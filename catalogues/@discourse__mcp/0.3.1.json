   "description": "Discover topics through a filtered, top, or hot view. Filtered uses Discourse TopicsFilter syntax; top uses Discourse's authoritative top score and defaults to weekly; hot is defined exactly as daily top (not sentiment, controversy, or real-time velocity). Returns a uniform rich topic projection and truthful pagination metadata.",
   "execution": {
    "taskSupport": "forbidden"
   },
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
     "filter": {
      "description": "TopicsFilter query (required for the filtered view)",
      "type": "string"
     },
     "page": {
      "description": "Page number (0-based, default: 0)",
      "minimum": 0,
      "type": "integer"
     },
     "per_page": {
      "description": "Items per page (default 20, max 50)",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
     },
     "top_period": {
      "description": "Top period (top view only; defaults to weekly)",
      "enum": [
       "daily",
       "weekly",
       "monthly",
       "quarterly",
       "yearly",
       "all"
      ],
      "type": "string"
     },
     "view": {
      "default": "filtered",
      "enum": [
       "filtered",
       "top",
       "hot"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },

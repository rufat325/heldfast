{
 "_meta": {
  "openai/outputTemplate": "ui://audiala/card-v1.html",
  "openai/toolInvocation/invoked": "City guide ready",
  "openai/toolInvocation/invoking": "Looking up the city\u2026",
  "ui": {
   "resourceUri": "ui://audiala/card-v1.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find a city"
 },
 "description": "Find a city in the Audiala audio-guide catalog (1,900+ cities). Shows a city card with a short editorial summary, the number of audio guides, and the city's must-see places, plus links to open the city in the Audiala app or signed-in web app. Use this whenever a user asks about a city for sightseeing, audio guides, or self-guided tours.",
 "inputSchema": {
  "properties": {
   "lang": {
    "description": "Content language for URLs. Defaults to en.",
    "enum": [
     "en",
     "fr",
     "de",
     "es",
     "it",
     "pt",
     "ru",
     "ja",
     "zh",
     "cs",
     "ar",
     "hi"
    ],
    "type": "string"
   },
   "name": {
    "description": "City name. Tolerates accents and minor misspellings ('Tokyo', 'T\u014dky\u014d', '\u6771\u4eac' all work).",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "audiala_find_city",
 "outputSchema": {
  "properties": {
   "city": {
    "description": "The resolved city.",
    "properties": {
     "app_url": {
      "description": "Opens the city in the signed-in Audiala web app.",
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "guides_count": {
      "description": "Number of audio guides in the city.",
      "type": [
       "integer",
       "null"
      ]
     },
     "image": {
      "description": "Hero image URL.",
      "type": [
       "string",
       "null"
      ]
     },
     "image_fallbacks": {
      "description": "Images to try if `image` fails.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "summary": {
      "description": "Short editorial summary.",
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "description": "Public audiala.com city page.",
      "type": "string"
     }
    },
    "required": [
     "name",
     "country",
     "url"
    ],
    "type": "object"
   },
   "kind": {
    "enum": [
     "city",
     "not_found"
    ],
    "type": "string"
   },
   "lang": {
    "type": "string"
   },
   "links": {
    "description": "UTM-tagged links into Audiala.",
    "properties": {
     "app_url": {
      "description": "Signed-in Audiala web app.",
      "type": "string"
     },
     "download": {
      "description": "App download page.",
      "type": "string"
     },
     "listen_in_app": {
      "description": "Deep link to the full guide in the Audiala app.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "matches": {
    "description": "Other cities matching the query.",
    "items": {
     "properties": {
      "app_url": {
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "monuments_count": {
       "type": [
        "integer",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "open_in_app": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "description": "Why nothing matched and what to try instead.",
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "top_places": {
    "description": "Must-see places, editorial order.",
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "url": {
       "description": "Public audiala.com page for the place.",
       "type": "string"
      }
     },
     "required": [
      "name",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "kind"
  ],
  "type": "object"
 },
 "title": "Find a city"
}

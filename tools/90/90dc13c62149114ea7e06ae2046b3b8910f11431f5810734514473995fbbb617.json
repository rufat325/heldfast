{
 "description": "Assemble the project's timeline into the final video (clips + music + watermark + overlays). Only projectId is required; settings fall back to the project. Async \u2014 returns a jobId; poll list_movies. Costs credits and an export.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aiGeneratedLabel": {
    "description": "Per-render override of the AI-disclosure label.",
    "type": "boolean"
   },
   "projectId": {
    "type": "string"
   },
   "settings": {
    "additionalProperties": false,
    "properties": {
     "aspectRatio": {
      "enum": [
       "16:9",
       "9:16",
       "1:1",
       "4:5"
      ],
      "type": "string"
     },
     "duration": {
      "maximum": 60,
      "minimum": 3,
      "type": "number"
     },
     "resolution": {
      "enum": [
       "720p",
       "1080p",
       "4k"
      ],
      "type": "string"
     },
     "transitions": {
      "enum": [
       "none",
       "fade",
       "slide",
       "zoom"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "render_movie",
 "title": "Render the final movie for a project"
}

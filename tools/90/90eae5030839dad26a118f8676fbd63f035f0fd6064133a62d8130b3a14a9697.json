{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Search-and-replace text across multiple files inside an explicit root path. Use for renames and refactors when the project scope is known.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allow_external": {
    "description": "Allow a replacement root outside the current project root. Use only when you intentionally target a temp or external directory.",
    "type": "boolean"
   },
   "dry_run": {
    "description": "Preview without writing (default: false)",
    "type": "boolean"
   },
   "format": {
    "description": "\"compact\" (default) = summary only, \"full\" = include capped diffs",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   },
   "glob": {
    "description": "File glob (default: \"**/*.{md,mjs,json,yml,ts,js}\")",
    "type": "string"
   },
   "max_files": {
    "description": "Max files to process (default: 100)",
    "type": "number"
   },
   "path": {
    "description": "Root directory for the replacement scope",
    "type": "string"
   },
   "replacements": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "properties": {
        "new": {
         "type": "string"
        },
        "old": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "old",
        "new"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     }
    ],
    "description": "JSON array of {old, new} pairs: [{\"old\":\"foo\",\"new\":\"bar\"}]"
   }
  },
  "required": [
   "replacements",
   "path"
  ],
  "type": "object"
 },
 "name": "bulk_replace",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "content": {
    "type": "string"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "recovery": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "recovery"
    ],
    "type": "object"
   },
   "failure_class": {
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "recovery": {
    "type": "string"
   },
   "status": {
    "enum": [
     "OK",
     "ERROR",
     "AUTO_REBASED",
     "CONFLICT",
     "STALE",
     "INVALID",
     "NO_CHANGES",
     "CHANGED",
     "UNSUPPORTED"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Bulk Replace"
}

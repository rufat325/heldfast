{
 "description": "Create a fulfillment for an order",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lineItems": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "locationId": {
    "type": "string"
   },
   "notifyCustomer": {
    "default": true,
    "type": "boolean"
   },
   "orderId": {
    "description": "The order ID to fulfill",
    "type": "string"
   },
   "trackingInfo": {
    "additionalProperties": false,
    "properties": {
     "company": {
      "type": "string"
     },
     "number": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "orderId",
   "lineItems"
  ],
  "type": "object"
 },
 "name": "createFulfillment"
}

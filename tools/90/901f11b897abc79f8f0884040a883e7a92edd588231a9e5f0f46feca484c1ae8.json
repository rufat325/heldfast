{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Load full context in one call: recent messages, entries, context, scratchpad. Run this at session start.",
 "inputSchema": {
  "properties": {
   "entries": {
    "description": "Number of entries to include (default: 10)",
    "type": "number"
   },
   "messages": {
    "description": "Number of messages to include (default: 20)",
    "type": "number"
   },
   "query": {
    "description": "Semantic query for relevant entries",
    "type": "string"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   }
  },
  "required": [
   "spaceId"
  ],
  "type": "object"
 },
 "name": "memory_bootstrap",
 "outputSchema": {
  "properties": {
   "activeThreads": {
    "description": "Active conversation threads",
    "type": "array"
   },
   "contextEncoding": {
    "description": "Context encoding mode (json or lln)",
    "type": "string"
   },
   "encryption": {
    "description": "Encryption mode: none, managed, or e2e",
    "type": "string"
   },
   "entities": {
    "description": "Known entities in the space",
    "type": "array"
   },
   "llnPrimer": {
    "description": "LLN primer mode (inline, system, or none)",
    "type": "string"
   },
   "recentEntries": {
    "description": "Most recent long-term entries",
    "items": {
     "properties": {
      "_id": {
       "description": "Entry ID",
       "type": "string"
      },
      "content": {
       "description": "Entry body",
       "type": "string"
      },
      "createdAt": {
       "description": "ISO 8601 creation timestamp",
       "type": "string"
      },
      "tags": {
       "description": "Tags for filtering",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Entry title",
       "type": "string"
      },
      "type": {
       "description": "Entry type: extraction, summary, decision, or artifact",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "recentMessages": {
    "description": "Most recent messages",
    "items": {
     "properties": {
      "_id": {
       "description": "Message ID",
       "type": "string"
      },
      "content": {
       "description": "Message text",
       "type": "string"
      },
      "createdAt": {
       "description": "ISO 8601 creation timestamp",
       "type": "string"
      },
      "metadata": {
       "description": "Optional caller-supplied metadata",
       "type": "object"
      },
      "role": {
       "description": "Message role: user, assistant, system, or tool",
       "type": "string"
      },
      "seq": {
       "description": "Monotonic sequence number within the space",
       "type": "number"
      },
      "spaceId": {
       "description": "Owning memory space ID",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "semanticEntries": {
    "description": "Entries matched by the optional semantic query",
    "items": {
     "properties": {
      "_id": {
       "description": "Entry ID",
       "type": "string"
      },
      "content": {
       "description": "Entry body",
       "type": "string"
      },
      "createdAt": {
       "description": "ISO 8601 creation timestamp",
       "type": "string"
      },
      "tags": {
       "description": "Tags for filtering",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Entry title",
       "type": "string"
      },
      "type": {
       "description": "Entry type: extraction, summary, decision, or artifact",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "shared": {
    "description": "Shared world context visible to all agents in the space",
    "type": "object"
   },
   "state": {
    "description": "Current working state for the space",
    "type": "object"
   }
  },
  "type": "object"
 }
}

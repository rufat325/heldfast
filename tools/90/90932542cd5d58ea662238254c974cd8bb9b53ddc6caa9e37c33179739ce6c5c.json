  "readOnlyHint": false,
  "title": "Remove From Watchlist"
 },
 "description": "Remove one company from the authenticated user's default StockLens portfolio. Does NOT execute trades and does NOT delete a recorded holding or its transactions; a holding with recorded transactions cannot be removed through this tool. Does NOT accept more than one ticker per call.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "exchange": {
    "description": "Exchange code (e.g. NASDAQ). Optional. When omitted, the ticker is matched against the portfolio; if it is there on more than one exchange you will be asked which.",
    "enum": [
     "NYSE",
     "NASDAQ",
     "AMEX",
     "OTC",
     "CBOE",
     "TSX",
     "TSXV",
     "CNQ",
     "NEO",
     "MEX",
     "B3",
     "SANTIAGO",
     "BUE",
     "BVC",
     "LSE",
     "EURONEXT_PARIS",
     "EURONEXT_AMSTERDAM",
     "EURONEXT_BRUSSELS",
     "EURONEXT_LISBON",
     "EURONEXT_DUBLIN",
     "XETRA",
     "SIX",
     "BME",
     "MILAN",
     "OSLO",
     "OMX_STOCKHOLM",
     "OMX_HELSINKI",
     "OMX_COPENHAGEN",
     "WSE",
     "VIE",
     "ATH",
     "PRA",
     "BUD",
     "IST",
     "ICE",
     "RIS",
     "TAL",
     "MCX",

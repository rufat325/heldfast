     "SGX",
     "NSE",
     "KRX",
     "BSE",
     "KOE",
     "JKT",
     "KLS",
     "SET",
     "NZE",
     "HOSE",
     "TWO",
     "TADAWUL",
     "JSE",
     "TLV",
     "DFM",
     "EGX",
     "DOH",
     "KUW"
    ],
    "type": "string"
   },
   "ticker": {
    "description": "Stock ticker symbol (e.g. AAPL). Exactly one ticker per call.",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9.\\-]{0,19}$",
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },

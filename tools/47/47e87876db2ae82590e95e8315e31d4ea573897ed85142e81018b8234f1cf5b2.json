{
 "description": "Get the balance of an ERC-20 or SPL token for a wallet address. Use this to check token holdings before trading or transferring.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "rpc_url": {
    "description": "Optional RPC endpoint override",
    "format": "uri",
    "type": "string"
   },
   "token": {
    "description": "CAIP-10 token contract address (e.g. 'eip155:8453:0xtoken...' or 'solana:5eykt...:mintAddress')",
    "type": "string"
   },
   "wallet": {
    "description": "CAIP-10 wallet address to check balance for (must be on the same chain as token)",
    "type": "string"
   }
  },
  "required": [
   "token",
   "wallet"
  ],
  "type": "object"
 },
 "name": "printr_get_token_balance",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_atomic": {
    "description": "Balance in atomic units (smallest denomination)",
    "type": "string"
   },
   "balance_formatted": {
    "description": "Human-readable balance with decimals",
    "type": "string"
   },
   "chain": {
    "description": "CAIP-2 chain ID",
    "type": "string"
   },
   "chain_name": {
    "description": "Human-readable chain name",
    "type": "string"
   },
   "decimals": {
    "description": "Token decimals",
    "type": "number"
   },
   "symbol": {
    "description": "Token symbol",
    "type": "string"
   },
   "token": {
    "description": "The queried token CAIP-10 address",
    "type": "string"
   },
   "wallet": {
    "description": "The wallet CAIP-10 address",
    "type": "string"
   }
  },
  "required": [
   "token",
   "wallet",
   "chain",
   "chain_name",
   "balance_atomic",
   "balance_formatted",
   "symbol",
   "decimals"
  ],
  "type": "object"
 }
}

{
 "description": "Update one template draft. Editing a draft can never change what a past delivery rendered: published versions are immutable.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "blocks": {
    "description": "Canonical content blocks. This is the stored form \u2014 HTML is converted into it, never kept raw.",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "message_type": {
    "description": "What the template may be used for. A marketing campaign will not accept a transactional template.",
    "enum": [
     "transactional",
     "marketing"
    ],
    "type": "string"
   },
   "name": {
    "description": "Template name",
    "type": "string"
   },
   "organization_id": {
    "description": "Active organization ID",
    "type": "string"
   },
   "subject": {
    "description": "Subject with declared {{variables}}",
    "type": "string"
   },
   "template_id": {
    "description": "Template ID",
    "type": "string"
   },
   "variables": {
    "description": "Typed variables the template declares: `name`, `type` and whether it is `required`.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Variable name",
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "type": {
       "enum": [
        "string",
        "number",
        "date"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "organization_id",
   "template_id"
  ],
  "type": "object"
 },
 "name": "commsharbor_template_update"
}

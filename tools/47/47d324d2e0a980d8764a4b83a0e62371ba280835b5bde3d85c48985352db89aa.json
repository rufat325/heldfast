{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Start Screen Recording"
 },
 "description": "Start recording the screen. Recording continues until screen_record_stop is called.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "duration": {
    "description": "Max recording duration in seconds (optional, device limit usually 180s)",
    "type": "number"
   },
   "remotePath": {
    "default": "/sdcard/scrcpy-mcp-recording.mp4",
    "description": "Path on device to save recording",
    "type": "string"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "screen_record_start",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Human-readable status message",
    "type": "string"
   },
   "remotePath": {
    "description": "Path on the device where the recording is saved",
    "type": "string"
   },
   "success": {
    "description": "Whether recording was started",
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 }
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Forward geocode \u2014 place name \u2192 coordinates. Strong on partial / autocomplete-style queries.",
 "inputSchema": {
  "examples": [
   {
    "query": "Eiffel Tower Paris"
   },
   {
    "lang": "en",
    "lat": 48.8566,
    "limit": 10,
    "location_bias_scale": 0.5,
    "lon": 2.3522,
    "osm_tag": "amenity:cafe",
    "query": "cafe"
   }
  ],
  "properties": {
   "bbox": {
    "description": "Bounding box: \"min_lon,min_lat,max_lon,max_lat\"",
    "type": "string"
   },
   "lang": {
    "description": "Language for the response (en, de, fr, ...)",
    "type": "string"
   },
   "lat": {
    "description": "Latitude bias center",
    "type": "number"
   },
   "layer": {
    "description": "house | street | locality | city | district | county | state | country",
    "type": "string"
   },
   "limit": {
    "description": "1-50 (default 5)",
    "type": "number"
   },
   "location_bias_scale": {
    "description": "Strength of lat/lon bias (default 0.2)",
    "type": "number"
   },
   "lon": {
    "description": "Longitude bias center",
    "type": "number"
   },
   "osm_tag": {
    "description": "OSM tag filter (e.g. \"amenity:pharmacy\")",
    "type": "string"
   },
   "query": {
    "description": "Free-text place name / address",
    "type": "string"
   },
   "zoom": {
    "description": "Zoom level for bias (0-18)",
    "type": "number"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "properties": {
   "features": {
    "description": "Array of geocoding results",
    "items": {
     "properties": {
      "geometry": {
       "properties": {
        "coordinates": {
         "description": "Longitude and latitude",

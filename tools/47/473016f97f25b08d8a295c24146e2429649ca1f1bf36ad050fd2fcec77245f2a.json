{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Scroll"
 },
 "description": "Scroll at the specified position. dx and dy are scroll amounts (-1 to 1 range approximated for ADB).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dx": {
    "description": "Horizontal scroll amount (negative=left, positive=right)",
    "type": "number"
   },
   "dy": {
    "description": "Vertical scroll amount (negative=up, positive=down)",
    "type": "number"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   },
   "x": {
    "description": "X coordinate to scroll at",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "y": {
    "description": "Y coordinate to scroll at",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "x",
   "y",
   "dx",
   "dy"
  ],
  "type": "object"
 },
 "name": "scroll",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Human-readable description of the action performed",
    "type": "string"
   },
   "success": {
    "description": "Whether the input action was dispatched to the device",
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 }
}

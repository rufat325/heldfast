{
 "description": "Set (or clear) the auto-expiry on a hosted drop. The host's gc cron deletes it after the deadline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expire": {
    "description": "'7d' | '24h' | '2w' | a date | 'off' to clear.",
    "type": "string"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "slug",
   "expire"
  ],
  "type": "object"
 },
 "name": "set_expiry"
}

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List forms"
 },
 "description": "List the forms in a workspace, newest first. Optional `query` searches by title.",
 "inputSchema": {
  "properties": {
   "page": {
    "description": "1-based page number.",
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page (max 100, default 25).",
    "type": "integer"
   },
   "query": {
    "description": "Search term (matches the form title).",
    "type": "string"
   },
   "workspace": {
    "description": "Workspace id. Optional when the account has one workspace; use list_workspaces to resolve otherwise.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_forms",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "description": "Total matching rows across all pages.",
    "type": "integer"
   },
   "error": {
    "additionalProperties": true,
    "description": "Present only when the tool failed (the result is also flagged isError).",
    "properties": {
     "cause": {
      "description": "Machine-readable failure category: invalid_argument, not_found, forbidden, plan_limit, rate_limited, or server_error.",
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retryable": {
      "description": "Whether repeating the same call could succeed.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "next": {
    "description": "URL of the next page, or null on the last page.",
    "type": [
     "string",
     "null"
    ]
   },
   "previous": {
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "created": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "modified": {
       "type": "string"
      },
      "response_count": {
       "type": "integer"
      },
      "share_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "workspace": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}

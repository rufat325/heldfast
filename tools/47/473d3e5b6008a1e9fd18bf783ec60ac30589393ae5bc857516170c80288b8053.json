{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage knowledge base documents. Methods: list, get, create, update, get_versions, restore_version, add_link, get_graph",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "author": {
    "description": "Author name (for: create)",
    "type": "string"
   },
   "change_summary": {
    "description": "Change description (for: update)",
    "type": "string"
   },
   "content": {
    "description": "Markdown content (required for: create)",
    "type": "string"
   },
   "doc_type": {
    "description": "Document type (for: create)",
    "enum": [
     "prd",
     "tech_spec",
     "architecture",
     "api_design",
     "custom"
    ],
    "type": "string"
   },
   "document_id": {
    "description": "Document ID (for: get, update, get_versions, restore_version)",
    "type": "string"
   },
   "inferred_fields": {
    "description": "Inferred fields (for: create)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "link_type": {
    "description": "Link type (for: add_link, default: related)",
    "enum": [
     "related",
     "references",
     "blocks",
     "parent"
    ],
    "type": "string"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "get_versions",
     "restore_version",
     "add_link",
     "get_graph"
    ],
    "type": "string"
   },
   "parent_id": {
    "description": "Parent document ID (for: create)",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (for: list, create, add_link, get_graph \u2014 auto-detected if omitted)",
    "type": "string"
   },
   "properties": {
    "additionalProperties": {},
    "description": "Custom properties (for: create, update)",
    "type": "object"
   },
   "sections": {
    "description": "Sections (for: create, update)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "collapsed": {
       "type": "boolean"
      },
      "content": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source_id": {
    "description": "Source entity ID (required for: add_link)",
    "type": "string"
   },
   "source_type": {
    "description": "Source entity type (required for: add_link)",
    "enum": [
     "document",
     "story",
     "feature",
     "decision",
     "sprint",
     "session"
    ],
    "type": "string"
   },
   "status": {
    "description": "Document status (for: create, update)",
    "enum": [
     "draft",
     "in_review",
     "published",
     "archived"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tags (for: create, update)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "target_id": {
    "description": "Target entity ID (required for: add_link)",
    "type": "string"
   },
   "target_type": {
    "description": "Target entity type (required for: add_link)",
    "enum": [
     "document",
     "story",
     "feature",
     "decision",
     "sprint",
     "session"
    ],
    "type": "string"
   },
   "template": {
    "description": "Template (for: create, update)",
    "enum": [
     "tech_spec",
     "meeting_notes",
     "decision_record",
     "wiki",
     "brainstorm",
     "prd",
     "blank"
    ],
    "type": "string"
   },
   "title": {
    "description": "Document title (required for: create)",
    "type": "string"
   },
   "version": {
    "description": "Version number to restore (required for: restore_version)",
    "type": "number"
   },
   "visibility": {
    "description": "Visibility (for: create, update)",
    "enum": [
     "private",
     "team",
     "public"
    ],
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "documents"
}

{
 "description": "Tell PeepTrend whether an opportunity was useful, wrong, saturated, off-niche, or used for a video. Requires an active PeepTrend subscription.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "gameId": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "message": {
    "maxLength": 1000,
    "type": "string"
   },
   "type": {
    "enum": [
     "useful",
     "not_useful",
     "wrong_match",
     "too_saturated",
     "not_my_niche",
     "made_video"
    ],
    "type": "string"
   }
  },
  "required": [
   "gameId",
   "type"
  ],
  "type": "object"
 },
 "name": "send_opportunity_feedback",
 "title": "Send opportunity feedback"
}

{
 "description": "Perform multimodal tasks combining text and images. Send a conversation with mixed text and image content to multimodal models for complex reasoning across modalities.",
 "inputSchema": {
  "properties": {
   "max_tokens": {
    "default": 2048,
    "maximum": 4096,
    "minimum": 1,
    "type": "integer"
   },
   "messages": {
    "description": "Conversation messages with optional images. Each message can have text content or an array of text and image_url parts.",
    "items": {
     "properties": {
      "content": {
       "oneOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "properties": {
           "image_url": {
            "properties": {
             "detail": {
              "enum": [
               "low",
               "high",
               "auto"
              ],
              "type": "string"
             },
             "url": {
              "format": "uri",
              "type": "string"
             }
            },
            "type": "object"
           },
           "text": {
            "type": "string"
           },
           "type": {
            "enum": [
             "text",
             "image_url"
            ],
            "type": "string"
           }
          },
          "type": "object"
         },
         "type": "array"
        }
       ]
      },
      "role": {
       "enum": [
        "system",
        "user",
        "assistant"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "model": {
    "description": "Multimodal model ID (e.g., nvidia/neva-22b, microsoft/phi-3.5-vision-instruct, meta/llama-3.2-90b-vision-instruct)",
    "type": "string"
   },
   "stream": {
    "default": false,
    "type": "boolean"
   },
   "temperature": {
    "default": 0.3,
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "top_p": {
    "default": 0.95,
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 },
 "name": "multimodal_task"
}

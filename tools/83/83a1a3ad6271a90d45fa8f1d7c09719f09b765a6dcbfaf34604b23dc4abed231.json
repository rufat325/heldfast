{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Call after connecting AND again after each meaningful chunk of work. Claude Code: reuse claude-code-<client session id>.",
 "inputSchema": {
  "properties": {
   "context": {
    "description": "Handoff another AI can continue from: goal, state, constraints, next steps.",
    "type": "string"
   },
   "continues_from": {
    "description": "Optional session_id from palim_resume that this chat continues.",
    "type": "string"
   },
   "created_at": {
    "description": "Optional ISO 8601 chat date from the client.",
    "type": "string"
   },
   "decisions_made": {
    "description": "Decisions in this chat.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "key_topics": {
    "description": "Main topics.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "open_items": {
    "description": "Open tasks.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "origin": {
    "description": "human (default) or automation (hooks/cron).",
    "enum": [
     "human",
     "automation"
    ],
    "type": "string"
   },
   "project": {
    "description": "Optional project name.",
    "type": "string"
   },
   "referenced_files": {
    "description": "Relevant files.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resolved_open_items": {
    "description": "Previously open items that are now done; quote a leading fragment.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "session_id": {
    "description": "Stable chat ID. Reuse it so checkpoints update one row. Claude Code/Codex: claude-code-<client session id>.",
    "type": "string"
   },
   "source_urls": {
    "description": "Optional URLs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "description": "Optional status, e.g. laufend or abgeschlossen.",
    "type": "string"
   },
   "tags": {
    "description": "Optional search tags.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Chat title when visible.",
    "type": "string"
   },
   "tool_source": {
    "description": "Client: cursor, claude, chatgpt, \u2026",
    "type": "string"
   }
  },
  "required": [
   "context",
   "tool_source"
  ],
  "type": "object"
 },
 "name": "palim_checkpoint",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "message": {
    "description": "Human-readable tool result text.",
    "type": "string"
   }
  },
  "required": [
   "message"
  ],
  "type": "object"
 }
}

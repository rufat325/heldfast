{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Meal"
 },
 "description": "Add a meal to a live event's culinary plan \u2014 kind (breakfast/lunch/dinner/snack/special), serve time (required), title, status (planning \u2026 served), expected diners, stations, shopping list, estimated cost ($). Requires event_id + kind + serve_at; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "estimated_cost": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "expected_diners": {
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "kind": {
    "enum": [
     "breakfast",
     "brunch",
     "lunch",
     "snack",
     "dinner",
     "late_night",
     "special"
    ],
    "type": "string"
   },
   "notes": {
    "maxLength": 2000,
    "type": "string"
   },
   "place_id": {
    "maxLength": 128,
    "type": "string"
   },
   "project_id": {
    "maxLength": 128,
    "type": "string"
   },
   "serve_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "shopping_list": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "stations": {
    "items": {
     "maxLength": 160,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "status": {
    "enum": [
     "planning",
     "sourcing",
     "ready",
     "cooking",
     "served",
     "cancelled"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "title": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "kind",
   "serve_at"
  ],
  "type": "object"
 },
 "name": "add_meal",
 "title": "Add Meal"
}

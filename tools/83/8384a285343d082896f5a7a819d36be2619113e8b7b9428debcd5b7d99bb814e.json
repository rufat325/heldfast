    "quartile": "FIRST",
    "region": "ca_los-angeles",
    "res_type": "single_family"
   }
  ],
  "properties": {
   "_altosKey": {
    "description": "Altos Research API key",
    "type": "string"
   },
   "date": {
    "description": "Date (must be a Friday, YYYY-MM-DD). Defaults to most recent Friday.",
    "type": "string"
   },
   "quartile": {

{
 "description": "Rename a tag by ID (all workflows using it see the new name).",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Tag ID",
    "type": "string"
   },
   "name": {
    "description": "New tag name",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "name"
  ],
  "type": "object"
 },
 "name": "update_tag"
}

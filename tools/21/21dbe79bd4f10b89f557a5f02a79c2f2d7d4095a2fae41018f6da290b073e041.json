{
 "description": "Search Google, return SERP results with organic, ads, AI Overview. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cr": {
    "description": "e.g. 'countryUS'.",
    "type": "string"
   },
   "device": {
    "description": "Device.",
    "enum": [
     "desktop",
     "mobile"
    ],
    "type": "string"
   },
   "filter": {
    "description": "'0' disables omitted-results filter.",
    "enum": [
     "0",
     "1"
    ],
    "type": "string"
   },
   "gl": {
    "description": "Country, e.g. 'us'.",
    "type": "string"
   },
   "google_domain": {
    "description": "e.g. 'google.co.uk'.",
    "type": "string"
   },
   "hl": {
    "description": "Language, e.g. 'en'.",
    "type": "string"
   },
   "include_html": {
    "description": "Include raw HTML.",
    "type": "boolean"
   },
   "location": {
    "description": "Location name, auto-encoded to UULE.",
    "type": "string"
   },
   "lr": {
    "description": "e.g. 'lang_en'.",
    "type": "string"
   },
   "nfpr": {
    "description": "Disable spelling correction.",
    "type": "boolean"
   },
   "query": {
    "description": "Search query.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "resolve_ai_overview": {
    "description": "Resolve deferred AI Overview (default true).",
    "type": "boolean"
   },
   "safe": {
    "description": "SafeSearch.",
    "enum": [
     "active"
    ],
    "type": "string"
   },
   "start": {
    "description": "Offset: 0=page 1, 10=page 2.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "time_period": {
    "description": "Time window.",
    "enum": [
     "last_hour",
     "last_day",
     "last_week",
     "last_month",
     "last_year"
    ],
    "type": "string"
   },
   "uule": {
    "description": "UULE string, overrides location.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_google"
}

{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Submit a vacancy for moderation. The server stores it as pending and returns it. URL (the dedup key), title, and company are required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "company": {
    "description": "Company name. Required.",
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "description": "Stored and rendered as HTML.",
    "type": "string"
   },
   "location": {
    "type": "string"
   },
   "posted_at": {
    "description": "RFC3339 timestamp.",
    "type": "string"
   },
   "remote": {
    "type": "boolean"
   },
   "source": {
    "description": "The posting's real origin (defaults to 'manual' server-side).",
    "type": "string"
   },
   "title": {
    "description": "Job title. Required.",
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "The posting URL \u2014 the dedup key. Required.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "title",
   "company"
  ],
  "type": "object"
 },
 "name": "submit"
}

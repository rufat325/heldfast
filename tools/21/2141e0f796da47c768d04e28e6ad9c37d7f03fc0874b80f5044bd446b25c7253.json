 "description": "Look up quotes by structural address within a work \u2014 act/scene for plays, chapter for novels. Example: author_id=\"william-shakespeare\", work_title=\"Hamlet\", act=3, scene=1 returns the \"To be, or not to be\" line.",
 "inputSchema": {
  "examples": [
   {
    "act": 3,
    "author_id": "william-shakespeare",
    "scene": 1,
    "work_title": "Hamlet"
   },
   {
    "author_id": "oscar-wilde",
    "chapter": 2,
    "work_title": "The Picture of Dorian Gray"
   }
  ],
  "properties": {
   "act": {
    "description": "Act number (plays only).",
    "type": "number"
   },
   "author_id": {
    "description": "Author id (e.g., \"william-shakespeare\").",
    "type": "string"
   },
   "chapter": {
    "description": "Chapter number (novels/essays).",
    "type": "number"
   },
   "scene": {
    "description": "Scene number (plays only).",
    "type": "number"
   },
   "work_title": {
    "description": "Title of the work (e.g., \"Hamlet\", \"The Picture of Dorian Gray\").",
    "type": "string"
   }
  },
  "required": [

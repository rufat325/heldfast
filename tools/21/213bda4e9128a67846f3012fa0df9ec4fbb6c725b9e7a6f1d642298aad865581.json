{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Status of applications the key owner's agent has requested \u2014 queued, submitted, refused (with the refusing gate named), or failed. Needs a key or a sign-in.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Most recent N, default 20, max 50.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "application_status",
 "outputSchema": {
  "additionalProperties": true,
  "oneOf": [
   {
    "required": [
     "queued",
     "applications",
     "statusKey"
    ]
   },
   {
    "required": [
     "error",
     "fix"
    ]
   }
  ],
  "properties": {
   "applications": {
    "description": "Prepared packets and their outcome, newest first.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "company": {
       "type": "string"
      },
      "needsHumanFor": {
       "description": "Present when blocked: the kinds of answer the classifier would not invent.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "notReleasedBecause": {
       "description": "Present when release was refused: the gate, named.",
       "type": "string"
      },
      "postingId": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "submittedAt": {
       "type": "string"
      },
      "submittedVia": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "vendor": {
       "type": "string"
      }
     },
     "required": [
      "postingId",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "description": "Only when this key is not linked to an account.",
    "type": "string"
   },
   "fix": {
    "type": "string"
   },
   "queued": {
    "description": "Requests waiting for the hourly preparer, newest first.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "company": {
       "type": "string"
      },
      "postingId": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "postingId",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "statusKey": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "What each status word means.",
    "type": "object"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "email"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Application status"
}

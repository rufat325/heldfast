{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search the public catalog"
 },
 "description": "Search the public catalog of recipes, lab protocols, event templates and workouts by name or keyword. Returns ids, names, descriptions and URLs; no login. Pass an id to load_public_recipe.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "environment": {
    "default": "kitchen",
    "description": "Which catalog: kitchen (default), laboratory, event or gym.",
    "enum": [
     "kitchen",
     "laboratory",
     "gym",
     "event",
     "events"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "default": "",
    "description": "Keyword; matches name and description. Empty returns the newest entries.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_public_recipes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "environment": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "description": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "description",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "environment",
   "count",
   "results"
  ],
  "type": "object"
 },
 "title": "Search the public catalog"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search HealthData.gov for public-health datasets by keyword (e.g. \"COVID hospitalizations\", \"Medicare spending\", \"opioid prescriptions\"). Returns each dataset's Socrata id (a 4x4 like \"g62h-syeh\"), title, description, owning agency, tags, when the data was last updated, and its page-view count. Pass the id to get_dataset for full metadata or to get_rows to read the actual rows.",
 "inputSchema": {
  "examples": [
   {
    "query": "COVID-19 hospitalizations"
   },
   {
    "limit": 20,
    "query": "opioid prescriptions by state"
   }
  ],
  "properties": {
   "limit": {
    "description": "Max results, 1-50 (default 10).",
    "type": "number"
   },
   "offset": {
    "description": "Skip this many results, for paging (default 0).",
    "type": "number"
   },
   "query": {
    "description": "Search query, e.g. \"vaccination rates\", \"hospital readmissions\".",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_datasets",
 "outputSchema": {
  "properties": {
   "results": {
    "description": "Array of matching datasets",
    "items": {
     "properties": {
      "created": {
       "description": "Dataset creation timestamp",
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "description": "Dataset description (truncated to 300 chars)",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Dataset package ID",
       "type": "string"
      },
      "modified": {
       "description": "Dataset last modified timestamp",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "description": "Dataset name",
       "type": "string"
      },
      "num_resources": {
       "description": "Number of resources in the dataset",
       "type": "number"
      },
      "organization": {
       "description": "Organization name that published the dataset",
       "type": [
        "string",
        "null"
       ]
      },
      "resource_formats": {
       "description": "List of resource file formats (e.g., CSV, JSON)",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "tags": {
       "description": "Dataset tags/keywords",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Dataset title",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name",
      "title",
      "description",
      "organization",
      "created",
      "modified",
      "tags",
      "num_resources",
      "resource_formats"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Total number of datasets matching the search query",
    "type": "number"
   }
  },
  "required": [
   "total",
   "results"
  ],
  "type": "object"
 },
 "title": "Search Datasets",
 "version": "v1.6c0bd6e5"
}

    "type": "string"
   },
   "_fredKey": {
    "description": "FRED API key",
    "type": "string"
   },
   "_hudKey": {
    "description": "HUD API token (optional \u2014 needed for income limits)",
    "type": "string"
   },
   "metro_name": {
    "description": "Metro name for metro-level FHFA HPI (e.g., \"Denver\", \"Savannah\"). Optional.",
    "type": "string"
   },
   "state": {
    "description": "State name or two-letter code (e.g., \"California\" or \"CA\"). Resolved for you \u2014 pass this rather than state_code. Optional: without it you still get the national mortgage rate, median price and affordability math, just no HUD income limits.",
    "type": "string"
   },
   "state_code": {
    "description": "Two-letter state code for HUD income limits (e.g., \"CO\"). `state` is preferred and accepts either form.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },

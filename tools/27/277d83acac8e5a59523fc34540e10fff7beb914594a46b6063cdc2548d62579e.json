{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Update the project brief"
 },
 "description": "Write the shared project brief, structured facts, and reference links. This is the intent layer every task under the project is measured against \u2014 keep it current when the goal or ground rules change.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "add_links": {
    "items": {
     "properties": {
      "kind": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "notes": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "brief_md": {
    "description": "Markdown brief. Replaces the existing brief.",
    "type": "string"
   },
   "client": {
    "type": "string"
   },
   "client_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "facts": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Structured key/value facts. Merged into existing facts.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "goal": {
    "description": "One-line intent, stored on the project itself.",
    "type": "string"
   },
   "project": {
    "description": "Name or @handle of the project. Fuzzy-resolved.",
    "type": "string"
   },
   "project_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_project_context",
 "title": "Update the project brief"
}

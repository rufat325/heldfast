{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Upcoming and past fixtures for a team or full league over a date range, including opponents, home and away teams, UTC start time, venue, and final result when available.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "date_from": {
    "description": "Start of date range in YYYY-MM-DD format. Inclusive.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_to": {
    "description": "End of date range in YYYY-MM-DD format. Inclusive.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "league": {
    "description": "League identifier. Supported: nfl, nba, mlb, nhl, epl, mls, laliga, bundesliga, seriea, ligue1, ucl, ncaaf, ncaab.",
    "enum": [
     "nfl",
     "nba",
     "mlb",
     "nhl",
     "epl",
     "mls",
     "laliga",
     "bundesliga",
     "seriea",
     "ligue1",
     "ucl",
     "ncaaf",
     "ncaab"
    ],
    "type": "string"
   },
   "team_name": {
    "description": "Team name or partial name to filter schedule. Fuzzy match. Omit for league-wide schedule.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "league"
  ],
  "type": "object"
 },
 "name": "sports_get_schedule",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "games",
     "league",
     "totalReturned"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "dateFrom": {
    "description": "Start date filter applied, if any.",
    "type": "string"
   },
   "dateTo": {
    "description": "End date filter applied, if any.",
    "type": "string"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `team_not_found`: The team_name resolves to no matching team in the league. Other values are possible when a failure originates below the handler.",
        "examples": [
         "team_not_found"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "games": {
    "description": "Games in the requested date range.",
    "items": {
     "additionalProperties": false,
     "description": "A single scheduled or completed game.",
     "properties": {
      "awayTeam": {
       "additionalProperties": false,
       "description": "Away team.",
       "properties": {
        "abbreviation": {
         "description": "Team abbreviation, e.g. \"SEA\" or \"DAL\".",
         "type": "string"
        },
        "id": {
         "description": "Source-prefixed team ID.",
         "type": "string"
        },
        "name": {
         "description": "Full team name.",
         "type": "string"
        },
        "score": {
         "description": "Final score, null if game not played yet.",
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "name",
        "abbreviation",
        "score"
       ],
       "type": "object"
      },
      "clock": {
       "description": "Game clock display, null if not applicable.",
       "type": [
        "string",
        "null"
       ]
      },
      "homeTeam": {
       "additionalProperties": false,
       "description": "Home team.",
       "properties": {
        "abbreviation": {
         "description": "Team abbreviation, e.g. \"SEA\" or \"DAL\".",
         "type": "string"
        },
        "id": {
         "description": "Source-prefixed team ID.",
         "type": "string"
        },
        "name": {
         "description": "Full team name.",
         "type": "string"
        },
        "score": {
         "description": "Final score, null if game not played yet.",
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "name",
        "abbreviation",
        "score"
       ],
       "type": "object"
      },
      "id": {
       "description": "Source-prefixed game ID.",
       "type": "string"
      },
      "period": {
       "description": "Current period or inning, null if not started.",
       "type": [
        "number",
        "null"
       ]
      },
      "shortName": {
       "description": "Short matchup string.",
       "type": "string"
      },
      "source": {
       "description": "Data source that provided this game record.",
       "enum": [
        "espn",
        "mlbstats"
       ],
       "type": "string"
      },
      "startTimeUtc": {
       "description": "Game start time in UTC ISO 8601.",
       "type": "string"
      },
      "status": {
       "description": "Game status.",
       "enum": [
        "scheduled",
        "in-progress",
        "final",
        "postponed",
        "cancelled"
       ],
       "type": "string"
      },
      "venue": {
       "description": "Venue name, or null if unavailable.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "shortName",
      "homeTeam",
      "awayTeam",
      "status",
      "period",
      "clock",
      "startTimeUtc",
      "venue",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "league": {
    "description": "The league queried.",
    "type": "string"
   },
   "teamFilter": {
    "description": "Team name filter applied, if any.",
    "type": "string"
   },
   "totalReturned": {
    "description": "Total number of games returned.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Sports Get Schedule"
}

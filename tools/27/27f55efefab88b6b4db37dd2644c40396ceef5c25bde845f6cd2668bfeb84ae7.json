 "description": "\u041e\u0444\u043e\u0440\u043c\u0438\u0442\u044c \u0437\u0430\u043a\u0430\u0437 \u043f\u043e \u043a\u043e\u0440\u0437\u0438\u043d\u0435 \u0441 \u043e\u043f\u043b\u0430\u0442\u043e\u0439 \u043f\u043e \u0441\u0447\u0451\u0442\u0443 \u0434\u043b\u044f \u044e\u0440\u043b\u0438\u0446\u0430 \u0438\u043b\u0438 \u0418\u041f. \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043d\u043e\u043c\u0435\u0440 \u0437\u0430\u043a\u0430\u0437\u0430 \u0438 \u0441\u0441\u044b\u043b\u043a\u0443 \u043d\u0430 \u0441\u0447\u0451\u0442. \u0421\u0430\u043c\u043e\u0432\u044b\u0432\u043e\u0437 \u0441\u043e \u0441\u043a\u043b\u0430\u0434\u0430 \u0438\u043b\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0422\u041a \u043f\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u0438\u044e. \u0422\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u0445\u043e\u0434\u0430 \u043f\u043e OAuth: \u0437\u0430\u043a\u0430\u0437 \u043e\u0444\u043e\u0440\u043c\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u043f\u043e\u0447\u0442\u0443 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0430 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cart_id": {
    "type": "string"
   },
   "comment": {
    "type": "string"
   },
   "company": {
    "minLength": 2,
    "type": "string"
   },
   "contact": {
    "type": "string"
   },
   "delivery": {
    "default": "pickup",
    "enum": [
     "pickup",
     "delivery"
    ],
    "type": "string"
   },
   "dry_run": {
    "default": false,
    "description": "\u041f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435 \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0438\u0442\u043e\u0433, \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043e\u0444\u043e\u0440\u043c\u043b\u044f\u044f",
    "type": "boolean"
   },
   "email": {
    "description": "\u041d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f: \u0437\u0430\u043a\u0430\u0437 \u043e\u0444\u043e\u0440\u043c\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u043f\u043e\u0447\u0442\u0443 \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0430 \u0432\u043e\u0448\u0435\u0434\u0448\u0435\u0433\u043e \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "inn": {
    "pattern": "^\\d{10}(\\d{2})?$",
    "type": "string"
   },
   "kpp": {
    "type": "string"
   },
   "legal_address": {
    "type": "string"
   },
   "phone": {
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "cart_id",
   "company",
   "inn",
   "phone"
  ],
  "type": "object"
 },
 "name": "create_invoice_order",
 "title": "\u0417\u0430\u043a\u0430\u0437 \u0441\u043e \u0441\u0447\u0451\u0442\u043e\u043c"
}

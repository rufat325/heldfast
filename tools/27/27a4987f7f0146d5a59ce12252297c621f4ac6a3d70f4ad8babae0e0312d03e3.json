{
 "annotations": {
  "readOnlyHint": false,
  "title": "Seal Credential"
 },
 "description": "Seal (encrypt and store) a credential using ML-KEM-768 + AES-256-GCM + ML-DSA-65 triple-layer encryption. Tenant isolation is enforced by the API key. Returns the vault entry UUID.",
 "inputSchema": {
  "properties": {
   "credential_type": {
    "description": "Credential type",
    "enum": [
     "api_key",
     "password",
     "oauth2_token",
     "oauth2_client",
     "bearer_token",
     "basic_auth",
     "mtls_cert",
     "saml_assertion",
     "jwt_signing_key",
     "aws_credentials",
     "ssh_key_pair",
     "database_dsn",
     "kafka_credentials",
     "webhook_secret",
     "custom_kv"
    ],
    "type": "string"
   },
   "metadata": {
    "additionalProperties": true,
    "description": "Optional metadata to store alongside the credential",
    "type": "object"
   },
   "name": {
    "description": "Human-readable label (e.g. 'aws-prod-keys')",
    "type": "string"
   },
   "plaintext": {
    "additionalProperties": true,
    "description": "Credential key-value pairs (e.g. {\"key\": \"sk-abc123\"})",
    "type": "object"
   },
   "ttl_days": {
    "description": "Optional TTL in days (1\u2013365). Omit for no expiry.",
    "maximum": 365,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "name",
   "credential_type",
   "plaintext"
  ],
  "type": "object"
 },
 "name": "vault_seal"
}

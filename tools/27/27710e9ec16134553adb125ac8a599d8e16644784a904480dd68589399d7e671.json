{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the latest stored visibility snapshot, including scores and winning/losing prompts; call refresh_brand first for fresh data. Example: brand_id='acme', engines=['chatgpt','perplexity'].",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brand_id": {
    "description": "Tracked brand ID to inspect.",
    "type": "string"
   },
   "engines": {
    "description": "Engines to include; omit or pass [] for all stored engines.",
    "items": {
     "enum": [
      "chatgpt",
      "claude",
      "perplexity",
      "gemini",
      "grok",
      "ai_overviews",
      "ai_mode"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "brand_id"
  ],
  "type": "object"
 },
 "name": "check_visibility",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brand": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "type": [
       "string",
       "null"
      ]
     },
     "domain": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "domain",
     "category"
    ],
    "type": "object"
   },
   "overall_score": {
    "type": "number"
   },
   "per_engine": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "engine": {
       "type": "string"
      },
      "prompts_appeared_in": {
       "type": "number"
      },
      "refreshed_at": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "total_prompts": {
       "type": "number"
      }
     },
     "required": [
      "engine",
      "score",
      "prompts_appeared_in",
      "total_prompts",
      "refreshed_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "refreshed_at": {
    "type": "string"
   },
   "top_losing_prompts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "competitors_cited": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "prompt": {
       "type": "string"
      }
     },
     "required": [
      "prompt",
      "competitors_cited"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "top_winning_prompts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "engines_cited_in": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "prompt": {
       "type": "string"
      }
     },
     "required": [
      "prompt",
      "engines_cited_in"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "brand",
   "refreshed_at",
   "overall_score",
   "per_engine",
   "top_winning_prompts",
   "top_losing_prompts"
  ],
  "type": "object"
 },
 "title": "Check AI visibility"
}

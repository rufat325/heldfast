{
 "description": "Fetch a value from a BrewPage KV store by namespace, ID, and key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "KV store ID",
    "type": "string"
   },
   "key": {
    "description": "Key to fetch",
    "type": "string"
   },
   "namespace": {
    "description": "KV store namespace",
    "type": "string"
   },
   "password": {
    "description": "Password if the KV store is protected",
    "type": "string"
   }
  },
  "required": [
   "namespace",
   "id",
   "key"
  ],
  "type": "object"
 },
 "name": "get_kv"
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create or update up to 20 visual blocks in one call after edit timing is settled. Presets: broll-headline, steps, quote, end-screen, key-number, before-after, screenshot-focus, chapter. IDs are scoped to the project; repeating an ID updates it. Asset IDs must belong to the workspace. Atomic, undoable; dryRun validates without writing. Returns IDs and revision. No generation pass.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "type": "boolean"
   },
   "expectedRevision": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "items": {
    "description": "Supply only the fields for the selected preset.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "afterAssetId": {
       "description": "Required for before-after.",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "assetId": {
       "description": "Required for broll-headline and screenshot-focus.",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "at": {
       "maximum": 86400,
       "minimum": 0,
       "type": "number"
      },
      "attribution": {
       "description": "Required for quote.",
       "maxLength": 60,
       "minLength": 1,
       "type": "string"
      },
      "beforeAssetId": {
       "description": "Required for before-after.",
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "cta": {
       "description": "Required for end-screen.",
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      },
      "duration": {
       "maximum": 30,
       "minimum": 1,
       "type": "number"
      },
      "focus": {
       "additionalProperties": false,
       "description": "Required for screenshot-focus. Normalized rectangle inside the source image.",
       "properties": {
        "height": {
         "exclusiveMinimum": 0,
         "maximum": 1,
         "type": "number"
        },
        "width": {
         "exclusiveMinimum": 0,
         "maximum": 1,
         "type": "number"
        },
        "x": {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "y": {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "x",
        "y",
        "width",
        "height"
       ],
       "type": "object"
      },
      "id": {
       "pattern": "^[a-zA-Z0-9_-]{1,80}$",
       "type": "string"
      },
      "logoAssetId": {
       "anyOf": [
        {
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Required for end-screen; null for no logo."
      },
      "number": {
       "description": "Required for chapter.",
       "maxLength": 4,
       "minLength": 1,
       "type": "string"
      },
      "preset": {
       "enum": [
        "broll-headline",
        "steps",
        "quote",
        "end-screen",
        "key-number",
        "before-after",
        "screenshot-focus",
        "chapter"
       ],
       "type": "string"
      },
      "steps": {
       "description": "Required for steps.",
       "items": {
        "maxLength": 48,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 5,
       "minItems": 2,
       "type": "array"
      },
      "suffix": {
       "description": "Required for key-number; empty string allowed.",
       "maxLength": 8,
       "type": "string"
      },
      "text": {
       "description": "Heading, or quote. Max 120 characters except quote: 220.",
       "maxLength": 220,
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "description": "Required for key-number.",
       "maximum": 999999,
       "minimum": -999999,
       "type": "number"
      }
     },
     "required": [
      "id",
      "at",
      "duration",
      "preset",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "items",
   "expectedRevision",
   "dryRun",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "visuals_apply",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "compositionId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "contentItemId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "status": {
       "enum": [
        "created",
        "updated"
       ],
       "type": "string"
      },
      "timelineItemId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      }
     },
     "required": [
      "id",
      "timelineItemId",
      "contentItemId",
      "compositionId",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mutationReceiptId": {
    "type": [
     "string",
     "null"
    ]
   },
   "replayed": {
    "type": "boolean"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "success",
   "dryRun",
   "revision",
   "mutationReceiptId",
   "replayed",
   "items",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Apply visual presets"
}

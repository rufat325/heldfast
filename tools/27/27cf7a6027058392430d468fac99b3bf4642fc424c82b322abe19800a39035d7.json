 },
 "description": "Map-match a noisy GPS trace (semicolon-separated lon,lat pairs) to the road network via OSRM, optionally specifying per-point search radiuses in meters; returns matched route geometry and confidence.",
 "inputSchema": {
  "examples": [
   {
    "coordinates": "-122.42,37.77;-122.39,37.78;-122.41,37.80"
   },
   {
    "coordinates": "-122.42,37.77;-122.39,37.78;-122.41,37.80",
    "profile": "bike",
    "radiuses": "5;10;5"
   }
  ],
  "properties": {
   "coordinates": {
    "type": "string"
   },
   "profile": {
    "type": "string"
   },
   "radiuses": {
    "description": "Per-point search radius in meters, semicolon-separated",
    "type": "string"
   }
  },
  "required": [
   "coordinates"
  ],
  "type": "object"
 },
 "name": "match",
 "outputSchema": {
  "description": "Map-matching response from OSRM",
  "properties": {
   "code": {
    "description": "Status code (Ok or error)",
    "type": "string"
   },
   "matchings": {
    "description": "Array of matched route segments",
    "items": {
     "properties": {
      "confidence": {
       "description": "Confidence score 0-1",
       "type": "number"
      },
      "distance": {
       "description": "Total distance in meters",
       "type": "number"
      },
      "duration": {
       "description": "Total duration in seconds",
       "type": "number"
      },
      "geometry": {
       "description": "GeoJSON LineString geometry",
       "type": "object"
      },
      "legs": {
       "description": "Array of route legs",
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "tracepoints": {
    "description": "Array of matched trace points",
    "items": {
     "properties": {
      "distance": {
       "type": "number"
      },
      "hint": {
       "type": "string"
      },
      "location": {
       "type": "array"
      },
      "matchings_index": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "waypoint_index": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },

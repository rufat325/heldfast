    "description": "Job ID returned by any generation_*_create tool.",
    "format": "uuid",
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "generation_jobs_get",
 "outputSchema": {

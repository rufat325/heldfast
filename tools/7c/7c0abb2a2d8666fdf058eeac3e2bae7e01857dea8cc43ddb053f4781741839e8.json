    "symbol": "btcusd"
   },
   {
    "include_breaks": true,
    "limit_trades": 100,
    "symbol": "ethusd"
   }
  ],
  "properties": {
   "include_breaks": {
    "type": "boolean"
   },
   "limit_trades": {
    "type": "number"
   },
   "symbol": {
    "type": "string"
   },
   "timestamp": {
    "type": "number"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "trades",

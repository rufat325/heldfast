{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add recipients to a message that was already sent (one you sent or received as a primary recipient). They receive the message and become participants of its thread. This cannot be undone. Fails on terminal messages.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "add_to": {
    "description": "addresses or short names to add",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "id": {
    "description": "fmsg message id",
    "pattern": "^[0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "id",
   "add_to"
  ],
  "type": "object"
 },
 "name": "add_recipients",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "add_to": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "added": {
    "type": "number"
   },
   "id": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "added",
   "add_to"
  ],
  "type": "object"
 },
 "title": "Add fmsg recipients"
}

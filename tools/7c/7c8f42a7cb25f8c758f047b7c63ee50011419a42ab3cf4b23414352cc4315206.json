    "type": "string"
   },
   "description": {
    "description": "Optional snapshot description",
    "type": "string"
   },
   "entity_id": {
    "description": "Target entity ID for undo or history lookup",
    "type": "string"
   },
   "name": {
    "description": "Snapshot name for save/restore",
    "type": "string"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   },
   "snapshot_a": {
    "description": "First snapshot name for diff",
    "type": "string"
   },
   "snapshot_b": {
    "description": "Second snapshot name for diff",
    "type": "string"
   },
   "timestamp": {
    "description": "ISO timestamp for time-travel reconstruction",
    "type": "string"
   },
   "type": {
    "description": "Mutation type to undo (default: any)",

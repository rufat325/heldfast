{
 "description": "Reset a print job to pending so the agent prints it again.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "job_id": {
    "description": "The print job id (from fulfillment_queue)",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "job_id"
  ],
  "type": "object"
 },
 "name": "fulfillment_reprint_job"
}

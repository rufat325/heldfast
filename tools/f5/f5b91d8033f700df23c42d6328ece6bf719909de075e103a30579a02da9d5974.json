{
 "description": "Best-effort cancel (checked between actions/scenes/stages). A mid-record cancel salvages the partial timeline + footage. The job settles asynchronously \u2014 poll job_status for the final state.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "jobId": {
    "type": "string"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "job_cancel",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currentScene": {
    "type": [
     "string",
     "null"
    ]
   },
   "demoDir": {
    "type": "string"
   },
   "endedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "failureArtifacts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "feedbackHint": {
      "description": "present on a genuine failure (not a cancel) \u2014 nudges toward the feedback tool while context is fresh",
      "type": "string"
     },
     "logFile": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "salvaged": {
      "additionalProperties": false,
      "properties": {
       "scenes": {
        "type": "number"
       },
       "timeline": {
        "type": "string"
       }
      },
      "required": [
       "scenes",
       "timeline"
      ],
      "type": "object"
     },
     "stage": {
      "type": "string"
     }
    },
    "required": [
     "message",
     "stage",
     "failureArtifacts",
     "logFile"
    ],
    "type": "object"
   },
   "jobId": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "logFile": {
    "type": "string"
   },
   "logTail": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   },
   "scenesDone": {
    "type": "number"
   },
   "scenesTotal": {
    "type": [
     "number",
     "null"
    ]
   },
   "stage": {
    "type": "string"
   },
   "startedAt": {
    "type": "string"
   },
   "status": {
    "enum": [
     "running",
     "succeeded",
     "failed",
     "canceled"
    ],
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "kind",
   "demoDir",
   "status",
   "stage",
   "scenesTotal",
   "scenesDone",
   "currentScene",
   "startedAt",
   "endedAt",
   "logFile",
   "logTail"
  ],
  "type": "object"
 },
 "title": "Cancel a job"
}

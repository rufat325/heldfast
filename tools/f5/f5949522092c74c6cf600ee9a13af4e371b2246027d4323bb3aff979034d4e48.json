{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Install APK"
 },
 "description": "Install an APK file on the device from the host machine.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apkPath": {
    "description": "Absolute path to the APK file on the host machine",
    "type": "string"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   }
  },
  "required": [
   "apkPath"
  ],
  "type": "object"
 },
 "name": "app_install",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Install result or error output from adb",
    "type": "string"
   },
   "success": {
    "description": "Whether the APK installed successfully",
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 }
}

{
 "description": "Tap at the same coordinates multiple times with a fixed interval. Use for spam-tapping, incrementing counters, or testing rapid repeat actions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "description": "Number of taps to perform",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "device_id": {
    "description": "Device ID (optional if only one device)",
    "type": "string"
   },
   "interval_ms": {
    "default": 100,
    "description": "Interval between taps in ms (default 100)",
    "type": "number"
   },
   "x": {
    "description": "X coordinate",
    "type": "number"
   },
   "y": {
    "description": "Y coordinate",
    "type": "number"
   }
  },
  "required": [
   "x",
   "y",
   "count"
  ],
  "type": "object"
 },
 "name": "multi_tap"
}

{
 "description": "List recent hits for one of your monitors (read-only). Create/edit monitors in the Dashboard.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max hits (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "monitor_id": {
    "description": "Monitor id from xflux_list_monitors",
    "type": "string"
   }
  },
  "required": [
   "monitor_id"
  ],
  "type": "object"
 },
 "name": "xflux_get_monitor_hits"
}

{
 "description": "Machine-readable resolved-forecast accuracy history. Optional filters: asset, horizon (1h/4h/24h), limit (number of records). $0.001 per call via x402.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asset": {
    "description": "Asset symbol to filter, e.g. 'btc'",
    "type": "string"
   },
   "horizon": {
    "description": "Forecast horizon to filter, e.g. '1h', '4h', '24h'",
    "type": "string"
   },
   "limit": {
    "description": "Number of records to return",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_forecast_ledger"
}

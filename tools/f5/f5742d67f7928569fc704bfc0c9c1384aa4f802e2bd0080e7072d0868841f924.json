{
 "description": "Link an external user from a 3rd party identity provider to a FusionAuth user.",
 "inputSchema": {
  "properties": {
   "requestBody": {
    "description": "The JSON request body.",
    "properties": {
     "eventInfo": {
      "description": "Information about a user event (login, register, etc) that helps identify the source of the event (location, device type, OS, etc).",
      "properties": {
       "data": {
        "additionalProperties": {
         "type": "object"
        },
        "type": "object"
       },
       "deviceDescription": {
        "type": "string"
       },
       "deviceName": {
        "type": "string"
       },
       "deviceType": {
        "type": "string"
       },
       "ipAddress": {
        "type": "string"
       },
       "location": {
        "description": "Location information. Useful for IP addresses and other displayable data objects.",
        "properties": {
         "city": {
          "type": "string"
         },
         "country": {
          "type": "string"
         },
         "displayString": {
          "type": "string"
         },
         "latitude": {
          "format": "double",
          "type": "number"
         },
         "longitude": {
          "format": "double",
          "type": "number"
         },
         "region": {
          "type": "string"
         },
         "zipcode": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "os": {
        "type": "string"
       },
       "userAgent": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "identityProviderLink": {
      "description": "",
      "properties": {
       "data": {
        "additionalProperties": {
         "type": "object"
        },
        "type": "object"
       },
       "displayName": {
        "type": "string"
       },
       "identityProviderId": {
        "format": "uuid",
        "type": "string"
       },
       "identityProviderName": {
        "type": "string"
       },
       "identityProviderType": {
        "description": "",
        "enum": [
         "Apple",
         "EpicGames",
         "ExternalJWT",
         "Facebook",
         "Google",
         "HYPR",
         "LinkedIn",
         "Nintendo",
         "OpenIDConnect",
         "SAMLv2",
         "SAMLv2IdPInitiated",
         "SonyPSN",
         "Steam",
         "Twitch",
         "Twitter",
         "Xbox"
        ],
        "type": "string"
       },
       "identityProviderUserId": {
        "type": "string"
       },
       "insertInstant": {
        "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
        "format": "int64",
        "type": "number"
       },
       "lastLoginInstant": {
        "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
        "format": "int64",
        "type": "number"
       },
       "tenantId": {
        "format": "uuid",
        "type": "string"
       },
       "token": {
        "type": "string"
       },
       "userId": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "pendingIdPLinkId": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "createUserLinkWithId"
}

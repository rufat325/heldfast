{
 "description": "Record a single message (user or assistant) with the current local datetime and timezone offset. Call before responding for user messages, and before sending for assistant messages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "Full message text",
    "type": "string"
   },
   "role": {
    "enum": [
     "user",
     "assistant"
    ],
    "type": "string"
   },
   "session_id": {
    "description": "Session ID returned by start_session",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "role",
   "content"
  ],
  "type": "object"
 },
 "name": "log_message"
}

  "readOnlyHint": false,
  "title": "Edit Transaction"
 },
 "description": "Change one accounting transaction (a Portfolio Transaction): update_fields for memo, the full tag set, or operation type; update_journal_line for the ledger account, counterparty, or reporting-group assignments on one debit or credit line (read the line number first, look up selectable values with list_journal_line_assignment_options); or set_fmv_override to correct a fair market value and recompute dependent cost-basis records. Track returned requestIds, or pass waitForCompletion (update_fields, set_fmv_override) to wait for a terminal state.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "accountNumber": {
    "description": "Chart-of-accounts number to assign (from list_journal_line_assignment_options, type: ledger_account) Only for operation update_journal_line.",
    "minLength": 1,
    "type": "string"
   },
   "assetId": {
    "description": "Asset ID to override (e.g. eth_1, as returned by the read tools) Only for operation set_fmv_override; required for each.",
    "minLength": 1,
    "type": "string"
   },
   "counterpartyName": {
    "description": "Counterparty name to assign; pass null to unset Only for operation update_journal_line.",
    "minLength": 1,
    "nullable": true,
    "type": "string"
   },
   "lineNumber": {
    "description": "Journal entry line number (1-based) Only for operation update_journal_line; required for each.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "memo": {
    "description": "New memo; pass null to clear it Only for operation update_fields.",
    "nullable": true,
    "type": "string"
   },
   "newValueQuote": {
    "description": "Exact per-unit decimal string in base currency, e.g. \"0\". Do not use price. Only for operation set_fmv_override; required for each.",
    "pattern": "^-?\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "operation": {
    "description": "update_fields: Change memo, the full tag set, or the accounting operation type. update_journal_line: Change the ledger account, counterparty, or reporting-group assignments on one transaction's debit or credit line. set_fmv_override: Set a corrected fair market value per unit for one asset on the transaction and recompute dependent cost-basis records.",
    "enum": [
     "update_fields",
     "update_journal_line",
     "set_fmv_override"
    ],
    "type": "string"
   },
   "operationType": {
    "description": "New accounting operation type Only for operation update_fields.",
    "enum": [
     "DEPOSIT_FIAT",
     "INCOME",
     "REFUND",
     "WITHDRAWAL_FIAT",
     "EXPENSE",
     "BUY",
     "SELL",
     "EXCHANGE",
     "SWAP",
     "MOVE",
     "INTERCOMPANY_SEND",
     "INTERCOMPANY_RECEIVE",
     "STAKE",
     "UNSTAKE",
     "PROTOCOL_DEPOSIT",
     "PROTOCOL_WITHDRAW",
     "VAULT_DEPOSIT",
     "VAULT_WITHDRAW",
     "LP_IN",
     "LP_OUT",
     "LOAN_BORROW",
     "LOAN_REPAY",
     "LOAN_LIQUIDATION",
     "LEND_GIVE",
     "LEND_WITHDRAW",
     "ADJUSTMENT",
     "UNCATEGORIZED",
     "SPAM"
    ],
    "type": "string"
   },
   "pollIntervalMs": {
    "description": "Polling interval in milliseconds, 100 to 5000 (default 500) Not for operation update_journal_line.",
    "maximum": 5000,
    "minimum": 100,
    "type": "integer"
   },
   "portfolioRef": {
    "description": "Portfolio name or slug inside that workspace. Call list_portfolios to resolve it.",
    "minLength": 1,
    "type": "string"
   },
   "quoteCurrency": {
    "description": "Optional quote currency (defaults to base currency) Only for operation set_fmv_override.",
    "minLength": 1,
    "type": "string"
   },
   "quoteSource": {
    "description": "Optional source/justification for the price Only for operation set_fmv_override.",
    "minLength": 1,
    "type": "string"
   },
   "reason": {
    "description": "Immutable root reason whose nonempty bytes are preserved exactly; use ptx:<uuid> for transaction references Only for operation set_fmv_override.",
    "minLength": 1,
    "type": "string"
   },
   "responsibilityCenterAssignments": {
    "description": "Typed responsibility-center assignment set, one per dimension. Replaces the line assignments; pass [] to clear every dimension. Type keys and center names come from list_journal_line_assignment_options, type: responsibility_center. Only for operation update_journal_line.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "responsibilityCenterName": {
       "description": "Responsibility-center name within that type",
       "minLength": 1,
       "type": "string"
      },
      "responsibilityCenterTypeKey": {
       "description": "Responsibility-center type key / dimension slug, e.g. primary, goal",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "responsibilityCenterTypeKey",
      "responsibilityCenterName"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "subType": {
    "description": "New operation sub-type (requires operationType) Only for operation update_fields.",
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "description": "Replace the full set of transaction tags Only for operation update_fields.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "timeoutMs": {
    "description": "Maximum wait time in milliseconds, 1000 to 60000 (default 30000) Not for operation update_journal_line.",
    "maximum": 60000,
    "minimum": 1000,
    "type": "integer"
   },
   "transactionId": {
    "description": "Portfolio transaction ID",
    "minLength": 1,
    "type": "string"
   },
   "waitForCompletion": {
    "anyOf": [
     {
      "description": "When true, poll queued request IDs and include terminal status/final state before returning",
      "type": "boolean"
     },
     {
      "description": "When true, poll the queued request and include terminal status/final state before returning",
      "type": "boolean"
     }
    ],
    "description": "When true, poll queued request IDs and include terminal status/final state before returning Not for operation update_journal_line."
   },
   "workspaceRef": {
    "description": "Workspace name or slug. Call list_workspaces to resolve it.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "workspaceRef",
   "portfolioRef",
   "operation",
   "transactionId"
  ],
  "type": "object"
 },

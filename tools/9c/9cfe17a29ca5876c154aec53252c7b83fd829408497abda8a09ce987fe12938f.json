{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Country-specific pricing for a set of products (the checkout applies the destination country's currency and pricing). Returns unit, sale and final prices plus the subtotal.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "items": {
    "description": "Basket lines as product ids with quantities.",
    "items": {
     "properties": {
      "id": {
       "description": "Product id from search/product tools.",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "quantity": {
       "default": 1,
       "maximum": 999,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "locale": {
    "description": "Storefront locale such as en-GB (default), en-US, de, fr-FR, es-ES, it-IT, nl-NL, pl. Controls product names, slugs and prices.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   },
   "shipping_country": {
    "description": "ISO 3166-1 alpha-2 country code, e.g. GB, IE, DE, US.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   }
  },
  "required": [
   "shipping_country",
   "items"
  ],
  "type": "object"
 },
 "name": "get_prices_for_country",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currency": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "fallback_used": {
    "description": "No prices for this country: another country's were used.",
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "final_price": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "number"
      },
      "quantity": {
       "type": "number"
      },
      "sale_price": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "unit_price": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "quantity",
      "unit_price",
      "sale_price",
      "final_price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pricing_country": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "shipping_country": {
    "type": "string"
   },
   "subtotal": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "shipping_country",
   "pricing_country",
   "currency",
   "fallback_used",
   "items",
   "subtotal"
  ],
  "type": "object"
 },
 "title": "Get prices for a country"
}

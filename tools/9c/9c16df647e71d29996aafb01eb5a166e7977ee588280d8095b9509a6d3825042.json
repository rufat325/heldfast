   "per_page": {
    "description": "Results per page (1-30, default 10)",
    "type": "number"
   },
   "query": {
    "description": "Common or scientific name",
    "type": "string"
   },
   "rank": {
    "description": "Restrict to a rank (kingdom, phylum, class, order, family, genus, species)",
    "type": "string"
   }
  },
  "required": [

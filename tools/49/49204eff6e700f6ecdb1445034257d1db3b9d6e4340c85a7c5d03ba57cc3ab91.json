{
 "description": "Store up to 50 memories in a single call. Returns an array of results with memory IDs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "memories": {
    "description": "Array of memories to store (max 50)",
    "items": {
     "properties": {
      "concepts": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "content": {
       "description": "Full memory content",
       "maxLength": 5000,
       "minLength": 1,
       "type": "string"
      },
      "emotional_valence": {
       "maximum": 1,
       "minimum": -1,
       "type": "number"
      },
      "importance": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "metadata": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "related_user": {
       "type": "string"
      },
      "related_wallet": {
       "type": "string"
      },
      "source": {
       "description": "Origin of this memory",
       "type": "string"
      },
      "source_id": {
       "type": "string"
      },
      "summary": {
       "description": "Short summary",
       "maxLength": 500,
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "type": {
       "description": "Memory type",
       "enum": [
        "episodic",
        "semantic",
        "procedural",
        "self_model",
        "introspective"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "content",
      "summary",
      "source"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "memories"
  ],
  "type": "object"
 },
 "name": "batch_store_memories"
}

  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add To Watchlist"
 },
 "description": "Add one company to the authenticated user's default StockLens portfolio as a company they follow, so its score stays readable here. Call it only when the person has asked for it or agreed to an offer. If the portfolio is already at the limit of the person's current plan, the result says so. After an add the person accepted from a get_market_summary offer, call get_market_summary again to answer their question. Does NOT execute trades, does NOT record a holding or transaction, and does NOT accept more than one ticker per call.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "exchange": {

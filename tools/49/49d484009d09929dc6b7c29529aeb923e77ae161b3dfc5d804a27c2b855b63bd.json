{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Affiliate Profile"
 },
 "description": "Create a reusable 'open' affiliate profile \u2014 a shareable link promoters self-join (no named email; use add_affiliate for a specific person). Set per-tier discount, optional code prefix, affiliate cap, commission, and start/expiry. Counts against the affiliate-profile plan cap. Requires event_id + at least one tier; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "code_prefix": {
    "maxLength": 16,
    "type": "string"
   },
   "commission_type": {
    "enum": [
     "percent",
     "fixed"
    ],
    "type": "string"
   },
   "commission_value": {
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "expires_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "max_affiliates": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "profile_name": {
    "maxLength": 160,
    "type": "string"
   },
   "starts_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "tiers": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "discount_type": {
       "enum": [
        "percent",
        "fixed"
       ],
       "type": "string"
      },
      "discount_value": {
       "maximum": 1000000,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "discount_type",
      "discount_value"
     ],
     "type": "object"
    },
    "propertyNames": {
     "maxLength": 128,
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "event_id",
   "tiers"
  ],
  "type": "object"
 },
 "name": "create_affiliate_profile",
 "title": "Create Affiliate Profile"
}

{
 "description": "Build a Graphify-style Mermaid visualization mapping design decisions and Task DAG execution state.",
 "inputSchema": {
  "properties": {
   "decisions": {
    "description": "List of key design decisions.",
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "choice": {
       "type": "string"
      },
      "rationale": {
       "type": "string"
      }
     },
     "required": [
      "category",
      "choice",
      "rationale"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "projectName": {
    "description": "Name of the project.",
    "type": "string"
   },
   "tasks": {
    "description": "Task DAG nodes.",
    "items": {
     "properties": {
      "dependencies": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "role": {
       "type": "string"
      },
      "status": {
       "enum": [
        "pending",
        "running",
        "completed",
        "blocked"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "role",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "projectName",
   "decisions"
  ],
  "type": "object"
 },
 "name": "pixasso_generate_brain"
}

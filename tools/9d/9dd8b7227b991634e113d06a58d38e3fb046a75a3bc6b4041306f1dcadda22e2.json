{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Contextual Bandit (LinUCB)"
 },
 "description": "Select the best option given a numeric context/feature vector, using a LinUCB contextual bandit that learns per-context preferences from optional history. Use when the best choice changes with situational features that vary call-to-call (user/segment attributes, time of day, current regime). Returns the chosen arm with its LinUCB expected reward and confidence width. If you have no per-call features, use optimize_bandit.",
 "inputSchema": {
  "properties": {
   "alpha": {
    "description": "Exploration coefficient (default: 1.0). Higher = more exploration.",
    "type": "number"
   },
   "arms": {
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "minItems": 2,
    "type": "array"
   },
   "context": {
    "description": "Numeric feature vector describing the current situation. Length must match across calls.",
    "items": {
     "type": "number"
    },
    "minItems": 1,
    "type": "array"
   },
   "history": {
    "description": "Optional past observations to seed the model.",
    "items": {
     "properties": {
      "armId": {
       "type": "string"
      },
      "context": {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "reward": {
       "type": "number"
      }
     },
     "required": [
      "armId",
      "reward",
      "context"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "arms",
   "context"
  ],
  "type": "object"
 },
 "name": "optimize_contextual",
 "outputSchema": {
  "properties": {
   "algorithm": {
    "const": "linucb",
    "type": "string"
   },
   "confidenceWidth": {
    "description": "Uncertainty bound on the estimate.",
    "type": "number"
   },
   "expectedReward": {
    "description": "LinUCB point estimate of reward.",
    "type": "number"
   },
   "score": {
    "description": "expectedReward + alpha * confidenceWidth.",
    "type": "number"
   },
   "selected": {
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name"
    ],
    "type": "object"
   }
  },
  "required": [
   "selected",
   "score",
   "expectedReward",
   "confidenceWidth",
   "algorithm"
  ],
  "type": "object"
 }
}

     "expires_at",
     "unsigned_action",
     "payload_sha256",
     "payload_sha256_spec",
     "server_signing",
     "server_submission",
     "signed",
     "submitted"
    ],
    "type": "object"
   },
   "caller_wallet_handoff": {
    "additionalProperties": {},
    "description": "Fresh self-verifying EIP-1193 or Solana Wallet Standard handoff. The caller still simulates, confirms, signs and submits.",
    "type": "object"
   },
   "semantic_verification": {

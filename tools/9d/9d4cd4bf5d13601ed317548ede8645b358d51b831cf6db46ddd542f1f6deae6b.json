      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "payload_sha256_spec": {
      "const": "sha256(UTF-8 JSON with sorted keys and compact separators, excluding payload_sha256 itself)",
      "type": "string"
     },
     "server_signing": {
      "const": false,
      "type": "boolean"
     },
     "server_submission": {
      "const": false,
      "type": "boolean"
     },
     "signed": {
      "const": false,
      "type": "boolean"
     },
     "step_index": {
      "minimum": 0,
      "type": "integer"
     },
     "submitted": {
      "const": false,
      "type": "boolean"
     },
     "unsigned_action": {
      "additionalProperties": {},
      "type": "object"
     },
     "version": {
      "const": "assetfare-direct-multichain-action-v2",
      "type": "string"
     },
     "workflow_id": {
      "format": "uuid",
      "type": "string"
     }

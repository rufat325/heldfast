 "description": "Search IETF Datatracker documents with optional filters for state (e.g. \"active\"), type (draft | rfc | charter), or name substring; returns document names, titles, and statuses.",
 "inputSchema": {
  "examples": [
   {
    "limit": 50,
    "type": "rfc"
   },
   {
    "name__contains": "quic",
    "states": "active",
    "type": "draft"
   }
  ],
  "properties": {
   "limit": {
    "description": "1-1000 (default 20).",
    "type": "number"
   },
   "name__contains": {
    "description": "Substring filter on the name.",
    "type": "string"
   },
   "offset": {
    "type": "number"
   },
   "states": {
    "description": "Comma-sep state ids (e.g. \"active\").",
    "type": "string"
   },
   "type": {
    "description": "draft | rfc | charter | conflrev | \u2026",
    "type": "string"
   }
  },
  "type": "object"
 },

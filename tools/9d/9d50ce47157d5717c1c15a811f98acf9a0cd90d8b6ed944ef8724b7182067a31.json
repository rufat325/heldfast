{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a source document from a SEC filing, served by ko.io. Returns a ko.io LINK to the rendered document (open in a browser) plus, optionally, an extracted text excerpt. Never returns the whole file \u2014 for full content, open the link or request a specific section. Requires a paid ko.io plan (Pro): on Free or keyless access the call returns an explicit plan-limit error. Use sec_list_filings / sec_get_filing_index (open on every plan) to find filings and their files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accession_no": {
    "description": "Accession number, e.g. '0000320193-23-000106'",
    "maxLength": 200,
    "type": "string"
   },
   "cik": {
    "description": "Company CIK number",
    "maxLength": 200,
    "type": "string"
   },
   "file": {
    "description": "File name within the filing (from sec_get_filing_index). Omit for the primary document.",
    "maxLength": 200,
    "type": "string"
   },
   "include_excerpt": {
    "default": true,
    "description": "Include a text excerpt (first ~6000 chars) in the response",
    "type": "boolean"
   }
  },
  "required": [
   "cik",
   "accession_no"
  ],
  "type": "object"
 },
 "name": "sec_get_filing_document",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accession_no": {
    "type": "string"
   },
   "cik": {
    "type": "string"
   },
   "excerpt": {
    "additionalProperties": false,
    "properties": {
     "chars_total": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "status": {
      "enum": [
       "ok",
       "unavailable",
       "not_requested"
      ],
      "type": "string"
     },
     "text": {
      "$ref": "#/properties/file"
     },
     "truncated": {
      "type": [
       "boolean",
       "null"
      ]
     }
    },
    "required": [
     "status",
     "text",
     "chars_total",
     "truncated"
    ],
    "type": "object"
   },
   "file": {
    "type": [
     "string",
     "null"
    ]
   },
   "link": {
    "additionalProperties": false,
    "properties": {
     "expires_at": {
      "$ref": "#/properties/file"
     },
     "signed": {
      "description": "true = ko.io-signed, expiring link a browser can open; false = needs a paid API key",
      "type": "boolean"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "url",
     "signed",
     "expires_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "cik",
   "accession_no",
   "file",
   "link",
   "excerpt"
  ],
  "type": "object"
 }
}

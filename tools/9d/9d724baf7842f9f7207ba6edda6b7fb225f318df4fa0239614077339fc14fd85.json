{
 "description": "Find high-intent leads or brand mentions while filtering out noise. Use this when the user wants to find 'buyers' or specific discussions.",
 "inputSchema": {
  "properties": {
   "hours_back": {
    "default": 24,
    "description": "How far back to search in hours.",
    "type": "number"
   },
   "keywords": {
    "description": "Main search terms.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "negative_keywords": {
    "description": "Words to exclude (e.g., \"crypto\", \"hiring\").",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "target_subreddits": {
    "description": "Limit search to specific subreddits.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "keywords"
  ],
  "type": "object"
 },
 "name": "reddit_lead_monitor"
}

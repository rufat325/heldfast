{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Enumerate every file in a single SEC filing (primary document, exhibits, images, XBRL, the full .txt submission). Pass a file name from here to sec_get_filing_document.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accession_no": {
    "description": "Accession number, e.g. '0000320193-23-000106'",
    "maxLength": 200,
    "type": "string"
   },
   "cik": {
    "description": "Company CIK number",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "cik",
   "accession_no"
  ],
  "type": "object"
 },
 "name": "sec_get_filing_index",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accession": {
    "$ref": "#/properties/cik"
   },
   "cik": {
    "type": [
     "string",
     "null"
    ]
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "last_modified": {
       "$ref": "#/properties/cik"
      },
      "name": {
       "$ref": "#/properties/cik"
      },
      "size_bytes": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "type": {
       "$ref": "#/properties/cik"
      }
     },
     "required": [
      "name",
      "type",
      "size_bytes",
      "last_modified"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "cik",
   "accession",
   "files"
  ],
  "type": "object"
 }
}

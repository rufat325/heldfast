    "limit": 10,
    "tag": "javascript"
   },
   {
    "limit": 20,
    "tag": "python",
    "top": 7
   }
  ],
  "properties": {
   "limit": {
    "description": "Number of articles to return (default 10, max 30)",
    "type": "number"
   },
   "tag": {
    "description": "Filter articles by tag (e.g., \"javascript\", \"python\", \"webdev\")",
    "type": "string"
   },
   "top": {
    "description": "Return top articles from the last N days (e.g., 7 for last week)",
    "type": "number"
   }
  },

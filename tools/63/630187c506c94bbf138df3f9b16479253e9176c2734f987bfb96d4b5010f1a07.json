{
 "description": "Histogram of recent similarity scores (20 buckets, width 0.1) for a semantic_cache. Errors on agent_cache.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cache_name": {
    "description": "Cache name as registered in __betterdb:caches (e.g. 'betterdb_scache_prod').",
    "minLength": 1,
    "type": "string"
   },
   "category": {
    "description": "Restrict to a single category",
    "type": "string"
   },
   "instanceId": {
    "description": "Connection ID; defaults to the active instance",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "window_hours": {
    "description": "Lookback window (default 24h, max 168h)",
    "maximum": 168,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "cache_name"
  ],
  "type": "object"
 },
 "name": "cache_similarity_distribution"
}

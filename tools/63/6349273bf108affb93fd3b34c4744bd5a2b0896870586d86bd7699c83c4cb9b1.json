{
 "description": "Resolve Granoflow milestone candidates by title without creating or updating data.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "includeDone": {
    "default": false,
    "type": "boolean"
   },
   "matchMode": {
    "default": "exact",
    "enum": [
     "exact",
     "contains"
    ],
    "type": "string"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "granoflow_milestone_resolve"
}

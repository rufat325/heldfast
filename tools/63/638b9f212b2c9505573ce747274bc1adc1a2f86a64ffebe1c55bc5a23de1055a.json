{
 "description": "Get replies to a tweet. Paginate with next_cursor/has_more. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "next_cursor from previous response.",
    "type": "string"
   },
   "rank": {
    "description": "'top' (default) or 'latest'.",
    "enum": [
     "top",
     "latest"
    ],
    "type": "string"
   },
   "tweet_id": {
    "description": "Tweet ID.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "tweet_id"
  ],
  "type": "object"
 },
 "name": "get_tweet_comments"
}

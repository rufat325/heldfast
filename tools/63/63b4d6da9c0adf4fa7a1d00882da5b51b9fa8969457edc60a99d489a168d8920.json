 "description": "Search global company registries by name across 140+ jurisdictions. Returns company name, jurisdiction, status, type, incorporation date, and registered address. REQUIRES your own OpenCorporates API token via _apiKey \u2014 their public API is closed and keyless calls return 401. For keyless global company lookup use gleif search_lei instead. Example: search_companies({query:\"Tesla\", country:\"us\", _apiKey:\"...\"})",
 "inputSchema": {
  "examples": [
   {
    "country": "us",
    "query": "Tesla"
   },
   {
    "query": "Acme Corp"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "Your OpenCorporates API token (required \u2014 get one at https://opencorporates.com/api_accounts/new)",
    "type": "string"
   },
   "country": {
    "description": "ISO 2-letter country code (e.g., \"us\", \"gb\", \"de\")",
    "type": "string"
   },
   "query": {
    "description": "Company name to search (e.g., \"Acme Corp\")",
    "type": "string"
   }
  },
  "required": [

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an idempotent Stripe Checkout URL for human prepaid funding.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "pattern": "^(?:0|[1-9]\\d{0,13})(?:\\.\\d{1,6})?$",
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 160,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
    "type": "string"
   },
   "schema_version": {
    "const": "rqm.jobs.funding-session-request.v1",
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "amount",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "create_funding_session",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "amount": {
      "pattern": "^(?:0|[1-9]\\d{0,13})(?:\\.\\d{1,6})?$",
      "type": "string"
     },
     "checkout_url": {
      "format": "uri",
      "type": "string"
     },
     "currency": {
      "const": "USD",
      "type": "string"
     },
     "duplicate": {
      "type": "boolean"
     },
     "expires_at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     "funding_session_id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "mode": {
      "enum": [
       "test",
       "live"
      ],
      "type": "string"
     },
     "rqm_account_id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "schema_version": {
      "const": "rqm.jobs.funding-session.v1",
      "type": "string"
     },
     "status": {
      "enum": [
       "awaiting_payment",
       "credited",
       "failed",
       "expired"
      ],
      "type": "string"
     }
    },
    "required": [
     "schema_version",
     "funding_session_id",
     "rqm_account_id",
     "currency",
     "amount",
     "checkout_url",
     "expires_at",
     "mode",
     "status",
     "duplicate"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "AUTHENTICATION_REQUIRED",
       "MACHINE_AUTHENTICATION_FAILED",
       "MACHINE_AUTHORIZATION_FAILED",
       "ACCOUNT_CORE_UNAVAILABLE",
       "FEATURE_DISABLED",
       "QUOTE_NOT_ENTITLED",
       "QUOTE_IDEMPOTENCY_CONFLICT",
       "QUOTE_NOT_AVAILABLE",
       "QUOTE_REQUEST_INVALID",
       "QUOTE_MISMATCH",
       "PRICE_LIMIT_EXCEEDED",
       "RUNTIME_LIMIT_EXCEEDED",
       "ARTIFACT_PREFERENCE_UNAVAILABLE",
       "INSUFFICIENT_BALANCE",
       "RESERVATION_FAILED",
       "PRODUCT_REJECTED",
       "PRODUCT_UNAVAILABLE",
       "JOB_NOT_FOUND",
       "JOB_NOT_READY",
       "JOB_ACCESS_DENIED",
       "SETTLEMENT_FAILED",
       "FUNDING_UNAVAILABLE",
       "FUNDING_FAILED"
      ],
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retryable": {
      "type": "boolean"
     },
     "schema_version": {
      "const": "rqm.jobs.error.v1",
      "type": "string"
     }
    },
    "required": [
     "schema_version",
     "code",
     "message",
     "retryable"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Create an RQM MCP funding session"
}

   },
   "kinds": {
    "description": "Filter events by kind(s)",
    "items": {
     "enum": [
      "mount",
      "unmount",
      "change",
      "action-start",
      "action-end",
      "action-error"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "limit": {
    "default": 50,
    "description": "Max events to return",
    "type": "number"
   },
   "projectRoot": {
    "description": "Project root path to link runtime data with static analysis",
    "type": "string"
   },
   "storeName": {
    "description": "Store name to query (optional)",
    "type": "string"
   },
   "windowMs": {
    "description": "Time window in milliseconds (from now back)",
    "type": "number"
   }
  },
  "type": "object"
 },

{
 "description": "Execute workflows with Ink rendering, comparison table, and optional AI judge",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compare": {
    "description": "Show comparison summary table (default: true)",
    "type": "boolean"
   },
   "file": {
    "description": "Workflow YAML file path",
    "type": "string"
   },
   "judge": {
    "description": "Enable AI judge to evaluate all steps at end",
    "type": "boolean"
   },
   "judgeTool": {
    "description": "Tool for judging (default: gemini_analyze_text)",
    "type": "string"
   },
   "maxStepTokens": {
    "description": "Max tokens per step (default: 2500)",
    "type": "number"
   },
   "name": {
    "description": "Workflow name to execute",
    "type": "string"
   },
   "projectPath": {
    "type": "string"
   },
   "query": {
    "description": "Input query for the workflow",
    "type": "string"
   },
   "truncateSteps": {
    "description": "Truncate step outputs (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "workflow"
}

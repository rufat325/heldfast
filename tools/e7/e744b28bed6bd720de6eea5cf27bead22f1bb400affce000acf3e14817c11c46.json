{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List conversations"
 },
 "description": "List conversations. Cursor-paginated, newest first. Deleted conversations are never returned.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assigned_to": {
    "description": "Team member id. Negative values are owner-level assignments.",
    "type": "integer"
   },
   "channel": {
    "description": "Channel.",
    "enum": [
     "facebook",
     "instagram",
     "sms",
     "telegram",
     "whatsapp"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Page size, 1 to 100. Default 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "starting_after": {
    "description": "The next_cursor from the previous page.",
    "type": "string"
   },
   "status": {
    "description": "Conversation status.",
    "enum": [
     "active",
     "resolved",
     "pending",
     "archived",
     "escalated"
    ],
    "type": "string"
   },
   "updated_since": {
    "description": "ISO-8601 UTC.",
    "format": "date-time",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_conversations"
}

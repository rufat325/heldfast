{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Tap Screen"
 },
 "description": "Tap at the specified screen coordinates",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "serial": {
    "description": "Device serial number",
    "type": "string"
   },
   "x": {
    "description": "X coordinate",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "y": {
    "description": "Y coordinate",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "x",
   "y"
  ],
  "type": "object"
 },
 "name": "tap",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Human-readable description of the action performed",
    "type": "string"
   },
   "success": {
    "description": "Whether the input action was dispatched to the device",
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 }
}

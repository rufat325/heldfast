{
 "description": "Import a safe HTML subset as a draft. Active content, forms and unsafe URLs are rejected, not sanitised-and-kept. What survives is stored as blocks, so an imported template behaves exactly like an authored one.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "html": {
    "description": "Safe HTML subset",
    "type": "string"
   },
   "message_type": {
    "description": "What it may be used for.",
    "enum": [
     "transactional",
     "marketing"
    ],
    "type": "string"
   },
   "name": {
    "description": "Template name",
    "type": "string"
   },
   "organization_id": {
    "description": "Active organization ID",
    "type": "string"
   },
   "subject": {
    "description": "Subject with declared {{variables}}",
    "type": "string"
   },
   "variables": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Variable name",
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "type": {
       "enum": [
        "string",
        "number",
        "date"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "organization_id",
   "name",
   "message_type",
   "subject",
   "html"
  ],
  "type": "object"
 },
 "name": "commsharbor_template_import_html"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Resolve an exact symbol or base asset and return market rules, ticker, best bid/ask, recent trades, and fees in one read-only call. Exact symbols win; ambiguous assets are never guessed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "depth": {
    "anyOf": [
     {
      "const": 5,
      "type": "number"
     },
     {
      "const": 10,
      "type": "number"
     },
     {
      "const": 20,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     },
     {
      "const": 100,
      "type": "number"
     }
    ],
    "default": 20
   },
   "market": {
    "description": "Exact symbol such as GRAM-USDT, or a base asset such as GRAM",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "precision": {
    "description": "Exact positive decimal string; never use a JSON number",
    "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
    "type": "string"
   }
  },
  "required": [
   "market"
  ],
  "type": "object"
 },
 "name": "xrocket_market_snapshot",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "additionalProperties": false,
    "properties": {
     "actions": {
      "additionalProperties": false,
      "properties": {
       "openXrocket": {
        "additionalProperties": false,
        "properties": {
         "label": {
          "const": "Open xRocket",
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "label",
         "url"
        ],
        "type": "object"
       },
       "tradeWithMcp": {
        "additionalProperties": false,
        "properties": {
         "label": {
          "const": "Trade with MCP",
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "label",
         "url"
        ],
        "type": "object"
       }
      },
      "required": [
       "tradeWithMcp",
       "openXrocket"
      ],
      "type": "object"
     },
     "constraints": {
      "additionalProperties": false,
      "properties": {
       "consistency": {
        "type": "string"
       },
       "decimalValues": {
        "type": "string"
       }
      },
      "required": [
       "decimalValues",
       "consistency"
      ],
      "type": "object"
     },
     "details": {
      "additionalProperties": false,
      "properties": {
       "orderbook": {},
       "recentTrades": {},
       "symbolRules": {},
       "ticker": {},
       "tradeFees": {}
      },
      "required": [
       "symbolRules",
       "ticker",
       "orderbook",
       "recentTrades",
       "tradeFees"
      ],
      "type": "object"
     },
     "environment": {
      "type": "string"
     },
     "retrievedAt": {
      "type": "string"
     },
     "summary": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "required": [
     "environment",
     "retrievedAt",
     "summary",
     "constraints",
     "actions",
     "details"
    ],
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "xRocket market snapshot"
}

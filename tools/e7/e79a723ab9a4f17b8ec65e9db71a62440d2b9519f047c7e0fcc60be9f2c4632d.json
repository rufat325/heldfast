{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Inventory Item"
 },
 "description": "Add a physical asset / gear item to a live event's inventory \u2014 name, category, status (wish_list \u2026 in_use), priority, quantity + quantity needed, unit cost ($), location, project/place links. Requires event_id + name; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category": {
    "maxLength": 80,
    "type": "string"
   },
   "current_location": {
    "maxLength": 200,
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "dimensions": {
    "maxLength": 200,
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "phase": {
    "enum": [
     "pre_production",
     "build",
     "event",
     "strike",
     "post"
    ],
    "type": "string"
   },
   "place_id": {
    "maxLength": 128,
    "type": "string"
   },
   "priority": {
    "enum": [
     "essential",
     "high",
     "medium",
     "low",
     "next_year"
    ],
    "type": "string"
   },
   "project_id": {
    "maxLength": 128,
    "type": "string"
   },
   "qty": {
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "qty_needed": {
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "wish_list",
     "needs_sourced",
     "needs_fixed",
     "needs_transport",
     "ready",
     "in_use",
     "sell_donate",
     "not_available"
    ],
    "type": "string"
   },
   "storage_container": {
    "maxLength": 200,
    "type": "string"
   },
   "subcategory": {
    "maxLength": 80,
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "to_source": {
    "type": "boolean"
   },
   "unit_cost": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "unit_of_measure": {
    "maxLength": 40,
    "type": "string"
   },
   "url": {
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "name"
  ],
  "type": "object"
 },
 "name": "add_inventory_item",
 "title": "Add Inventory Item"
}

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List landing pages"
 },
 "description": "List the landing pages in a workspace, newest first.",
 "inputSchema": {
  "properties": {
   "workspace": {
    "description": "Workspace id. Optional when the account has one workspace; use list_workspaces to resolve otherwise.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_pages",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "description": "Total matching rows across all pages.",
    "type": "integer"
   },
   "error": {
    "additionalProperties": true,
    "description": "Present only when the tool failed (the result is also flagged isError).",
    "properties": {
     "cause": {
      "description": "Machine-readable failure category: invalid_argument, not_found, forbidden, plan_limit, rate_limited, or server_error.",
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retryable": {
      "description": "Whether repeating the same call could succeed.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "next": {
    "description": "URL of the next page, or null on the last page.",
    "type": [
     "string",
     "null"
    ]
   },
   "previous": {
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "blocks": {
       "description": "Block list; present for layout_version 2 pages.",
       "items": {
        "additionalProperties": true,
        "properties": {
         "content": {
          "type": "object"
         },
         "form": {
          "description": "Linked form id for form/signup blocks.",
          "type": [
           "string",
           "null"
          ]
         },
         "hidden": {
          "type": "boolean"
         },
         "id": {
          "type": "string"
         },
         "type": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "created": {
       "type": "string"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "layout_version": {
       "description": "1 = legacy links list, 2 = block builder.",
       "type": "integer"
      },
      "links": {
       "items": {
        "additionalProperties": true,
        "properties": {
         "title": {
          "type": "string"
         },
         "type": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "qr_id": {
       "description": "The page's QR code id (use with download_qr / update_qr_code).",
       "type": [
        "string",
        "null"
       ]
      },
      "share_url": {
       "description": "Live URL of the page.",
       "type": [
        "string",
        "null"
       ]
      },
      "slug": {
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "type": "string"
      },
      "svg": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}

{
 "description": "Changes a user's password using the change password Id. This usually occurs after an email has been sent to the user and they clicked on a link to reset their password.  As of version 1.32.2, prefer sending the changePasswordId in the request body. To do this, omit the first parameter, and set the value in the request body.",
 "inputSchema": {
  "properties": {
   "changePasswordId": {
    "description": "The change password Id used to find the user. This value is generated by FusionAuth once the change password workflow has been initiated.",
    "type": "string"
   },
   "requestBody": {
    "description": "Change password request object.",
    "properties": {
     "applicationId": {
      "format": "uuid",
      "type": "string"
     },
     "changePasswordId": {
      "type": "string"
     },
     "currentPassword": {
      "type": "string"
     },
     "eventInfo": {
      "description": "Information about a user event (login, register, etc) that helps identify the source of the event (location, device type, OS, etc).",
      "properties": {
       "data": {
        "additionalProperties": {
         "type": "object"
        },
        "type": "object"
       },
       "deviceDescription": {
        "type": "string"
       },
       "deviceName": {
        "type": "string"
       },
       "deviceType": {
        "type": "string"
       },
       "ipAddress": {
        "type": "string"
       },
       "location": {
        "description": "Location information. Useful for IP addresses and other displayable data objects.",
        "properties": {
         "city": {
          "type": "string"
         },
         "country": {
          "type": "string"
         },
         "displayString": {
          "type": "string"
         },
         "latitude": {
          "format": "double",
          "type": "number"
         },
         "longitude": {
          "format": "double",
          "type": "number"
         },
         "region": {
          "type": "string"
         },
         "zipcode": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "os": {
        "type": "string"
       },
       "userAgent": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "loginId": {
      "type": "string"
     },
     "loginIdTypes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "password": {
      "type": "string"
     },
     "refreshToken": {
      "type": "string"
     },
     "trustChallenge": {
      "type": "string"
     },
     "trustToken": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "changePasswordId"
  ],
  "type": "object"
 },
 "name": "changePasswordWithId"
}

       "master_klarman",
       "master_pabrai",
       "master_ackman",
       "master_damodaran",
       "master_taleb",
       "master_natenberg",
       "master_sinclair",
       "master_bogle"
      ],
      "type": "string"
     },
     "position_intent": {
      "enum": [
       "would_buy",
       "would_add",
       "would_hold",
       "would_watch",
       "would_pass",
       "would_avoid",
       "not_in_my_circle",
       "inputs_unavailable"
      ],
      "type": "string"
     },
     "source_ids": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "stance": {
      "enum": [
       "constructive",
       "cautious",
       "opposed",
       "out_of_scope"
      ],
      "type": "string"
     },
     "summary": {

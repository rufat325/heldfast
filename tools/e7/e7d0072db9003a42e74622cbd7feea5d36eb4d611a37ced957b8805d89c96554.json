       },
       "what_changes_my_mind": {
        "minLength": 1,
        "type": "string"
       },
       "what_i_see": {
        "minLength": 1,
        "type": "string"
       },
       "where_i_disagree": {
        "minLength": 1,
        "type": "string"
       },
       "would_i_act": {
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },

     "master_klarman",
     "master_pabrai",
     "master_ackman",
     "master_damodaran",
     "master_taleb",
     "master_natenberg",
     "master_sinclair",
     "master_bogle"
    ],
    "type": "string"
   },
   "packet": {
    "description": "Current physical v3 seats require the five-field first-person public-method voice contract; acknowledged_stance MUST be one of constructive | cautious | opposed | out_of_scope and match the frozen stance returned by plan_visible_run. The legacy stance/verdict/summary shape remains accepted only for a legacy seat.",
    "properties": {
     "acknowledged_stance": {
      "enum": [
       "constructive",
       "cautious",
       "opposed",
       "out_of_scope"
      ],
      "type": "string"
     },
     "confidence": {
      "enum": [
       "high",
       "medium",
       "low"
      ],
      "type": "string"
     },
     "disagreements": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "disclosure_ack": {
      "const": "alphacouncil.first_person_public_method_simulation.v1",
      "type": "string"
     },
     "key_findings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "master": {
      "enum": [
       "master_buffett",
       "master_graham",
       "master_simons",
       "master_soros",
       "master_cathie_wood",
       "master_druckenmiller",
       "master_fisher",
       "master_munger",
       "master_thorp",
       "master_asness",
       "master_dalio",
       "master_duan_yongping",
       "master_jhunjhunwala",
       "master_lynch",
       "master_forensic_short",
       "master_li_lu",

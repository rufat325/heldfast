{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Update a dated project event"
 },
 "description": "Correct or enrich a project timeline event \u2014 its title, description, category, dates, impact note or link. Use this instead of logging a duplicate event when the facts change.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "enum": [
     "change",
     "launch",
     "incident",
     "external",
     "milestone"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "ends_on": {
    "description": "YYYY-MM-DD, for a period. Empty string clears it.",
    "type": "string"
   },
   "event_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "impact": {
    "type": "string"
   },
   "occurred_on": {
    "description": "YYYY-MM-DD.",
    "type": "string"
   },
   "task_id": {
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "event_id"
  ],
  "type": "object"
 },
 "name": "update_project_event",
 "title": "Update a dated project event"
}

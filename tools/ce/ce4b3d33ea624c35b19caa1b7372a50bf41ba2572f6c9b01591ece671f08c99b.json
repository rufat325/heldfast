{
 "description": "Estimate the cost of a single LLM call for one model from known or estimated token counts. Offline, no keys.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "charsPerToken": {
    "description": "Override the chars-per-token heuristic divisor.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "expectedOutputText": {
    "description": "Expected output text; estimated if outputTokens is absent.",
    "maxLength": 2000000,
    "type": "string"
   },
   "inputText": {
    "description": "Prompt text; estimated to tokens if inputTokens is absent.",
    "maxLength": 2000000,
    "type": "string"
   },
   "inputTokens": {
    "description": "Exact input tokens; optional if inputText is given.",
    "minimum": 0,
    "type": "integer"
   },
   "model": {
    "description": "Model alias or full id, e.g. \"sonnet\" or \"claude-sonnet-4-6\".",
    "type": "string"
   },
   "outputTokens": {
    "description": "Exact output tokens; defaults to the model output cap.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "model"
  ],
  "type": "object"
 },
 "name": "estimate_cost",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "type": "string"
   },
   "breakdown": {
    "additionalProperties": false,
    "properties": {
     "inputUsd": {
      "type": "number"
     },
     "outputUsd": {
      "type": "number"
     }
    },
    "required": [
     "inputUsd",
     "outputUsd"
    ],
    "type": "object"
   },
   "catalogVersion": {
    "type": "string"
   },
   "cost": {
    "additionalProperties": false,
    "properties": {
     "cents": {
      "type": "number"
     },
     "usd": {
      "type": "number"
     },
     "usdMicros": {
      "type": "number"
     }
    },
    "required": [
     "usd",
     "usdMicros",
     "cents"
    ],
    "type": "object"
   },
   "inputTokens": {
    "type": "number"
   },
   "model": {
    "type": "string"
   },
   "outputTokens": {
    "type": "number"
   },
   "pricing": {
    "additionalProperties": false,
    "properties": {
     "inputPerMillion": {
      "type": "number"
     },
     "outputPerMillion": {
      "type": "number"
     }
    },
    "required": [
     "inputPerMillion",
     "outputPerMillion"
    ],
    "type": "object"
   },
   "provider": {
    "type": "string"
   },
   "tier": {
    "type": "string"
   },
   "tokensWereEstimated": {
    "type": "boolean"
   }
  },
  "required": [
   "model",
   "provider",
   "tier",
   "inputTokens",
   "outputTokens",
   "tokensWereEstimated",
   "cost",
   "breakdown",
   "pricing",
   "catalogVersion",
   "asOf"
  ],
  "type": "object"
 },
 "title": "Estimate cost"
}

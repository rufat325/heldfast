{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compute a complete natal (birth) chart: the ten classical bodies plus lunar\nnodes, Lilith, Chiron and the four major asteroids, house cusps, Ascendant and Midheaven, the Part of Fortune,\nand all aspects.\n\nAccepts local birth time directly when given the IANA timezone \u2014 no manual UTC\nconversion needed. Supports tropical (Western) and sidereal (Vedic/Lahiri,\nFagan-Bradley) zodiacs.\n\nExamples:\n  - \"Chart for 15 March 1990, 3:45pm in Riga\" ->\n    { datetime: \"1990-03-15T15:45\", timezone: \"Europe/Riga\", latitude: 56.95, longitude: 24.11 }\n  - Vedic chart: add { zodiac: \"sidereal-lahiri\" }\n\nReturns: positions (13 points), houses (12 cusps + angles), the Part of\nFortune (classical day/night formula, with the dayChart flag showing which\napplied), aspects, and the ayanamsa applied (0 for tropical).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "datetime": {
    "description": "Birth date and time.",
    "minLength": 4,
    "type": "string"
   },
   "house_system": {
    "default": "whole-sign",
    "description": "House system: whole-sign (default), equal, porphyry, or placidus.",
    "enum": [
     "whole-sign",
     "equal",
     "porphyry",
     "placidus"
    ],
    "type": "string"
   },
   "latitude": {
    "description": "Geographic latitude in degrees, positive north (-90 to 90).",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Geographic longitude in degrees, positive east (-180 to 180).",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "timezone": {
    "description": "IANA timezone the datetime is local to, e.g. \"Europe/Riga\" or \"America/New_York\". Omit when the datetime already carries Z or a UTC offset.",
    "minLength": 1,
    "type": "string"
   },
   "zodiac": {
    "default": "tropical",
    "description": "Zodiac frame: tropical (Western default), sidereal-lahiri (Vedic), or sidereal-fagan-bradley (Western sidereal).",
    "enum": [
     "tropical",
     "sidereal-lahiri",
     "sidereal-fagan-bradley"
    ],
    "type": "string"
   }
  },
  "required": [
   "datetime",
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
 "name": "compute_natal_chart",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "angle": {
       "type": "number"
      },
      "aspect": {
       "type": "string"
      },
      "body1": {
       "type": "string"
      },
      "body2": {
       "type": "string"
      },
      "orb": {
       "type": "number"
      }
     },
     "required": [
      "body1",
      "body2",
      "aspect",
      "angle",
      "orb"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ayanamsa": {
    "type": "number"
   },
   "houses": {
    "additionalProperties": false,
    "properties": {
     "ascendant": {
      "type": "number"
     },
     "cusps": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "midheaven": {
      "type": "number"
     },
     "note": {
      "type": "string"
     },
     "system": {
      "type": "string"
     }
    },
    "required": [
     "system",
     "cusps",
     "ascendant",
     "midheaven"
    ],
    "type": "object"
   },
   "location": {
    "additionalProperties": false,
    "properties": {
     "latitude": {
      "type": "number"
     },
     "longitude": {
      "type": "number"
     }
    },
    "required": [
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "partOfFortune": {
    "additionalProperties": false,
    "properties": {
     "dayChart": {
      "type": "boolean"
     },
     "degreeInSign": {
      "type": "number"
     },
     "longitude": {
      "type": "number"
     },
     "sign": {
      "type": "string"
     }
    },
    "required": [
     "longitude",
     "sign",
     "degreeInSign",
     "dayChart"
    ],
    "type": "object"
   },
   "positions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "declination": {
       "type": "number"
      },
      "degreeInSign": {
       "type": "number"
      },
      "latitude": {
       "type": "number"
      },
      "longitude": {
       "type": "number"
      },
      "retrograde": {
       "type": "boolean"
      },
      "sign": {
       "type": "string"
      },
      "speed": {
       "type": "number"
      }
     },
     "required": [
      "body",
      "longitude",
      "sign",
      "degreeInSign",
      "speed",
      "retrograde",
      "declination",
      "latitude"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "utc": {
    "type": "string"
   },
   "zodiac": {
    "type": "string"
   }
  },
  "required": [
   "utc",
   "location",
   "zodiac",
   "ayanamsa",
   "positions",
   "houses",
   "partOfFortune",
   "aspects"
  ],
  "type": "object"
 },
 "title": "Compute Natal Chart"
}

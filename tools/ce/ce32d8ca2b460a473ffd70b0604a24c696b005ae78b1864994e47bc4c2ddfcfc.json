 "description": "Find aircraft currently airborne in a geographic area, by bounding box. LIVE ADS-B data, no key required. Returns per aircraft: ICAO24 hex, callsign, registration (tail number), aircraft type, position, altitude, ground speed, heading, vertical rate, squawk, and any emergency code. Use for \"what planes are over <place> right now\", \"aircraft near <airport>\", \"is anything squawking 7700 near X\". For one known aircraft use get_aircraft; for what route a callsign flies use get_flight_route.",
 "inputSchema": {
  "examples": [
   {
    "lamax": 40.8,
    "lamin": 40.6,
    "lomax": -73.8,
    "lomin": -74
   },
   {
    "lamax": 51.6,
    "lamin": 51.4,
    "lomax": -0.2,
    "lomin": -0.5
   }
  ],
  "properties": {
   "lamax": {
    "description": "Maximum (north) latitude of the bounding box, degrees",
    "type": "number"
   },
   "lamin": {
    "description": "Minimum (south) latitude of the bounding box, degrees",
    "type": "number"
   },
   "limit": {
    "description": "Max aircraft to return (1-500, default 200), nearest the box centre first.",
    "type": "number"
   },
   "lomax": {
    "description": "Maximum (east) longitude of the bounding box, degrees",
    "type": "number"
   },
   "lomin": {
    "description": "Minimum (west) longitude of the bounding box, degrees",
    "type": "number"
   }
  },
  "required": [
   "lamin",
   "lomin",
   "lamax",
   "lomax"
  ],
  "type": "object"
 },
 "name": "get_flights_in_area",

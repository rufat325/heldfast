 "description": "Look up a specific DNS record type for a domain. Specify record type (e.g., 'A', 'MX', 'TXT', 'CNAME'). Returns records with TTLs and data values.",
 "inputSchema": {
  "examples": [
   {
    "domain": "example.com"
   },
   {
    "domain": "mail.google.com",
    "type": "MX"
   }
  ],
  "properties": {
   "domain": {
    "description": "Domain name to look up (e.g., \"example.com\", \"mail.google.com\")",
    "type": "string"
   },
   "type": {
    "description": "DNS record type to query (e.g., \"A\", \"AAAA\", \"MX\", \"NS\", \"TXT\", \"CNAME\", \"SOA\"). Defaults to \"A\".",
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "dns_lookup",
 "outputSchema": {

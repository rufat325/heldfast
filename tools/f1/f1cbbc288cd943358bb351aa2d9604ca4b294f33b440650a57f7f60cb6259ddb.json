{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a bounded answer from retrieved public evidence. Every readable factual statement is copied from validated evidence and linked to its source.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "question": {
    "maxLength": 2000,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "type": "object"
 },
 "name": "ask_spot",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "answer": {
    "type": "string"
   },
   "claims": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "citations": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "evidenceId": {
          "type": "string"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "evidenceId",
         "title",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "evidenceIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text",
      "evidenceIds",
      "citations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limitation": {
    "type": "string"
   },
   "qualifications": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "citations": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "evidenceId": {
          "type": "string"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "evidenceId",
         "title",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "evidenceIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text",
      "evidenceIds",
      "citations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reason": {
    "enum": [
     "insufficient_evidence",
     "unsupported_request",
     "inference_unavailable",
     "quota_unavailable",
     "generation_failed",
     "generation_timeout",
     "invalid_citations",
     "client_rate_limit",
     "daily_generation_limit"
    ],
    "type": "string"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "evidenceId": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "evidenceId",
      "title",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "spotCallout": {
    "type": "string"
   },
   "status": {
    "enum": [
     "answered",
     "insufficient_evidence",
     "unsupported",
     "limited",
     "unavailable"
    ],
    "type": "string"
   },
   "unansweredQuestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "spotCallout",
   "status",
   "answer",
   "claims",
   "qualifications",
   "unansweredQuestions",
   "sources"
  ],
  "type": "object"
 },
 "title": "Ask Spot from published evidence"
}

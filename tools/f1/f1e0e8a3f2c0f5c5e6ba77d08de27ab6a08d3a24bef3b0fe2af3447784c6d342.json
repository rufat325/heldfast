{
 "annotations": {
  "openWorldHint": true,
  "title": "Generate featured images (bulk)"
 },
 "description": "Generate AI featured images for multiple pages in one async job. 1 credit per page. Max 50 pages. Pages must be rewritten. Returns a job_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "page_ids": {
    "description": "Array of page UUIDs (must be rewritten first)",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "page_ids"
  ],
  "type": "object"
 },
 "name": "generate_image_bulk"
}

  "properties": {
   "currency": {
    "description": "e.g. USD, ETH, BTC.",
    "type": "string"
   }
  },
  "required": [
   "currency"
  ],
  "type": "object"
 },
 "name": "hubvibe_market_rates",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get formatted context for a specific topic by searching and retrieving relevant sessions.",
 "inputSchema": {
  "properties": {
   "max_sessions": {
    "default": 3,
    "description": "Maximum number of sessions to include (default: 3)",
    "type": "number"
   },
   "project": {
    "description": "Optional filter by project",
    "type": "string"
   },
   "status": {
    "description": "Optional filter by metadata.status (e.g. \"laufend\", \"abgeschlossen\").",
    "type": "string"
   },
   "tags": {
    "description": "Filter by metadata tags (match any).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "topic": {
    "description": "Topic to get context for.",
    "type": "string"
   }
  },
  "required": [
   "topic"
  ],
  "type": "object"
 },
 "name": "palim_get_context",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "message": {
    "description": "Human-readable tool result text.",
    "type": "string"
   }
  },
  "required": [
   "message"
  ],
  "type": "object"
 }
}

 "description": "Retrieve filing history for a UK company by company_number (from search_companies). Returns up to 25 filings per page \u2014 each with category, type, description, filing date, action date, transaction ID, page count, and document metadata URL. Filter by category (accounts | confirmation-statement | officers | etc.).",
 "inputSchema": {
  "examples": [
   {
    "company_number": "00006245"
   },
   {
    "category": "accounts",
    "company_number": "00006245",
    "items_per_page": 25
   }
  ],
  "properties": {
   "category": {
    "description": "Optional filter (accounts | confirmation-statement | officers | etc.)",
    "type": "string"
   },
   "company_number": {
    "description": "UK company number (e.g. \"07098618\") OR the company NAME (e.g. \"Ocado Group\") \u2014 a name is resolved here automatically and the match is echoed back as resolved_from_name. Pass whichever you have; do not guess a number from memory, since a plausible wrong one returns a clean empty result that reads as \"nothing filed\" for a company that may not exist.",
    "type": "string"
   },
   "items_per_page": {
    "description": "1-100 (default 25)",
    "type": "number"
   },
   "start_index": {
    "description": "Pagination offset (default 0)",
    "type": "number"
   }
  },
  "required": [
   "company_number"
  ],
  "type": "object"
 },
 "name": "get_filings",
 "outputSchema": {
  "properties": {
   "company_number": {
    "description": "UK company number",
    "type": "string"
   },
   "filings": {
    "description": "List of filing history records",
    "items": {
     "properties": {
      "action_date": {
       "description": "Action date (ISO format)",
       "type": [
        "string",

       ]
      },
      "description": {
       "description": "Filing description",
       "type": [
        "string",
        "null"
       ]
      },
      "document_metadata": {
       "description": "Link to document metadata",
       "type": [
        "string",
        "null"
       ]
      },
      "filed_on": {
       "description": "Filing date (ISO format)",
       "type": [
        "string",
        "null"
       ]
      },
      "pages": {
       "description": "Number of pages in filing",
       "type": [
        "number",
        "null"
       ]
      },
      "transaction_id": {
       "description": "Filing transaction ID",
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "description": "Filing type",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "resolved_from_name": {
    "description": "Present only when a NAME was passed instead of a number. Shows which company answered, so a caller can see the resolution rather than assume it.",
    "properties": {
     "company_name": {
      "description": "Official name of the matched company.",
      "type": "string"
     },
     "company_number": {
      "description": "The number it resolved to.",
      "type": "string"
     },
     "resolved_from": {
      "description": "The name the caller passed.",
      "type": "string"
     },
     "status": {
      "description": "Company status; an active match is preferred over a dissolved namesake.",
      "type": "string"
     }

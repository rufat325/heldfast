 },
 "description": "Calculate Luxembourg mortgage affordability and state whether the property-price ceiling includes every acquisition cost or only currently known costs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "annualNetIncome": {
    "description": "User-confirmed annual household net income",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "bellegenAktCreditAvailable": {
    "description": "Aggregate unused B\u00ebllegen Akt balance explicitly confirmed for the acquirers",
    "minimum": 0,
    "type": "number"
   },
   "bellegenAktEligibleBuyers": {
    "description": "Explicitly confirmed eligible acquirer count",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "employmentType": {
    "enum": [
     "salaried",
     "self_employed",
     "civil_servant"
    ],
    "type": "string"
   },
   "energyClassDiscountPct": {
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "floodZoneRateAdjustmentPct": {
    "maximum": 3,
    "minimum": 0,
    "type": "number"
   },
   "householdType": {
    "enum": [
     "single",
     "couple"
    ],
    "type": "string"
   },
   "isFirstTimeBuyer": {
    "default": false,
    "description": "Deprecated optional compatibility signal; never proves B\u00ebllegen entitlement",
    "type": "boolean"
   },
   "isPersonalResidence": {
    "description": "Deprecated residence-use compatibility flag; prefer residenceUse",
    "type": "boolean"
   },
   "loanTermYears": {
    "maximum": 35,
    "minimum": 5,
    "type": "integer"
   },
   "marketRate": {
    "exclusiveMinimum": 0,
    "maximum": 15,
    "type": "number"
   },
   "maxDebtToIncomeRatio": {
    "description": "Explicit housing-payment share of net income, e.g. 0.35",
    "exclusiveMinimum": 0,
    "maximum": 0.6,
    "type": "number"
   },
   "monthlyDebts": {
    "default": 0,
    "description": "Existing monthly debt payments",
    "minimum": 0,
    "type": "number"
   },
   "residenceUse": {
    "description": "Residence use; omitted or unknown preserves an unconfirmed B\u00ebllegen position",
    "enum": [
     "unknown",
     "primary",
     "other"
    ],
    "type": "string"
   },
   "residencyType": {
    "enum": [
     "luxembourg",
     "cross_border_fr",
     "cross_border_be",
     "cross_border_de"
    ],
    "type": "string"
   },
   "savingsAvailable": {
    "description": "Available savings/down payment",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "annualNetIncome",
   "maxDebtToIncomeRatio",
   "savingsAvailable",
   "householdType",
   "employmentType",
   "residencyType"
  ],
  "type": "object"
 },
 "name": "get_affordability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "confidence": {
    "type": "string"
   },
   "freshness": {
    "type": "string"
   },
   "maxPropertyPrice": {
    "type": "number"
   },
   "maxPropertyPriceCostBasis": {
    "enum": [
     "complete",
     "known_costs_only"
    ],
    "type": "string"
   },
   "trust": {

     },
     "generatedAt": {
      "type": "string"
     },
     "missingFields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sources",
     "confidence",
     "freshness"
    ],
    "type": "object"
   }
  },
  "required": [
   "maxPropertyPrice",
   "maxPropertyPriceCostBasis",
   "confidence",
   "freshness",
   "trust"
  ],
  "type": "object"
 },

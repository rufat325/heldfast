{
 "description": "Return the model catalog with pricing, optionally filtered. capabilities are arrays. Offline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "description": "Require a capability.",
    "enum": [
     "chat",
     "tools",
     "vision",
     "streaming"
    ],
    "type": "string"
   },
   "includeLocal": {
    "description": "Include local / self-hosted $0 models (off by default).",
    "type": "boolean"
   },
   "maxInputPerMillion": {
    "description": "Only models at or below this input price per 1M tokens.",
    "minimum": 0,
    "type": "number"
   },
   "provider": {
    "description": "Filter to a single provider.",
    "enum": [
     "anthropic",
     "gemini",
     "openai",
     "local"
    ],
    "type": "string"
   },
   "tier": {
    "description": "Filter to a single tier.",
    "enum": [
     "trivial",
     "fast",
     "standard",
     "reasoning"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_models",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "type": "string"
   },
   "catalogVersion": {
    "type": "string"
   },
   "count": {
    "type": "number"
   },
   "models": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "alias": {
       "type": "string"
      },
      "capabilities": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "inputPerMillion": {
       "type": "number"
      },
      "license": {
       "type": "string"
      },
      "outputCap": {
       "type": "number"
      },
      "outputPerMillion": {
       "type": "number"
      },
      "provider": {
       "type": "string"
      },
      "tier": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "alias",
      "provider",
      "tier",
      "capabilities",
      "inputPerMillion",
      "outputPerMillion"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "type": "string"
   }
  },
  "required": [
   "models",
   "count",
   "catalogVersion",
   "asOf",
   "source"
  ],
  "type": "object"
 },
 "title": "List models / pricing"
}

 "description": "Get details for OpenStreetMap locations by ID (e.g., \"N123456\" for node, \"W654321\" for way, \"R111\" for relation). Returns coordinates, names, and metadata.",
 "inputSchema": {
  "examples": [
   {
    "ids": "N123456,W654321"
   },
   {
    "ids": "R111"
   }
  ],
  "properties": {
   "ids": {
    "description": "Comma-separated list of OSM IDs with type prefix (e.g. \"N123456,W654321\"). N=node, W=way, R=relation.",
    "type": "string"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "lookup",
 "outputSchema": {

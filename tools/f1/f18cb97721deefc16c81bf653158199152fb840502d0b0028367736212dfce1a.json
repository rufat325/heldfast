{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Formats files with Prettier (--write) and returns a structured list of changed files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cache": {
    "description": "Cache formatted files for faster subsequent runs (maps to --cache)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "config": {
    "description": "Path to a Prettier configuration file (maps to --config)",
    "maxLength": 4096,
    "type": "string"
   },
   "endOfLine": {
    "description": "Line ending style override",
    "enum": [
     "lf",
     "crlf",
     "cr",
     "auto"
    ],
    "type": "string"
   },
   "ignoreUnknown": {
    "description": "Ignore files that cannot be parsed (maps to --ignore-unknown)",
    "type": "boolean"
   },
   "logLevel": {
    "description": "Log level to control output verbosity",
    "enum": [
     "silent",
     "error",
     "warn",
     "log",
     "debug"
    ],
    "type": "string"
   },
   "noConfig": {
    "description": "Do not look for a configuration file (maps to --no-config)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "."
    ],
    "description": "File patterns to format (default: ['.'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "printWidth": {
    "description": "The line length where Prettier will try to wrap",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "singleQuote": {
    "description": "Use single quotes instead of double quotes where possible",
    "type": "boolean"
   },
   "tabWidth": {
    "description": "Number of spaces per indentation level (maps to --tab-width)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "trailingComma": {
    "description": "Print trailing commas wherever possible",
    "enum": [
     "all",
     "es5",
     "none"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "prettier-format",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "errorMessage": {
    "type": "string"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filesChanged": {
    "type": "number"
   },
   "filesTruncated": {
    "type": "boolean"
   },
   "filesUnchanged": {
    "type": "number"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "filesChanged",
   "success"
  ],
  "type": "object"
 },
 "title": "Prettier Format"
}

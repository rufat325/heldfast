{
 "description": "Create an alert rule, including optional severity-threshold lifecycle scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "channel": {
    "type": "string"
   },
   "conditionType": {
    "type": "string"
   },
   "config": {
    "additionalProperties": {},
    "type": "object"
   },
   "cooldownSeconds": {
    "maximum": 604800,
    "minimum": 0,
    "type": "integer"
   },
   "isEnabled": {
    "type": "boolean"
   },
   "projectId": {
    "type": "string"
   },
   "serviceId": {
    "type": "string"
   },
   "severityLifecycleScope": {
    "enum": [
     "new_incident",
     "incident_regressed",
     "both"
    ],
    "type": "string"
   },
   "severityMin": {
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "channel",
   "conditionType",
   "config"
  ],
  "type": "object"
 },
 "name": "create_alert"
}

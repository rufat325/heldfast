{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Compose a Tewdy quote request from the user's description. Returns a deep link to the Tewdy app with all fields pre-filled; the user reviews and clicks publish to actually post the request. This tool deliberately does not auto-post \u2014 quote acceptance and payment confirmation always happen on tewdy.com via deep link, never in chat. Requires authentication.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget_max": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "budget_min": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "category": {
    "maxLength": 120,
    "type": "string"
   },
   "currency": {
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "location_name": {
    "maxLength": 200,
    "type": "string"
   },
   "preferred_date": {
    "maxLength": 40,
    "type": "string"
   },
   "urgency": {
    "enum": [
     "urgent",
     "normal",
     "flexible"
    ],
    "type": "string"
   }
  },
  "required": [
   "description"
  ],
  "type": "object"
 },
 "name": "request_quote",
 "title": "Request a quote"
}

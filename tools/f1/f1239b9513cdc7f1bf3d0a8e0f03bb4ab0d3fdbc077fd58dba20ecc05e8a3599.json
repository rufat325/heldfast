{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Place"
 },
 "description": "Add a place / location to a live event \u2014 a build site, zone, or venue area (name, structure, sector, lifecycle + build status, parent place, budgets, start date). Requires event_id + name; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_allocated": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "budget_requested": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "build_status": {
    "enum": [
     "not_started",
     "surveyed",
     "staged",
     "built",
     "systemized",
     "designed",
     "complete"
    ],
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "lifecycle_status": {
    "enum": [
     "new",
     "exploring",
     "repeating",
     "improving",
     "removing"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "name_alt": {
    "maxLength": 200,
    "type": "string"
   },
   "parent_place_id": {
    "maxLength": 128,
    "type": "string"
   },
   "sector": {
    "maxLength": 80,
    "type": "string"
   },
   "start_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "structure": {
    "maxLength": 200,
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "event_id",
   "name"
  ],
  "type": "object"
 },
 "name": "add_place",
 "title": "Add Place"
}

{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare static analysis graph with runtime event data to find stores declared in the static graph but not observed in this runtime session, and stores seen at runtime but absent from the static graph (dynamic or unscanned). Use after running the app to verify instrumentation completeness. Example: {} or {projectRoot: \"/path/to/project\"}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "projectRoot": {
    "description": "Project root path (uses first configured root if omitted)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "nanostores_runtime_coverage",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "report": {
    "additionalProperties": false,
    "properties": {
     "coverageByKind": {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "covered": {
         "type": "number"
        },
        "total": {
         "type": "number"
        }
       },
       "required": [
        "total",
        "covered"
       ],
       "type": "object"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "coveredCount": {
      "type": "number"
     },
     "projectRoot": {
      "type": "string"
     },
     "runtimeOnlyCount": {
      "type": "number"
     },
     "runtimeStoreCount": {
      "type": "number"
     },
     "staticOnlyCount": {
      "type": "number"
     },
     "staticStoreCount": {
      "type": "number"
     },
     "stores": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "file": {
         "type": "string"
        },
        "inRuntime": {
         "type": "boolean"
        },
        "inStaticGraph": {
         "type": "boolean"
        },
        "kind": {
         "type": "string"
        },
        "runtimeChanges": {
         "type": "number"
        },
        "runtimeMounts": {
         "type": "number"
        },
        "storeId": {
         "type": "string"
        },
        "storeName": {
         "type": "string"
        }
       },
       "required": [
        "storeName",
        "inStaticGraph",
        "inRuntime"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "projectRoot",
     "staticStoreCount",
     "runtimeStoreCount",
     "coveredCount",
     "staticOnlyCount",
     "runtimeOnlyCount",
     "coverageByKind",
     "stores"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "summary",
   "report"
  ],
  "type": "object"
 },
 "title": "Runtime coverage report"
}

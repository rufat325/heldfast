{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Genetic Algorithm (discrete + multi-objective)"
 },
 "description": "Run a genetic algorithm over a fixed-length gene vector (binary, integer, real, or permutation bounds) against a weighted-sum fitness, with an optional Pareto frontier for multi-objective runs. Use for discrete or mixed search spaces (feature selection, integer allocation, permutation/TSP-style problems) or when you want several non-dominated solutions. Returns the best chromosome and fitness, the Pareto frontier when applicable, the convergence generation, total generations, and recent fitness history; results vary run to run (stochastic). For smooth continuous objectives, use optimize_cmaes.",
 "inputSchema": {
  "properties": {
   "bounds": {
    "properties": {
     "max": {
      "description": "Per-gene upper bound.",
      "type": "number"
     },
     "min": {
      "description": "Per-gene lower bound.",
      "type": "number"
     },
     "type": {
      "description": "Default: real.",
      "enum": [
       "binary",
       "integer",
       "real",
       "permutation"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "crossoverMethod": {
    "description": "Default: single-point.",
    "enum": [
     "single-point",
     "two-point",
     "uniform"
    ],
    "type": "string"
   },
   "crossoverRate": {
    "description": "Crossover probability (default: 0.8).",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "fitnessWeights": {
    "description": "Per-gene weights in the default linear fitness sum. Length should equal geneLength.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "geneLength": {
    "description": "Number of genes (variables) per chromosome.",
    "minimum": 1,
    "type": "integer"
   },
   "maxGenerations": {
    "description": "Default: 100, capped at 500.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "mutationRate": {
    "description": "Per-gene mutation probability (default: 0.01).",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "populationSize": {
    "description": "Default: 100, capped at 500.",
    "maximum": 500,
    "minimum": 2,
    "type": "integer"
   },
   "selectionMethod": {
    "description": "Default: tournament.",
    "enum": [
     "tournament",
     "roulette",
     "rank"
    ],
    "type": "string"
   }
  },
  "required": [
   "geneLength"
  ],
  "type": "object"
 },
 "name": "optimize_evolve",
 "outputSchema": {
  "properties": {
   "bestChromosome": {
    "properties": {
     "fitness": {
      "type": "number"
     },
     "genes": {
      "items": {
       "type": "number"
      },
      "type": "array"
     }
    },
    "required": [
     "genes",
     "fitness"
    ],
    "type": "object"
   },
   "convergenceGeneration": {
    "description": "Generation at which best fitness stopped improving.",
    "type": "integer"
   },
   "executionTimeMs": {
    "type": "number"
   },
   "fitnessHistory": {
    "description": "Last 20 generations' best fitness.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "paretoFrontier": {
    "description": "Non-dominated solutions (multi-objective only).",
    "items": {
     "properties": {
      "fitness": {
       "type": "number"
      },
      "genes": {
       "items": {
        "type": "number"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "totalGenerations": {
    "type": "integer"
   }
  },
  "required": [
   "bestChromosome",
   "totalGenerations"
  ],
  "type": "object"
 }
}

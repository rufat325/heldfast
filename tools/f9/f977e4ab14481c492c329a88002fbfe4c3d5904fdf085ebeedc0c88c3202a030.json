{
 "description": "Ejecuta una secuencia de requests en orden. Extrae variables de cada respuesta para usar en pasos siguientes con {{variable}}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "steps": {
    "description": "Pasos a ejecutar en orden",
    "items": {
     "additionalProperties": false,
     "properties": {
      "auth": {
       "additionalProperties": false,
       "description": "Autenticaci\u00f3n",
       "properties": {
        "header": {
         "description": "Header name para API key (default: X-API-Key)",
         "type": "string"
        },
        "key": {
         "description": "API key value",
         "type": "string"
        },
        "password": {
         "description": "Password para Basic auth",
         "type": "string"
        },
        "token": {
         "description": "Token para Bearer auth",
         "type": "string"
        },
        "type": {
         "description": "Tipo de autenticaci\u00f3n",
         "enum": [
          "bearer",
          "api-key",
          "basic"
         ],
         "type": "string"
        },
        "username": {
         "description": "Username para Basic auth",
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      "body": {
       "description": "Body del request"
      },
      "extract": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Variables a extraer de la respuesta para pasos siguientes. Key = nombre variable, value = path (ej: { \"TOKEN\": \"body.token\", \"USER_ID\": \"body.data.id\" })",
       "type": "object"
      },
      "headers": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Headers HTTP",
       "type": "object"
      },
      "method": {
       "description": "HTTP method",
       "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
       ],
       "type": "string"
      },
      "name": {
       "description": "Nombre del paso (ej: \"login\", \"crear-post\")",
       "type": "string"
      },
      "query": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Query parameters",
       "type": "object"
      },
      "url": {
       "description": "URL del endpoint",
       "type": "string"
      }
     },
     "required": [
      "name",
      "method",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "stop_on_error": {
    "description": "Detener al primer error (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "steps"
  ],
  "type": "object"
 },
 "name": "flow_run"
}

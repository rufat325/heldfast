{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "When you need to trace what recomputes if X changes, call this once \u2014 not nanostores_store_summary on each downstream store. Returns the full ordered downstream chain in a single response: computed stores that depend on X at hop 1, their dependents at hop 2, and so on. Subscribers appear at the same hop as the store they react to. Use nanostores_store_subgraph instead when you also need upstream ancestors (BFS in both directions). Example: {name: \"$isLoggedIn\"} returns every computed store and subscriber that recomputes when $isLoggedIn changes, ordered by distance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Store name. Used if storeId is not provided.",
    "type": "string"
   },
   "projectRoot": {
    "description": "Project root path (uses default if omitted)",
    "type": "string"
   },
   "storeId": {
    "description": "Exact store id. If provided, takes priority.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "nanostores_store_impact",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hops": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "derivedStores": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "file": {
          "type": "string"
         },
         "id": {
          "type": "string"
         },
         "kind": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "valueType": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "kind",
         "file"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "hop": {
       "type": "number"
      },
      "subscribers": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "file": {
          "type": "string"
         },
         "id": {
          "type": "string"
         },
         "kind": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "kind",
         "file"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "hop",
      "derivedStores",
      "subscribers"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sourceName": {
    "type": "string"
   },
   "sourceStoreId": {
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "maxHops": {
      "type": "number"
     },
     "totalAffectedStores": {
      "type": "number"
     },
     "totalAffectedSubscribers": {
      "type": "number"
     }
    },
    "required": [
     "totalAffectedStores",
     "totalAffectedSubscribers",
     "maxHops"
    ],
    "type": "object"
   }
  },
  "required": [
   "sourceStoreId",
   "hops",
   "summary"
  ],
  "type": "object"
 },
 "title": "Get store impact chain"
}

{
 "description": "Batch moderate comments by status",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ids": {
    "description": "Comment IDs",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "New status",
    "enum": [
     "approve",
     "hold",
     "spam",
     "trash"
    ],
    "type": "string"
   }
  },
  "required": [
   "site",
   "ids",
   "status"
  ],
  "type": "object"
 },
 "name": "wp_moderate_comments"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check Caption Safe Zone"
 },
 "description": "Check caption, title, logo, and graphic rectangles against approximate platform UI overlay zones (TikTok, Reels, Shorts, feed, YouTube, LinkedIn, X) and suggest the nearest clear position. Local-only geometry on caller-supplied normalized rects; it never reads or changes Premiere.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "elements": {
    "description": "On-screen rectangles normalized to the frame (0..1), with x,y at the top-left corner.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "height": {
       "description": "Height as a fraction of frame height.",
       "exclusiveMinimum": 0,
       "maximum": 1,
       "type": "number"
      },
      "id": {
       "description": "Caller-stable element ID.",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "kind": {
       "description": "Element kind.",
       "enum": [
        "caption",
        "title",
        "logo",
        "graphic"
       ],
       "type": "string"
      },
      "width": {
       "description": "Width as a fraction of frame width.",
       "exclusiveMinimum": 0,
       "maximum": 1,
       "type": "number"
      },
      "x": {
       "description": "Left edge as a fraction of frame width.",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "y": {
       "description": "Top edge as a fraction of frame height.",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "id",
      "x",
      "y",
      "width",
      "height",
      "kind"
     ],
     "type": "object"
    },
    "maxItems": 64,
    "minItems": 1,
    "type": "array"
   },
   "frame": {
    "additionalProperties": false,
    "description": "Output frame size in pixels; used for orientation checks and pixel readback.",
    "properties": {
     "height": {
      "description": "Frame height in pixels.",
      "maximum": 16384,
      "minimum": 16,
      "type": "integer"
     },
     "width": {
      "description": "Frame width in pixels.",
      "maximum": 16384,
      "minimum": 16,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height"
    ],
    "type": "object"
   },
   "platform": {
    "description": "Target platform whose UI overlays are checked.",
    "enum": [
     "tiktok",
     "instagram_reels",
     "youtube_shorts",
     "instagram_feed",
     "youtube",
     "linkedin",
     "x"
    ],
    "type": "string"
   }
  },
  "required": [
   "platform",
   "frame",
   "elements"
  ],
  "type": "object"
 },
 "name": "check_caption_safe_zone",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Check Caption Safe Zone"
}

{
 "description": "Find a version ID by version string (e.g., \"1.6.0\"). Useful when you have the version number but need the ID for other tools.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "appId": {
    "description": "App ID",
    "type": "string"
   },
   "platform": {
    "default": "IOS",
    "description": "Platform",
    "enum": [
     "IOS",
     "MAC_OS",
     "TV_OS",
     "VISION_OS"
    ],
    "type": "string"
   },
   "versionString": {
    "description": "Version string to find (e.g., 1.6.0)",
    "type": "string"
   }
  },
  "required": [
   "appId",
   "versionString"
  ],
  "type": "object"
 },
 "name": "asc_resolve_version"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a user persona in a VibeMap project. Personas are the cast of users the spec is written for \u2014 author them FIRST, then reference each persona's role (userRole) when writing user stories. Match the depth VibeMap's own generator produces: fill the structured blocks so the persona is rich and semantically searchable, not just a name. Existing personas are visible via vibemap_get_project_context \u2014 enrich, don't duplicate. All params are camelCase.",
 "inputSchema": {
  "properties": {
   "avatarDescription": {
    "description": "Brief visual description",
    "type": "string"
   },
   "communicationPreferences": {
    "description": "How to reach them",
    "properties": {
     "contentPreferences": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "messagingResponse": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "demographics": {
    "description": "Who they are",
    "properties": {
     "ageRange": {
      "type": "string"
     },
     "education": {
      "type": "string"
     },
     "familyStructure": {
      "type": "string"
     },
     "gender": {
      "type": "string"
     },
     "incomeLevel": {
      "type": "string"
     },
     "location": {
      "type": "string"
     },
     "occupation": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "goalsAndNeeds": {
    "description": "What they are trying to achieve",
    "properties": {
     "emotionalNeeds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "functionalNeeds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "primaryObjectives": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "problemsToSolve": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Persona's first name",
    "type": "string"
   },
   "narrative": {
    "description": "Their voice",
    "properties": {
     "keyFrustrations": {
      "type": "string"
     },
     "quote": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "painPoints": {
    "description": "What frustrates or blocks them",
    "properties": {
     "barriers": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "currentChallenges": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "skillGaps": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "productSpecific": {
    "description": "How they relate to this product",
    "properties": {
     "featurePriorities": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "priceSensitivity": {
      "type": "string"
     },
     "primaryUseCases": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "technicalProficiency": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "projectId": {
    "type": "string"
   },
   "psychographics": {
    "description": "What drives them",
    "properties": {
     "aspirations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "motivations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "personalityTraits": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "values": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "tagline": {
    "description": "Brief one-line descriptor",
    "type": "string"
   },
   "userRole": {
    "description": "Canonical role this persona represents (e.g. 'admin', 'diver'). User stories reference this role.",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "name"
  ],
  "type": "object"
 },
 "name": "vibemap_create_persona"
}

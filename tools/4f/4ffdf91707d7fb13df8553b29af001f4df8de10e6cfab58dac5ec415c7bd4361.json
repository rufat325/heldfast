{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Move a PR between states: attention (need attention), waiting (waiting on maintainer), shelved (hidden), or auto (reset to computed status).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "prUrl": {
    "description": "Full GitHub PR URL",
    "pattern": "^https:\\/\\/github\\.com\\/[^/]+\\/[^/]+\\/pull\\/\\d+$",
    "type": "string"
   },
   "target": {
    "description": "Target state for the PR",
    "enum": [
     "attention",
     "waiting",
     "shelved",
     "auto"
    ],
    "type": "string"
   }
  },
  "required": [
   "prUrl",
   "target"
  ],
  "type": "object"
 },
 "name": "move"
}

    "type": "number"
   },
   "package": {
    "description": "Package name in vendor/package form",
    "type": "string"
   },
   "versions": {
    "description": "List of all versions",
    "items": {
     "properties": {
      "released": {
       "description": "ISO 8601 release timestamp",
       "type": "string"
      },
      "version": {

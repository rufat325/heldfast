 "description": "Release history of one PHP/Composer package on the Packagist registry, given a vendor/package name such as symfony/console. Returns every published version string paired with its release timestamp, plus a total count. Answers which versions of a Composer package exist and when the latest one shipped.",
 "inputSchema": {
  "examples": [
   {
    "name": "symfony/console"
   }
  ],
  "properties": {

{
 "annotations": {
  "cost": {
   "all": 1
  },
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Typeahead / partial-name search for POIs near a lat/lon point. Matches place names by prefix within a radius \u2014 good for \"find places starting with X near here\". Returns matching POIs with xid, name, kinds, distance, and coordinates. Example: opentripmap_autosuggest({ name: \"louv\", lat: 48.8566, lon: 2.3522, radius: 5000, _apiKey: \"your-key\" })",
 "inputSchema": {
  "examples": [
   {
    "_apiKey": "your-opentripmap-api-key",
    "lat": 48.8566,
    "lon": 2.3522,
    "name": "louv",
    "radius": 5000
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "OpenTripMap API key",
    "type": "string"
   },
   "kinds": {
    "description": "Optional comma-separated category filter",
    "type": "string"
   },
   "lang": {
    "description": "Two-letter language code (default \"en\")",
    "type": "string"
   },
   "lat": {
    "description": "Latitude of the search center",
    "type": "number"
   },
   "limit": {
    "description": "Max results to return (default 50)",
    "type": "number"
   },
   "lon": {
    "description": "Longitude of the search center",
    "type": "number"
   },
   "name": {
    "description": "Partial place name to match, e.g. \"louv\"",
    "type": "string"
   },
   "radius": {
    "description": "Search radius in meters, e.g. 5000",
    "type": "number"
   }
  },
  "required": [
   "name",
   "lat",
   "lon",
   "radius",
   "_apiKey"
  ],
  "type": "object"
 },
 "name": "opentripmap_autosuggest",
 "title": "Opentripmap Autosuggest",
 "version": "v1.044bdc5a"
}

{
 "description": "Find symbol definitions (classes, functions, interfaces, methods) by name in the indexed symbol table. Faster than full-text search for exact identifiers. Re-index the project if results are empty.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file_pattern": {
    "description": "Optional glob to limit files (e.g., \"apps/gateway/**\")",
    "type": "string"
   },
   "kind": {
    "description": "Optional filter by symbol kind",
    "enum": [
     "class",
     "function",
     "interface",
     "type",
     "enum",
     "method",
     "variable",
     "namespace"
    ],
    "type": "string"
   },
   "project_name": {
    "description": "Project name",
    "type": "string"
   },
   "symbol": {
    "description": "Symbol name to find (e.g., ProxyService, checkQuota)",
    "type": "string"
   }
  },
  "required": [
   "project_name",
   "symbol"
  ],
  "type": "object"
 },
 "name": "symbol_lookup"
}

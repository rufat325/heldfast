 "description": "Fetch full transaction detail (inputs, outputs, fee, size, confirmation status) for a given txid on mainnet/testnet/signet/liquid.",
 "inputSchema": {
  "examples": [
   {
    "network": "mainnet",
    "txid": "1da1f48e9e20a6be6fa7d4df5c5e9e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e"
   }
  ],
  "properties": {
   "network": {
    "default": "mainnet",
    "description": "Which Bitcoin network. Defaults to mainnet \u2014 the real Bitcoin network, which is what \"Bitcoin\" means in an ordinary question. \"bitcoin\" and \"btc\" are accepted as aliases for mainnet.",
    "enum": [
     "mainnet",
     "testnet",
     "signet",
     "liquid"
    ],
    "type": "string"
   },
   "txid": {
    "type": "string"
   }
  },
  "required": [

 "description": "FINRA Reg SHO daily short-sale volume time series for one symbol \u2014 up to 30 trading days ending at `end_date` (default: most recent published day). Each day carries short_volume, short_exempt_volume, total_volume and short_ratio summed across every consolidated-NMS reporting facility, so the daily totals match FINRA's consolidated CNMS figures. Use it to see how a symbol's short-sale share of volume moved over recent sessions. Zero-rated: costs 0 credits.",
 "inputSchema": {
  "examples": [
   {
    "days": 5,
    "end_date": "2026-08-21",
    "symbol": "GME"
   },
   {
    "days": 10,
    "symbol": "AAPL"
   }
  ],
  "properties": {
   "days": {
    "description": "1\u201330 (default 10)",
    "type": "number"
   },
   "end_date": {
    "description": "YYYY-MM-DD or YYYYMMDD; defaults to most recent published day",
    "type": "string"
   },
   "symbol": {
    "description": "Ticker (case-insensitive)",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },

{
 "description": "Update an existing invoice. POSTs to /Invoices/{InvoiceID}. DRAFT/SUBMITTED invoices are fully editable; AUTHORISED invoices have limited editable fields (Reference, DueDate, etc).",
 "inputSchema": {
  "properties": {
   "Date": {
    "description": "Invoice date YYYY-MM-DD.",
    "type": "string"
   },
   "DueDate": {
    "description": "Payment due date YYYY-MM-DD.",
    "type": "string"
   },
   "InvoiceID": {
    "description": "Xero Invoice UUID to update.",
    "type": "string"
   },
   "InvoiceNumber": {
    "description": "Merchant invoice number.",
    "type": "string"
   },
   "LineAmountTypes": {
    "description": "Tax treatment for line amounts.",
    "enum": [
     "Exclusive",
     "Inclusive",
     "NoTax"
    ],
    "type": "string"
   },
   "LineItems": {
    "description": "Replacement line items array.",
    "type": "array"
   },
   "Reference": {
    "description": "Free-text reference.",
    "type": "string"
   },
   "Status": {
    "description": "New invoice status.",
    "enum": [
     "DRAFT",
     "SUBMITTED",
     "AUTHORISED",
     "VOIDED"
    ],
    "type": "string"
   }
  },
  "required": [
   "InvoiceID"
  ],
  "type": "object"
 },
 "name": "update_invoice"
}

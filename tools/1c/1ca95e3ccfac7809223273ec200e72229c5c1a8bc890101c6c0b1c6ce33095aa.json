{
 "description": "Propose forgetting memories (by id, or by scope/tags). Creates a pending proposal that a human must approve before anything is deleted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentId": {
    "description": "Scope: agent id",
    "type": "string"
   },
   "id": {
    "description": "Forget a single memory by id",
    "type": "string"
   },
   "instanceId": {
    "description": "Optional instance ID override",
    "type": "string"
   },
   "memory_name": {
    "description": "The memory store name (from memory_stores)",
    "minLength": 1,
    "type": "string"
   },
   "namespace": {
    "description": "Scope: namespace",
    "type": "string"
   },
   "reasoning": {
    "description": "Why these memories should be forgotten (min 20 chars)",
    "minLength": 20,
    "type": "string"
   },
   "tags": {
    "description": "Scope: forget memories carrying all these tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "threadId": {
    "description": "Scope: thread id",
    "type": "string"
   }
  },
  "required": [
   "memory_name",
   "reasoning"
  ],
  "type": "object"
 },
 "name": "memory_forget"
}

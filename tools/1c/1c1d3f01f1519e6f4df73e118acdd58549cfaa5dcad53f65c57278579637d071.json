{
 "description": "Send the same message to multiple platforms at once. Runs in parallel.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "targets": {
    "description": "Array of { platform, channelId } targets",
    "items": {
     "properties": {
      "channelId": {
       "type": "string"
      },
      "platform": {
       "description": "Messaging platform",
       "enum": [
        "telegram",
        "discord",
        "slack",
        "whatsapp"
       ],
       "type": "string"
      }
     },
     "required": [
      "platform",
      "channelId"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "text": {
    "description": "Message text to broadcast",
    "type": "string"
   }
  },
  "required": [
   "targets",
   "text"
  ],
  "type": "object"
 },
 "name": "channel_broadcast"
}

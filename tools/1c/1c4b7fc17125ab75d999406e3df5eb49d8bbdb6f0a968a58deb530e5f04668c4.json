{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Runs go build and returns structured error list (file, line, column, message).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buildmode": {
    "description": "Build mode (-buildmode). Controls the type of output artifact.",
    "enum": [
     "default",
     "archive",
     "c-archive",
     "c-shared",
     "shared",
     "exe",
     "pie",
     "plugin"
    ],
    "type": "string"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "gcflags": {
    "description": "Arguments to pass to the Go compiler (-gcflags). Example: \"-N -l\" to disable optimizations.",
    "maxLength": 65536,
    "type": "string"
   },
   "ldflags": {
    "description": "Linker flags (-ldflags). Commonly used for version injection, e.g. \"-X main.version=1.0.0\"",
    "maxLength": 65536,
    "type": "string"
   },
   "output": {
    "description": "Output binary name or path (-o)",
    "maxLength": 4096,
    "type": "string"
   },
   "packages": {
    "default": [
     "./..."
    ],
    "description": "Packages to build (default: ./...)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "race": {
    "default": false,
    "description": "Enable data race detection (-race)",
    "type": "boolean"
   },
   "tags": {
    "description": "Build tags for conditional compilation (-tags). Example: ['integration', 'linux']",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "trimpath": {
    "default": false,
    "description": "Remove all file system paths from the resulting binary (-trimpath). Needed for reproducible builds.",
    "type": "boolean"
   },
   "verbose": {
    "default": false,
    "description": "Print the names of packages as they are compiled (-v)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "build",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buildCache": {
    "additionalProperties": false,
    "description": "Best-effort build cache estimate derived from go list stale metadata",
    "properties": {
     "estimatedHits": {
      "type": "number"
     },
     "estimatedMisses": {
      "type": "number"
     },
     "totalPackages": {
      "type": "number"
     }
    },
    "required": [
     "estimatedHits",
     "estimatedMisses",
     "totalPackages"
    ],
    "type": "object"
   },
   "errors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "rawErrors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Go Build"
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create or update a reference-based character for repeatable faceless story generation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "canonicalDescription": {
    "type": "string"
   },
   "characterId": {
    "type": "string"
   },
   "confirmLikenessConsent": {
    "default": false,
    "description": "For a human character, set true only after the user confirms consent to use the depicted person's likeness.",
    "type": "boolean"
   },
   "confirmRightsToReferences": {
    "default": false,
    "description": "Set true only after the user confirms they own the reference media or have permission to use it.",
    "type": "boolean"
   },
   "defaultVoiceId": {
    "type": "string"
   },
   "defaultVoiceStyle": {
    "type": "string"
   },
   "idempotencyKey": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "primaryReferenceAssetId": {
    "type": "string"
   },
   "referenceAssetIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "species": {
    "type": "string"
   },
   "storyFacts": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "default": "human",
    "enum": [
     "human",
     "fictional",
     "other"
    ],
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace UUID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "name",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "characters_apply",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "character": {
    "type": "object"
   },
   "mutationReceipt": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ]
     },
     "operation": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "key",
     "operation",
     "status",
     "replayed"
    ],
    "type": "object"
   }
  },
  "required": [
   "character",
   "mutationReceipt"
  ],
  "type": "object"
 },
 "title": "Apply Reusable Character"
}

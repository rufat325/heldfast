{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Programming Item"
 },
 "description": "Add a programming item (curated experience \u2014 workshop, performance, DJ set, ritual) to a live event \u2014 title, status (ideation \u2026 ready), types, duration, start time, linked talent/places, rider, production needs. Requires event_id + title; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "act": {
    "maxLength": 200,
    "type": "string"
   },
   "description": {
    "maxLength": 4000,
    "type": "string"
   },
   "duration_minutes": {
    "exclusiveMinimum": 0,
    "maximum": 100000,
    "type": "integer"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "experience_series": {
    "maxLength": 200,
    "type": "string"
   },
   "phase": {
    "enum": [
     "pre_production",
     "build",
     "event",
     "strike",
     "post"
    ],
    "type": "string"
   },
   "place_ids": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "production_needs": {
    "maxLength": 4000,
    "type": "string"
   },
   "rider": {
    "maxLength": 4000,
    "type": "string"
   },
   "start_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "status": {
    "enum": [
     "ideation",
     "needs_talent",
     "confirming",
     "programmed",
     "story_and_design",
     "needs_producer",
     "production",
     "ready",
     "cancelled",
     "blocked",
     "on_event_serendipity"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "talent_ids": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "title": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "types": {
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "event_id",
   "title"
  ],
  "type": "object"
 },
 "name": "add_programming_item",
 "title": "Add Programming Item"
}

{
 "description": "Atomically create an ordered, idempotent task node batch through the Granoflow NodeService.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "expectedTaskUpdatedAt": {
    "format": "date-time",
    "type": "string"
   },
   "idempotencyKey": {
    "minLength": 1,
    "type": "string"
   },
   "nodes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "parentId": {
       "minLength": 1,
       "type": "string"
      },
      "title": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "taskId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId",
   "idempotencyKey",
   "expectedTaskUpdatedAt",
   "nodes"
  ],
  "type": "object"
 },
 "name": "granoflow_task_node_batch_create"
}

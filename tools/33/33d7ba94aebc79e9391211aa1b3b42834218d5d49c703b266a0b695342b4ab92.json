{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Event"
 },
 "description": "Edit a live event you manage: name, description (with links), category, start/end time, cover image, turn public discovery on/off, show or hide the guest list, visibility, and capacity. Approval is set per ticket tier \u2014 use update_ticket_tier for it. Requires event_id; you must be a host (connected via 'Connect with SocialLoop').",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "absorb_fees": {
    "type": "boolean"
   },
   "capacity": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "category": {
    "maxLength": 80,
    "type": "string"
   },
   "cover_image_url": {
    "format": "uri",
    "maxLength": 2000,
    "type": "string"
   },
   "description_html": {
    "maxLength": 20000,
    "type": "string"
   },
   "discoverable": {
    "type": "boolean"
   },
   "ends_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z||([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "event_description": {
    "maxLength": 10000,
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "event_name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "requires_approval": {
    "type": "boolean"
   },
   "show_participants": {
    "type": "boolean"
   },
   "starts_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z||([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "timezone": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "visibility": {
    "enum": [
     "public",
     "friends",
     "private"
    ],
    "type": "string"
   }
  },
  "required": [
   "event_id"
  ],
  "type": "object"
 },
 "name": "update_event",
 "title": "Update Event"
}

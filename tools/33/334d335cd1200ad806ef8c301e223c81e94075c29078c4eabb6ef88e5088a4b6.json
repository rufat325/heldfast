{
 "description": "List WordPress pages",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "order": {
    "default": "asc",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "orderby": {
    "default": "menu_order",
    "enum": [
     "date",
     "title",
     "modified",
     "menu_order"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "number"
   },
   "parent": {
    "description": "Parent page ID (0 for top-level)",
    "type": "number"
   },
   "per_page": {
    "default": 20,
    "description": "Pages per request (max 100)",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "Page status filter",
    "enum": [
     "publish",
     "future",
     "draft",
     "pending",
     "private",
     "trash"
    ],
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_pages"
}

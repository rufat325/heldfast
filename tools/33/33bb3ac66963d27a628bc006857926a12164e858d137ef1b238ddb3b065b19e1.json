{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "If your question is 'what recomputes downstream when X changes?', use nanostores_store_impact instead \u2014 it gives the ordered causal chain in one call. Use this tool only when you need both directions: upstream sources AND downstream dependents together. Returns the BFS neighborhood within a configurable radius (default 2). Start with radius=1; increase only when you need wider structural context. On highly connected hub stores (score>5 in project_outline) radius=2+ may return most of the project. Example: {name: \"$cart\", radius: 1} or {storeId: \"store:src/stores.ts#$cart\", radius: 2}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Store name. Used if storeId is not provided.",
    "type": "string"
   },
   "projectRoot": {
    "description": "Project root path (uses default if omitted)",
    "type": "string"
   },
   "radius": {
    "default": 2,
    "description": "BFS radius around the store (default 2)",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "storeId": {
    "description": "Exact store id. If provided, takes priority.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "nanostores_store_subgraph",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "centerStoreId": {
    "type": "string"
   },
   "edges": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "from": {
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "from",
      "to",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nodes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "file": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "type": {
       "enum": [
        "store",
        "file"
       ],
       "type": "string"
      },
      "valueType": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "radius": {
    "type": "number"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "dependencies": {
      "type": "number"
     },
     "edges": {
      "type": "number"
     },
     "nodes": {
      "type": "number"
     },
     "subscribers": {
      "type": "number"
     }
    },
    "required": [
     "nodes",
     "edges"
    ],
    "type": "object"
   },
   "warning": {
    "type": "string"
   }
  },
  "required": [
   "centerStoreId",
   "radius",
   "nodes",
   "edges"
  ],
  "type": "object"
 },
 "title": "Get store subgraph"
}

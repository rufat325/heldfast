{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List exports with render status and progress. Completed exports include a signed download URL. Pass exportId to return one export.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "exportId": {
    "description": "Return only this export, including its signed download URL when the render is complete. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum exports to return when exportId is absent (1-50).",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Export offset when exportId is absent.",
    "minimum": 0,
    "type": "number"
   },
   "projectId": {
    "description": "Filter exports by project ID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace ID when projectId is not provided. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "exports_list",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "bounds": {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "type": "number"
     },
     "maxLimit": {
      "type": "number"
     },
     "offset": {
      "type": "number"
     },
     "returned": {
      "type": "number"
     },
     "total": {
      "type": "number"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "limit",
     "maxLimit",
     "offset",
     "total",
     "returned",
     "hasMore",
     "truncated"
    ],
    "type": "object"
   },
   "exports": {
    "items": {
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "exports",
   "bounds"
  ],
  "type": "object"
 },
 "title": "List Exports"
}

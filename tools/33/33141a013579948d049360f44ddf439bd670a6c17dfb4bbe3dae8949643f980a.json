 "description": "Convert a datetime from one timezone to another. If no time is provided the current time in the source timezone is used.",
 "inputSchema": {
  "examples": [
   {
    "from_timezone": "America/New_York",
    "to_timezone": "Europe/London"
   },
   {
    "from_timezone": "America/Los_Angeles",
    "time": "2024-06-15T14:30:00",
    "to_timezone": "Asia/Singapore"
   }
  ],
  "properties": {
   "from_timezone": {
    "description": "Source IANA timezone, e.g. \"America/New_York\"",
    "type": "string"
   },
   "time": {
    "description": "Datetime to convert as \"YYYY-MM-DD HH:mm:ss\" (optional \u2014 defaults to current time in source).",
    "type": "string"
   },
   "to_timezone": {
    "description": "Target IANA timezone, e.g. \"Europe/Paris\"",
    "type": "string"
   }
  },
  "required": [
   "from_timezone",
   "to_timezone"
  ],
  "type": "object"
 },
 "name": "convert_time",
 "outputSchema": {
  "properties": {
   "from_datetime": {
    "description": "Source datetime in ISO 8601 format",
    "type": "string"
   },
   "from_timezone": {
    "description": "Source timezone",
    "type": "string"
   },
   "from_utc_offset": {
    "description": "UTC offset of source timezone in \u00b1HH:MM format",
    "type": "string"
   },
   "offset_difference": {
    "description": "Difference in UTC offsets in \u00b1HH:MM format",
    "type": "string"
   },
   "to_datetime": {
    "description": "Converted datetime in ISO 8601 format",
    "type": "string"
   },
   "to_timezone": {
    "description": "Target timezone",
    "type": "string"
   },
   "to_utc_offset": {
    "description": "UTC offset of target timezone in \u00b1HH:MM format",
    "type": "string"
   }
  },
  "required": [
   "from_timezone",
   "from_datetime",
   "from_utc_offset",
   "to_timezone",
   "to_datetime",
   "to_utc_offset",
   "offset_difference"
  ],
  "type": "object"
 },

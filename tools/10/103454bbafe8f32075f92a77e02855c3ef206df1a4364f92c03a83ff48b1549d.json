   },
   "node_id": {
    "description": "Node ID of the clip",
    "type": "string"
   }
  },
  "required": [
   "node_id",
   "effect_name"
  ],
  "type": "object"
 },
 "name": "remove_effect_by_name",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",

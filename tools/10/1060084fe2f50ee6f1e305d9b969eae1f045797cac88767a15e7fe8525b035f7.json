  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create PDF QR code"
 },
 "description": "Create a dynamic QR code and short link for a PDF (menus, flyers, tickets). Host the PDF by passing `pdf_url` (a link Hovercode fetches) or `pdf_base64` (the file's base64 bytes). Returns a shareable short link plus a rendered QR. Because it's dynamic you can later swap the PDF without reprinting the code \u2014 always dynamic, no static option here. Draws on the same free, per-workspace dynamic-code allowance as create_qr_code (list_workspaces' `dynamic_qr_limit`); past that limit this call fails asking for an upgrade, it isn't paid-only from the start.",
 "inputSchema": {
  "properties": {
   "display_name": {
    "description": "Internal name to find this code later.",
    "type": "string"
   },
   "domain": {
    "description": "Custom short-link domain (list_workspaces shows the plan).",
    "type": "string"
   },
   "filename": {
    "description": "Name for the stored file, e.g. 'menu.pdf'.",
    "type": "string"
   },
   "pdf_base64": {
    "description": "Base64-encoded PDF bytes (data-URI prefix allowed), max 20 MB. Or use pdf_url.",
    "type": "string"
   },
   "pdf_url": {
    "description": "URL of a PDF to fetch and host. Use this or pdf_base64.",
    "type": "string"
   },
   "tags": {
    "description": "Labels to attach (created if new) so you can find these later \u2014 list_qr_codes and list_short_links search by tag.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workspace": {
    "description": "Workspace id. Optional when the account has one workspace; use list_workspaces to resolve otherwise.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_pdf_qr",

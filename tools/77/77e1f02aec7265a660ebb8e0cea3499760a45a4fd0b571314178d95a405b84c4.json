{
 "description": "Send a message to a specific platform and channel. Use channel_list to discover channel IDs first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "channelId": {
    "description": "Channel/chat ID on the platform",
    "type": "string"
   },
   "platform": {
    "description": "Target platform",
    "enum": [
     "telegram",
     "discord",
     "slack",
     "whatsapp"
    ],
    "type": "string"
   },
   "replyToId": {
    "description": "Message ID to reply to",
    "type": "string"
   },
   "text": {
    "description": "Message text to send",
    "type": "string"
   },
   "threadId": {
    "description": "Thread/topic ID for threaded replies",
    "type": "string"
   }
  },
  "required": [
   "platform",
   "channelId",
   "text"
  ],
  "type": "object"
 },
 "name": "channel_send"
}

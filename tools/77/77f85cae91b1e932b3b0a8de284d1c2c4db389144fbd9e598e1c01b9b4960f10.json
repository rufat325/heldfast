{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Create a 3-5 year tax projection and strategy. Models income changes, Roth conversions, retirement contributions, and bracket management across multiple years.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currentAge": {
    "minimum": 0,
    "type": "integer"
   },
   "filingStatus": {
    "enum": [
     "single",
     "married_filing_jointly",
     "married_filing_separately",
     "head_of_household"
    ],
    "type": "string"
   },
   "years": {
    "description": "Year-by-year projections",
    "items": {
     "additionalProperties": false,
     "properties": {
      "dependents": {
       "minimum": 0,
       "type": "integer"
      },
      "expectedIncome": {
       "description": "Expected gross income",
       "minimum": 0,
       "type": "number"
      },
      "planned401k": {
       "description": "Planned 401k contribution",
       "minimum": 0,
       "type": "number"
      },
      "plannedIRA": {
       "description": "Planned IRA contribution",
       "minimum": 0,
       "type": "number"
      },
      "plannedRothConversion": {
       "description": "Planned Roth conversion amount",
       "minimum": 0,
       "type": "number"
      },
      "selfEmploymentIncome": {
       "minimum": 0,
       "type": "number"
      },
      "stateCode": {
       "maxLength": 2,
       "minLength": 2,
       "type": "string"
      },
      "year": {
       "description": "Tax year (2024, 2025, or 2026)",
       "type": "number"
      }
     },
     "required": [
      "year",
      "expectedIncome"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "filingStatus",
   "currentAge",
   "years"
  ],
  "type": "object"
 },
 "name": "plan_multi_year_taxes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "suggestion"
    ],
    "type": "object"
   },
   "isError": {
    "type": "boolean"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "isError"
  ],
  "type": "object"
 }
}

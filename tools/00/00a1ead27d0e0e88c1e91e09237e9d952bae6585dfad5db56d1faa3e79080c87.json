  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search the Packagist PHP/Composer registry by free text with optional type (e.g. library, symfony-bundle) and tag filters. Returns package names, descriptions, download counts, and latest versions.",
 "inputSchema": {
  "examples": [
   {
    "query": "laravel orm"
   },
   {
    "page": 1,
    "per_page": 10,
    "query": "logging",
    "tags": "psr-3,monolog",
    "type": "library"
   }
  ],
  "properties": {
   "page": {
    "description": "1-based page",
    "type": "number"
   },
   "per_page": {
    "description": "1-15 (default 15, API max)",
    "type": "number"
   },
   "query": {
    "description": "Free-text \u2014 package name / description",
    "type": "string"
   },
   "tags": {
    "description": "Comma-separated tags",
    "type": "string"
   },
   "type": {
    "description": "composer-plugin | library | symfony-bundle | wordpress-plugin | ...",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "properties": {
   "next": {
    "description": "URL for next page of results",
    "type": "string"
   },
   "results": {
    "description": "Array of matching packages",
    "items": {
     "properties": {
      "description": {
       "description": "Short package description",
       "type": "string"
      },
      "downloads": {
       "description": "Total download count",
       "type": "number"
      },
      "favers": {
       "description": "Number of favorites",
       "type": "number"
      },
      "name": {
       "description": "Package name in vendor/package form",
       "type": "string"
      },
      "repository": {
       "description": "Repository URL",
       "type": "string"
      },
      "type": {
       "description": "Package type",
       "type": "string"
      },
      "url": {
       "description": "Package URL on Packagist",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Total number of matching results",
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Search",
 "version": "v1.dffe8553"

{
 "description": "MIND Sheets \u2014 Airtable-style tables at m-i-n-d.ai/#/sheets. Actions: tables_list, table_create, table_update, table_delete, column_add, column_update, column_delete, columns_reorder, rows_list, row_create, row_update, row_delete, rows_bulk_delete, export_csv (returns raw CSV text).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Which sheets operation to perform.",
    "enum": [
     "tables_list",
     "table_create",
     "table_update",
     "table_delete",
     "column_add",
     "column_update",
     "column_delete",
     "columns_reorder",
     "rows_list",
     "row_create",
     "row_update",
     "row_delete",
     "rows_bulk_delete",
     "export_csv"
    ],
    "type": "string"
   },
   "cells": {
    "additionalProperties": {},
    "description": "{column_id: value, ...} \u2014 row_create/row_update (required).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "column_id": {
    "description": "Column id \u2014 column_update/column_delete.",
    "type": "string"
   },
   "column_ids": {
    "description": "New column order \u2014 required for columns_reorder.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "columns": {
    "description": "[{name, type, options?, width?}] \u2014 table_create initial columns.",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max rows \u2014 rows_list (default 500, max 2000).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "name": {
    "description": "Table name (table_create required/table_update required) or column name (column_add required/column_update).",
    "type": "string"
   },
   "offset": {
    "description": "Row offset \u2014 rows_list (default 0).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "options": {
    "description": "Select-type options \u2014 column_add/column_update.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "row_id": {
    "description": "Row id \u2014 row_update/row_delete.",
    "type": "string"
   },
   "row_ids": {
    "description": "Row ids to delete \u2014 required for rows_bulk_delete.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "table_id": {
    "description": "Table id \u2014 every action except tables_list/table_create.",
    "type": "string"
   },
   "type": {
    "description": "Column type: text|number|select|date|checkbox|url \u2014 required for column_add; column_update.",
    "type": "string"
   },
   "width": {
    "description": "Column width in px \u2014 column_update.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "mind_sheets"
}

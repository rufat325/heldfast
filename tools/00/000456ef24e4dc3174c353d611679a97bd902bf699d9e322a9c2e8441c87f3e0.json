{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Change the TTL of an RRSet. Pass ttl=null to fall back to the zone default TTL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id_or_name": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^[^/\\s]+$",
      "type": "string"
     }
    ],
    "description": "Zone ID or name"
   },
   "name": {
    "description": "RRSet name",
    "pattern": "^[^/\\s]+$",
    "type": "string"
   },
   "ttl": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "New TTL in seconds, or null to fall back to the zone default"
   },
   "type": {
    "description": "DNS record type (A, AAAA, CNAME, MX, NS, TXT, etc.)",
    "enum": [
     "A",
     "AAAA",
     "CAA",
     "CNAME",
     "DS",
     "HINFO",
     "HTTPS",
     "MX",
     "NS",
     "PTR",
     "RP",
     "SOA",
     "SRV",
     "SVCB",
     "TLSA",
     "TXT"
    ],
    "type": "string"
   }
  },
  "required": [
   "id_or_name",
   "name",
   "type",
   "ttl"
  ],
  "type": "object"
 },
 "name": "hetzner_change_zone_rrset_ttl",
 "title": "Change DNS Zone RRSet TTL"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new prospect in Outreach. Example: { \"email\": \"jane@acme.com\", \"first_name\": \"Jane\", \"last_name\": \"Doe\" }\n\nREQUIRED: At least email or last_name.\nCOMMON MISTAKES: Don't forget to associate with an account via account_id if known.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "description": "Associated Outreach account ID",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "company": {
    "description": "Company name",
    "type": "string"
   },
   "custom_fields": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean",
      "null"
     ]
    },
    "description": "Outreach custom field values, keyed custom1 through custom35 (e.g. { \"custom1\": \"enterprise\" })",
    "type": "object"
   },
   "email": {
    "description": "Email address",
    "type": "string"
   },
   "first_name": {
    "description": "First name",
    "type": "string"
   },
   "last_name": {
    "description": "Last name",
    "type": "string"
   },
   "tags": {
    "description": "Tags to apply",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Job title",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "outreach_create_prospect"
}

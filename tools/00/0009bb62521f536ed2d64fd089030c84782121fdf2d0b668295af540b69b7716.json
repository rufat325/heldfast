{
 "description": "Force-terminate a running app by bundle ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundleId": {
    "description": "App bundle identifier to terminate",
    "type": "string"
   },
   "deviceId": {
    "description": "Device UDID, name, or \"booted\" (default: booted)",
    "type": "string"
   }
  },
  "required": [
   "bundleId"
  ],
  "type": "object"
 },
 "name": "simulator_terminate_app"
}

{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Push File to Device"
 },
 "description": "Push a file from the host machine to the device.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "localPath": {
    "description": "Absolute path to the file on the host machine",
    "type": "string"
   },
   "remotePath": {
    "description": "Destination path on the device (e.g., /sdcard/myfile.txt)",
    "type": "string"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   }
  },
  "required": [
   "localPath",
   "remotePath"
  ],
  "type": "object"
 },
 "name": "file_push",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "adb push result or a confirmation message",
    "type": "string"
   },
   "success": {
    "description": "Whether the file was pushed",
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 }
}

{
 "description": "Lanza N requests concurrentes al mismo endpoint y mide tiempos promedio, percentiles y tasa de errores.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "auth": {
    "additionalProperties": false,
    "description": "Autenticaci\u00f3n",
    "properties": {
     "header": {
      "description": "Header name para API key (default: X-API-Key)",
      "type": "string"
     },
     "key": {
      "description": "API key value",
      "type": "string"
     },
     "password": {
      "description": "Password para Basic auth",
      "type": "string"
     },
     "token": {
      "description": "Token para Bearer auth",
      "type": "string"
     },
     "type": {
      "description": "Tipo de autenticaci\u00f3n",
      "enum": [
       "bearer",
       "api-key",
       "basic"
      ],
      "type": "string"
     },
     "username": {
      "description": "Username para Basic auth",
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "body": {
    "description": "Body del request"
   },
   "concurrent": {
    "description": "N\u00famero de requests concurrentes a lanzar (max: 100)",
    "type": "number"
   },
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Headers HTTP",
    "type": "object"
   },
   "method": {
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "PATCH",
     "DELETE",
     "HEAD",
     "OPTIONS"
    ],
    "type": "string"
   },
   "query": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Query parameters",
    "type": "object"
   },
   "timeout": {
    "description": "Timeout por request en ms (default: 30000)",
    "type": "number"
   },
   "url": {
    "description": "URL del endpoint",
    "type": "string"
   }
  },
  "required": [
   "method",
   "url",
   "concurrent"
  ],
  "type": "object"
 },
 "name": "load_test"
}

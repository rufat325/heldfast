{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get a day\u2019s order"
 },
 "description": "Get what a student has ordered on one specific date \u2014 the items, sizes, quantities, add-ons and prices.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "description": "The day to look at (YYYY-MM-DD).",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "studentId": {
    "description": "Student id from mhlb_list_students.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "studentId",
   "date"
  ],
  "type": "object"
 },
 "name": "mhlb_get_day"
}

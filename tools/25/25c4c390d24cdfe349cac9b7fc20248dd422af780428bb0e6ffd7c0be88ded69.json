{
 "description": "List a TikTok Shop seller's products with exact prices. Paginate with next_cursor/has_more. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Pagination cursor from previous response.",
    "type": "string"
   },
   "region": {
    "description": "Region: US (default), GB, SG, MY, PH, TH, VN, ID.",
    "enum": [
     "US",
     "GB",
     "SG",
     "MY",
     "PH",
     "TH",
     "VN",
     "ID"
    ],
    "type": "string"
   },
   "shop_id": {
    "description": "Shop/seller ID.",
    "pattern": "^\\d{6,25}$",
    "type": "string"
   }
  },
  "required": [
   "shop_id"
  ],
  "type": "object"
 },
 "name": "get_tiktok_shop_shop_products"
}

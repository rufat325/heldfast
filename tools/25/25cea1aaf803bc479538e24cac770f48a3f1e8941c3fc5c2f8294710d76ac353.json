    "properties": {
     "myPoints": {
      "items": {
       "properties": {
        "zip1": {
         "maxLength": 5,
         "minLength": 5,
         "type": "string"
        },
        "zip2": {
         "maxLength": 5,
         "minLength": 5,
         "type": "string"
        }
       },
       "required": [
        "zip1",
        "zip2"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "myPoints"
    ],
    "type": "object"
   }
  },
  "required": [
   "body"
  ],
  "type": "object"
 },
 "name": "get_distance_between_zips_bulk"
}

{
 "description": "Create a hosted health check for a project. Omit failureThreshold to use the plan recommendation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "enabled": {
    "type": "boolean"
   },
   "environment": {
    "type": "string"
   },
   "expectedStatusMax": {
    "type": "number"
   },
   "expectedStatusMin": {
    "type": "number"
   },
   "failureThreshold": {
    "type": "number"
   },
   "intervalSeconds": {
    "type": "number"
   },
   "method": {
    "enum": [
     "GET",
     "HEAD"
    ],
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "recoveryThreshold": {
    "type": "number"
   },
   "serviceName": {
    "type": [
     "string",
     "null"
    ]
   },
   "timeoutMs": {
    "type": "number"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "name",
   "url",
   "intervalSeconds"
  ],
  "type": "object"
 },
 "name": "create_health_check"
}

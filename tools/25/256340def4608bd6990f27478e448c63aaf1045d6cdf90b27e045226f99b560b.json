{
 "description": "Record a push-style heartbeat for an agent you own, marking it alive right now. The server sets the timestamp; no client-supplied time is accepted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "slug": {
    "description": "The agent's URL slug (from its public profile or a list_agents result).",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "send_heartbeat",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "lastHeartbeatAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "slug": {
    "type": "string"
   },
   "status": {
    "enum": [
     "unknown",
     "healthy",
     "degraded",
     "down"
    ],
    "type": "string"
   }
  },
  "required": [
   "slug",
   "status",
   "lastHeartbeatAt"
  ],
  "type": "object"
 },
 "title": "Send Heartbeat"
}

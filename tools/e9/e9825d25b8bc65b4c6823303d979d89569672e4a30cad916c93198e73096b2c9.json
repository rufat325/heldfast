{
 "description": "Rotate the simulator device left or right. Uses Cmd+Arrow keyboard shortcut in Simulator.app.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "direction": {
    "description": "Rotation direction",
    "enum": [
     "left",
     "right"
    ],
    "type": "string"
   }
  },
  "required": [
   "direction"
  ],
  "type": "object"
 },
 "name": "simulator_rotate"
}

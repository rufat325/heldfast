{
 "_meta": {
  "openai/outputTemplate": "ui://widget/search-results.html",
  "openai/toolInvocation/invoked": "Found matching bikes on Cyclesite",
  "openai/toolInvocation/invoking": "Searching live UK listings\u2026"
 },
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search bikes for sale"
 },
 "description": "Search live UK used-bike listings on Cyclesite (the UK's used bicycle marketplace). Filter by brand, category, city, price range, and condition. Returns up to 5 active listings with specs and listing URLs. Live data \u2014 refreshed continuously as new bikes are listed. Example queries: 'a Trek Domane in Manchester under \u00a32,000', 'gravel bike, very good condition, near Bristol'.",
 "inputSchema": {
  "properties": {
   "brand": {
    "description": "Bike brand (e.g. Trek, Specialized, Canyon).",
    "type": "string"
   },
   "category": {
    "description": "Bike category.",
    "enum": [
     "road",
     "mtb",
     "gravel",
     "hybrid",
     "ebike",
     "kids",
     "bmx",
     "folding",
     "city",
     "touring",
     "triathlon",
     "track",
     "cyclocross",
     "cargo",
     "adaptive",
     "other"
    ],
    "type": "string"
   },
   "city": {
    "description": "UK city.",
    "type": "string"
   },
   "condition": {
    "description": "Condition rating.",
    "enum": [
     "Excellent",
     "Very_Good",
     "Good",
     "Fair",
     "Poor",
     "For_Parts"
    ],
    "type": "string"
   },
   "maxPrice": {
    "description": "Maximum price in GBP.",
    "type": "number"
   },
   "minPrice": {
    "description": "Minimum price in GBP.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search_bikes",
 "outputSchema": {
  "properties": {
   "attribution": {
    "description": "Citation string \u2014 include verbatim when surfacing data.",
    "type": "string"
   },
   "listings": {
    "items": {
     "properties": {
      "brand": {
       "type": [
        "string",
        "null"
       ]
      },
      "city": {
       "type": [
        "string",
        "null"
       ]
      },
      "condition": {
       "type": "string"
      },
      "delivery": {
       "type": [
        "string",
        "null"
       ]
      },
      "distanceMiles": {
       "type": [
        "number",
        "null"
       ]
      },
      "ebikeBatteryWh": {
       "type": [
        "number",
        "null"
       ]
      },
      "ebikeMotor": {
       "type": [
        "string",
        "null"
       ]
      },
      "frameMaterial": {
       "type": [
        "string",
        "null"
       ]
      },
      "frameSize": {
       "type": [
        "string",
        "null"
       ]
      },
      "groupset": {
       "type": [
        "string",
        "null"
       ]
      },
      "imageUrl": {
       "format": "uri",
       "type": [
        "string",
        "null"
       ]
      },
      "isEbike": {
       "type": "boolean"
      },
      "listingId": {
       "type": [
        "string",
        "null"
       ]
      },
      "model": {
       "type": [
        "string",
        "null"
       ]
      },
      "negotiable": {
       "type": "boolean"
      },
      "offer": {
       "description": "UCP/ACP-shaped commerce signal for this listing.",
       "properties": {
        "availability": {
         "type": "string"
        },
        "itemCondition": {
         "type": "string"
        },
        "price": {
         "type": "number"
        },
        "priceCurrency": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "priceGbp": {
       "description": "Price in GBP.",
       "type": "number"
      },
      "slug": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": [
        "string",
        "null"
       ]
      },
      "wheelSize": {
       "type": [
        "string",
        "null"
       ]
      },
      "year": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "resultsCount": {
    "type": "number"
   }
  },
  "required": [
   "attribution",
   "resultsCount",
   "listings"
  ],
  "type": "object"
 }
}

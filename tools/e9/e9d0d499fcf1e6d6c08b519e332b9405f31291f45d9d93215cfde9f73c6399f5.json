{
 "description": "Send a push notification to an app. Provide the full APNs payload JSON (e.g., {\"aps\": {\"alert\": \"Hello\"}}).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundleId": {
    "description": "App bundle ID to receive the push",
    "type": "string"
   },
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "payload": {
    "additionalProperties": {},
    "description": "Push notification JSON payload (e.g., {\"aps\": {\"alert\": \"Hello\"}})",
    "type": "object"
   }
  },
  "required": [
   "bundleId",
   "payload"
  ],
  "type": "object"
 },
 "name": "simulator_send_push"
}

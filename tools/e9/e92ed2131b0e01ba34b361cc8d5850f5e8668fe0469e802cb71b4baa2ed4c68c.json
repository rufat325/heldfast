{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Wake a named agent through the server-side notification route. Prefer the target agent's full identity address (localpart@domain); bare localpart remains compatible for legacy single-domain deployments. The server owns topics and credentials.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "level": {
    "description": "urgent, normal (default), or low",
    "enum": [
     "urgent",
     "normal",
     "low"
    ],
    "type": "string"
   },
   "message": {
    "description": "Notification body",
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Target agent full address preferred (e.g. qa-bot@example.com); bare localpart (e.g. qa-bot) for legacy single-domain",
    "pattern": "^[a-z0-9][a-z0-9._-]{0,62}(?:@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*)?$",
    "type": "string"
   },
   "tags": {
    "description": "Optional ntfy tags",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "title": {
    "description": "Short notification title",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "title",
   "message"
  ],
  "type": "object"
 },
 "name": "notify_agent",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "level": {
    "enum": [
     "urgent",
     "normal",
     "low"
    ],
    "type": "string"
   },
   "target": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "target",
   "title",
   "level"
  ],
  "type": "object"
 },
 "title": "Notify Agent"
}

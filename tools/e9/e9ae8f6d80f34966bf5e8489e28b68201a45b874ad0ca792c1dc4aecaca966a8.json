{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "update_chute_session"
 },
 "description": "Revise a PROPOSED chute session before the user starts it: rename it or replace its widget grid (full replacement list, same widget types and arrangement rules as create_chute_session). Sessions that have been started at the chute cannot be changed from here \u2014 only the operator can edit those in the app.",
 "inputSchema": {
  "properties": {
   "farm_id": {
    "description": "The ID of the farm (optional if a default is set).",
    "type": "string"
   },
   "group_name": {
    "description": "Group the processed animals join; created if it does not exist.",
    "type": "string"
   },
   "name": {
    "description": "New session name.",
    "type": "string"
   },
   "record_type": {
    "enum": [
     "FEED",
     "GENETIC",
     "HEALTH",
     "MOVEMENT",
     "OTHER"
    ],
    "type": "string"
   },
   "session_id": {
    "description": "The PROPOSED chute session UUID.",
    "type": "string"
   },
   "widgets": {
    "description": "Full replacement widget list, in display order.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "minLength": 1,
       "type": "string"
      },
      "label": {
       "minLength": 1,
       "type": "string"
      },
      "options": {
       "additionalProperties": {},
       "type": "object"
      },
      "size": {
       "enum": [
        "full",
        "half"
       ],
       "type": "string"
      },
      "type": {
       "enum": [
        "boolean",
        "number",
        "photo",
        "score",
        "select",
        "text",
        "treatment",
        "weight"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "type",
      "label"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "update_chute_session"
}

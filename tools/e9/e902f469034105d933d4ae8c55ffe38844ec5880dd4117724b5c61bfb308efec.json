{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Inspect one symbol: signature, callers, callees, area. Accepts name, file:line, glob or id.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "epistemic": {
    "description": "keep only edges of this evidence tier",
    "enum": [
     "observed",
     "name-matched",
     "declared"
    ],
    "type": "string"
   },
   "min_edge_confidence": {
    "description": "0..1 \u2014 drop edges below this confidence",
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "pick": {
    "description": "nth candidate if ambiguous",
    "type": "number"
   },
   "response_format": {
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_node"
}

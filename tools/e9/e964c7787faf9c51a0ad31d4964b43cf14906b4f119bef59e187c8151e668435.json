   {
    "commodity": "corn",
    "country": "CN",
    "end_year": "2024",
    "start_year": "2020"
   },
   {
    "commodity": "soybeans"
   }
  ],
  "properties": {
   "commodity": {
    "description": "Commodity name (e.g., \"corn\", \"soybeans\", \"wheat\", \"beef\", \"pork\", \"cotton\") or commodity code",
    "type": "string"
   },
   "country": {
    "description": "Destination country code (e.g., \"CN\" for China, \"MX\" for Mexico, \"JP\" for Japan). Optional \u2014 omit for all destinations.",
    "type": "string"
   },
   "end_year": {
    "description": "End year (e.g., \"2024\"). Optional.",
    "type": "string"
   },
   "start_year": {
    "description": "Start year (e.g., \"2020\"). Optional.",
    "type": "string"
   }
  },

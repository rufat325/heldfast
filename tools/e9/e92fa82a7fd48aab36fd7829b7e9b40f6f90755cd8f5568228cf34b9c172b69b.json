 "description": "Search bills in any US statehouse. Pass jurisdiction as a 2-letter state code (e.g., \"CA\", \"NY\", \"TX\") or full name. Returns bill identifiers, titles, classifications, last action, sponsors, and OpenStates IDs for use with get_bill.",
 "inputSchema": {
  "examples": [
   {
    "jurisdiction": "CA",
    "query": "healthcare"
   },
   {
    "classification": "bill",
    "jurisdiction": "NY",
    "per_page": 10,
    "query": "education funding",
    "session": "20232024",
    "sort": "updated_desc",
    "sponsor": "Smith"
   }
  ],

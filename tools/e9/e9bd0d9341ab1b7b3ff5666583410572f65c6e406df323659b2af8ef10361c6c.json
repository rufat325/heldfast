{
 "description": "List recent memories by creation time. Good for session context recovery.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hours": {
    "description": "Look back N hours (default 2)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "layer": {
    "description": "Filter by layer",
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "description": "Max results (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_importance": {
    "description": "Minimum importance threshold",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "namespace": {
    "description": "Filter by namespace (also includes \"default\" namespace automatically)",
    "type": "string"
   },
   "source": {
    "description": "Filter by source (e.g. session)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "engram_recent"
}

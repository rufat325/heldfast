    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "endX": {
    "description": "End X coordinate",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "endY": {
    "description": "End Y coordinate",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   },
   "startX": {
    "description": "Start X coordinate",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "startY": {
    "description": "Start Y coordinate",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "startX",
   "startY",
   "endX",
   "endY"
  ],
  "type": "object"
 },
 "name": "drag_drop",

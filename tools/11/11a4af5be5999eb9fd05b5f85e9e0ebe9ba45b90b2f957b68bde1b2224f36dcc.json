{
 "description": "Long press at screen coordinates. Useful for context menus, drag handles, and press-and-hold interactions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_id": {
    "description": "Device ID (optional if only one device)",
    "type": "string"
   },
   "duration_ms": {
    "default": 1000,
    "description": "Hold duration in ms (default 1000)",
    "type": "number"
   },
   "x": {
    "description": "X coordinate",
    "type": "number"
   },
   "y": {
    "description": "Y coordinate",
    "type": "number"
   }
  },
  "required": [
   "x",
   "y"
  ],
  "type": "object"
 },
 "name": "long_press"
}

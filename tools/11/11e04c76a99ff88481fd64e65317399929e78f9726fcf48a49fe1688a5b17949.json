{
 "annotations": {
  "cost": {
   "all": 5
  },
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "\"Find restaurants / hotels / coffee shops / [businesses] near [location]\" / \"nearby [type] within [radius]\" / \"places to eat in [area]\" \u2014 find nearby businesses and points of interest via Google Maps Places. Returns names, addresses, Google ratings, distances. Premium-quality POI data; requires Google Maps API key. Use over Yelp/OSM when you want Google's POI coverage and ratings.",
 "inputSchema": {
  "examples": [
   {
    "_apiKey": "your-google_maps-api-key",
    "query": "pizza near Times Square"
   },
   {
    "_apiKey": "your-google_maps-api-key",
    "location": "40.7128,-74.0060",
    "query": "coffee",
    "radius": 1000
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "Google Maps API key",
    "type": "string"
   },
   "location": {
    "description": "Center point as \"lat,lng\" (optional)",
    "type": "string"
   },
   "query": {
    "description": "Search query (e.g., \"pizza near Times Square\")",
    "type": "string"
   },
   "radius": {
    "description": "Search radius in meters (max 50000, default 5000)",
    "type": "number"
   }
  },
  "required": [
   "query",
   "_apiKey"
  ],
  "type": "object"
 },
 "name": "maps_place_search",
 "outputSchema": {
  "properties": {
   "results": {
    "description": "Array of places matching search criteria",
    "items": {
     "properties": {
      "business_status": {
       "description": "Business operational status",
       "type": "string"
      },
      "formatted_address": {
       "description": "Formatted address of the place",
       "type": "string"
      },
      "geometry": {
       "description": "Location geometry",
       "properties": {
        "location": {
         "properties": {
          "lat": {
           "description": "Latitude",
           "type": "number"
          },
          "lng": {
           "description": "Longitude",
           "type": "number"
          }
         },
         "type": "object"
        }
       },
       "type": "object"
      },
      "name": {
       "description": "Place name",
       "type": "string"
      },
      "place_id": {
       "description": "Unique Google place ID",
       "type": "string"
      },
      "rating": {
       "description": "Average user rating (0-5)",
       "type": "number"
      },
      "types": {
       "description": "Place type categories",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "Status of the place search request",
    "enum": [
     "OK",
     "ZERO_RESULTS",
     "INVALID_REQUEST",
     "OVER_QUERY_LIMIT",
     "REQUEST_DENIED",
     "UNKNOWN_ERROR"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Maps Place Search",
 "version": "v1.648de170"
}

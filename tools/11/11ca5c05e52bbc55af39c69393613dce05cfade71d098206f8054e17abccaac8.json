{
 "description": "Get detailed metadata about an installed app (bundle ID, paths, version, etc.).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundleId": {
    "description": "App bundle identifier (e.g., \"com.apple.mobilesafari\")",
    "type": "string"
   },
   "deviceId": {
    "description": "Device UDID, name, or \"booted\" (default: booted)",
    "type": "string"
   }
  },
  "required": [
   "bundleId"
  ],
  "type": "object"
 },
 "name": "simulator_app_info"
}

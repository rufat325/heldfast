{
 "description": "List WooCommerce orders",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Orders after date (YYYY-MM-DD)",
    "type": "string"
   },
   "before": {
    "description": "Orders before date (YYYY-MM-DD)",
    "type": "string"
   },
   "customer": {
    "description": "Customer ID",
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "per_page": {
    "default": 20,
    "type": "number"
   },
   "product": {
    "description": "Product ID",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "default": "any",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_list_orders"
}

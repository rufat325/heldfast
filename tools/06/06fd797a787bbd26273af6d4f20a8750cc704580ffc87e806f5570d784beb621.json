    "format": "uuid",
    "type": "string"
   },
   "name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "steps": {
    "items": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 40,
    "minItems": 1,
    "type": "array"
   },
   "version": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "version",
   "steps"
  ],
  "type": "object"
 },
 "name": "create_protocol_version"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Create a producer-approved immutable farm protocol version from the exact named steps provided. Do not invent or prescribe care steps.",
 "inputSchema": {

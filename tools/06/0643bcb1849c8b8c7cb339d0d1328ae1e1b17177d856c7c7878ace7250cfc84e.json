{
 "description": "List issues in an organization with optional filters. An issue is a unique error grouped by fingerprint. Returns id, title, level, status, lastSeen, firstSeen, count, and project info.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Pagination cursor. Omit for first page.",
    "type": "string"
   },
   "environment": {
    "description": "Filter by environment name (e.g. 'production', 'staging')",
    "type": "string"
   },
   "level": {
    "description": "Minimum issue severity level",
    "enum": [
     "debug",
     "info",
     "warning",
     "error",
     "fatal"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Maximum issues to return (default 25)",
    "type": "number"
   },
   "org": {
    "description": "Organization slug (e.g. 'acme')",
    "type": "string"
   },
   "project": {
    "description": "Restrict to a single project ID. Get IDs from list_projects.",
    "type": "number"
   },
   "query": {
    "description": "Sentry search query (e.g. 'is:unresolved browser.name:Chrome')",
    "type": "string"
   },
   "sort": {
    "description": "Sort order (default 'date')",
    "enum": [
     "date",
     "new",
     "priority",
     "freq",
     "user",
     "trends"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by issue status",
    "enum": [
     "resolved",
     "unresolved",
     "ignored",
     "muted"
    ],
    "type": "string"
   }
  },
  "required": [
   "org"
  ],
  "type": "object"
 },
 "name": "list_issues"
}

{
 "description": "Converts a Hebrew date to a Gregorian (civil) date",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "day": {
    "description": "Hebrew day of month",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "month": {
    "description": "Hebrew month name transliterated, like Elul or Tishrei",
    "type": "string"
   },
   "year": {
    "description": "Hebrew year",
    "maximum": 9999,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "day",
   "month",
   "year"
  ],
  "type": "object"
 },
 "name": "convert-hebrew-to-gregorian"
}

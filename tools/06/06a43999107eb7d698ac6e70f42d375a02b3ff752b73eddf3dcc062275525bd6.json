{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search file contents with ripgrep. Default: summary-first discovery output; use `content` with `edit_ready=true` when you need verified edit hunks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allow_large_output": {
    "description": "Bypass the default content-mode block/char caps when you intentionally need a larger payload.",
    "type": "boolean"
   },
   "case_insensitive": {
    "description": "Ignore case (-i)",
    "type": "boolean"
   },
   "context": {
    "description": "Symmetric context lines around matches (-C)",
    "type": "number"
   },
   "context_after": {
    "description": "Context lines AFTER match (-A)",
    "type": "number"
   },
   "context_before": {
    "description": "Context lines BEFORE match (-B)",
    "type": "number"
   },
   "edit_ready": {
    "description": "Preserve hash/checksum search hunks in `content` mode. Default: false.",
    "type": "boolean"
   },
   "glob": {
    "description": "Glob filter (e.g. \"*.ts\")",
    "type": "string"
   },
   "head_limit": {
    "description": "Total match events across all files; multiline matches count as 1 (default: 50 for summary discovery, 200 for content, 1000 for files_with_matches/count, 0 = unlimited)",
    "type": "number"
   },
   "limit": {
    "description": "Max matches per file (default: 20 for summary discovery, 100 for content)",
    "type": "number"
   },
   "literal": {
    "description": "Literal string search, no regex (-F)",
    "type": "boolean"
   },
   "multiline": {
    "description": "Pattern can span multiple lines (-U)",
    "type": "boolean"
   },
   "output_mode": {
    "description": "Output format (default: summary)",
    "enum": [
     "summary",
     "content",
     "files_with_matches",
     "count"
    ],
    "type": "string"
   },
   "path": {
    "description": "Search dir/file (default: cwd)",
    "type": "string"
   },
   "pattern": {
    "description": "Search pattern (regex by default, literal if literal:true)",
    "type": "string"
   },
   "plain": {
    "description": "Omit hash tags, return file:line:content",
    "type": "boolean"
   },
   "smart_case": {
    "description": "CI when pattern is all lowercase, CS if uppercase (-S)",
    "type": "boolean"
   },
   "type": {
    "description": "File type (e.g. \"js\", \"py\")",
    "type": "string"
   }
  },
  "required": [
   "pattern"
  ],
  "type": "object"
 },
 "name": "grep_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "content": {
    "type": "string"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "recovery": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "recovery"
    ],
    "type": "object"
   },
   "failure_class": {
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "pattern": {
    "type": "string"
   },
   "recovery": {
    "type": "string"
   },
   "status": {
    "enum": [
     "OK",
     "ERROR",
     "AUTO_REBASED",
     "CONFLICT",
     "STALE",
     "INVALID",
     "NO_CHANGES",
     "CHANGED",
     "UNSUPPORTED"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Search Files"
}

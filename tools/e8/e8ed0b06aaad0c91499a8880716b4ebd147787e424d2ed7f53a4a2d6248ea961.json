 "description": "Return POIs sorted by distance from a lat/lon without a text query. Requires latitude+longitude; optional radius_m (default 500m) and numeric fsq_category_ids filter. Returns name, categories, address, distance, tel, website. rating/hours/popularity are Foursquare Premium fields \u2014 present only where enabled (see `rating_included` / `rating_note`).",
 "inputSchema": {
  "examples": [
   {
    "latitude": 51.5074,
    "limit": 20,
    "longitude": -0.1278,
    "radius_m": 500
   },
   {
    "categories": "13000,13001",
    "latitude": 35.6762,
    "limit": 15,
    "longitude": 139.6503,
    "radius_m": 2000
   }
  ],
  "properties": {
   "categories": {
    "description": "OPTIONAL numeric fsq_category_id values only (from a prior result). Do NOT invent IDs; unknown IDs are ignored.",
    "type": "string"
   },
   "latitude": {
    "description": "Latitude",
    "type": "number"
   },
   "limit": {
    "description": "Results (1-50, default 20)",
    "type": "number"
   },
   "longitude": {
    "description": "Longitude",
    "type": "number"
   },
   "radius_m": {
    "description": "1-100000 metres (default 500)",
    "type": "number"
   }
  },
  "required": [
   "latitude",
   "longitude"
  ],
  "type": "object"
 },

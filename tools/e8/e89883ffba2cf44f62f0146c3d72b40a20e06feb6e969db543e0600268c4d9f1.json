{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List media files in user's library (videos, audio, images)",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assetType": {
    "default": "all",
    "description": "Filter by asset type",
    "enum": [
     "video",
     "audio",
     "image",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of assets to return (1-50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Media asset offset.",
    "minimum": 0,
    "type": "integer"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "media_list",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "assets": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "bounds": {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "type": "number"
     },
     "maxLimit": {
      "type": "number"
     },
     "offset": {
      "type": "number"
     },
     "returned": {
      "type": "number"
     },
     "total": {
      "type": "number"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "limit",
     "maxLimit",
     "offset",
     "total",
     "returned",
     "hasMore",
     "truncated"
    ],
    "type": "object"
   }
  },
  "required": [
   "assets",
   "bounds"
  ],
  "type": "object"
 },
 "title": "List Media"
}

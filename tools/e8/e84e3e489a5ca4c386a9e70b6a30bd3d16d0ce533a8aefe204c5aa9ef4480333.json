{
 "description": "Set or update a key in an existing BrewPage KV store. Requires owner token.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "KV store ID",
    "type": "string"
   },
   "key": {
    "description": "Key to set",
    "type": "string"
   },
   "namespace": {
    "description": "KV store namespace",
    "type": "string"
   },
   "ownerToken": {
    "description": "Owner token received when the KV store was created",
    "type": "string"
   },
   "value": {
    "description": "Value to assign to the key",
    "type": "string"
   }
  },
  "required": [
   "namespace",
   "id",
   "key",
   "value",
   "ownerToken"
  ],
  "type": "object"
 },
 "name": "set_kv"
}

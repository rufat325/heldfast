 "description": "Recent Bitcoin transactions touching one address, read from the mempool.space block explorer API (mainnet by default; testnet, signet, and Liquid also selectable). Returns up to 50 transactions with txid, inputs, outputs, values in satoshis, fee, size, and confirmation status. Answers what a BTC address has been sending or receiving lately.",
 "inputSchema": {
  "examples": [
   {
    "address": "1A1z7agoat5JZ5sqM8cBkFFikTxGkna6uk",
    "limit": 25
   }
  ],
  "properties": {
   "address": {
    "type": "string"
   },
   "limit": {
    "description": "Default 25 (max ~50)",
    "type": "number"
   },
   "network": {
    "default": "mainnet",
    "description": "Which Bitcoin network. Defaults to mainnet \u2014 the real Bitcoin network, which is what \"Bitcoin\" means in an ordinary question. \"bitcoin\" and \"btc\" are accepted as aliases for mainnet.",
    "enum": [
     "mainnet",
     "testnet",
     "signet",
     "liquid"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_address_transactions",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Number of transactions returned",
    "type": "number"
   },
   "transactions": {
    "description": "Recent transactions for address",
    "items": {
     "properties": {
      "fee": {
       "description": "Fee in satoshis",
       "type": "number"
      },
      "locktime": {
       "description": "Locktime",
       "type": "number"
      },
      "size": {
       "description": "Size in bytes",
       "type": "number"
      },
      "status": {
       "description": "Confirmation status",
       "type": "object"
      },
      "txid": {
       "description": "Transaction ID",
       "type": "string"
      },
      "version": {
       "description": "Transaction version",
       "type": "number"
      },
      "vin": {
       "description": "Inputs",
       "type": "array"
      },
      "vout": {
       "description": "Outputs",
       "type": "array"
      },
      "weight": {
       "description": "Weight in WU",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "transactions"
  ],
  "type": "object"
 },
 "title": "Get Address Transactions",
 "version": "v1.5cff899b"

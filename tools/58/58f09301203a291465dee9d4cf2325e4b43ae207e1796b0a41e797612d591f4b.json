{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Ask an audience"
 },
 "description": "Ask simulated people a multiple-choice question (2 to 10 options) and get each person's pick and reasoning. Use it for naming, positioning, or which feature to build next. Each person answers on their own.",
 "inputSchema": {
  "properties": {
   "audience": {
    "description": "Who to ask, e.g. \"SaaS founders with 10 to 50 employees\".",
    "maxLength": 500,
    "type": "string"
   },
   "concurrency": {
    "default": 6,
    "description": "Parallel workers (default 6).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "context": {
    "default": "Product validation survey",
    "description": "What the question is for.",
    "maxLength": 500,
    "type": "string"
   },
   "count": {
    "default": 10,
    "description": "How many simulated people (default 10, max 50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "options": {
    "description": "Answer options (2 to 10).",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "question": {
    "description": "The question.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "timeout_seconds": {
    "default": 300,
    "maximum": 900,
    "minimum": 30,
    "type": "integer"
   }
  },
  "required": [
   "audience",
   "question",
   "options"
  ],
  "type": "object"
 },
 "name": "mimiq.ask_audience"
}

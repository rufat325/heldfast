{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "[Requires login] Post a new text-status update to the authenticated user's own AniList profile, or update an existing one by passing its `id`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Activity ID to update instead of creating a new post.",
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   },
   "text": {
    "description": "The text to post (per AniList's own schema: 5-10000 characters).",
    "maxLength": 10000,
    "minLength": 5,
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "post_text_activity",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "activity": {
    "additionalProperties": {},
    "properties": {
     "id": {
      "exclusiveMinimum": 0,
      "maximum": 2147483647,
      "type": "integer"
     },
     "siteUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "text": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "activity"
  ],
  "type": "object"
 },
 "title": "Post a text activity"
}

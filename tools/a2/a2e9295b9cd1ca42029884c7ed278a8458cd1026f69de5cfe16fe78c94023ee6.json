{
 "description": "Search YouTube Shorts. Paginate with next_cursor/has_more. 2 credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Pagination cursor from previous response.",
    "type": "string"
   },
   "search": {
    "description": "Search query.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "sort_by": {
    "default": "relevance",
    "description": "Sort order.",
    "enum": [
     "relevance",
     "date",
     "view_count",
     "rating"
    ],
    "type": "string"
   }
  },
  "required": [
   "search"
  ],
  "type": "object"
 },
 "name": "search_youtube_shorts"
}

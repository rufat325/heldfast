  "additionalProperties": false,
  "properties": {
   "participant_token": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "visit_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "participant_token",
   "visit_id"
  ],
  "type": "object"
 },
 "name": "cafe_leave"
}

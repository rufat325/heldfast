{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "End your own seat and return to your task. Requires its private participant_token and visit_id. No explanation, continued attendance or follow-up is required. Expired seats are reported as expired rather than voluntary departures.",

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update the comment on existing records in an RRSet (matched by value). The comment field is always sent \u2014 use an empty string to clear.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id_or_name": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^[^/\\s]+$",
      "type": "string"
     }
    ],
    "description": "Zone ID or name"
   },
   "name": {
    "description": "RRSet name",
    "pattern": "^[^/\\s]+$",
    "type": "string"
   },
   "records": {
    "description": "Records to update",
    "items": {
     "properties": {
      "comment": {
       "description": "New comment to set on the record; empty string clears it",
       "type": "string"
      },
      "value": {
       "description": "Existing record value to match",
       "type": "string"
      }
     },
     "required": [
      "value",
      "comment"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "type": {
    "description": "DNS record type (A, AAAA, CNAME, MX, NS, TXT, etc.)",
    "enum": [
     "A",
     "AAAA",
     "CAA",
     "CNAME",
     "DS",
     "HINFO",
     "HTTPS",
     "MX",
     "NS",
     "PTR",
     "RP",
     "SOA",
     "SRV",
     "SVCB",
     "TLSA",
     "TXT"
    ],
    "type": "string"
   }
  },
  "required": [
   "id_or_name",
   "name",
   "type",
   "records"
  ],
  "type": "object"
 },
 "name": "hetzner_update_zone_rrset_records",
 "title": "Update DNS Zone RRSet Record Comments"
}

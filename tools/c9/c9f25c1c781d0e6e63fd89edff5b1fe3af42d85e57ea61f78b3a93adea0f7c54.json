{
 "description": "Update AnalyticsBundle settings for a project.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "update": {
    "additionalProperties": false,
    "properties": {
     "aggregate_retention_months": {
      "maximum": 120,
      "minimum": 1,
      "type": "integer"
     },
     "approved_custom_dimensions": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "capture_actions": {
      "type": "boolean"
     },
     "capture_friction_signals": {
      "type": "boolean"
     },
     "capture_page_views": {
      "type": "boolean"
     },
     "capture_route_changes": {
      "type": "boolean"
     },
     "consent_required": {
      "type": "boolean"
     },
     "enabled": {
      "type": "boolean"
     },
     "hourly_retention_days": {
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     },
     "journey_sample_rate": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "max_custom_dimensions": {
      "maximum": 20,
      "minimum": 0,
      "type": "integer"
     },
     "max_saved_funnels": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "privacy_mode": {
      "enum": [
       "strict",
       "standard",
       "custom"
      ],
      "type": "string"
     },
     "raw_retention_days": {
      "maximum": 30,
      "minimum": 1,
      "type": "integer"
     },
     "sample_retention_days": {
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "update"
  ],
  "type": "object"
 },
 "name": "update_analytics_settings"
}

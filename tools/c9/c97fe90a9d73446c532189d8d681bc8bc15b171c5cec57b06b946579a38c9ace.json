{
 "description": "Locally validate the browser adapter capabilities and ordered, value-free proof stages required to claim one resume attachment. This helper does not open a chooser, read a local path, control the browser, or send values to Trackly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capabilities": {
    "additionalProperties": false,
    "properties": {
     "chooserArming": {
      "type": "boolean"
     },
     "committedFilenameInspection": {
      "type": "boolean"
     },
     "fileAttachment": {
      "type": "boolean"
     },
     "parserFieldRecheck": {
      "type": "boolean"
     },
     "semanticControlDiscovery": {
      "type": "boolean"
     }
    },
    "required": [
     "semanticControlDiscovery",
     "chooserArming",
     "fileAttachment",
     "committedFilenameInspection",
     "parserFieldRecheck"
    ],
    "type": "object"
   },
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "events": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "failureCode": {
       "enum": [
        "upload_capability_unavailable",
        "upload_stage_missing",
        "upload_stage_out_of_order",
        "upload_stage_duplicate",
        "control_ambiguous",
        "chooser_timeout",
        "chooser_open_without_commit",
        "file_missing",
        "file_expired",
        "set_files_failed",
        "filename_uncommitted",
        "unexpected_file_navigation",
        "parser_unsettled",
        "parser_field_regression"
       ],
       "type": "string"
      },
      "outcome": {
       "enum": [
        "passed",
        "failed"
       ],
       "type": "string"
      },
      "stage": {
       "enum": [
        "semantic_control_discovered",
        "file_chooser_armed",
        "file_chooser_opened",
        "set_files_succeeded",
        "user_facing_filename_committed",
        "parser_fields_rechecked"
       ],
       "type": "string"
      }
     },
     "required": [
      "stage",
      "outcome"
     ],
     "type": "object"
    },
    "maxItems": 6,
    "type": "array"
   }
  },
  "required": [
   "capabilities",
   "events"
  ],
  "type": "object"
 },
 "name": "trackly_validate_apply_resume_upload"
}

 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "jobHuntId": {
    "description": "Filter by job hunt ID",
    "type": "string"
   },
   "limit": {
    "description": "Number of results per page (default: 20, max: 50)",
    "type": "number"
   },
   "page": {

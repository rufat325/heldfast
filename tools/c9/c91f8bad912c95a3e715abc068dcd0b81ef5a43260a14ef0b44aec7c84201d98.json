   },
   "status": {
    "description": "Filter by status (e.g., \"PENDING\", \"APPLIED\", \"INTERVIEW\", \"OFFER\", \"REJECTED\")",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_applications"
}

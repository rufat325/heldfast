{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Invite to board"
 },
 "description": "Invite a user to board by email with role ADMIN/MEMBER/VIEWER. Requires ADMIN/OWNER.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "board_id": {
    "description": "Board UUID",
    "format": "uuid",
    "type": "string"
   },
   "board_slug": {
    "description": "Board slug (alternative to board_id)",
    "type": "string"
   },
   "email": {
    "description": "Invitee email",
    "format": "email",
    "type": "string"
   },
   "role": {
    "description": "Role to grant on acceptance",
    "enum": [
     "ADMIN",
     "MEMBER",
     "VIEWER"
    ],
    "type": "string"
   }
  },
  "required": [
   "email",
   "role"
  ],
  "type": "object"
 },
 "name": "create_board_invitation",
 "title": "Invite to board"
}

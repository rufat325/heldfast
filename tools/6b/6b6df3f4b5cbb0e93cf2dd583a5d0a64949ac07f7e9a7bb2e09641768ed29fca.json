{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get recent attention history for a Topic.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "description": "Start of time window (ISO 8601)",
    "type": "string"
   },
   "measure": {
    "description": "trend for hourly scores; rank for recorded Trend-rank changes",
    "enum": [
     "trend",
     "rank"
    ],
    "type": "string"
   },
   "to": {
    "description": "End of time window (ISO 8601)",
    "type": "string"
   },
   "topicId": {
    "description": "Topic ID",
    "pattern": "^topic_[a-f\\d]{20}$",
    "type": "string"
   }
  },
  "required": [
   "topicId",
   "measure"
  ],
  "type": "object"
 },
 "name": "get_topic_series",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "basis": {
      "enum": [
       "hourly",
       "rank_transitions"
      ],
      "type": "string"
     },
     "measure": {
      "enum": [
       "trend",
       "rank"
      ],
      "type": "string"
     },
     "points": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "at": {
         "type": "string"
        },
        "clusters": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "count": {
            "type": "number"
           },
           "id": {
            "type": "string"
           },
           "name": {
            "type": "string"
           }
          },
          "required": [
           "id",
           "count"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "value": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "at",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "topic": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "name"
      ],
      "type": "object"
     },
     "window": {
      "additionalProperties": false,
      "properties": {
       "from": {
        "type": "string"
       },
       "to": {
        "type": "string"
       }
      },
      "required": [
       "from",
       "to"
      ],
      "type": "object"
     }
    },
    "required": [
     "measure",
     "basis",
     "window",
     "points",
     "topic"
    ],
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "versions": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "required": [
     "versions"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "Get topic history"
}

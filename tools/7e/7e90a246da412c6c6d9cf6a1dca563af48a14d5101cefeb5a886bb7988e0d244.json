   "address": {
    "description": "Street address",
    "type": "string"
   },
   "addressNumber": {
    "description": "Address number",
    "type": "string"
   },
   "companyType": {
    "description": "Company type",
    "enum": [
     "MEI",
     "LIMITED",
     "INDIVIDUAL",
     "ASSOCIATION"
    ],
    "type": "string"
   },
   "cpfCnpj": {
    "description": "CPF or CNPJ (numbers only)",
    "type": "string"
   },
   "email": {
    "description": "Email address",
    "type": "string"
   },
   "mobilePhone": {
    "description": "Mobile phone number",
    "type": "string"
   },
   "name": {
    "description": "Subaccount name",
    "type": "string"
   },
   "phone": {
    "description": "Phone number",
    "type": "string"
   },
   "postalCode": {
    "description": "Postal code (CEP)",
    "type": "string"
   },
   "province": {
    "description": "Neighborhood",
    "type": "string"
   }

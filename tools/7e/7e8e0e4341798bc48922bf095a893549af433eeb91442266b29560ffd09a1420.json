{
 "description": "Update a matter. Only the provided fields change. Note: the public API has no documented way to move a matter between pipeline stages \u2014 sub_status_id is the closest control.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assigned_staff_ids": {
    "description": "User IDs from list-users.",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "case_blurb": {
    "type": "string"
   },
   "case_title": {
    "type": "string"
   },
   "email": {
    "type": "string"
   },
   "first_name": {
    "type": "string"
   },
   "last_name": {
    "type": "string"
   },
   "matter_id": {
    "description": "The matter (prospect) ID to update.",
    "type": "string"
   },
   "notes": {
    "description": "Additional notes to add.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "description": "Note body text.",
       "type": "string"
      },
      "name": {
       "description": "Note title.",
       "type": "string"
      }
     },
     "required": [
      "name",
      "body"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "phone": {
    "type": "string"
   },
   "practice_area_id": {
    "type": "integer"
   },
   "sub_status_id": {
    "type": "integer"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "matter_id"
  ],
  "type": "object"
 },
 "name": "update-matter"
}

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns a verified before/after migration recipe for a single Reactive Forms construct (e.g. \"FormControl\", \"FormBuilder.group\", \"Validators.required\"). An unknown construct returns found:false plus the list of available constructs \u2014 it is never an error. Read-only: this tool never modifies your files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "construct": {
    "description": "Reactive Forms construct to look up, e.g. \"FormControl\", \"FormBuilder.group\", \"Validators.required\".",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "construct"
  ],
  "type": "object"
 },
 "name": "get_signalforms_recipe",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "type": "string"
   },
   "availableConstructs": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "before": {
    "type": "string"
   },
   "caveats": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "construct": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "found": {
    "type": "boolean"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "retrievedISO": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "sources": {
      "items": {
       "format": "uri",
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "verifiedAgainstVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "versionSensitive": {
      "type": "boolean"
     }
    },
    "required": [
     "verifiedAgainstVersion",
     "retrievedISO",
     "sources",
     "versionSensitive"
    ],
    "type": "object"
   }
  },
  "required": [
   "construct",
   "found"
  ],
  "type": "object"
 },
 "title": "Get an Angular Signal Forms migration recipe"
}

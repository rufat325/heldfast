{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new acceptance criterion for a user story in BDD format (Given/When/Then). Use this to flesh out what 'done' means for a story before or during implementation. You can call this multiple times to add multiple scenarios (happy path, error cases, edge cases) to the same story.",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "Optional plain-text summary",
    "type": "string"
   },
   "givenCondition": {
    "description": "Precondition / context ('Given \u2026')",
    "type": "string"
   },
   "scenarioCategory": {
    "default": "happy_path",
    "enum": [
     "happy_path",
     "error_scenario",
     "edge_case"
    ],
    "type": "string"
   },
   "status": {
    "default": "draft",
    "enum": [
     "draft",
     "pending",
     "passed",
     "failed"
    ],
    "type": "string"
   },
   "storyId": {
    "description": "ID of the user story this criterion belongs to",
    "type": "string"
   },
   "thenOutcome": {
    "description": "Expected result ('Then \u2026')",
    "type": "string"
   },
   "whenAction": {
    "description": "Action performed ('When \u2026')",
    "type": "string"
   }
  },
  "required": [
   "storyId",
   "givenCondition",
   "whenAction",
   "thenOutcome"
  ],
  "type": "object"
 },
 "name": "vibemap_create_acceptance_criterion"
}

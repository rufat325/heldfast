{
 "description": "Get aggregate AnalyticsBundle funnel conversion and dropoff analysis.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "authState": {
    "enum": [
     "anonymous",
     "authenticated",
     "unknown"
    ],
    "type": "string"
   },
   "bearerToken": {
    "type": "string"
   },
   "browser": {
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "customDimensions": {
    "additionalProperties": {
     "maxLength": 128,
     "type": "string"
    },
    "propertyNames": {
     "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    },
    "type": "object"
   },
   "deviceType": {
    "type": "string"
   },
   "environment": {
    "type": "string"
   },
   "from": {
    "type": "string"
   },
   "funnelKey": {
    "type": "string"
   },
   "granularity": {
    "enum": [
     "hour",
     "day"
    ],
    "type": "string"
   },
   "language": {
    "type": "string"
   },
   "last": {
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "os": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "referrer": {
    "type": "string"
   },
   "route": {
    "type": "string"
   },
   "service": {
    "type": "string"
   },
   "to": {
    "type": "string"
   },
   "utmCampaign": {
    "type": "string"
   },
   "utmMedium": {
    "type": "string"
   },
   "utmSource": {
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "funnelKey"
  ],
  "type": "object"
 },
 "name": "get_funnel_analysis"
}

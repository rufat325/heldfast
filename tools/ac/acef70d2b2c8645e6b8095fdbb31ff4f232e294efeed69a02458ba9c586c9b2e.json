{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs golangci-lint and returns structured lint diagnostics (file, line, linter, severity, message).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buildTags": {
    "description": "Build tags for correct analysis (--build-tags <tag1,tag2,...>)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "concurrency": {
    "description": "Number of CPUs to use for linting (--concurrency <n>). Default: number of CPUs.",
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "config": {
    "description": "Path to golangci-lint config file",
    "maxLength": 4096,
    "type": "string"
   },
   "disable": {
    "description": "Disable specific linters (--disable <linter1,linter2,...>)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "enable": {
    "description": "Enable specific linters (--enable <linter1,linter2,...>)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "fast": {
    "default": false,
    "description": "Run only fast linters for quick feedback during iteration (--fast)",
    "type": "boolean"
   },
   "fix": {
    "default": false,
    "description": "Automatically fix found issues where possible (--fix)",
    "type": "boolean"
   },
   "maxIssuesPerLinter": {
    "description": "Maximum issues per linter (--max-issues-per-linter <n>). 0 means unlimited. Default: 50.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "maxSameIssues": {
    "description": "Maximum number of same issues reported (--max-same-issues <n>). 0 means unlimited. Default: 3.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "new": {
    "default": false,
    "description": "Show only new issues (--new). Useful for incremental linting.",
    "type": "boolean"
   },
   "newFromRev": {
    "description": "Show only new issues created after the specified git revision (--new-from-rev <rev>). Essential for PR review workflows.",
    "maxLength": 255,
    "type": "string"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "./..."
    ],
    "description": "File patterns or packages to lint (default: ['./...'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "presets": {
    "description": "Enable linter presets (--presets <preset1,preset2,...>)",
    "items": {
     "enum": [
      "bugs",
      "comment",
      "complexity",
      "error",
      "format",
      "import",
      "metalinter",
      "module",
      "performance",
      "sql",
      "style",
      "test",
      "unused"
     ],
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "sortResults": {
    "default": false,
    "description": "Sort lint results for consistent output (--sort-results)",
    "type": "boolean"
   },
   "timeout": {
    "description": "Timeout for the linter run (--timeout <duration>). Example: '5m', '300s'. Default: 1m.",
    "maxLength": 255,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "golangci-lint",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "fix": {
       "additionalProperties": false,
       "properties": {
        "range": {
         "additionalProperties": false,
         "properties": {
          "end": {
           "additionalProperties": false,
           "properties": {
            "column": {
             "type": "number"
            },
            "line": {
             "type": "number"
            }
           },
           "required": [
            "line"
           ],
           "type": "object"
          },
          "start": {
           "additionalProperties": false,
           "properties": {
            "column": {
             "type": "number"
            },
            "line": {
             "type": "number"
            }
           },
           "required": [
            "line"
           ],
           "type": "object"
          }
         },
         "required": [
          "start",
          "end"
         ],
         "type": "object"
        },
        "text": {
         "type": "string"
        }
       },
       "required": [
        "text"
       ],
       "type": "object"
      },
      "line": {
       "type": "number"
      },
      "linter": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "linter",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnosticsOmitted": {
    "type": "number"
   },
   "error": {
    "type": "string"
   },
   "errors": {
    "type": "number"
   },
   "exitCode": {
    "type": "number"
   },
   "resultsTruncated": {
    "type": "boolean"
   },
   "warnings": {
    "type": "number"
   }
  },
  "required": [
   "errors",
   "warnings"
  ],
  "type": "object"
 },
 "title": "golangci-lint"
}

{
 "description": "Quickly search for Reddit posts, comments, or users. Best for general information gathering.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "description": "Max number of results.",
    "type": "number"
   },
   "query": {
    "description": "The search keyword.",
    "type": "string"
   },
   "sort": {
    "description": "Sort order.",
    "enum": [
     "relevance",
     "hot",
     "top",
     "new"
    ],
    "type": "string"
   },
   "subreddits": {
    "description": "Limit search to specific subreddits (e.g., [\"marketing\", \"SaaS\"]).",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "reddit_fast_search"
}

{
 "description": "List recent Smart Money prediction calls across accounts. Optional niche and exclude list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "Window in days (default 14)",
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "exclude": {
    "description": "Comma-separated @handles to exclude",
    "type": "string"
   },
   "limit": {
    "description": "Max claims (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "niche": {
    "description": "Optional niche filter",
    "enum": [
     "MACRO",
     "TRADING",
     "CRYPTO",
     "GEOPOLITICS",
     "macro",
     "trading",
     "crypto",
     "geopolitics"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "xflux_smart_money_claims"
}

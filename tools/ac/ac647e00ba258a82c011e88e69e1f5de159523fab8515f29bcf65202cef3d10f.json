{
 "description": "Correct a logged meal item by id (from log_meal/get_day) so the history stays accurate. Pass only the fields to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cal": {
    "type": "number"
   },
   "carb_g": {
    "type": "number"
   },
   "description": {
    "type": "string"
   },
   "fat_g": {
    "type": "number"
   },
   "fiber_g": {
    "type": "number"
   },
   "grams": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "id": {
    "description": "Meal entry id.",
    "type": "integer"
   },
   "meal": {
    "enum": [
     "breakfast",
     "lunch",
     "dinner",
     "snack"
    ],
    "type": "string"
   },
   "protein_g": {
    "type": "number"
   },
   "qty": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "unit": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "edit_entry",
 "title": "Edit a logged item"
}

{
 "description": "Create a non-destructive, versioned edit of a project image. editType: staging/destaging, twilight(+_interior), upscale, green_grass, bright_day, seasonal (winter/halloween/christmas +_interior), advanced replace/remove/add (need advancedParams), or manual (customPrompt). staging needs roomType+style. Async \u2014 returns a jobId; the new version appears on the image. Costs 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "advancedParams": {
    "additionalProperties": false,
    "description": "Required for replace/remove/add.",
    "properties": {
     "target": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "required": [
     "target"
    ],
    "type": "object"
   },
   "customPrompt": {
    "description": "Required for editType='manual'.",
    "type": "string"
   },
   "editType": {
    "enum": [
     "staging",
     "destaging",
     "twilight",
     "twilight_interior",
     "replace",
     "remove",
     "add",
     "winter",
     "halloween",
     "halloween_interior",
     "christmas",
     "christmas_interior",
     "manual",
     "green_grass",
     "bright_day",
     "upscale"
    ],
    "type": "string"
   },
   "imageId": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "roomType": {
    "description": "Required for staging + advanced/interior edits.",
    "type": "string"
   },
   "style": {
    "description": "Required for staging.",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "imageId",
   "editType"
  ],
  "type": "object"
 },
 "name": "edit_image",
 "title": "Edit a project image (Gemini)"
}

{
 "description": "Get the top Polymarket traders ranked by realized P&L, win rate, or volume from the Beefy P&L subgraph.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "first": {
    "default": 10,
    "description": "Number of traders to return (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "minTrades": {
    "default": 10,
    "description": "Minimum number of trades to filter out inactive accounts",
    "minimum": 1,
    "type": "number"
   },
   "orderBy": {
    "default": "totalRealizedPnl",
    "description": "Metric to rank traders by",
    "enum": [
     "totalRealizedPnl",
     "collateralVolume",
     "winRate",
     "profitFactor",
     "numTrades"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_top_traders"
}

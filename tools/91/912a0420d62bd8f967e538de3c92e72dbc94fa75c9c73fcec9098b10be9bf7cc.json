 "description": "Get georeferenced observation records for a species with coordinates, dates, and sources. Pass either `name` (a scientific name like \"Danaus plexippus\" \u2014 resolved automatically) or a numeric GBIF backbone `key`. Filter by country code (e.g., 'US', 'BR', 'AU') to narrow results geographically.",
 "inputSchema": {
  "examples": [
   {
    "key": 2436436,
    "limit": 100
   },
   {
    "country": "US",
    "key": 2436436,
    "limit": 50
   }
  ],
  "properties": {
   "country": {
    "description": "ISO 3166-1 alpha-2 country code to filter occurrences (e.g., \"US\", \"DE\")",
    "type": "string"
   },
   "key": {
    "description": "GBIF backbone taxon key (integer), e.g. 5133088. Alternative to `name`.",
    "type": "number"
   },
   "limit": {
    "description": "Maximum records to return (1-300, default 20)",
    "type": "number"
   },
   "name": {
    "description": "Scientific name, e.g. \"Danaus plexippus\". Resolved to a GBIF backbone taxon key automatically. Use this unless you already hold a key.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },

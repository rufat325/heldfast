{
 "description": "Get the daily menu (Speiseplan): dishes with prices and the PDF last-updated date.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "get_menu",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "contact": {
    "additionalProperties": false,
    "description": "Restaurant contact details.",
    "properties": {
     "address": {
      "description": "Street address of the restaurant.",
      "type": "string"
     },
     "email": {
      "description": "Email address.",
      "type": "string"
     },
     "mapsLink": {
      "description": "Share link to the restaurant location on Google Maps.",
      "type": "string"
     },
     "phone": {
      "description": "Telephone number.",
      "type": "string"
     }
    },
    "required": [
     "address",
     "mapsLink",
     "phone",
     "email"
    ],
    "type": "object"
   },
   "currency": {
    "description": "ISO 4217 currency code for all dish prices.",
    "type": "string"
   },
   "dishes": {
    "description": "Dishes with prices in EUR.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "price": {
       "description": "Price in EUR, always with exactly 2 decimal digits.",
       "type": "string"
      }
     },
     "required": [
      "name",
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "kitchenHours": {
    "description": "Kitchen working hours (when dishes are cooked/served), when known.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "from": {
       "description": "Opening time in HH:MM.",
       "type": "string"
      },
      "to": {
       "description": "Closing time in HH:MM.",
       "type": "string"
      }
     },
     "required": [
      "from",
      "to"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "lastUpdated": {
    "description": "Date the menu PDF was last updated (its creation date), in YYYY-MM-DD format.",
    "type": "string"
   }
  },
  "required": [
   "lastUpdated",
   "currency",
   "contact",
   "dishes"
  ],
  "type": "object"
 }
}

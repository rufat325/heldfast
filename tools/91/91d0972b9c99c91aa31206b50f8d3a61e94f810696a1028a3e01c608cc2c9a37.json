{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Status, stage, per-scene progress (scenesTotal/scenesDone/currentScene \u2014 populated for probe/record/render/voice/captions/compose), log tail, and final result or error (with failure-artifact paths and, on a genuine failure, a feedbackHint pointing at the feedback tool) of a pipeline job.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "jobId": {
    "type": "string"
   },
   "tailLines": {
    "description": "log lines to return (default 40)",
    "type": "number"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "job_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currentScene": {
    "type": [
     "string",
     "null"
    ]
   },
   "demoDir": {
    "type": "string"
   },
   "endedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "failureArtifacts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "feedbackHint": {
      "description": "present on a genuine failure (not a cancel) \u2014 nudges toward the feedback tool while context is fresh",
      "type": "string"
     },
     "logFile": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "salvaged": {
      "additionalProperties": false,
      "properties": {
       "scenes": {
        "type": "number"
       },
       "timeline": {
        "type": "string"
       }
      },
      "required": [
       "scenes",
       "timeline"
      ],
      "type": "object"
     },
     "stage": {
      "type": "string"
     }
    },
    "required": [
     "message",
     "stage",
     "failureArtifacts",
     "logFile"
    ],
    "type": "object"
   },
   "jobId": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "logFile": {
    "type": "string"
   },
   "logTail": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   },
   "scenesDone": {
    "type": "number"
   },
   "scenesTotal": {
    "type": [
     "number",
     "null"
    ]
   },
   "stage": {
    "type": "string"
   },
   "startedAt": {
    "type": "string"
   },
   "status": {
    "enum": [
     "running",
     "succeeded",
     "failed",
     "canceled"
    ],
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "kind",
   "demoDir",
   "status",
   "stage",
   "scenesTotal",
   "scenesDone",
   "currentScene",
   "startedAt",
   "endedAt",
   "logFile",
   "logTail"
  ],
  "type": "object"
 },
 "title": "Poll a job"
}

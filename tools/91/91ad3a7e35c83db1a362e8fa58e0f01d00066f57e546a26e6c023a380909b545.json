{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Evaluate a prospective basket for a destination country: whether it can be fulfilled, which promotions apply (including free-delivery style offers and free gifts) and the adjusted basket value. Same check the checkout runs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country_code": {
    "description": "Destination country (ISO alpha-2).",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "has_tax_id": {
    "description": "Whether the buyer has a VAT/tax id (business purchase).",
    "type": "boolean"
   },
   "items": {
    "description": "Basket lines as product ids with quantities.",
    "items": {
     "properties": {
      "id": {
       "description": "Product id from search/product tools.",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "quantity": {
       "default": 1,
       "maximum": 999,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "locale": {
    "description": "Storefront locale such as en-GB (default), en-US, de, fr-FR, es-ES, it-IT, nl-NL, pl. Controls product names, slugs and prices.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "country_code",
   "items"
  ],
  "type": "object"
 },
 "name": "get_cart_promotions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adjusted_value": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Basket value after promotions."
   },
   "basket_value": {
    "type": "number"
   },
   "can_fulfill": {
    "type": "boolean"
   },
   "free_gifts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "quantity": {
       "type": "number"
      },
      "sku": {
       "type": "string"
      }
     },
     "required": [
      "sku",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "lines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "quantity": {
       "type": "number"
      },
      "sku": {
       "type": "string"
      },
      "unit_price": {
       "type": "number"
      }
     },
     "required": [
      "sku",
      "quantity",
      "unit_price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "promotions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "discount_value": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "description",
      "type",
      "discount_value"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "can_fulfill",
   "message",
   "basket_value",
   "adjusted_value",
   "promotions",
   "free_gifts",
   "lines"
  ],
  "type": "object"
 },
 "title": "Get basket promotions"
}

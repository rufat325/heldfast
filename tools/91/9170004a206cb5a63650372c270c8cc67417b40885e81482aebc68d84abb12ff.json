{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search for components by name inside the app runtime. Check traversal.complete before treating no matches as definitive.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "includeProps": {
    "default": true,
    "description": "Include component props in matches",
    "type": "boolean"
   },
   "maxDepth": {
    "default": 200,
    "description": "Maximum fiber depth to traverse (default 200, maximum 600)",
    "maximum": 600,
    "minimum": 0,
    "type": "integer"
   },
   "maxNodes": {
    "default": 1200,
    "description": "Maximum fibers to scan (default 1200)",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "pattern": {
    "description": "Case-insensitive component name pattern",
    "type": "string"
   }
  },
  "required": [
   "pattern"
  ],
  "type": "object"
 },
 "name": "find_components"
}

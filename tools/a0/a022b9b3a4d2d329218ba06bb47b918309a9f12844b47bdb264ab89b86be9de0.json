 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "flags": {
    "default": "g",
    "description": "Regex flags",
    "type": "string"
   },
   "pattern": {
    "description": "Regular expression pattern",
    "type": "string"
   },
   "replacement": {
    "description": "Replacement string (supports $1 capture groups)",
    "type": "string"
   },
   "test_string": {
    "description": "Input string",
    "type": "string"
   }
  },
  "required": [
   "pattern",
   "test_string",
   "replacement"
  ],
  "type": "object"
 },
 "name": "replace_regex"
}

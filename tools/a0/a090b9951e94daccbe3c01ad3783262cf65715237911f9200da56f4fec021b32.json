{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new load balancer with the specified type, location, and optional targets and services.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "algorithm": {
    "description": "Load balancing algorithm",
    "properties": {
     "type": {
      "description": "Algorithm type",
      "enum": [
       "round_robin",
       "least_connections"
      ],
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Labels as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "load_balancer_type": {
    "description": "Load balancer type name or ID",
    "type": "string"
   },
   "location": {
    "description": "Location name (e.g. \"fsn1\"), mutually exclusive with network_zone",
    "type": "string"
   },
   "name": {
    "description": "Name of the load balancer",
    "type": "string"
   },
   "network": {
    "description": "Network ID to attach to",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "network_zone": {
    "description": "Network zone (e.g. \"eu-central\"), mutually exclusive with location",
    "type": "string"
   },
   "public_interface": {
    "description": "Enable the public interface",
    "type": "boolean"
   },
   "services": {
    "description": "Array of services",
    "items": {
     "properties": {
      "destination_port": {
       "description": "Port traffic is forwarded to",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "health_check": {
       "description": "Health check configuration",
       "properties": {
        "http": {
         "description": "HTTP-specific health check settings",
         "properties": {
          "domain": {
           "description": "Domain to send in HTTP Host header",
           "type": "string"
          },
          "path": {
           "description": "HTTP path to check",
           "type": "string"
          },
          "response": {
           "description": "Expected response body",
           "type": "string"
          },
          "status_codes": {
           "description": "Expected HTTP status codes",
           "items": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
           },
           "type": "array"
          },
          "tls": {
           "description": "Whether to use HTTPS",
           "type": "boolean"
          }
         },
         "type": "object"
        },
        "interval": {
         "description": "Interval between checks in seconds",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "port": {
         "description": "Port to check",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "protocol": {
         "description": "Health check protocol: tcp, http, or https",
         "type": "string"
        },
        "retries": {
         "description": "Number of retries before marking unhealthy",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "timeout": {
         "description": "Timeout for a single check in seconds",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        }
       },
       "required": [
        "protocol",
        "port",
        "interval",
        "timeout",
        "retries"
       ],
       "type": "object"
      },
      "http": {
       "description": "HTTP-specific service settings",
       "properties": {
        "certificates": {
         "description": "Certificate IDs",
         "items": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "type": "array"
        },
        "cookie_lifetime": {
         "description": "Lifetime of sticky session cookie in seconds",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "cookie_name": {
         "description": "Name of the sticky session cookie",
         "type": "string"
        },
        "redirect_http": {
         "description": "Redirect HTTP to HTTPS",
         "type": "boolean"
        },
        "sticky_sessions": {
         "description": "Enable sticky sessions",
         "type": "boolean"
        },
        "timeout_idle": {
         "description": "Idle timeout in seconds (30-300, default 50)",
         "maximum": 300,
         "minimum": 30,
         "type": "integer"
        }
       },
       "type": "object"
      },
      "listen_port": {
       "description": "Port the load balancer listens on",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "protocol": {
       "description": "Service protocol: tcp, http, or https",
       "type": "string"
      },
      "proxyprotocol": {
       "description": "Enable PROXY protocol",
       "type": "boolean"
      }
     },
     "required": [
      "protocol",
      "listen_port",
      "destination_port"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "targets": {
    "description": "Array of targets",
    "items": {
     "properties": {
      "ip": {
       "description": "IP target",
       "properties": {
        "ip": {
         "description": "IP address",
         "type": "string"
        }
       },
       "required": [
        "ip"
       ],
       "type": "object"
      },
      "label_selector": {
       "description": "Label selector target",
       "properties": {
        "selector": {
         "description": "Label selector",
         "type": "string"
        }
       },
       "required": [
        "selector"
       ],
       "type": "object"
      },
      "server": {
       "description": "Server target",
       "properties": {
        "id": {
         "description": "Server ID",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        }
       },
       "required": [
        "id"
       ],
       "type": "object"
      },
      "type": {
       "description": "Target type",
       "enum": [
        "server",
        "label_selector",
        "ip"
       ],
       "type": "string"
      },
      "use_private_ip": {
       "description": "Use private IP for the target",
       "type": "boolean"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "load_balancer_type"
  ],
  "type": "object"
 },
 "name": "hetzner_create_load_balancer",
 "title": "Create Load Balancer"
}

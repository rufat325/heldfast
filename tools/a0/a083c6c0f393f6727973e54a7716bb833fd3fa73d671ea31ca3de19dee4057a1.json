{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Change tracked-brand metadata without replacing prompts or history. Example: brand_id='acme', competitors=['rival.com'], refresh_frequency='manual' pauses cron scans but keeps manual refresh.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aliases": {
    "description": "Replacement mention aliases.",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "brand_id": {
    "description": "Tracked brand ID to update.",
    "type": "string"
   },
   "category": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "New category, or null to clear it."
   },
   "competitors": {
    "description": "Replacement competitor domains.",
    "items": {
     "maxLength": 253,
     "minLength": 3,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "domain": {
    "description": "New primary domain.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "exclude_terms": {
    "description": "Replacement bare terms to ignore in mention matching.",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "name": {
    "description": "New display name.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "refresh_frequency": {
    "description": "New cadence; 'manual' pauses cron scans.",
    "enum": [
     "daily",
     "weekly",
     "manual"
    ],
    "type": "string"
   }
  },
  "required": [
   "brand_id"
  ],
  "type": "object"
 },
 "name": "update_brand",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brand": {
    "additionalProperties": false,
    "properties": {
     "aliases": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "category": {
      "type": [
       "string",
       "null"
      ]
     },
     "competitors": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "domain": {
      "type": "string"
     },
     "exclude_terms": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "refresh_frequency": {
      "enum": [
       "daily",
       "weekly",
       "manual"
      ],
      "type": "string"
     }
    },
    "required": [
     "name",
     "domain",
     "category",
     "competitors",
     "aliases",
     "exclude_terms",
     "refresh_frequency"
    ],
    "type": "object"
   },
   "brand_id": {
    "type": "string"
   },
   "changed_fields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_steps": {
    "type": "string"
   },
   "updated": {
    "type": "boolean"
   }
  },
  "required": [
   "updated",
   "brand_id",
   "changed_fields",
   "brand",
   "next_steps"
  ],
  "type": "object"
 },
 "title": "Update tracked brand"
}

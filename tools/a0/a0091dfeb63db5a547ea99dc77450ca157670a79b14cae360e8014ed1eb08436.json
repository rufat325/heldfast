{
 "description": "YouTube search autocomplete suggestions for a query. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "language": {
    "default": "en",
    "description": "Language, e.g. 'en'.",
    "type": "string"
   },
   "region": {
    "default": "US",
    "description": "Region, e.g. 'US'.",
    "type": "string"
   },
   "search": {
    "description": "Partial search query.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "search"
  ],
  "type": "object"
 },
 "name": "youtube_search_suggestions"
}

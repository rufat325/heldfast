{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this to get all resources of one FHIR R4 type for one synthetic scenario's patient (baseline-adult unless patient_id names another).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "patient_id": {
    "description": "Optional scenario subject from list_demo_scenarios. Omitted searches the baseline-adult Bundle only.",
    "enum": [
     "patient-demo-001",
     "patient-demo-polypharmacy",
     "patient-demo-pediatric-asthma",
     "patient-demo-multi-source",
     "patient-demo-sparse",
     "patient-demo-messy-coding",
     "patient-demo-rate-limited",
     "patient-demo-consent-revoked",
     "patient-demo-consent-partial",
     "patient-demo-source-unavailable"
    ],
    "type": "string"
   },
   "resource_type": {
    "description": "FHIR R4 resource type present in the synthetic scenario Bundles.",
    "enum": [
     "AllergyIntolerance",
     "Condition",
     "DiagnosticReport",
     "Encounter",
     "Immunization",
     "MedicationDispense",
     "MedicationRequest",
     "Observation",
     "Organization",
     "Patient",
     "Practitioner",
     "Provenance"
    ],
    "type": "string"
   }
  },
  "required": [
   "resource_type"
  ],
  "type": "object"
 },
 "name": "search_demo_fhir",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundle": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "bundle"
  ],
  "type": "object"
 },
 "title": "Search synthetic FHIR resources"
}

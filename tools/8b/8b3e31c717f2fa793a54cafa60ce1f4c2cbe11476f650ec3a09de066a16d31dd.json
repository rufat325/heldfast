{
 "description": "Evaluate the current Project Work YAML for a manual or automatic action. Partial attachment is allowed; gated actions fail with all relevant missing paths.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "attach_partial_project_work",
     "create_milestone_manually",
     "create_task_manually",
     "create_milestone_automatically",
     "execute_task_automatically",
     "complete_task_automatically",
     "continue_project_automatically",
     "publish_automatically",
     "deploy_automatically",
     "complete_project_automatically"
    ],
    "type": "string"
   },
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "requiredPaths": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "action"
  ],
  "type": "object"
 },
 "name": "granoflow_project_work_evaluate"
}

{
 "description": "\u30c7\u30fc\u30bf\u533a\u5206\u3054\u3068\u306e\u30e9\u30a4\u30d5\u30b5\u30a4\u30af\u30eb\u72b6\u614b\u30fb\u9077\u79fb\u304b\u3089\u3001\u30c7\u30fc\u30bf\u533a\u5206\u00d7\u72b6\u614b\u30de\u30c8\u30ea\u30af\u30b9\u30fb\u72b6\u614b\u9077\u79fb\u4e00\u89a7\u30fb\u30c7\u30fc\u30bf\u7ba1\u7406\u8868\u30fb\u30c7\u30fc\u30bf\u00d7\u30c6\u30b9\u30c8\u30b1\u30fc\u30b9\u306e\u4f9b\u7d66\u30c8\u30ec\u30fc\u30b5\u30d3\u30ea\u30c6\u30a3\u30fb\u540c\u4e00\u30c7\u30fc\u30bf\u3092\u66f4\u65b0\u3059\u308b\u8907\u6570\u30b1\u30fc\u30b9\u306e\u6392\u4ed6\u691c\u51fa\u30fb\u72b6\u614b/\u9077\u79fb\u88ab\u8986\u3092\u6c7a\u5b9a\u7684\u306b\u7b97\u51fa\u3057\u3066Markdown\u3067\u8fd4\u3059\u3002\u5404\u72b6\u614b\u306f DL:S:\u3001\u5404\u9077\u79fb\u306f DL:T: \u30d7\u30ec\u30d5\u30a3\u30c3\u30af\u30b9\u306e\u7db2\u7f85\u5bfe\u8c61ID\u3068\u3057\u3066 generate_test_cases \u306e testData \u3078\u305d\u306e\u307e\u307e\u6e21\u305b\u308b\u3002\u4f9b\u7d66\u5143\u306e\u6709\u7121\u306fID\u306e\u5b58\u5728\u3060\u3051\u3067\u306a\u304f\u521d\u671f\u72b6\u614b\u304b\u3089\u306e\u5230\u9054\u53ef\u80fd\u6027\u3067\u5224\u5b9a\u3057\u3001\u88ab\u8986\u7387\u306f\u30b1\u30fc\u30b9\u672c\u6587\u304b\u3089\u306e\u88cf\u4ed8\u3051\u3092\u901a\u904e\u3057\u305f\u8981\u6c42\u3060\u3051\u3092\u5206\u5b50\u306b\u6570\u3048\u308b\u3002\u5b9f\u884c\u9806\u5e8f\u30fb\u4f9d\u5b58\u95a2\u4fc2\u30fb\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d1\u30b9\u306e\u6c7a\u5b9a\u306f\u5bfe\u8c61\u5916\uff08\u5c06\u6765\u306e analyze_execution_order \u306e\u62c5\u5f53\u9818\u57df\uff09\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "completedTools": {
    "description": "Already executed tools; entries without evidence are treated as not executed",
    "items": {
     "properties": {
      "evidence": {
       "description": "Evidence of execution: an output file path (e.g. docs/test-cases.md) or an output heading line starting with '#'",
       "type": "string"
      },
      "outputExcerpt": {
       "description": "Excerpt of the declared tool's actual output text. Must contain that tool's own H1 heading line; otherwise the declaration is reported as evidence-unverified and still counted as not executed",
       "type": "string"
      },
      "toolName": {
       "description": "Name of an already executed tool in this workflow",
       "type": "string"
      }
     },
     "required": [
      "toolName",
      "evidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dataClasses": {
    "description": "Data classes with their lifecycle states and transitions",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "description": "Data class id, unique across the input",
       "type": "string"
      },
      "keyAttributes": {
       "description": "Attribute keys used to identify the same data item",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "kind": {
       "enum": [
        "master",
        "transaction",
        "counter",
        "credential",
        "external-settlement",
        "time-dependent"
       ],
       "type": "string"
      },
      "nameJa": {
       "type": "string"
      },
      "owner": {
       "description": "Preparation owner",
       "type": "string"
      },
      "preparation": {
       "description": "How the data is procured",
       "type": "string"
      },
      "sharingPolicy": {
       "enum": [
        "shared",
        "exclusive",
        "per-case"
       ],
       "type": "string"
      },
      "states": {
       "items": {
        "properties": {
         "definition": {
          "type": "string"
         },
         "id": {
          "type": "string"
         },
         "isInitial": {
          "type": "boolean"
         },
         "isTerminal": {
          "type": "boolean"
         },
         "nameJa": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "nameJa"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "transitions": {
       "default": [],
       "items": {
        "properties": {
         "event": {
          "type": "string"
         },
         "from": {
          "type": "string"
         },
         "guard": {
          "type": "string"
         },
         "id": {
          "type": "string"
         },
         "mutating": {
          "description": "Whether this transition changes the data (default true)",
          "type": "boolean"
         },
         "to": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "from",
         "to",
         "event"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "volume": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "nameJa",
      "states"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "dataItems": {
    "description": "Data management table rows (concrete data item instances)",
    "items": {
     "properties": {
      "attributes": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "dataClassId": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "initialStateId": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "note": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "dataClassId",
      "label",
      "initialStateId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "maxDataClasses": {
    "description": "Data class count cap (default 100)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "maxStatesPerClass": {
    "description": "Per-class state count cap (default 50)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "testBasisDocuments": {
    "description": "Test basis documents used to verify that declared labels (factor names, level values, state names, etc.), quoted wordings and referenced ids really exist in the test basis. Pass the full text: passing only excerpts makes existing wordings be reported as ungrounded. When omitted, the grounding check is reported as not inspectable instead of passing silently.",
    "items": {
     "properties": {
      "content": {
       "description": "Full text of the document (any format; caller converts binaries to text)",
       "type": "string"
      },
      "name": {
       "description": "Document name or file name of the test basis document",
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testCases": {
    "description": "Test cases and the data they require",
    "items": {
     "properties": {
      "caseId": {
       "type": "string"
      },
      "preconditionText": {
       "type": "string"
      },
      "requiredData": {
       "items": {
        "properties": {
         "access": {
          "enum": [
           "read",
           "update"
          ],
          "type": "string"
         },
         "dataClassId": {
          "type": "string"
         },
         "dataItemId": {
          "type": "string"
         },
         "resultStateId": {
          "type": "string"
         },
         "stateId": {
          "type": "string"
         },
         "transitionId": {
          "type": "string"
         }
        },
        "required": [
         "dataClassId",
         "stateId",
         "access"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "stepsText": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "caseId",
      "requiredData"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "dataClasses"
  ],
  "type": "object"
 },
 "name": "design_test_data",
 "title": "Design Test Data"
}

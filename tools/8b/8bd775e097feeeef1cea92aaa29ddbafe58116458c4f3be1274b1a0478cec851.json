{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage file attachments on stories, features, decisions, comments. Methods: list, upload (base64), delete, get_url",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attachment_id": {
    "description": "Attachment ID (required for: delete, get_url)",
    "type": "string"
   },
   "content_base64": {
    "description": "File content as base64 string (required for: upload)",
    "type": "string"
   },
   "entity_id": {
    "description": "Entity ID (required for: list, upload)",
    "type": "string"
   },
   "entity_type": {
    "description": "Entity type (required for: list, upload)",
    "enum": [
     "story",
     "feature",
     "decision",
     "document",
     "comment"
    ],
    "type": "string"
   },
   "filename": {
    "description": "Original filename with extension (required for: upload)",
    "type": "string"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "upload",
     "delete",
     "get_url"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (for: upload \u2014 auto-detected if omitted)",
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "attachments"
}

{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "List the proposal queue (paginated), or confirm/reject by id. Rejecting ARCHIVES the proposal. Example: {\"action\":\"confirm\",\"ids\":[\"01H...\"]}",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "list",
     "confirm",
     "reject"
    ],
    "type": "string"
   },
   "ids": {
    "description": "required for confirm/reject (max 100 ids, 64 chars each)",
    "items": {
     "maxLength": 64,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "limit": {
    "description": "list: max proposals returned (default 50, max 200)",
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   },
   "offset": {
    "description": "list: skip this many (default 0)",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "memory_review",
 "title": "Review proposals"
}

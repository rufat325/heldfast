{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "YNAB: Get Account Details"
 },
 "description": "Get details for a single account including current balance.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - account_id (string, required): Account UUID.\n  - response_format (string, optional): \"json\" or \"markdown\" (default: \"markdown\").\n\nReturns: account (id, name, type, balance, cleared_balance, uncleared_balance, on_budget, closed), cached, cache_info\n\nErrors:\n  - \"No default budget set\" \u2192 run ynab_set_default_budget first\n  - \"Account not found\" \u2192 invalid account_id",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "minLength": 1,
    "type": "string"
   },
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   }
  },
  "required": [
   "account_id"
  ],
  "type": "object"
 },
 "name": "ynab_get_account",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "account": {
    "additionalProperties": false,
    "description": "Account details",
    "properties": {
     "balance": {
      "description": "Account balance in dollars",
      "type": "number"
     },
     "cleared_balance": {
      "description": "Cleared balance in dollars",
      "type": "number"
     },
     "closed": {
      "description": "Closed flag",
      "type": "boolean"
     },
     "direct_import_in_error": {
      "description": "Direct import error flag",
      "type": "boolean"
     },
     "direct_import_linked": {
      "description": "Direct import linked flag",
      "type": "boolean"
     },
     "id": {
      "description": "Account ID",
      "type": "string"
     },
     "name": {
      "description": "Account name",
      "type": "string"
     },
     "note": {
      "description": "Account note",
      "type": "string"
     },
     "on_budget": {
      "description": "On-budget flag",
      "type": "boolean"
     },
     "transfer_payee_id": {
      "description": "Transfer payee ID",
      "type": "string"
     },
     "type": {
      "description": "Account type",
      "type": "string"
     },
     "uncleared_balance": {
      "description": "Uncleared balance in dollars",
      "type": "number"
     }
    },
    "required": [
     "id",
     "name",
     "type",
     "on_budget",
     "closed",
     "balance",
     "cleared_balance",
     "uncleared_balance",
     "transfer_payee_id"
    ],
    "type": "object"
   },
   "cache_info": {
    "description": "Human-readable cache status message (e.g., \"Cache hit\", \"Cache miss\")",
    "type": "string"
   },
   "cached": {
    "description": "Indicates if data was served from cache",
    "type": "boolean"
   },
   "usedDelta": {
    "description": "Indicates if delta merge optimization was applied for budgets",
    "type": "boolean"
   }
  },
  "required": [
   "account"
  ],
  "type": "object"
 }
}

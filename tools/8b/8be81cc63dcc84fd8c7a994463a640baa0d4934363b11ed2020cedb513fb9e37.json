{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Add Wallet(s) to Portfolio"
 },
 "description": "Add one or more blockchain addresses and start their first sync. Omit the blockchain connection identifier (integrationId) to add an EVM 0x address on every supported EVM network; other addresses require an integrationId. This tool does not configure exchange accounts and reports which addresses were added or skipped.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "portfolioRef": {
    "description": "Portfolio name or slug inside that workspace. Call list_portfolios to resolve it.",
    "minLength": 1,
    "type": "string"
   },
   "wallets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Wallet address",
       "minLength": 1,
       "type": "string"
      },
      "integrationId": {
       "description": "Integration id for chain resolution. Use 'evm' for automatic EVM chain discovery; use a specific integration id for direct chain add.",
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "description": "Optional wallet name",
       "maxLength": 100,
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "workspaceRef": {
    "description": "Workspace name or slug. Call list_workspaces to resolve it.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "workspaceRef",
   "portfolioRef",
   "wallets"
  ],
  "type": "object"
 },
 "name": "add_wallet",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": "string"
      },
      "chainRef": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "status": {
       "enum": [
        "created",
        "skipped"
       ],
       "type": "string"
      }
     },
     "required": [
      "address",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "syncQueued": {
    "type": "boolean"
   }
  },
  "required": [
   "results",
   "syncQueued"
  ],
  "type": "object"
 },
 "title": "Add Wallet(s) to Portfolio"
}

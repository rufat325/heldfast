{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "streamingHint": true,
  "title": "Grok Web Search"
 },
 "description": "Web search with live X/Twitter and news grounding (Grok). Best for breaking events and social discussion; use grok_search_lite for the same search at lower cost. Put your QUERY in the 'query' parameter.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "max_search_results": {
    "type": "number"
   },
   "query": {
    "type": "string"
   },
   "recency": {
    "enum": [
     "all",
     "day",
     "week",
     "month",
     "year"
    ],
    "type": "string"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "allowed_websites": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "country": {
       "type": "string"
      },
      "type": {
       "enum": [
        "web",
        "news",
        "x",
        "rss"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "grok_search"
}

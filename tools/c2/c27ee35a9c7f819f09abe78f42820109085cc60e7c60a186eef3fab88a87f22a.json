{
 "description": "On user request, refresh episodic project memory and its handoff graph, or start/stop/status automatic memory updates. Not a package upgrade. Explicit project_path is recommended.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "default": "refresh",
    "enum": [
     "refresh",
     "start",
     "stop",
     "status"
    ],
    "type": "string"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "handoff": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "interval_seconds": {
    "default": 300,
    "maximum": 86400,
    "minimum": 10,
    "type": "integer"
   },
   "note": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "project_path": {
    "type": "string"
   },
   "task": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "infimium_update"
}

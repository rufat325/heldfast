 "description": "Historical AQI observations inside a bounding box for a date range. Specify pollutants as comma-separated parameter codes (e.g., \"OZONE,PM25,PM10,CO,NO2,SO2\"). bbox format: \"minLon,minLat,maxLon,maxLat\".",
 "inputSchema": {
  "examples": [
   {
    "bbox": "-74.1,40.6,-73.9,40.8",
    "end_date": "2025-01-10T23",
    "start_date": "2025-01-10T00"
   },
   {
    "bbox": "-118.3,34.0,-118.2,34.1",
    "data_type": "A",
    "end_date": "2025-01-10T23",
    "parameters": "OZONE,PM25,NO2",
    "start_date": "2025-01-08T00",
    "verbose": true
   }
  ],
  "properties": {

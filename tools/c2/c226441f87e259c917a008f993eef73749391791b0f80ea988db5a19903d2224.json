    "type": "string"
   },
   "end_date": {
    "description": "YYYY-MM-DDT23",
    "type": "string"
   },
   "parameters": {
    "description": "Comma-separated pollutants (default: OZONE,PM25,PM10)",
    "type": "string"
   },
   "start_date": {

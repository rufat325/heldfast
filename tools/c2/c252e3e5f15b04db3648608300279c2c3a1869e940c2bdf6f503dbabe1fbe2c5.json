{
 "description": "Search Walmart products. Paginate with page while has_more_pages. 1 credit (US/CA), 2 credits (Mexico).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domain": {
    "description": "'com' (US, 1cr), 'ca' (Canada, 1cr), 'com.mx' (Mexico, 2cr). Default US.",
    "enum": [
     "com",
     "ca",
     "com.mx"
    ],
    "type": "string"
   },
   "fulfillment_speed": {
    "description": "'today' or 'tomorrow'. Omit for all items.",
    "enum": [
     "today",
     "tomorrow"
    ],
    "type": "string"
   },
   "fulfillment_type": {
    "description": "'in_store' for pickup only. Omit for all.",
    "enum": [
     "in_store"
    ],
    "type": "string"
   },
   "max_price": {
    "description": "Max price.",
    "type": "number"
   },
   "min_price": {
    "description": "Min price.",
    "type": "number"
   },
   "page": {
    "description": "Results page, 1-based.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Product search query.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "sort_by": {
    "description": "Sort order. Default 'best_match'.",
    "enum": [
     "best_match",
     "price_low",
     "price_high",
     "best_seller",
     "rating_high",
     "new"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_walmart"
}

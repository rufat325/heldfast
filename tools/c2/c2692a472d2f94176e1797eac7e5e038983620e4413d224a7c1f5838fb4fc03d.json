{
 "description": "Update a Granoflow project with common structured fields. Defaults to dry-run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "domainTag": {
    "minLength": 1,
    "type": "string"
   },
   "dryRun": {
    "default": true,
    "description": "When true, previews the request without writing.",
    "type": "boolean"
   },
   "projectId": {
    "description": "Granoflow project id.",
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "granoflow_project_update"
}

{
 "description": "Recent proposals for a single cache (any status), so agents can avoid re-proposing pending or recently-applied changes. Newest first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cache_name": {
    "description": "Cache name as registered in __betterdb:caches (e.g. 'betterdb_scache_prod').",
    "minLength": 1,
    "type": "string"
   },
   "instanceId": {
    "description": "Connection ID; defaults to the active instance",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "description": "Max proposals to return (default 20, max 200)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "cache_name"
  ],
  "type": "object"
 },
 "name": "cache_recent_changes"
}

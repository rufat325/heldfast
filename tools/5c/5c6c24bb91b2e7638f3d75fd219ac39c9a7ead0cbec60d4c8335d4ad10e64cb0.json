{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs go test and returns structured test results (name, status, package, elapsed).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bench": {
    "description": "Benchmark name filter regex (-bench)",
    "maxLength": 255,
    "type": "string"
   },
   "benchmem": {
    "default": false,
    "description": "Print memory allocation stats for benchmarks (-benchmem)",
    "type": "boolean"
   },
   "benchtime": {
    "description": "Benchmark run duration or count (-benchtime), e.g. '3s' or '100x'",
    "maxLength": 255,
    "type": "string"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "count": {
    "description": "Run each test and benchmark N times (-count <n>). Useful for verifying flaky test fixes.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "cover": {
    "default": false,
    "description": "Enable test coverage analysis (-cover)",
    "type": "boolean"
   },
   "coverprofile": {
    "description": "Write a coverage profile to the named file (-coverprofile <file>). Implies -cover.",
    "maxLength": 4096,
    "type": "string"
   },
   "failfast": {
    "default": false,
    "description": "Stop running tests after the first failure (-failfast). Saves time and tokens.",
    "type": "boolean"
   },
   "packages": {
    "default": [
     "./..."
    ],
    "description": "Packages to test (default: ./...)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "parallel": {
    "description": "Maximum number of tests to run in parallel (-parallel <n>). Default: GOMAXPROCS.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "race": {
    "default": false,
    "description": "Enable data race detection during tests (-race)",
    "type": "boolean"
   },
   "run": {
    "description": "Test name filter regex",
    "maxLength": 255,
    "type": "string"
   },
   "short": {
    "default": false,
    "description": "Tell long-running tests to shorten their run time (-short). Enables quick smoke tests.",
    "type": "boolean"
   },
   "shuffle": {
    "description": "Randomize test execution order (-shuffle). 'on' uses a random seed, 'off' is the default.",
    "enum": [
     "on",
     "off"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Build tags required to run tests correctly (-tags)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "timeout": {
    "description": "Test execution timeout (-timeout <d>). Examples: '30s', '5m', '1h'. Default: 10m.",
    "maxLength": 255,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "test",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "type": "string"
   },
   "exitCode": {
    "type": "number"
   },
   "failed": {
    "type": "number"
   },
   "packageFailures": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "output": {
       "type": "string"
      },
      "package": {
       "type": "string"
      }
     },
     "required": [
      "package"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "passed": {
    "type": "number"
   },
   "skipped": {
    "type": "number"
   },
   "success": {
    "type": "boolean"
   },
   "tests": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "elapsed": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "output": {
       "type": "string"
      },
      "package": {
       "type": "string"
      },
      "parent": {
       "description": "Parent test name for subtests (e.g., parent of TestA/Sub1 is TestA)",
       "type": "string"
      },
      "status": {
       "enum": [
        "pass",
        "fail",
        "skip"
       ],
       "type": "string"
      }
     },
     "required": [
      "package",
      "name",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "success",
   "passed",
   "failed",
   "skipped"
  ],
  "type": "object"
 },
 "title": "Go Test"
}

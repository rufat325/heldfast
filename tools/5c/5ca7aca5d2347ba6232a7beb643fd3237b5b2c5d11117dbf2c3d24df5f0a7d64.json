{
 "description": "Updates the key with the given Id.",
 "inputSchema": {
  "properties": {
   "keyId": {
    "description": "The Id of the key to update.",
    "type": "string"
   },
   "requestBody": {
    "description": "Key API request object.",
    "properties": {
     "key": {
      "description": "Domain for a public key, key pair or an HMAC secret. This is used by KeyMaster to manage keys for JWTs, SAML, etc.",
      "properties": {
       "algorithm": {
        "enum": [
         "ES256",
         "ES384",
         "ES512",
         "HS256",
         "HS384",
         "HS512",
         "RS256",
         "RS384",
         "RS512",
         "Ed25519",
         "None"
        ],
        "type": "string"
       },
       "certificate": {
        "type": "string"
       },
       "certificateInformation": {
        "properties": {
         "issuer": {
          "type": "string"
         },
         "md5Fingerprint": {
          "type": "string"
         },
         "serialNumber": {
          "type": "string"
         },
         "sha1Fingerprint": {
          "type": "string"
         },
         "sha1Thumbprint": {
          "type": "string"
         },
         "sha256Fingerprint": {
          "type": "string"
         },
         "sha256Thumbprint": {
          "type": "string"
         },
         "subject": {
          "type": "string"
         },
         "validFrom": {
          "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
          "format": "int64",
          "type": "number"
         },
         "validTo": {
          "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
          "format": "int64",
          "type": "number"
         }
        },
        "type": "object"
       },
       "expirationInstant": {
        "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
        "format": "int64",
        "type": "number"
       },
       "hasPrivateKey": {
        "type": "boolean"
       },
       "id": {
        "format": "uuid",
        "type": "string"
       },
       "insertInstant": {
        "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
        "format": "int64",
        "type": "number"
       },
       "issuer": {
        "type": "string"
       },
       "kid": {
        "type": "string"
       },
       "lastUpdateInstant": {
        "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
        "format": "int64",
        "type": "number"
       },
       "length": {
        "type": "number"
       },
       "name": {
        "type": "string"
       },
       "privateKey": {
        "type": "string"
       },
       "publicKey": {
        "type": "string"
       },
       "secret": {
        "type": "string"
       },
       "type": {
        "enum": [
         "EC",
         "RSA",
         "HMAC",
         "OKP",
         "Secret"
        ],
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "keyId"
  ],
  "type": "object"
 },
 "name": "updateKeyWithId"
}

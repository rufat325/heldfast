{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true,
  "title": "List support requests"
 },
 "description": "List your Tango support tickets and read the full conversation, including replies from Tango staff. Pass ticket_id to fetch one thread.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "status": {
    "default": "all",
    "enum": [
     "open",
     "waiting_on_customer",
     "waiting_on_us",
     "resolved",
     "closed",
     "all"
    ],
    "type": "string"
   },
   "ticket_id": {
    "description": "Fetch the full thread for this ticket.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_support_requests",
 "title": "List support requests"
}

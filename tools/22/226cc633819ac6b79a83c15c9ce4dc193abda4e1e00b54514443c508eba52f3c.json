    "type": "string"
   },
   "id": {
    "description": "Server ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "start": {
    "description": "Start of period, ISO 8601 timestamp (e.g. \"2025-01-01T00:00:00Z\")",
    "type": "string"
   },
   "type": {
    "description": "Comma-separated metric types: \"cpu\", \"disk\", \"network\"",
    "type": "string"
   }
  },
  "required": [

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage brainstorming sessions. Methods: list, start, log_message, complete",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "artifacts": {
    "description": "Created artifacts (for: log_message)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "id",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "content": {
    "description": "Message content (required for: log_message)",
    "type": "string"
   },
   "decisions_made": {
    "description": "Decisions made (for: complete)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "features_created": {
    "description": "Features created (for: complete)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "start",
     "log_message",
     "complete"
    ],
    "type": "string"
   },
   "open_questions": {
    "description": "Open questions (for: complete)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "persona": {
    "description": "Persona to use (for: start)",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (for: list, start \u2014 auto-detected if omitted)",
    "type": "string"
   },
   "role": {
    "description": "Message role (required for: log_message)",
    "enum": [
     "user",
     "assistant"
    ],
    "type": "string"
   },
   "session_id": {
    "description": "Session ID (required for: log_message, complete)",
    "type": "string"
   },
   "summary": {
    "description": "Session summary (required for: complete)",
    "type": "string"
   },
   "title": {
    "description": "Session title (for: start)",
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "sessions"
}

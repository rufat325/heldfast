{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set Place Build Status"
 },
 "description": "Set a place's build status (not_started \u2192 surveyed \u2192 staged \u2192 built \u2192 systemized \u2192 designed \u2192 complete, or null to clear) \u2014 the build axis, separate from lifecycle status. Requires event_id + place_id + build_status; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "build_status": {
    "anyOf": [
     {
      "enum": [
       "not_started",
       "surveyed",
       "staged",
       "built",
       "systemized",
       "designed",
       "complete"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "place_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "place_id",
   "build_status"
  ],
  "type": "object"
 },
 "name": "set_place_build_status",
 "title": "Set Place Build Status"
}

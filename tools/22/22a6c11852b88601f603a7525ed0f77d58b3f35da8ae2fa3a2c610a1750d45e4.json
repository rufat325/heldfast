    "minimum": -1,
    "type": "integer"
   },
   "buffs": {
    "default": [],
    "description": "Buffs to add to the target",
    "items": {
     "additionalProperties": false,
     "properties": {
      "param": {
       "description": "Parameter id (0-7)",
       "maximum": 7,
       "minimum": 0,
       "type": "integer"
      },
      "turns": {
       "default": 5,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "param"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "debuffs": {
    "default": [],
    "description": "Debuffs to add to the target",
    "items": {
     "additionalProperties": false,
     "properties": {
      "param": {
       "description": "Parameter id (0-7)",
       "maximum": 7,
       "minimum": 0,
       "type": "integer"
      },
      "turns": {
       "default": 5,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "param"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "default": "",
    "description": "Two-line description shown in menus",
    "type": "string"
   },
   "iconIndex": {
    "default": 0,
    "description": "Icon sheet index",
    "minimum": 0,
    "type": "integer"
   },
   "mpCost": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "note": {
    "default": "",
    "type": "string"
   },
   "occasion": {
    "description": "When usable: 0 always, 1 battle only, 2 menu only, 3 never",
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   },
   "scope": {
    "description": "Target scope: 1 one enemy, 2 all enemies, 3-6 random enemies (1-4), 7 one ally, 8 all allies, 9 one dead ally, 10 all dead allies, 11 the user",
    "maximum": 11,
    "minimum": 0,
    "type": "integer"
   },
   "stypeId": {
    "default": 1,
    "description": "Skill type id (1 = Magic by default)",
    "minimum": 0,
    "type": "integer"
   },
   "tpCost": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_buff_skill",
 "title": "Create buff/debuff skill"
}

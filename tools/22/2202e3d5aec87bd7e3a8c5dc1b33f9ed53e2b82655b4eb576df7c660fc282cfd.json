{
 "description": "Assign a build to an App Store version. The build must be in VALID processing state.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "buildId": {
    "description": "Build ID (from asc_list_builds)",
    "type": "string"
   },
   "versionId": {
    "description": "Version ID",
    "type": "string"
   }
  },
  "required": [
   "versionId",
   "buildId"
  ],
  "type": "object"
 },
 "name": "asc_assign_build"
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Queue a sound effect into the BlitzReels media library. Spends AI credits and returns a job to poll with generation_jobs_get.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "durationSeconds": {
    "default": 2,
    "description": "Effect length between 0.5 and 30 seconds.",
    "maximum": 30,
    "minimum": 0.5,
    "type": "number"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "loop": {
    "default": false,
    "description": "Produce a seamlessly loopable effect.",
    "type": "boolean"
   },
   "prompt": {
    "description": "The sound to create (3-500 characters).",
    "maxLength": 500,
    "minLength": 3,
    "type": "string"
   },
   "promptInfluence": {
    "default": 0.5,
    "description": "How literally to follow the prompt, between 0 and 1. Higher is more literal.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "generation_sound_create",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "generation": {
    "properties": {
     "estimated_credits": {
      "type": [
       "number",
       "null"
      ]
     },
     "job_id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "image",
       "video",
       "voiceover",
       "music",
       "sound",
       "faceless"
      ],
      "type": "string"
     },
     "media_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "mutationReceipt": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "key": {
        "type": [
         "string",
         "null"
        ]
       },
       "operation": {
        "type": "string"
       },
       "replayed": {
        "type": "boolean"
       },
       "status": {
        "enum": [
         "completed"
        ],
        "type": "string"
       }
      },
      "required": [
       "id",
       "key",
       "operation",
       "status",
       "replayed"
      ],
      "type": "object"
     },
     "project_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "job_id",
     "kind",
     "status",
     "mutationReceipt"
    ],
    "type": "object"
   }
  },
  "required": [
   "generation"
  ],
  "type": "object"
 },
 "title": "Generate Sound Effect"
}

{
 "description": "Convert output/final-demo.mp4 to a README-ready GIF. Returns a jobId immediately \u2014 poll job_status. Rejects if another job is running.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dir": {
    "description": "demo project directory \u2014 pass an absolute path",
    "type": "string"
   },
   "fps": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "out": {
    "type": "string"
   },
   "width": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "dir"
  ],
  "type": "object"
 },
 "name": "gif",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "demoDir": {
    "description": "resolved absolute demo directory",
    "type": "string"
   },
   "jobId": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "logFile": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "kind",
   "demoDir",
   "status",
   "logFile"
  ],
  "type": "object"
 }
}

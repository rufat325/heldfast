{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Bathymetry"
 },
 "description": "Seafloor depth from Clairwave-served global bathymetry (~450 m resolution). Location:\n    lat/lon or `place` (name resolved to a water point, echoed in `location`).\n    Without a bearing: depth at the point. With a bearing (compass degrees,\n    0 = north): a depth profile along that transect out to range_km.",
 "inputSchema": {
  "properties": {
   "bearing_deg": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Bearing Deg"
   },
   "lat": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lat"
   },
   "lon": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lon"
   },
   "n_points": {
    "default": 100,
    "title": "N Points",
    "type": "integer"
   },
   "place": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Place"
   },
   "range_km": {
    "default": 20.0,
    "title": "Range Km",
    "type": "number"
   }
  },
  "title": "get_bathymetryArguments",
  "type": "object"
 },
 "name": "get_bathymetry",
 "outputSchema": {
  "$defs": {
   "LocationInfo": {
    "additionalProperties": true,
    "properties": {
     "depth_m": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "water depth at the point, metres (positive down)",
      "title": "Depth M"
     },
     "lat": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "latitude used, decimal degrees N",
      "title": "Lat"
     },
     "lon": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "longitude used, decimal degrees E",
      "title": "Lon"
     },
     "matched": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "gazetteer key or OpenStreetMap display name that matched",
      "title": "Matched"
     },
     "offshore_km": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "offset applied along the seaward bearing",
      "title": "Offshore Km"
     },
     "original": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ],
      "description": "original lat/lon/depth before the snap",
      "title": "Original"
     },
     "provenance": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ],
      "description": "provider/source notes",
      "title": "Provenance"
     },
     "query": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "place name as given",
      "title": "Query"
     },
     "seaward_bearing_deg": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "compass bearing that leads further to sea",
      "title": "Seaward Bearing Deg"
     },
     "snap": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ],
      "description": "bearing_deg and distance_km of the seaward walk",
      "title": "Snap"
     },
     "snapped_to_water": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "description": "true if the original point was on land/shallow and was moved seaward",
      "title": "Snapped To Water"
     },
     "source": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "gazetteer:exact | gazetteer:contains | gazetteer:fuzzy | nominatim (OpenStreetMap)",
      "title": "Source"
     }
    },
    "title": "LocationInfo",
    "type": "object"
   }
  },
  "properties": {
   "bearing_deg": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Bearing Deg"
   },
   "depth_m": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Depth M"
   },
   "lat": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lat"
   },
   "location": {
    "anyOf": [
     {
      "$ref": "#/$defs/LocationInfo"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "lon": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lon"
   },
   "max_depth_m": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Max Depth M"
   },
   "min_depth_m": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Min Depth M"
   },
   "profile": {
    "anyOf": [
     {
      "items": {},
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Profile"
   },
   "provenance": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Provenance"
   },
   "range_km": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Range Km"
   }
  },
  "title": "BathymetryResult",
  "type": "object"
 },
 "title": "Bathymetry"
}

{
 "description": "Audit an agent, skill, MCP server, or paid API for release consistency, required discovery surfaces, evidence freshness, supported claims, and channel-specific launch constraints. Costs $0.25 USDC on Base mainnet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "claims": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "evidence_surface_ids": {
       "items": {
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "text": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "text",
      "evidence_surface_ids"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "launch_evidence": {
    "additionalProperties": false,
    "properties": {
     "founder_available": {
      "type": "boolean"
     },
     "generated_comments_planned": {
      "type": "boolean"
     },
     "live_product": {
      "type": "boolean"
     },
     "pricing_transparent": {
      "type": "boolean"
     },
     "tryable_without_signup": {
      "type": "boolean"
     },
     "unique_value_evidence": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "observed_at": {
    "format": "date-time",
    "type": "string"
   },
   "product": {
    "additionalProperties": false,
    "properties": {
     "canonical_url": {
      "format": "uri",
      "type": "string"
     },
     "kind": {
      "enum": [
       "mcp-server",
       "agent-skill",
       "paid-api"
      ]
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "price_usd": {
      "maximum": 10000,
      "minimum": 0,
      "type": "number"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "version",
     "kind",
     "canonical_url",
     "price_usd"
    ],
    "type": "object"
   },
   "surfaces": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "canonical_url": {
       "format": "uri",
       "type": "string"
      },
      "capabilities": {
       "items": {
        "type": "string"
       },
       "maxItems": 1000,
       "type": "array"
      },
      "captured_at": {
       "format": "date-time",
       "type": "string"
      },
      "evidence_ref": {
       "type": "string"
      },
      "http_status": {
       "maximum": 599,
       "minimum": 100,
       "type": "integer"
      },
      "id": {
       "type": "string"
      },
      "install_command": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "price_usd": {
       "maximum": 10000,
       "minimum": 0,
       "type": "number"
      },
      "type": {
       "enum": [
        "homepage",
        "documentation",
        "pricing",
        "support",
        "security",
        "package-registry",
        "agent-registry",
        "transport",
        "source-repository"
       ]
      },
      "url": {
       "format": "uri",
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "type",
      "url",
      "captured_at",
      "http_status"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "target_channels": {
    "items": {
     "enum": [
      "mcp-registry",
      "smithery",
      "npm",
      "github",
      "product-hunt",
      "show-hn"
     ]
    },
    "maxItems": 6,
    "type": "array"
   }
  },
  "required": [
   "observed_at",
   "product",
   "surfaces",
   "claims",
   "target_channels"
  ],
  "type": "object"
 },
 "name": "justhandled_agent_distribution_readiness_pack"
}

{
 "description": "Add an item to a menu",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "menu_id": {
    "description": "Menu ID",
    "type": "number"
   },
   "object": {
    "description": "Object type (page, product_cat, etc.)",
    "type": "string"
   },
   "object_id": {
    "description": "Object ID",
    "type": "number"
   },
   "object_type": {
    "default": "custom",
    "description": "Item type",
    "enum": [
     "custom",
     "post_type",
     "taxonomy"
    ],
    "type": "string"
   },
   "parent": {
    "default": 0,
    "description": "Parent menu item ID",
    "type": "number"
   },
   "position": {
    "description": "Position in menu",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "title": {
    "description": "Menu item title",
    "type": "string"
   },
   "url": {
    "description": "URL for custom links",
    "type": "string"
   }
  },
  "required": [
   "site",
   "menu_id",
   "title"
  ],
  "type": "object"
 },
 "name": "mcp_add_menu_item"
}

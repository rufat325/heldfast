{
 "description": "Read raw bytes from a file at a specific offset.",
 "inputSchema": {
  "properties": {
   "file_path": {
    "description": "Path to the file",
    "type": "string"
   },
   "length": {
    "description": "Number of bytes to read (default 256)",
    "type": "number"
   },
   "offset": {
    "description": "Byte offset to start reading",
    "type": "number"
   }
  },
  "required": [
   "file_path",
   "offset"
  ],
  "type": "object"
 },
 "name": "hex_read"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a local tracked brand and starter buyer-intent prompts; uses Claude Haiku when configured, otherwise three generic prompts. Example: brand_id='acme', name='Acme', domain='acme.com'. Call refresh_brand next.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aliases": {
    "description": "Additional names that count as brand mentions.",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "brand_id": {
    "description": "New stable brand ID, e.g. 'acme'.",
    "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
    "type": "string"
   },
   "category": {
    "description": "Market/category for prompt generation.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "competitors": {
    "description": "Competitor domains to compare.",
    "items": {
     "maxLength": 253,
     "minLength": 3,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "domain": {
    "description": "Primary domain, e.g. 'acme.com'.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "exclude_terms": {
    "description": "Bare terms to ignore in mention matching; the full domain still matches.",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "name": {
    "description": "Brand display name.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "prompt_count": {
    "default": 20,
    "description": "Buyer-intent prompts to create.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "refresh_frequency": {
    "default": "weekly",
    "description": "Worker cron cadence; 'manual' disables cron scans. Local stdio stores this setting only.",
    "enum": [
     "daily",
     "weekly",
     "manual"
    ],
    "type": "string"
   }
  },
  "required": [
   "brand_id",
   "name",
   "domain"
  ],
  "type": "object"
 },
 "name": "track_brand",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brand_id": {
    "type": "string"
   },
   "competitors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "domain": {
    "type": "string"
   },
   "next_steps": {
    "type": "string"
   },
   "prompt_source": {
    "enum": [
     "generated",
     "fallback"
    ],
    "type": "string"
   },
   "prompts_inserted": {
    "type": "number"
   },
   "reason": {
    "type": "string"
   },
   "refresh_frequency": {
    "enum": [
     "daily",
     "weekly",
     "manual"
    ],
    "type": "string"
   },
   "seeded": {
    "type": "boolean"
   }
  },
  "required": [
   "seeded",
   "brand_id",
   "next_steps"
  ],
  "type": "object"
 },
 "title": "Track a brand"
}

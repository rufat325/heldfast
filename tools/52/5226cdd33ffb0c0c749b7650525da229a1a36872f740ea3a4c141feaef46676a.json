{
 "description": "Generate a SEP-1649 MCP Server Card (/.well-known/mcp/server-card.json) so crawlers and registries can discover your server without connecting to it.",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "What the server does",
    "type": "string"
   },
   "endpointUrl": {
    "description": "Public Streamable HTTP endpoint URL",
    "type": "string"
   },
   "name": {
    "description": "Server name",
    "type": "string"
   },
   "requiresAuth": {
    "description": "Does the server require authentication?",
    "type": "boolean"
   },
   "tools": {
    "description": "Optional JSON array of {name, description} for the capability summary. Accepts a JSON array, or a JSON string containing one.",
    "type": [
     "string",
     "array",
     "object"
    ]
   },
   "transport": {
    "description": "Transport: streamable-http or sse (default streamable-http)",
    "type": "string"
   },
   "version": {
    "description": "Server version (semver)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "description"
  ],
  "type": "object"
 },
 "name": "generate_mcp_server_card"
}

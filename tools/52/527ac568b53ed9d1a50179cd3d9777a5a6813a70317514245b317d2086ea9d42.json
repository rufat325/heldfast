{
 "description": "Create a coupon",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "default": "0",
    "type": "string"
   },
   "code": {
    "description": "Coupon code",
    "type": "string"
   },
   "date_expires": {
    "description": "Expiry date (YYYY-MM-DD)",
    "type": "string"
   },
   "discount_type": {
    "default": "fixed_cart",
    "enum": [
     "fixed_cart",
     "percent",
     "fixed_product"
    ],
    "type": "string"
   },
   "excluded_product_ids": {
    "default": [],
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "free_shipping": {
    "default": false,
    "type": "boolean"
   },
   "individual_use": {
    "default": false,
    "type": "boolean"
   },
   "maximum_amount": {
    "default": "",
    "type": "string"
   },
   "minimum_amount": {
    "default": "",
    "type": "string"
   },
   "product_ids": {
    "default": [],
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "usage_limit": {
    "type": "number"
   },
   "usage_limit_per_user": {
    "type": "number"
   }
  },
  "required": [
   "site",
   "code"
  ],
  "type": "object"
 },
 "name": "woo_create_coupon"
}

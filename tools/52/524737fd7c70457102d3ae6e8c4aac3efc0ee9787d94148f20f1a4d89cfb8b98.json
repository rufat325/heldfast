  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "height_cm": {
    "description": "Height of one piece in centimetres (> 0). Example: 100.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "length_cm": {
    "description": "Length of one piece in centimetres (> 0). Example: 120.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "pieces": {
    "description": "Number of identical pieces \u2014 total volume scales linearly. Default: 1.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "width_cm": {
    "description": "Width of one piece in centimetres (> 0). Example: 80.",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "length_cm",
   "width_cm",
   "height_cm"
  ],
  "type": "object"
 },

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Mark received messages as read. Reading a message with get_message does not mark it read.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ids": {
    "items": {
     "description": "fmsg message id",
     "pattern": "^[0-9]+$",
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "mark_read",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "failed": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "error": {
       "type": "string"
      },
      "id": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "error"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "marked": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "time_read": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "time_read"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "marked",
   "failed"
  ],
  "type": "object"
 },
 "title": "Mark fmsg messages read"
}

{
 "description": "Browse Walmart category products (no query). Same shape as search_walmart. Paginate with page while has_more_pages. limit trims locally (doesn't reduce cost). 1 credit (US/CA), 2 credits (Mexico).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category_id": {
    "description": "Category id, e.g. '1095191' or '3944_133251_1095191'.",
    "minLength": 1,
    "type": "string"
   },
   "domain": {
    "description": "'com' (US, 1cr), 'ca' (Canada, 1cr), 'com.mx' (Mexico, 2cr). Default US.",
    "enum": [
     "com",
     "ca",
     "com.mx"
    ],
    "type": "string"
   },
   "fulfillment_speed": {
    "description": "'today' or 'tomorrow'. Omit for all items.",
    "enum": [
     "today",
     "tomorrow"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max products to return (local trim, same cost).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Max price.",
    "type": "number"
   },
   "min_price": {
    "description": "Min price.",
    "type": "number"
   },
   "page": {
    "description": "Page, 1-based.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "sort_by": {
    "description": "Sort order. Default 'best_match'.",
    "enum": [
     "best_match",
     "price_low",
     "price_high",
     "best_seller",
     "rating_high",
     "new"
    ],
    "type": "string"
   }
  },
  "required": [
   "category_id"
  ],
  "type": "object"
 },
 "name": "get_walmart_category"
}

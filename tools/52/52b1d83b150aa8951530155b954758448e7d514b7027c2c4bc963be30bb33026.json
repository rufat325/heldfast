 "description": "Executed trades for a market ticker, live OR long-settled. Returns most-recent N trades with yes/no price in BOTH units (yes_price_cents and yes_price_dollars at full precision), contract size, taker side and timestamp. Useful for sanity-checking what the market actually paid vs the resting orderbook, and for reconstructing how a resolved market traded. Kalshi answers 200-with-an-empty-list on its live trades endpoint for markets it has archived, so this falls through to Kalshi's historical trade archive and reports which one answered in `source`.",
 "inputSchema": {
  "examples": [
   {
    "limit": 50,
    "ticker": "KXFED-26OCT-T3.50"
   },
   {
    "limit": 3,
    "ticker": "PRES-2024-DJT"
   }
  ],
  "properties": {
   "limit": {
    "description": "1-1000 (default 50)",
    "type": "number"
   },
   "ticker": {
    "description": "Kalshi market ticker",
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "kalshi_trades",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Number of trades returned",
    "type": "number"
   },
   "cursor": {
    "description": "Pagination cursor",
    "type": [
     "string",
     "null"
    ]
   },
   "ticker": {
    "description": "Market ticker",
    "type": "string"
   },
   "trades": {
    "description": "Recent executed trades",
    "items": {
     "properties": {
      "count": {
       "description": "Number of contracts traded",
       "type": "number"
      },
      "created_time": {
       "description": "Trade execution timestamp",
       "type": "string"
      },
      "no_price_cents": {
       "description": "NO price in cents",
       "type": "number"
      },
      "taker_side": {
       "description": "yes|no (which side took liquidity)",
       "type": "string"
      },
      "ticker": {
       "description": "Market ticker",
       "type": "string"
      },
      "trade_id": {
       "description": "Unique trade ID",
       "type": "string"
      },
      "yes_price_cents": {
       "description": "YES price in cents",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [

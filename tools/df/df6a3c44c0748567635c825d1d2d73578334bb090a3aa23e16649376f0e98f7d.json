{
 "description": "Read a bounded section of project_snapshot.yaml or project_rules.yaml. Defaults to header, summary, and the smallest matching section; full read requires explicit intent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowFullRead": {
    "default": false,
    "type": "boolean"
   },
   "attachment": {
    "default": "snapshot",
    "enum": [
     "snapshot",
     "rules",
     "project_snapshot.yaml",
     "project_rules.yaml"
    ],
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "When true, previews the HTTP request without calling the app.",
    "type": "boolean"
   },
   "intent": {
    "default": "normal",
    "enum": [
     "normal",
     "full_audit",
     "export",
     "migration",
     "rewrite",
     "full_read"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "Granoflow project id.",
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "minLength": 1,
    "type": "string"
   },
   "section": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "granoflow_project_context_attachment_read"
}

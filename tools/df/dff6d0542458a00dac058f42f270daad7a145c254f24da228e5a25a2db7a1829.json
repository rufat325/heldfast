{
 "description": "Create a new in-app event (promotion, live event, challenge, etc.) for the App Store.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "appId": {
    "description": "App ID",
    "type": "string"
   },
   "badge": {
    "description": "Event badge shown on App Store",
    "enum": [
     "LIVE_EVENT",
     "PREMIERE",
     "CHALLENGE",
     "COMPETITION",
     "NEW_SEASON",
     "MAJOR_UPDATE",
     "SPECIAL_EVENT"
    ],
    "type": "string"
   },
   "deepLink": {
    "description": "Deep link URL that opens to this event in the app",
    "type": "string"
   },
   "priority": {
    "default": "NORMAL",
    "description": "Event priority",
    "enum": [
     "HIGH",
     "NORMAL"
    ],
    "type": "string"
   },
   "purchaseRequirement": {
    "description": "Purchase requirement",
    "enum": [
     "NO_COST_ASSOCIATED",
     "IN_APP_PURCHASE",
     "SUBSCRIPTION",
     "IN_APP_PURCHASE_AND_SUBSCRIPTION",
     "IN_APP_PURCHASE_OR_SUBSCRIPTION"
    ],
    "type": "string"
   },
   "purpose": {
    "description": "Event purpose",
    "enum": [
     "APPROPRIATE_FOR_ALL_USERS",
     "LIVE_EVENT",
     "PREMIERE",
     "CHALLENGE",
     "COMPETITION",
     "NEW_SEASON",
     "MAJOR_UPDATE",
     "SPECIAL_EVENT"
    ],
    "type": "string"
   },
   "referenceName": {
    "description": "Internal reference name",
    "type": "string"
   },
   "territorySchedules": {
    "description": "Territory schedules with dates",
    "items": {
     "properties": {
      "eventEnd": {
       "type": "string"
      },
      "eventStart": {
       "type": "string"
      },
      "publishStart": {
       "type": "string"
      },
      "territories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "territories",
      "publishStart",
      "eventStart",
      "eventEnd"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "appId",
   "referenceName",
   "deepLink",
   "purpose",
   "badge",
   "purchaseRequirement",
   "territorySchedules"
  ],
  "type": "object"
 },
 "name": "asc_create_app_event"
}

{
 "description": "[Merchant] Update an existing price schedule. Only provide fields you want to change.",
 "inputSchema": {
  "properties": {
   "correctionType": {
    "description": "Price correction method",
    "enum": [
     "PERCENTAGE",
     "VALUE"
    ],
    "type": "string"
   },
   "correctionValue": {
    "description": "Correction value (positive number with max 2 decimals)",
    "type": "string"
   },
   "dateFrom": {
    "description": "Schedule start date (YYYY-MM-DD format)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dateTo": {
    "description": "Schedule end date (YYYY-MM-DD format)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "description": {
    "description": "Schedule description",
    "maxLength": 300,
    "type": "string"
   },
   "partnerId": {
    "default": "heldfast-churn-placeholder",
    "description": "Merchant partner ID (uses PAYWARE_PARTNER_ID env var as default)",
    "type": "string"
   },
   "priceCorrection": {
    "description": "Price correction direction",
    "enum": [
     "DISCOUNT",
     "INCREMENT"
    ],
    "type": "string"
   },
   "privateKey": {
    "description": "RSA private key for authentication (uses environment-specific private key as default)",
    "type": "string"
   },
   "productId": {
    "description": "Product identifier (starts with 'pr')",
    "pattern": "^pr[a-zA-Z0-9]+$",
    "type": "string"
   },
   "scheduleId": {
    "description": "Schedule identifier",
    "type": "number"
   },
   "useSandbox": {
    "default": true,
    "description": "Use sandbox environment",
    "type": "boolean"
   }
  },
  "required": [
   "productId",
   "scheduleId"
  ],
  "type": "object"
 },
 "name": "payware_products_update_schedule"
}

{
 "description": "[GA4 WRITE] Create a custom metric. Requires GA4_MCP_ENABLE_WRITES=true and confirm=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "Must be true to apply the change.",
    "type": "boolean"
   },
   "description": {
    "type": "string"
   },
   "displayName": {
    "minLength": 1,
    "type": "string"
   },
   "measurementUnit": {
    "description": "Measurement unit.",
    "enum": [
     "STANDARD",
     "CURRENCY",
     "FEET",
     "METERS",
     "KILOMETERS",
     "MILES",
     "MILLISECONDS",
     "SECONDS",
     "MINUTES",
     "HOURS"
    ],
    "type": "string"
   },
   "parameterName": {
    "description": "Event parameter name to register as a metric.",
    "minLength": 1,
    "type": "string"
   },
   "property": {
    "description": "GA4 property ID, e.g. \"123456789\" or \"properties/123456789\".",
    "minLength": 1,
    "type": "string"
   },
   "restrictedMetricType": {
    "description": "Restricted-metric types (for CURRENCY metrics).",
    "items": {
     "enum": [
      "COST_DATA",
      "REVENUE_DATA"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "scope": {
    "description": "Custom metric scope (EVENT).",
    "enum": [
     "EVENT"
    ],
    "type": "string"
   }
  },
  "required": [
   "property",
   "parameterName",
   "displayName",
   "measurementUnit",
   "scope",
   "confirm"
  ],
  "type": "object"
 },
 "name": "ga4_create_custom_metric"
}

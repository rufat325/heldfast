{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a one-click service (database, cache, etc.) or a Docker Compose deployment (pass docker_compose_raw with the YAML content). Requires project_uuid, server_uuid, and environment_name (or environment_uuid). Since Coolify v4.1, Docker Compose deployments are services, not applications.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "type": "string"
   },
   "destination_uuid": {
    "type": "string"
   },
   "docker_compose_raw": {
    "type": "string"
   },
   "environment_name": {
    "type": "string"
   },
   "environment_uuid": {
    "type": "string"
   },
   "force_domain_override": {
    "default": false,
    "type": "boolean"
   },
   "instant_deploy": {
    "default": false,
    "type": "boolean"
   },
   "is_container_label_escape_enabled": {
    "default": true,
    "type": "boolean"
   },
   "name": {
    "maxLength": 255,
    "type": "string"
   },
   "project_uuid": {
    "type": "string"
   },
   "server_uuid": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "type": "string"
   },
   "urls": {
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "project_uuid",
   "server_uuid"
  ],
  "type": "object"
 },
 "name": "createService",
 "title": "Create service"
}

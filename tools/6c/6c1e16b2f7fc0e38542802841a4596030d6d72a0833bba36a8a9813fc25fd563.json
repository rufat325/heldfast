{
 "description": "List files and directories on a remote server.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "glob": {
    "description": "Glob pattern to filter (e.g. '**/*.ts')",
    "type": "string"
   },
   "path": {
    "description": "Directory path (default: /root/project)",
    "type": "string"
   },
   "server": {
    "description": "Server name (auto-selects if only one is running)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vm_ls"
}

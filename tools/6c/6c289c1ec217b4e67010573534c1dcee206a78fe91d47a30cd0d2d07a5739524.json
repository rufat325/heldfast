{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find Tibia quests by level, premium, Rookgaard and location, with their rewards. Use this for questions like \"which quests can a level 20 character do\". Call tibia_get with a title for the legend and dangers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "type": "string"
   },
   "include_inactive": {
    "default": false,
    "type": "boolean"
   },
   "is_premium": {
    "type": "boolean"
   },
   "is_rookgaard": {
    "type": "boolean"
   },
   "level_max": {
    "description": "Highest level the character has. Quests with no level requirement always match.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "location_contains": {
    "description": "Literal substring of the location, case-insensitive.",
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "default": "level_recommended",
    "description": "Levels ascend, title is alphabetical. Unknown levels come last.",
    "enum": [
     "level_recommended",
     "level_required",
     "title"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tibia_find_quests",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "indexGeneratedAt": {
    "type": "string"
   },
   "nextCursor": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "estimatedTime": {
       "type": [
        "string",
        "null"
       ]
      },
      "isPremium": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "levelRecommended": {
       "type": [
        "number",
        "null"
       ]
      },
      "levelRequired": {
       "type": [
        "number",
        "null"
       ]
      },
      "location": {
       "type": [
        "string",
        "null"
       ]
      },
      "rewards": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "location",
      "levelRequired",
      "levelRecommended",
      "isPremium",
      "estimatedTime",
      "rewards"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalMatches": {
    "type": "number"
   }
  },
  "required": [
   "results",
   "totalMatches",
   "indexGeneratedAt"
  ],
  "type": "object"
 }
}

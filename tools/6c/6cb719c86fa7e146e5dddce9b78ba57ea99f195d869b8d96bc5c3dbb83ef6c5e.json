{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Reports what the template needs and contains: refs (variables referenced), sets (#set macros, re-picked per reference), defs (#def, rolled once per render), includes, diagnostics, and best-effort construct counts. Answers \"what variables must I supply\" \u2014 it is NOT a variant-cardinality counter.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "knownVariables": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "locale": {
    "description": "Locale for {plural \u2026} arity, e.g. \"en\" (2-form) or \"ru\" (3-form: ru/uk/be/sr/hr/bs). Omit for the 2-form default.",
    "type": "string"
   },
   "template": {
    "description": "Spintax template source. #include is disabled on this server.",
    "type": "string"
   }
  },
  "required": [
   "template"
  ],
  "type": "object"
 },
 "name": "analyze_spintax",
 "outputSchema": {
  "properties": {
   "constructs": {
    "additionalProperties": {
     "type": "integer"
    },
    "type": "object"
   },
   "defs": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "diagnostics": {
    "items": {
     "properties": {
      "code": {
       "description": "Stable machine code, e.g. plural.arity",
       "type": "string"
      },
      "column": {
       "description": "1-based",
       "type": "integer"
      },
      "data": {
       "type": "object"
      },
      "endColumn": {
       "type": "integer"
      },
      "endLine": {
       "type": "integer"
      },
      "line": {
       "description": "1-based",
       "type": "integer"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      }
     },
     "required": [
      "severity",
      "code",
      "message",
      "line",
      "column"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "includes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "refs": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sets": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "refs",
   "sets",
   "defs",
   "includes",
   "diagnostics",
   "constructs"
  ],
  "type": "object"
 },
 "title": "Analyze a spintax template"
}

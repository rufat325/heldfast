{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find Nanostores documentation by topic or store kind. Use query for free-text search across guides, API references, and best practices. Use storeKind to get docs relevant to a specific store type (atom, map, computed, etc.). Combine both to search within store-relevant pages. To read full page content, use the nanostores://docs/page/{id} resource. Example: {query: \"persistent storage\"} or {storeKind: \"computed\"} or {query: \"batched\", storeKind: \"computed\"}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum number of results",
    "type": "number"
   },
   "query": {
    "description": "Search query for documentation. Required unless storeKind is provided.",
    "type": "string"
   },
   "storeKind": {
    "description": "Find docs relevant to this store type. Can be used alone or with query.",
    "enum": [
     "atom",
     "map",
     "computed",
     "persistentAtom",
     "persistentMap",
     "atomFamily",
     "mapTemplate",
     "computedTemplate",
     "router",
     "i18n",
     "deepMap",
     "unknown"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags (e.g., ['react', 'persistent'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "nanostores_docs_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "headingPath": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "pageId": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "snippet": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "pageId",
      "title",
      "headingPath",
      "snippet",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "storeKind": {
    "type": "string"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search Nanostores documentation"
}

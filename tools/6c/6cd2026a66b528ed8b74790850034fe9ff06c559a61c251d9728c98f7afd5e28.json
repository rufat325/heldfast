{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Request Report Export"
 },
 "description": "Queue generation of the requested spreadsheet, PDF, or JSON accounting report\u2014such as profit and loss, trial balance, balance sheet, journal, or transaction export\u2014for a reporting period; track the returned requestId with get_request_status.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Export format",
    "enum": [
     "xlsx",
     "pdf",
     "json"
    ],
    "type": "string"
   },
   "fromDate": {
    "description": "Report period start ISO timestamp",
    "type": "string"
   },
   "portfolioRef": {
    "description": "Portfolio exact name or slug",
    "type": "string"
   },
   "reportType": {
    "description": "Report type",
    "enum": [
     "transactions",
     "journal-entries",
     "gains-losses",
     "cost-basis-ledger",
     "income-expense",
     "profit-and-loss",
     "statement",
     "balance-sheet",
     "trial-balance"
    ],
    "type": "string"
   },
   "toDate": {
    "description": "Report period end ISO timestamp",
    "type": "string"
   },
   "totalsOnly": {
    "description": "Return summary only when true",
    "type": "boolean"
   },
   "workspaceRef": {
    "description": "Workspace exact name or slug",
    "type": "string"
   }
  },
  "required": [
   "workspaceRef",
   "portfolioRef",
   "reportType",
   "format",
   "fromDate",
   "toDate"
  ],
  "type": "object"
 },
 "name": "request_report_export",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "requestId": {
    "type": "string"
   }
  },
  "required": [
   "requestId"
  ],
  "type": "object"
 },
 "title": "Request Report Export"
}

{
 "description": "Link or update a confirmed task usage for an Experience.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "experienceId": {
    "minLength": 1,
    "type": "string"
   },
   "kind": {
    "enum": [
     "referenced",
     "applied",
     "validated",
     "contradicted"
    ],
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "taskId": {
    "$ref": "#/properties/experienceId"
   }
  },
  "required": [
   "experienceId",
   "taskId",
   "kind",
   "confirmed"
  ],
  "type": "object"
 },
 "name": "granoflow_experience_usage_link"
}

{
 "description": "\u95be\u5024\u30d1\u30e9\u30e1\u30fc\u30bf\u8868\u306e\u5909\u66f4\u524d\u5f8c2\u30b9\u30ca\u30c3\u30d7\u30b7\u30e7\u30c3\u30c8\u3092\u7a81\u304d\u5408\u308f\u305b\u3001\u5909\u66f4\u304c\u65e2\u5b58\u306e\u30c6\u30b9\u30c8\u6761\u4ef6\u30fb\u30c6\u30b9\u30c8\u30b1\u30fc\u30b9\u30fb\u7db2\u7f85\u5bfe\u8c61\u3078\u4e0e\u3048\u308b\u5f71\u97ff\u3092\u6c7a\u5b9a\u7684\u306b\u6d17\u3044\u51fa\u3059\u3002\u30d1\u30e9\u30e1\u30fc\u30bf\u540d\u306b\u675f\u7e1b\u3057\u305f\u5883\u754c\u5024\u5909\u6570\u30fb\u540c\u5024\u30af\u30e9\u30b9\u306f\u65b0\u65e7\u305d\u308c\u305e\u308c\u3067\u518d\u5c55\u958b\u3057\u3001\u7db2\u7f85\u5bfe\u8c61ID\uff08BV:/EP:\uff09\u306e\u5909\u5316\u30fb\u5931\u52b9\u3092\u5dee\u5206\u8868\u3068\u3057\u3066\u63d0\u793a\u3059\u308b\u3002\u65e7\u5024\u306e\u76f4\u5024\u6b8b\u5b58\u3001\u5931\u52b9\u3057\u305f\u7db2\u7f85\u5bfe\u8c61ID\u53c2\u7167\u3001\u540d\u524d\u53c2\u7167\u7d4c\u7531\u3067\u518d\u78ba\u8a8d\u304c\u5fc5\u8981\u306a\u30b1\u30fc\u30b9\u3092\u533a\u5206\u4ed8\u304d\u3067\u5217\u6319\u3057\u3001\u6210\u679c\u7269\u306e\u518d\u751f\u6210\u6307\u793a\u3092\u8fd4\u3059\u3002\u5909\u66f4\u524d\u5f8c\u306e\u4ed5\u69d8\u66f8\u30c6\u30ad\u30b9\u30c8\u3092\u6e21\u3059\u3068\u95be\u5024\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u6587\u66f8\u304b\u3089\u81ea\u524d\u62bd\u51fa\u3057\u3066\u5ba3\u8a00\u8868\u3068\u7a81\u5408\u3057\u3001\u65b0\u65e7\u5bfe\u7167\u8868\u3092\u63d0\u6848\u3068\u3057\u3066\u63d0\u793a\u3059\u308b\uff08\u627f\u8a8d\u3055\u308c\u305f\u5019\u88dc\u306e\u307f\u304c\u518d\u5c55\u958b\u3078\u53cd\u6620\u3055\u308c\u308b\u4e8c\u6bb5\u69cb\u6210\uff09\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvedExtractions": {
    "description": "Human approvals for extracted threshold candidates. Only approved candidates are merged into the effective parameter tables; unapproved candidates stay proposals and never affect the re-expansion. Declared parameter values are never overwritten",
    "items": {
     "properties": {
      "afterValue": {
       "description": "Approved after-snapshot value, must equal the extracted value",
       "type": "string"
      },
      "beforeValue": {
       "description": "Approved before-snapshot value, must equal the extracted value",
       "type": "string"
      },
      "name": {
       "description": "Extracted candidate name being approved",
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "unit": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "boundaryBindings": {
    "description": "Boundary value variables bound to parameter names, re-expanded for before/after snapshots",
    "items": {
     "properties": {
      "max": {
       "description": "Literal upper bound, used when maxParameterName is not given",
       "type": "number"
      },
      "maxParameterName": {
       "description": "Parameter name bound to the upper bound",
       "type": "string"
      },
      "min": {
       "description": "Literal lower bound, used when minParameterName is not given",
       "type": "number"
      },
      "minParameterName": {
       "description": "Parameter name bound to the lower bound",
       "type": "string"
      },
      "name": {
       "description": "Boundary variable name",
       "type": "string"
      },
      "step": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "valueType": {
       "enum": [
        "int",
        "decimal"
       ],
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "boundaryMode": {
    "enum": [
     "two",
     "three"
    ],
    "type": "string"
   },
   "completedTools": {
    "description": "Already executed tools; entries without evidence are treated as not executed",
    "items": {
     "properties": {
      "evidence": {
       "description": "Evidence of execution: an output file path (e.g. docs/test-cases.md) or an output heading line starting with '#'",
       "type": "string"
      },
      "outputExcerpt": {
       "description": "Excerpt of the declared tool's actual output text. Must contain that tool's own H1 heading line; otherwise the declaration is reported as evidence-unverified and still counted as not executed",
       "type": "string"
      },
      "toolName": {
       "description": "Name of an already executed tool in this workflow",
       "type": "string"
      }
     },
     "required": [
      "toolName",
      "evidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "documentsAfter": {
    "description": "Specification texts after the change. Threshold parameter candidates are extracted from them and cross-checked against parametersAfter",
    "items": {
     "properties": {
      "content": {
       "description": "Full raw text of the specification after the change; free text, format agnostic",
       "type": "string"
      },
      "name": {
       "description": "Document name shown in the digest and in extraction sources",
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "documentsBefore": {
    "description": "Specification texts before the change. Threshold parameter candidates are extracted from them and cross-checked against parametersBefore",
    "items": {
     "properties": {
      "content": {
       "description": "Full raw text of the specification before the change; free text, format agnostic",
       "type": "string"
      },
      "name": {
       "description": "Document name shown in the digest and in extraction sources",
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "equivalenceBindings": {
    "description": "Equivalence partitioning variables bound to parameter names, re-expanded for before/after snapshots",
    "items": {
     "properties": {
      "classes": {
       "description": "Equivalence classes for this variable",
       "items": {
        "properties": {
         "description": {
          "type": "string"
         },
         "kind": {
          "enum": [
           "valid",
           "invalid"
          ],
          "type": "string"
         },
         "label": {
          "type": "string"
         },
         "representative": {
          "type": "string"
         },
         "representativeParameterName": {
          "type": "string"
         }
        },
        "required": [
         "label",
         "kind"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "description": "Equivalence variable name",
       "type": "string"
      }
     },
     "required": [
      "name",
      "classes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "parametersAfter": {
    "description": "Threshold parameter table snapshot after the change",
    "items": {
     "properties": {
      "name": {
       "description": "Parameter name referenced from case bodies",
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "source": {
       "description": "Origin (requirement id / spec location)",
       "type": "string"
      },
      "unit": {
       "type": "string"
      },
      "value": {
       "description": "Literal value",
       "type": "string"
      }
     },
     "required": [
      "name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "parametersBefore": {
    "description": "Threshold parameter table snapshot before the change; empty array means all parameters are additions",
    "items": {
     "properties": {
      "name": {
       "description": "Parameter name referenced from case bodies",
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "source": {
       "description": "Origin (requirement id / spec location)",
       "type": "string"
      },
      "unit": {
       "type": "string"
      },
      "value": {
       "description": "Literal value",
       "type": "string"
      }
     },
     "required": [
      "name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testCases": {
    "description": "Existing test cases to check for threshold change impact",
    "items": {
     "properties": {
      "caseId": {
       "description": "Test case id",
       "type": "string"
      },
      "coverageTargets": {
       "description": "Coverage target ids this case satisfies",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "note": {
       "type": "string"
      },
      "postconditions": {
       "items": {
        "properties": {
         "name": {
          "description": "State variable name",
          "type": "string"
         },
         "value": {
          "description": "State variable value",
          "type": "string"
         }
        },
        "required": [
         "name",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "preconditions": {
       "items": {
        "properties": {
         "name": {
          "description": "State variable name",
          "type": "string"
         },
         "value": {
          "description": "State variable value",
          "type": "string"
         }
        },
        "required": [
         "name",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "steps": {
       "items": {
        "properties": {
         "action": {
          "description": "A single operation for this step",
          "type": "string"
         },
         "expected": {
          "description": "Observable expected result for this step",
          "type": "string"
         },
         "no": {
          "description": "1-based sequential step number",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "no",
         "action",
         "expected"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "testConditionId": {
       "type": "string"
      },
      "title": {
       "description": "Test case title",
       "type": "string"
      }
     },
     "required": [
      "caseId",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testConditions": {
    "description": "Existing test conditions to check for threshold change impact",
    "items": {
     "properties": {
      "id": {
       "description": "Test condition id",
       "type": "string"
      },
      "statement": {
       "description": "The test condition statement",
       "type": "string"
      },
      "target": {
       "description": "Target of the condition",
       "type": "string"
      }
     },
     "required": [
      "id",
      "statement"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "verbose": {
    "description": "If false/omitted (default), sections 0.2/0.3/0.4/2.1/4.1/4.2 are truncated to a fixed number of rows with total/omitted counts noted. If true, lists every row in full (as in previous versions).",
    "type": "boolean"
   }
  },
  "required": [
   "parametersBefore",
   "parametersAfter"
  ],
  "type": "object"
 },
 "name": "reexpand_threshold_changes",
 "title": "Reexpand Threshold Changes"
}

    "limit": 50,
    "npi": "1659344299",
    "year": 2025
   }
  ],
  "properties": {
   "limit": {
    "description": "Payment rows (1-100, default 50).",
    "type": "number"
   },
   "npi": {
    "description": "Exact 10-digit NPI.",
    "type": "string"
   },
   "payment_type": {
    "enum": [
     "General",
     "Research",
     "Ownership"
    ],
    "type": "string"
   },
   "year": {
    "description": "Program year; default latest.",
    "type": "number"
   }
  },
  "required": [

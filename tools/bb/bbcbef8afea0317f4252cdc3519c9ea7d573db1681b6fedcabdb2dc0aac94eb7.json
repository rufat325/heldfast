{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Sponsor"
 },
 "description": "Add a sponsor to your sponsor book \u2014 company, tier (platinum/gold/silver/bronze), total committed ($), deliverables, optional contact. Spans all your events. Requires a connected account.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "company_name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "contact_email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "contact_name": {
    "maxLength": 160,
    "type": "string"
   },
   "contact_phone": {
    "maxLength": 40,
    "type": "string"
   },
   "deliverables": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "notes": {
    "maxLength": 4000,
    "type": "string"
   },
   "tier": {
    "enum": [
     "platinum",
     "gold",
     "silver",
     "bronze"
    ],
    "type": "string"
   },
   "total_committed": {
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "company_name"
  ],
  "type": "object"
 },
 "name": "add_sponsor",
 "title": "Add Sponsor"
}

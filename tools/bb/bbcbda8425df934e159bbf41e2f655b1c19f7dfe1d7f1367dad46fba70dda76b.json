{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Filter periodic table elements by category, group, period, atomic number range, or atomic mass range. At least one filter is required. Returns matching elements as a summary list. Use ref_element_lookup for the full record on a specific element. Valid categories: alkali metal, alkaline earth metal, transition metal, post-transition metal, metalloid, reactive nonmetal, noble gas, lanthanide, actinide.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "atomic_mass_range": {
    "description": "Inclusive range of atomic mass in unified atomic mass units.",
    "properties": {
     "max": {
      "description": "Maximum value (inclusive).",
      "type": "number"
     },
     "min": {
      "description": "Minimum value (inclusive).",
      "type": "number"
     }
    },
    "required": [
     "min",
     "max"
    ],
    "type": "object"
   },
   "atomic_number_range": {
    "description": "Inclusive range of atomic numbers to include.",
    "properties": {
     "max": {
      "description": "Maximum value (inclusive).",
      "type": "number"
     },
     "min": {
      "description": "Minimum value (inclusive).",
      "type": "number"
     }
    },
    "required": [
     "min",
     "max"
    ],
    "type": "object"
   },
   "category": {
    "description": "Element category (partial match): alkali metal, alkaline earth metal, transition metal, post-transition metal, metalloid, reactive nonmetal, noble gas, lanthanide, actinide.",
    "type": "string"
   },
   "group": {
    "description": "Periodic table group number (1\u201318). Lanthanides and actinides have no group.",
    "maximum": 18,
    "minimum": 1,
    "type": "integer"
   },
   "period": {
    "description": "Periodic table period (1\u20137).",
    "maximum": 7,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "ref_element_search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "results",
     "totalMatches",
     "appliedFilters"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "appliedFilters": {
    "additionalProperties": false,
    "description": "Active filters applied to the search.",
    "properties": {
     "atomic_mass_range": {
      "additionalProperties": false,
      "description": "Atomic mass range applied.",
      "properties": {
       "max": {
        "description": "Maximum value (inclusive).",
        "type": "number"
       },
       "min": {
        "description": "Minimum value (inclusive).",
        "type": "number"
       }
      },
      "required": [
       "min",
       "max"
      ],
      "type": "object"
     },
     "atomic_number_range": {
      "additionalProperties": false,
      "description": "Atomic number range applied.",
      "properties": {
       "max": {
        "description": "Maximum value (inclusive).",
        "type": "number"
       },
       "min": {
        "description": "Minimum value (inclusive).",
        "type": "number"
       }
      },
      "required": [
       "min",
       "max"
      ],
      "type": "object"
     },
     "category": {
      "description": "Category filter applied.",
      "type": "string"
     },
     "group": {
      "description": "Group filter applied.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "period": {
      "description": "Period filter applied.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `no_filters`: No filter was provided. Other values are possible when a failure originates below the handler.",
        "examples": [
         "no_filters"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "notice": {
    "description": "Recovery hint when no elements matched \u2014 echoes active filters and suggests how to broaden.",
    "type": "string"
   },
   "results": {
    "description": "Matching element summaries.",
    "items": {
     "additionalProperties": false,
     "description": "Summary for a matching element.",
     "properties": {
      "atomic_mass": {
       "description": "Atomic mass in unified atomic mass units. Null for unstable elements.",
       "type": [
        "number",
        "null"
       ]
      },
      "atomic_mass_estimated": {
       "description": "True when the atomic mass is estimated.",
       "type": "boolean"
      },
      "category": {
       "description": "Element category.",
       "type": "string"
      },
      "name": {
       "description": "IUPAC element name.",
       "type": "string"
      },
      "number": {
       "description": "Atomic number.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "symbol": {
       "description": "Chemical symbol.",
       "type": "string"
      }
     },
     "required": [
      "number",
      "symbol",
      "name",
      "atomic_mass",
      "atomic_mass_estimated",
      "category"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalMatches": {
    "description": "Number of elements matching all filters.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "Element Search"
}

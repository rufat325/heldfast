 "description": "Full-text + faceted search across GovInfo. Filter by one or more collection codes (BILLS, FR, CFR, USCODE, CHRG, CRPT, CREC, PLAW, USCOURTS...), date range, congress, and free-text query. Several codes search the union of those collections. Returns package IDs, titles, collection and issue dates.",
 "inputSchema": {
  "examples": [
   {
    "query": "climate change"
   },
   {
    "collections": "CHRG,CRPT",
    "limit": 5,
    "query": "Cooper"
   },
   {
    "collections": "BILLS,FR",
    "congress": 118,
    "date_from": "2023-01-01",
    "date_to": "2024-12-31",
    "page_size": 50,
    "query": "environmental protection"
   }
  ],
  "properties": {
   "collections": {
    "description": "Collection codes, comma- or space-separated (e.g. \"CHRG\" or \"CHRG,CRPT\"). Several codes return the union of those collections \u2014 \"CHRG,CRPT\" gives every package in either. Codes come from list_collections.",
    "type": "string"
   },
   "congress": {
    "description": "Congress number (e.g., 118) \u2014 for BILLS/CHRG/CRPT",
    "type": "number"
   },
   "date_from": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "date_to": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "limit": {
    "description": "Alias for page_size, 1-100.",
    "type": "number"
   },
   "offset_mark": {
    "description": "Pagination cursor from previous response",
    "type": "string"
   },
   "page_size": {
    "description": "Results per page, 1-100 (default 25). `limit` works as an alias.",
    "type": "number"
   },
   "query": {
    "description": "Free-text search",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_packages",
 "outputSchema": {
  "properties": {
   "next_offset_mark": {
    "description": "Pagination cursor for next results",
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "description": "Search result packages",
    "items": {
     "properties": {
      "collection": {

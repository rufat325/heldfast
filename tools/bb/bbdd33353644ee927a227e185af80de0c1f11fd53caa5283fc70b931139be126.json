       "description": "Last modified date",
       "type": [
        "string",
        "null"
       ]
      },
      "package_id": {
       "description": "GovInfo package ID",
       "type": [
        "string",
        "null"
       ]
      },
      "package_link": {
       "description": "URL to package on GovInfo",
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "description": "Package title",
       "type": [
        "string",

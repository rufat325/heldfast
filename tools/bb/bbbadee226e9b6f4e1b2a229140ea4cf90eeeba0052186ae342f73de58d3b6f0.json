    "type": "string"
   },
   "handles": {
    "description": "Object handles to fetch.",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "projection": {
    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   },
   "select": {
    "description": "Optional property names to include.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "documentId",
   "handles"
  ],
  "type": "object"
 },
 "name": "dwg.get_objects"
}

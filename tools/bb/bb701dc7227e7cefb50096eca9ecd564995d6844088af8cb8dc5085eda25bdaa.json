{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Semantic search over the persistent memory store. Returns facts, pack chunks, and past optimizations ranked by vector similarity to the query. Useful for inspecting what ClarifyPrompt would retrieve for a given prompt, and for debugging curator decisions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kinds": {
    "default": [
     "fact",
     "pack_chunk"
    ],
    "description": "Which memory kinds to search. Default: facts + pack chunks.",
    "items": {
     "enum": [
      "fact",
      "outcome",
      "pack_chunk",
      "optimization"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 5,
    "exclusiveMinimum": 0,
    "maximum": 25,
    "type": "integer"
   },
   "query": {
    "description": "The search query \u2014 usually the user's intent or a paraphrase of a future prompt.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "memory_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "kinds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Search persistent memory"
}

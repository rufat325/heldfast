{
 "description": "Google AI Mode: synthesized answer with cited sources. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device.",
    "enum": [
     "desktop",
     "mobile"
    ],
    "type": "string"
   },
   "gl": {
    "description": "Country, e.g. 'us'.",
    "type": "string"
   },
   "google_domain": {
    "description": "e.g. 'google.co.uk'.",
    "type": "string"
   },
   "hl": {
    "description": "Language, e.g. 'en'.",
    "type": "string"
   },
   "include_html": {
    "description": "Include raw HTML.",
    "type": "boolean"
   },
   "location": {
    "description": "Location name, auto-encoded to UULE.",
    "type": "string"
   },
   "query": {
    "description": "Question or prompt.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "safe": {
    "description": "SafeSearch.",
    "enum": [
     "active"
    ],
    "type": "string"
   },
   "uule": {
    "description": "UULE string, overrides location.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "google_ai_mode"
}

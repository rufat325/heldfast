{
 "description": "Append a section to a legal document. Returns the resolved slug, which is what shortcodes address.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "HTML body",
    "type": "string"
   },
   "doc": {
    "description": "Document type",
    "enum": [
     "impressum",
     "datenschutz",
     "agb",
     "widerruf"
    ],
    "type": "string"
   },
   "heading": {
    "type": "string"
   },
   "level": {
    "description": "2 or 3, default 2",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "site",
   "doc",
   "heading",
   "body"
  ],
  "type": "object"
 },
 "name": "legal_add_section"
}

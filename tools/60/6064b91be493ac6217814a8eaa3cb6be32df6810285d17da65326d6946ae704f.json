{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "YNAB: List Months"
 },
 "description": "List summary data for all budget months with pagination.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - limit (int, optional): Max results per page. Default: 50.\n  - offset (int, optional): Zero-based offset for pagination. Default: 0.\n  - response_format (string, optional): \"json\" or \"markdown\" (default: \"markdown\").\n\nReturns: months[], total_count, returned_count, offset, has_more, next_offset, cached, cache_info\n\nExamples:\n  - List recent months: call with no args, months are newest-first\n  - Page 2: set limit=12, offset=12\n\nErrors:\n  - \"No default budget set\" \u2192 run ynab_set_default_budget first",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ynab_list_months",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cache_info": {
    "description": "Human-readable cache status message (e.g., \"Cache hit\", \"Cache miss\")",
    "type": "string"
   },
   "cached": {
    "description": "Indicates if data was served from cache",
    "type": "boolean"
   },
   "has_more": {
    "description": "Whether more items exist beyond this page",
    "type": "boolean"
   },
   "months": {
    "description": "List of months",
    "items": {
     "additionalProperties": false,
     "properties": {
      "activity": {
       "description": "Activity in dollars",
       "type": "number"
      },
      "age_of_money": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Age of money in days"
      },
      "budgeted": {
       "description": "Budgeted amount in dollars",
       "type": "number"
      },
      "deleted": {
       "description": "Deleted flag",
       "type": "boolean"
      },
      "income": {
       "description": "Income in dollars",
       "type": "number"
      },
      "month": {
       "description": "Month identifier",
       "type": "string"
      },
      "note": {
       "description": "Month note",
       "type": "string"
      },
      "to_be_budgeted": {
       "description": "To be budgeted in dollars",
       "type": "number"
      }
     },
     "required": [
      "month",
      "income",
      "budgeted",
      "activity",
      "to_be_budgeted",
      "deleted"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_offset": {
    "description": "Offset for next page, if has_more is true",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "offset": {
    "description": "Offset used for this response",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "returned_count": {
    "description": "Number of items returned",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "total_count": {
    "description": "Total number of items available",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "usedDelta": {
    "description": "Indicates if delta merge optimization was applied for budgets",
    "type": "boolean"
   }
  },
  "required": [
   "total_count",
   "returned_count",
   "offset",
   "has_more",
   "months"
  ],
  "type": "object"
 }
}

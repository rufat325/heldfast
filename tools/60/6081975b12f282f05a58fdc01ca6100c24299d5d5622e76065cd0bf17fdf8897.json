     "JSON",
     "XML"
    ],
    "type": "string"
   },
   "includeFields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "topic": {
    "description": "The webhook topic (e.g., ORDERS_CREATE)",
    "type": "string"
   }
  },
  "required": [

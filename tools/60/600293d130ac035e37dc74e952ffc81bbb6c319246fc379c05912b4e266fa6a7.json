{
 "description": "Send a command to a device (e.g. turn on a relay, blink an LED, set a value).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Command action (e.g. relay.on, relay.off, led.on, led.off, led.blink, led.toggle)",
    "type": "string"
   },
   "device_id": {
    "description": "Device ID",
    "type": "string"
   },
   "params": {
    "additionalProperties": {},
    "description": "Optional parameters (e.g. {\"duration\": 5000} for timed relay)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "device_id",
   "action"
  ],
  "type": "object"
 },
 "name": "send_command"
}

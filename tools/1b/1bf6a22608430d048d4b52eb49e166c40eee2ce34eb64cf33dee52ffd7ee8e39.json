{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List the policies previously created on this PolicyForge account, newest first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results (1-100, default 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset.",
    "minimum": 0,
    "type": "integer"
   },
   "sortBy": {
    "description": "Sort field (default updatedAt).",
    "enum": [
     "createdAt",
     "updatedAt",
     "name"
    ],
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort direction (default desc).",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status.",
    "enum": [
     "draft",
     "published",
     "archived"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by policy type.",
    "enum": [
     "privacy_policy",
     "terms_of_service",
     "cookie_policy",
     "refund_policy",
     "eula",
     "disclaimer",
     "baa"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_policies",
 "title": "List policies"
}

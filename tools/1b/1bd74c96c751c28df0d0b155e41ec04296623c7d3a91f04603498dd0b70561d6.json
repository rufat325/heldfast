{
 "description": "Bind an initial or recovered browser surface to an existing frozen member and run. This increments the inspection epoch and returns only the exact backend-stored requisition URL; it never creates a replacement run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adapterCode": {
    "pattern": "^[a-z0-9][a-z0-9_:-]{0,99}$",
    "type": "string"
   },
   "batchId": {
    "minimum": 1,
    "type": "integer"
   },
   "bindingReason": {
    "enum": [
     "initial_binding",
     "recovery_binding"
    ],
    "type": "string"
   },
   "browserBindingHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "browserSurface": {
    "enum": [
     "codex_in_app",
     "chrome_extension",
     "claude_in_chrome"
    ],
    "type": "string"
   },
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "expectedInspectionEpoch": {
    "minimum": 0,
    "type": "integer"
   },
   "expectedMemberVersion": {
    "minimum": 1,
    "type": "integer"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 16,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "leaseToken": {
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "memberId": {
    "minimum": 1,
    "type": "integer"
   },
   "runId": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "batchId",
   "memberId",
   "runId",
   "expectedMemberVersion",
   "expectedInspectionEpoch",
   "leaseToken",
   "browserBindingHash",
   "browserSurface",
   "adapterCode",
   "bindingReason",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "trackly_bind_apply_surface"
}

{
 "description": "MIND Library \u2014 personal bookshelf at m-i-n-d.ai/#/library. Actions: authors (author stats), books_list, book_get, book_content (chapter text/table of contents), book_companion (AI reading companion for a book), book_create, book_update, book_delete.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Which library operation to perform.",
    "enum": [
     "authors",
     "books_list",
     "book_get",
     "book_content",
     "book_companion",
     "book_create",
     "book_update",
     "book_delete"
    ],
    "type": "string"
   },
   "author": {
    "description": "Filter by author \u2014 books_list.",
    "type": "string"
   },
   "authors": {
    "description": "Author names \u2014 book_create/book_update.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "book_id": {
    "description": "Book id \u2014 every action except authors/books_list/book_create.",
    "type": "string"
   },
   "chapter": {
    "description": "Return only this chapter id \u2014 book_content.",
    "type": "string"
   },
   "cover_url": {
    "description": "Cover image URL \u2014 book_create/book_update.",
    "type": "string"
   },
   "date_finished": {
    "description": "Date finished (YYYY-MM-DD) \u2014 book_create/book_update.",
    "type": "string"
   },
   "date_started": {
    "description": "Date started (YYYY-MM-DD) \u2014 book_create/book_update.",
    "type": "string"
   },
   "description": {
    "description": "Book description/blurb \u2014 book_create/book_update.",
    "type": "string"
   },
   "file_format": {
    "description": "File format, e.g. 'epub'/'pdf' \u2014 book_create/book_update.",
    "type": "string"
   },
   "file_size": {
    "description": "File size in bytes \u2014 book_create/book_update.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "file_url": {
    "description": "Book file URL \u2014 book_create/book_update.",
    "type": "string"
   },
   "genre": {
    "description": "Filter by genre \u2014 books_list.",
    "type": "string"
   },
   "genres": {
    "description": "Genres \u2014 book_create/book_update.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "isbn10": {
    "description": "ISBN-10 \u2014 book_create/book_update.",
    "type": "string"
   },
   "isbn13": {
    "description": "ISBN-13 \u2014 book_create/book_update.",
    "type": "string"
   },
   "language": {
    "description": "Language code \u2014 book_create/book_update.",
    "type": "string"
   },
   "limit": {
    "description": "Max results \u2014 books_list (default 60, 1-500).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "notes": {
    "description": "Free-text notes \u2014 book_create/book_update.",
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset \u2014 books_list (default 0).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "order": {
    "description": "Sort order 'asc'|'desc' \u2014 books_list (default 'desc').",
    "type": "string"
   },
   "page_count": {
    "description": "Page count \u2014 book_create/book_update.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "progress_pct": {
    "description": "Reading progress percent 0-100 \u2014 book_create (default 0)/book_update.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "published_year": {
    "description": "Publication year \u2014 book_create/book_update.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "publisher": {
    "description": "Publisher \u2014 book_create/book_update.",
    "type": "string"
   },
   "q": {
    "description": "Free-text search \u2014 books_list.",
    "type": "string"
   },
   "rating": {
    "description": "Rating 0-5 \u2014 book_create/book_update.",
    "type": "number"
   },
   "series": {
    "description": "Filter by series \u2014 books_list; book_create/book_update.",
    "type": "string"
   },
   "series_index": {
    "description": "Position within the series \u2014 book_create/book_update.",
    "type": "number"
   },
   "shelf_id": {
    "description": "Filter by shelf id \u2014 books_list.",
    "type": "string"
   },
   "sort": {
    "description": "Sort field \u2014 books_list (default 'added').",
    "type": "string"
   },
   "source": {
    "description": "Source of the record \u2014 book_create (default 'manual').",
    "type": "string"
   },
   "source_id": {
    "description": "External source id \u2014 book_create.",
    "type": "string"
   },
   "status": {
    "description": "Filter by reading status \u2014 books_list; book_create (default 'unread')/book_update.",
    "enum": [
     "unread",
     "reading",
     "finished",
     "abandoned"
    ],
    "type": "string"
   },
   "subtitle": {
    "description": "Book subtitle \u2014 book_create/book_update.",
    "type": "string"
   },
   "tag": {
    "description": "Filter by tag \u2014 books_list.",
    "type": "string"
   },
   "tags": {
    "description": "Tags \u2014 book_create/book_update.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Book title \u2014 required for book_create; book_update.",
    "type": "string"
   },
   "toc_only": {
    "description": "Return only the table of contents, no HTML \u2014 book_content (default false).",
    "type": "boolean"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "mind_library"
}

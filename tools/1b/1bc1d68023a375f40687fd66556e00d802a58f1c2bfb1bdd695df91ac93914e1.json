{
 "description": "List recent Outscraper requests by bucket.\n\nBest for:\n- debugging async flows\n- seeing running, completed, or failed jobs\n- checking what was recently submitted through the current API key\n\nUse this when:\n- you lost a request id and want to find recent jobs\n- you want a quick view of recent running or finished requests\n- you are debugging async submissions across tools",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "type": {
    "description": "Optional request bucket.",
    "enum": [
     "running",
     "finished",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "requests_list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "async": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "is_async_submission": {
      "type": "boolean"
     },
     "next_step": {
      "type": "string"
     },
     "results_location": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "is_async_submission"
    ],
    "type": "object"
   },
   "data": {},
   "meta": {
    "additionalProperties": false,
    "properties": {
     "operation": {
      "type": "string"
     },
     "service": {
      "type": "string"
     }
    },
    "required": [
     "service",
     "operation"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "Outscraper Request History"
}

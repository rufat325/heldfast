{
 "description": "Map product claims and observed proof to current channel rules, required artifacts, link treatment, attribution, pricing disclosure, and human-authored identity fields. Costs $0.25 USDC on Base mainnet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifacts": {
    "additionalProperties": false,
    "properties": {
     "attribution_mechanism": {
      "maxLength": 2000,
      "type": "string"
     },
     "demo_url": {
      "type": "string"
     },
     "install_path": {
      "maxLength": 2000,
      "type": "string"
     },
     "link_target": {
      "type": "string"
     },
     "pricing_disclosure": {
      "maxLength": 2000,
      "type": "string"
     },
     "screenshots": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "evidence_id": {
         "type": "string"
        },
        "id": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "evidence_id"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     }
    },
    "required": [
     "demo_url",
     "install_path",
     "screenshots",
     "pricing_disclosure",
     "link_target",
     "attribution_mechanism"
    ],
    "type": "object"
   },
   "channel": {
    "additionalProperties": false,
    "properties": {
     "demo_required": {
      "type": "boolean"
     },
     "identity_fields": {
      "items": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     "kind": {
      "enum": [
       "agent-directory",
       "marketplace",
       "community",
       "social",
       "package-registry",
       "product-launch",
       "owned-search"
      ]
     },
     "link_policy": {
      "enum": [
       "allowed",
       "limited",
       "prohibited",
       "unknown"
      ]
     },
     "name": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "pricing_disclosure_required": {
      "type": "boolean"
     },
     "rule_status": {
      "enum": [
       "verified",
       "review-required",
       "unknown",
       "blocked"
      ]
     },
     "rules_captured_at": {
      "format": "date-time",
      "type": "string"
     },
     "rules_source_url": {
      "format": "uri",
      "type": "string"
     },
     "screenshots_required": {
      "maximum": 20,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "name",
     "kind",
     "rules_captured_at",
     "rules_source_url",
     "rule_status",
     "link_policy",
     "pricing_disclosure_required",
     "demo_required",
     "screenshots_required",
     "identity_fields"
    ],
    "type": "object"
   },
   "claims": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "evidence_ids": {
       "items": {
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "human_field": {
       "maxLength": 120,
       "type": "string"
      },
      "id": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "personal_experience": {
       "type": "boolean"
      },
      "required_for_submission": {
       "type": "boolean"
      },
      "text": {
       "maxLength": 2000,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "text",
      "evidence_ids",
      "required_for_submission",
      "personal_experience"
     ],
     "type": "object"
    },
    "maxItems": 250,
    "minItems": 1,
    "type": "array"
   },
   "evidence": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "captured_at": {
       "format": "date-time",
       "type": "string"
      },
      "id": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "observed": {
       "type": "boolean"
      },
      "source_url": {
       "format": "uri",
       "type": "string"
      },
      "supports_claim_ids": {
       "items": {
        "type": "string"
       },
       "maxItems": 250,
       "type": "array"
      },
      "type": {
       "enum": [
        "product-page",
        "documentation",
        "registry",
        "demo",
        "screenshot",
        "payment",
        "release",
        "support",
        "security",
        "privacy",
        "experiment"
       ]
      }
     },
     "required": [
      "id",
      "type",
      "source_url",
      "captured_at",
      "observed",
      "supports_claim_ids"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "human_authored_fields": {
    "additionalProperties": {
     "type": "boolean"
    },
    "type": "object"
   },
   "max_evidence_age_days": {
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "observed_at": {
    "format": "date-time",
    "type": "string"
   },
   "product": {
    "additionalProperties": false,
    "properties": {
     "canonical_url": {
      "format": "uri",
      "type": "string"
     },
     "id": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "name": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "offer_url": {
      "format": "uri",
      "type": "string"
     },
     "price_usd": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "number"
     },
     "version": {
      "maxLength": 60,
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "version",
     "canonical_url",
     "offer_url",
     "price_usd"
    ],
    "type": "object"
   }
  },
  "required": [
   "observed_at",
   "max_evidence_age_days",
   "product",
   "channel",
   "claims",
   "evidence",
   "artifacts",
   "human_authored_fields"
  ],
  "type": "object"
 },
 "name": "justhandled_proof_to_channel_evidence_packet"
}

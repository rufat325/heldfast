{
 "description": "Create a new calendar event. Supports title, start/end time, description, location, attendees, recurrence. Google Meet links available with Google provider. Automatically checks for conflicts before creating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addMeetLink": {
    "description": "Auto-generate a Google Meet link for this event",
    "type": "boolean"
   },
   "attendees": {
    "description": "Attendee email addresses",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "calendarId": {
    "description": "Calendar ID (default: primary)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "description": "Event description",
    "maxLength": 10000,
    "type": "string"
   },
   "end": {
    "description": "End time (ISO 8601, e.g. 2026-03-18T11:00:00+01:00)",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "location": {
    "description": "Event location",
    "maxLength": 500,
    "type": "string"
   },
   "recurrence": {
    "description": "Recurrence rule: \"daily\", \"weekly\", \"monthly\", \"yearly\", or custom RRULE string (e.g. \"RRULE:FREQ=WEEKLY;BYDAY=MO\")",
    "maxLength": 500,
    "type": "string"
   },
   "start": {
    "description": "Start time (ISO 8601, e.g. 2026-03-18T10:00:00+01:00)",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "summary": {
    "description": "Event title",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "timeZone": {
    "description": "Time zone (default: Europe/Berlin)",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "summary",
   "start",
   "end"
  ],
  "type": "object"
 },
 "name": "calendar_create_event"
}

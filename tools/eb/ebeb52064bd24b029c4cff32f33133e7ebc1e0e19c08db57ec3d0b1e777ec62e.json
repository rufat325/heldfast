  "readOnlyHint": false,
  "title": "YNAB: Create Multiple Transactions"
 },
 "description": "Create 1\u2013100 transactions in a single batch with duplicate detection and dry-run support.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - transactions (array, required): Up to 100 transaction objects. Each requires account_id, date, and exactly one of amount_decimal (preferred), amount_milliunits, or deprecated amount.\n  - dry_run (boolean, optional): Validate without saving. Default: false.\n\nReturns: summary (created, duplicates, failed), results[], transactions[].\n\nExamples:\n  - Dry run first: set dry_run=true to validate before committing\n  - If you explicitly want YNAB-side duplicate import detection, set import_id on each transaction\n\nWrite safety: call without confirmation_token to preview. Execute the identical validated request with the short-lived confirmation_token returned by that preview.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "confirmation_token": {
    "description": "Short-lived, single-use token returned by the immediately preceding preview of this exact validated request.",
    "minLength": 16,
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   },
   "transactions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "account_id": {
       "minLength": 1,
       "type": "string"
      },
      "amount": {
       "description": "Deprecated legacy alias for amount_milliunits. Use amount_decimal for currency input or amount_milliunits for raw YNAB values.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "amount_decimal": {
       "description": "Preferred: amount in decimal currency units (for example, -12.34). Rounded exactly to the nearest YNAB milliunit.",
       "type": "number"
      },
      "amount_milliunits": {
       "description": "Raw YNAB milliunits. Use only when the value is already converted.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "approved": {
       "type": "boolean"
      },
      "category_id": {
       "type": "string"
      },
      "cleared": {
       "enum": [
        "cleared",
        "uncleared",
        "reconciled"
       ],
       "type": "string"
      },
      "date": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "flag_color": {
       "enum": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple"
       ],
       "type": "string"
      },
      "import_id": {
       "minLength": 1,
       "type": "string"
      },
      "memo": {
       "type": "string"
      },
      "payee_id": {
       "type": "string"
      },
      "payee_name": {
       "type": "string"
      }
     },
     "required": [
      "account_id",
      "date"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "transactions"
  ],
  "type": "object"
 },

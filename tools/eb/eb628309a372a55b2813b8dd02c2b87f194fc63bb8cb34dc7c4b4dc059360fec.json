{
 "description": "Create a task in the shared 5dive task queue. Returns the new task's id (e.g. DIVE-N). Use for filing work for an agent or human on the fleet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assignee": {
    "description": "Agent name to assign to.",
    "type": "string"
   },
   "body": {
    "description": "Full task description / context.",
    "type": "string"
   },
   "from": {
    "description": "Who is filing the task.",
    "type": "string"
   },
   "parent": {
    "description": "Parent task id (numeric or DIVE-N) to nest under.",
    "type": "string"
   },
   "priority": {
    "description": "Task priority (default: medium).",
    "enum": [
     "low",
     "medium",
     "high",
     "urgent"
    ],
    "type": "string"
   },
   "title": {
    "description": "Short task title.",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "task_create"
}

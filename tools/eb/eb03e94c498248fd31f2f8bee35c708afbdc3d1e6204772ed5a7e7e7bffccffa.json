   {
    "base": "EUR",
    "date": "2020-03-20",
    "symbols": "USD"
   }
  ],
  "properties": {
   "base": {
    "description": "Base currency code (default \"EUR\")",
    "type": "string"
   },
   "date": {
    "description": "Date in YYYY-MM-DD format (e.g., \"2024-01-15\")",
    "type": "string"
   },
   "symbols": {
    "description": "Comma-separated target currency codes (e.g., \"USD,GBP\")",
    "type": "string"
   }
  },
  "required": [

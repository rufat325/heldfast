{
 "description": "Probe a bounded localhost port list for Granoflow identity. This never scans all ports or writes config.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ports": {
    "items": {
     "maximum": 65535,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 20,
    "type": "array"
   },
   "timeoutMs": {
    "maximum": 5000,
    "minimum": 50,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "granoflow_setup_detect_local_api"
}

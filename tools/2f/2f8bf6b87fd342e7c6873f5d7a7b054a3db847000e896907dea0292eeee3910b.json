{
 "description": "Import memories from a JSON array. Use to restore from backup, migrate between machines, or bootstrap a project with shared team context.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "memories": {
    "description": "Array of memories to import",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "enum": [
        "decision",
        "convention",
        "bug",
        "architecture",
        "preference",
        "todo",
        "context",
        "session_summary"
       ],
       "type": "string"
      },
      "content": {
       "minLength": 1,
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "importance": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "status": {
       "enum": [
        "pending",
        "in_progress",
        "done"
       ],
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "content",
      "category"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "memories"
  ],
  "type": "object"
 },
 "name": "memory_import"
}

{
 "description": "Get the full details of an Ata de Registro de Pre\u00e7o, optionally including its items (with available balance and supplier info) and attached files. Use orgaoCnpj/anoCompra/sequencialCompra (the parent procurement) and sequencialAta (the ARP within that procurement).",
 "inputSchema": {
  "properties": {
   "anoCompra": {
    "description": "Year of the parent procurement",
    "type": "integer"
   },
   "includeArquivos": {
    "default": false,
    "type": "boolean"
   },
   "includeItens": {
    "default": true,
    "type": "boolean"
   },
   "orgaoCnpj": {
    "description": "Procuring agency CNPJ",
    "type": "string"
   },
   "sequencialAta": {
    "description": "Sequential of the ARP",
    "type": "integer"
   },
   "sequencialCompra": {
    "description": "Sequential of the parent procurement",
    "type": "integer"
   }
  },
  "required": [
   "orgaoCnpj",
   "anoCompra",
   "sequencialCompra",
   "sequencialAta"
  ],
  "type": "object"
 },
 "name": "get_ata_rp"
}

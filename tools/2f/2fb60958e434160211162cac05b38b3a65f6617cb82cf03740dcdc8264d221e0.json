{
 "description": "Compile Java source code and optionally inject into JAR.",
 "inputSchema": {
  "properties": {
   "auto_classpath": {
    "description": "Auto-add JAR to classpath (default: true)",
    "type": "boolean"
   },
   "class_name": {
    "description": "Fully-qualified class name",
    "type": "string"
   },
   "classpath": {
    "description": "Additional classpath entries",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "inject_into_jar": {
    "description": "Inject compiled class into JAR (default: true)",
    "type": "boolean"
   },
   "java_release": {
    "description": "Java release target (default: 21)",
    "type": "number"
   },
   "session_id": {
    "description": "Session ID",
    "type": "string"
   },
   "source_code": {
    "description": "Java source code",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "source_code",
   "class_name"
  ],
  "type": "object"
 },
 "name": "jar_compile_java"
}

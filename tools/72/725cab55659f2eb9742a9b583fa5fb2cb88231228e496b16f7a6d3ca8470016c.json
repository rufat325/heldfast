{
 "description": "Check a Swift project for Swift 6 concurrency and isolation defects: @Observable types missing @MainActor, Task.detached, DispatchQueue.main.async in async code, @unchecked Sendable, nonisolated(unsafe), unstructured Tasks in onAppear, empty catch blocks, and types named Task that shadow _Concurrency.Task. Use when reviewing Swift code, migrating to Swift 6, or diagnosing a data race.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "path": {
    "description": "Absolute path to the Swift project root (the folder containing Package.swift or the .xcodeproj).",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "review_swift_concurrency",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "counts": {
    "additionalProperties": false,
    "properties": {
     "blocker": {
      "type": "integer"
     },
     "minor": {
      "type": "integer"
     },
     "serious": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "blocker",
     "serious",
     "minor",
     "total"
    ],
    "type": "object"
   },
   "files_checked": {
    "description": "Swift files actually scanned.",
    "type": "integer"
   },
   "issues": {
    "description": "Every finding, most severe first.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "consequence": {
       "type": "string"
      },
      "doc": {
       "type": "string"
      },
      "excerpt": {
       "type": "string"
      },
      "file": {
       "type": "string"
      },
      "fix": {
       "type": "string"
      },
      "line": {
       "type": "integer"
      },
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "blocker",
        "serious",
        "minor"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "severity",
      "rule",
      "message",
      "consequence",
      "fix",
      "doc",
      "excerpt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "score": {
    "description": "0-100 defect density. 100 = no findings. penalty = 10*blockers + 3*serious + 1*minor; capacity = files*10. Comparable across runs on ONE project, not between projects.",
    "type": "integer"
   },
   "suggestions": {
    "description": "Prioritized next actions, deduplicated by rule \u2014 not a restatement of every issue's fix.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary": {
    "description": "One-line plain-language result.",
    "type": "string"
   }
  },
  "required": [
   "summary",
   "score",
   "counts",
   "files_checked",
   "issues",
   "suggestions"
  ],
  "type": "object"
 },
 "title": "Review Swift concurrency and actor isolation"
}

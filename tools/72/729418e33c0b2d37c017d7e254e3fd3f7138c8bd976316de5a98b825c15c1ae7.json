{
 "description": "Expire or force-renew a StoreKit test subscription by transaction ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "\"expire\" to expire a subscription, \"renew\" to force renewal",
    "enum": [
     "expire",
     "renew"
    ],
    "type": "string"
   },
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "transactionId": {
    "description": "Transaction ID of the subscription",
    "type": "string"
   }
  },
  "required": [
   "action",
   "transactionId"
  ],
  "type": "object"
 },
 "name": "simulator_storekit_manage_subscription"
}

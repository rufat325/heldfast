{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "title": "Set category-author mapping"
 },
 "description": "Set the category-to-author mapping for a WordPress domain. Replaces any existing mapping. The mapping is consumed by categorize_pages and the publish tools to auto-resolve the author for each post.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "default_author_id": {
    "description": "Default author ID when no mapping matches",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "default_category_id": {
    "description": "Default category ID when a page has no category assigned",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "domain": {
    "description": "WordPress domain (e.g. example.com)",
    "type": "string"
   },
   "mappings": {
    "description": "Array of category-to-author mappings",
    "items": {
     "properties": {
      "author_id": {
       "description": "WordPress author ID",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "category_id": {
       "description": "WordPress category ID",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "category_id",
      "author_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "domain",
   "mappings"
  ],
  "type": "object"
 },
 "name": "wordpress_set_mapping"
}

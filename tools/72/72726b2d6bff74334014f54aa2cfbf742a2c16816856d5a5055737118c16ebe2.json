{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Attaches a phone number to an SMI subject.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "extension": {
    "description": "The phone extension, if there is one.",
    "minLength": 1,
    "type": "string"
   },
   "phone": {
    "description": "The phone number to attach to the subject.",
    "minLength": 1,
    "pattern": "^[+\\d\\s().-]+$",
    "type": "string"
   },
   "subjectId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ],
    "description": "The subject's id, from a prior smi_get_subject or subject-enrichment call."
   }
  },
  "required": [
   "subjectId",
   "phone"
  ],
  "type": "object"
 },
 "name": "smi_add_subject_phone",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "recordId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   },
   "subjectId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   }
  },
  "required": [
   "subjectId"
  ],
  "type": "object"
 },
 "title": "Add Subject Phone Number"
}

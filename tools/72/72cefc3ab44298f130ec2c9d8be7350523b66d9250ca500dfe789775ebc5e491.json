{
 "description": "Before verifying a feature you just built from a ticket, plan its proof. Send the ticket first: Tada answers with what it knows about the app and the rules a proof must meet.\nThen write the proof yourself and send it back as proposal. Tada holds it to those rules, names anything missing, and walks its pages before anything runs.\nShow the plan to the developer and get their confirmation, then write each journey's steps and call verify_feature with the returned feature and journeys.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acceptanceCriteria": {
    "description": "One criterion per entry, as the ticket states them.",
    "items": {
     "maxLength": 400,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "changed": {
    "additionalProperties": false,
    "description": "The branch, and what you changed in a sentence or two.",
    "properties": {
     "branch": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "outOfScope": {
    "description": "What this ticket deliberately does not do.",
    "items": {
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "pages": {
    "description": "The pages this feature adds or changes.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "purpose": {
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      },
      "reachedBy": {
       "description": "How a person gets there by clicking, for example \"Settings \u203a Roles\".",
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "route": {
       "description": "The path, for example /settings/roles.",
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "route"
     ],
     "type": "object"
    },
    "maxItems": 40,
    "type": "array"
   },
   "proposal": {
    "additionalProperties": false,
    "description": "Your proof, once plan_feature has told you the rules. Leave out on the first call.",
    "properties": {
     "access": {
      "description": "permissions: who may see or do what once inside. sign_in: signing in and out. none: neither.",
      "enum": [
       "permissions",
       "sign_in",
       "none"
      ],
      "type": "string"
     },
     "journeys": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "as": {
         "anyOf": [
          {
           "maxLength": 40,
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "The role it runs as; null for the default login."
        },
        "covers": {
         "default": [],
         "description": "The acceptance criteria it proves, by number.",
         "items": {
          "type": "integer"
         },
         "maxItems": 30,
         "type": "array"
        },
        "kind": {
         "enum": [
          "setup",
          "invite",
          "can",
          "cant",
          "revoke",
          "direct_url",
          "check"
         ],
         "type": "string"
        },
        "name": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "needs": {
         "default": [],
         "description": "Journeys of this proof that must pass first, by name.",
         "items": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
         },
         "maxItems": 10,
         "type": "array"
        },
        "says": {
         "description": "What should happen and why.",
         "maxLength": 400,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "name",
        "as",
        "kind",
        "says"
       ],
       "type": "object"
      },
      "maxItems": 24,
      "minItems": 1,
      "type": "array"
     },
     "name": {
      "description": "The feature, named exactly as the ticket names it.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "notBrowserCheckable": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "covers": {
         "default": [],
         "items": {
          "type": "integer"
         },
         "maxItems": 30,
         "type": "array"
        },
        "what": {
         "maxLength": 300,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "what"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "type": "array"
     },
     "ticketRef": {
      "anyOf": [
       {
        "maxLength": 60,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "uses": {
      "description": "Other features this proof needs first, by name.",
      "items": {
       "maxLength": 200,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     }
    },
    "required": [
     "name",
     "ticketRef",
     "access",
     "journeys",
     "notBrowserCheckable",
     "uses"
    ],
    "type": "object"
   },
   "roles": {
    "description": "Who uses it, and what each may and may not do.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "can": {
       "default": [],
       "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "cannot": {
       "default": [],
       "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "name": {
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "setup": {
    "description": "What must exist first, for example \"a client named Acme Holding\".",
    "items": {
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "text": {
    "description": "The ticket description: what the feature should do and for whom.",
    "maxLength": 20000,
    "type": "string"
   },
   "ticket": {
    "description": "The ticket id as the tracker writes it, for example SOL-123.",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "description": "The ticket title, exactly as the tracker shows it.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "plan_feature"
}

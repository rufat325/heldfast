{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage comments on stories, features, decisions, documents. Methods: list, create, update, delete",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comment_id": {
    "description": "Comment ID (required for: update, delete)",
    "type": "string"
   },
   "content": {
    "description": "Comment text (required for: create, update)",
    "type": "string"
   },
   "entity_id": {
    "description": "Entity ID (required for: list, create)",
    "type": "string"
   },
   "entity_type": {
    "description": "Entity type (required for: list, create)",
    "enum": [
     "story",
     "feature",
     "decision",
     "document",
     "note"
    ],
    "type": "string"
   },
   "flat": {
    "description": "Flat list vs threaded tree (for: list)",
    "type": "boolean"
   },
   "mentions": {
    "description": "User IDs to @mention (for: create)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "create",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "parent_id": {
    "description": "Parent comment ID for threading (for: create)",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (for: list, create \u2014 auto-detected if omitted)",
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "comments"
}

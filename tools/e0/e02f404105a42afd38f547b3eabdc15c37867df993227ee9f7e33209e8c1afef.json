{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compute a midpoint composite chart for two people: a single chart describing\nthe relationship itself, built from the shorter-arc midpoints of the two natal\ncharts' positions and angles.\n\nBoth birth locations are required (the composite angles derive from each\nchart's Ascendant/Midheaven).\n\nExample:\n  - { datetime_a: \"1990-03-15T15:45\", timezone_a: \"Europe/Riga\",\n      latitude_a: 56.95, longitude_a: 24.11,\n      datetime_b: \"1992-07-22T08:30\", timezone_b: \"America/New_York\",\n      latitude_b: 40.71, longitude_b: -74.01 }",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "datetime_a": {
    "description": "Person A's birth date and time.",
    "minLength": 4,
    "type": "string"
   },
   "datetime_b": {
    "description": "Person B's birth date and time.",
    "minLength": 4,
    "type": "string"
   },
   "house_system": {
    "default": "whole-sign",
    "description": "House system: whole-sign (default), equal, porphyry, or placidus.",
    "enum": [
     "whole-sign",
     "equal",
     "porphyry",
     "placidus"
    ],
    "type": "string"
   },
   "latitude_a": {
    "description": "Person A's birth latitude.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "latitude_b": {
    "description": "Person B's birth latitude.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude_a": {
    "description": "Person A's birth longitude.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "longitude_b": {
    "description": "Person B's birth longitude.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "timezone_a": {
    "description": "IANA timezone the datetime is local to, e.g. \"Europe/Riga\" or \"America/New_York\". Omit when the datetime already carries Z or a UTC offset.",
    "minLength": 1,
    "type": "string"
   },
   "timezone_b": {
    "description": "IANA timezone the datetime is local to, e.g. \"Europe/Riga\" or \"America/New_York\". Omit when the datetime already carries Z or a UTC offset.",
    "minLength": 1,
    "type": "string"
   },
   "zodiac": {
    "default": "tropical",
    "description": "Zodiac frame: tropical (Western default), sidereal-lahiri (Vedic), or sidereal-fagan-bradley (Western sidereal).",
    "enum": [
     "tropical",
     "sidereal-lahiri",
     "sidereal-fagan-bradley"
    ],
    "type": "string"
   }
  },
  "required": [
   "datetime_a",
   "latitude_a",
   "longitude_a",
   "datetime_b",
   "latitude_b",
   "longitude_b"
  ],
  "type": "object"
 },
 "name": "compute_composite_chart",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "angle": {
       "type": "number"
      },
      "aspect": {
       "type": "string"
      },
      "body1": {
       "type": "string"
      },
      "body2": {
       "type": "string"
      },
      "orb": {
       "type": "number"
      }
     },
     "required": [
      "body1",
      "body2",
      "aspect",
      "angle",
      "orb"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "houses": {
    "additionalProperties": false,
    "properties": {
     "ascendant": {
      "type": "number"
     },
     "cusps": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "midheaven": {
      "type": "number"
     },
     "note": {
      "type": "string"
     },
     "system": {
      "type": "string"
     }
    },
    "required": [
     "system",
     "cusps",
     "ascendant",
     "midheaven"
    ],
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "positions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "declination": {
       "type": "number"
      },
      "degreeInSign": {
       "type": "number"
      },
      "latitude": {
       "type": "number"
      },
      "longitude": {
       "type": "number"
      },
      "retrograde": {
       "type": "boolean"
      },
      "sign": {
       "type": "string"
      },
      "speed": {
       "type": "number"
      }
     },
     "required": [
      "body",
      "longitude",
      "sign",
      "degreeInSign",
      "speed",
      "retrograde",
      "declination",
      "latitude"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "zodiac": {
    "type": "string"
   }
  },
  "required": [
   "zodiac",
   "positions",
   "houses",
   "aspects",
   "note"
  ],
  "type": "object"
 },
 "title": "Compute Composite Chart"
}

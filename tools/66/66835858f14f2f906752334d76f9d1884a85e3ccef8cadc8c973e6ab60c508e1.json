{
 "description": "Create an event (appointment), optionally attached to a matter or contact and with user hosts. Set send_invites: false to avoid emailing attendees.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "all_day": {
    "type": "boolean"
   },
   "description": {
    "type": "string"
   },
   "end_date": {
    "description": "End, ISO 8601 with offset.",
    "type": "string"
   },
   "event_type_id": {
    "type": "integer"
   },
   "eventable_id": {
    "type": "integer"
   },
   "eventable_type": {
    "description": "What the event is attached to. Use 'Prospect' for a matter.",
    "enum": [
     "Prospect",
     "Contact",
     "Client"
    ],
    "type": "string"
   },
   "location_id": {
    "type": "integer"
   },
   "name": {
    "description": "Event name, e.g. 'Initial Consultation'.",
    "type": "string"
   },
   "reminder_delay_length": {
    "type": "integer"
   },
   "reminder_type": {
    "enum": [
     "minutes",
     "hours",
     "days",
     "weeks",
     "months"
    ],
    "type": "string"
   },
   "send_invites": {
    "description": "Default true \u2014 Lawmatics emails invites unless set to false.",
    "type": "boolean"
   },
   "start_date": {
    "description": "Start, ISO 8601 with offset, e.g. 2026-08-15T15:00:00-07:00.",
    "type": "string"
   },
   "time_zone": {
    "description": "IANA time zone, e.g. America/New_York.",
    "type": "string"
   },
   "user_ids": {
    "description": "Host user IDs (from list-users).",
    "items": {
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "create-event"
}

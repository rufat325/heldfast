{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Whole-basket Website Express verdict for a set of product ids and quantities: every line must be eligible (no split shipments).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "items": {
    "description": "Basket lines as product ids with quantities.",
    "items": {
     "properties": {
      "id": {
       "description": "Product id from search/product tools.",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "quantity": {
       "default": 1,
       "maximum": 999,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "locale": {
    "description": "Storefront locale such as en-GB (default), en-US, de, fr-FR, es-ES, it-IT, nl-NL, pl. Controls product names, slugs and prices.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "check_express_eligibility",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "basket_eligible": {
    "type": "boolean"
   },
   "enabled": {
    "type": "boolean"
   },
   "express": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "available": {
        "type": "boolean"
       },
       "order_by_iso": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "promised_dispatch_date": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "same_day": {
        "type": "boolean"
       }
      },
      "required": [
       "available",
       "same_day",
       "order_by_iso",
       "promised_dispatch_date"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "lines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "eligible": {
       "type": "boolean"
      },
      "id": {
       "type": "number"
      },
      "reason": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Why a line is not eligible."
      },
      "sku": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "sku",
      "eligible",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "enabled",
   "basket_eligible",
   "express",
   "lines"
  ],
  "type": "object"
 },
 "title": "Check Website Express eligibility"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "After producer approval, update task status and optionally its due date. An explicit null clears the date; omission preserves it.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "due_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": [
     "string",
     "null"
    ]
   },
   "farm_id": {
    "format": "uuid",
    "type": "string"
   },
   "status": {
    "enum": [
     "TODO",
     "DONE",
     "CANCELLED"
    ],
    "type": "string"
   },
   "task_id": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "status"
  ],
  "type": "object"
 },
 "name": "update_farm_task"
}

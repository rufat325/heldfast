{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Schedule Item"
 },
 "description": "Add a run-of-show cue / schedule item to a live event \u2014 a time-blocked moment (lighting/sound/performance/transition/safety/\u2026) with start (and optional end), lane, cue number, project, talent. Requires event_id + title + start_at; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cue_number": {
    "maxLength": 40,
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "end_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "lane": {
    "maxLength": 80,
    "type": "string"
   },
   "notes": {
    "maxLength": 2000,
    "type": "string"
   },
   "project_id": {
    "maxLength": 128,
    "type": "string"
   },
   "start_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "talent_ids": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "title": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "enum": [
     "lighting",
     "sound",
     "video",
     "announce",
     "transition",
     "performance",
     "safety",
     "pyro",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "title",
   "start_at"
  ],
  "type": "object"
 },
 "name": "add_schedule_item",
 "title": "Add Schedule Item"
}

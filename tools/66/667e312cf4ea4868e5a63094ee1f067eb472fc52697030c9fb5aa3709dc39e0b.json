    "description": "The item's client ID, any listed. Item variants can share one.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "cursor": {
    "type": "string"
   },
   "damage_type": {

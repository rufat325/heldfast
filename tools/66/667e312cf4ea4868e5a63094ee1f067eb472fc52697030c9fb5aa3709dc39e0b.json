     "fire",
     "holy",
     "ice",
     "physical"
    ],
    "type": "string"
   },
   "defense_min": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "hands": {
    "enum": [
     "one",
     "two"
    ],
    "type": "string"
   },
   "imbuement_slots_min": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "include_inactive": {
    "default": false,
    "type": "boolean"
   },
   "is_pickupable": {
    "type": "boolean"
   },
   "is_stackable": {
    "type": "boolean"
   },
   "item_class": {
    "description": "e.g. \"Weapons\", \"Armors\".",
    "type": "string"
   },
   "item_type": {
    "description": "e.g. \"Sword Weapons\".",
    "type": "string"
   },
   "leech": {
    "description": "Leeches everything listed.",
    "items": {
     "enum": [
      "life",
      "mana"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "required_level_max": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "resistant_to": {
    "description": "Resists everything listed (resistance above 0).",
    "items": {
     "enum": [
      "physical",
      "earth",
      "fire",
      "ice",
      "energy",
      "death",
      "holy",
      "drown",
      "lifedrain",
      "manadrain",
      "critical_hit"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "skill_bonus": {
    "description": "Raises every listed skill.",
    "items": {
     "enum": [
      "magic_level",
      "sword",
      "axe",
      "club",
      "distance",
      "fist",
      "shielding"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "sort": {
    "default": "title",
    "description": "weight ascends, value, armor, attack and defense descend, title is alphabetical.",
    "enum": [
     "title",
     "weight",
     "value",
     "armor",
     "attack",
     "defense"
    ],
    "type": "string"
   },
   "vocation": {
    "description": "Matches required_vocation, e.g. \"knight\".",
    "type": "string"
   },
   "weapon_type": {
    "description": "e.g. \"Sword\", \"Axe\", \"Club\".",
    "type": "string"
   },
   "weight_max": {
    "description": "In oz. Items without a weight never match.",
    "type": "number"
   }
  },
  "type": "object"
 },

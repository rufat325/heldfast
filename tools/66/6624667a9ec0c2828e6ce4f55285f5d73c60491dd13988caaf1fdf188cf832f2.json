{
 "description": "Append a telemetry line to akis/YYYY-MM-DD.jsonl. No network.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "action": {
    "enum": [
     "read",
     "write",
     "search",
     "run",
     "decide",
     "wait"
    ],
    "type": "string"
   },
   "agent": {
    "minLength": 1,
    "type": "string"
   },
   "blocked": {
    "type": [
     "string",
     "null"
    ]
   },
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "job": {
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "maxLength": 200,
    "type": "string"
   },
   "status": {
    "enum": [
     "started",
     "running",
     "done",
     "error"
    ],
    "type": "string"
   },
   "touched": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "world": {
    "type": "string"
   }
  },
  "required": [
   "agent",
   "job",
   "action",
   "status"
  ],
  "type": "object"
 },
 "name": "event_report"
}

 "description": "Fetch observations for one Data360 series. DATABASE_ID selects the source database (e.g. WB_WDI), INDICATOR is the code from data360_search_indicators (e.g. WB_WDI_SP_POP_TOTL), REF_AREA is an ISO3 country code (e.g. BRA, USA). Returns SDMX-style records with OBS_VALUE, TIME_PERIOD, UNIT_MEASURE and disaggregation attributes (SEX, AGE, etc.). Omit TIME_PERIOD for the full series.",
 "inputSchema": {
  "examples": [
   {
    "DATABASE_ID": "WB_WDI",
    "INDICATOR": "WB_WDI_SP_POP_TOTL",
    "REF_AREA": "USA"
   },
   {
    "DATABASE_ID": "WB_WDI",
    "INDICATOR": "WB_WDI_NY_GDP_PCAP_CD",
    "REF_AREA": "BRA",
    "TIME_PERIOD": "2020"
   }
  ],
  "properties": {
   "DATABASE_ID": {
    "description": "Source database ID, e.g. \"WB_WDI\".",
    "type": "string"
   },
   "INDICATOR": {
    "description": "Indicator code, e.g. \"WB_WDI_SP_POP_TOTL\".",
    "type": "string"
   },
   "REF_AREA": {
    "description": "ISO3 country/region code, e.g. \"BRA\", \"USA\", \"WLD\".",
    "type": "string"
   },
   "TIME_PERIOD": {
    "description": "Optional single year, e.g. \"2020\".",
    "type": "string"
   },
   "skip": {
    "description": "Offset for pagination (default 0).",
    "type": "number"
   },
   "top": {
    "description": "Max observations to return (default 100).",
    "type": "number"
   }
  },
  "required": [
   "DATABASE_ID",
   "INDICATOR",
   "REF_AREA"
  ],
  "type": "object"
 },

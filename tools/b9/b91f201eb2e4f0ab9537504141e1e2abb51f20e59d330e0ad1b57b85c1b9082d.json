{
 "description": "IDA-style pattern scan with wildcards. Searches for byte patterns in PE sections.",
 "inputSchema": {
  "properties": {
   "file_path": {
    "description": "Path to PE file",
    "type": "string"
   },
   "max_results": {
    "description": "Max results (default 10)",
    "type": "number"
   },
   "pattern": {
    "description": "Pattern with wildcards (e.g. \"48 8B 05 ?? ?? ?? ?? 48 85 C0\")",
    "type": "string"
   },
   "section": {
    "description": "PE section to search (default: .text)",
    "type": "string"
   }
  },
  "required": [
   "file_path",
   "pattern"
  ],
  "type": "object"
 },
 "name": "pattern_scan"
}

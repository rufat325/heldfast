{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Capture browser console output (log/warn/error). Returns last N messages. Call to check for runtime errors and warnings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clear": {
    "description": "Clear the capture buffer",
    "type": "boolean"
   },
   "level": {
    "description": "Filter by level",
    "enum": [
     "log",
     "warn",
     "error"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max messages to return (default: 50)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "console_capture"
}

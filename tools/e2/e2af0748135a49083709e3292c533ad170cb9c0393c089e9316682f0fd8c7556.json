{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Turn product ids and quantities into one link that fills the shopper's basket on camdentools.com. Opening the link makes sure the basket holds at least those quantities (opening it twice does not double them); the shopper reviews the basket and pays at checkout themselves. The result says which lines are out of stock: those cannot be bought, so offer an alternative before sharing the link. Use it to finish a shopping conversation. Ids come from search_products, list_products or get_product.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "items": {
    "description": "Basket lines as product ids with quantities.",
    "items": {
     "properties": {
      "id": {
       "description": "Product id from search/product tools.",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "quantity": {
       "default": 1,
       "maximum": 999,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "locale": {
    "description": "Storefront locale such as en-GB (default), en-US, de, fr-FR, es-ES, it-IT, nl-NL, pl. Controls product names, slugs and prices.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "create_basket_link",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "currency": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "number"
      },
      "in_stock": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "sku": {
       "type": "string"
      },
      "stock_level": {
       "type": "number"
      },
      "unit_price": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "sku",
      "name",
      "quantity",
      "unit_price",
      "currency",
      "in_stock",
      "stock_level"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "out_of_stock_ids": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "unavailable_ids": {
    "description": "Product ids that were not found.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "url": {
    "description": "Fills the shopper's basket with these lines. Share it unchanged.",
    "type": "string"
   }
  },
  "required": [
   "url",
   "lines",
   "unavailable_ids",
   "out_of_stock_ids",
   "note"
  ],
  "type": "object"
 },
 "title": "Create a basket link"
}

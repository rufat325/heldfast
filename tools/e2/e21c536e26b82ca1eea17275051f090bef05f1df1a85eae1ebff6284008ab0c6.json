{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search"
 },
 "description": "Search FinTech Studios news for documents matching a query. Returns lightweight results ({id, title, url, published_at}); use `fetch` to retrieve a document's full text. Costs ~3 credits (call estimate_endpoint_costs for exact pricing).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "query": {
    "description": "Search query",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "results": {
    "description": "Matching documents, most recent first, syndicated duplicates collapsed",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "published_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search"
}

{
 "description": "Generate a minimal Minecraft mod JAR structure.",
 "inputSchema": {
  "properties": {
   "author": {
    "description": "Author name",
    "type": "string"
   },
   "description": {
    "description": "Mod description",
    "type": "string"
   },
   "loader": {
    "description": "Mod loader: fabric, forge, neoforge (default: fabric)",
    "type": "string"
   },
   "mc_version": {
    "description": "Minecraft version (default: 1.21.5)",
    "type": "string"
   },
   "mod_id": {
    "description": "Mod ID (lowercase, no spaces)",
    "type": "string"
   },
   "mod_name": {
    "description": "Mod display name",
    "type": "string"
   },
   "output_dir": {
    "description": "Output directory",
    "type": "string"
   }
  },
  "required": [
   "mod_name",
   "mod_id",
   "output_dir"
  ],
  "type": "object"
 },
 "name": "jar_scaffold_mod"
}

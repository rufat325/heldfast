{
 "description": "Confirm the exact current Project Work content hash in the App. Confirmation does not authorize execution, commit, push, publish, deploy, deletion, payment, or messaging.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "expectedContentSha256": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "expectedContentSha256",
   "confirmed"
  ],
  "type": "object"
 },
 "name": "granoflow_project_work_confirm"
}

{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Initiate an authorized outbound AI telephone call and return a call identifier immediately; completion and duration arrive asynchronously. Use when an authorized agent must contact a customer by telephone for a lawful, consent-aware objective and retrieve a structured result later.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "context": {
    "additionalProperties": {
     "maxLength": 500,
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "language": {
    "enum": [
     "en",
     "ar"
    ],
    "type": "string"
   },
   "maxDurationSeconds": {
    "default": 300,
    "maximum": 3600,
    "minimum": 1,
    "type": "integer"
   },
   "objective": {
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "phoneNumber": {
    "pattern": "^\\+[1-9]\\d{7,14}$",
    "type": "string"
   },
   "safety": {
    "properties": {
     "consentNotice": {
      "maxLength": 500,
      "type": "string"
     },
     "recording": {
      "default": false,
      "type": "boolean"
     },
     "timezone": {
      "maxLength": 100,
      "type": "string"
     },
     "transcription": {
      "default": false,
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "phoneNumber",
   "objective",
   "language"
  ],
  "type": "object"
 },
 "name": "ai_call_agent",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "answered": {
    "type": "boolean"
   },
   "callId": {
    "type": "string"
   },
   "completedAt": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "createdAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "durationSeconds": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "nextAction": {
    "type": [
     "string",
     "null"
    ]
   },
   "outcome": {
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "enum": [
     "created",
     "queued",
     "dialing",
     "ringing",
     "answered",
     "in_progress",
     "completed",
     "no_answer",
     "busy",
     "rejected",
     "failed",
     "cancelled"
    ],
    "type": "string"
   },
   "structuredFacts": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "summary": {
    "type": [
     "string",
     "null"
    ]
   },
   "transcript": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "at": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
       "type": "string"
      },
      "speaker": {
       "enum": [
        "agent",
        "customer"
       ],
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "speaker",
      "text",
      "at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "callId",
   "status",
   "answered",
   "durationSeconds",
   "outcome",
   "summary",
   "nextAction",
   "structuredFacts",
   "transcript",
   "createdAt",
   "completedAt"
  ],
  "type": "object"
 }
}

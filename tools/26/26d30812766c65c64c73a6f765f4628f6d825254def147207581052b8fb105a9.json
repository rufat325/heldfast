{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Explicit private life-graph export: favorites/VIP plus people with edges or recent event tags. Pass full=true for a larger capped list. Optional event\u2013people links. Requires OAuth or a supported scoped credential. ($0.25; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "event_links_limit": {
    "default": 25,
    "type": "number"
   },
   "full": {
    "default": false,
    "description": "Include additional people by last interaction, up to max_people",
    "type": "boolean"
   },
   "include_event_links": {
    "default": false,
    "type": "boolean"
   },
   "max_people": {
    "default": 80,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "get_life_graph",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "edge_count": {
    "type": "number"
   },
   "edges": {
    "items": {
     "additionalProperties": true,
     "description": "A relationship edge between people.",
     "type": "object"
    },
    "type": "array"
   },
   "event_people_links": {
    "items": {
     "additionalProperties": true,
     "description": "A recent event-to-person link.",
     "type": "object"
    },
    "type": "array"
   },
   "hot": {
    "type": "boolean"
   },
   "max_people_requested": {
    "type": "number"
   },
   "node_count": {
    "type": "number"
   },
   "nodes": {
    "items": {
     "additionalProperties": true,
     "description": "A Dayze person or contact record.",
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "hot",
   "node_count",
   "edge_count",
   "nodes",
   "edges"
  ],
  "type": "object"
 },
 "readOnlyHint": true,
 "securitySchemes": [
  {
   "scopes": [
    "context.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Life Graph Export"
}

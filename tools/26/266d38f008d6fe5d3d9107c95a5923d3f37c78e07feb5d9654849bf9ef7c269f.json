{
 "description": "Double tap at screen coordinates. Useful for zoom-in gestures and double-tap interactions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_id": {
    "description": "Device ID (optional if only one device)",
    "type": "string"
   },
   "interval_ms": {
    "default": 100,
    "description": "Interval between taps in ms (default 100)",
    "type": "number"
   },
   "x": {
    "description": "X coordinate",
    "type": "number"
   },
   "y": {
    "description": "Y coordinate",
    "type": "number"
   }
  },
  "required": [
   "x",
   "y"
  ],
  "type": "object"
 },
 "name": "double_tap"
}

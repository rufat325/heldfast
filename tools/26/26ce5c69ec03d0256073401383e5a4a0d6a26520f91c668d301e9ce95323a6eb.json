{
 "description": "Get comments on a LinkedIn post. Page-number pagination; stop when page is empty. 10 credits/page.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "page": {
    "description": "1-based page number. Stop when page returns empty.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "post_id": {
    "description": "Post ID or activity URN.",
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Post URL (alternative to post_id).",
    "format": "uri",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_linkedin_post_comments"
}

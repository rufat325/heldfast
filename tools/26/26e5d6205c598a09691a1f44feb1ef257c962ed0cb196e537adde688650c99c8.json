{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set Community Signup Form"
 },
 "description": "Replace a community's signup form \u2014 questions, live or not, optional name. A live form is required before joining. Pass question ids to keep answers mapped. Requires community_id + questions + enabled; creator or admin.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "community_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "enabled": {
    "type": "boolean"
   },
   "name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "questions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "canonical_key": {
       "anyOf": [
        {
         "maxLength": 120,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "maxLength": 128,
       "type": "string"
      },
      "label": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "options": {
       "items": {
        "maxLength": 300,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "placeholder": {
       "maxLength": 300,
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "type": {
       "enum": [
        "text",
        "textarea",
        "select",
        "multiSelect",
        "email",
        "phone",
        "url",
        "number"
       ],
       "type": "string"
      }
     },
     "required": [
      "label",
      "type"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "type": "array"
   }
  },
  "required": [
   "community_id",
   "questions",
   "enabled"
  ],
  "type": "object"
 },
 "name": "set_community_signup_form",
 "title": "Set Community Signup Form"
}

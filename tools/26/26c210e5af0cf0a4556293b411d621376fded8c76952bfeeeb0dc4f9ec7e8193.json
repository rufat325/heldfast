{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Knowledge-base operations: create (with documents), list, delete, query (smart retrieval).",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Operation",
    "enum": [
     "create",
     "list",
     "delete",
     "query"
    ],
    "type": "string"
   },
   "description": {
    "description": "KB description (create)",
    "type": "string"
   },
   "documents": {
    "description": "Documents to index (create)",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "kbId": {
    "description": "KB ID (delete/query)",
    "type": "string"
   },
   "limit": {
    "description": "Max results (query)",
    "type": "number"
   },
   "name": {
    "description": "KB name (create)",
    "type": "string"
   },
   "query": {
    "description": "Query text (query)",
    "type": "string"
   },
   "slug": {
    "description": "KB slug (create/query)",
    "type": "string"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   }
  },
  "required": [
   "spaceId",
   "action"
  ],
  "type": "object"
 },
 "name": "knowledge",
 "outputSchema": {
  "properties": {},
  "type": "object"
 }
}

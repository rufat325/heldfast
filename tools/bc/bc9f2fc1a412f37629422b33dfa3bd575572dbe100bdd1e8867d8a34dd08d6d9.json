{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Translate and dub audio into a different language, cloning the original speaker's voice. COST: 1 credit per 2 seconds. WORKFLOW: Returns task_id \u2192 poll or use wait_for_runway_task.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audio": {
    "description": "Audio file to dub. HTTPS URL or local file path.",
    "type": "string"
   },
   "disable_voice_cloning": {
    "description": "Use generic voice instead of cloning. Default: false.",
    "type": "boolean"
   },
   "drop_background_audio": {
    "description": "Remove background audio/music. Default: false.",
    "type": "boolean"
   },
   "num_speakers": {
    "description": "Number of speakers. Auto-detected if not specified.",
    "type": "integer"
   },
   "target_language": {
    "description": "Target language code (e.g., \"es\" for Spanish).",
    "enum": [
     "en",
     "hi",
     "pt",
     "zh",
     "es",
     "fr",
     "de",
     "ja",
     "ar",
     "ru",
     "ko",
     "id",
     "it",
     "nl",
     "tr",
     "pl",
     "sv",
     "fil",
     "ms",
     "ro",
     "uk",
     "el",
     "cs",
     "da",
     "fi",
     "bg",
     "hr",
     "sk",
     "ta"
    ],
    "type": "string"
   }
  },
  "required": [
   "audio",
   "target_language"
  ],
  "type": "object"
 },
 "name": "dub_audio"
}

{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs Oxlint and returns structured diagnostics (file, line, column, rule, severity, message).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allow": {
    "description": "Rules to allow (disable) (maps to -A)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "config": {
    "description": "Path to Oxlint configuration file (maps to --config)",
    "maxLength": 4096,
    "type": "string"
   },
   "deny": {
    "description": "Rules to deny (error level) (maps to -D)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "fix": {
    "description": "Auto-fix problems (maps to --fix)",
    "type": "boolean"
   },
   "fixSuggestions": {
    "description": "Apply suggestion-level fixes (maps to --fix-suggestions)",
    "type": "boolean"
   },
   "ignorePath": {
    "description": "Path to an alternate ignore file (maps to --ignore-path)",
    "maxLength": 4096,
    "type": "string"
   },
   "noIgnore": {
    "description": "Disable ignore patterns (maps to --no-ignore)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "."
    ],
    "description": "File patterns to lint (default: ['.'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "plugins": {
    "description": "Plugin categories to enable (e.g., 'import', 'jest', 'jsx-a11y') (maps to --<plugin>-plugin)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "quiet": {
    "description": "Report errors only, suppress warnings (maps to --quiet)",
    "type": "boolean"
   },
   "threads": {
    "description": "Number of threads to use for parallel linting",
    "type": "number"
   },
   "tsconfig": {
    "description": "Path to tsconfig.json for type-aware rules (maps to --tsconfig)",
    "maxLength": 4096,
    "type": "string"
   },
   "warn": {
    "description": "Rules to warn on (maps to -W)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "oxlint",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deprecationCount": {
    "type": "number"
   },
   "deprecations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reference": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "severity",
      "rule",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnosticsTruncated": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "errors": {
    "type": "number"
   },
   "exitCode": {
    "type": "number"
   },
   "filesChecked": {
    "type": "number"
   },
   "fixableErrorCount": {
    "type": "number"
   },
   "fixableWarningCount": {
    "type": "number"
   },
   "omittedCount": {
    "type": "number"
   },
   "warnings": {
    "type": "number"
   }
  },
  "required": [
   "errors",
   "warnings",
   "filesChecked"
  ],
  "type": "object"
 },
 "title": "Oxlint Check"
}

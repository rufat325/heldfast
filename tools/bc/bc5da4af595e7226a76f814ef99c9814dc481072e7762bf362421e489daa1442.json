{
 "description": "Update a task \u2014 e.g. mark it done, change the due date, or reassign it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "done": {
    "type": "boolean"
   },
   "due_date": {
    "description": "ISO 8601 date or datetime.",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "priority": {
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "task_id": {
    "description": "The task ID to update.",
    "type": "string"
   },
   "user_ids": {
    "items": {
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "task_id"
  ],
  "type": "object"
 },
 "name": "update-task"
}

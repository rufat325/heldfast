{
 "description": "Saves a quote and returns a marketplace Quote ID, for a specific provider. This tool BOOKS a provider -- it does not discover one. Before calling, call list_service_providers (needs only the move date and loading ZIP; optionally accepts labor hours, crew size, sort order, service type, flights of stairs, and resultFormat) to find available providers, then take the chosen provider's location id from that result and pass it as workerLocationID. The input schema marks workerLocationID as optional, but a marketplace quote cannot be created without it -- omitting it returns a 400 (\"WorkerLocationID must be between 1 and 2147483647\"). Takes the full create-quote request and returns the raw result.",
 "execution": {
  "taskSupport": "optional"
 },
 "inputSchema": {
  "properties": {
   "body": {
    "description": "The marketplace create-quote request body",
    "properties": {
     "contactInformation": {
      "properties": {
       "emailAddress": {
        "maxLength": 300,
        "type": "string"
       },
       "firstName": {
        "maxLength": 50,
        "type": "string"
       },
       "lastName": {
        "maxLength": 50,
        "type": "string"
       },
       "phoneNumber": {
        "type": "string"
       },
       "secondaryPhoneNumber": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "emailAddress",
       "phoneNumber",
       "firstName",
       "lastName"
      ],
      "type": "object"
     },
     "customReference": {
      "maxLength": 100,
      "type": [
       "string",
       "null"
      ]
     },
     "heavyItems": {
      "items": {
       "properties": {
        "itemType": {
         "enum": [
          "Unknown",
          "ItemBetweenThreeAndFourFifty",
          "ItemBetweenFourFiftyAndSix",
          "ItemsSixPlus",
          "Pianos"
         ],
         "type": "string"
        },
        "quantity": {
         "maximum": 100,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "itemType"
       ],
       "type": "object"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "load": {
      "properties": {
       "address": {
        "properties": {
         "city": {
          "maxLength": 50,
          "minLength": 1,
          "type": "string"
         },
         "state": {
          "maxLength": 2,
          "minLength": 1,
          "type": "string"
         },
         "street": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
         },
         "streetLineTwo": {
          "maxLength": 50,
          "type": [
           "string",
           "null"
          ]
         },
         "zip": {
          "maxLength": 5,
          "minLength": 5,
          "type": "string"
         }
        },
        "required": [
         "street",
         "city",
         "state",
         "zip"
        ],
        "type": "object"
       },
       "crewSize": {
        "maximum": 12,
        "minimum": 1,
        "type": "integer"
       },
       "desiredArrivalWindow": {
        "type": "string"
       },
       "flightsOfStairs": {
        "maximum": 20,
        "minimum": 0,
        "type": [
         "integer",
         "null"
        ]
       },
       "laborHours": {
        "maximum": 50,
        "minimum": 2,
        "type": "number"
       },
       "notes": {
        "maxLength": 6000,
        "type": [
         "string",
         "null"
        ]
       },
       "requestedDate": {
        "type": "string"
       },
       "workerLocationID": {
        "maximum": 2147483647,
        "minimum": 1,
        "type": [
         "integer",
         "null"
        ]
       }
      },
      "required": [
       "address",
       "desiredArrivalWindow",
       "requestedDate"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "serviceType": {
      "enum": [
       "Unknown",
       "Standard",
       "Elite",
       "MoversPlusTruck",
       "Transport",
       "HybridZS",
       "Container",
       "FreightTrailer",
       "CarShipping",
       "TruckRental",
       "ManagedLaborHourly",
       "ManagedLaborPlus",
       "CorporateRelocation_LaborOnly",
       "CorporateRelocation_LocalFullService"
      ],
      "type": "string"
     },
     "transports": {
      "properties": {
       "areWeMovingContainer": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "areWeMovingFreightTrailer": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "areWeMovingRentalTruck": {
        "type": [
         "boolean",
         "null"
        ]
       }
      },
      "type": [
       "object",
       "null"
      ]
     },
     "unload": {
      "properties": {
       "address": {
        "$ref": "#/properties/body/properties/load/properties/address"
       },
       "crewSize": {
        "maximum": 12,
        "minimum": 1,
        "type": "integer"
       },
       "desiredArrivalWindow": {
        "type": "string"
       },
       "flightsOfStairs": {
        "maximum": 20,
        "minimum": 0,
        "type": [
         "integer",
         "null"
        ]
       },
       "laborHours": {
        "maximum": 50,
        "minimum": 2,
        "type": "number"
       },
       "notes": {
        "maxLength": 6000,
        "type": [
         "string",
         "null"
        ]
       },
       "requestedDate": {
        "type": "string"
       },
       "workerLocationID": {
        "maximum": 2147483647,
        "minimum": 1,
        "type": [
         "integer",
         "null"
        ]
       }
      },
      "required": [
       "address",
       "desiredArrivalWindow",
       "requestedDate"
      ],
      "type": [
       "object",
       "null"
      ]
     }
    },
    "required": [
     "contactInformation",
     "serviceType"
    ],
    "type": "object"
   }
  },
  "required": [
   "body"
  ],
  "type": "object"
 },
 "name": "create_marketplace_quote"
}

{
 "annotations": {
  "openWorldHint": true,
  "title": "Categorize pages"
 },
 "description": "AI-suggest a WordPress category for 1-50 pages based on content. Free. Saves the assigned category on each page. Requires a category-author mapping (wordpress_set_mapping) to exist for the domain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "page_ids": {
    "description": "Page UUIDs (1 to 50)",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "wordpress_domain": {
    "description": "WordPress domain (e.g. example.com)",
    "type": "string"
   }
  },
  "required": [
   "page_ids",
   "wordpress_domain"
  ],
  "type": "object"
 },
 "name": "categorize_pages"
}

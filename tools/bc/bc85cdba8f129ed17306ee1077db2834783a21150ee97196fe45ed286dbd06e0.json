{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage projects. Methods: list (all projects), list_read (with stats), create, update, resolve (auto-detect from cwd), get_context (full snapshot)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Project description (for: create, update)",
    "type": "string"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "list_read",
     "create",
     "update",
     "resolve",
     "get_context"
    ],
    "type": "string"
   },
   "name": {
    "description": "Project name (required for: create)",
    "type": "string"
   },
   "path": {
    "description": "Path to resolve project from (for: resolve)",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (for: update, get_context)",
    "type": "string"
   },
   "project_key": {
    "description": "Short key like VP (for: create, update)",
    "type": "string"
   },
   "repo_path": {
    "description": "Repository path (for: create, update)",
    "type": "string"
   },
   "status": {
    "description": "Filter by status (for: list, list_read)",
    "enum": [
     "active",
     "paused",
     "completed",
     "archived"
    ],
    "type": "string"
   },
   "tech_stack": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Tech stack map (for: create, update)",
    "type": "object"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "projects"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get current FX rates for African currencies against a base currency",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "base_currency": {
    "default": "USD",
    "description": "Base currency (3-letter code)",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "country_code": {
    "description": "Filter by country",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Max results",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "quote_currencies": {
    "description": "Comma-separated quote currencies (e.g. \"NGN,KES,ZAR\")",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_fx_rates"
}

{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find UI Element"
 },
 "description": "Find UI elements on screen by text, resource ID, class name, or content description. Returns matching elements with their tap coordinates. At least one search criterion must be provided.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "className": {
    "description": "Class name to match exactly (e.g., 'android.widget.Button')",
    "type": "string"
   },
   "contentDesc": {
    "description": "Content description to search for (partial match, case-insensitive)",
    "type": "string"
   },
   "resourceId": {
    "description": "Resource ID to match exactly (e.g., 'com.app:id/button')",
    "type": "string"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   },
   "text": {
    "description": "Text content to search for (partial match, case-insensitive)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ui_find_element",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Number of matching elements",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "elements": {
    "description": "Matching UI elements with tap coordinates",
    "items": {
     "additionalProperties": false,
     "properties": {
      "bounds": {
       "description": "Raw bounds string [x1,y1][x2,y2]",
       "type": "string"
      },
      "className": {
       "description": "Widget class name",
       "type": "string"
      },
      "clickable": {
       "description": "Whether the element is clickable",
       "type": "boolean"
      },
      "contentDesc": {
       "description": "Content description (accessibility label)",
       "type": "string"
      },
      "resourceId": {
       "description": "Resource ID of the element",
       "type": "string"
      },
      "tapX": {
       "description": "X coordinate of the element center",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "tapY": {
       "description": "Y coordinate of the element center",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "text": {
       "description": "Visible text of the element",
       "type": "string"
      }
     },
     "required": [
      "text",
      "resourceId",
      "className",
      "contentDesc",
      "bounds",
      "tapX",
      "tapY",
      "clickable"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "elements"
  ],
  "type": "object"
 }
}

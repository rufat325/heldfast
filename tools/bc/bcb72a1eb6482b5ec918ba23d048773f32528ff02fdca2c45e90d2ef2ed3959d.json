   },
   "type": {
    "enum": [
     "line",
     "bar",
     "horizontalBar",
     "area",
     "pie",
     "doughnut",
     "gauge",
     "scatter",
     "bubble",
     "radar",
     "funnel",
     "stackedBar",
     "stackedBar100",
     "stackedArea100",
     "groupedBar",
     "multiLine",
     "mixed"
    ],
    "type": "string"
   },
   "width": {
    "default": 800,
    "maximum": 4000,
    "minimum": 100,
    "type": "number"
   }
  },
  "required": [

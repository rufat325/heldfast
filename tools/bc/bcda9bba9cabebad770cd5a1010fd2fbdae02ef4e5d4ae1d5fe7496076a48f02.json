{
 "description": "Start recording the simulator screen to a video file. Use simulator_stop_recording to stop. Supports H.264 and HEVC codecs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "codec": {
    "description": "Video codec (default: h264)",
    "enum": [
     "h264",
     "hevc"
    ],
    "type": "string"
   },
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "display": {
    "description": "Display to capture (default: internal)",
    "enum": [
     "internal",
     "external"
    ],
    "type": "string"
   },
   "mask": {
    "description": "For non-rectangular displays, handle mask by policy",
    "enum": [
     "ignored",
     "alpha",
     "black"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "simulator_record_video"
}

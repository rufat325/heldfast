{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Poll and wait until an entity reaches a specific spatial state (exists, becomes active, confidence exceeds threshold, or enters region).",
 "inputSchema": {
  "properties": {
   "condition": {
    "description": "Condition to wait for",
    "enum": [
     "exists",
     "active",
     "confidence_above",
     "in_region"
    ],
    "type": "string"
   },
   "entity_id": {
    "description": "Entity ID to monitor",
    "type": "string"
   },
   "poll_interval_ms": {
    "description": "Polling interval in milliseconds (default: 250)",
    "type": "number"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   },
   "region_id": {
    "description": "Target region ID for in_region condition",
    "type": "string"
   },
   "threshold": {
    "description": "Confidence threshold (default: 0.8)",
    "type": "number"
   },
   "timeout_ms": {
    "description": "Timeout in milliseconds (default: 10000)",
    "type": "number"
   }
  },
  "required": [
   "entity_id",
   "condition"
  ],
  "type": "object"
 },
 "name": "wait_for_spatial_state"
}

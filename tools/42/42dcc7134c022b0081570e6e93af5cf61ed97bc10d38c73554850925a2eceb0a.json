{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a video entirely from a text description. MODELS: gen4.5 (flagship), veo3.1 (best + audio), veo3.1_fast, veo3 (deprecated upstream). WORKFLOW: Returns task_id \u2192 poll or use wait_for_runway_task.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audio": {
    "description": "Generate audio (veo models only). Default: true.",
    "type": "boolean"
   },
   "content_moderation": {
    "description": "Public figure threshold.",
    "enum": [
     "auto",
     "low"
    ],
    "type": "string"
   },
   "duration": {
    "description": "Seconds. gen4.5: 2-10 (default 5). veo: 4,6,8 (default 8).",
    "type": "number"
   },
   "model": {
    "description": "Default: gen4.5.",
    "enum": [
     "gen4.5",
     "veo3.1",
     "veo3.1_fast",
     "veo3"
    ],
    "type": "string"
   },
   "negative_prompt": {
    "description": "What should NOT appear in the output (veo models only, max 1000 chars). Omit to use the default negative prompt.",
    "maxLength": 1000,
    "type": "string"
   },
   "prompt_text": {
    "description": "Detailed video description. Max 1000 chars.",
    "maxLength": 1000,
    "type": "string"
   },
   "ratio": {
    "description": "Output resolution. Default: 1280:720.",
    "enum": [
     "1280:720",
     "720:1280"
    ],
    "type": "string"
   },
   "seed": {
    "description": "Random seed (0-4294967295).",
    "type": "integer"
   }
  },
  "required": [
   "prompt_text"
  ],
  "type": "object"
 },
 "name": "generate_video_from_text"
}

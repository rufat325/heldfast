{
 "description": "Create a Wan task on RunAPI (edit video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "type": "string"
   },
   "audio": {
    "type": "boolean"
   },
   "audio_setting": {
    "type": "string"
   },
   "callback_url": {
    "type": "string"
   },
   "duration_seconds": {
    "type": "number"
   },
   "enable_prompt_expansion": {
    "type": "boolean"
   },
   "enable_safety_checker": {
    "type": "boolean"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "wan-2.6-edit-video",
     "wan-2.6-flash-edit-video",
     "wan-2.7-edit-video"
    ],
    "type": "string"
   },
   "multi_shots": {
    "type": "boolean"
   },
   "negative_prompt": {
    "type": "string"
   },
   "output_resolution": {
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "reference_image_url": {
    "type": "string"
   },
   "seed": {
    "type": "number"
   },
   "source_video_url": {
    "type": "string"
   },
   "source_video_urls": {
    "items": {},
    "type": "array"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   },
   "watermark": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "edit_video"
}

{
 "description": "Create a discount code",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appliesOncePerCustomer": {
    "type": "boolean"
   },
   "code": {
    "type": "string"
   },
   "customerGets": {
    "additionalProperties": false,
    "properties": {
     "items": {
      "enum": [
       "all",
       "products",
       "collections"
      ],
      "type": "string"
     },
     "value": {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "type": "string"
       },
       "percentage": {
        "type": "number"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "value"
    ],
    "type": "object"
   },
   "customerSelection": {
    "default": "all",
    "enum": [
     "all",
     "customer_segments"
    ],
    "type": "string"
   },
   "endsAt": {
    "type": "string"
   },
   "minimumRequirement": {
    "additionalProperties": false,
    "properties": {
     "quantity": {
      "type": "number"
     },
     "subtotal": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "startsAt": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "usageLimit": {
    "type": "number"
   }
  },
  "required": [
   "title",
   "code",
   "customerGets"
  ],
  "type": "object"
 },
 "name": "createDiscountCode"
}

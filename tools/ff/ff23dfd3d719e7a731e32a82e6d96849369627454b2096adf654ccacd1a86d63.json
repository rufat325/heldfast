 "description": "Search EPA-regulated facilities by name, state, ZIP code, city, or industry code. facility_name uses a case-insensitive starts-with match; prepend % for a contains search (e.g., \"%Exxon%\" finds any facility with \"Exxon\" in its name). Combine at least two filters \u2014 a bare state is rejected upstream for large states ({state: \"TX\"} alone matches ~344,000 facilities and errors). Good queries: {facility_name: \"%Exxon%\", state: \"TX\"}, {city: \"Baytown\", state: \"TX\"}, {zip: \"94025\"}, {naics: \"3251\", state: \"TX\"}. Returns facility IDs, addresses, lat/long, compliance status, inspection/enforcement counts, and total penalties.",
 "inputSchema": {
  "examples": [
   {
    "facility_name": "Steel Mill",
    "limit": 20,
    "state": "PA"
   },
   {
    "city": "Houston",
    "limit": 50,
    "naics": "3211",
    "state": "TX"
   }
  ],
  "properties": {
   "city": {
    "description": "City name (e.g., \"Baytown\").",
    "type": "string"
   },
   "facility_name": {
    "description": "Facility name \u2014 starts-with match by default; use % wildcard for contains search, e.g., \"%Exxon%\" or \"%Baytown%\".",
    "type": "string"
   },
   "limit": {
    "description": "Max results to return (default 20, max 100).",
    "type": "number"
   },
   "naics": {
    "description": "NAICS industry code, 2-6 digits \u2014 prefix match (e.g., \"3251\" = basic chemical manufacturing). Pair with state; alone it matches too many facilities.",
    "type": "string"
   },
   "state": {
    "description": "Two-letter state abbreviation (e.g., \"TX\").",
    "type": "string"
   },
   "zip": {
    "description": "ZIP code.",
    "type": "string"
   }
  },
  "type": "object"
 },

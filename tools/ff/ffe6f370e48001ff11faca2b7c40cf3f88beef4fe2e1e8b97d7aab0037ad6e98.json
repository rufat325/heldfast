{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Manage scheduled backups for a database. Actions: list, create, update, delete (backup schedules), list_executions, delete_execution. create/update take frequency (cron expression) plus optional fields (enabled, save_s3, s3_storage_uuid, databases_to_backup, dump_all, retention settings via extra).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "create",
     "update",
     "delete",
     "list_executions",
     "delete_execution"
    ],
    "type": "string"
   },
   "databases_to_backup": {
    "type": "string"
   },
   "dump_all": {
    "type": "boolean"
   },
   "enabled": {
    "type": "boolean"
   },
   "execution_uuid": {
    "description": "Required for delete_execution",
    "type": "string"
   },
   "extra": {
    "additionalProperties": {},
    "description": "Additional backup fields (retention settings, backup_now, ...)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "frequency": {
    "description": "Cron expression, e.g. '0 0 * * *'",
    "type": "string"
   },
   "s3_storage_uuid": {
    "type": "string"
   },
   "save_s3": {
    "type": "boolean"
   },
   "scheduled_backup_uuid": {
    "description": "Required for update, delete, list_executions, delete_execution",
    "type": "string"
   },
   "uuid": {
    "description": "Database UUID",
    "type": "string"
   }
  },
  "required": [
   "uuid",
   "action"
  ],
  "type": "object"
 },
 "name": "databaseBackups",
 "title": "Manage database backups"
}

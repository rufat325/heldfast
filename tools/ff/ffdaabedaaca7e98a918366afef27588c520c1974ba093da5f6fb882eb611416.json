{
 "description": "Update a rule's name, severity, config, description, or fix_hint (rule IDs via get_rule_set).",
 "inputSchema": {
  "properties": {
   "config": {
    "description": "New condition-specific config",
    "type": "object"
   },
   "description": {
    "type": "string"
   },
   "fix_hint": {
    "description": "Shown on failure",
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "severity": {
    "enum": [
     "error",
     "warning",
     "info"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_rule"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new floating IP. Either home_location or server must be provided.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "Description of the floating IP",
    "type": "string"
   },
   "home_location": {
    "description": "Home location name (e.g. \"fsn1\"). Required if server is not set",
    "type": "string"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Labels as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Name of the floating IP",
    "type": "string"
   },
   "server": {
    "description": "Server ID to assign the floating IP to. Required if home_location is not set",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "type": {
    "description": "IP type",
    "enum": [
     "ipv4",
     "ipv6"
    ],
    "type": "string"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "hetzner_create_floating_ip",
 "title": "Create Floating IP"
}

{
 "description": "Vote to corroborate or refute an attestation. Acts as the identity in the local credential store.",
 "inputSchema": {
  "properties": {
   "attestation_id": {
    "description": "Attestation id",
    "type": "string"
   },
   "comment": {
    "description": "Optional reasoning (public)",
    "type": "string"
   },
   "signature": {
    "description": "Ed25519 signature of (attestation_id + vote), base64",
    "type": "string"
   },
   "vote": {
    "description": "\"corroborate\" or \"refute\"",
    "type": "string"
   }
  },
  "required": [
   "attestation_id",
   "vote",
   "signature"
  ],
  "type": "object"
 },
 "name": "agent_corroborate"
}

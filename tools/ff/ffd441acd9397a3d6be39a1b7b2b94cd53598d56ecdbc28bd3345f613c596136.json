{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Poll, wait on, cancel or list long-running crosspad tasks (build, flash, hil_run, capture, stimulus, submodule_update). Task handles are task_<n>; results are kept 1 h after completion. Use this when your client does not support the MCP tasks capability.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "status: one task; wait: block until it finishes; cancel: stop it; list: every task this session",
    "enum": [
     "status",
     "wait",
     "cancel",
     "list"
    ],
    "type": "string"
   },
   "task": {
    "description": "Task handle (task_<n>). Required for status, wait and cancel; ignored by list",
    "pattern": "^task_\\d+$",
    "type": "string"
   },
   "timeout_ms": {
    "default": 30000,
    "description": "wait only: how long to block before returning the current status (max 600000)",
    "maximum": 600000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "crosspad_task",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cancelled": {
    "type": "boolean"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "hint": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "success": {
    "type": "boolean"
   },
   "task": {
    "additionalProperties": false,
    "properties": {
     "daemonTask": {
      "type": "string"
     },
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "message": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "finishedAt": {
      "type": "number"
     },
     "kind": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "progress": {
      "type": "number"
     },
     "result": {},
     "startedAt": {
      "type": "number"
     },
     "status": {
      "enum": [
       "working",
       "completed",
       "failed",
       "cancelled"
      ],
      "type": "string"
     },
     "task": {
      "type": "string"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "task",
     "kind",
     "status",
     "startedAt"
    ],
    "type": "object"
   },
   "tasks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "daemonTask": {
       "type": "string"
      },
      "error": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "message"
       ],
       "type": "object"
      },
      "finishedAt": {
       "type": "number"
      },
      "kind": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "progress": {
       "type": "number"
      },
      "result": {},
      "startedAt": {
       "type": "number"
      },
      "status": {
       "enum": [
        "working",
        "completed",
        "failed",
        "cancelled"
       ],
       "type": "string"
      },
      "task": {
       "type": "string"
      },
      "total": {
       "type": "number"
      }
     },
     "required": [
      "task",
      "kind",
      "status",
      "startedAt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 }
}

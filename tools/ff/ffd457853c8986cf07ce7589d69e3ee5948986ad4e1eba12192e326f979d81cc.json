{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Cancels a paid, confirmed booking using the cancel_token from its payment receipt. Within 60 minutes of paying, or before the business's refund window, the payment is refunded in full; after that the deposit is forfeited under the booking's policy (the result says which). Only the agent that paid holds the token. Cancelling twice answers already_cancelled.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cancel_token": {
    "description": "The cancel_token from the payment receipt",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "reservation_id": {
    "description": "The paid reservation's id",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "slug": {
    "description": "Business slug identifier",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug",
   "reservation_id",
   "cancel_token"
  ],
  "type": "object"
 },
 "name": "cancel_booking",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currency": {
    "type": "string"
   },
   "refund": {
    "description": "full: refunded to the payment method; none: the deposit was forfeited under the policy",
    "enum": [
     "full",
     "none"
    ],
    "type": "string"
   },
   "refunded_cents": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "reservation_id": {
    "type": "string"
   },
   "status": {
    "const": "cancelled",
    "type": "string"
   }
  },
  "required": [
   "status",
   "reservation_id",
   "refund",
   "refunded_cents",
   "currency"
  ],
  "type": "object"
 },
 "title": "Cancel Paid Booking"
}

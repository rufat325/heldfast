{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Ticket Tier"
 },
 "description": "Add a ticket tier to a live event you manage \u2014 free RSVP (price 0) or paid, with capacity, optional approval, or a secret unlock code. Paid tiers need Stripe connected. Requires event_id; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capacity": {
    "exclusiveMinimum": 0,
    "maximum": 10000000,
    "type": "integer"
   },
   "description": {
    "maxLength": 1000,
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "max_per_person": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "price": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "requires_approval": {
    "type": "boolean"
   },
   "secret": {
    "type": "boolean"
   }
  },
  "required": [
   "event_id",
   "name",
   "price",
   "capacity"
  ],
  "type": "object"
 },
 "name": "add_ticket_tier",
 "title": "Add Ticket Tier"
}

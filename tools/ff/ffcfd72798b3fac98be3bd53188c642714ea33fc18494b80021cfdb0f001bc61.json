{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List all servers in the project, with optional filtering by name, label, or status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "label_selector": {
    "description": "Label filter, e.g. \"env=prod,tier=web\"",
    "type": "string"
   },
   "name": {
    "description": "Filter by server name",
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Results per page (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Filter by server status",
    "enum": [
     "running",
     "initializing",
     "starting",
     "stopping",
     "off",
     "deleting",
     "migrating",
     "rebuilding",
     "unknown"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "hetzner_list_servers",
 "title": "List Servers"
}

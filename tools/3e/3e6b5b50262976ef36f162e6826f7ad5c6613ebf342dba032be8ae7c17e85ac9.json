{
 "description": "Claim accumulated creator fees for a token on a specific chain. First use printr_get_creator_fees to check available fees, then call this to claim. Uses the treasury wallet to sign and submit the claim transaction. Returns the transaction hash/signature on success.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chain": {
    "description": "CAIP-2 chain ID to claim fees on (e.g., 'solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp')",
    "type": "string"
   },
   "token_id": {
    "description": "Telecoin ID (hex) or CAIP-10 token address",
    "type": "string"
   }
  },
  "required": [
   "token_id",
   "chain"
  ],
  "type": "object"
 },
 "name": "printr_claim_fees",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "description": "Chain where fees were claimed",
    "type": "string"
   },
   "claimed_amount_native": {
    "description": "Amount claimed in native token (atomic)",
    "type": "string"
   },
   "claimed_amount_usd": {
    "description": "Amount claimed in USD",
    "type": "number"
   },
   "native_symbol": {
    "description": "Native token symbol",
    "type": "string"
   },
   "token_id": {
    "description": "Telecoin ID",
    "type": "string"
   },
   "tx_hash": {
    "description": "EVM transaction hash",
    "type": "string"
   },
   "tx_signature": {
    "description": "Solana transaction signature",
    "type": "string"
   }
  },
  "required": [
   "token_id",
   "chain",
   "claimed_amount_usd",
   "claimed_amount_native",
   "native_symbol"
  ],
  "type": "object"
 }
}

{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Turns auto layout on for a frame and sets its direction, spacing, padding and alignment. Pass mode \"NONE\" to turn it off. Only the properties you name are changed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "counterAxisAlignItems": {
    "description": "Alignment across the layout direction.",
    "enum": [
     "MIN",
     "CENTER",
     "MAX",
     "BASELINE"
    ],
    "type": "string"
   },
   "itemSpacing": {
    "description": "Gap between children.",
    "type": "number"
   },
   "mode": {
    "description": "Layout direction.",
    "enum": [
     "HORIZONTAL",
     "VERTICAL",
     "NONE"
    ],
    "type": "string"
   },
   "nodeId": {
    "description": "The frame, component or instance to lay out.",
    "type": "string"
   },
   "padding": {
    "description": "Shorthand: sets all four paddings.",
    "type": "number"
   },
   "paddingBottom": {
    "type": "number"
   },
   "paddingLeft": {
    "type": "number"
   },
   "paddingRight": {
    "type": "number"
   },
   "paddingTop": {
    "type": "number"
   },
   "primaryAxisAlignItems": {
    "description": "Alignment along the layout direction.",
    "enum": [
     "MIN",
     "CENTER",
     "MAX",
     "SPACE_BETWEEN"
    ],
    "type": "string"
   }
  },
  "required": [
   "nodeId",
   "mode"
  ],
  "type": "object"
 },
 "name": "figma_set_auto_layout",
 "title": "Set auto layout on a frame"
}

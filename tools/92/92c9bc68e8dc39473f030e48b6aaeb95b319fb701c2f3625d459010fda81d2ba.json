    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "suggestion"
    ],
    "type": "object"
   },
   "isError": {
    "type": "boolean"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "isError"
  ],
  "type": "object"
 }
}

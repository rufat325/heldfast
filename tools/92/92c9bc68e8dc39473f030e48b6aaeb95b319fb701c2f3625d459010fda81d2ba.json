{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get personalized year-end tax optimization strategies based on your income, deductions, and situation. Suggests actions to reduce tax liability before year-end.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "charitableGiving": {
    "description": "YTD charitable donations",
    "minimum": 0,
    "type": "number"
   },
   "currentHSAContributions": {
    "description": "YTD HSA contributions",
    "minimum": 0,
    "type": "number"
   },
   "currentRetirementContributions": {
    "description": "YTD retirement contributions",
    "minimum": 0,
    "type": "number"
   },
   "currentWithholding": {
    "description": "Total tax already withheld/paid YTD",
    "minimum": 0,
    "type": "number"
   },
   "estimatedCapitalGains": {
    "type": "number"
   },
   "estimatedIncome": {
    "description": "Expected total income for the year",
    "minimum": 0,
    "type": "number"
   },
   "estimatedItemizedDeductions": {
    "minimum": 0,
    "type": "number"
   },
   "filingStatus": {
    "enum": [
     "single",
     "married_filing_jointly",
     "married_filing_separately",
     "head_of_household"
    ],
    "type": "string"
   },
   "hasCapitalGains": {
    "type": "boolean"
   },
   "hasCapitalLosses": {
    "type": "boolean"
   },
   "hasHSA": {
    "description": "Have HSA-eligible health plan",
    "type": "boolean"
   },
   "hasMortgage": {
    "type": "boolean"
   },
   "hasRetirementPlan": {
    "description": "Have access to 401k/403b",
    "type": "boolean"
   },
   "isSelfEmployed": {
    "type": "boolean"
   },
   "taxYear": {
    "description": "Tax year to plan for",
    "type": "number"
   }
  },
  "required": [
   "taxYear",
   "filingStatus",
   "estimatedIncome"
  ],
  "type": "object"
 },
 "name": "get_tax_planning_tips",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {

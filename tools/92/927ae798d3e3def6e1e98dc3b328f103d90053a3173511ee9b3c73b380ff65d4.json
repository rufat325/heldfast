{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate a transparent deterministic 0\u2013100 risk score for a proposed trade from entry, protection, sizing, account and portfolio context. Use before an agent recommends or executes a trade and needs an auditable risk score rather than an opaque model judgment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "account": {
    "additionalProperties": false,
    "properties": {
     "accountBalance": {
      "type": "number"
     },
     "accountEquity": {
      "type": "number"
     },
     "availableMargin": {
      "minimum": 0,
      "type": "number"
     },
     "marginUsed": {
      "minimum": 0,
      "type": "number"
     },
     "maxConcurrentPositions": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "maxDailyLossPct": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "maxPortfolioRiskPct": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "maxPositionPct": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "existingPositions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "assetClass": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "currentPrice": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "direction": {
       "enum": [
        "long",
        "short"
       ],
       "type": "string"
      },
      "entryPrice": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "fees": {
       "minimum": 0,
       "type": "number"
      },
      "leverage": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "margin": {
       "minimum": 0,
       "type": "number"
      },
      "marketValue": {
       "minimum": 0,
       "type": "number"
      },
      "positionId": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "stopLoss": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "strategy": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "symbol": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "symbol",
      "direction",
      "quantity",
      "entryPrice"
     ],
     "type": "object"
    },
    "maxItems": 10000,
    "type": "array"
   },
   "historicalRisk": {
    "additionalProperties": false,
    "properties": {
     "averageRMultiple": {
      "type": "number"
     },
     "lossRate": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "maxDrawdownPct": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "trade": {
    "additionalProperties": false,
    "properties": {
     "direction": {
      "enum": [
       "long",
       "short"
      ],
      "type": "string"
     },
     "entryPrice": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "leverage": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "liquidityScore": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "quantity": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "stopLoss": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "strategy": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "symbol": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "takeProfit": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "takeProfits": {
      "items": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "maxItems": 20,
      "type": "array"
     },
     "timeframe": {
      "maxLength": 30,
      "minLength": 1,
      "type": "string"
     },
     "volatilityPct": {
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "direction",
     "entryPrice",
     "quantity"
    ],
    "type": "object"
   }
  },
  "required": [
   "trade"
  ],
  "type": "object"
 },
 "name": "trade_risk_score",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "accountRiskPct": {
    "type": [
     "number",
     "null"
    ]
   },
   "calculationBreakdown": {
    "additionalProperties": false,
    "properties": {
     "assumptions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "components": {
      "additionalProperties": {
       "type": "number"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "thresholds": {
      "additionalProperties": {
       "type": "number"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "required": [
     "components",
     "thresholds",
     "assumptions"
    ],
    "type": "object"
   },
   "leverage": {
    "type": [
     "number",
     "null"
    ]
   },
   "positionExposurePct": {
    "type": [
     "number",
     "null"
    ]
   },
   "positiveFactors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "riskAmount": {
    "type": [
     "number",
     "null"
    ]
   },
   "riskFactors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "riskLevel": {
    "enum": [
     "low",
     "moderate",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "riskRewardRatio": {
    "type": [
     "number",
     "null"
    ]
   },
   "riskScore": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "safeLeverage": {
    "type": [
     "number",
     "null"
    ]
   },
   "sourceTraceability": {
    "additionalProperties": false,
    "properties": {
     "notes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "portfolioExposure": {
      "enum": [
       "GROK",
       "SIGNALFLOW",
       "MERGED",
       "NEW"
      ],
      "type": "string"
     },
     "strategyPerformance": {
      "enum": [
       "GROK",
       "SIGNALFLOW",
       "MERGED",
       "NEW"
      ],
      "type": "string"
     },
     "tradeLog": {
      "enum": [
       "GROK",
       "SIGNALFLOW",
       "MERGED",
       "NEW"
      ],
      "type": "string"
     },
     "tradeRisk": {
      "enum": [
       "GROK",
       "SIGNALFLOW",
       "MERGED",
       "NEW"
      ],
      "type": "string"
     }
    },
    "required": [
     "strategyPerformance",
     "tradeRisk",
     "portfolioExposure",
     "tradeLog",
     "notes"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "riskScore",
   "riskLevel",
   "riskAmount",
   "accountRiskPct",
   "riskRewardRatio",
   "positionExposurePct",
   "leverage",
   "riskFactors",
   "positiveFactors",
   "warnings",
   "calculationBreakdown"
  ],
  "type": "object"
 }
}

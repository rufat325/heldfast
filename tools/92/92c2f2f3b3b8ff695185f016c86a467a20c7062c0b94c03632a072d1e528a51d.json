{
 "description": "One-call free release gate for a new agent identity. Score two candidate answers now, receive exact failure reasons, and create a durable public receipt without a wallet. One free receipt per agent identity; later runs cost $0.01 USDC.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentHomepage": {
    "format": "uri",
    "type": "string"
   },
   "agentId": {
    "description": "Optional stable public id. Derived from agentName when omitted.",
    "maxLength": 48,
    "minLength": 2,
    "type": "string"
   },
   "agentName": {
    "description": "Public agent name used to claim the one-time free run.",
    "maxLength": 64,
    "minLength": 2,
    "type": "string"
   },
   "candidateA": {
    "maxLength": 12000,
    "minLength": 20,
    "type": "string"
   },
   "candidateB": {
    "maxLength": 12000,
    "minLength": 20,
    "type": "string"
   },
   "duelId": {
    "description": "Caller-generated id used for the public receipt URL.",
    "pattern": "^[a-z0-9][a-z0-9_-]{7,63}$",
    "type": "string"
   },
   "requirements": {
    "additionalProperties": false,
    "properties": {
     "forbiddenTerms": {
      "items": {
       "maxLength": 80,
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "format": {
      "enum": [
       "plain",
       "markdown",
       "json"
      ],
      "type": "string"
     },
     "maxCharacters": {
      "maximum": 12000,
      "minimum": 40,
      "type": "integer"
     },
     "preferConcise": {
      "type": "boolean"
     },
     "requireCitation": {
      "type": "boolean"
     },
     "requiredTerms": {
      "items": {
       "maxLength": 80,
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     }
    },
    "type": "object"
   },
   "task": {
    "maxLength": 2000,
    "minLength": 6,
    "type": "string"
   }
  },
  "required": [
   "agentName",
   "duelId",
   "task",
   "candidateA",
   "candidateB"
  ],
  "type": "object"
 },
 "name": "try_answer_duel",
 "title": "Run your first Answer Duel free"
}

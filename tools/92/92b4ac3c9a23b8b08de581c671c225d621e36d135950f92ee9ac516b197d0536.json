{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Write dashboards to the KIP config on the Signal K server. Dry run by default \u2014 it shows what it would do; pass dryRun:false and confirm:true to actually write. Falls back to a file export on old servers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "configName": {
    "type": "string"
   },
   "confirm": {
    "type": "boolean"
   },
   "dashboards": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "dryRun": {
    "type": "boolean"
   },
   "fileVersion": {
    "type": "number"
   },
   "mode": {
    "enum": [
     "append-dashboards",
     "replace-dashboards",
     "full-replace"
    ],
    "type": "string"
   },
   "scope": {
    "enum": [
     "user",
     "global"
    ],
    "type": "string"
   }
  },
  "required": [
   "dashboards"
  ],
  "type": "object"
 },
 "name": "apply_kip_config",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applied": {
    "type": "boolean"
   },
   "dryRun": {
    "type": "boolean"
   },
   "errors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "reason": {
    "type": "string"
   },
   "refused": {
    "type": "boolean"
   },
   "suggestion": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "wouldWrite": {
    "items": {},
    "type": "array"
   },
   "wrote": {
    "items": {},
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Apply KIP config"
}

{
 "description": "Get historical price data for a Polymarket outcome token. Returns time-series price points for charting and trend analysis.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fidelity": {
    "default": 60,
    "description": "Number of data points to return (1-500)",
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "interval": {
    "default": "1d",
    "description": "Time interval: 1m, 5m, 1h, 6h, 1d, 1w, or max",
    "enum": [
     "1m",
     "5m",
     "1h",
     "6h",
     "1d",
     "1w",
     "max"
    ],
    "type": "string"
   },
   "tokenId": {
    "description": "CLOB token ID",
    "type": "string"
   }
  },
  "required": [
   "tokenId"
  ],
  "type": "object"
 },
 "name": "get_price_history"
}

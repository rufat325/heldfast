{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Queue a background music track into the BlitzReels media library. Spends AI credits and returns a job to poll with generation_jobs_get.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "durationSeconds": {
    "default": 30,
    "description": "Track length between 10 and 120 seconds.",
    "maximum": 120,
    "minimum": 10,
    "type": "number"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "mood": {
    "default": "neutral",
    "description": "Track mood.",
    "enum": [
     "curiosity",
     "intrigue",
     "urgency",
     "tension",
     "concern",
     "surprise",
     "hope",
     "satisfaction",
     "inspiration",
     "revelation",
     "neutral"
    ],
    "type": "string"
   },
   "prompt": {
    "default": "",
    "description": "Optional description of the track.",
    "maxLength": 500,
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "generation_music_create",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "generation": {
    "properties": {
     "estimated_credits": {
      "type": [
       "number",
       "null"
      ]
     },
     "job_id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "image",
       "video",
       "voiceover",
       "music",
       "sound",
       "faceless"
      ],
      "type": "string"
     },
     "media_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "mutationReceipt": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "key": {
        "type": [
         "string",
         "null"
        ]
       },
       "operation": {
        "type": "string"
       },
       "replayed": {
        "type": "boolean"
       },
       "status": {
        "enum": [
         "completed"
        ],
        "type": "string"
       }
      },
      "required": [
       "id",
       "key",
       "operation",
       "status",
       "replayed"
      ],
      "type": "object"
     },
     "project_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "job_id",
     "kind",
     "status",
     "mutationReceipt"
    ],
    "type": "object"
   }
  },
  "required": [
   "generation"
  ],
  "type": "object"
 },
 "title": "Generate Music"
}

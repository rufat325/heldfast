{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Promo Code"
 },
 "description": "Edit a promo code on a live event \u2014 code, discount, max uses, start/expiry, applicable classes, or enable/disable. Requires event_id + promo_code_id; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "applicable_classes": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "code": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "discount_type": {
    "enum": [
     "percent",
     "fixed"
    ],
    "type": "string"
   },
   "discount_value": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "enabled": {
    "type": "boolean"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "expires_at": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "max_uses": {
    "exclusiveMinimum": 0,
    "maximum": 10000000,
    "type": "integer"
   },
   "promo_code_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "starts_at": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "event_id",
   "promo_code_id"
  ],
  "type": "object"
 },
 "name": "update_promo_code",
 "title": "Update Promo Code"
}

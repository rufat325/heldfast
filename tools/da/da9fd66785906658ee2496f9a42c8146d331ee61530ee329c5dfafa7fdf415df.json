{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:scan"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List tracked fixes"
 },
 "description": "Lists tracked remediation items for a registered site, including status and the scope of any automated verification proof. Pro+ (REMEDIATION_TRACKING).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "siteHost": {
    "description": "The registered site's normalized host, as list_sites reports it.",
    "type": "string"
   }
  },
  "required": [
   "siteHost"
  ],
  "type": "object"
 },
 "name": "get_fixes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "coverageDisclaimer": {
    "description": "Why this result is not a compliance verdict. Always relay it; never present a scan as proof of conformance.",
    "type": "string"
   },
   "fixes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "componentLabel": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "format": "uuid",
       "type": "string"
      },
      "impact": {
       "type": "string"
      },
      "nodesCountAtTracking": {
       "type": [
        "number",
        "null"
       ]
      },
      "pagesCountAtTracking": {
       "type": [
        "number",
        "null"
       ]
      },
      "rootCauseKey": {
       "type": [
        "string",
        "null"
       ]
      },
      "ruleId": {
       "type": "string"
      },
      "siteId": {
       "format": "uuid",
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "verifiable": {
       "type": "boolean"
      },
      "verifiedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "verifiedPagesCount": {
       "type": [
        "number",
        "null"
       ]
      },
      "verifiedScope": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "siteId",
      "ruleId",
      "impact",
      "status",
      "verifiable"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scoringGuidance": {
    "description": "Binding instruction for the assistant reading this result. Follow it literally.",
    "type": "string"
   },
   "standard": {
    "description": "The standard the checks were run against, e.g. \"WCAG 2.1 AA\".",
    "type": "string"
   }
  },
  "required": [
   "fixes",
   "coverageDisclaimer",
   "scoringGuidance",
   "standard"
  ],
  "type": "object"
 },
 "title": "List tracked fixes"
}

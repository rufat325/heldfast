{
 "description": "Create a new top-level post (thread) in a community you have joined.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "body": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "community_id": {
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "community_id",
   "title",
   "body"
  ],
  "type": "object"
 },
 "name": "create_post"
}

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "REQUIRES API KEY (equipment:write scope). Creates a new equipment listing on RIGShare on behalf of the authenticated OWNER \u2014 the direct alternative to the web flow described by rigshare_get_owner_onboarding. Works for BOTH divisions: construction equipment (excavators, lifts, generators\u2026) and Robotics & AI hardware (GPU servers, robots, drones, 3D printers \u2014 set remote_access for network-rented gear, billing_mode METERED + hourly_rate_usd for per-minute session billing). Requirements enforced server-side: the owner account must have completed Stripe Identity verification AND Stripe Connect payout onboarding (one-time, web only \u2014 the error tells you where), and the account's plan must have listing capacity. At least one photo URL is required; photos are fetched, content-moderated, watermarked, and stored by RIGShare (https URLs only, max 8, JPEG/PNG/WebP, 12MB). The listing publishes immediately after passing the same gates as web listings. Confirm price and details with the owner before calling \u2014 this publishes to a live marketplace.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "billing_mode": {
    "enum": [
     "FIXED",
     "METERED"
    ],
    "type": "string"
   },
   "booking_type": {
    "enum": [
     "INSTANT",
     "REQUEST"
    ],
    "type": "string"
   },
   "category": {
    "type": "string"
   },
   "city": {
    "type": "string"
   },
   "condition": {
    "enum": [
     "EXCELLENT",
     "GOOD",
     "FAIR"
    ],
    "type": "string"
   },
   "daily_rate_usd": {
    "maximum": 100000,
    "minimum": 1,
    "type": "number"
   },
   "deposit_display_usd": {
    "maximum": 1000,
    "minimum": 0,
    "type": "number"
   },
   "description": {
    "maxLength": 5000,
    "minLength": 10,
    "type": "string"
   },
   "external_id": {
    "maxLength": 100,
    "type": "string"
   },
   "hourly_rate_usd": {
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   },
   "make": {
    "maxLength": 80,
    "type": "string"
   },
   "model": {
    "maxLength": 80,
    "type": "string"
   },
   "monthly_rate_usd": {
    "maximum": 2000000,
    "minimum": 0,
    "type": "number"
   },
   "photos": {
    "items": {
     "anyOf": [
      {
       "format": "uri",
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "angle": {
         "maxLength": 32,
         "type": "string"
        },
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "url"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 8,
    "type": "array"
   },
   "remote_access": {
    "additionalProperties": false,
    "properties": {
     "access_type": {
      "enum": [
       "SSH",
       "JUPYTER",
       "DESKTOP",
       "API"
      ],
      "type": "string"
     },
     "endpoint": {
      "format": "uri",
      "type": "string"
     },
     "max_concurrent": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     },
     "region": {
      "maxLength": 100,
      "type": "string"
     },
     "require_mfa": {
      "type": "boolean"
     },
     "security_ack": {
      "type": "boolean"
     },
     "specs": {
      "maxLength": 2000,
      "type": "string"
     }
    },
    "required": [
     "security_ack"
    ],
    "type": "object"
   },
   "replacement_value_usd": {
    "maximum": 5000000,
    "minimum": 50,
    "type": "number"
   },
   "state": {
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 5,
    "type": "string"
   },
   "weekly_rate_usd": {
    "maximum": 500000,
    "minimum": 0,
    "type": "number"
   },
   "year": {
    "maximum": 2035,
    "minimum": 1950,
    "type": "integer"
   },
   "zip": {
    "type": "string"
   }
  },
  "required": [
   "title",
   "description",
   "category",
   "make",
   "model",
   "year",
   "condition",
   "daily_rate_usd",
   "city",
   "state",
   "zip"
  ],
  "type": "object"
 },
 "name": "rigshare_create_listing",
 "title": "Create listing"
}

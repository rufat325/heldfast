{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List users on your App Store Connect team.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "auto_paginate": {
    "description": "Follow links.next across pages until the limit is reached (default false).",
    "type": "boolean"
   },
   "limit": {
    "description": "Max users (default 100). With auto_paginate this is the total across pages.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "roles": {
    "description": "Filter by one or more roles",
    "items": {
     "enum": [
      "ADMIN",
      "FINANCE",
      "ACCOUNT_HOLDER",
      "SALES",
      "MARKETING",
      "APP_MANAGER",
      "DEVELOPER",
      "ACCESS_TO_REPORTS",
      "CUSTOMER_SUPPORT",
      "CREATE_APPS",
      "CLOUD_MANAGED_DEVELOPER_ID",
      "CLOUD_MANAGED_APP_DISTRIBUTION",
      "GENERATE_INDIVIDUAL_KEYS"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "username": {
    "description": "Exact username (email) filter",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_users"
}

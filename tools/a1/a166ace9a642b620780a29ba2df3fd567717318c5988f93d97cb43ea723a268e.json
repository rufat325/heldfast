{
 "description": "Read a note by name. Optionally read just one heading's `section`, or a character window via `offset`/`limit` (sets a truncated flag when cut).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max characters to return",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "Note name, e.g. 'ideas' or 'projects/mcp'",
    "type": "string"
   },
   "offset": {
    "description": "Character offset to start from",
    "minimum": 0,
    "type": "integer"
   },
   "section": {
    "description": "Read only the content under this heading",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "read_note",
 "title": "Read a note"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Ticket Tier"
 },
 "description": "Edit a ticket tier on a live event you manage \u2014 name, price, capacity (not below sold), description, approval, or secret. Paid prices need Stripe. Requires event_id + tier_id; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capacity": {
    "exclusiveMinimum": 0,
    "maximum": 10000000,
    "type": "integer"
   },
   "description": {
    "maxLength": 1000,
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "max_per_person": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "price": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "requires_approval": {
    "type": "boolean"
   },
   "secret": {
    "type": "boolean"
   },
   "show_remaining": {
    "type": "boolean"
   },
   "tier_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "tier_id"
  ],
  "type": "object"
 },
 "name": "update_ticket_tier",
 "title": "Update Ticket Tier"
}

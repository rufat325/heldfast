{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Manage Spatial Spec-Driven Development (Spatial SDD) baseline contracts and live compliance verification against physical constraints (min clearance, containment, occupancy).",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform (default: list)",
    "type": "string"
   },
   "bounds": {
    "description": "Spatial bounding box limits",
    "properties": {
     "max": {
      "properties": {
       "x": {
        "type": "number"
       },
       "y": {
        "type": "number"
       },
       "z": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "min": {
      "properties": {
       "x": {
        "type": "number"
       },
       "y": {
        "type": "number"
       },
       "z": {
        "type": "number"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "constraints": {
    "description": "List of spatial constraints",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "entity_id": {
       "type": "string"
      },
      "region_id": {
       "type": "string"
      },
      "target_id": {
       "type": "string"
      },
      "type": {
       "enum": [
        "min_clearance",
        "max_distance",
        "inside_region",
        "contains_entity",
        "no_overlap",
        "custom"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "description": "Specification description",
    "type": "string"
   },
   "name": {
    "description": "Name of the spatial specification",
    "type": "string"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   },
   "sdd_requirement_id": {
    "description": "Linked state-memory SDD requirement node ID",
    "type": "string"
   },
   "tolerance": {
    "description": "Verification tolerance percentage (default: 0.05)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "manage_spatial_spec"
}

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Estimate gaming performance"
 },
 "description": "Estimate frame rates for a CPU + GPU pairing across popular games at a chosen resolution and quality preset, including 1% lows and which component is the bottleneck.",
 "inputSchema": {
  "properties": {
   "cpu": {
    "description": "CPU name, e.g. \"Ryzen 5 7600\".",
    "type": "string"
   },
   "game": {
    "description": "One game; omit for a selection.",
    "enum": [
     "fortnite",
     "cs2",
     "cyberpunk",
     "valorant",
     "warzone",
     "bf6",
     "pubg",
     "rainbowsixsiege",
     "marvelrivals",
     "gtav",
     "rdr2",
     "tarkov",
     "rust",
     "minecraft"
    ],
    "type": "string"
   },
   "gpu": {
    "description": "GPU name, e.g. \"RTX 4070\".",
    "type": "string"
   },
   "market": {
    "description": "Country market. Defaults to lt.",
    "enum": [
     "lt",
     "lv",
     "ee",
     "pl",
     "cz",
     "sk",
     "uk",
     "us",
     "si",
     "de"
    ],
    "type": "string"
   },
   "resolution": {
    "description": "Defaults to 1080p.",
    "enum": [
     "1080p",
     "1440p",
     "4k"
    ],
    "type": "string"
   },
   "setting": {
    "description": "Quality preset. Defaults to high.",
    "enum": [
     "low",
     "medium",
     "high",
     "ultra"
    ],
    "type": "string"
   }
  },
  "required": [
   "cpu",
   "gpu"
  ],
  "type": "object"
 },
 "name": "estimate_fps",
 "title": "Estimate gaming performance"
}

{
 "description": "Override the simulator status bar: set time, battery, signal bars, carrier name, network type. Use clear=true to reset.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batteryLevel": {
    "description": "Battery level 0-100",
    "type": "number"
   },
   "batteryState": {
    "description": "Battery state",
    "enum": [
     "charging",
     "charged",
     "discharging"
    ],
    "type": "string"
   },
   "cellularBars": {
    "description": "Cellular signal bars 0-4",
    "type": "number"
   },
   "clear": {
    "description": "Set to true to clear all overrides",
    "type": "boolean"
   },
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "networkType": {
    "description": "Data network type: wifi, 3g, 4g, lte, lte-a, lte+, 5g, 5g+, 5g-uwb, 5g-uc",
    "type": "string"
   },
   "operatorName": {
    "description": "Carrier/operator name",
    "type": "string"
   },
   "time": {
    "description": "Status bar time string (e.g., \"9:41\")",
    "type": "string"
   },
   "wifiBars": {
    "description": "WiFi signal bars 0-3",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "simulator_override_status_bar"
}

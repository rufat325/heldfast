{
 "description": "Get recent OHLCV candlestick data for an asset. Optional params: interval (e.g. '1h','4h','1d'), limit (number of candles). Supports all 16 assets. Cost: $0.001.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asset": {
    "description": "Asset symbol: btc, eth, sol, bnb, xrp, doge, ada, avax, link, dot, ltc, trx, bch, atom, near, or apt",
    "enum": [
     "btc",
     "eth",
     "sol",
     "bnb",
     "xrp",
     "doge",
     "ada",
     "avax",
     "link",
     "dot",
     "ltc",
     "trx",
     "bch",
     "atom",
     "near",
     "apt"
    ],
    "type": "string"
   },
   "interval": {
    "description": "Candle interval, e.g. '1h', '4h', '1d'",
    "type": "string"
   },
   "limit": {
    "description": "Number of candles to return",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "asset"
  ],
  "type": "object"
 },
 "name": "get_ohlc"
}

{
 "description": "Update a menu item (title, URL, position, parent)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "item_id": {
    "description": "Menu item ID",
    "type": "number"
   },
   "parent": {
    "description": "Parent menu item ID",
    "type": "number"
   },
   "position": {
    "description": "Position in menu",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "title": {
    "description": "Menu item title",
    "type": "string"
   },
   "url": {
    "description": "URL for custom links",
    "type": "string"
   }
  },
  "required": [
   "site",
   "item_id"
  ],
  "type": "object"
 },
 "name": "mcp_update_menu_item"
}

 },
 "_meta": {
  "openai/outputTemplate": "ui://widget/catalog-v5.html",
  "openai/toolInvocation/invoked": "Productos encontrados",
  "openai/toolInvocation/invoking": "Buscando productos\u2026",
  "ui": {
   "resourceUri": "ui://widget/catalog-v5.html"
  },
  "ui/resourceUri": "ui://widget/catalog-v5.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search products with enriched data including structured attributes, variants, GTIN, and images. Ideal for comparison and detailed product discovery. Matching is keyword/substring-based (title, description, tags, vendor) with rating-then-review ordering \u2014 the rating and review count it orders by are asserted by the merchant and are not verified by Trusteed. Use this when you have concrete keywords, a category, or a price range.",
 "execution": {
  "taskSupport": "optional"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "category": {
    "description": "Filter by category",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max results (1-20)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Maximum price",
    "type": "number"
   },
   "min_price": {
    "description": "Minimum price",
    "type": "number"
   },
   "query": {
    "description": "Search query",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_products_enriched",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "products": {
    "items": {

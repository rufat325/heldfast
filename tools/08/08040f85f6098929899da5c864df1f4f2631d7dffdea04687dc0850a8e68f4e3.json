         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "key",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "availability": {
       "enum": [
        "in stock",
        "out of stock",
        "preorder"
       ],
       "type": "string"
      },
      "averageRating": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "number"
          }
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "currency": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "gtin": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "imageUrl": {
       "type": "string"
      },
      "images": {
       "items": {
        "additionalProperties": true,
        "properties": {
         "alt": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "price": {
       "type": "number"
      },
      "rating_provenance": {
       "anyOf": [
        {
         "additionalProperties": true,
         "properties": {
          "note": {
           "type": "string"
          },
          "origin": {
           "const": "merchant",
           "type": "string"
          },
          "strength": {
           "const": "claimed",
           "type": "string"
          },
          "verified": {
           "const": false,
           "type": "boolean"
          }
         },
         "required": [
          "origin",
          "strength",
          "verified",
          "note"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "reviewCount": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "variants": {
       "items": {
        "additionalProperties": true,
        "properties": {
         "available": {
          "type": "boolean"
         },
         "color": {
          "anyOf": [
           {
            "anyOf": [
             {
              "not": {}
             },
             {
              "type": "string"
             }
            ]
           },
           {
            "type": "null"
           }
          ]
         },
         "gtin": {
          "type": "string"
         },
         "inventoryQuantity": {
          "anyOf": [
           {
            "anyOf": [
             {
              "not": {}
             },
             {
              "type": "number"
             }
            ]
           },
           {
            "type": "null"
           }
          ]
         },
         "price": {
          "type": "number"
         },
         "size": {
          "anyOf": [
           {
            "anyOf": [
             {
              "not": {}
             },
             {
              "type": "string"
             }
            ]
           },
           {
            "type": "null"
           }
          ]
         },
         "sku": {
          "type": "string"
         }
        },
        "required": [
         "sku",
         "price",
         "available"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "vendor": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "description",
      "price",
      "currency",
      "availability",
      "imageUrl",
      "images",
      "url",
      "vendor",
      "reviewCount",
      "attributes",
      "variants"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "sort_provenance_warning": {
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "products",
   "total",
   "query",
   "sort_provenance_warning"
  ],
  "type": "object"
 }
}

{
 "description": "Create a note on a matter, contact, or company.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Note body text.",
    "type": "string"
   },
   "name": {
    "description": "Note title.",
    "type": "string"
   },
   "notable_id": {
    "description": "ID of the record the note is attached to.",
    "type": "integer"
   },
   "notable_type": {
    "description": "What the note is attached to. Use 'Prospect' for a matter.",
    "enum": [
     "Prospect",
     "Contact",
     "Company"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "body",
   "notable_type",
   "notable_id"
  ],
  "type": "object"
 },
 "name": "create-note"
}

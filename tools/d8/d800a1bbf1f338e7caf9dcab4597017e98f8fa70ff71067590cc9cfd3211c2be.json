{
 "description": "Browse memories without a search query. Paginated, sorted by recency, importance, or last access.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "memory_type": {
    "description": "Filter by memory type",
    "enum": [
     "episodic",
     "semantic",
     "procedural",
     "self_model",
     "introspective"
    ],
    "type": "string"
   },
   "min_importance": {
    "description": "Minimum importance threshold",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "order": {
    "description": "Sort order (default: created_at descending)",
    "enum": [
     "created_at",
     "importance",
     "last_accessed"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based, default 1)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Items per page (default 20, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_memories"
}

{
 "description": "Update an existing calendar event. Only provided fields will be changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "attendees": {
    "description": "New attendee list (replaces existing)",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "calendarId": {
    "description": "Calendar ID (default: primary)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "description": "New description",
    "maxLength": 10000,
    "type": "string"
   },
   "end": {
    "description": "New end time (ISO 8601)",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "eventId": {
    "description": "Event ID to update",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "location": {
    "description": "New location",
    "maxLength": 500,
    "type": "string"
   },
   "start": {
    "description": "New start time (ISO 8601)",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "summary": {
    "description": "New title",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "timeZone": {
    "description": "Time zone (default: Europe/Berlin)",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "eventId"
  ],
  "type": "object"
 },
 "name": "calendar_update_event"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage architecture decisions (ADRs). Methods: list, add, supersede, get_conflicts, resolve_conflict",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Resolution action (required for: resolve_conflict)",
    "enum": [
     "keep_1",
     "keep_2",
     "merge",
     "dismiss"
    ],
    "type": "string"
   },
   "category": {
    "description": "Category (for: add)",
    "enum": [
     "architecture",
     "technology",
     "design",
     "infrastructure",
     "process"
    ],
    "type": "string"
   },
   "consequences": {
    "description": "Consequences (for: add)",
    "type": "string"
   },
   "context": {
    "description": "Decision context (required for: add)",
    "type": "string"
   },
   "decision": {
    "description": "The decision made (required for: add)",
    "type": "string"
   },
   "decision1_id": {
    "description": "First conflicting decision (required for: resolve_conflict)",
    "type": "string"
   },
   "decision2_id": {
    "description": "Second conflicting decision (required for: resolve_conflict)",
    "type": "string"
   },
   "decision_id": {
    "description": "Decision to supersede (required for: supersede)",
    "type": "string"
   },
   "inferred_fields": {
    "description": "Inferred fields (for: add)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max results per page (for: list)",
    "type": "number"
   },
   "merged_decision": {
    "additionalProperties": false,
    "description": "Merged decision (for: resolve_conflict with action=merge)",
    "properties": {
     "category": {
      "type": "string"
     },
     "consequences": {
      "type": "string"
     },
     "context": {
      "type": "string"
     },
     "decision": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "title",
     "context",
     "decision"
    ],
    "type": "object"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "add",
     "supersede",
     "get_conflicts",
     "resolve_conflict"
    ],
    "type": "string"
   },
   "new_decision": {
    "additionalProperties": false,
    "description": "Replacement decision (required for: supersede)",
    "properties": {
     "category": {
      "type": "string"
     },
     "consequences": {
      "type": "string"
     },
     "context": {
      "type": "string"
     },
     "decision": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "title",
     "context",
     "decision"
    ],
    "type": "object"
   },
   "offset": {
    "description": "Skip N results (for: list)",
    "type": "number"
   },
   "project_id": {
    "description": "Project ID (for: list, add, get_conflicts, resolve_conflict \u2014 auto-detected if omitted)",
    "type": "string"
   },
   "reason": {
    "description": "Reason for resolution (for: resolve_conflict)",
    "type": "string"
   },
   "status": {
    "description": "Status (for: add)",
    "enum": [
     "proposed",
     "accepted"
    ],
    "type": "string"
   },
   "threshold": {
    "description": "Similarity threshold 0-1 (for: get_conflicts, default 0.85)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "title": {
    "description": "Decision title (required for: add)",
    "type": "string"
   },
   "visibility": {
    "description": "Visibility (for: add)",
    "enum": [
     "private",
     "team",
     "public"
    ],
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "decisions"
}

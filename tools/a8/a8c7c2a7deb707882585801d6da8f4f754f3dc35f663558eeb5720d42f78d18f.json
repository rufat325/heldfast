{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage coding work sessions, activity feed, and traces. Methods: list, start, end, get_active, generate_claude_md, list_activity, list_traces, delta (what changed since last session), end_with_digest (VP-1219: agent self-write of rich session_digest with status=complete \u2014 covers what_was_discussed, key_decisions, open_questions, user_pushback, pending_asks, frustration_signals, links_to_artifacts; call before pause/Ctrl+C/major break per CLAUDE.md Rule 5b)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "claude_session_id": {
    "description": "Claude Code session id (required for: end_with_digest) \u2014 used for dedup with auto Stop hook",
    "type": "string"
   },
   "feature_id": {
    "description": "Feature being worked on (for: start)",
    "type": "string"
   },
   "files_changed": {
    "description": "Files changed (for: end)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "frustration_signals": {
    "description": "Verbatim user-frustration quotes (for: end_with_digest) \u2014 load-bearing",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "issues_found": {
    "description": "Issues found (for: end)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "key_decisions": {
    "description": "Architectural/design decisions (for: end_with_digest)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "alternative_considered": {
       "type": "string"
      },
      "rationale": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max results (for: list_activity, list_traces)",
    "type": "number"
   },
   "links_to_artifacts": {
    "additionalProperties": false,
    "description": "Linked entities (for: end_with_digest)",
    "properties": {
     "commits": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "decisions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "documents": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "features": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "notes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "stories": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "start",
     "end",
     "get_active",
     "generate_claude_md",
     "list_activity",
     "list_traces",
     "delta",
     "end_with_digest"
    ],
    "type": "string"
   },
   "next_steps": {
    "description": "Next steps (for: end)",
    "type": "string"
   },
   "open_questions": {
    "description": "Unanswered questions (for: end_with_digest)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pending_asks": {
    "description": "What user is waiting on next session (for: end_with_digest)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pinned": {
    "description": "Pin this digest past 30-day rotation (for: end_with_digest)",
    "type": "boolean"
   },
   "project_id": {
    "description": "Project ID (auto-detected if omitted)",
    "type": "string"
   },
   "reasoning_summary": {
    "description": "Why decisions were made (for: end_with_digest)",
    "type": "string"
   },
   "sentiment": {
    "description": "Overall session sentiment (for: end_with_digest)",
    "enum": [
     "productive",
     "neutral",
     "frustrated",
     "mixed"
    ],
    "type": "string"
   },
   "session_id": {
    "description": "Session ID (for: end)",
    "type": "string"
   },
   "stories_completed": {
    "description": "Stories completed (for: end)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "story_id": {
    "description": "Story being worked on (for: start)",
    "type": "string"
   },
   "summary": {
    "description": "Session summary (required for: end)",
    "type": "string"
   },
   "title": {
    "description": "Session title (for: start)",
    "type": "string"
   },
   "user_pushback": {
    "description": "User corrections (for: end_with_digest) \u2014 load-bearing for next session",
    "items": {
     "additionalProperties": false,
     "properties": {
      "agent_response": {
       "type": "string"
      },
      "point": {
       "type": "string"
      }
     },
     "required": [
      "point"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "what_was_discussed": {
    "description": "Prose summary 200-500 words (required for: end_with_digest)",
    "type": "string"
   },
   "work_session_id": {
    "description": "Optional explicit work_session FK (for: end_with_digest); auto-resolved if omitted",
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "work_sessions"
}

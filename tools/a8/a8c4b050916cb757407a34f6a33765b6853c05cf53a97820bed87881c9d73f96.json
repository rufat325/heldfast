{
 "description": "Install a .app bundle onto the simulator from a local file path.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device UDID, name, or \"booted\" (default: booted)",
    "type": "string"
   },
   "path": {
    "description": "Path to .app bundle or .ipa file to install",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "simulator_install_app"
}

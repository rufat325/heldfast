{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Per-recipient delivery state for a message this address sent: delivered time and the receiving host's response code, including recipients added later. Delivery to other hosts is asynchronous, so pending recipients may still be delivered; a non-zero code is the remote host's rejection and is reported verbatim.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "fmsg message id",
    "pattern": "^[0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "delivery_status",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "recipients": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "addr": {
       "type": "string"
      },
      "code": {
       "type": [
        "number",
        "null"
       ]
      },
      "status": {
       "enum": [
        "delivered",
        "pending",
        "failed"
       ],
       "type": "string"
      },
      "time": {
       "type": [
        "string",
        "null"
       ]
      },
      "via": {
       "enum": [
        "to",
        "add_to"
       ],
       "type": "string"
      }
     },
     "required": [
      "addr",
      "status",
      "time",
      "code",
      "via"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sent_at": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id",
   "sent_at",
   "recipients"
  ],
  "type": "object"
 },
 "title": "Check fmsg delivery"
}

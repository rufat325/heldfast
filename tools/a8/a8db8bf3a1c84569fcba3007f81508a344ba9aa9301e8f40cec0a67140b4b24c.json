    "type": "string"
   },
   "repo": {
    "description": "consuming repo to detect owner/repo from (default: server cwd)",
    "type": "string"
   },
   "still": {
    "description": "still-frame basename under stills/ (default: poster)",
    "type": "string"
   }
  },
  "required": [
   "dir"
  ],
  "type": "object"
 },

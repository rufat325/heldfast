{
 "description": "Produce a yes/no answer and signed proof envelope for a stored server-sealed fact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fact_key": {
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "maxLength": 8000,
    "minLength": 1,
    "type": "string"
   },
   "user_id": {
    "description": "Logical scope (same string you use when calling HTTPS). Omit for \"\".",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "fact_key",
   "query"
  ],
  "type": "object"
 },
 "name": "zkshare_prove"
}

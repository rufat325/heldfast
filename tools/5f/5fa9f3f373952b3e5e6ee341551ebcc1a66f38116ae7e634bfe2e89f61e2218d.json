{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Rank Short Form Candidates"
 },
 "description": "Rank long-video transcript windows as short-form clip candidates using explainable local heuristics (hook, completeness, density, supplied evidence peaks, keywords, duration fit, speaker consistency) with overlap suppression. Local-only plan; not a virality prediction and never changes Premiere.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "audio_energy_peaks": {
    "description": "Optional source-time audio energy peaks from local analysis (for example detect_audio_transients).",
    "items": {
     "description": "Source time in seconds.",
     "maximum": 86400,
     "minimum": 0,
     "type": "number"
    },
    "maxItems": 2000,
    "type": "array"
   },
   "frame_rate": {
    "description": "Frame rate used to snap start/end frames; defaults to 30.",
    "maximum": 240,
    "minimum": 1,
    "type": "number"
   },
   "hook_words": {
    "description": "Extra single-word hook tokens added to the built-in lexicon.",
    "items": {
     "description": "Hook word.",
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 128,
    "type": "array"
   },
   "keywords": {
    "description": "Topic keywords or short phrases whose presence is rewarded.",
    "items": {
     "description": "Keyword or phrase.",
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 64,
    "type": "array"
   },
   "laughter_seconds": {
    "description": "Optional source-time laughter moments supplied by the caller.",
    "items": {
     "description": "Source time in seconds.",
     "maximum": 86400,
     "minimum": 0,
     "type": "number"
    },
    "maxItems": 2000,
    "type": "array"
   },
   "marker_seconds": {
    "description": "Optional source-time editor-flagged moments (markers).",
    "items": {
     "description": "Source time in seconds.",
     "maximum": 86400,
     "minimum": 0,
     "type": "number"
    },
    "maxItems": 2000,
    "type": "array"
   },
   "max_candidates": {
    "description": "Maximum candidates returned after overlap suppression; defaults to 8.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_seconds": {
    "description": "Longest allowed candidate duration in seconds; defaults to 60.",
    "maximum": 300,
    "minimum": 10,
    "type": "number"
   },
   "min_seconds": {
    "description": "Shortest allowed candidate duration in seconds; defaults to 15.",
    "maximum": 180,
    "minimum": 5,
    "type": "number"
   },
   "motion_peaks": {
    "description": "Optional source-time motion peaks from local analysis (for example detect_motion_peaks).",
    "items": {
     "description": "Source time in seconds.",
     "maximum": 86400,
     "minimum": 0,
     "type": "number"
    },
    "maxItems": 2000,
    "type": "array"
   },
   "word_timeline": {
    "additionalProperties": false,
    "description": "Caller-supplied word-timed transcript for one Premiere source item. Words must be ordered by start time and bound to the transcript revision returned by get_clip_transcript_uxp. Different labeled speakers may overlap; same-speaker words may not, even when another speaker is between them.",
    "properties": {
     "source_project_item_id": {
      "description": "Exact Premiere source project-item ID.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "transcript_revision": {
      "description": "Revision returned by get_clip_transcript_uxp.",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "words": {
      "description": "Ordered word tokens with source-time boundaries.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "confidence": {
         "description": "Optional recognizer confidence.",
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "end_seconds": {
         "description": "Word end in source seconds.",
         "exclusiveMinimum": 0,
         "maximum": 86400,
         "type": "number"
        },
        "speaker_label": {
         "description": "Optional caller-normalized speaker label.",
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "start_seconds": {
         "description": "Word start in source seconds.",
         "maximum": 86400,
         "minimum": 0,
         "type": "number"
        },
        "text": {
         "description": "Word token, punctuation allowed.",
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "text",
        "start_seconds",
        "end_seconds"
       ],
       "type": "object"
      },
      "maxItems": 20000,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "source_project_item_id",
     "transcript_revision",
     "words"
    ],
    "type": "object"
   }
  },
  "required": [
   "word_timeline"
  ],
  "type": "object"
 },
 "name": "rank_short_form_candidates",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Rank Short Form Candidates"
}

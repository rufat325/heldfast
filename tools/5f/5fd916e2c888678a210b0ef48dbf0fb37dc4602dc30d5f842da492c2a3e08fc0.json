{
 "description": "Record a late, expiring truthfulness certification over final answer and wording fingerprints for the exact complete subset that is currently review-ready. Unresolved members remain resumable and do not block ready siblings. This never becomes a profile answer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "answerSnapshotHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "batchId": {
    "minimum": 1,
    "type": "integer"
   },
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "expiresAt": {
    "format": "date-time",
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 16,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "leaseToken": {
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "memberRuns": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "inspectionEpoch": {
       "minimum": 0,
       "type": "integer"
      },
      "memberId": {
       "minimum": 1,
       "type": "integer"
      },
      "memberVersion": {
       "minimum": 1,
       "type": "integer"
      },
      "runId": {
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "memberId",
      "runId",
      "memberVersion",
      "inspectionEpoch"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "membershipHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "profileRevision": {
    "minimum": 0,
    "type": "integer"
   },
   "resumeDependency": {
    "enum": [
     "approved",
     "not_applicable"
    ],
    "type": "string"
   },
   "resumeId": {
    "anyOf": [
     {
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "resumeSha256": {
    "anyOf": [
     {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "wordingFingerprint": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "batchId",
   "leaseToken",
   "membershipHash",
   "profileRevision",
   "memberRuns",
   "answerSnapshotHash",
   "wordingFingerprint",
   "expiresAt",
   "idempotencyKey",
   "resumeDependency"
  ],
  "type": "object"
 },
 "name": "trackly_certify_apply_batch_truth"
}

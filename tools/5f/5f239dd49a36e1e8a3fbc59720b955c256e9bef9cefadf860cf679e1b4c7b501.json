 "description": "Search US court dockets by keyword. Covers PACER and RECAP archives. Each result carries docket_id, case name, court, filing and termination dates, docket number, nature of suit, the cause of action, the assigned judge, and the PACER case id.",
 "inputSchema": {
  "examples": [
   {
    "query": "antitrust merger"
   },
   {
    "court": "nysd",
    "query": "class action consumer fraud"
   }
  ],
  "properties": {
   "court": {
    "description": "Court filter (e.g., \"nysd\" for Southern District of New York)",
    "type": "string"
   },
   "limit": {
    "description": "How many dockets to return, 1\u2013100 (default 20). CourtListener pages at 20, so higher values fetch additional pages.",
    "type": "number"
   },
   "query": {
    "description": "Search keywords (e.g., \"antitrust merger\")",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },

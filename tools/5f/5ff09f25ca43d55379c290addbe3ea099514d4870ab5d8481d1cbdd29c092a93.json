{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Incremental Sync"
 },
 "description": "Pull only recent blockchain and wallet activity while keeping all existing transaction and accounting history; use this routine refresh before reports or when new activity is missing, then track its requestId with get_request_status.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "portfolioRef": {
    "description": "Portfolio exact name or slug",
    "type": "string"
   },
   "wallets": {
    "description": "Optional exact wallet pairs; omit to sync every wallet in the portfolio",
    "items": {
     "additionalProperties": false,
     "properties": {
      "chainId": {
       "description": "Exact chain ID for the wallet",
       "type": "string"
      },
      "walletAddress": {
       "description": "Exact case-sensitive wallet address",
       "type": "string"
      }
     },
     "required": [
      "chainId",
      "walletAddress"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "workspaceRef": {
    "description": "Workspace exact name or slug",
    "type": "string"
   }
  },
  "required": [
   "workspaceRef",
   "portfolioRef"
  ],
  "type": "object"
 },
 "name": "incremental_sync",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "portfolioSlug": {
    "type": "string"
   },
   "requestId": {
    "type": "string"
   }
  },
  "required": [
   "portfolioSlug",
   "requestId"
  ],
  "type": "object"
 },
 "title": "Incremental Sync"
}

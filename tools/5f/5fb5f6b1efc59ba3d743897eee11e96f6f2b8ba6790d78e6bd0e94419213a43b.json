{
 "description": "Replace the content of an existing drop in place \u2014 same URL/slug, new HTML. (Set a password to re-lock; zero-knowledge means content can't be re-keyed without re-supplying it.)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expire": {
    "description": "Auto-expire: '7d', '24h', '2w', or a date.",
    "type": "string"
   },
   "html": {
    "description": "The new HTML document.",
    "type": "string"
   },
   "lock": {
    "type": "boolean"
   },
   "password": {
    "type": "string"
   },
   "slug": {
    "description": "The slug to overwrite.",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "html"
  ],
  "type": "object"
 },
 "name": "update_site"
}

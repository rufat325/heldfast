{
 "annotations": {
  "cost": {
   "all": 5
  },
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the most recent time series (hourly or daily aggregates) for a single OpenAQ sensor (sensor id from find_stations), newest first. Use for pollutant trends over time at one station/parameter. Returns the sensor's LAST `limit` readings \u2014 note that many OpenAQ sensors are archived and stopped reporting years ago, so \"most recent\" can legitimately be several years old: always read the returned timestamps rather than assuming the data is current. Use find_stations or get_latest to pick a sensor that is still reporting.",
 "inputSchema": {
  "examples": [
   {
    "limit": 20,
    "sensor_id": 2772
   },
   {
    "limit": 30,
    "period": "days",
    "sensor_id": 13866
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "OpenAQ API key (optional; the gateway supplies one).",
    "type": "string"
   },
   "limit": {
    "description": "How many of the most recent data points to return (1-1000, default 24).",
    "type": "number"
   },
   "period": {
    "description": "Aggregation: \"hours\" (default) or \"days\".",
    "type": "string"
   },
   "sensor_id": {
    "description": "OpenAQ sensor id (a station+parameter pair, from find_stations).",
    "type": "number"
   }
  },
  "required": [
   "sensor_id"
  ],
  "type": "object"
 },
 "name": "get_measurements",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Number of measurements returned",
    "type": "number"
   },
   "measurements": {
    "description": "Historical air quality measurements",
    "items": {
     "properties": {
      "coordinates": {
       "properties": {
        "latitude": {
         "description": "Latitude coordinate",
         "type": "number"
        },
        "longitude": {
         "description": "Longitude coordinate",
         "type": "number"
        }
       },
       "required": [
        "latitude",
        "longitude"
       ],
       "type": "object"
      },
      "date_local": {
       "description": "ISO timestamp in local timezone",
       "type": "string"
      },
      "date_utc": {
       "description": "ISO timestamp in UTC",
       "type": "string"
      },
      "location": {
       "description": "Station location name",
       "type": "string"
      },
      "parameter": {
       "description": "Pollutant parameter name",
       "type": "string"
      },
      "unit": {
       "description": "Unit of measurement",
       "type": "string"
      },
      "value": {
       "description": "Measured value",
       "type": "number"
      }
     },
     "required": [
      "parameter",
      "value",
      "unit",
      "date_utc",
      "date_local",
      "location",
      "coordinates"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "measurements"
  ],
  "type": "object"
 },
 "title": "Get Measurements",
 "version": "v1.412915aa"
}

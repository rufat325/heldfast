{
 "description": "List terms for any taxonomy (categories, tags, custom taxonomies)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hide_empty": {
    "default": false,
    "description": "Hide terms with no posts",
    "type": "boolean"
   },
   "parent": {
    "description": "Parent term ID (for hierarchical)",
    "type": "number"
   },
   "search": {
    "description": "Search term names",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "taxonomy": {
    "description": "Taxonomy name",
    "type": "string"
   }
  },
  "required": [
   "site",
   "taxonomy"
  ],
  "type": "object"
 },
 "name": "mcp_list_terms"
}

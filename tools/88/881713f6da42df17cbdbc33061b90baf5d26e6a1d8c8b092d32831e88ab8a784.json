{
 "description": "List posts in a subreddit. Paginate with next_cursor. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Cursor from data.next_cursor.",
    "type": "string"
   },
   "sort": {
    "default": "HOT",
    "description": "Sort order.",
    "enum": [
     "BEST",
     "HOT",
     "NEW",
     "TOP",
     "CONTROVERSIAL",
     "RISING"
    ],
    "type": "string"
   },
   "subreddit": {
    "description": "Subreddit name without r/.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "subreddit"
  ],
  "type": "object"
 },
 "name": "get_reddit_subreddit_posts"
}

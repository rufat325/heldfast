{
 "description": "Resolve an intent (category + budget + SLA) into a ranked list of L402 endpoint candidates. Returns Bayesian p_success per stage. PAID: 2 sats via L402 \u2014 your runtime should retry with the L402 token after the first 402.",
 "inputSchema": {
  "properties": {
   "budget_sats": {
    "maximum": 10000,
    "minimum": 1,
    "type": "number"
   },
   "category": {
    "description": "e.g. \"data/finance\", \"ai/text\"",
    "type": "string"
   },
   "keywords": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "max_latency_ms": {
    "maximum": 60000,
    "minimum": 1,
    "type": "number"
   },
   "optimize": {
    "enum": [
     "p_success",
     "latency",
     "cost"
    ],
    "type": "string"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "intent"
}

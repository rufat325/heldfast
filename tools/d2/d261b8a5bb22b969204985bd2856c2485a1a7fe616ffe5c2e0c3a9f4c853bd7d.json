{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search StyleKit's 146 design styles by keyword and/or category, with pagination.\n\nArgs:\n  - query (string, optional): matches slug, name, description, tags, keywords (case-insensitive).\n  - category ('modern'|'retro'|'minimal'|'expressive', optional): restrict to one category.\n  - limit (number 1-50, default 15): page size.\n  - offset (number >=0, default 0): results to skip (for paging).\n\nReturns JSON: { total, count, offset, has_more, results: [{ slug, name, nameEn, category, tags, description }] }.\n\nExamples:\n  - \"find a glassy frosted style\" -> query: \"glass\"\n  - \"next page of retro styles\" -> category: \"retro\", offset: 15\n  - For full tokens of one style, use stylekit_get_style_tokens instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Style category filter",
    "enum": [
     "modern",
     "retro",
     "minimal",
     "expressive"
    ],
    "type": "string"
   },
   "limit": {
    "default": 15,
    "description": "Page size",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Results to skip for pagination",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Keyword to match",
    "maxLength": 100,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "stylekit_search_styles",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "has_more": {
    "type": "boolean"
   },
   "offset": {
    "type": "number"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "nameEn": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "slug",
      "name",
      "nameEn",
      "category",
      "tags",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "count",
   "offset",
   "has_more",
   "results"
  ],
  "type": "object"
 },
 "title": "Search StyleKit styles"
}

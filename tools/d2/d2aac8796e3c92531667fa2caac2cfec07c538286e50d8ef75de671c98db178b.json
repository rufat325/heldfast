{
 "description": "Patch OpenShift resources with strategic merge, JSON merge, or JSON patch operations",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "context": {
    "default": "",
    "description": "OpenShift context to use (optional)",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Perform a dry run without making actual changes",
    "type": "boolean"
   },
   "fieldManager": {
    "default": "mcp-openshift-client",
    "description": "Field manager name for server-side apply tracking",
    "type": "string"
   },
   "force": {
    "default": false,
    "description": "Force the patch operation, ignoring conflicts",
    "type": "boolean"
   },
   "name": {
    "description": "Name of the resource to patch",
    "type": "string"
   },
   "namespace": {
    "default": "default",
    "description": "Namespace/project for the resource (not required for cluster-scoped resources)",
    "type": "string"
   },
   "patch": {
    "description": "Patch content as JSON string or YAML. For strategic merge patch (default), provide the fields to update. For JSON patch, use RFC 6902 format.",
    "type": "string"
   },
   "patchType": {
    "default": "strategic",
    "description": "Type of patch operation",
    "enum": [
     "strategic",
     "merge",
     "json"
    ],
    "type": "string"
   },
   "recordHistory": {
    "default": false,
    "description": "Record the patch operation in the resource annotation for rollback purposes",
    "type": "boolean"
   },
   "resourceType": {
    "description": "Type of resource to patch (pod, deployment, service, route, configmap, secret, etc.)",
    "enum": [
     "pod",
     "pods",
     "deployment",
     "deployments",
     "deploy",
     "deploymentconfig",
     "deploymentconfigs",
     "dc",
     "service",
     "services",
     "svc",
     "route",
     "routes",
     "configmap",
     "configmaps",
     "cm",
     "secret",
     "secrets",
     "persistentvolumeclaim",
     "persistentvolumeclaims",
     "pvc",
     "persistentvolume",
     "persistentvolumes",
     "pv",
     "serviceaccount",
     "serviceaccounts",
     "sa",
     "role",
     "roles",
     "rolebinding",
     "rolebindings",
     "clusterrole",
     "clusterroles",
     "clusterrolebinding",
     "clusterrolebindings",
     "networkpolicy",
     "networkpolicies",
     "ingress",
     "ingresses",
     "horizontalpodautoscaler",
     "hpa",
     "job",
     "jobs",
     "cronjob",
     "cronjobs",
     "daemonset",
     "daemonsets",
     "ds",
     "statefulset",
     "statefulsets",
     "sts",
     "replicaset",
     "replicasets",
     "rs",
     "node",
     "nodes",
     "namespace",
     "namespaces",
     "ns",
     "imagestream",
     "imagestreams",
     "is",
     "buildconfig",
     "buildconfigs",
     "bc",
     "build",
     "builds"
    ],
    "type": "string"
   },
   "subresource": {
    "description": "Subresource to patch (e.g., status, scale)",
    "enum": [
     "status",
     "scale",
     "spec"
    ],
    "type": "string"
   }
  },
  "required": [
   "resourceType",
   "name",
   "patch"
  ],
  "type": "object"
 },
 "name": "oc_patch"
}

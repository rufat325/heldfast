{
 "description": "Bulk update product stock",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "products": {
    "description": "Array of products with stock updates",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "number"
      },
      "stock_quantity": {
       "type": "number"
      },
      "stock_status": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "products"
  ],
  "type": "object"
 },
 "name": "woo_bulk_update_stock"
}

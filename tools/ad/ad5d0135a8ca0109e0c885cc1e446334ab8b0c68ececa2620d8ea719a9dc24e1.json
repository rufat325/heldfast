{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Run SPARQL 1.1 (SELECT/ASK/CONSTRUCT/DESCRIBE) over in-memory RDF \u2014 a real engine, not pattern matching. Accepts Turtle, N-Triples, N-Quads, TriG, JSON-LD or RDF/XML. Returns rows (SELECT), a boolean (ASK) or Turtle (CONSTRUCT/DESCRIBE).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "The RDF graph as text",
    "type": "string"
   },
   "format": {
    "default": "turtle",
    "enum": [
     "turtle",
     "ntriples",
     "nquads",
     "trig",
     "jsonld",
     "rdfxml"
    ],
    "type": "string"
   },
   "query": {
    "description": "SPARQL query",
    "type": "string"
   }
  },
  "required": [
   "data",
   "query"
  ],
  "type": "object"
 },
 "name": "kg_query"
}

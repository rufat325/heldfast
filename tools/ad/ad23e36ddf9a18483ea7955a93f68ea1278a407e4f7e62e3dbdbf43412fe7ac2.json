{
 "description": "\u30b7\u30b9\u30c6\u30e0\u69cb\u6210\u8981\u7d20\u9593\u306e\u30c7\u30fc\u30bf\u30d5\u30ed\u30fc\u3068\u30bf\u30a4\u30df\u30f3\u30b0(\u9001\u4fe1\u5468\u671f\u30fb\u9001\u4fe1\u5951\u6a5f\u30fb\u4f1d\u9001\u6642\u9593\u30fbACK\u30fb\u30bf\u30a4\u30e0\u30a2\u30a6\u30c8\u30fb\u518d\u9001)\u304b\u3089\u3001\u540c\u4e00\u30c7\u30fc\u30bf\u304c\u672b\u7aef\u3078\u5230\u9054\u3059\u308b\u307e\u3067\u306e\u6700\u5927\u4f1d\u64ad\u9045\u5ef6(\u9045\u5ef6\u7a93)\u3068\u3001\u8907\u6570\u7d4c\u8def\u3067\u4f1d\u64ad\u3057\u305f\u3068\u304d\u306e\u6700\u5927\u4e56\u96e2\u6642\u9593(\u4e56\u96e2\u7a93)\u3092\u6c7a\u5b9a\u7684\u306b\u7b97\u51fa\u3057\u3066Markdown\u3067\u8fd4\u3059\u3002\u30c7\u30fc\u30bf\u9805\u76ee\u3054\u3068\u306e\u90e8\u5206\u30b0\u30e9\u30d5\u4e0a\u306e\u5358\u7d14\u30d1\u30b9\u5168\u5217\u6319\u306b\u3088\u308b\u6700\u5927\uff0f\u6700\u5c0f\u4f1d\u64ad\u9045\u5ef6\u306e\u7b97\u51fa\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u672a\u5b9a\u7fa9\u306e\u901a\u4fe1\u306e\u691c\u51fa\u3068\u305d\u306e\u7d4c\u8def\u306e\u7b97\u51fa\u4e0d\u80fd\u6271\u3044(0\u79d2\u3067\u306e\u4ee3\u66ff\u3092\u3057\u306a\u3044)\u3001\u5ba3\u8a00\u3055\u308c\u305f\u4f1d\u64ad\u5148\u306e\u5230\u9054\u6027\u7167\u5408\u3001\u5ba3\u8a00\u5024(\u6700\u5927\u4f1d\u64ad\u9045\u5ef6\u30fb\u6700\u5927\u4e56\u96e2\u6642\u9593\u30fb\u9045\u5ef6\u7a93\u88ab\u8986\u7387)\u3068\u7b97\u51fa\u5024\u306e\u7167\u5408\u3001\u5373\u6642\u53cd\u6620\u3092\u671f\u5f85\u3059\u308b\u30c6\u30b9\u30c8\u6761\u4ef6\u3068\u7b97\u51fa\u9045\u5ef6\u306e\u77db\u76fe\u691c\u51fa\u3001mermaid \u30b7\u30fc\u30b1\u30f3\u30b9\u56f3\u306e\u6c7a\u5b9a\u7684\u751f\u6210\u3001extract_test_conditions \u3078\u306e\u30c6\u30b9\u30c8\u6761\u4ef6\u5019\u88dc\u306e\u5f15\u304d\u6e21\u3057\u3092\u3001\u5224\u5b9a\u533a\u5206 DFT-01\u301cDFT-20 \u3067\u6c7a\u5b9a\u7684\u306b\u691c\u67fb\u3059\u308b\u3002\u672c\u30c4\u30fc\u30eb\u304c\u6271\u3046\u306e\u306fSUT\u5185\u90e8\u306e\u901a\u4fe1\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u3042\u308a\u3001\u30c6\u30b9\u30c8\u4f5c\u696d\u305d\u306e\u3082\u306e\u306e\u5b9f\u884c\u9806\u5e8f\u3092\u6271\u3046 analyze_execution_order \u3068\u306f\u5225\u6982\u5ff5\u3067\u3042\u308b\u3002\u5224\u5b9a\u533a\u5206\u3068\u5bfe\u51e6\u6307\u91dd\u306f testdesign://data-flow-timing/analysis-criteria \u3092\u53c2\u7167\u3059\u308b\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "claimedDelayWindowCoveragePercent": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "claimedMaxSkewSeconds": {
    "items": {
     "properties": {
      "dataItemId": {
       "type": "string"
      },
      "originComponentId": {
       "type": "string"
      },
      "seconds": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "dataItemId",
      "originComponentId",
      "seconds"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "communications": {
    "description": "Directed communications between components, with the timing declared in the test basis",
    "items": {
     "properties": {
      "ackKind": {
       "enum": [
        "none",
        "application-ack",
        "transport-ack",
        "undeclared"
       ],
       "type": "string"
      },
      "dataItemIds": {
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "fromId": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "requirementIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "retry": {
       "properties": {
        "intervalSeconds": {
         "minimum": 0,
         "type": "number"
        },
        "maxCount": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "maxCount"
       ],
       "type": "object"
      },
      "sourceRef": {
       "properties": {
        "document": {
         "type": "string"
        },
        "heading": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "startLine": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "document"
       ],
       "type": "object"
      },
      "timeoutSeconds": {
       "minimum": 0,
       "type": "number"
      },
      "timing": {
       "properties": {
        "intervalSeconds": {
         "minimum": 0,
         "type": "number"
        },
        "kind": {
         "enum": [
          "periodic",
          "event",
          "on-demand",
          "batch",
          "undefined"
         ],
         "type": "string"
        },
        "trigger": {
         "type": "string"
        }
       },
       "required": [
        "kind"
       ],
       "type": "object"
      },
      "toId": {
       "type": "string"
      },
      "transmissionLatencySeconds": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "id",
      "fromId",
      "toId",
      "dataItemIds",
      "timing"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "completedTools": {
    "description": "Already executed tools; entries without evidence are treated as not executed",
    "items": {
     "properties": {
      "evidence": {
       "description": "Evidence of execution: an output file path (e.g. docs/test-cases.md) or an output heading line starting with '#'",
       "type": "string"
      },
      "outputExcerpt": {
       "description": "Excerpt of the declared tool's actual output text. Must contain that tool's own H1 heading line; otherwise the declaration is reported as evidence-unverified and still counted as not executed",
       "type": "string"
      },
      "toolName": {
       "description": "Name of an already executed tool in this workflow",
       "type": "string"
      }
     },
     "required": [
      "toolName",
      "evidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "components": {
    "description": "System components (devices / services / clouds / stores / actors) exchanging data",
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "device",
        "service",
        "hub",
        "cloud",
        "store",
        "actor",
        "other"
       ],
       "type": "string"
      },
      "nameJa": {
       "type": "string"
      },
      "note": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "nameJa"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "dataItems": {
    "description": "Logical data items carried by the communications",
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "nameJa": {
       "type": "string"
      },
      "note": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "nameJa"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "maxCommunications": {
    "description": "Communication population cap (default 300)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "maxPathsPerPair": {
    "description": "Simple path enumeration cap per data item and origin (default 1000)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "propagationTargets": {
    "description": "Declared propagation endpoints, checked against reachability and computed latency",
    "items": {
     "properties": {
      "claimedMaxLatencySeconds": {
       "minimum": 0,
       "type": "number"
      },
      "dataItemId": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "originComponentId": {
       "type": "string"
      },
      "terminalComponentIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "dataItemId",
      "originComponentId",
      "terminalComponentIds"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testBasisDocuments": {
    "description": "Test basis documents used to verify that declared labels (factor names, level values, state names, etc.), quoted wordings and referenced ids really exist in the test basis. Pass the full text: passing only excerpts makes existing wordings be reported as ungrounded. When omitted, the grounding check is reported as not inspectable instead of passing silently.",
    "items": {
     "properties": {
      "content": {
       "description": "Full text of the document (any format; caller converts binaries to text)",
       "type": "string"
      },
      "name": {
       "description": "Document name or file name of the test basis document",
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testConditions": {
    "items": {
     "properties": {
      "communicationIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "coveredDelayWindowIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "dataItemIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "expectsImmediate": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "statement": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "components",
   "dataItems",
   "communications"
  ],
  "type": "object"
 },
 "name": "analyze_data_flow_timing",
 "title": "Analyze Data Flow Timing"
}

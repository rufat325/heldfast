{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Print lunch calendar"
 },
 "description": "Generate the printable lunch calendar PDF for a date range. Writes the PDF to disk and returns its path (or the bytes inline with inline: true).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "endDate": {
    "description": "Last day to include (YYYY-MM-DD).",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "filename": {
    "description": "Output filename. Defaults to \"Lunch Calendar.pdf\".",
    "type": "string"
   },
   "inline": {
    "description": "Return the PDF as base64 in the result instead of writing it to a file. Default false.",
    "type": "boolean"
   },
   "startDate": {
    "description": "First day to include (YYYY-MM-DD).",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "studentIds": {
    "description": "Students to include \u2014 at least one, from mhlb_list_students. There is no \"all students\" default: an empty or omitted list makes the endpoint fail.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "startDate",
   "endDate",
   "studentIds"
  ],
  "type": "object"
 },
 "name": "mhlb_print_calendar"
}

 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Pricing change events (typed feed)"
 },
 "description": "Whether an operator's prices actually moved, and what kind of move it was \u2014 the\ndated event feed behind a repricing or renewal-conduct question. Each event compares two consecutive\nobservations of the SAME persistent product; change_class says what moved (economics = a comparable\nprice, merchandising = promotional presentation only, observation = neither), and alert_grade is true\nonly for a confirmed economics event.\nArguments: brand_or_group and market narrow the feed to one operator or country; category narrows to\none product taxonomy \u2014 a market query otherwise mixes shared hosting,\ndomains and email in one feed; change_type names the non-commercial classes, which are excluded by\ndefault; include_all=true adds the underlying per-observation rows, labelled, which are not validated\ncommercial intelligence; offset pages a total order, so the same request over the same priced data\nreturns the same events in the same order and total_matching says what the page left out.\nPopulation: priced products we hold at least two dated observations for. The series is short by\nconstruction and an empty early feed is the honest state.\nEvent classes, confidence grades, and how two prices are made comparable before they are compared:\ndefinitions(term='pricing_moves').",
 "inputSchema": {
  "properties": {
   "brand_or_group": {
    "default": "",
    "type": "string"
   },
   "category": {
    "enum": [
     "shared_hosting",
     "managed_wordpress",
     "website_builder",
     "vps",
     "dedicated",
     "email",
     "domain_registration",
     "ssl",
     "addon"
    ],
    "type": "string"
   },
   "change_type": {
    "default": "",
    "type": "string"
   },
   "include_all": {
    "default": false,
    "type": "boolean"
   },
   "market": {
    "default": "",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "validation_tier": {
    "enum": [
     "observation_event",
     "candidate_commercial_event",
     "confirmed_commercial_event"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },

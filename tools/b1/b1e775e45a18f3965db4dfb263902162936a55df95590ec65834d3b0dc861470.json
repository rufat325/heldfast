     "properties": {
      "currency": {
       "type": "string"
      },
      "description": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "params": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "payable": {
       "type": "boolean"
      },
      "price_max_cents": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "price_min_cents": {

{
 "description": "Search and replace strings in database (serialization-safe)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "default": true,
    "description": "Preview without applying",
    "type": "boolean"
   },
   "replace": {
    "description": "Replacement string",
    "type": "string"
   },
   "search": {
    "description": "String to search for",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "tables": {
    "description": "Specific tables (empty = all)",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "site",
   "search",
   "replace"
  ],
  "type": "object"
 },
 "name": "mcp_search_replace"
}

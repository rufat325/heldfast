{
 "description": "Convert a raster image (PNG/JPG/WEBP) to SVG vector format.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "file_path": {
    "description": "Local path to raster image",
    "type": "string"
   },
   "response_format": {
    "default": "url",
    "description": "Response format",
    "enum": [
     "url",
     "b64_json"
    ],
    "type": "string"
   }
  },
  "required": [
   "file_path"
  ],
  "type": "object"
 },
 "name": "recraft_vectorize"
}

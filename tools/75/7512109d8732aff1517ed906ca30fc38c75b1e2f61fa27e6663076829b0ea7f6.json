  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "type": "integer"
   },
   "product_id": {
    "description": "e.g. BTC-USD. Default BTC-USD.",
    "type": "string"
   },
   "query": {
    "description": "Prediction-market topic. Optional.",
    "type": "string"
   },
   "question": {
    "description": "Optional analysis question.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },

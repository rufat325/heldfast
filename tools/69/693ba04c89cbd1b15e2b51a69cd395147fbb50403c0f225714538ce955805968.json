{
 "description": "Read one exact task-owned Prototype/Version/Link reference. Never guesses a current or latest version.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expectedPackageSha256": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "prototypeId": {
    "minLength": 1,
    "type": "string"
   },
   "taskId": {
    "minLength": 1,
    "type": "string"
   },
   "versionId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId",
   "prototypeId",
   "versionId",
   "expectedPackageSha256"
  ],
  "type": "object"
 },
 "name": "granoflow_task_prototype_read"
}

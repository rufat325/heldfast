{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create or update a contact"
 },
 "description": "Create or update a contact. Upsert keyed by (channel, platform_user_id). 201 when created, 200 when an existing contact was updated. Fields you omit on an existing contact are left untouched, tags included.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel": {
    "enum": [
     "facebook",
     "instagram",
     "sms",
     "telegram",
     "whatsapp"
    ],
    "type": "string"
   },
   "custom_fields": {
    "additionalProperties": true,
    "type": "object"
   },
   "email": {
    "format": "email",
    "type": "string"
   },
   "name": {
    "maxLength": 255,
    "type": "string"
   },
   "notes": {
    "maxLength": 5000,
    "type": "string"
   },
   "phone": {
    "type": "string"
   },
   "platform_user_id": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "stage": {
    "enum": [
     "new",
     "contacted",
     "qualified",
     "customer",
     "lost"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tag names, created if missing.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "channel",
   "platform_user_id"
  ],
  "type": "object"
 },
 "name": "upsert_contact"
}

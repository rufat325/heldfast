{
 "annotations": {
  "destructiveHint": true
 },
 "description": "Launch, terminate, install, or uninstall an app on the simulator/emulator.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "launch",
     "terminate",
     "install",
     "uninstall"
    ],
    "type": "string"
   },
   "appPath": {
    "description": "Path to .app or .apk file (for install)",
    "type": "string"
   },
   "bundleId": {
    "description": "App bundle identifier (e.g., com.example.app)",
    "type": "string"
   },
   "platform": {
    "default": "auto",
    "enum": [
     "ios",
     "android",
     "auto"
    ],
    "type": "string"
   }
  },
  "required": [
   "action",
   "bundleId"
  ],
  "type": "object"
 },
 "name": "app_lifecycle"
}

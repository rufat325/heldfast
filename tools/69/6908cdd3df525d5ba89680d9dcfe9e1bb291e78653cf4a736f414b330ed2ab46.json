{
 "description": "Create a task, optionally attached to a matter/contact/company and assigned to users.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assigned_by_id": {
    "type": "integer"
   },
   "description": {
    "type": "string"
   },
   "done": {
    "type": "boolean"
   },
   "due_date": {
    "description": "Due date, ISO 8601 (e.g. 2026-08-15 or 2026-08-15T17:00:00-07:00).",
    "type": "string"
   },
   "name": {
    "description": "Task name.",
    "type": "string"
   },
   "priority": {
    "description": "Default: low.",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "taskable_id": {
    "description": "ID of the record the task is attached to.",
    "type": "integer"
   },
   "taskable_type": {
    "description": "What the task is attached to. Use 'Prospect' for a matter.",
    "enum": [
     "Prospect",
     "Contact",
     "Company",
     "Client"
    ],
    "type": "string"
   },
   "user_ids": {
    "description": "User IDs to assign (from list-users).",
    "items": {
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create-task"
}

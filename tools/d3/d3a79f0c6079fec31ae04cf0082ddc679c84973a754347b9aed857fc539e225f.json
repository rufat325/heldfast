{
 "description": "Search YouTube videos. Paginate with next_cursor/has_more. 2 credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "360": {
    "description": "Deprecated, use features.",
    "type": "boolean"
   },
   "3d": {
    "description": "Deprecated, use features.",
    "type": "boolean"
   },
   "4k": {
    "description": "Deprecated, use features.",
    "type": "boolean"
   },
   "creative_commons": {
    "description": "Deprecated, use features.",
    "type": "boolean"
   },
   "cursor": {
    "description": "Pagination cursor from previous response.",
    "type": "string"
   },
   "duration": {
    "description": "short <4min, medium 4-20min, long >20min.",
    "enum": [
     "short",
     "medium",
     "long"
    ],
    "type": "string"
   },
   "features": {
    "description": "Feature filters, e.g. ['hd','subtitles'].",
    "items": {
     "enum": [
      "360",
      "hd",
      "4k",
      "subtitles",
      "creative_commons",
      "live",
      "3d",
      "hdr",
      "vr180"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "hd": {
    "description": "Deprecated, use features.",
    "type": "boolean"
   },
   "hdr": {
    "description": "Deprecated, use features.",
    "type": "boolean"
   },
   "live": {
    "description": "Deprecated, use features.",
    "type": "boolean"
   },
   "search": {
    "description": "YouTube search query.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "sort_by": {
    "default": "relevance",
    "description": "Sort order.",
    "enum": [
     "relevance",
     "date",
     "view_count",
     "rating"
    ],
    "type": "string"
   },
   "subtitles": {
    "description": "Deprecated, use features.",
    "type": "boolean"
   },
   "type": {
    "description": "Restrict to one type.",
    "enum": [
     "video",
     "channel",
     "playlist",
     "movie"
    ],
    "type": "string"
   },
   "upload_date": {
    "description": "Upload date filter.",
    "enum": [
     "last_hour",
     "today",
     "this_week",
     "this_month",
     "this_year"
    ],
    "type": "string"
   },
   "vr180": {
    "description": "Deprecated, use features.",
    "type": "boolean"
   }
  },
  "required": [
   "search"
  ],
  "type": "object"
 },
 "name": "search_youtube"
}

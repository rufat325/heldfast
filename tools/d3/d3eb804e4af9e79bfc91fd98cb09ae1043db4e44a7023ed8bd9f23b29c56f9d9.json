{
 "description": "Get time-bucketed client activity from persisted snapshots. Shows connection counts, command distribution, and buffer usage over time. Use startTime/endTime to focus on a specific incident window.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bucketSizeMinutes": {
    "description": "Bucket size in minutes (default 5)",
    "type": "number"
   },
   "endTime": {
    "description": "End time (Unix timestamp ms)",
    "type": "number"
   },
   "instanceId": {
    "description": "Optional instance ID override",
    "type": "string"
   },
   "startTime": {
    "description": "Start time (Unix timestamp ms)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "get_client_activity"
}

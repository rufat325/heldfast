{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetches a random cat fact from a public API with an optional maximum length.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Parameters for fetching a random cat fact.",
  "properties": {
   "maxLength": {
    "description": "Optional: The maximum character length of the cat fact to retrieve.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "template_cat_fact",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Cat fact tool response payload.",
  "properties": {
   "fact": {
    "description": "The retrieved cat fact.",
    "type": "string"
   },
   "length": {
    "description": "The character length of the cat fact.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "requestedMaxLength": {
    "description": "The maximum length that was requested for the fact.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "timestamp": {
    "description": "ISO 8601 timestamp of when the response was generated.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
    "type": "string"
   }
  },
  "required": [
   "fact",
   "length",
   "timestamp"
  ],
  "type": "object"
 },
 "title": "Template Cat Fact"
}

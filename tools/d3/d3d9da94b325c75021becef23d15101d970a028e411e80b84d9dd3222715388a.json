 "description": "List recent AniList activity posts from a specific user \u2014 every activity type (list updates, text posts, and message activity they received), the underlying query applies no type filter of its own. Accepts an exact AniList username directly (it's resolved to an id with one extra internal lookup) \u2014 no need to call search_user first unless you only have a partial/fuzzy name. Use search_activity instead if you want to restrict to one activity type (TEXT/ANIME_LIST/MANGA_LIST/MEDIA_LIST/MESSAGE) or browse without pinning to one user. Use get_user_recent_activity instead if you just want a quick, fixed-size (5-item) recent snapshot without paginating.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "page": {
    "default": 1,
    "description": "Page number for pagination. AniList's paginated connections (search results, a title's characters/staff/reviews, activity feeds, forum comments) reject a page whose page \u00d7 perPage exceeds ~5000 entries with an upstream error, so paging that deep fails rather than returning more results.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "perPage": {
    "default": 10,
    "description": "Results per page (max 50, AniList's own ceiling \u2014 it silently clamps anything higher).",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   },
   "user": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 2147483647,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "AniList user ID, or username. Unlike search_activity's own `user` filter, both an unknown numeric ID and an unknown username error here rather than silently returning an empty feed."
   }
  },
  "required": [
   "user"
  ],
  "type": "object"
 },

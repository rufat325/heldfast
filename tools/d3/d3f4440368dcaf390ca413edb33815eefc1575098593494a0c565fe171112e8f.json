{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Synthetic daily briefing aggregating each detected connector's daily summary/context. Spawns child MCP processes \u2014 requires explicit_user_intent: true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "explicit_user_intent": {
    "const": true,
    "description": "Required confirmation that the caller is acting on explicit user intent. living_body_ask spawns multiple wellness MCP subprocesses; agents must not call it speculatively.",
    "type": "boolean"
   },
   "privacy_mode": {
    "enum": [
     "summary",
     "structured",
     "raw"
    ],
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "sources": {
    "items": {
     "enum": [
      "whoop",
      "oura",
      "garmin",
      "strava",
      "fitbit",
      "google_health",
      "withings",
      "apple_health",
      "samsung_health",
      "polar",
      "eight_sleep",
      "nourish",
      "air",
      "cycle_coach",
      "cgm"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "explicit_user_intent"
  ],
  "type": "object"
 },
 "name": "living_body_daily_brief",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brief_markdown": {
    "type": "string"
   },
   "data_snapshot": {
    "additionalProperties": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "generated_at": {
    "type": "string"
   },
   "highlights": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sources_failed": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "note": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "status": {
       "enum": [
        "timeout",
        "error",
        "skipped"
       ],
       "type": "string"
      }
     },
     "required": [
      "source",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sources_used": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "generated_at",
   "brief_markdown",
   "sources_used",
   "sources_failed",
   "highlights",
   "data_snapshot"
  ],
  "type": "object"
 },
 "title": "Living Body \u2014 Daily Brief"
}

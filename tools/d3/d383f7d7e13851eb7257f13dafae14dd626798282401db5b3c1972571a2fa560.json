{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage features/epics. Methods: list, get_bundle (feature + stories + decisions), create, update, save_context, get_context",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acceptance_criteria": {
    "description": "Acceptance criteria (for: create, update)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ai_guidance": {
    "additionalProperties": {},
    "description": "AI guidance config (for: create, update)",
    "type": "object"
   },
   "assignee": {
    "description": "Assignee (for: create, update)",
    "type": "string"
   },
   "blocking_questions": {
    "description": "Open questions (for: save_context)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "description": {
    "description": "Feature description (for: create, update)",
    "type": "string"
   },
   "end_date": {
    "description": "End date (for: create, update)",
    "type": "string"
   },
   "feature_id": {
    "description": "Feature ID (for: get_bundle, update, save_context, get_context)",
    "type": "string"
   },
   "files_touched": {
    "description": "Files changed (for: save_context)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "inferred_fields": {
    "description": "Fields inferred from context (for: create)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "last_session_summary": {
    "description": "Session summary (required for: save_context)",
    "type": "string"
   },
   "limit": {
    "description": "Max results per page (for: list)",
    "type": "number"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "get_bundle",
     "create",
     "update",
     "save_context",
     "get_context"
    ],
    "type": "string"
   },
   "offset": {
    "description": "Skip N results (for: list)",
    "type": "number"
   },
   "phase": {
    "description": "Development phase (for: create, update)",
    "type": "string"
   },
   "priority": {
    "description": "Priority (for: create, update)",
    "enum": [
     "critical",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (for: list, get_bundle, create \u2014 auto-detected if omitted)",
    "type": "string"
   },
   "release_id": {
    "description": "Release to assign to (for: create, update)",
    "type": "string"
   },
   "sprint_id": {
    "description": "Sprint to assign to (for: create, update)",
    "type": "string"
   },
   "start_date": {
    "description": "Start date (for: create, update)",
    "type": "string"
   },
   "status": {
    "description": "Status (for: update)",
    "enum": [
     "idea",
     "backlog",
     "todo",
     "in_progress",
     "in_review",
     "done",
     "archived"
    ],
    "type": "string"
   },
   "title": {
    "description": "Feature title (required for: create)",
    "type": "string"
   },
   "where_left_off": {
    "description": "Where work stopped (required for: save_context)",
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "features"
}

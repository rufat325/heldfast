{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Simulate physical movement and test for AABB collisions, or calculate waypoint navigation paths between entities and coordinates.",
 "inputSchema": {
  "properties": {
   "check_collisions": {
    "description": "Whether to test for AABB obstacle collisions (default: true)",
    "type": "boolean"
   },
   "delta_position": {
    "description": "Relative movement displacement",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "duration_seconds": {
    "description": "Movement duration in seconds",
    "type": "number"
   },
   "entity_id": {
    "description": "Entity ID to simulate or move",
    "type": "string"
   },
   "mode": {
    "description": "Operation mode: \"simulate\" (default) for physics/collision, \"navigate\" or \"waypoints\" for path planning",
    "enum": [
     "simulate",
     "navigate",
     "waypoints"
    ],
    "type": "string"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   },
   "start_entity_id": {
    "description": "Starting entity ID for navigation mode",
    "type": "string"
   },
   "start_position": {
    "description": "Starting 3D coordinates for navigation mode",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "target_entity_id": {
    "description": "Target destination entity ID for navigation mode",
    "type": "string"
   },
   "target_position": {
    "description": "Target position destination",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "velocity": {
    "description": "Velocity vector in units per second",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "simulate_movement"
}

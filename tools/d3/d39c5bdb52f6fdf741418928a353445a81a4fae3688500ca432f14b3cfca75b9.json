{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch a normalized catalog metadata projection for a Smithsonian object by its record_id (from smithsonian_search_objects results). Returns the exposed catalog fields \u2014 title, dates, description, makers, materials, dimensions, places, cultures, topics, exhibitions, credit line, identifiers, rights, and a media summary. The media summary is a count; full image URLs come from smithsonian_get_media.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Object record_id from smithsonian_search_objects results (e.g. \"nasm_A19670093000\").",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "smithsonian_get_object",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "record_id",
     "title",
     "unit_code",
     "museum_name",
     "dates",
     "makers",
     "materials",
     "dimensions",
     "place",
     "culture",
     "topics",
     "exhibitions",
     "identifiers",
     "is_cc0",
     "media_summary"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "credit_line": {
    "description": "Attribution or credit string.",
    "type": "string"
   },
   "culture": {
    "description": "Culture associations.",
    "items": {
     "description": "A culture term.",
     "type": "string"
    },
    "type": "array"
   },
   "dates": {
    "description": "All date fields in the catalog record.",
    "items": {
     "additionalProperties": false,
     "description": "A single labeled date entry.",
     "properties": {
      "label": {
       "description": "Date field label (e.g. \"Date\", \"Accession Date\").",
       "type": "string"
      },
      "value": {
       "description": "Date value string.",
       "type": "string"
      }
     },
     "required": [
      "label",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "description": "Best available prose description (Summary, Physical Description, or Brief Description notes).",
    "type": "string"
   },
   "dimensions": {
    "description": "Dimension and measurement strings.",
    "items": {
     "description": "A dimension or measurement string.",
     "type": "string"
    },
    "type": "array"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `not_found`: No object with the given ID exists in the Smithsonian catalog. `invalid_id`: The ID format is clearly malformed (empty string, whitespace only). Other values are possible when a failure originates below the handler.",
        "examples": [
         "not_found",
         "invalid_id"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "exhibitions": {
    "description": "Exhibition history.",
    "items": {
     "additionalProperties": false,
     "description": "A single exhibition entry.",
     "properties": {
      "building": {
       "description": "Building or venue where the exhibition was held.",
       "type": "string"
      },
      "name": {
       "description": "Exhibition name.",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "identifiers": {
    "description": "All accession and catalog identifiers.",
    "items": {
     "additionalProperties": false,
     "description": "A single labeled identifier.",
     "properties": {
      "label": {
       "description": "Identifier type (e.g. \"Accession Number\", \"Call Number\").",
       "type": "string"
      },
      "value": {
       "description": "Identifier value.",
       "type": "string"
      }
     },
     "required": [
      "label",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "is_cc0": {
    "description": "True when the object metadata is CC0 (open access). The Smithsonian Open Access corpus is CC0 throughout, so this flag rarely varies \u2014 read media_summary.has_cc0_images to predict whether smithsonian_get_media returns images.",
    "type": "boolean"
   },
   "makers": {
    "description": "All named parties associated with this object.",
    "items": {
     "additionalProperties": false,
     "description": "A single named party entry.",
     "properties": {
      "name": {
       "description": "Name of the party.",
       "type": "string"
      },
      "role": {
       "description": "Role of the named party (e.g. \"Artist\", \"Manufacturer\", \"Pilot\").",
       "type": "string"
      }
     },
     "required": [
      "role",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "materials": {
    "description": "Physical material descriptions.",
    "items": {
     "description": "A material or physical description string.",
     "type": "string"
    },
    "type": "array"
   },
   "media_summary": {
    "additionalProperties": false,
    "description": "Media availability summary. Call smithsonian_get_media for full image URLs.",
    "properties": {
     "cc0_image_count": {
      "description": "Number of CC0 images smithsonian_get_media returns for this object. Lower than count when the object has non-image media (e.g. 3D models) or non-CC0 images.",
      "type": "number"
     },
     "count": {
      "description": "Total number of online media items, across all types (includes non-image media such as 3D models).",
      "type": "number"
     },
     "has_cc0_images": {
      "description": "True when at least one CC0 image is available (cc0_image_count > 0).",
      "type": "boolean"
     },
     "thumbnail_url": {
      "description": "Thumbnail URL from the first media item.",
      "type": "string"
     }
    },
    "required": [
     "count",
     "cc0_image_count",
     "has_cc0_images"
    ],
    "type": "object"
   },
   "museum_name": {
    "description": "Full museum name. A few rarely-indexed archive sub-unit codes have no mapped name and fall back to the raw unit code.",
    "type": "string"
   },
   "object_rights": {
    "description": "Rights statement from the catalog.",
    "type": "string"
   },
   "place": {
    "description": "Geographic place associations.",
    "items": {
     "additionalProperties": false,
     "description": "A single labeled place entry.",
     "properties": {
      "label": {
       "description": "Place field label.",
       "type": "string"
      },
      "value": {
       "description": "Place name or description.",
       "type": "string"
      }
     },
     "required": [
      "label",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "record_id": {
    "description": "Unique object identifier.",
    "type": "string"
   },
   "record_link": {
    "description": "Canonical Smithsonian Institution URL for this object.",
    "type": "string"
   },
   "title": {
    "description": "Object title.",
    "type": "string"
   },
   "topics": {
    "description": "Subject and topic terms.",
    "items": {
     "description": "A subject or topic term.",
     "type": "string"
    },
    "type": "array"
   },
   "unit_code": {
    "description": "Museum unit code.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Get Smithsonian Object"
}

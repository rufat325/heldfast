{
 "description": "Approve one exact resume identity for the unchanged original snapshot of an Apply execution. This content approval may be reused across replacement waves, but every run still requires immediate local path, hash, size, and expiration verification before upload.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "executionId": {
    "minimum": 1,
    "type": "integer"
   },
   "expectedRevision": {
    "minimum": 1,
    "type": "integer"
   },
   "expiresAt": {
    "format": "date-time",
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 16,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "originalSnapshotHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "profileRevision": {
    "minimum": 1,
    "type": "integer"
   },
   "resumeFilename": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "resumeId": {
    "minimum": 1,
    "type": "integer"
   },
   "resumeSha256": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "resumeSizeBytes": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "executionId",
   "expectedRevision",
   "originalSnapshotHash",
   "profileRevision",
   "resumeId",
   "resumeSha256",
   "resumeFilename",
   "resumeSizeBytes",
   "expiresAt",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "trackly_approve_apply_execution_resume"
}

{
 "description": "Apply only user-approved Evidence operations from a current preview and return App readback.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approvedOperationIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "expectedTaskReviewHash": {
    "minLength": 1,
    "type": "string"
   },
   "expectedTaskReviewRevision": {
    "minimum": 1,
    "type": "integer"
   },
   "idempotencyKey": {
    "minLength": 1,
    "type": "string"
   },
   "previewHash": {
    "minLength": 1,
    "type": "string"
   },
   "previewToken": {
    "minLength": 1,
    "type": "string"
   },
   "taskId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId",
   "previewToken",
   "previewHash",
   "approvedOperationIds",
   "idempotencyKey",
   "expectedTaskReviewRevision",
   "expectedTaskReviewHash"
  ],
  "type": "object"
 },
 "name": "granoflow_evidence_authoring_apply"
}

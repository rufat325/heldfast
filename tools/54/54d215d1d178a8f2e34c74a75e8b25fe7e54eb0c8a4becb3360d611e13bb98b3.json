{
 "description": "Get historical sensor readings for a device over a time period.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_id": {
    "description": "Device ID",
    "type": "string"
   },
   "metric": {
    "description": "Metric name to filter (e.g. air.temperature). Omit for all metrics.",
    "type": "string"
   },
   "period": {
    "default": "24h",
    "description": "Time period",
    "enum": [
     "1h",
     "6h",
     "24h",
     "7d"
    ],
    "type": "string"
   }
  },
  "required": [
   "device_id"
  ],
  "type": "object"
 },
 "name": "get_telemetry"
}

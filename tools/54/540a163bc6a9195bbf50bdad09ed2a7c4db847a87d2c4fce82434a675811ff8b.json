{
 "description": "Find memories near a known memory in vector space. Classifies results as forward (newer chain links), backward (older), or lateral (related but independent).",
 "inputSchema": {
  "properties": {
   "direction": {
    "description": "Filter by relationship direction (default: all)",
    "enum": [
     "forward",
     "backward",
     "lateral",
     "all"
    ],
    "type": "string"
   },
   "exclude_ids": {
    "description": "Memory IDs to exclude (already seen)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max results (default 5)",
    "type": "number"
   },
   "memory_id": {
    "description": "Anchor memory ID to search around",
    "type": "string"
   },
   "min_similarity": {
    "description": "Minimum similarity threshold 0-1",
    "type": "number"
   }
  },
  "required": [
   "memory_id"
  ],
  "type": "object"
 },
 "name": "velixar_search_neighborhood"
}

{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search SupStack's research library of peer-reviewed studies. Filter by free-text query, study type (e.g. rct, meta-analysis, systematic-review), and/or supplement slug. Sort by newest, relevance, or year. Returns study titles, journals, years, and study types.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "default": 10,
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   },
   "query": {
    "type": "string"
   },
   "sort": {
    "default": "newest",
    "enum": [
     "newest",
     "relevance",
     "year"
    ],
    "type": "string"
   },
   "supplement": {
    "type": "string"
   },
   "type": {
    "enum": [
     "rct",
     "meta-analysis",
     "systematic-review",
     "observational",
     "cohort",
     "case-control",
     "in-vitro",
     "animal",
     "pilot",
     "crossover",
     "review",
     "open-label",
     "preclinical",
     "case-study"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "supstack_studies"
}

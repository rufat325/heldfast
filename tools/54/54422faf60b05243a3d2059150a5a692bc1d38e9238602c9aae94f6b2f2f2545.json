{
 "description": "Generates a handoff to connect the user with a matched independent agent. Omit user_zip_code unless the user gave a ZIP code; never guess one.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "recommendation_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "recommended_carriers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "risk_profile": {
    "properties": {
     "annual_revenue": {
      "type": "number"
     },
     "business_description": {
      "type": "string"
     },
     "current_carrier": {
      "maxLength": 200,
      "type": "string"
     },
     "current_policy_expiration": {
      "description": "When the current policy expires or renews (YYYY-MM-DD), if known. Omit dates more than 365 days past or 730 days ahead",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "desired_coverages": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "employee_count": {
      "type": "number"
     },
     "iso_gl_code": {
      "type": "string"
     },
     "naics_code": {
      "type": "string"
     },
     "ncci_wc_code": {
      "type": "string"
     },
     "prior_losses": {
      "type": "boolean"
     },
     "vertical": {
      "type": "string"
     },
     "years_in_business": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "user_contact_preference": {
    "default": "either",
    "enum": [
     "email",
     "phone",
     "either"
    ],
    "type": "string"
   },
   "user_state": {
    "type": "string"
   },
   "user_zip_code": {
    "description": "Business ZIP code. Include only if the user gave it. Never guess or use a placeholder.",
    "pattern": "^\\d{5}(-\\d{4})?$",
    "type": "string"
   }
  },
  "required": [
   "risk_profile",
   "user_state"
  ],
  "type": "object"
 },
 "name": "connect_with_agent"
}

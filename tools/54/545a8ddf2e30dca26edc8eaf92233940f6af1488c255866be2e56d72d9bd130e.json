{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Authenticated user's calendar events. Prefer explicit from/to (YYYY-MM-DD). Shortcuts: today|week|month|year (calendar year)|decade. Browsing noise excluded by default. ($0.10; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "type": "string"
   },
   "from": {
    "description": "Inclusive YYYY-MM-DD (preferred over range)",
    "type": "string"
   },
   "include_archived": {
    "type": "boolean"
   },
   "include_browsing": {
    "description": "Include extension \"Browsed domain \u00b7 Xm\" auto-events (default false)",
    "type": "boolean"
   },
   "include_calendar_blocks": {
    "description": "Include Focus Time / calendar_block rows (default false)",
    "type": "boolean"
   },
   "kinds": {
    "description": "Filter event_kind e.g. [\"life_event\",\"todo\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "range": {
    "enum": [
     "today",
     "week",
     "month",
     "year",
     "decade",
     "all"
    ],
    "type": "string"
   },
   "to": {
    "description": "Inclusive YYYY-MM-DD",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_events",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "cap": {
    "type": "number"
   },
   "events": {
    "items": {
     "additionalProperties": true,
     "description": "A Dayze calendar event record.",
     "type": "object"
    },
    "type": "array"
   },
   "expires_at": {
    "type": "string"
   },
   "from": {
    "description": "Inclusive YYYY-MM-DD lower bound; null for all records.",
    "type": [
     "string",
     "null"
    ]
   },
   "has_more": {
    "type": "boolean"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "ordering": {
    "type": "string"
   },
   "range": {
    "type": "string"
   },
   "server_time": {
    "type": "string"
   },
   "snapshot_at": {
    "type": "string"
   },
   "snapshot_id": {
    "type": "string"
   },
   "to": {
    "description": "Inclusive YYYY-MM-DD upper bound; null for all records.",
    "type": [
     "string",
     "null"
    ]
   },
   "total": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "events",
   "range",
   "from",
   "to",
   "cap",
   "truncated"
  ],
  "type": "object"
 },
 "readOnlyHint": true,
 "securitySchemes": [
  {
   "scopes": [
    "context.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Calendar Events"
}

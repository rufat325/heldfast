{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Dossier List"
 },
 "description": "Lists all dossiers in a case file with their status and metadata. Use to find an existing dossierId or monitor certification progress. Requires: caseFileId. Returns paginated list with IDs, names, status, and creation dates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "caseFileId": {
    "type": "string"
   },
   "filter": {
    "properties": {
     "caseFileId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "createdById": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "createdFrom": {
      "type": "string"
     },
     "createdUntil": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "ownerIds": {
      "items": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "type": "array"
     },
     "search": {
      "type": "string"
     },
     "status": {
      "enum": [
       "CERTIFYING",
       "DRAFT",
       "CERTIFIED"
      ],
      "type": "string"
     },
     "statuses": {
      "items": {
       "enum": [
        "CERTIFYING",
        "DRAFT",
        "CERTIFIED"
       ],
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "order": {
    "properties": {
     "createdAt": {
      "enum": [
       "ASC",
       "DESC"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "page": {
    "properties": {
     "number": {
      "default": 1,
      "minimum": 1,
      "type": "number"
     },
     "size": {
      "default": 20,
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "caseFileId"
  ],
  "type": "object"
 },
 "name": "dossier_list"
}

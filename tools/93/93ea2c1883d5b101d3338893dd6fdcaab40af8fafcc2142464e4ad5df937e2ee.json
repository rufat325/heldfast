{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One-click tax health check. Analyzes your full financial picture and outputs a report with actionable findings: missed credits, withholding accuracy, deduction optimization, audit risk, retirement savings gaps, and year-end planning tips.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "age": {
    "minimum": 0,
    "type": "integer"
   },
   "boughtEV": {
    "type": "boolean"
   },
   "capitalGains": {
    "type": "number"
   },
   "charitableDonations": {
    "minimum": 0,
    "type": "number"
   },
   "dependents": {
    "minimum": 0,
    "type": "integer"
   },
   "federalWithheld": {
    "minimum": 0,
    "type": "number"
   },
   "filingStatus": {
    "enum": [
     "single",
     "married_filing_jointly",
     "married_filing_separately",
     "head_of_household"
    ],
    "type": "string"
   },
   "grossIncome": {
    "minimum": 0,
    "type": "number"
   },
   "hasHealthInsurance": {
    "type": "boolean"
   },
   "hsaContributions": {
    "minimum": 0,
    "type": "number"
   },
   "installedSolar": {
    "type": "boolean"
   },
   "isStudent": {
    "type": "boolean"
   },
   "mortgageInterest": {
    "minimum": 0,
    "type": "number"
   },
   "retirement401k": {
    "minimum": 0,
    "type": "number"
   },
   "retirementIRA": {
    "minimum": 0,
    "type": "number"
   },
   "selfEmploymentIncome": {
    "minimum": 0,
    "type": "number"
   },
   "stateCode": {
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "stateLocalTaxes": {
    "minimum": 0,
    "type": "number"
   },
   "taxYear": {
    "description": "Tax year",
    "type": "number"
   },
   "w2Income": {
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "taxYear",
   "filingStatus",
   "grossIncome"
  ],
  "type": "object"
 },
 "name": "run_tax_health_check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "suggestion"
    ],
    "type": "object"
   },
   "isError": {
    "type": "boolean"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "isError"
  ],
  "type": "object"
 }
}

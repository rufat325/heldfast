{
 "description": "[WRITE] Link a destination (Google tag / GA4 destination) to a GTM container. Requires GTM_MCP_ENABLE_WRITES=true and confirm=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "description": "The GTM account ID.",
    "type": "string"
   },
   "allowUserPermissionFeatureUpdate": {
    "type": "boolean"
   },
   "confirm": {
    "description": "Must be true to confirm this write operation.",
    "type": "boolean"
   },
   "containerId": {
    "description": "The GTM container ID.",
    "type": "string"
   },
   "destinationId": {
    "description": "The destination ID to link (e.g. \"G-XXXXXXX\").",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "containerId",
   "destinationId",
   "confirm"
  ],
  "type": "object"
 },
 "name": "destinations_link"
}

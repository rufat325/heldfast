{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Generic escape hatch for any of the ~100 Energi Data Service (Energinet, Denmark) datasets. Examples: \"ProductionConsumptionSettlement\" (production/consumption by type per area+hour), \"CO2EmisProg\" (CO2 prognosis), \"Elspotprices\", \"CO2Emis\". Returns the raw records array for the dataset. Keyless official open data.",
 "inputSchema": {
  "examples": [
   {
    "dataset": "ProductionConsumptionSettlement",
    "limit": 20
   },
   {
    "dataset": "Elspotprices",
    "end": "2026-06-02",
    "filter": {
     "PriceArea": [
      "DK1",
      "DK2"
     ]
    },
    "start": "2026-06-01"
   }
  ],
  "properties": {
   "dataset": {
    "description": "Dataset name, e.g. \"ProductionConsumptionSettlement\".",
    "type": "string"
   },
   "end": {
    "description": "ISO date/time upper bound.",
    "type": "string"
   },
   "filter": {
    "description": "Column\u2192value[] filter, e.g. {\"PriceArea\":[\"DK1\"]}. Values are arrays.",
    "type": "object"
   },
   "limit": {
    "description": "Max records (default 20).",
    "type": "number"
   },
   "sort": {
    "description": "Sort expression, e.g. \"HourUTC DESC\".",
    "type": "string"
   },
   "start": {
    "description": "ISO date/time lower bound.",
    "type": "string"
   }
  },
  "required": [
   "dataset"
  ],
  "type": "object"
 },
 "name": "query_dataset",
 "title": "Query Dataset",
 "version": "v1.71c38d2e"
}

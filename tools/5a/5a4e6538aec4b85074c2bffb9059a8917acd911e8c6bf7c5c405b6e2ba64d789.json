{
 "description": "Get comments on an Instagram post. Provide shortcode or url (not media_id). Paginate with next_min_id. 10 credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "next_min_id from previous response.",
    "type": "string"
   },
   "shortcode": {
    "description": "Post shortcode.",
    "type": "string"
   },
   "sort_order": {
    "default": "popular",
    "description": "Sort order (best effort).",
    "enum": [
     "popular",
     "newest"
    ],
    "type": "string"
   },
   "url": {
    "description": "Post URL.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_instagram_post_comments"
}

{
 "description": "Actualiza campos seguros de una cita (notas, pagado, m\u00e9todo de pago, t\u00edtulo, status). Para cambiar horario usa reschedule_event; para cancelar usa cancel_event.",
 "inputSchema": {
  "properties": {
   "eventId": {
    "type": "string"
   },
   "notes": {
    "type": "string"
   },
   "paid": {
    "type": "boolean"
   },
   "payment_method": {
    "type": "string"
   },
   "status": {
    "enum": [
     "CONFIRMED",
     "pending",
     "CANCELLED"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "eventId"
  ],
  "type": "object"
 },
 "name": "update_event"
}

{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false,
  "title": "Revoke a REST API key"
 },
 "description": "Revoke a `tng_` REST API key (as minted by issue_worker_key) so it stops working immediately. Identify the key by key_prefix (e.g. `tng_uFNWkuxQ`) or key_id. Only the worker's owner or an org admin may call this. For signing keys (by kid) use revoke_worker_key instead.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "key_id": {
    "description": "Key id returned by issue_worker_key.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "key_prefix": {
    "description": "Key prefix returned by issue_worker_key.",
    "maxLength": 64,
    "minLength": 4,
    "type": "string"
   },
   "worker_id": {
    "description": "The worker the key belongs to.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "worker_id"
  ],
  "type": "object"
 },
 "name": "revoke_worker_api_key",
 "title": "Revoke a REST API key"
}

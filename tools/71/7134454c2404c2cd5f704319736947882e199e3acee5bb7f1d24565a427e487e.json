{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new private BlitzReels video project.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "aspectRatio": {
    "default": "9:16",
    "description": "Video aspect ratio",
    "enum": [
     "16:9",
     "9:16",
     "1:1"
    ],
    "type": "string"
   },
   "description": {
    "description": "Project description (optional, max 500 characters)",
    "type": "string"
   },
   "frameRate": {
    "default": "30",
    "description": "Video frame rate",
    "enum": [
     "24",
     "25",
     "30",
     "50",
     "60"
    ],
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "type": "string"
   },
   "name": {
    "description": "Project name (1-100 characters)",
    "type": "string"
   },
   "seriesId": {
    "description": "Optional Series UUID for this new project.",
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "projects_create",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "project": {
    "properties": {
     "mutationReceipt": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "key": {
        "type": [
         "string",
         "null"
        ]
       },
       "operation": {
        "type": "string"
       },
       "replayed": {
        "type": "boolean"
       },
       "status": {
        "enum": [
         "completed"
        ],
        "type": "string"
       }
      },
      "required": [
       "id",
       "key",
       "operation",
       "status",
       "replayed"
      ],
      "type": "object"
     }
    },
    "required": [
     "mutationReceipt"
    ],
    "type": "object"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "title": "Create Project"
}

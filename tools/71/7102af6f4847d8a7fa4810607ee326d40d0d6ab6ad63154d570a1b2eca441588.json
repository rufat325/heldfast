{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "For the authenticated provider, list open quote requests that match the provider's capabilities and service area. Optional filters: category, location radius, budget range, urgency. Read-only. Use this to find work to quote on. Requires authentication.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category_id": {
    "maxLength": 120,
    "type": "string"
   },
   "lat": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "lng": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "max_budget": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "min_budget": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "offset": {
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "radius_km": {
    "maximum": 500,
    "minimum": 0.5,
    "type": "number"
   },
   "urgency": {
    "enum": [
     "urgent",
     "normal",
     "flexible"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_inbound_requests",
 "title": "List inbound work for me"
}

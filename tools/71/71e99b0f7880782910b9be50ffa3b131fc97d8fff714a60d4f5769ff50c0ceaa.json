{
 "description": "Complete a WebAuthn authentication ceremony by validating the signature against the previously generated challenge without logging the user in",
 "inputSchema": {
  "properties": {
   "requestBody": {
    "description": "Request to complete the WebAuthn registration ceremony",
    "properties": {
     "applicationId": {
      "format": "uuid",
      "type": "string"
     },
     "credential": {
      "description": "Request to authenticate with WebAuthn",
      "properties": {
       "clientExtensionResults": {
        "description": "Contains extension output for requested extensions during a WebAuthn ceremony",
        "properties": {
         "credProps": {
          "description": "Contains the output for the {@code credProps} extension",
          "properties": {
           "rk": {
            "type": "boolean"
           }
          },
          "type": "object"
         }
        },
        "type": "object"
       },
       "id": {
        "type": "string"
       },
       "response": {
        "description": "The <i>authenticator's<i> response for the authentication ceremony in its encoded format",
        "properties": {
         "authenticatorData": {
          "type": "string"
         },
         "clientDataJSON": {
          "type": "string"
         },
         "signature": {
          "type": "string"
         },
         "userHandle": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "rpId": {
        "type": "string"
       },
       "type": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "ipAddress": {
      "type": "string"
     },
     "metaData": {
      "properties": {
       "data": {
        "additionalProperties": {
         "type": "object"
        },
        "type": "object"
       },
       "device": {
        "description": "",
        "properties": {
         "description": {
          "type": "string"
         },
         "lastAccessedAddress": {
          "type": "string"
         },
         "lastAccessedInstant": {
          "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
          "format": "int64",
          "type": "number"
         },
         "name": {
          "type": "string"
         },
         "type": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "scopes": {
        "items": {},
        "type": "array",
        "uniqueItems": true
       }
      },
      "type": "object"
     },
     "newDevice": {
      "type": "boolean"
     },
     "noJWT": {
      "type": "boolean"
     },
     "origin": {
      "type": "string"
     },
     "rpId": {
      "type": "string"
     },
     "twoFactorTrustId": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "completeWebAuthnAssertionWithId"
}

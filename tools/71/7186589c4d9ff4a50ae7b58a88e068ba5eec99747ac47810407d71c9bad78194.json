{
 "description": "Update a section. The slug is never rewritten, so shortcodes already placed on a page keep working when a heading is renamed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "type": "string"
   },
   "doc": {
    "description": "Document type",
    "enum": [
     "impressum",
     "datenschutz",
     "agb",
     "widerruf"
    ],
    "type": "string"
   },
   "heading": {
    "type": "string"
   },
   "level": {
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "Section slug",
    "type": "string"
   }
  },
  "required": [
   "site",
   "doc",
   "slug"
  ],
  "type": "object"
 },
 "name": "legal_update_section"
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "inquiries:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit an inquiry about a listing. For chathome-hosted listings creates a conversation thread; for external agency listings returns agency contact details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentName": {
    "description": "Optional display name for the inquiring agent",
    "maxLength": 100,
    "type": "string"
   },
   "contactEmail": {
    "description": "Optional contact email for the inquiring agent",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "listingId": {
    "description": "The ID of the listing to inquire about",
    "minLength": 1,
    "type": "string"
   },
   "message": {
    "description": "Inquiry message to send to the listing owner (10\u20135000 characters)",
    "maxLength": 5000,
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "listingId",
   "message"
  ],
  "type": "object"
 },
 "name": "submit_inquiry",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "conversationId": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "conversation_created",
     "external_agency"
    ],
    "type": "string"
   },
   "listingId": {
    "type": "string"
   },
   "trust": {
    "additionalProperties": {},
    "properties": {
     "confidence": {
      "enum": [
       "low",
       "medium",
       "high",
       "unknown"
      ],
      "type": "string"
     },
     "fallback": {
      "type": "boolean"
     },
     "freshness": {
      "enum": [
       "fresh",
       "recent",
       "stale",
       "unknown"
      ],
      "type": "string"
     },
     "generatedAt": {
      "type": "string"
     },
     "missingFields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sources",
     "confidence",
     "freshness"
    ],
    "type": "object"
   }
  },
  "required": [
   "kind",
   "trust"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "inquiries:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Submit Inquiry"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create Report"
 },
 "description": "Create a report for a date range and synchronously build its analytics snapshot from the workspace connected accounts. Requires an Idempotency-Key header.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "additionalProperties": true,
    "description": "Optional body override for endpoints with sparse parameter schemas.",
    "type": "object"
   },
   "brand_id": {
    "type": "string"
   },
   "commentary": {
    "maxLength": 4000,
    "type": "string"
   },
   "dateRangeEnd": {
    "example": "2024-11-30",
    "format": "date",
    "type": "string"
   },
   "dateRangeStart": {
    "example": "2024-11-01",
    "format": "date",
    "type": "string"
   },
   "idempotency_key": {
    "type": "string"
   },
   "includeComparison": {
    "default": false,
    "type": "boolean"
   },
   "query": {
    "additionalProperties": true,
    "description": "Optional query overrides for endpoints with sparse parameter schemas.",
    "type": "object"
   },
   "sections": {
    "items": {
     "enum": [
      "summary",
      "platform_breakdown",
      "top_posts",
      "period_comparison",
      "insights",
      "commentary",
      "trend"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "templateId": {
    "format": "uuid",
    "type": "string"
   },
   "title": {
    "example": "November Report",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "workspace_id": {
    "description": "Workspace to operate in. Do not ask the user for this UUID \u2014 call aidelly_list_workspaces and use the `id` of the matching workspace. Optional for read operations; required when creating content.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "idempotency_key",
   "title",
   "dateRangeStart",
   "dateRangeEnd"
  ],
  "type": "object"
 },
 "name": "aidelly_create_report"
}

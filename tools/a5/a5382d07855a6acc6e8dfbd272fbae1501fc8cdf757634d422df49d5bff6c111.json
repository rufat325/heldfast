{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Manage environment variables for a service. Actions: list (secrets masked unless showSecrets), create, update, bulk_update (pass envs array), delete (needs env_uuid).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "create",
     "update",
     "bulk_update",
     "delete"
    ],
    "type": "string"
   },
   "env_uuid": {
    "description": "Required for delete",
    "type": "string"
   },
   "envs": {
    "description": "For bulk_update: full list of env vars to apply",
    "items": {
     "properties": {
      "is_literal": {
       "type": "boolean"
      },
      "is_preview": {
       "type": "boolean"
      },
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "is_literal": {
    "type": "boolean"
   },
   "is_preview": {
    "type": "boolean"
   },
   "key": {
    "type": "string"
   },
   "showSecrets": {
    "type": "boolean"
   },
   "uuid": {
    "description": "Service UUID",
    "type": "string"
   },
   "value": {
    "type": "string"
   }
  },
  "required": [
   "uuid",
   "action"
  ],
  "type": "object"
 },
 "name": "serviceEnvs",
 "title": "Manage service env vars"
}

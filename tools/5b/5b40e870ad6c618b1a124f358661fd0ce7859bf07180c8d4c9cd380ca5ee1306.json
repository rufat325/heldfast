 "description": "Search ACLED political-violence and protest events. Filter by country (use \"|\" to OR, e.g., \"Ukraine|Russia\"), region, event_type, actor, ISO country code, or date range. Returns date, lat/lon, actors, event type, fatalities, and source notes.",
 "inputSchema": {
  "examples": [
   {
    "country": "Ukraine|Russia",
    "event_date_from": "2024-01-01",
    "event_date_to": "2024-12-31",
    "event_type": "Battles",
    "limit": 500
   },
   {
    "actor": "Civil society",
    "event_type": "Protests",
    "fatalities_min": 0,
    "limit": 100,
    "region": "Western Africa",
    "year": 2023
   }
  ],
  "properties": {
   "actor": {
    "description": "Match actor1 or actor2 (partial substring ok)",
    "type": "string"
   },
   "country": {
    "description": "Country name(s), pipe-separated for OR",
    "type": "string"
   },
   "event_date_from": {
    "description": "YYYY-MM-DD inclusive",
    "type": "string"
   },
   "event_date_to": {
    "description": "YYYY-MM-DD inclusive",
    "type": "string"
   },
   "event_type": {
    "description": "Battles | Protests | Riots | Explosions/Remote violence | Violence against civilians | Strategic developments",
    "type": "string"
   },
   "fatalities_min": {
    "description": "Minimum fatalities filter",
    "type": "number"
   },
   "iso": {
    "description": "ISO 3166-1 numeric country code (alternative to country)",
    "type": "number"
   },
   "limit": {
    "description": "Records to return (1-5000, default 100; ACLED max-per-call is 5000)",
    "type": "number"
   },
   "region": {
    "description": "ACLED region (e.g., \"Western Africa\")",
    "type": "string"
   },
   "sub_event_type": {
    "description": "Optional ACLED sub-event type",
    "type": "string"
   },
   "year": {
    "description": "Restrict to a calendar year",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },

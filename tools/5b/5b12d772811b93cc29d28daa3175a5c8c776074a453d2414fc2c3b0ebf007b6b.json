{
 "description": "Save a query as a feed (needs a key). Sources, kinds and tags narrow; q is a text match; upcoming keeps only future-dated items.",
 "inputSchema": {
  "properties": {
   "bbox": {
    "description": "west,south,east,north; west > east crosses the antimeridian",
    "type": "string"
   },
   "collection": {
    "description": "Collection slug",
    "type": "string"
   },
   "description": {
    "description": "Optional",
    "type": "string"
   },
   "enrichers": {
    "description": "Enrichers to show; omit for the collection defaults",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "kinds": {
    "description": "Item kinds",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "lat": {
    "description": "Query center latitude; requires long",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "long": {
    "description": "Query center longitude; requires lat",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "name": {
    "description": "Feed name",
    "type": "string"
   },
   "public": {
    "description": "Default true",
    "type": "boolean"
   },
   "q": {
    "description": "Text match",
    "type": "string"
   },
   "radius": {
    "description": "Default 10; maximum 1000 km",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "sort": {
    "enum": [
     "id",
     "published",
     "updated",
     "distance"
    ],
    "type": "string"
   },
   "sources": {
    "description": "Source slugs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tags": {
    "description": "Tags, any match",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "unit": {
    "description": "Default km",
    "enum": [
     "km",
     "mi"
    ],
    "type": "string"
   },
   "upcoming": {
    "type": "boolean"
   }
  },
  "required": [
   "collection",
   "name"
  ],
  "type": "object"
 },
 "name": "create_feed"
}

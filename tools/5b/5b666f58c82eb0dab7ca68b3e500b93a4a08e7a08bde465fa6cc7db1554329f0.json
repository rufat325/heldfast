{
 "_legacy": {
  "bucket": "discovery",
  "successor": "https://api.trusteed.xyz/demo-store/mcp/discovery"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read the content of a specific page on Trusteed. Pass the page slug (e.g. 'for-agents', 'pricing', 'blog') or a blog post slug. Use get_site_map first to discover available slugs. Pass page='blog' to list all blog posts.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "page": {
    "description": "Page slug (e.g. 'for-agents', 'pricing', 'trust') or blog post slug. Use 'blog' to list all blog posts.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "page"
  ],
  "type": "object"
 },
 "name": "get_page_content",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "category": {
    "type": "string"
   },
   "datePublished": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "excerpt": {
    "type": "string"
   },
   "found": {
    "type": "boolean"
   },
   "keywords": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "path": {
    "type": "string"
   },
   "posts": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "category": {
       "type": "string"
      },
      "datePublished": {
       "type": "string"
      },
      "excerpt": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "path",
      "title",
      "excerpt",
      "category",
      "datePublished"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "readingTime": {
    "type": "string"
   },
   "related_tools": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "slug": {
    "type": "string"
   },
   "suggestion": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "total": {
    "type": "number"
   },
   "type": {
    "enum": [
     "page",
     "blog_post",
     "blog_index"
    ],
    "type": "string"
   }
  },
  "type": "object"
 }
}

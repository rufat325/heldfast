{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Update a project"
 },
 "description": "Update a project: name, goal, owner, stage, health, dates, client stakeholder, or archive/reactivate it. Archiving hides it from list_projects but leaves its tasks intact.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "client": {
    "description": "Client to scope the project lookup to.",
    "type": "string"
   },
   "client_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "deadline": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "goal": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "health": {
    "description": "A judgement call, not a computed value. Pair it with health_note.",
    "enum": [
     "on_track",
     "at_risk",
     "off_track"
    ],
    "type": "string"
   },
   "health_note": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "owner_id": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "User id of the person accountable for the project."
   },
   "project": {
    "description": "Name or @handle of the project. Fuzzy-resolved.",
    "type": "string"
   },
   "project_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "stage": {
    "description": "Where the project is in its life. Sets status too.",
    "enum": [
     "planning",
     "active",
     "on_hold",
     "complete",
     "archived"
    ],
    "type": "string"
   },
   "stakeholder_email": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "stakeholder_name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "stakeholder_role": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "start_date": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "YYYY-MM-DD"
   },
   "status": {
    "enum": [
     "active",
     "archived"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_project",
 "title": "Update a project"
}

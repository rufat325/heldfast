{
 "description": "Cheap web search (Grok, cheaper tier than grok_search). Prefer this for routine lookups; use grok_search when answer quality matters more than cost. Put your QUERY in the 'query' parameter.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "max_search_results": {
    "type": "number"
   },
   "query": {
    "type": "string"
   },
   "recency": {
    "enum": [
     "all",
     "day",
     "week",
     "month",
     "year"
    ],
    "type": "string"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "allowed_websites": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "country": {
       "type": "string"
      },
      "type": {
       "enum": [
        "web",
        "news",
        "x",
        "rss"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "grok_search_lite"
}

{
 "description": "Register an AI agent as a trusted payer in the AP2 network. Defines the agent's identity, capabilities, and spending limits.",
 "inputSchema": {
  "properties": {
   "capabilities": {
    "description": "Agent capabilities",
    "items": {
     "enum": [
      "pay",
      "receive",
      "authorize",
      "audit"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "description": {
    "description": "Agent description and purpose",
    "type": "string"
   },
   "name": {
    "description": "Human-readable agent name",
    "type": "string"
   },
   "ownerEmail": {
    "description": "Owner email for notifications",
    "type": "string"
   },
   "spendLimit": {
    "description": "Spending limit for this agent",
    "properties": {
     "amount": {
      "description": "Maximum spend amount (e.g. '1000.00')",
      "type": "string"
     },
     "currency": {
      "description": "Currency code (e.g. 'USD')",
      "type": "string"
     },
     "period": {
      "description": "Limit period",
      "enum": [
       "per_transaction",
       "daily",
       "weekly",
       "monthly"
      ],
      "type": "string"
     }
    },
    "required": [
     "amount",
     "currency",
     "period"
    ],
    "type": "object"
   }
  },
  "required": [
   "name",
   "capabilities",
   "spendLimit"
  ],
  "type": "object"
 },
 "name": "register_agent"
}

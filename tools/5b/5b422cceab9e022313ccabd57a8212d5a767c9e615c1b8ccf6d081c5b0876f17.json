    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "page": {
    "type": "number"
   },
   "posting": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "company": {
        "anyOf": [
         {
          "type": "string"

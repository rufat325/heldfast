     }
    ]
   },
   "totalPages": {
    "type": "number"
   }
  },
  "required": [
   "mode",
   "matches",
   "page",
   "totalPages",
   "totalMatches",
   "newestJobMatchId",
   "notFoundIds",
   "posting"
  ],
  "type": "object"
 },
 "title": "Get Job Matches"

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Submit Async Job"
 },
 "description": "Submit an ASYNC bulk lookup job for up to 10000 North American phone numbers. Balance is reserved up front and the job runs in the background; check progress with vri_bulk_status. Requires a customer API key (jobs bill the account that owns the key).",
 "inputSchema": {
  "properties": {
   "phone_numbers": {
    "description": "US/Canada numbers to process asynchronously (max 10000)",
    "items": {
     "type": "string"
    },
    "maxItems": 10000,
    "type": "array"
   },
   "products": {
    "description": "Default ['lrn'].",
    "items": {
     "enum": [
      "lrn",
      "cnam",
      "spam",
      "messaging"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "phone_numbers"
  ],
  "type": "object"
 },
 "name": "vri_submit_job",
 "outputSchema": {
  "additionalProperties": true,
  "description": "Accepted job receipt",
  "properties": {
   "job_id": {
    "description": "Use with vri_bulk_status",
    "type": "string"
   },
   "reserved": {
    "description": "USD balance reserved for the job",
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Submit Async Job"
}

{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Publish a live timeline"
 },
 "description": "Publish a program as a live, shareable timeline (a public share link) and return its URL, with an ASCII Gantt and an itinerary. For a schedule the user wants to follow or share ('plan this so it all finishes at 6', 'when do I start each thing'). Validates first and refuses an invalid program with fix hints.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allowInvalid": {
    "default": false,
    "description": "Publish despite validation errors. Only when the user explicitly wants an imperfect draft shared.",
    "type": "boolean"
   },
   "program": {
    "additionalProperties": {},
    "description": "Program JSON; shape under validate_program.",
    "properties": {},
    "type": "object"
   }
  },
  "required": [
   "program"
  ],
  "type": "object"
 },
 "name": "visualize_schedule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "imageUrl": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "makespanSeconds": {
    "type": "number"
   },
   "shareId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "url": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "url",
   "shareId",
   "imageUrl",
   "makespanSeconds",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Publish a live timeline"
}

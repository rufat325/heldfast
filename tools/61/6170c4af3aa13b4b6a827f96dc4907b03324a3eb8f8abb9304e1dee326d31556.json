{
 "description": "Get the top Polymarket markets ranked by open interest (USDC locked in outstanding positions). This data is unique to the Open Interest subgraph \u2014 no other Polymarket subgraph tracks OI.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "first": {
    "default": 10,
    "description": "Number of markets to return (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "orderBy": {
    "default": "amount",
    "description": "Field to rank markets by",
    "enum": [
     "amount",
     "splitCount",
     "mergeCount",
     "lastUpdatedTimestamp"
    ],
    "type": "string"
   },
   "orderDirection": {
    "default": "desc",
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_market_open_interest"
}

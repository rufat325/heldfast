    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "desiredMarkupPercent": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "desiredProfitOMR": {
    "description": "OMR; calculations use integer baisa internally",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "laborOMR": {
    "default": 0,
    "description": "OMR; calculations use integer baisa internally",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "language": {
    "default": "en",
    "enum": [
     "ar",
     "en"
    ],
    "type": "string"
   },
   "marketingOMR": {
    "default": 0,
    "description": "OMR; calculations use integer baisa internally",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "otherVariableCostsOMR": {
    "default": 0,
    "description": "OMR; calculations use integer baisa internally",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "packagingOMR": {
    "default": 0,
    "description": "OMR; calculations use integer baisa internally",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "productCostOMR": {
    "description": "OMR; calculations use integer baisa internally",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [

    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "governorate": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "incomeLevel": {
    "maxLength": 100,
    "minLength": 1,

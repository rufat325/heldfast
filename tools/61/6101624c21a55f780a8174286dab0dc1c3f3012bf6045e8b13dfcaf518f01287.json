     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "problem": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "triggers": {
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   }

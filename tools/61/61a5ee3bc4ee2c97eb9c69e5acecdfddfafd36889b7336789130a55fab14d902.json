{
 "description": "Get recently received messages from the in-memory buffer. For older messages, use channel_history instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max messages to return (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "platform": {
    "description": "Filter by platform (omit for all)",
    "enum": [
     "telegram",
     "discord",
     "slack",
     "whatsapp"
    ],
    "type": "string"
   },
   "since": {
    "description": "Unix timestamp (ms) \u2014 only messages after this time",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "channel_receive"
}

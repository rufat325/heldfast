{
 "description": "Extract ASCII and UTF-16 strings from a binary file with filtering.",
 "inputSchema": {
  "properties": {
   "encoding": {
    "description": "Encoding: ascii, utf16, both (default: both)",
    "type": "string"
   },
   "file_path": {
    "description": "Path to the binary file",
    "type": "string"
   },
   "filter": {
    "description": "Optional filter (case-insensitive substring match)",
    "type": "string"
   },
   "max_results": {
    "description": "Max results (default 500)",
    "type": "number"
   },
   "min_length": {
    "description": "Minimum string length (default 4)",
    "type": "number"
   }
  },
  "required": [
   "file_path"
  ],
  "type": "object"
 },
 "name": "extract_strings_advanced"
}

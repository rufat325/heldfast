 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Set Entity Policy"
 },
 "description": "Replace server-side entity access policy. Optional action rules override read/write roles and can allow public create without public read, update, or delete. Omitting rules replaces any existing action rules with read/write role behavior.",
 "inputSchema": {
  "properties": {
   "app_id": {
    "description": "The app ID",
    "type": "string"
   },
   "entity": {
    "description": "Entity name, e.g. Booking",
    "type": "string"
   },
   "read": {
    "description": "Roles allowed to read when rules are omitted",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rules": {
    "additionalProperties": false,
    "description": "Nonempty unconditional action/role rules. No matching rule denies access. Include owner/admin actions explicitly. Record conditions are not supported by this MCP input.",
    "properties": {
     "rules": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "actions": {
         "items": {
          "enum": [
           "create",
           "read",
           "update",
           "delete",
           "write"
          ],
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        },
        "description": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "subject": {
         "additionalProperties": false,
         "properties": {
          "roles": {
           "items": {
            "type": "string"
           },
           "minItems": 1,
           "type": "array"
          }
         },
         "required": [
          "roles"
         ],
         "type": "object"
        }
       },
       "required": [
        "actions",
        "subject"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "version": {
      "enum": [
       1
      ],
      "type": "integer"
     }
    },
    "required": [
     "rules"
    ],
    "type": "object"
   },
   "write": {
    "description": "Roles allowed to write when rules are omitted",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "app_id",
   "entity",
   "read",
   "write"
  ],
  "type": "object"
 },
 "name": "set_entity_policy",
 "securitySchemes": [

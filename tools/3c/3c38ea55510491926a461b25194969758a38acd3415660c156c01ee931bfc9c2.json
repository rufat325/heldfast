{
 "description": "Compose a fake chat screenshot (iMessage, WhatsApp, Instagram DM, Telegram, Messenger, Snapchat) and get a deep link to the Mock Screenshots generator, pre-filled and ready to preview and download. Output is watermarked and clearly fictional; intended for parody, education, design mockups and fiction \u2014 not deception.",
 "inputSchema": {
  "properties": {
   "contact": {
    "description": "Contact name, username or group name shown in the header.",
    "type": "string"
   },
   "dark": {
    "description": "Dark mode. Defaults to false.",
    "type": "boolean"
   },
   "device": {
    "description": "Device frame. Defaults to iphone-16-pro.",
    "enum": [
     "iphone-16-pro",
     "iphone-16",
     "iphone-15-pro",
     "iphone-15",
     "iphone-14",
     "iphone-13",
     "iphone-se",
     "pixel-8-pro",
     "pixel-8",
     "galaxy-s24-ultra",
     "galaxy-s24"
    ],
    "type": "string"
   },
   "format": {
    "description": "Return an inline preview image (default) or just links.",
    "enum": [
     "image",
     "link"
    ],
    "type": "string"
   },
   "messages": {
    "description": "The conversation, in order.",
    "items": {
     "properties": {
      "author": {
       "description": "Sender name for group chats (incoming only).",
       "type": "string"
      },
      "sender": {
       "description": "\"me\" = the phone owner (right side).",
       "enum": [
        "me",
        "them"
       ],
       "type": "string"
      },
      "service": {
       "description": "iMessage blue vs SMS green.",
       "enum": [
        "imessage",
        "sms"
       ],
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "ticks": {
       "description": "WhatsApp/Telegram outgoing ticks.",
       "enum": [
        "sent",
        "delivered",
        "read"
       ],
       "type": "string"
      },
      "time": {
       "description": "Optional timestamp, e.g. \"20:14\".",
       "type": "string"
      }
     },
     "required": [
      "text",
      "sender"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "platform": {
    "description": "Which chat app to mimic.",
    "enum": [
     "imessage",
     "whatsapp",
     "whatsapp-group",
     "instagram",
     "telegram",
     "messenger",
     "snapchat"
    ],
    "type": "string"
   },
   "status": {
    "description": "Header status line, e.g. \"online\", \"Active now\", \"typing\u2026\".",
    "type": "string"
   }
  },
  "required": [
   "platform",
   "messages"
  ],
  "type": "object"
 },
 "name": "generate_fake_chat"
}

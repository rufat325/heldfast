{
 "description": "Open a dataset, estimate an OLS model, and open the same workflow in Gretl GUI by default.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "datasetPath": {
    "description": "Path to a Gretl-supported dataset.",
    "minLength": 1,
    "type": "string"
   },
   "dependentVariable": {
    "description": "Dependent variable name.",
    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
    "type": "string"
   },
   "displayInGretl": {
    "description": "Open a visible Gretl GUI script window for this workflow. Defaults to true outside CI.",
    "type": "boolean"
   },
   "gretlCliPath": {
    "type": "string"
   },
   "gretlGuiPath": {
    "type": "string"
   },
   "guiNewInstance": {
    "default": true,
    "type": "boolean"
   },
   "includeConstant": {
    "default": true,
    "type": "boolean"
   },
   "independentVariables": {
    "description": "Independent variable names.",
    "items": {
     "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "requireGui": {
    "description": "Require the visible Gretl GUI to open for this workflow. Defaults to true outside CI.",
    "type": "boolean"
   },
   "safeMode": {
    "default": false,
    "type": "boolean"
   },
   "timeoutSeconds": {
    "exclusiveMinimum": 0,
    "maximum": 300,
    "type": "integer"
   }
  },
  "required": [
   "datasetPath",
   "dependentVariable",
   "independentVariables"
  ],
  "type": "object"
 },
 "name": "gretl_ols"
}

 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "fileName": {
    "description": "File name for App Store (e.g., 01_home.png)",
    "type": "string"
   },
   "filePath": {
    "description": "Absolute path to the screenshot file on disk",
    "type": "string"
   },
   "screenshotSetId": {

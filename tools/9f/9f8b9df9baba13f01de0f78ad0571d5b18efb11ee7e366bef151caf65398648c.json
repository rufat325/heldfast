{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send an immediate reply to a message (linking it into that thread). fmsg messages are immutable: once sent they cannot be edited or recalled. Send within the user's requested task or authorized automation. By default the reply goes to everyone on the parent message \u2014 its sender, recipients and anyone added later \u2014 except you; pass recipients to narrow or widen that. Fails if the parent is terminal; a parent marked no-reply is refused unless allow_no_reply is true. Secrets are redacted and the count reported.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "allow_no_reply": {
    "default": false,
    "description": "reply even though the parent asked for no replies",
    "type": "boolean"
   },
   "attachments": {
    "items": {
     "properties": {
      "content_type": {
       "type": "string"
      },
      "data_base64": {
       "minLength": 1,
       "type": "string"
      },
      "filename": {
       "pattern": "^[A-Za-z0-9._-]+$",
       "type": "string"
      }
     },
     "required": [
      "filename",
      "data_base64"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "body": {
    "type": "string"
   },
   "id": {
    "description": "message to reply to",
    "pattern": "^[0-9]+$",
    "type": "string"
   },
   "important": {
    "default": false,
    "type": "boolean"
   },
   "no_reply": {
    "default": false,
    "type": "boolean"
   },
   "recipients": {
    "description": "override the reply-all recipient set",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "default": "text/markdown; charset=utf-8",
    "type": "string"
   }
  },
  "required": [
   "id",
   "body"
  ],
  "type": "object"
 },
 "name": "reply",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "attachments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "filename": {
       "type": "string"
      },
      "size": {
       "type": "number"
      }
     },
     "required": [
      "filename",
      "size"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "parent_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "redactions": {
    "description": "secrets replaced with placeholders before sending",
    "type": "number"
   },
   "time": {
    "type": [
     "string",
     "null"
    ]
   },
   "to": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "topic": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "time",
   "from",
   "to",
   "topic",
   "parent_id",
   "attachments",
   "redactions",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Reply in fmsg thread"
}

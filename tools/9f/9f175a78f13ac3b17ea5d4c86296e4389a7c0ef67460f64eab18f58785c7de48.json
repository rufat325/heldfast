{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set Role Deal Defaults"
 },
 "description": "Set a community's standing ticket-split offer per member role (e.g. staff events run 70/30; \"__member__\" = the member's leg). Becomes a real deal only when a member confirms the shown terms at event submission. Admin-only. Requires community_id + by_role.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "by_role": {
    "additionalProperties": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "splits": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "recipient_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
           },
           "recipient_type": {
            "enum": [
             "producer",
             "community"
            ],
            "type": "string"
           },
           "share_value": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
           }
          },
          "required": [
           "recipient_id",
           "recipient_type",
           "share_value"
          ],
          "type": "object"
         },
         "maxItems": 20,
         "minItems": 1,
         "type": "array"
        }
       },
       "required": [
        "splits"
       ],
       "type": "object"
      },
      {
       "type": "null"
      }
     ]
    },
    "propertyNames": {
     "enum": [
      "admin",
      "moderator",
      "staff",
      "member"
     ],
     "type": "string"
    },
    "type": "object"
   },
   "community_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "community_id",
   "by_role"
  ],
  "type": "object"
 },
 "name": "set_role_deal_defaults",
 "title": "Set Role Deal Defaults"
}

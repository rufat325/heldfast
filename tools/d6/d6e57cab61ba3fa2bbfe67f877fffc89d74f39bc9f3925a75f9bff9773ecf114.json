    "description": "The date the purchase order was issued (YYYY-MM-DD format). Defaults to today.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "deliveryDate": {
    "description": "The date the goods are to be delivered (YYYY-MM-DD format).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },

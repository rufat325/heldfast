{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Match talent to a job"
 },
 "description": "[AlgeriaCertify] Recruitment matchmaker: given a job description or a list of required skills (plus optional specialty/wilaya), returns the best-matching certified professionals in Algeria, ranked by skill overlap, trust score and availability. Each result includes a match score, the matched terms, verified certifications and the public profile URL.",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "The job description or required skills/keywords (free text, any language).",
    "type": "string"
   },
   "limit": {
    "description": "Max candidates (1-25, default 8).",
    "type": "integer"
   },
   "open_to_work": {
    "description": "Only candidates open to work.",
    "type": "boolean"
   },
   "specialty": {
    "description": "Optional specialty / job-title filter.",
    "type": "string"
   },
   "wilaya": {
    "description": "Optional wilaya: code, Arabic or English name.",
    "type": "string"
   }
  },
  "required": [
   "description"
  ],
  "type": "object"
 },
 "name": "certify__match_talent_to_job",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "results": {
    "items": {
     "properties": {
      "certifications": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "experience_years": {
       "type": [
        "integer",
        "null"
       ]
      },
      "headline": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "open_to_work": {
       "type": "boolean"
      },
      "profile_url": {
       "type": "string"
      },
      "wilaya": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}

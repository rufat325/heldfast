{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Queue a text-to-speech voiceover into the BlitzReels media library. Spends AI credits and returns a job to poll with generation_jobs_get.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "speed": {
    "default": 1,
    "description": "Speaking rate between 0.5 and 1.6.",
    "maximum": 1.6,
    "minimum": 0.5,
    "type": "number"
   },
   "text": {
    "description": "Script to read aloud (3-8000 characters).",
    "maxLength": 8000,
    "minLength": 3,
    "type": "string"
   },
   "voiceId": {
    "default": "pNInz6obpgDQGcFmaJgB",
    "description": "Voice ID. Call generation_options_list with kind voiceover for the catalog.",
    "enum": [
     "pNInz6obpgDQGcFmaJgB",
     "TX3LPaxmHKxFdv7VOQHJ",
     "FGY2WhTYpPnrIDTdsKH5",
     "IKne3meq5aSn9XLyUdCD",
     "cgSgspJ2msm6clMCkdW9",
     "bIHbv24MWmeRgasZH58o",
     "nPczCjzI2devNBz1zQrb",
     "JBFqnCBsd6RMkjVDRZzb",
     "SOYHLrjzK2X1ezoPC6cr",
     "N2lVS1w4EtoT3dr4eOWO",
     "S9EGwlCtMF7VXtENq79v",
     "VhxAIIZM8IRmnl5fyeyk",
     "hpp4J3VqNfWAUOO0d1Us",
     "EXAVITQu4vr4xnSDxMaL",
     "pFZP5JQG7iQjIQuC4Bku",
     "SAz9YHcvj6GT2YYXdXww",
     "Xb7hH8MSUJpSbSDYk0k2",
     "XrExE9yKIg1WjnnlVkGX",
     "onwK4e9ZLuTAKqWW03F9",
     "pqHfZKP75CvOlQylNhV4",
     "CwhRBWXzGAHq8TQ4Fs17",
     "cjVigY5qzO86Huf0OWal",
     "iP95p4xoKVk53GoZ742B"
    ],
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "voiceStyle": {
    "default": "neutral",
    "description": "Delivery emotion.",
    "enum": [
     "curiosity",
     "intrigue",
     "urgency",
     "tension",
     "concern",
     "surprise",
     "hope",
     "satisfaction",
     "inspiration",
     "revelation",
     "neutral"
    ],
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "generation_voiceover_create",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "generation": {
    "properties": {
     "estimated_credits": {
      "type": [
       "number",
       "null"
      ]
     },
     "job_id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "image",
       "video",
       "voiceover",
       "music",
       "sound",
       "faceless"
      ],
      "type": "string"
     },
     "media_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "mutationReceipt": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "key": {
        "type": [
         "string",
         "null"
        ]
       },
       "operation": {
        "type": "string"
       },
       "replayed": {
        "type": "boolean"
       },
       "status": {
        "enum": [
         "completed"
        ],
        "type": "string"
       }
      },
      "required": [
       "id",
       "key",
       "operation",
       "status",
       "replayed"
      ],
      "type": "object"
     },
     "project_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "job_id",
     "kind",
     "status",
     "mutationReceipt"
    ],
    "type": "object"
   }
  },
  "required": [
   "generation"
  ],
  "type": "object"
 },
 "title": "Generate Voiceover"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Analyze a paycheck to verify withholding accuracy. Input your pay stub numbers and see if your employer is withholding the right amount.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "federalWithheld": {
    "description": "Federal tax withheld this period",
    "minimum": 0,
    "type": "number"
   },
   "filingStatus": {
    "enum": [
     "single",
     "married_filing_jointly",
     "married_filing_separately",
     "head_of_household"
    ],
    "type": "string"
   },
   "grossPay": {
    "description": "Gross pay this period",
    "minimum": 0,
    "type": "number"
   },
   "hsaContribution": {
    "description": "HSA contribution this period",
    "minimum": 0,
    "type": "number"
   },
   "medicareWithheld": {
    "description": "Medicare withheld",
    "minimum": 0,
    "type": "number"
   },
   "payFrequency": {
    "enum": [
     "weekly",
     "biweekly",
     "semimonthly",
     "monthly"
    ],
    "type": "string"
   },
   "retirement401k": {
    "description": "401k/403b pre-tax contribution this period",
    "minimum": 0,
    "type": "number"
   },
   "socialSecurityWithheld": {
    "description": "Social Security withheld",
    "minimum": 0,
    "type": "number"
   },
   "stateCode": {
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "stateWithheld": {
    "description": "State tax withheld this period",
    "minimum": 0,
    "type": "number"
   },
   "taxYear": {
    "description": "Tax year",
    "type": "number"
   }
  },
  "required": [
   "taxYear",
   "filingStatus",
   "payFrequency",
   "grossPay",
   "federalWithheld"
  ],
  "type": "object"
 },
 "name": "analyze_paycheck",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "suggestion"
    ],
    "type": "object"
   },
   "isError": {
    "type": "boolean"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "isError"
  ],
  "type": "object"
 }
}

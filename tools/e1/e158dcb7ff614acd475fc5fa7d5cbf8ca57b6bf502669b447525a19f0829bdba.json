{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find Companies"
 },
 "description": "Multi-axis company segmentation. Analyst tier. Filter by industry, role family they're hiring for, top-skill match, hiring trend, job-count range. Returns companies sorted by total open jobs descending. Use for 'fintech companies hiring ML engineers', 'defense tech companies scaling up', or 'who's hiring 100+ engineers and growing?'. Not for a simple name or industry lookup \u2014 use `search_companies` for that.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "family": {
    "description": "Only companies hiring for this role family (e.g. 'machine_learning'). Omit to include all families. ANDs with the other filters.",
    "enum": [
     "software_engineering",
     "data_engineering",
     "machine_learning",
     "security",
     "product",
     "design",
     "operations",
     "marketing",
     "sales",
     "finance",
     "people",
     "services",
     "legal",
     "other"
    ],
    "type": "string"
   },
   "industry": {
    "description": "Industry substring filter (case-insensitive). E.g. 'fintech', 'health', 'AI', 'defense'.",
    "type": "string"
   },
   "limit": {
    "description": "Max companies to return (1-100, default 25)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "maxJobs": {
    "description": "Maximum total open jobs (default unlimited)",
    "minimum": 0,
    "type": "integer"
   },
   "minJobs": {
    "description": "Minimum total open jobs (default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "skill": {
    "description": "Only companies whose top skills include this (case-insensitive substring, e.g. 'Rust'). Omit to skip skill filtering.",
    "type": "string"
   },
   "trend": {
    "description": "Hiring trend filter, from each company's 2-month rolling job-count average: 'up' = growing, 'down' = shrinking, 'stable' = flat.",
    "enum": [
     "up",
     "down",
     "stable"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_companies",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "citation_url": {
    "description": "hirejack.com URL to cite when surfacing this result",
    "type": "string"
   },
   "data": {
    "additionalProperties": true,
    "description": "Companies matching the segmentation filters",
    "properties": {
     "companies": {
      "description": "Matching companies, most open jobs first",
      "items": {
       "additionalProperties": true,
       "properties": {
        "companyName": {
         "type": "string"
        },
        "domain": {
         "description": "Pass to get_company_profile / get_company_history / company_fit",
         "type": "string"
        },
        "engineeringJobs": {
         "type": "number"
        },
        "hiringTrend": {
         "description": "'up' | 'down' | 'stable'",
         "type": "string"
        },
        "industry": {
         "type": "string"
        },
        "medianSalary": {
         "description": "Annual USD, when enough postings disclose pay",
         "nullable": true,
         "type": "number"
        },
        "topSkills": {
         "description": "Capped at 5",
         "items": {
          "additionalProperties": true,
          "properties": {
           "name": {
            "type": "string"
           },
           "pct": {
            "description": "Share of the company's postings mentioning the skill, 0-100",
            "type": "number"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "totalJobs": {
         "type": "number"
        },
        "trendPct": {
         "description": "Trend magnitude, % change",
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "filters": {
      "additionalProperties": true,
      "description": "Echo of the applied filters",
      "properties": {},
      "type": "object"
     },
     "matched": {
      "description": "Companies matching the filters (before the limit)",
      "type": "number"
     },
     "returned": {
      "description": "Companies in this response",
      "type": "number"
     }
    },
    "type": "object"
   },
   "meta": {
    "additionalProperties": true,
    "description": "Request/response metadata (pagination cursors, snapshot timestamps, applied filters)",
    "properties": {},
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "title": "Find Companies"
}

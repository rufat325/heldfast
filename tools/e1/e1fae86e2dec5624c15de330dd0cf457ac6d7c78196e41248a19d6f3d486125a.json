    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "criteria": {
    "default": {
     "currency": "USD",
     "decisionMakerRequired": false,
     "requiredInterest": false,
     "targetTimelineDays": 30
    },
    "properties": {
     "currency": {
      "default": "USD",
      "maxLength": 3,
      "minLength": 3,
      "type": "string"
     },
     "decisionMakerRequired": {
      "default": false,
      "type": "boolean"
     },
     "minimumBudget": {
      "minimum": 0,
      "type": "number"
     },
     "requiredInterest": {
      "default": false,
      "type": "boolean"
     },
     "targetTimelineDays": {
      "default": 30,
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "language": {
    "enum": [
     "en",
     "ar"
    ],
    "type": "string"
   },
   "maxDurationSeconds": {
    "default": 300,
    "maximum": 3600,
    "minimum": 1,
    "type": "integer"
   },
   "phoneNumber": {
    "pattern": "^\\+[1-9]\\d{7,14}$",
    "type": "string"
   },
   "safety": {
    "properties": {
     "consentNotice": {
      "maxLength": 500,
      "type": "string"
     },
     "recording": {
      "default": false,
      "type": "boolean"
     },
     "timezone": {
      "maxLength": 100,
      "type": "string"
     },
     "transcription": {
      "default": false,
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "phoneNumber",
   "language"
  ],
  "type": "object"
 },

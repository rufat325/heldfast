{
 "_meta": {
  "ui": {
   "resourceUri": "ui://template-data-explorer/app.html"
  },
  "ui/resourceUri": "ui://template-data-explorer/app.html"
 },
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generates sample sales data and renders an interactive explorer. Users can sort columns, filter rows, and select entries directly in the UI. Hosts without MCP Apps support receive a text table.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Parameters for generating sample sales data.",
  "properties": {
   "rowCount": {
    "default": 20,
    "description": "Number of sample rows to generate (5\u2013100).",
    "maximum": 100,
    "minimum": 5,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "template_data_explorer",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Sales data explorer response payload.",
  "properties": {
   "generatedAt": {
    "description": "ISO 8601 timestamp when data was generated.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
    "type": "string"
   },
   "rows": {
    "description": "Generated sales data rows.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "description": "Sale date (YYYY-MM-DD).",
       "type": "string"
      },
      "id": {
       "description": "Unique row identifier.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "product": {
       "description": "Product name.",
       "type": "string"
      },
      "region": {
       "description": "Sales region name.",
       "type": "string"
      },
      "revenue": {
       "description": "Revenue in USD.",
       "type": "number"
      },
      "units": {
       "description": "Units sold.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "id",
      "region",
      "product",
      "units",
      "revenue",
      "date"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "additionalProperties": false,
    "description": "Aggregate summary of the dataset.",
    "properties": {
     "totalRevenue": {
      "description": "Sum of all revenue.",
      "type": "number"
     },
     "totalRows": {
      "description": "Total number of rows.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "totalUnits": {
      "description": "Sum of all units sold.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "totalRows",
     "totalRevenue",
     "totalUnits"
    ],
    "type": "object"
   }
  },
  "required": [
   "rows",
   "generatedAt",
   "summary"
  ],
  "type": "object"
 },
 "title": "Template Data Explorer"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Ask a wellness question; composes detected connectors in parallel and returns a synthesized answer + reasoning trace. Spawns subprocesses \u2014 requires explicit_user_intent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "explicit_user_intent": {
    "const": true,
    "description": "Required confirmation that the caller is acting on explicit user intent. living_body_ask spawns multiple wellness MCP subprocesses; agents must not call it speculatively.",
    "type": "boolean"
   },
   "privacy_mode": {
    "description": "Passed down to child connectors. Defaults to 'structured'. 'raw' is only honored with explicit_user_intent and is discouraged for routine composition.",
    "enum": [
     "summary",
     "structured",
     "raw"
    ],
    "type": "string"
   },
   "question": {
    "description": "Natural language question about training, recovery, sleep, nutrition or readiness.",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "sources": {
    "description": "Restrict composition to a subset of detected connectors. Defaults to all detected.",
    "items": {
     "enum": [
      "whoop",
      "oura",
      "garmin",
      "strava",
      "fitbit",
      "google_health",
      "withings",
      "apple_health",
      "samsung_health",
      "polar",
      "eight_sleep",
      "nourish",
      "air",
      "cycle_coach",
      "cgm"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "question",
   "explicit_user_intent"
  ],
  "type": "object"
 },
 "name": "living_body_ask",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "child_tool_mode": {
    "enum": [
     "context",
     "daily_summary",
     "series"
    ],
    "type": "string"
   },
   "confidence": {
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "data_snapshot": {
    "additionalProperties": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "generated_at": {
    "type": "string"
   },
   "reasoning": {
    "type": "string"
   },
   "recommendation": {
    "type": "string"
   },
   "sources_failed": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "note": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "status": {
       "enum": [
        "timeout",
        "error",
        "skipped"
       ],
       "type": "string"
      }
     },
     "required": [
      "source",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sources_used": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "recommendation",
   "reasoning",
   "sources_used",
   "confidence",
   "data_snapshot",
   "sources_failed",
   "generated_at"
  ],
  "type": "object"
 },
 "title": "Living Body \u2014 Ask"
}

{
 "description": "Create a new WordPress post",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categories": {
    "description": "Category IDs",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "content": {
    "description": "Post content (HTML)",
    "type": "string"
   },
   "excerpt": {
    "description": "Post excerpt",
    "type": "string"
   },
   "featured_media": {
    "description": "Featured image ID",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "default": "draft",
    "description": "Post status",
    "enum": [
     "publish",
     "future",
     "draft",
     "pending",
     "private",
     "trash"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tag IDs",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "title": {
    "description": "Post title",
    "type": "string"
   }
  },
  "required": [
   "site",
   "title"
  ],
  "type": "object"
 },
 "name": "wp_create_post"
}

{
 "description": "Refund, approve, or decline ask-to-buy for a StoreKit test transaction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action: \"refund\" a transaction, \"approve-ask-to-buy\", or \"decline-ask-to-buy\"",
    "enum": [
     "refund",
     "approve-ask-to-buy",
     "decline-ask-to-buy"
    ],
    "type": "string"
   },
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "transactionId": {
    "description": "Transaction ID",
    "type": "string"
   }
  },
  "required": [
   "action",
   "transactionId"
  ],
  "type": "object"
 },
 "name": "simulator_storekit_manage_transaction"
}

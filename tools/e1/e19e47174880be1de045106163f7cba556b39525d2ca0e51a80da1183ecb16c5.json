{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Validate a SEMANTIC LAYER document (term\u2192predicate glossary + named SPARQL metrics) before trusting it: structure, required fields (term/target, name/sparql), metric names usable as identifiers, and uniqueness. Returns {ok, errors, warnings}. This is \"semantics as code\": define once, compute the same everywhere.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "semantic": {
    "additionalProperties": false,
    "description": "Semantic layer: { glossary: [{term,target,synonyms?}], metrics: [{name,label?,sparql}] }",
    "properties": {
     "glossary": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "note": {
         "type": "string"
        },
        "synonyms": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "target": {
         "type": "string"
        },
        "term": {
         "type": "string"
        }
       },
       "required": [
        "term",
        "target"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "metrics": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "label": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "note": {
         "type": "string"
        },
        "sparql": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "sparql"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "semantic"
  ],
  "type": "object"
 },
 "name": "kg_semantic_validate"
}

{
 "_legacy": {
  "bucket": "discovery",
  "successor": "https://api.trusteed.xyz/demo-store/mcp/discovery"
 },
 "_meta": {
  "openai/outputTemplate": "ui://widget/merchant-trust.html",
  "openai/toolInvocation/invoked": "Perfil del comercio",
  "openai/toolInvocation/invoking": "Consultando el perfil del comercio\u2026",
  "ui": {
   "resourceUri": "ui://widget/merchant-trust.html"
  },
  "ui/resourceUri": "ui://widget/merchant-trust.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the complete profile \u2014 trust score, policies, compliance, and protocol support \u2014 of the merchant this MCP endpoint belongs to. Takes NO parameters: the merchant is fixed by which store's /:storeSlug/mcp endpoint you connected to, not by an argument. To read a different merchant's profile, call this same tool on that merchant's own endpoint instead.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {},
  "type": "object"
 },
 "name": "get_merchant_profile",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "acpFeedUrl": {
    "type": "string"
   },
   "agentPolicySummary": {
    "additionalProperties": true,
    "properties": {
     "allowedShippingCountries": {
      "additionalProperties": true,
      "properties": {
       "countries": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "derivedFrom": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "countries",
       "derivedFrom"
      ],
      "type": "object"
     },
     "confirmationRequiredAtOrAbove": {
      "$ref": "#/properties/agentPolicySummary/properties/maxCartValue"
     },
     "maxCartValue": {
      "additionalProperties": true,
      "properties": {
       "amountCents": {
        "type": "number"
       },
       "derivedFrom": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "amountCents",
       "derivedFrom"
      ],
      "type": "object"
     },
     "maxUnitsPerLine": {
      "additionalProperties": true,
      "properties": {
       "derivedFrom": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "units": {
        "type": "integer"
       }
      },
      "required": [
       "units",
       "derivedFrom"
      ],
      "type": "object"
     },
     "source": {
      "enum": [
       "merchant_rules",
       "platform_ceiling",
       "not_configured",
       "lookup_failed"
      ],
      "type": "string"
     }
    },
    "required": [
     "source"
    ],
    "type": "object"
   },
   "compliance": {
    "additionalProperties": true,
    "properties": {
     "dataRetentionDays": {
      "description": "Retention window as declared by the merchant. Absent = not declared; absence is NOT 'data is deleted immediately'.",
      "type": "number"
     },
     "encryptionAtRest": {
      "type": "string"
     },
     "encryptionInTransit": {
      "type": "string"
     },
     "gdprContactEmail": {
      "type": "string"
     },
     "gdprDataController": {
      "type": "string"
     },
     "pciDssLevel": {
      "description": "PCI DSS merchant level as declared by the merchant (1-4). Absent = not declared.",
      "type": "number"
     },
     "provenance": {
      "$ref": "#/properties/identity/properties/provenance"
     },
     "verified": {
      "$ref": "#/properties/identity/properties/verified"
     }
    },
    "type": "object"
   },
   "discovery": {
    "additionalProperties": true,
    "properties": {
     "agUiEndpoint": {
      "type": "string"
     },
     "agentCard": {
      "type": "string"
     },
     "agentPolicy": {
      "type": "string"
     },
     "llmsTxt": {
      "type": "string"
     },
     "mcpEndpoint": {
      "type": "string"
     },
     "ucpProfile": {
      "type": "string"
     }
    },
    "required": [
     "mcpEndpoint",
     "agUiEndpoint",
     "agentCard",
     "agentPolicy",
     "ucpProfile",
     "llmsTxt"
    ],
    "type": "object"
   },
   "enrichedCatalogEnabled": {
    "type": "boolean"
   },
   "identity": {
    "additionalProperties": true,
    "properties": {
     "address": {
      "additionalProperties": true,
      "properties": {
       "city": {
        "type": "string"
       },
       "country": {
        "type": "string"
       },
       "postalCode": {
        "type": "string"
       },
       "state": {
        "type": "string"
       },
       "street": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "contact": {
      "additionalProperties": true,
      "properties": {
       "chat": {
        "type": "string"
       },
       "email": {
        "type": "string"
       },
       "phone": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "legalName": {
      "type": "string"
     },
     "provenance": {
      "const": "synthetic_demo",
      "description": "Present only on showcase/demo stores: this block is synthetic demo data, not a real seller's claim.",
      "type": "string"
     },
     "taxId": {
      "type": "string"
     },
     "verified": {
      "const": false,
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "identityLinkingEnabled": {
    "type": "boolean"
   },
   "identityProviderType": {
    "type": [
     "string",
     "null"
    ]
   },
   "manifest_hash": {
    "type": "string"
   },
   "manifest_jws": {
    "type": [
     "string",
     "null"
    ]
   },
   "manifest_signed_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "policies": {
    "additionalProperties": true,
    "properties": {
     "payment": {
      "additionalProperties": true,
      "description": "Merchant-declared payment policy. Absent = not declared; ask at checkout.",
      "properties": {
       "acceptedMethods": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "provenance": {
        "$ref": "#/properties/identity/properties/provenance"
       },
       "securityStandard": {
        "type": "string"
       },
       "verified": {
        "$ref": "#/properties/identity/properties/verified"
       },
       "withheldMethods": {
        "items": {
         "additionalProperties": true,
         "properties": {
          "method": {
           "type": "string"
          },
          "reason": {
           "type": "string"
          }
         },
         "required": [
          "method",
          "reason"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "type": "object"
     },
     "returns": {
      "additionalProperties": true,
      "description": "Merchant-declared return policy. Absent = not declared; absence is NEVER zero.",
      "properties": {
       "freeReturnShipping": {
        "type": "string"
       },
       "provenance": {
        "$ref": "#/properties/identity/properties/provenance"
       },
       "refundMethod": {
        "type": "string"
       },
       "refundProcessingDays": {
        "type": "number"
       },
       "verified": {
        "$ref": "#/properties/identity/properties/verified"
       },
       "windowDays": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "shipping": {
      "additionalProperties": true,
      "description": "Merchant-declared shipping policy for the merchant's OWN checkout. Absent = not declared. An absent freeThresholdCents is NOT 'free shipping on everything', and a declared one is NOT applied by get_shipping_rates: those rates are flat estimates that ignore the cart subtotal. Delivery days here may differ from the estimates too.",
      "properties": {
       "expressPrice": {
        "type": "number"
       },
       "freeThresholdCents": {
        "type": "number"
       },
       "overnightPrice": {
        "type": "number"
       },
       "provenance": {
        "$ref": "#/properties/identity/properties/provenance"
       },
       "standardDeliveryDays": {
        "type": "string"
       },
       "verified": {
        "$ref": "#/properties/identity/properties/verified"
       }
      },
      "type": "object"
     },
     "warranty": {
      "additionalProperties": true,
      "description": "Merchant-declared warranty. Absent = not declared, NOT 'no warranty'.",
      "properties": {
       "covered": {
        "type": "string"
       },
       "periodYears": {
        "type": "number"
       },
       "provenance": {
        "$ref": "#/properties/identity/properties/provenance"
       },
       "verified": {
        "$ref": "#/properties/identity/properties/verified"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "protocolScopeNote": {
    "type": "string"
   },
   "protocols": {
    "additionalProperties": true,
    "properties": {
     "acp": {
      "additionalProperties": true,
      "properties": {
       "enabled": {
        "type": "boolean"
       },
       "provider": {
        "type": "string"
       }
      },
      "required": [
       "enabled",
       "provider"
      ],
      "type": "object"
     },
     "ap2": {
      "additionalProperties": true,
      "properties": {
       "enabled": {
        "type": "boolean"
       },
       "provider": {
        "type": "string"
       }
      },
      "required": [
       "enabled",
       "provider"
      ],
      "type": "object"
     },
     "ucp": {
      "additionalProperties": true,
      "properties": {
       "enabled": {
        "type": "boolean"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "enabled",
       "version"
      ],
      "type": "object"
     },
     "vic": {
      "additionalProperties": true,
      "properties": {
       "enabled": {
        "type": "boolean"
       },
       "environment": {
        "type": "string"
       }
      },
      "required": [
       "enabled",
       "environment"
      ],
      "type": "object"
     },
     "x402": {
      "additionalProperties": true,
      "properties": {
       "enabled": {
        "type": "boolean"
       },
       "provider": {
        "type": "string"
       }
      },
      "required": [
       "enabled",
       "provider"
      ],
      "type": "object"
     }
    },
    "required": [
     "acp",
     "ap2",
     "x402"
    ],
    "type": "object"
   },
   "store": {
    "additionalProperties": true,
    "properties": {
     "description": {
      "type": "string"
     },
     "isDemo": {
      "type": "boolean"
     },
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "slug",
     "description",
     "isDemo"
    ],
    "type": "object"
   },
   "supportedProtocols": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "description": {
       "type": "string"
      },
      "mode": {
       "enum": [
        "live",
        "sandbox",
        "coming_soon"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "mode",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "trust": {
    "additionalProperties": true,
    "properties": {
     "componentsSourceOfTruth": {
      "description": "Canonical source for the components behind overallScore.",
      "type": "string"
     },
     "legacyV2Components": {
      "additionalProperties": true,
      "description": "Legacy v2 self-declared breakdown (0-1). Does NOT explain overallScore (v4.1). For the components behind the published score call GET /api/v1/stores/{slug}/trust-score. Omitted when every value is zero.",
      "properties": {
       "catalogCompleteness": {
        "type": "number"
       },
       "dataFreshness": {
        "type": "number"
       },
       "policyClarity": {
        "type": "number"
       },
       "priceAccuracy": {
        "type": "number"
       },
       "responseTime": {
        "type": "number"
       },
       "returnRate": {
        "type": "number"
       },
       "stockReliability": {
        "type": "number"
       },
       "verificationDepth": {
        "type": "number"
       }
      },
      "required": [
       "catalogCompleteness",
       "dataFreshness",
       "priceAccuracy",
       "stockReliability",
       "policyClarity",
       "responseTime",
       "returnRate",
       "verificationDepth"
      ],
      "type": "object"
     },
     "overallScore": {
      "description": "Trust score, engine v4.1, scale 0-100. null = not published.",
      "type": [
       "number",
       "null"
      ]
     },
     "scoringVersion": {
      "description": "Engine version behind overallScore ('4.1'), null when absent.",
      "type": [
       "string",
       "null"
      ]
     },
     "verificationLevel": {
      "type": "string"
     },
     "verificationProvenance": {
      "enum": [
       "seeded",
       "verified"
      ],
      "type": "string"
     }
    },
    "required": [
     "overallScore",
     "scoringVersion",
     "verificationLevel",
     "verificationProvenance",
     "componentsSourceOfTruth"
    ],
    "type": "object"
   }
  },
  "required": [
   "store",
   "identity",
   "trust",
   "policies",
   "compliance",
   "protocols",
   "supportedProtocols",
   "protocolScopeNote",
   "agentPolicySummary",
   "discovery",
   "identityLinkingEnabled",
   "identityProviderType",
   "acpFeedUrl",
   "enrichedCatalogEnabled",
   "manifest_hash",
   "manifest_signed_at",
   "manifest_jws"
  ],
  "type": "object"
 }
}

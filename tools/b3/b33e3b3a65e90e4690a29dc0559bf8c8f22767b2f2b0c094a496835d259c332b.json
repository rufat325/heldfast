{
 "description": "Fetch a single memory by ID from a store.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "The memory ID",
    "minLength": 1,
    "type": "string"
   },
   "instanceId": {
    "description": "Optional instance ID override",
    "type": "string"
   },
   "memory_name": {
    "description": "The memory store name (from memory_stores)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "memory_name",
   "id"
  ],
  "type": "object"
 },
 "name": "memory_get"
}

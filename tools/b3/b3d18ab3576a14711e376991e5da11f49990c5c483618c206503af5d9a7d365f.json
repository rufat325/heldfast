{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs ESLint and returns structured diagnostics (file, line, column, rule, severity, message).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cache": {
    "description": "Cache lint results for faster subsequent runs (maps to --cache)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "config": {
    "description": "Path to ESLint configuration file (maps to --config)",
    "maxLength": 4096,
    "type": "string"
   },
   "fix": {
    "default": false,
    "description": "Auto-fix problems",
    "type": "boolean"
   },
   "fixDryRun": {
    "description": "Preview fixes without writing them (maps to --fix-dry-run)",
    "type": "boolean"
   },
   "fixType": {
    "description": "Types of fixes to apply (maps to --fix-type). Requires --fix or --fix-dry-run.",
    "items": {
     "enum": [
      "problem",
      "suggestion",
      "layout",
      "directive"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "type": "array"
   },
   "maxWarnings": {
    "description": "Maximum number of warnings before failing (maps to --max-warnings). Use -1 for no limit.",
    "maximum": 9007199254740991,
    "minimum": -1,
    "type": "integer"
   },
   "noIgnore": {
    "description": "Disable ignore patterns to lint normally-ignored files (maps to --no-ignore)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "."
    ],
    "description": "File patterns to lint (default: ['.'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "quiet": {
    "description": "Report errors only, suppress warnings (maps to --quiet)",
    "type": "boolean"
   },
   "rule": {
    "description": "Ad-hoc rule overrides, e.g. ['no-console: error'] (maps to --rule)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "lint",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deprecationCount": {
    "type": "number"
   },
   "deprecations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reference": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "severity",
      "rule",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnosticsTruncated": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "errors": {
    "type": "number"
   },
   "exitCode": {
    "type": "number"
   },
   "filesChecked": {
    "type": "number"
   },
   "fixableErrorCount": {
    "type": "number"
   },
   "fixableWarningCount": {
    "type": "number"
   },
   "omittedCount": {
    "type": "number"
   },
   "warnings": {
    "type": "number"
   }
  },
  "required": [
   "errors",
   "warnings",
   "filesChecked"
  ],
  "type": "object"
 },
 "title": "ESLint Check"
}

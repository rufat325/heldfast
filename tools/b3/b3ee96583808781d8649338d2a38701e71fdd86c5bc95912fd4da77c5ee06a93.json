{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read bounded project context for editing, including timeline items, media assets, transcripts, captions, and stable IDs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assetLimit": {
    "description": "Maximum media assets to return (1-50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "assetOffset": {
    "description": "Media asset offset.",
    "minimum": 0,
    "type": "integer"
   },
   "captionWordLimit": {
    "description": "Maximum caption words to return (1-2000).",
    "maximum": 2000,
    "minimum": 1,
    "type": "integer"
   },
   "captionWordOffset": {
    "description": "Caption word offset.",
    "minimum": 0,
    "type": "integer"
   },
   "mode": {
    "default": "timeline",
    "description": "Bounded project context view to return.",
    "enum": [
     "summary",
     "assets",
     "timeline",
     "transcript",
     "full"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "Project UUID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "search": {
    "description": "Optional media search when mode is assets or full.",
    "type": "string"
   },
   "timelineLimit": {
    "description": "Maximum timeline items to return (1-1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "timelineOffset": {
    "description": "Timeline item offset.",
    "minimum": 0,
    "type": "integer"
   },
   "transcriptLimit": {
    "description": "Maximum transcript segments to return (1-500).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "transcriptOffset": {
    "description": "Transcript segment offset.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "projects_inspect",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "bounds": {
    "properties": {
     "collections": {
      "items": {
       "properties": {
        "hasMore": {
         "type": "boolean"
        },
        "limit": {
         "type": "number"
        },
        "name": {
         "type": "string"
        },
        "offset": {
         "type": "number"
        },
        "returned": {
         "type": "number"
        },
        "total": {
         "type": "number"
        },
        "truncated": {
         "type": "boolean"
        }
       },
       "required": [
        "name",
        "offset",
        "limit",
        "total",
        "returned",
        "hasMore",
        "truncated"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "collections"
    ],
    "type": "object"
   },
   "data": {
    "type": "object"
   },
   "mode": {
    "enum": [
     "summary",
     "assets",
     "timeline",
     "transcript",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "mode",
   "data",
   "bounds"
  ],
  "type": "object"
 },
 "title": "Inspect Project"
}

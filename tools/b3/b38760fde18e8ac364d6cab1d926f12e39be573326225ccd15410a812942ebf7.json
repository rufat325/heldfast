{
 "description": "Manage connector overrides for your org. Overrides replace the sandbox mock with your real endpoint.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "list_overrides",
     "register",
     "delete"
    ],
    "type": "string"
   },
   "auth_header": {
    "description": "Auth header name, e.g. X-Api-Key",
    "type": "string"
   },
   "auth_value": {
    "description": "Secret value \u2014 never echoed back in the response",
    "type": "string"
   },
   "connector_id": {
    "description": "e.g. connector.ocr.document_extract_v1",
    "type": "string"
   },
   "endpoint": {
    "description": "Your HTTPS endpoint URL",
    "type": "string"
   },
   "label": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "mova_connector"
}

{
 "description": "Read UserDefaults values from inside the simulator. Inspect app preferences, feature flags, and configuration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "domain": {
    "description": "Defaults domain (bundle ID like \"com.apple.mobilesafari\" or \"NSGlobalDomain\")",
    "type": "string"
   },
   "key": {
    "description": "Specific key to read (omit for all keys)",
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "simulator_defaults_read"
}

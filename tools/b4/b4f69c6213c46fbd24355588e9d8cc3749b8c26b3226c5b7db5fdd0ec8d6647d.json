 "description": "Get full details for a specific company by jurisdiction and company number. Returns registration details, officers, filings, and industry codes. REQUIRES your own OpenCorporates API token via _apiKey \u2014 their public API is closed and keyless calls return 401. Example: get_company({jurisdiction:\"us_de\", number:\"4483789\", _apiKey:\"...\"}) for a Delaware company.",
 "inputSchema": {
  "examples": [
   {
    "jurisdiction": "us_de",
    "number": "4483789"
   },
   {
    "jurisdiction": "gb",
    "number": "12345678"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "Your OpenCorporates API token (required \u2014 get one at https://opencorporates.com/api_accounts/new)",
    "type": "string"
   },
   "jurisdiction": {
    "description": "Jurisdiction code (e.g., \"us_de\" for Delaware, \"gb\" for UK, \"ca_on\" for Ontario)",
    "type": "string"
   },
   "number": {
    "description": "Company registration number",
    "type": "string"
   }
  },
  "required": [
   "jurisdiction",
   "number"
  ],
  "type": "object"
 },
 "name": "get_company",

{
 "description": "List analyses from alive-analysis project. Supports filtering by type, stage, status, analyst, and tags.",
 "inputSchema": {
  "properties": {
   "analyst": {
    "description": "Filter by analyst name",
    "type": "string"
   },
   "limit": {
    "description": "Max results to return (default: 20)",
    "type": "number"
   },
   "stage": {
    "description": "Filter by current ALIVE stage",
    "enum": [
     "ASK",
     "LOOK",
     "INVESTIGATE",
     "VOICE",
     "EVOLVE"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "active",
     "archived"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags (OR logic)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Filter by analysis type",
    "enum": [
     "Investigation",
     "Experiment",
     "Simulation",
     "Learn"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "alive_list"
}

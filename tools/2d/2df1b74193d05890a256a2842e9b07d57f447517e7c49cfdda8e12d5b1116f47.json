{
 "description": "Get compact table and column context for writing SQL",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "connection_id": {
    "description": "Unique ID of the DBX connection",
    "type": "string"
   },
   "connection_name": {
    "description": "Name of the DBX connection",
    "type": "string"
   },
   "database": {
    "type": "string"
   },
   "max_tables": {
    "description": "Maximum number of tables to include, from 1 to 20",
    "format": "uint",
    "minimum": 0,
    "type": "integer"
   },
   "schema": {
    "type": "string"
   },
   "tables": {
    "description": "Specific table names to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "dbx_get_schema_context"
}

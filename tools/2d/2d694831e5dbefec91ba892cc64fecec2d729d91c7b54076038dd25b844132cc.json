{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Record Transaction"
 },
 "description": "Record a bank-side ledger row \u2014 actual money moving (income/expense/transfer): name, amount ($), optional fee, category, phase, date, banking references, and links to a receipt/project/vendor/place/team. Requires event_id + name + impact + amount; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "category": {
    "enum": [
     "attendee_payment",
     "donation",
     "sponsor",
     "rental",
     "service",
     "purchase",
     "labor",
     "software",
     "fees",
     "travel_food",
     "transfer",
     "refund",
     "misc"
    ],
    "type": "string"
   },
   "date": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "description": {
    "maxLength": 4000,
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "fee": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "impact": {
    "enum": [
     "income",
     "expense",
     "transfer"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "maxLength": 4000,
    "type": "string"
   },
   "paid_from_account": {
    "maxLength": 200,
    "type": "string"
   },
   "paid_to_account": {
    "maxLength": 200,
    "type": "string"
   },
   "payer": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "maxLength": 128,
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "required": [
     "id",
     "name"
    ],
    "type": "object"
   },
   "payer_email": {
    "maxLength": 320,
    "type": "string"
   },
   "phase": {
    "enum": [
     "pre_production",
     "build",
     "event",
     "strike",
     "post"
    ],
    "type": "string"
   },
   "place_id": {
    "maxLength": 128,
    "type": "string"
   },
   "project_id": {
    "maxLength": 128,
    "type": "string"
   },
   "receipt_id": {
    "maxLength": 128,
    "type": "string"
   },
   "receiver": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "maxLength": 128,
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "required": [
     "id",
     "name"
    ],
    "type": "object"
   },
   "reconciled": {
    "type": "boolean"
   },
   "references": {
    "additionalProperties": false,
    "properties": {
     "credit_card_id": {
      "maxLength": 200,
      "type": "string"
     },
     "domestic_routing": {
      "maxLength": 200,
      "type": "string"
     },
     "electronic_routing": {
      "maxLength": 200,
      "type": "string"
     },
     "international_routing": {
      "maxLength": 200,
      "type": "string"
     },
     "source_account": {
      "maxLength": 200,
      "type": "string"
     },
     "transaction_ref": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "tags": {
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "team_id": {
    "maxLength": 128,
    "type": "string"
   },
   "vendor_id": {
    "maxLength": 128,
    "type": "string"
   },
   "who_for": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "maxLength": 128,
       "type": "string"
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "event_id",
   "name",
   "impact",
   "amount"
  ],
  "type": "object"
 },
 "name": "record_transaction",
 "title": "Record Transaction"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Score Resume"
 },
 "description": "Score a resume for ATS compatibility. Returns an overall score, section scores, the keywords the resume matches and the ones it is missing, and specific rewrite suggestions. Pass job_description to score against a posting, or omit it for a general ATS readiness score. Requires a connected AI Applyd account and uses the user's credits. Do not use it to rewrite the resume; use aiapplyd_optimize_resume. Next: aiapplyd_optimize_resume rewrites the resume against the same posting.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "job_description": {
    "description": "Full text of the job description (optional, omit for a general ATS readiness score)",
    "maxLength": 50000,
    "minLength": 50,
    "type": "string"
   },
   "resume_text": {
    "description": "Full text of the resume",
    "maxLength": 50000,
    "minLength": 50,
    "type": "string"
   }
  },
  "required": [
   "resume_text"
  ],
  "type": "object"
 },
 "name": "aiapplyd_score_resume",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keywordMatches": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "missingKeywords": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "overallScore": {
    "type": "number"
   },
   "sectionScores": {
    "additionalProperties": false,
    "properties": {
     "education": {
      "type": "number"
     },
     "experience": {
      "type": "number"
     },
     "formatting": {
      "type": "number"
     },
     "keywords": {
      "type": "number"
     },
     "skills": {
      "type": "number"
     }
    },
    "required": [
     "skills",
     "experience",
     "education",
     "formatting",
     "keywords"
    ],
    "type": "object"
   },
   "suggestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "overallScore",
   "sectionScores",
   "keywordMatches",
   "missingKeywords",
   "suggestions"
  ],
  "type": "object"
 },
 "title": "Score Resume"
}

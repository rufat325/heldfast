{
 "description": "Move a message to another mailbox in the same account.\n[governed: scope=Mail mode=write-gated undo=native; runs as dry-run preview unless live mode is on AND a human approves out-of-band]",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Account owning both mailboxes",
    "minLength": 1,
    "type": "string"
   },
   "mailbox": {
    "description": "Current mailbox, if known",
    "type": "string"
   },
   "messageId": {
    "description": "RFC Message-ID (from mail_search results)",
    "minLength": 1,
    "type": "string"
   },
   "toMailbox": {
    "description": "Destination mailbox name",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "messageId",
   "account",
   "toMailbox"
  ],
  "type": "object"
 },
 "name": "mail_move"
}

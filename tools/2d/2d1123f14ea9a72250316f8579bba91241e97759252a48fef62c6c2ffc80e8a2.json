{
 "description": "Search TikTok videos by keyword. Paginate with data.cursor/has_more. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "default": 20,
    "description": "Results per page.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "cursor": {
    "default": "0",
    "description": "From data.cursor of previous response.",
    "type": "string"
   },
   "keyword": {
    "description": "Search query.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "publish_time": {
    "default": "0",
    "description": "'0'=all, '1'=day, '7'=week, '30'=month, '90'=3mo, '180'=6mo.",
    "enum": [
     "0",
     "1",
     "7",
     "30",
     "90",
     "180"
    ],
    "type": "string"
   },
   "sort_type": {
    "default": "0",
    "description": "'0' = relevance, '1' = most likes.",
    "enum": [
     "0",
     "1"
    ],
    "type": "string"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "search_tiktok_videos"
}

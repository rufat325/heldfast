{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Submits the source-chain transaction returned by `bridge_quote`. Currently the server-side submitter only signs on Monad \u2014 for cross-chain submission, open the approval URL on a wallet that supports the source chain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "data": {
    "pattern": "^0x[a-fA-F0-9]*$",
    "type": "string"
   },
   "to": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "ttl_seconds": {
    "default": 600,
    "exclusiveMinimum": 0,
    "maximum": 3600,
    "type": "integer"
   },
   "value_wei": {
    "default": "0",
    "pattern": "^\\d+$",
    "type": "string"
   }
  },
  "required": [
   "to",
   "data",
   "chain_id"
  ],
  "type": "object"
 },
 "name": "bridge_execute",
 "title": "Execute a bridge transaction (source chain)"
}

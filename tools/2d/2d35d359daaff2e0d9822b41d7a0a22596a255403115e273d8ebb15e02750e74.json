{
 "description": "List a Reddit user's comments. Paginate with next_cursor. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Cursor from data.next_cursor.",
    "type": "string"
   },
   "sort": {
    "default": "NEW",
    "description": "Sort order.",
    "enum": [
     "HOT",
     "NEW",
     "TOP",
     "BEST",
     "CONTROVERSIAL"
    ],
    "type": "string"
   },
   "username": {
    "description": "Username without u/.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "username"
  ],
  "type": "object"
 },
 "name": "get_reddit_user_comments"
}

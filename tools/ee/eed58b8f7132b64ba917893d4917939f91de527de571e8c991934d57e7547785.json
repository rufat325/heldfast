{
 "description": "Dry-run evaluate a hostname/bytes/spend against a Gate policy. Never blocks network I/O. Pass policy JSON or omit to use defaults / last fetched shape.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hostname": {
    "description": "Destination hostname, e.g. api.openai.com",
    "type": "string"
   },
   "policy": {
    "additionalProperties": false,
    "description": "Policy object to evaluate against",
    "properties": {
     "allowed_hosts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "blocked_hosts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "dry_run": {
      "type": "boolean"
     },
     "enforce": {
      "type": "boolean"
     },
     "max_request_bytes": {
      "type": "number"
     },
     "pii_types": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "redact_pii": {
      "type": "boolean"
     },
     "spend_cap_usd": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "request_bytes": {
    "description": "Request body size in bytes",
    "type": "number"
   },
   "spent_usd": {
    "description": "Session spend so far in USD",
    "type": "number"
   }
  },
  "required": [
   "hostname"
  ],
  "type": "object"
 },
 "name": "gate_evaluate"
}

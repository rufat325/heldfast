{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Substring search across title, author, lane tags, and classifier tags.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max rows (default 50, max 200).",
    "type": "number"
   },
   "q": {
    "description": "Search query.",
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_library",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_version": {
    "type": "string"
   },
   "books": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": [
        "string",
        "null"
       ]
      },
      "canonicalUrl": {
       "type": "string"
      },
      "engGuides": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "hasProfile": {
       "type": "boolean"
      },
      "libraryId": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "year": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "libraryId",
      "title",
      "author",
      "year",
      "engGuides",
      "hasProfile",
      "canonicalUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "number"
   },
   "limit": {
    "type": "number"
   },
   "query": {
    "type": "string"
   },
   "total_matching": {
    "type": "number"
   }
  },
  "required": [
   "api_version",
   "query",
   "total_matching",
   "count",
   "limit",
   "books"
  ],
  "type": "object"
 },
 "title": "Search the engineering library"
}

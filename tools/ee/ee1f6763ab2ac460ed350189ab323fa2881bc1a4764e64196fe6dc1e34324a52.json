 "description": "Search PermID for organizations, people, instruments, or quotes by name. Returns PermID, primary type, name, and a brief context. Use get_entity with the PermID for the full linked-data record.",
 "inputSchema": {
  "examples": [
   {
    "query": "Apple Inc"
   },
   {
    "entity_type": "organization",
    "limit": 10,
    "query": "Tesla"
   }
  ],
  "properties": {
   "entity_type": {
    "description": "Restrict by type",
    "enum": [
     "organization",
     "person",
     "instrument",
     "quote",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "description": "1-100 (default 20)",
    "type": "number"
   },
   "query": {
    "description": "Free-text search term",
    "type": "string"
   }
  },

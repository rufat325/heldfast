{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Normalize recent Strava activity load into a compact training_context for workout recommendation engines. Includes fallback guidance when recent Strava activity is missing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "default": 7,
    "description": "Lookback window for normalized Strava training context.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "injury_flags": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "maxLength": 500,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "soreness": {
    "default": [],
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "default": "UTC",
    "description": "IANA timezone used only for display, e.g. America/New_York.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "strava_training_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context_contract_version": {
    "const": "delx-wellness-context/v1",
    "type": "string"
   },
   "context_type": {
    "const": "training_context",
    "type": "string"
   },
   "data_quality": {},
   "fallback_hint": {
    "type": "string"
   },
   "generated_at": {
    "type": "string"
   },
   "injury_flags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "last_activity_type": {},
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "privacy": {
    "additionalProperties": false,
    "properties": {
     "gps": {
      "const": "withheld_from_context",
      "type": "string"
     },
     "route_details": {
      "const": "not_included",
      "type": "string"
     }
    },
    "required": [
     "gps",
     "route_details"
    ],
    "type": "object"
   },
   "recent_training_load": {
    "enum": [
     "low",
     "normal",
     "high",
     "unknown"
    ],
    "type": "string"
   },
   "recommended_handoff": {
    "additionalProperties": false,
    "properties": {
     "reason": {
      "type": "string"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool",
     "reason"
    ],
    "type": "object"
   },
   "relative_effort": {
    "minimum": 0,
    "type": "number"
   },
   "soreness": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "soreness_hint": {
    "minimum": 0,
    "type": "number"
   },
   "source": {
    "const": "strava",
    "type": "string"
   },
   "telegram_summary": {
    "type": "string"
   },
   "weekly_minutes": {
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "source",
   "context_contract_version",
   "context_type",
   "generated_at",
   "recent_training_load",
   "privacy",
   "recommended_handoff",
   "soreness",
   "injury_flags"
  ],
  "type": "object"
 },
 "title": "Strava Training Context"
}

{
 "description": "List a TikTok user's videos. Requires sec_user_id. Paginate with max_cursor/has_more. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "default": 20,
    "description": "Results per page.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "cursor": {
    "default": "0",
    "description": "Use data.max_cursor from previous response.",
    "type": "string"
   },
   "sec_user_id": {
    "description": "From get_tiktok_profile.",
    "type": "string"
   },
   "sort_type": {
    "default": "0",
    "description": "'0' = latest, '1' = popular.",
    "enum": [
     "0",
     "1"
    ],
    "type": "string"
   }
  },
  "required": [
   "sec_user_id"
  ],
  "type": "object"
 },
 "name": "get_tiktok_user_posts"
}

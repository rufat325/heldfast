{
 "description": "\u30c6\u30b9\u30c8\u30d9\u30fc\u30b9\u306b\u5bfe\u3057\u3066\u30c6\u30b9\u30c8\u4ed5\u69d8\u66f8\u304c\u5341\u5206\u304b\u3092\u30ec\u30d3\u30e5\u30fc\u3002\u8981\u4ef6ID\u30fb\u30c6\u30b9\u30c8\u6761\u4ef6ID\u30fb\u30ea\u30b9\u30afID\u306e3\u7cfb\u7d71\u00d7\u53cc\u65b9\u5411\u30ab\u30d0\u30ec\u30c3\u30b8\u3001ID\u8868\u8a18\u3086\u308c\u3001\u30b1\u30fc\u30b9ID\u91cd\u8907\u30fb\u671f\u5f85\u7d50\u679c\u7a7a\u6b04\u30fb\u512a\u5148\u5ea6\u4ed8\u4e0e\u30fb\u524d\u63d0\u6761\u4ef6\u30fb\u624b\u9806\u3068\u671f\u5f85\u7d50\u679c\u306e\u30d0\u30e9\u30f3\u30b9\u30fb\u4e3b\u89b3\u8a9e\u30fb\u671f\u5f85\u7d50\u679c\u306e\u5f15\u7528\u6587\u8a00/ID\u306e\u30c6\u30b9\u30c8\u30d9\u30fc\u30b9\u5b9f\u5728\u7167\u5408\u30fb\u7db2\u7f85\u57fa\u6e96\u5ba3\u8a00\u3092\u6c7a\u5b9a\u7684\u306b\u691c\u67fb\u3059\u308b\u3002\u6295\u5165\u6587\u66f8\u306e\u5165\u529b\u30c0\u30a4\u30b8\u30a7\u30b9\u30c8(\u629c\u7c8b\u6295\u5165\u306e\u691c\u51fa)\u3082\u51fa\u529b\u3057\u3001\u610f\u5473\u7684\u30c1\u30a7\u30c3\u30af\u30ea\u30b9\u30c8\u3068\u6539\u5584\u63d0\u6848\u3092\u4f75\u305b\u3066\u8fd4\u3059\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "additionalAmbiguousTerms": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "additionalSubjectiveTerms": {
    "description": "Extra subjective words checked in expected results",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "completedTools": {
    "description": "Already executed tools; entries without evidence are treated as not executed",
    "items": {
     "properties": {
      "evidence": {
       "description": "Evidence of execution: an output file path (e.g. docs/test-cases.md) or an output heading line starting with '#'",
       "type": "string"
      },
      "outputExcerpt": {
       "description": "Excerpt of the declared tool's actual output text. Must contain that tool's own H1 heading line; otherwise the declaration is reported as evidence-unverified and still counted as not executed",
       "type": "string"
      },
      "toolName": {
       "description": "Name of an already executed tool in this workflow",
       "type": "string"
      }
     },
     "required": [
      "toolName",
      "evidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "idPatterns": {
    "description": "Extra regular expression sources for requirement/feature IDs, added to the default pattern. Capture group count decides how the ID is built: 1 group = group 1 is used as the whole ID as-is (no hyphen joining), 2 groups = reconstructed as `${group1}-${group2}` (default pattern behavior), 0 groups = the whole match is used. Use a 1-group pattern for numeric-only IDs (031), dot-separated IDs (3.1.2) and underscore IDs (REQ_001) so the reported ID matches the notation in the source document. If a given pattern matches nothing, a [high] finding is emitted in the input digest.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "idPrefix": {
    "description": "Test case id prefix (default TCS-)",
    "type": "string"
   },
   "requirementIds": {
    "description": "Requirement ids; omitted triggers automatic extraction from testBasisDocuments",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "risks": {
    "description": "Risks; omitted skips the risk axis",
    "items": {
     "properties": {
      "description": {
       "description": "Risk description",
       "type": "string"
      },
      "id": {
       "description": "Risk id, e.g. R-001",
       "type": "string"
      }
     },
     "required": [
      "id",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testBasisDocuments": {
    "description": "One or more test basis documents the test specification is evaluated against",
    "items": {
     "properties": {
      "content": {
       "description": "Full text of the document (any format; caller converts binaries to text)",
       "type": "string"
      },
      "name": {
       "description": "Document name or file name of the test basis document",
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "testCases": {
    "description": "Structured test case specs, same shape as generate_test_cases; omitted triggers id-extraction-only simple checks",
    "items": {
     "properties": {
      "caseId": {
       "description": "Test case id, e.g. TCS-001",
       "type": "string"
      },
      "coverageTargets": {
       "description": "Coverage target ids from section 2 that this case satisfies (required)",
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "declaredTestSize": {
       "description": "Test size declared by the caller; compared against the classified size",
       "enum": [
        "small",
        "medium",
        "large"
       ],
       "type": "string"
      },
      "derivedFrom": {
       "description": "Requirement/feature/screen/scenario/risk ids this case was derived from (required). Plain id string, or {kind, id} to disambiguate across requirement/risk/stakeholder/guideword namespaces",
       "items": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "properties": {
           "id": {
            "minLength": 1,
            "type": "string"
           },
           "kind": {
            "enum": [
             "requirement",
             "risk",
             "stakeholder",
             "guideword"
            ],
            "type": "string"
           }
          },
          "required": [
           "kind",
           "id"
          ],
          "type": "object"
         }
        ]
       },
       "minItems": 1,
       "type": "array"
      },
      "estimatedDurationSeconds": {
       "description": "Estimated execution time in seconds at design time, used for test size classification",
       "minimum": 0,
       "type": "number"
      },
      "externalDependencyIds": {
       "description": "External dependency axis ids (TSD-01..TSD-08 from testdesign://testsize/classification-criteria); pass an empty array to declare no external dependency",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "note": {
       "type": "string"
      },
      "perspectiveCategoryId": {
       "type": "string"
      },
      "postconditions": {
       "items": {
        "properties": {
         "name": {
          "description": "State variable name",
          "type": "string"
         },
         "value": {
          "description": "State variable value",
          "type": "string"
         }
        },
        "required": [
         "name",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "preconditions": {
       "description": "Precondition state variables (required)",
       "items": {
        "properties": {
         "name": {
          "description": "State variable name",
          "type": "string"
         },
         "value": {
          "description": "State variable value",
          "type": "string"
         }
        },
        "required": [
         "name",
         "value"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "priority": {
       "enum": [
        "\u9ad8",
        "\u4e2d",
        "\u4f4e"
       ],
       "type": "string"
      },
      "result": {
       "properties": {
        "defectNo": {
         "description": "Linked defect number",
         "type": "string"
        },
        "executedBy": {
         "description": "Executor name",
         "type": "string"
        },
        "executedDate": {
         "description": "Execution date",
         "type": "string"
        },
        "verdict": {
         "description": "Execution verdict",
         "enum": [
          "\u5408\u683c",
          "\u4e0d\u5408\u683c",
          "\u672a\u5b9f\u65bd",
          "\u5bfe\u8c61\u5916"
         ],
         "type": "string"
        }
       },
       "type": "object"
      },
      "sourceRefs": {
       "description": "Explicit source locations in the test basis; takes precedence over other resolution",
       "items": {
        "properties": {
         "document": {
          "description": "Test basis document name",
          "type": "string"
         },
         "endLine": {
          "description": "1-based end line in the document",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
         },
         "heading": {
          "description": "Nearest heading in the document",
          "type": "string"
         },
         "label": {
          "description": "Display label, e.g. 'EH-100 Ticket gate startup'",
          "type": "string"
         },
         "startLine": {
          "description": "1-based start line in the document",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
         }
        },
        "required": [
         "document",
         "startLine"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "steps": {
       "description": "Ordered steps, one operation per step (required)",
       "items": {
        "properties": {
         "action": {
          "description": "A single operation for this step",
          "type": "string"
         },
         "expected": {
          "description": "Observable expected result for this step",
          "type": "string"
         },
         "no": {
          "description": "1-based sequential step number",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "no",
         "action",
         "expected"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "techniqueId": {
       "description": "Applied technique id (required)",
       "type": "string"
      },
      "testConditionId": {
       "description": "Origin test condition id (required)",
       "type": "string"
      },
      "testLevel": {
       "description": "Declared test level for this case; used to check test level allocation against the test size",
       "enum": [
        "component-testing",
        "integration-testing",
        "system-testing",
        "acceptance-testing"
       ],
       "type": "string"
      },
      "testType": {
       "description": "Test type label",
       "type": "string"
      },
      "title": {
       "description": "Test case title",
       "type": "string"
      }
     },
     "required": [
      "caseId",
      "title",
      "testConditionId",
      "derivedFrom",
      "techniqueId",
      "coverageTargets",
      "preconditions",
      "steps"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testConditions": {
    "description": "Test conditions (extract_test_conditions output); omitted skips the condition axis",
    "items": {
     "properties": {
      "derivedFrom": {
       "description": "Requirement/risk/persona ids (required). Plain id string, or {kind, id} to disambiguate across requirement/risk/stakeholder/guideword namespaces",
       "items": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "properties": {
           "id": {
            "minLength": 1,
            "type": "string"
           },
           "kind": {
            "enum": [
             "requirement",
             "risk",
             "stakeholder",
             "guideword"
            ],
            "type": "string"
           }
          },
          "required": [
           "kind",
           "id"
          ],
          "type": "object"
         }
        ]
       },
       "minItems": 1,
       "type": "array"
      },
      "id": {
       "description": "Test condition id, e.g. TC-001",
       "type": "string"
      },
      "priority": {
       "enum": [
        "\u9ad8",
        "\u4e2d",
        "\u4f4e"
       ],
       "type": "string"
      },
      "statement": {
       "description": "The test condition statement",
       "type": "string"
      },
      "target": {
       "description": "Target of the condition",
       "type": "string"
      }
     },
     "required": [
      "id",
      "target",
      "statement",
      "derivedFrom"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testSpecificationText": {
    "description": "Full text of the test specification document (any format)",
    "type": "string"
   }
  },
  "required": [
   "testBasisDocuments",
   "testSpecificationText"
  ],
  "type": "object"
 },
 "name": "review_test_specification",
 "title": "Review Test Specification"
}

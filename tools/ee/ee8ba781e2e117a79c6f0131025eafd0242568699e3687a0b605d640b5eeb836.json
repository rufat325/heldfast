{
 "description": "List Polymarket events (groups of related markets). Events bundle multiple Yes/No markets under one topic (e.g. 'US Presidential Election 2024' contains many candidate markets). Uses the Gamma API.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "active": {
    "description": "Filter: only active events",
    "type": "boolean"
   },
   "ascending": {
    "default": false,
    "description": "Sort ascending",
    "type": "boolean"
   },
   "closed": {
    "description": "Filter: only closed events",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "description": "Number of events (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "orderBy": {
    "description": "Sort field",
    "enum": [
     "volume",
     "liquidity",
     "startDate",
     "endDate",
     "createdAt"
    ],
    "type": "string"
   },
   "tag": {
    "description": "Filter by tag (e.g. 'politics', 'crypto', 'sports')",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_polymarket_events"
}

 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search/browse AniList's activity feed (list updates, text posts, messages), optionally filtered to one user and/or one activity type. Each result already includes its full content (text/message/status, `replyCount`/`likeCount`/`isLiked`, the posting user, and \u2014 for list activity \u2014 the media) \u2014 no follow-up get_activity call needed unless you need to re-check one specific result's `replyCount`/`likeCount`/`isLiked` later (e.g. after liking it).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "page": {
    "default": 1,
    "description": "Page number for pagination. AniList's paginated connections (search results, a title's characters/staff/reviews, activity feeds, forum comments) reject a page whose page \u00d7 perPage exceeds ~5000 entries with an upstream error, so paging that deep fails rather than returning more results.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "perPage": {
    "default": 10,
    "description": "Results per page (max 50, AniList's own ceiling \u2014 it silently clamps anything higher).",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   },
   "type": {
    "description": "Restrict to this activity type. MEDIA_LIST matches both ANIME_LIST and MANGA_LIST activities; use ANIME_LIST/MANGA_LIST to restrict to just one.",
    "enum": [
     "TEXT",
     "ANIME_LIST",
     "MANGA_LIST",
     "MESSAGE",
     "MEDIA_LIST"
    ],
    "type": "string"
   },
   "user": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 2147483647,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Restrict results to this AniList user \u2014 numeric ID or exact username (resolved to an id with one extra internal lookup; no need to call search_user first unless you only have a partial/fuzzy name). An unknown ID or username errors with not_found rather than silently returning an empty result. Use get_user_activity instead if you only need one user's feed without the type filter."
   }
  },
  "type": "object"
 },

 "description": "Search USDA Food Data Central for food items by name, brand, or ingredient. Supports filtering by data type (Branded, Foundation, SR Legacy, Survey FNDDS, Experimental) and brand owner. Returns FDC id, description, data type, and publication date per result.",
 "inputSchema": {
  "examples": [
   {
    "query": "organic whole milk"
   },
   {
    "brand_owner": "Perdue",
    "page_size": 25,
    "query": "chicken breast",
    "sort_by": "publishedDate",
    "sort_order": "desc"
   }
  ],
  "properties": {
   "brand_owner": {
    "description": "Restrict to a brand owner",
    "type": "string"
   },
   "data_type": {
    "description": "Filter to data type(s). Comma-sep. Options: Branded | Foundation | Survey (FNDDS) | SR Legacy | Experimental",
    "type": "string"
   },
   "page_number": {
    "description": "1-based page (default 1)",
    "type": "number"
   },
   "page_size": {
    "description": "1-200 (default 50)",
    "type": "number"
   },
   "query": {
    "description": "Free-text \u2014 name / brand / ingredient",
    "type": "string"
   },
   "sort_by": {
    "description": "dataType.keyword | lowercaseDescription.keyword | fdcId | publishedDate (default relevance)",
    "type": "string"
   },
   "sort_order": {
    "description": "asc | desc",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_foods",

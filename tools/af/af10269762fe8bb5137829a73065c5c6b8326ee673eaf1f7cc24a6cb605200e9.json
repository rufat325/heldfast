{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Execute type-checker (tsc, mypy, pyright) and map errors to enclosing AST symbols. Read-only.",
 "inputSchema": {
  "properties": {
   "checker": {
    "description": "Checker (tsc, mypy, pyright)",
    "enum": [
     "tsc",
     "mypy",
     "pyright"
    ],
    "type": "string"
   },
   "file_path": {
    "description": "Filter by file path",
    "maxLength": 512,
    "type": "string"
   },
   "max_files": {
    "description": "Max files reported",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "max_per_file": {
    "description": "Max errors per file",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "reduce_output": {
    "description": "Shrink long output to a receipt",
    "type": "boolean"
   },
   "timeout_ms": {
    "description": "Timeout in ms",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_diagnostics"
}

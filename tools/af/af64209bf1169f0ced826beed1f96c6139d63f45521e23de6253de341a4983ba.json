{
 "description": "Apply only user-approved operations from a current review-card authoring preview. Returns app-owned readback; never call without explicit approval of the previewed operations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approvedFieldsByOperation": {
    "additionalProperties": {
     "items": {
      "minLength": 1,
      "type": "string"
     },
     "minItems": 1,
     "type": "array"
    },
    "type": "object"
   },
   "approvedOperationIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "previewHash": {
    "minLength": 1,
    "type": "string"
   },
   "previewToken": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "previewToken",
   "previewHash",
   "approvedOperationIds"
  ],
  "type": "object"
 },
 "name": "granoflow_review_card_authoring_apply"
}

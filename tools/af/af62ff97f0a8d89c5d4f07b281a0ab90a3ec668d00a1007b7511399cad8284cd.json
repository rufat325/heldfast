{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submits previously created SMI export drafts (Draft status only) for processing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ids": {
    "items": {
     "anyOf": [
      {
       "minLength": 1,
       "type": "string"
      },
      {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      }
     ]
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "smi_submit_exports",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accepted": {
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      }
     ]
    },
    "type": "array"
   },
   "outcomesEnumerated": {
    "type": "boolean"
   },
   "rejected": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "number"
        }
       ]
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "accepted",
   "rejected",
   "outcomesEnumerated"
  ],
  "type": "object"
 },
 "title": "Submit Exports"
}

     "additionalProperties": true,
     "required": [
      "tool"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "contracts",
   "calls"
  ],
  "type": "object"
 },
 "name": "justhandled_tool_call_contract_auditor"
}

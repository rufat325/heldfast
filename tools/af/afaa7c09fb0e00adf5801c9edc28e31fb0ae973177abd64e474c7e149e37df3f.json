{
 "description": "Update automated improvement settings for a project.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "update": {
    "additionalProperties": false,
    "properties": {
     "automated_improvement_bundles_enabled": {
      "type": "boolean"
     },
     "improvement_bundle_sensitivity": {
      "enum": [
       "high_confidence",
       "balanced",
       "verbose"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "update"
  ],
  "type": "object"
 },
 "name": "update_improvement_settings"
}

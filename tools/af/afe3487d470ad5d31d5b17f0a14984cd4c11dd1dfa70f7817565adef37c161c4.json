 "description": "Search for questions on StackOverflow or any StackExchange site. Returns title, body, score, answer count, tags, and link.",
 "inputSchema": {
  "examples": [
   {
    "query": "python async await"
   },
   {
    "limit": 10,
    "query": "how to install nodejs",
    "site": "askubuntu"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "Optional \u2014 a StackExchange API key (free, 10k/day) for a dedicated quota. The gateway supplies a platform key; pass your own only to override.",
    "type": "string"
   },
   "limit": {
    "description": "Number of results to return (1-20, default 5)",
    "type": "number"
   },
   "query": {
    "description": "Search query string",
    "type": "string"
   },
   "site": {
    "description": "StackExchange site slug (default: stackoverflow). Examples: serverfault, superuser, askubuntu, math, physics",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_questions",

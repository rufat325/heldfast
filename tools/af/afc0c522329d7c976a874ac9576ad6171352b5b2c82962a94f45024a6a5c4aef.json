{
 "description": "Read a card's preset (spend limits, rate limits, allowed categories/merchants, time windows, and surfaces) as a plain-English summary. A card without a preset is unrestricted.",
 "inputSchema": {
  "properties": {
   "card_id": {
    "description": "The card id (from list_cards).",
    "type": "string"
   }
  },
  "required": [
   "card_id"
  ],
  "type": "object"
 },
 "name": "get_card_preset",
 "outputSchema": {
  "properties": {
   "cardId": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "preset": {
    "description": "Preset summary, or null when unrestricted.",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "summary": {
      "type": "string"
     },
     "version": {
      "type": "number"
     }
    },
    "type": [
     "object",
     "null"
    ]
   }
  },
  "required": [
   "message"
  ],
  "type": "object"
 }
}

 "description": "\"Which SBIR or STTR solicitations are open at [agency]?\" / \"current SBIR topics\" / \"open DoD SBIR solicitations\" / \"SBIR proposal deadlines\" \u2014 active SBIR/STTR funding opportunities and topic solicitations from the federal SBIR program, by keyword or agency (e.g., \"DOD\", \"DARPA\", \"NSF\", \"NASA\", \"DOE\", \"HHS\"). Returns topic descriptions, sponsoring agency/branch, Phase, and open/close dates. This is the tool for open federal small-business R&D solicitations and topics; for who already WON SBIR money use sbir_search_awards.",
 "inputSchema": {
  "examples": [
   {
    "agency": "NSF",
    "keyword": "artificial intelligence",
    "open_only": true
   },
   {
    "keyword": "biotechnology",
    "limit": 10
   }
  ],
  "properties": {
   "agency": {
    "description": "Filter by agency: DOW (Department of War, formerly DOD \u2014 \"DOD\" is accepted and translated), HHS, NASA, NSF, DOE, USDA, EPA, DOC, ED, DOT, DHS.",
    "type": "string"
   },
   "keyword": {
    "description": "Search term to match against solicitation topics and descriptions",
    "type": "string"
   },
   "limit": {
    "description": "Number of results to return (default 20)",
    "type": "number"
   },
   "open_only": {
    "description": "Only return currently open solicitations (default true)",
    "type": "boolean"
   }
  },
  "required": [],
  "type": "object"
 },

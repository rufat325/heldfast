{
 "description": "Record one explicit content approval for the exact default-resume identity and complete current eligible frozen run set. This does not upload the file; every actual attachment still requires immediate path/hash verification.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batchId": {
    "minimum": 1,
    "type": "integer"
   },
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "expiresAt": {
    "format": "date-time",
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 16,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "leaseToken": {
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "memberRuns": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "inspectionEpoch": {
       "minimum": 0,
       "type": "integer"
      },
      "memberId": {
       "minimum": 1,
       "type": "integer"
      },
      "memberVersion": {
       "minimum": 1,
       "type": "integer"
      },
      "runId": {
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "memberId",
      "runId",
      "memberVersion",
      "inspectionEpoch"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "membershipHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "profileRevision": {
    "minimum": 0,
    "type": "integer"
   },
   "resumeFilename": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "resumeId": {
    "minimum": 1,
    "type": "integer"
   },
   "resumeSha256": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "resumeSizeBytes": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "batchId",
   "leaseToken",
   "membershipHash",
   "profileRevision",
   "resumeId",
   "resumeSha256",
   "resumeFilename",
   "resumeSizeBytes",
   "memberRuns",
   "expiresAt",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "trackly_approve_apply_batch_resume"
}

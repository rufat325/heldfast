{
 "description": "Header search (subject/sender/date) across a mailbox. Fast, index-backed. Full-text body search is not available in this tier.\n[governed: scope=Mail mode=read undo=none]",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Limit to one account",
    "type": "string"
   },
   "before": {
    "description": "Received before, ISO 8601",
    "format": "date-time",
    "type": "string"
   },
   "from": {
    "description": "Match in sender (name or address)",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "mailbox": {
    "description": "Mailbox name (default: inbox)",
    "type": "string"
   },
   "since": {
    "description": "Received after, ISO 8601",
    "format": "date-time",
    "type": "string"
   },
   "subject": {
    "description": "Match in subject",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "mail_search"
}

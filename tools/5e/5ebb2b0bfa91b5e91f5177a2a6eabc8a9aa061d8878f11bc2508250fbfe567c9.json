{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Aggregate supplied open and proposed positions into gross, net, directional and concentration exposure with stop-risk and margin indicators. Use when an agent needs to assess portfolio concentration or directional exposure before adding or modifying a position.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "account": {
    "additionalProperties": false,
    "properties": {
     "accountBalance": {
      "type": "number"
     },
     "accountEquity": {
      "type": "number"
     },
     "availableMargin": {
      "minimum": 0,
      "type": "number"
     },
     "marginUsed": {
      "minimum": 0,
      "type": "number"
     },
     "maxConcurrentPositions": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "maxDailyLossPct": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "maxPortfolioRiskPct": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "maxPositionPct": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "correlations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "correlation": {
       "maximum": 1,
       "minimum": -1,
       "type": "number"
      },
      "symbolA": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "symbolB": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "symbolA",
      "symbolB",
      "correlation"
     ],
     "type": "object"
    },
    "maxItems": 100000,
    "type": "array"
   },
   "positions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "assetClass": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "currentPrice": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "direction": {
       "enum": [
        "long",
        "short"
       ],
       "type": "string"
      },
      "entryPrice": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "fees": {
       "minimum": 0,
       "type": "number"
      },
      "leverage": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "margin": {
       "minimum": 0,
       "type": "number"
      },
      "marketValue": {
       "minimum": 0,
       "type": "number"
      },
      "positionId": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "stopLoss": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "strategy": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "symbol": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "symbol",
      "direction",
      "quantity",
      "entryPrice"
     ],
     "type": "object"
    },
    "maxItems": 10000,
    "type": "array"
   },
   "proposedPosition": {
    "additionalProperties": false,
    "properties": {
     "assetClass": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "currentPrice": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "direction": {
      "enum": [
       "long",
       "short"
      ],
      "type": "string"
     },
     "entryPrice": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "fees": {
      "minimum": 0,
      "type": "number"
     },
     "leverage": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "margin": {
      "minimum": 0,
      "type": "number"
     },
     "marketValue": {
      "minimum": 0,
      "type": "number"
     },
     "positionId": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "quantity": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "stopLoss": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "strategy": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "symbol": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "symbol",
     "direction",
     "quantity",
     "entryPrice"
    ],
    "type": "object"
   }
  },
  "required": [
   "positions"
  ],
  "type": "object"
 },
 "name": "portfolio_exposure_check",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "accountEquity": {
    "type": [
     "number",
     "null"
    ]
   },
   "availableFreeMargin": {
    "type": [
     "number",
     "null"
    ]
   },
   "concentrationFlags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "exposurePctOfEquity": {
    "type": [
     "number",
     "null"
    ]
   },
   "grossExposure": {
    "minimum": 0,
    "type": "number"
   },
   "largestConcentrationPct": {
    "type": [
     "number",
     "null"
    ]
   },
   "leverage": {
    "type": [
     "number",
     "null"
    ]
   },
   "longExposure": {
    "minimum": 0,
    "type": "number"
   },
   "marginUsage": {
    "type": [
     "number",
     "null"
    ]
   },
   "netExposure": {
    "type": "number"
   },
   "openRisk": {
    "type": [
     "number",
     "null"
    ]
   },
   "positions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "concentrationPct": {
       "type": [
        "number",
        "null"
       ]
      },
      "direction": {
       "enum": [
        "long",
        "short"
       ],
       "type": "string"
      },
      "exposure": {
       "minimum": 0,
       "type": "number"
      },
      "openRisk": {
       "type": [
        "number",
        "null"
       ]
      },
      "symbol": {
       "type": "string"
      }
     },
     "required": [
      "symbol",
      "direction",
      "exposure",
      "concentrationPct",
      "openRisk"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "riskFlags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "shortExposure": {
    "minimum": 0,
    "type": "number"
   },
   "sourceTraceability": {
    "additionalProperties": false,
    "properties": {
     "notes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "portfolioExposure": {
      "enum": [
       "GROK",
       "SIGNALFLOW",
       "MERGED",
       "NEW"
      ],
      "type": "string"
     },
     "strategyPerformance": {
      "enum": [
       "GROK",
       "SIGNALFLOW",
       "MERGED",
       "NEW"
      ],
      "type": "string"
     },
     "tradeLog": {
      "enum": [
       "GROK",
       "SIGNALFLOW",
       "MERGED",
       "NEW"
      ],
      "type": "string"
     },
     "tradeRisk": {
      "enum": [
       "GROK",
       "SIGNALFLOW",
       "MERGED",
       "NEW"
      ],
      "type": "string"
     }
    },
    "required": [
     "strategyPerformance",
     "tradeRisk",
     "portfolioExposure",
     "tradeLog",
     "notes"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "grossExposure",
   "netExposure",
   "longExposure",
   "shortExposure",
   "exposurePctOfEquity",
   "largestConcentrationPct",
   "leverage",
   "positions",
   "concentrationFlags",
   "riskFlags",
   "summary",
   "accountEquity",
   "openRisk",
   "marginUsage",
   "availableFreeMargin"
  ],
  "type": "object"
 }
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Analyze investment lots and suggest which to sell to minimize tax. Considers long-term vs short-term, 0% bracket space, loss harvesting, and wash sale rules.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filingStatus": {
    "enum": [
     "single",
     "married_filing_jointly",
     "married_filing_separately",
     "head_of_household"
    ],
    "type": "string"
   },
   "lots": {
    "description": "Investment lots to analyze",
    "items": {
     "additionalProperties": false,
     "properties": {
      "costBasis": {
       "description": "Total cost basis",
       "type": "number"
      },
      "currentValue": {
       "description": "Current market value",
       "type": "number"
      },
      "holdingMonths": {
       "description": "Months held",
       "minimum": 0,
       "type": "integer"
      },
      "name": {
       "description": "Investment name (e.g., 'AAPL', 'VTI')",
       "type": "string"
      },
      "shares": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "name",
      "shares",
      "costBasis",
      "currentValue",
      "holdingMonths"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ordinaryIncome": {
    "description": "Ordinary income (W-2, SE, interest, etc.) before investment sales",
    "minimum": 0,
    "type": "number"
   },
   "targetGainOrLoss": {
    "description": "Target net gain/loss to realize (negative for harvesting losses)",
    "type": "number"
   },
   "taxYear": {
    "description": "Tax year",
    "type": "number"
   }
  },
  "required": [
   "taxYear",
   "filingStatus",
   "ordinaryIncome",
   "lots"
  ],
  "type": "object"
 },
 "name": "optimize_capital_gains",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "suggestion"
    ],
    "type": "object"
   },
   "isError": {
    "type": "boolean"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "isError"
  ],
  "type": "object"
 }
}

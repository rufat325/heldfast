{
 "description": "List WooCommerce products",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category ID",
    "type": "number"
   },
   "featured": {
    "type": "boolean"
   },
   "on_sale": {
    "type": "boolean"
   },
   "order": {
    "default": "desc",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "orderby": {
    "default": "date",
    "type": "string"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "per_page": {
    "default": 20,
    "type": "number"
   },
   "search": {
    "default": "",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "default": "any",
    "enum": [
     "any",
     "draft",
     "pending",
     "private",
     "publish",
     "trash"
    ],
    "type": "string"
   },
   "stock_status": {
    "default": "",
    "enum": [
     "",
     "instock",
     "outofstock",
     "onbackorder"
    ],
    "type": "string"
   },
   "tag": {
    "description": "Tag ID",
    "type": "number"
   },
   "type": {
    "default": "",
    "enum": [
     "simple",
     "grouped",
     "external",
     "variable",
     ""
    ],
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_list_products"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "YNAB: Update Category Budget"
 },
 "description": "Update the budgeted amount for a category in the current month.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - category_id (string, required): Category UUID.\n  - budgeted_decimal (number, preferred): New funding amount in decimal currency units.\n  - budgeted_milliunits (int, alternative): Explicit raw YNAB milliunits.\n  - budgeted (int, deprecated): Backward-compatible alias for budgeted_milliunits.\n  - dry_run (boolean, optional): Preview without saving. Default: false.\n\nReturns: updated category with new budgeted, activity, balance.\n\nExamples:\n  - Budget $100: set budgeted_decimal=100.00\n  - Already-converted data: set budgeted_milliunits=100000\n  - Dry run: set dry_run=true\n\nErrors:\n  - \"No default budget set\" \u2192 run ynab_set_default_budget first\n\nWrite safety: call without confirmation_token to preview. Execute the identical validated request with the short-lived confirmation_token returned by that preview.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "budgeted": {
    "description": "Deprecated legacy alias for budgeted_milliunits. Use budgeted_decimal or budgeted_milliunits.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "budgeted_decimal": {
    "description": "Preferred: category funding amount in decimal currency units (for example, 100.00).",
    "type": "number"
   },
   "budgeted_milliunits": {
    "description": "Raw YNAB category funding amount in milliunits.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "category_id": {
    "minLength": 1,
    "type": "string"
   },
   "confirmation_token": {
    "description": "Short-lived, single-use token returned by the immediately preceding preview of this exact validated request.",
    "minLength": 16,
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   }
  },
  "required": [
   "category_id"
  ],
  "type": "object"
 },
 "name": "ynab_update_category",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "action": {
      "const": "ynab_update_category",
      "type": "string"
     },
     "dry_run": {
      "const": true,
      "type": "boolean"
     },
     "request": {
      "additionalProperties": false,
      "properties": {
       "budget_id": {
        "type": "string"
       },
       "budgeted": {
        "type": "number"
       },

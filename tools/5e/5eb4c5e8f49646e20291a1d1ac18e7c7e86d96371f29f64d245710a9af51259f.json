{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new RRSet (record set) inside a DNS zone.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id_or_name": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^[^/\\s]+$",
      "type": "string"
     }
    ],
    "description": "Zone ID or name"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Labels as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "RRSet name (e.g. \"@\", \"www\", \"_acme-challenge\")",
    "type": "string"
   },
   "records": {
    "description": "Records belonging to this RRSet",
    "items": {
     "properties": {
      "comment": {
       "description": "Optional human-readable comment for this record",
       "type": "string"
      },
      "value": {
       "description": "Record value, e.g. \"1.2.3.4\" or \"10 mail.example.com.\"",
       "type": "string"
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ttl": {
    "description": "TTL in seconds for records in this RRSet",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "DNS record type (A, AAAA, CNAME, MX, NS, TXT, etc.)",
    "enum": [
     "A",
     "AAAA",
     "CAA",
     "CNAME",
     "DS",
     "HINFO",
     "HTTPS",
     "MX",
     "NS",
     "PTR",
     "RP",
     "SOA",
     "SRV",
     "SVCB",
     "TLSA",
     "TXT"
    ],
    "type": "string"
   }
  },
  "required": [
   "id_or_name",
   "name",
   "type"
  ],
  "type": "object"
 },
 "name": "hetzner_create_zone_rrset",
 "title": "Create DNS Zone RRSet"
}

{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs Biome check (lint + format) and returns structured diagnostics (file, line, rule, severity, message).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apply": {
    "description": "Apply safe fixes automatically (maps to --apply)",
    "type": "boolean"
   },
   "applyUnsafe": {
    "description": "Apply safe and unsafe fixes automatically (maps to --apply-unsafe)",
    "type": "boolean"
   },
   "changed": {
    "description": "Only check VCS-changed files (maps to --changed)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "configPath": {
    "description": "Path to Biome configuration file (maps to --config-path)",
    "maxLength": 4096,
    "type": "string"
   },
   "diagnosticLevel": {
    "description": "Minimum diagnostic level to report",
    "enum": [
     "info",
     "warn",
     "error"
    ],
    "type": "string"
   },
   "formatterEnabled": {
    "description": "Enable or disable the formatter (maps to --formatter-enabled)",
    "type": "boolean"
   },
   "linterEnabled": {
    "description": "Enable or disable the linter (maps to --linter-enabled)",
    "type": "boolean"
   },
   "maxDiagnostics": {
    "description": "Maximum number of diagnostics to display (maps to --max-diagnostics)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "."
    ],
    "description": "File patterns to check (default: ['.'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "since": {
    "description": "Only check files changed since this git ref (maps to --since)",
    "maxLength": 65536,
    "type": "string"
   },
   "skip": {
    "description": "Rules to skip (maps to --skip)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "staged": {
    "description": "Only check staged files (maps to --staged)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "biome-check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deprecationCount": {
    "type": "number"
   },
   "deprecations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reference": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "severity",
      "rule",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnosticsTruncated": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "errors": {
    "type": "number"
   },
   "exitCode": {
    "type": "number"
   },
   "filesChecked": {
    "type": "number"
   },
   "fixableErrorCount": {
    "type": "number"
   },
   "fixableWarningCount": {
    "type": "number"
   },
   "omittedCount": {
    "type": "number"
   },
   "warnings": {
    "type": "number"
   }
  },
  "required": [
   "errors",
   "warnings",
   "filesChecked"
  ],
  "type": "object"
 },
 "title": "Biome Check"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Schedule a post"
 },
 "description": "Create a post and queue it for every account named. Pass draft true to hold it here instead, sending nothing until posts_update promotes it. Name accounts with ids from accounts_list, or name a group from groups_list and get all of its members \u2014 the two combine, and a group is expanded now, so adding an account to it later does not add it to this post. Accounts must all be in one workspace. Attach media by id from media_list; a post is either a video or a set of images, never both. Omit scheduled_at to send as soon as possible. Nothing publishes yet: this records the intent. Publishing has to be enabled on the account; where it is not, this saves nothing at all and says so. Do not tell anyone their post is saved or scheduled until this has returned successfully.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "account_ids": {
    "description": "Which accounts to post to, from accounts_list. Optional when groups is given; naming neither is refused.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "content": {
    "description": "The caption.",
    "type": "string"
   },
   "draft": {
    "description": "Hold the post here instead of sending it. Nothing is queued and nothing reaches any platform; use posts_update with draft false to send it. Unrelated to the per-platform draft option, which uploads to the platform for the creator to finish.",
    "type": "boolean"
   },
   "groups": {
    "description": "Group names from groups_list, expanded to their members and combined with account_ids. Matched without regard to case.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "idempotency_key": {
    "description": "Reuse on retry to avoid posting twice; returns the original post.",
    "type": "string"
   },
   "media_ids": {
    "description": "Files to attach, in order. Order is the slideshow order.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "platform_options": {
    "description": "Per-platform settings, keyed by platform. Only the keys shown are accepted \u2014 an unknown key is refused rather than ignored. The names, types and accepted values are here; call platforms_list for what each one does, its default, and which kind of post it applies to.",
    "properties": {
     "facebook": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
     },
     "instagram": {
      "additionalProperties": false,
      "properties": {
       "coverUrl": {
        "format": "uri",
        "type": "string"
       },
       "isAiGenerated": {
        "type": "boolean"
       },
       "shareToFeed": {
        "type": "boolean"
       },
       "story": {
        "type": "boolean"
       },
       "thumbOffset": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "trialReel": {
        "enum": [
         "SS_PERFORMANCE",
         "MANUAL"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "tiktok": {
      "additionalProperties": false,
      "properties": {
       "autoAddMusic": {
        "type": "boolean"
       },
       "brandContentToggle": {
        "type": "boolean"
       },
       "brandOrganicToggle": {
        "type": "boolean"
       },
       "disableComment": {
        "type": "boolean"
       },
       "disableDuet": {
        "type": "boolean"
       },
       "disableStitch": {
        "type": "boolean"
       },
       "draft": {
        "type": "boolean"
       },
       "isAigc": {
        "type": "boolean"
       },
       "photoCoverIndex": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "privacyLevel": {
        "enum": [
         "PUBLIC_TO_EVERYONE",
         "MUTUAL_FOLLOW_FRIENDS",
         "FOLLOWER_OF_CREATOR",
         "SELF_ONLY"
        ],
        "type": "string"
       },
       "title": {
        "maxLength": 90,
        "type": "string"
       },
       "videoCoverTimestampMs": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "type": "object"
     },
     "x": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
     },
     "youtube": {
      "additionalProperties": false,
      "properties": {
       "categoryId": {
        "type": "string"
       },
       "containsSyntheticMedia": {
        "type": "boolean"
       },
       "madeForKids": {
        "type": "boolean"
       },
       "privacy": {
        "enum": [
         "public",
         "unlisted",
         "private"
        ],
        "type": "string"
       },
       "tags": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "title": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "scheduled_at": {
    "description": "ISO 8601. Omit to send as soon as possible.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "posts_schedule",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "post": {

    "properties": {
     "content": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "organizationId": {
      "type": "string"
     },
     "scheduledAt": {
      "anyOf": [
       {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "source": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "targets": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "externalUrl": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "id": {
         "type": "string"
        },
        "lastError": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "publishedAt": {
         "anyOf": [
          {
           "format": "date-time",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "socialAccountId": {
         "type": "string"
        },
        "status": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "socialAccountId",
        "status",
        "externalUrl",
        "publishedAt",
        "lastError"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "id",
     "status",
     "content",
     "scheduledAt",
     "source",
     "organizationId",
     "createdAt",
     "targets"
    ],
    "type": "object"
   }
  },
  "required": [
   "post"
  ],
  "type": "object"
 },
 "title": "Schedule a post"
}

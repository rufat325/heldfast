 },
 "description": "Search BookBrainz (MetaBrainz open book database) for works, editions, authors, publishers, series, or edition-groups by free-text query. Returns matching entity records with their BookBrainz UUIDs (bbids) for use with lookup.",
 "inputSchema": {
  "examples": [
   {
    "query": "The Great Gatsby",
    "type": "work"
   },
   {
    "limit": 5,
    "offset": 0,
    "query": "F. Scott Fitzgerald",
    "type": "author"
   }
  ],
  "properties": {
   "limit": {
    "description": "1-50 (default 10)",
    "type": "number"
   },
   "offset": {
    "description": "0-based offset",
    "type": "number"
   },
   "query": {
    "description": "Free-text query",
    "type": "string"
   },
   "type": {
    "description": "work | edition | author | publisher | series | edition-group",
    "type": "string"
   }
  },
  "required": [
   "query",
   "type"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "description": "Search results from BookBrainz API",
  "properties": {
   "resultCount": {
    "type": "number"
   },
   "searchResult": {
    "items": {
     "properties": {
      "bbid": {
       "type": "string"
      },
      "defaultAlias": {
       "properties": {
        "language": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "primary": {
         "type": "boolean"
        },
        "sortName": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "entityType": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "totalCount": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Search",
 "version": "v1.9ffdc2dd"
}

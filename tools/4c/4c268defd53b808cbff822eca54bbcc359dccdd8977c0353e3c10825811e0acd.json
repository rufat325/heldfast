{
 "description": "Transfer native tokens (ETH, SOL, BNB, etc.) to another address. Uses the active wallet from printr_wallet_unlock if no private_key is provided.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Amount to send in human-readable units (e.g. '0.1' for 0.1 ETH or SOL)",
    "type": "string"
   },
   "private_key": {
    "description": "Private key to sign the transaction. EVM: hex (with or without 0x). SVM: base58 keypair. If omitted, uses the active wallet from printr_wallet_unlock.",
    "type": "string"
   },
   "rpc_url": {
    "description": "Optional RPC endpoint override",
    "format": "uri",
    "type": "string"
   },
   "to": {
    "description": "CAIP-10 recipient address (e.g. 'eip155:8453:0x...' or 'solana:5eykt...:pubkey')",
    "type": "string"
   }
  },
  "required": [
   "to",
   "amount"
  ],
  "type": "object"
 },
 "name": "printr_transfer",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Amount sent in human-readable units",
    "type": "string"
   },
   "amount_atomic": {
    "description": "Amount sent in atomic units",
    "type": "string"
   },
   "chain": {
    "description": "CAIP-2 chain ID",
    "type": "string"
   },
   "chain_name": {
    "description": "Human-readable chain name",
    "type": "string"
   },
   "signature": {
    "description": "Solana transaction signature",
    "type": "string"
   },
   "symbol": {
    "description": "Native token symbol",
    "type": "string"
   },
   "to": {
    "description": "Recipient CAIP-10 address",
    "type": "string"
   },
   "tx_hash": {
    "description": "EVM transaction hash",
    "type": "string"
   }
  },
  "required": [
   "to",
   "chain",
   "chain_name",
   "amount",
   "amount_atomic",
   "symbol"
  ],
  "type": "object"
 }
}

 "description": "Total greenhouse-gas emissions by INDUSTRY SECTOR within a US state (EPA GHGRP) \u2014 answers 'which sectors emit the most in <state>'. Sectors: Power Plants, Refineries, Chemicals, Metals, Minerals, Pulp and Paper, Petroleum and Natural Gas Systems, Waste, etc. Returns each sector's total metric tons CO2e and facility count, ranked. State-scoped (pass a state); data lags ~1.5y so the latest full year (~2023) is auto-selected unless `year` is given.",
 "inputSchema": {
  "examples": [
   {
    "state": "Texas"
   },
   {
    "sector": "Power Plants",
    "state": "California"
   }
  ],
  "properties": {
   "sector": {
    "description": "Optional \u2014 filter to one sector by name (e.g. \"Power Plants\", \"Refineries\", \"Chemicals\").",
    "type": "string"
   },
   "state": {
    "description": "US state \u2014 2-letter code (\"TX\") or full name (\"Texas\"). Required (state-scoped, not national).",
    "type": "string"
   },
   "year": {
    "description": "Reporting year (default: latest available, ~2023).",
    "type": "number"
   }
  },
  "required": [
   "state"
  ],
  "type": "object"
 },

{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find Tibia spells by vocation, level, group, element and type. Use this for questions like \"which healing spells can a level 30 druid cast\". Call tibia_get with a title for cooldowns, effect and area.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "type": "string"
   },
   "element": {
    "description": "Damage element. For healing spells, use group.",
    "enum": [
     "death",
     "earth",
     "energy",
     "fire",
     "holy",
     "ice",
     "physical"
    ],
    "type": "string"
   },
   "group": {
    "description": "Runes are all filed under support, so find attack runes by spell_type and element.",
    "enum": [
     "attack",
     "healing",
     "support",
     "conjure"
    ],
    "type": "string"
   },
   "include_inactive": {
    "default": false,
    "type": "boolean"
   },
   "is_premium": {
    "type": "boolean"
   },
   "level_max": {
    "description": "Highest level the caster has.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "default": "level",
    "description": "level and mana ascend, title is alphabetical. Spells with a variable cost (party spells) store mana 0, so they come first by mana.",
    "enum": [
     "level",
     "mana",
     "title"
    ],
    "type": "string"
   },
   "spell_type": {
    "enum": [
     "instant",
     "rune"
    ],
    "type": "string"
   },
   "vocation": {
    "enum": [
     "knight",
     "sorcerer",
     "druid",
     "paladin",
     "monk"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tibia_find_spells",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "indexGeneratedAt": {
    "type": "string"
   },
   "nextCursor": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "element": {
       "type": [
        "string",
        "null"
       ]
      },
      "group": {
       "type": [
        "string",
        "null"
       ]
      },
      "isPremium": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "isPromotion": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "level": {
       "type": [
        "number",
        "null"
       ]
      },
      "mana": {
       "type": [
        "number",
        "null"
       ]
      },
      "spellType": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "vocations": {
       "items": {
        "enum": [
         "knight",
         "sorcerer",
         "druid",
         "paladin",
         "monk"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "words": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "title",
      "words",
      "spellType",
      "group",
      "element",
      "level",
      "mana",
      "vocations",
      "isPremium",
      "isPromotion"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalMatches": {
    "type": "number"
   }
  },
  "required": [
   "results",
   "totalMatches",
   "indexGeneratedAt"
  ],
  "type": "object"
 }
}

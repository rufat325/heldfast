{
 "description": "GET /projects for the authenticated user. Supports paging, sorting, search, and status filter.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderId": {
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "page": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "search": {
    "type": "string"
   },
   "sortBy": {
    "description": "e.g. updatedAt, createdAt, name, lastInteractedAt",
    "type": "string"
   },
   "sortOrder": {
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "starred": {
    "type": "boolean"
   },
   "status": {
    "enum": [
     "draft",
     "processing",
     "completed",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_projects",
 "title": "List projects"
}

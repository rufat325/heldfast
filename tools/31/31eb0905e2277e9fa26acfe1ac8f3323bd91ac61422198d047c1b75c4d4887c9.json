{
 "description": "Update item fields such as available_quantity (stock), status (active/paused/closed), price, or title",
 "inputSchema": {
  "properties": {
   "available_quantity": {
    "description": "Stock quantity",
    "type": "number"
   },
   "fields": {
    "additionalProperties": true,
    "description": "Arbitrary extra fields to send in the PUT body",
    "type": "object"
   },
   "itemId": {
    "description": "Item ID (e.g. MLB1234567890)",
    "type": "string"
   },
   "price": {
    "description": "New price",
    "type": "number"
   },
   "status": {
    "description": "Listing status (lowercase)",
    "enum": [
     "active",
     "paused",
     "closed"
    ],
    "type": "string"
   },
   "title": {
    "description": "New title (only allowed if item has no sales)",
    "type": "string"
   }
  },
  "required": [
   "itemId"
  ],
  "type": "object"
 },
 "name": "update_item"
}

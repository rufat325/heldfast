{
 "description": "Verify a contractor's license across US states (CA, TX, FL, NY). Search by license number, person name, or business name. Returns license status, expiration, classifications, and contact info from official state licensing boards.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "businessName": {
    "description": "Business name to search",
    "type": "string"
   },
   "firstName": {
    "description": "First name (optional with lastName)",
    "type": "string"
   },
   "lastName": {
    "description": "Last name for person search",
    "type": "string"
   },
   "licenseNumber": {
    "description": "License number to look up",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max results (max 25)",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "description": "US state: CA (CSLB), TX (TDLR), FL (DBPR), NY (NYC)",
    "enum": [
     "CA",
     "TX",
     "FL",
     "NY"
    ],
    "type": "string"
   }
  },
  "required": [
   "state"
  ],
  "type": "object"
 },
 "name": "verify_contractor_license"
}

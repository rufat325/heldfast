{
 "annotations": {
  "openWorldHint": true,
  "title": "Publish to WordPress (bulk)"
 },
 "description": "Publish multiple pages to WordPress in one async job. Free. Supports plugin mode and Basic Auth mode. Plugin mode preserves original URLs and pushes URL mappings automatically. Returns a job_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "author_id": {
    "description": "WordPress author ID (overrides mapping)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "category_id": {
    "description": "WordPress category ID (overrides mapping)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "page_ids": {
    "description": "Array of page UUIDs to publish",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "post_type": {
    "description": "WordPress post type (default: post)",
    "enum": [
     "post",
     "page"
    ],
    "type": "string"
   },
   "remove_links": {
    "description": "Remove links from content (default: false)",
    "type": "boolean"
   },
   "status": {
    "description": "Publish status (default: draft)",
    "enum": [
     "draft",
     "publish"
    ],
    "type": "string"
   },
   "use_rewritten_content": {
    "description": "Use rewritten content if available (default: true)",
    "type": "boolean"
   },
   "wordpress_domain": {
    "description": "Target WordPress domain",
    "type": "string"
   }
  },
  "required": [
   "page_ids",
   "wordpress_domain"
  ],
  "type": "object"
 },
 "name": "wordpress_publish_bulk"
}

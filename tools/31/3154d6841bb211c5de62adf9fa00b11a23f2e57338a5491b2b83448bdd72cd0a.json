{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Construct a commercial offer from supplied outcome, bundle and delivery terms; never invents scarcity. Use when an agent needs the Creative Techno book framework for offer builder.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bonuses": {
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "bundle": {
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "coreOutcome": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "customer": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "deliveryPromise": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "genuineScarcity": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "guarantee": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "ar",
     "en"
    ],
    "type": "string"
   },
   "priceOMR": {
    "description": "OMR; calculations use integer baisa internally",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "product": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "product",
   "customer",
   "coreOutcome",
   "deliveryPromise",
   "priceOMR"
  ],
  "type": "object"
 },
 "name": "offer_builder",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "frameworkSource": {
    "additionalProperties": false,
    "properties": {
     "edition": {
      "const": "2026",
      "type": "string"
     },
     "publisher": {
      "const": "Creative Techno",
      "type": "string"
     },
     "title": {
      "const": "\u0643\u064a\u0641 \u062a\u0628\u062f\u0623 \u0645\u0634\u0631\u0648\u0639\u0643 \u0627\u0644\u0635\u063a\u064a\u0631 \u0641\u064a \u0639\u064f\u0645\u0627\u0646\u061f",
      "type": "string"
     }
    },
    "required": [
     "publisher",
     "title",
     "edition"
    ],
    "type": "object"
   },
   "language": {
    "enum": [
     "ar",
     "en"
    ],
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "frameworkSource",
   "language",
   "result"
  ],
  "type": "object"
 }
}

{
 "description": "Recall memories from a store by a precomputed query vector (the caller supplies the embedding).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentId": {
    "description": "Filter by agent ID",
    "type": "string"
   },
   "instanceId": {
    "description": "Optional instance ID override",
    "type": "string"
   },
   "k": {
    "description": "Max results",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "memory_name": {
    "description": "The memory store name (from memory_stores)",
    "minLength": 1,
    "type": "string"
   },
   "namespace": {
    "description": "Filter by namespace",
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags (AND)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "threadId": {
    "description": "Filter by thread ID",
    "type": "string"
   },
   "threshold": {
    "description": "Max cosine distance",
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "vector": {
    "description": "Precomputed query embedding",
    "items": {
     "type": "number"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "memory_name",
   "vector"
  ],
  "type": "object"
 },
 "name": "memory_recall"
}

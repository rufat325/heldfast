{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Preview or delete a terminal clip batch. Dry-run is the default; real deletion requires explicit confirmation, retention choice, workspace delete permission, and an idempotency key.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "batchId": {
    "description": "UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "confirmDelete": {
    "default": false,
    "type": "boolean"
   },
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "idempotencyKey": {
    "maxLength": 255,
    "minLength": 8,
    "type": "string"
   },
   "retention": {
    "default": "retain_projects_and_exports",
    "enum": [
     "retain_projects_and_exports",
     "delete_projects_and_exports"
    ],
    "type": "string"
   },
   "workspaceId": {
    "description": "UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "batchId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "clip_batches_delete",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Delete Clip Batch"
}

{
 "description": "Search for a pattern in files on a remote server. Uses ripgrep if available, falls back to grep.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "include": {
    "description": "File glob to include (e.g. '*.ts')",
    "type": "string"
   },
   "path": {
    "description": "Directory or file to search (default: /root/project)",
    "type": "string"
   },
   "pattern": {
    "description": "Regex pattern to search for",
    "type": "string"
   },
   "server": {
    "description": "Server name (auto-selects if only one is running)",
    "type": "string"
   }
  },
  "required": [
   "pattern"
  ],
  "type": "object"
 },
 "name": "vm_grep"
}

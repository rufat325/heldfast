{
 "description": "Search Belgian street records in the official BeST address registry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum number of streets to return",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "municipalityId": {
    "description": "Municipality identifier URI",
    "type": "string"
   },
   "municipalityName": {
    "description": "Municipality name",
    "type": "string"
   },
   "name": {
    "description": "Street name",
    "type": "string"
   },
   "nisCode": {
    "description": "Municipality NIS code",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Result page number",
    "minimum": 1,
    "type": "number"
   },
   "postCode": {
    "description": "Belgian postal code",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "best_search_streets"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a 14- or 30-day structured content calendar from an offer and selected channels. Use when an agent needs the Creative Techno book framework for content plan generator.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "business": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "channels": {
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "days": {
    "anyOf": [
     {
      "const": 14,
      "type": "number"
     },
     {
      "const": 30,
      "type": "number"
     }
    ],
    "default": 14
   },
   "icp": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "ar",
     "en"
    ],
    "type": "string"
   },
   "offer": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "postingFrequencyPerWeek": {
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "business",
   "icp",
   "channels",
   "postingFrequencyPerWeek",
   "offer"
  ],
  "type": "object"
 },
 "name": "content_plan_generator",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "frameworkSource": {
    "additionalProperties": false,
    "properties": {
     "edition": {
      "const": "2026",
      "type": "string"
     },
     "publisher": {
      "const": "Creative Techno",
      "type": "string"
     },
     "title": {
      "const": "\u0643\u064a\u0641 \u062a\u0628\u062f\u0623 \u0645\u0634\u0631\u0648\u0639\u0643 \u0627\u0644\u0635\u063a\u064a\u0631 \u0641\u064a \u0639\u064f\u0645\u0627\u0646\u061f",
      "type": "string"
     }
    },
    "required": [
     "publisher",
     "title",
     "edition"
    ],
    "type": "object"
   },
   "language": {
    "enum": [
     "ar",
     "en"
    ],
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "frameworkSource",
   "language",
   "result"
  ],
  "type": "object"
 }
}

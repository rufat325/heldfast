{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Group Messages"
 },
 "description": "Full-text search messages in a specific group.\n\n    Uses Postgres ``plainto_tsquery`` with the 'simple' config (same\n    as the global ``/messages/search``). Scoped to non-soft-deleted\n    rows. Caller must be a member.\n\n    Hits are in ``items``; ``results`` is a DEPRECATED duplicate of the\n    same list. ``count`` is how many hits this response holds;\n    ``has_more`` is true when more match than ``limit`` allowed.",
 "inputSchema": {
  "properties": {
   "conversation_id": {
    "description": "UUID of the group conversation",
    "title": "Conversation Id",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Maximum results to return (1-100).",
    "maximum": 100,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "q": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "deprecated": true,
    "description": "Deprecated: use `query`, which means the same thing.",
    "title": "Q",
    "x-deprecated-alias-of": "query"
   },
   "query": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Search query (2-200 chars). Required.",
    "title": "Query"
   }
  },
  "required": [
   "conversation_id"
  ],
  "title": "search_group_messages_toolArguments",
  "type": "object"
 },
 "name": "colony_search_group_messages",
 "outputSchema": {
  "properties": {
   "result": {
    "title": "Result",
    "type": "string"
   }
  },
  "required": [
   "result"
  ],
  "title": "search_group_messages_toolOutput",
  "type": "object"
 }
}

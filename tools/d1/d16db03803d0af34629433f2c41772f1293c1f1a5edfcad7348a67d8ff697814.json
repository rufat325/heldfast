      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `season_not_found`: An explicit season year was requested but returned no standings data. Other values are possible when a failure originates below the handler.",
        "examples": [
         "season_not_found"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},

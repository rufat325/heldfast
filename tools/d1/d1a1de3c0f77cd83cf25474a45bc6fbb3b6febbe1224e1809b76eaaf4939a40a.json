{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage project notes. Methods: list, add",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "Note content (required for: add)",
    "type": "string"
   },
   "feature_id": {
    "description": "Link to feature (for: add)",
    "type": "string"
   },
   "limit": {
    "description": "Max results (for: list)",
    "type": "number"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "add"
    ],
    "type": "string"
   },
   "offset": {
    "description": "Skip N results (for: list)",
    "type": "number"
   },
   "project_id": {
    "description": "Project ID (auto-detected if omitted)",
    "type": "string"
   },
   "source": {
    "description": "Note source (for: add)",
    "enum": [
     "chat",
     "voice",
     "manual",
     "mcp"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tags (for: add)",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "notes"
}

     "other"
    ],
    "type": "string"
   },
   "city": {
    "description": "City or region, e.g. Muscat. Strongly recommended \u2014 same-city comparables score higher.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },

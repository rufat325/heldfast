{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Order an advanced certificate pack for one or more hostnames. Requires confirm:true (human-approval gate); without it returns a preview only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "certificate_authority": {
    "description": "Certificate authority. Default 'google'.",
    "enum": [
     "google",
     "lets_encrypt",
     "ssl_com"
    ],
    "type": "string"
   },
   "confirm": {
    "description": "Human-approval gate: must be true to actually perform this mutating operation. Omit or set false to get a non-executing preview of what would happen (with secrets redacted). A human should approve before this is set to true.",
    "type": "boolean"
   },
   "hosts": {
    "description": "Hostnames to cover, e.g. ['example.com', '*.example.com'].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "validation_method": {
    "description": "Domain control validation method. Default 'txt'.",
    "enum": [
     "txt",
     "http",
     "email"
    ],
    "type": "string"
   },
   "validity_days": {
    "anyOf": [
     {
      "const": 14,
      "type": "number"
     },
     {
      "const": 30,
      "type": "number"
     },
     {
      "const": 90,
      "type": "number"
     },
     {
      "const": 365,
      "type": "number"
     }
    ],
    "description": "Certificate validity in days. Default 90."
   },
   "zone_id": {
    "description": "The Cloudflare zone ID (32-char hex). Get it from list_zones.",
    "type": "string"
   }
  },
  "required": [
   "zone_id",
   "hosts"
  ],
  "type": "object"
 },
 "name": "order_certificate_pack"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the authenticated canonical Account Core prepaid USD balance.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "schema_version": {
    "const": "rqm.jobs.account-balance-request.v1",
    "type": "string"
   }
  },
  "required": [
   "schema_version"
  ],
  "type": "object"
 },
 "name": "get_account_balance",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "available_amount": {
      "pattern": "^(?:0|[1-9]\\d{0,13})(?:\\.\\d{1,6})?$",
      "type": "string"
     },
     "currency": {
      "const": "USD",
      "type": "string"
     },
     "reserved_amount": {
      "pattern": "^(?:0|[1-9]\\d{0,13})(?:\\.\\d{1,6})?$",
      "type": "string"
     },
     "rqm_account_id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "schema_version": {
      "const": "rqm.jobs.account-balance.v1",
      "type": "string"
     },
     "spent_amount": {
      "pattern": "^(?:0|[1-9]\\d{0,13})(?:\\.\\d{1,6})?$",
      "type": "string"
     },
     "version": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "schema_version",
     "rqm_account_id",
     "currency",
     "available_amount",
     "reserved_amount",
     "spent_amount",
     "version"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "AUTHENTICATION_REQUIRED",
       "MACHINE_AUTHENTICATION_FAILED",
       "MACHINE_AUTHORIZATION_FAILED",
       "ACCOUNT_CORE_UNAVAILABLE",
       "FEATURE_DISABLED",
       "QUOTE_NOT_ENTITLED",
       "QUOTE_IDEMPOTENCY_CONFLICT",
       "QUOTE_NOT_AVAILABLE",
       "QUOTE_REQUEST_INVALID",
       "QUOTE_MISMATCH",
       "PRICE_LIMIT_EXCEEDED",
       "RUNTIME_LIMIT_EXCEEDED",
       "ARTIFACT_PREFERENCE_UNAVAILABLE",
       "INSUFFICIENT_BALANCE",
       "RESERVATION_FAILED",
       "PRODUCT_REJECTED",
       "PRODUCT_UNAVAILABLE",
       "JOB_NOT_FOUND",
       "JOB_NOT_READY",
       "JOB_ACCESS_DENIED",
       "SETTLEMENT_FAILED",
       "FUNDING_UNAVAILABLE",
       "FUNDING_FAILED"
      ],
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retryable": {
      "type": "boolean"
     },
     "schema_version": {
      "const": "rqm.jobs.error.v1",
      "type": "string"
     }
    },
    "required": [
     "schema_version",
     "code",
     "message",
     "retryable"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Get RQM MCP account balance"
}

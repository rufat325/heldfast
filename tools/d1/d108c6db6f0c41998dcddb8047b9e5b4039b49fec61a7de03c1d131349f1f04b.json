{
 "description": "Export token usage data as JSON, CSV, or Markdown. Returns the full data payload in the requested format. Use JSON for programmatic consumption, CSV for spreadsheets, Markdown for reports.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Which data to export (default: all)",
    "enum": [
     "records",
     "models",
     "providers",
     "projects",
     "daily",
     "stats",
     "all"
    ],
    "type": "string"
   },
   "format": {
    "description": "Export format: json, csv, or markdown",
    "enum": [
     "json",
     "csv",
     "markdown"
    ],
    "type": "string"
   },
   "project": {
    "description": "Filter by project name/path substring",
    "type": "string"
   },
   "providers": {
    "description": "Filter to specific providers (e.g. ['claude-code','cursor'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scope": {
    "description": "Time scope: today, week (last 7d), month (calendar month), or all (default)",
    "enum": [
     "today",
     "week",
     "month",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "format"
  ],
  "type": "object"
 },
 "name": "drishti_export"
}

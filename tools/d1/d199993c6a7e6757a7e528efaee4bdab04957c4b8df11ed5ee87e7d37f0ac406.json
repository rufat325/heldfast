{
 "description": "Capture observations from sub-agents and teammates. The lead agent parses findings from sub-agent responses, then calls this to persist and analyze them. Identifies scar candidates.",
 "inputSchema": {
  "properties": {
   "observations": {
    "description": "Array of observations from sub-agents/teammates",
    "items": {
     "properties": {
      "context": {
       "description": "File, function, or area (optional)",
       "type": "string"
      },
      "severity": {
       "description": "Observation severity",
       "enum": [
        "info",
        "warning",
        "scar_candidate"
       ],
       "type": "string"
      },
      "source": {
       "description": "Who made this observation (e.g., \"Sub-Agent: code review\")",
       "type": "string"
      },
      "text": {
       "description": "What was observed",
       "type": "string"
      }
     },
     "required": [
      "source",
      "text",
      "severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "task_id": {
    "description": "Linear issue or task identifier (optional)",
    "type": "string"
   }
  },
  "required": [
   "observations"
  ],
  "type": "object"
 },
 "name": "absorb_observations"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List recent optimization traces from the local tracer. Summary only; use get_trace for full records.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "day": {
    "description": "UTC day YYYY-MM-DD; defaults to the most recent day with data",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_traces",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "day": {
    "type": "string"
   },
   "entries": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "mode": {
    "type": "string"
   },
   "tracesDir": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "List optimization traces"
}

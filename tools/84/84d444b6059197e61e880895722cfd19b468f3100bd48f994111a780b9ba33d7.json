 "description": "Fetch current top news headlines from NewsAPI, filterable by `country` (ISO 2-letter), `category` (business/entertainment/health/science/sports/technology), publisher `sources`, or keyword `q`. Returns article title, description, source, URL, and published date.",
 "inputSchema": {
  "examples": [

{
 "description": "Press a hardware/software key",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_id": {
    "description": "Device ID (optional if only one device)",
    "type": "string"
   },
   "key": {
    "description": "Key to press",
    "enum": [
     "back",
     "home",
     "enter",
     "tab",
     "delete",
     "menu",
     "recent_apps",
     "volume_up",
     "volume_down",
     "power",
     "search",
     "dpad_up",
     "dpad_down",
     "dpad_left",
     "dpad_right",
     "dpad_center"
    ],
    "type": "string"
   }
  },
  "required": [
   "key"
  ],
  "type": "object"
 },
 "name": "press_key"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get detailed info about a specific object by name, uuid, or path",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Object name (first match)",
    "type": "string"
   },
   "path": {
    "description": "Dot path: \"Scene.MyGroup.MyMesh\"",
    "type": "string"
   },
   "uuid": {
    "description": "Object UUID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "object_details"
}

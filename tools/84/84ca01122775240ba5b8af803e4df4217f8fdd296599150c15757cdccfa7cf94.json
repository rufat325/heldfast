     "A",
     "AAAA",
     "CNAME",
     "TXT",
     "MX",
     "NS",
     "SRV",
     "CAA",
     "PTR",
     "SPF"
    ],
    "type": "string"
   },
   "zone_id": {
    "description": "The Cloudflare zone ID (32-char hex). Get it from list_zones.",
    "type": "string"
   }
  },
  "required": [

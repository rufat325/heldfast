    "type": "boolean"
   },
   "name": {
    "description": "Filter by record name (FQDN).",
    "type": "string"
   },
   "page": {
    "type": "number"
   },
   "per_page": {
    "type": "number"
   },
   "type": {
    "description": "DNS record type.",

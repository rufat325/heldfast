    "type": "string"
   },
   "promocode": {
    "description": "\u041f\u0440\u043e\u043c\u043e\u043a\u043e\u0434 \u043d\u0430 \u0441\u043a\u0438\u0434\u043a\u0443",
    "type": "string"
   },
   "root_pass": {
    "description": "\u041f\u0430\u0440\u043e\u043b\u044c root: \u043c\u0438\u043d. 8 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432, \u0437\u0430\u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0431\u0443\u043a\u0432\u0430, \u0446\u0438\u0444\u0440\u0430, \u0441\u043f\u0435\u0446\u0441\u0438\u043c\u0432\u043e\u043b (\u043a\u0440\u043e\u043c\u0435 @ \u0438 #)",

 "description": "\u0417\u0430\u043a\u0430\u0437 instant- \u0438\u043b\u0438 stock-\u0441\u0435\u0440\u0432\u0435\u0440\u0430 (eq/order_instance). \u0412\u0410\u0416\u041d\u041e: \u0437\u0430\u043a\u0430\u0437 \u0441\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0441 \u043a\u0440\u0435\u0434\u0438\u0442\u043d\u043e\u0433\u043e \u0431\u0430\u043b\u0430\u043d\u0441\u0430 \u0438\u043b\u0438 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0438\u043d\u0432\u043e\u0439\u0441. \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 dry_run=true \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0435\u0441\u0435\u0442\u0430 \u0438 \u041e\u0421 \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u0432\u043e\u0434\u043a\u0443 \u0431\u0435\u0437 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0437\u0430\u043a\u0430\u0437\u0430. \u0414\u043b\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u0430\u043a\u0430\u0437\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435 dry_run=false \u0438 confirm=true \u043f\u043e\u0441\u043b\u0435 \u044f\u0432\u043d\u043e\u0433\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c. \u0414\u0435\u043f\u043b\u043e\u0439 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 10\u201330 \u043c\u0438\u043d\u0443\u0442, \u0441\u0442\u0430\u0442\u0443\u0441 \u2014 \u0447\u0435\u0440\u0435\u0437 check_task.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "\u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u0435\u043d (=true) \u0434\u043b\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0437\u0430\u043a\u0430\u0437\u0430",
    "type": "boolean"
   },
   "deploy_notify": {
    "description": "\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0438 \u0434\u0435\u043f\u043b\u043e\u044f \u043d\u0430 email (\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f true)",
    "type": "boolean"
   },
   "deploy_period": {

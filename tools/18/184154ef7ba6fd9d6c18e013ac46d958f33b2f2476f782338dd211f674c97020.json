{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Update a known project issue"
 },
 "description": "Change the status, severity or detail of a project issue, attach the task that fixes it, or record how it was resolved. Use this instead of logging a duplicate issue.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "detail": {
    "type": "string"
   },
   "issue_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "resolution": {
    "description": "What was done, required in spirit when closing an issue.",
    "type": "string"
   },
   "severity": {
    "enum": [
     "blocker",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "open",
     "in_progress",
     "resolved",
     "wont_fix"
    ],
    "type": "string"
   },
   "task_id": {
    "description": "Task that fixes this issue.",
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "issue_id"
  ],
  "type": "object"
 },
 "name": "update_project_issue",
 "title": "Update a known project issue"
}

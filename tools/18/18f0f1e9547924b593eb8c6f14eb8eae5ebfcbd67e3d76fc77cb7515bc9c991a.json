{
 "description": "Exporta los requests guardados como una Postman Collection v2.1 (JSON). Escribe el archivo en disco, importable directamente en Postman.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Nombre de la colecci\u00f3n (default: \"API Testing Collection\")",
    "type": "string"
   },
   "output_dir": {
    "description": "Directorio donde guardar el archivo (default: ./postman/)",
    "type": "string"
   },
   "resolve_variables": {
    "description": "Resolver {{variables}} del entorno activo (default: false)",
    "type": "boolean"
   },
   "tag": {
    "description": "Filtrar requests por tag",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "export_postman_collection"
}

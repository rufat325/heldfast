   },
   "ip": {
    "description": "\u0411\u0435\u043b\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a IP, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 10.0.0.2, 10.4.6.3/24",
    "type": "string"
   },
   "login_notify_address": {
    "description": "Email \u0438\u043b\u0438 webhook URL \u0434\u043b\u044f \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439",
    "type": "string"
   },
   "login_notify_method": {
    "description": "\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043e \u0432\u0445\u043e\u0434\u0430\u0445 \u043f\u043e \u043a\u043b\u044e\u0447\u0443; \u0434\u043b\u044f per-server \u043a\u043b\u044e\u0447\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 none",
    "enum": [
     "none",
     "email",
     "webhook"
    ],
    "type": "string"
   },
   "name": {
    "description": "\u0418\u043c\u044f \u043a\u043b\u044e\u0447\u0430",

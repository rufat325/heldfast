{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Font, size, line height, letter spacing, alignment and colour, on a TEXT layer. Only what you name is changed. Prefer figma_apply_style where the file has a text style for it \u2014 a named style survives a redesign and a hard-coded 14px does not.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "align": {
    "enum": [
     "LEFT",
     "CENTER",
     "RIGHT",
     "JUSTIFIED"
    ],
    "type": "string"
   },
   "autoResize": {
    "enum": [
     "NONE",
     "WIDTH_AND_HEIGHT",
     "HEIGHT",
     "TRUNCATE"
    ],
    "type": "string"
   },
   "color": {
    "description": "Hex colour.",
    "type": "string"
   },
   "fontFamily": {
    "type": "string"
   },
   "fontSize": {
    "minimum": 1,
    "type": "number"
   },
   "fontStyle": {
    "description": "Weight or style, like \"Semi Bold\".",
    "type": "string"
   },
   "letterSpacing": {
    "description": "In pixels.",
    "type": "number"
   },
   "lineHeight": {
    "description": "In pixels.",
    "minimum": 0,
    "type": "number"
   },
   "nodeId": {
    "description": "Figma node id, like \"21:10314\". Omit to use whatever is selected on the canvas.",
    "type": "string"
   }
  },
  "required": [
   "nodeId"
  ],
  "type": "object"
 },
 "name": "figma_set_text_style",
 "title": "Set type on a text layer"
}

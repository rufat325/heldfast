{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Highlight an object for debugging (wireframe or visibility toggle). Runtime only \u2014 for visual inspection, not persisted.\n\nDebug only \u2014 page reload will reset. No code changes needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "enabled": {
    "description": "Enable/disable highlight (default: true)",
    "type": "boolean"
   },
   "mode": {
    "description": "Highlight mode (default: wireframe)",
    "enum": [
     "wireframe",
     "visibility"
    ],
    "type": "string"
   },
   "name": {
    "description": "Object name",
    "type": "string"
   },
   "uuid": {
    "description": "Object UUID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "highlight_object"
}

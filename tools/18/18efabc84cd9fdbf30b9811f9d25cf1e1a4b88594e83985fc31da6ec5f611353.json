{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Event Draft"
 },
 "description": "Create an event draft on the user's behalf and return a claim link they open to publish it. Use when a user wants to create or publish an event \u2014 works even if they have no SocialLoop account yet. The draft is private until the user opens the claim link and confirms. For a user connected via 'Connect with SocialLoop', it publishes directly to their account and returns a manage link instead. Ticketing can be free RSVP, a fixed price, named tiers, or a donation (ticket_mode 'pwyw') with a minimum and suggested amounts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capacity": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "category": {
    "maxLength": 80,
    "type": "string"
   },
   "contact_email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "cover_image_url": {
    "format": "uri",
    "maxLength": 2000,
    "type": "string"
   },
   "description_html": {
    "maxLength": 20000,
    "type": "string"
   },
   "ends_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z||([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "event_description": {
    "maxLength": 5000,
    "type": "string"
   },
   "event_name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "idempotency_key": {
    "default": "be2c1312-5a5e-4bb9-9d61-7bffb36b9dd4",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "location_address": {
    "maxLength": 500,
    "type": "string"
   },
   "pwyw_min_price": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "pwyw_suggested_prices": {
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 1000000,
     "type": "number"
    },
    "maxItems": 6,
    "type": "array"
   },
   "requires_approval": {
    "type": "boolean"
   },
   "source": {
    "maxLength": 120,
    "type": "string"
   },
   "starts_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z||([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "ticket_mode": {
    "default": "rsvp",
    "enum": [
     "rsvp",
     "paid",
     "tiered",
     "pwyw"
    ],
    "type": "string"
   },
   "ticket_price": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "tiers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "capacity": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 1000000,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "price": {
       "maximum": 1000000,
       "minimum": 0,
       "type": "number"
      },
      "requires_approval": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "price"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "timezone": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "venue_name": {
    "maxLength": 200,
    "type": "string"
   },
   "visibility": {
    "default": "public",
    "enum": [
     "public",
     "friends",
     "private"
    ],
    "type": "string"
   }
  },
  "required": [
   "idempotency_key",
   "event_name",
   "starts_at",
   "visibility",
   "ticket_mode"
  ],
  "type": "object"
 },
 "name": "create_event_draft",
 "title": "Create Event Draft"
}

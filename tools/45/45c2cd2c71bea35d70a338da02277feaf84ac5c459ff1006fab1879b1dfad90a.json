{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Draft a customer-facing response for a supplied sales situation; does not send messages. Use when an agent needs the Creative Techno book framework for sales response builder.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "business": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "case": {
    "enum": [
     "price_inquiry",
     "price_objection",
     "undecided",
     "close_sale",
     "post_purchase",
     "upsell",
     "complaint"
    ],
    "type": "string"
   },
   "customerMessage": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "ar",
     "en"
    ],
    "type": "string"
   },
   "priceOMR": {
    "description": "OMR; calculations use integer baisa internally",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "product": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "case",
   "business",
   "product",
   "customerMessage"
  ],
  "type": "object"
 },
 "name": "sales_response_builder",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "frameworkSource": {
    "additionalProperties": false,
    "properties": {
     "edition": {
      "const": "2026",
      "type": "string"
     },
     "publisher": {
      "const": "Creative Techno",
      "type": "string"
     },
     "title": {
      "const": "\u0643\u064a\u0641 \u062a\u0628\u062f\u0623 \u0645\u0634\u0631\u0648\u0639\u0643 \u0627\u0644\u0635\u063a\u064a\u0631 \u0641\u064a \u0639\u064f\u0645\u0627\u0646\u061f",
      "type": "string"
     }
    },
    "required": [
     "publisher",
     "title",
     "edition"
    ],
    "type": "object"
   },
   "language": {
    "enum": [
     "ar",
     "en"
    ],
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "frameworkSource",
   "language",
   "result"
  ],
  "type": "object"
 }
}

{
 "description": "List transfers with optional filters",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of results (default 10)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset",
    "type": "number"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "PENDING",
     "BANK_PROCESSING",
     "DONE",
     "CANCELLED",
     "FAILED"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by transfer type",
    "enum": [
     "BANK_ACCOUNT_TRANSFER",
     "ASAAS_ACCOUNT_TRANSFER"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_transfers"
}

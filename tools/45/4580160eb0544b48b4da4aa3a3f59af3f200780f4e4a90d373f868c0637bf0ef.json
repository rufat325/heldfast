{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Recent crowdfunding and P2P lending news: headline, summary, publication date, category, and a link to the article at its publisher. Filter by category, by kind (editorial \u2014 written by CrowdSpace, syndicated \u2014 aggregated from the industry press, or all), and by date range. Use it for \"what happened recently / any news about X\" questions, and cite the URL each item carries \u2014 for a syndicated item that is the original publisher, not CrowdSpace. Do NOT use it to establish facts about a platform: it is a news feed, not the catalogue; search_platforms holds the current data.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "News category slug.",
    "enum": [
     "fundraiser-tips",
     "investor-insights",
     "market-data",
     "platform-update",
     "regulation",
     "success-story",
     "tools-tech",
     "trends",
     "campaign-news"
    ],
    "type": "string"
   },
   "from": {
    "description": "Published on or after, YYYY-MM-DD.",
    "type": "string"
   },
   "kind": {
    "description": "all (default), editorial (written by CrowdSpace) or syndicated (aggregated from the press).",
    "enum": [
     "all",
     "editorial",
     "syndicated"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Language of the returned items.",
    "type": "string"
   },
   "page": {
    "description": "Page number, 1-based.",
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per call, 1-25. Default 20.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "to": {
    "description": "Published on or before, YYYY-MM-DD.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_industry_news",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "meta": {
    "additionalProperties": true,
    "description": "Paging and the tier that answered.",
    "properties": {
     "generated_at": {
      "description": "When these figures were computed, ISO 8601 UTC.",
      "type": "string"
     },
     "language": {
      "type": "string"
     },
     "page": {
      "type": "integer"
     },
     "per_page": {
      "type": "integer"
     },
     "sort": {
      "type": "string"
     },
     "tier": {
      "type": "string"
     },
     "total": {
      "type": "integer"
     },
     "total_active": {
      "description": "How many of the matches are still operating \u2014 the number the aggregate tools count.",
      "type": "integer"
     },
     "total_pages": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "news": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "canonical_url": {
       "description": "The publisher that wrote it \u2014 not always CrowdSpace.",
       "type": "string"
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "language": {
       "type": "string"
      },
      "published": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "source": {
       "properties": {
        "name": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "url"
       ],
       "type": "object"
      },
      "summary": {
       "type": "string"
      },
      "syndicated": {
       "description": "True when the article belongs to another publisher.",
       "type": "boolean"
      },
      "title": {
       "type": "string"
      },
      "updated_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "title",
      "canonical_url",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "news",
   "meta"
  ],
  "type": "object"
 },
 "title": "Industry news"
}

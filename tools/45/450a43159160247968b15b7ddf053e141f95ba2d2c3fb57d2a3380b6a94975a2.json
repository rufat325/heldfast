{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List handled comments"
 },
 "description": "List handled comments. Comments the AI Comment Manager handled, newest first, kept 30 days. Each carries the comment, its sentiment, what moderation did, the AI draft, and what happened to the reply. status=pending is the approval queue.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel": {
    "description": "instagram or facebook.",
    "enum": [
     "instagram",
     "facebook"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Page size, 1 to 100. Default 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "post_id": {
    "description": "Comments on one post.",
    "type": "string"
   },
   "since": {
    "description": "ISO-8601 UTC on created_at.",
    "format": "date-time",
    "type": "string"
   },
   "starting_after": {
    "description": "The next_cursor from the previous page.",
    "type": "string"
   },
   "status": {
    "description": "Where the comment is.",
    "enum": [
     "pending",
     "approved",
     "rejected",
     "sent",
     "failed",
     "skipped",
     "moderated"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_handled_comments"
}

 "description": "Search active eBay listings (US marketplace). Returns title, price, condition, seller, thumbnail, and item_id per hit. Use ebay_get_item with the returned item_id for full detail.",
 "inputSchema": {
  "examples": [
   {
    "limit": 25,
    "q": "iPhone 15 Pro 256GB",
    "sort": "price"
   },
   {
    "category_id": "15687",
    "filter": "price:[50..200],conditions:{USED}",
    "limit": 50,
    "q": "vintage leather jacket"
   }
  ],
  "properties": {
   "category_id": {
    "description": "eBay category ID to scope to (see ebay_get_categories)",
    "type": "string"
   },
   "filter": {
    "description": "Advanced Browse API filter, e.g. \"price:[20..100],conditions:{NEW},buyingOptions:{FIXED_PRICE}\". See Browse docs.",
    "type": "string"
   },
   "limit": {
    "description": "1\u2013200 (default 25)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset (default 0)",
    "type": "number"
   },
   "q": {
    "description": "Keyword query (e.g. \"iPhone 15 Pro 256GB\")",
    "type": "string"
   },
   "sort": {
    "description": "price (asc) | -price (desc) | newlyListed | endingSoonest",
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },

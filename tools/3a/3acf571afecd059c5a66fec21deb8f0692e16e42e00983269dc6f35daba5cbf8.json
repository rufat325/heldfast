{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get scan analytics"
 },
 "description": "Scan analytics over a period: totals, unique scanners, scans-by-day, and top countries/cities/OS/browsers. Pass a QR code `id` for one code, or omit it for the whole workspace (which also returns the top codes). Use this to answer 'how did my codes do this month and where were people scanning?'.",
 "inputSchema": {
  "properties": {
   "days": {
    "description": "Look-back window in days (default 30, max 365).",
    "type": "integer"
   },
   "end": {
    "description": "Range end, ISO date/datetime. Defaults to now when only `start` is given.",
    "type": "string"
   },
   "id": {
    "description": "QR code id for per-code analytics; omit for workspace-wide.",
    "type": "string"
   },
   "start": {
    "description": "Range start, ISO date or datetime (e.g. 2026-08-03 or 2026-08-03T14:00:00Z). Use start/end together for a fixed window instead of the rolling `days` look-back.",
    "type": "string"
   },
   "workspace": {
    "description": "Workspace id. Optional when the account has one workspace; use list_workspaces to resolve otherwise.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_analytics",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "end": {
    "type": "string"
   },
   "error": {
    "additionalProperties": true,
    "description": "Present only when the tool failed (the result is also flagged isError).",
    "properties": {
     "cause": {
      "description": "Machine-readable failure category: invalid_argument, not_found, forbidden, plan_limit, rate_limited, or server_error.",
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retryable": {
      "description": "Whether repeating the same call could succeed.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "period_days": {
    "type": "integer"
   },
   "qr_code_id": {
    "description": "Set when the report is for a single code.",
    "type": "string"
   },
   "scans_by_day": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "date": {
       "type": "string"
      },
      "scans": {
       "type": "integer"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "start": {
    "type": "string"
   },
   "top_browsers": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "scans": {
       "type": "integer"
      },
      "value": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "top_cities": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "scans": {
       "type": "integer"
      },
      "value": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "top_codes": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "id": {
       "type": [
        "string",
        "null"
       ]
      },
      "scans": {
       "type": "integer"
      },
      "value": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "top_countries": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "scans": {
       "type": "integer"
      },
      "value": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "top_os": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "scans": {
       "type": "integer"
      },
      "value": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "total_scans": {
    "type": "integer"
   },
   "unique_scans": {
    "type": "integer"
   },
   "workspace": {
    "description": "Set when the report is workspace-wide.",
    "type": "string"
   }
  },
  "type": "object"
 }
}

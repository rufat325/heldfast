{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Report measured token usage for the current execution. Runtime blocks empty reports and generates deterministic idempotency key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "payload": {
    "additionalProperties": false,
    "properties": {
     "aiAgentFlowRunID": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "aiAgentTaskExecutionID": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "requestKey": {
      "minLength": 1,
      "type": "string"
     },
     "taskID": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "tokenUsages": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "cost": {
         "minimum": 0,
         "type": "number"
        },
        "currency": {
         "maxLength": 20,
         "minLength": 1,
         "type": "string"
        },
        "estimationModelVersion": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "inputTokens": {
         "minimum": 0,
         "type": "integer"
        },
        "measurement": {
         "enum": [
          "exact",
          "estimated",
          "unavailable"
         ],
         "type": "string"
        },
        "measurementSource": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "model": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "outputTokens": {
         "minimum": 0,
         "type": "integer"
        },
        "providerRequestID": {
         "maxLength": 500,
         "type": "string"
        },
        "totalTokens": {
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "measurement"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "taskID",
     "aiAgentFlowRunID",
     "tokenUsages"
    ],
    "type": "object"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "laviya_report_token_usage",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {},
   "result": {}
  },
  "type": "object"
 },
 "title": "Report Token Usage"
}

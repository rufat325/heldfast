{
 "description": "Run a Volatility 3 Windows plugin against a memory dump. Returns plugin, success, output, and errors. Read-only analysis, Volatility 3 auto-detects OS. Requires vol3 (vol) on PATH.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dump_path": {
    "description": "Path to the Windows memory dump file",
    "type": "string"
   },
   "plugin": {
    "description": "Volatility 3 Windows plugin to run",
    "enum": [
     "windows.info",
     "windows.pslist",
     "windows.pstree",
     "windows.netscan",
     "windows.netstat",
     "windows.filescan",
     "windows.malfind",
     "windows.cmdline",
     "windows.dlllist",
     "windows.handles",
     "windows.registry.hivelist",
     "windows.registry.printkey",
     "windows.envars",
     "windows.svcscan"
    ],
    "type": "string"
   }
  },
  "required": [
   "dump_path",
   "plugin"
  ],
  "type": "object"
 },
 "name": "volatility_windows"
}

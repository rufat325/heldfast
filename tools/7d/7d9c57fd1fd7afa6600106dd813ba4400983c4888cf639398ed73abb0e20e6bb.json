{
 "description": "Update a current Granoflow task with common structured fields. AI execution never sets status=doing: it remains pending until verified completion and writes actual execution time through granoflow_task_history_mutate. status=doing is for human manual focus and keeps the App-recorded start behavior. When moving it into a milestone without dueAt, inherit the milestone deadline; a later explicit date fails closed. Defaults to dry-run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "descriptionImpactReview": {
    "additionalProperties": false,
    "properties": {
     "authoringEvidence": {
      "additionalProperties": {},
      "description": "Required for AI or automation task creation: declare an action/outcome title, plain-language review, and exact analogy/example excerpts from the description.",
      "type": "object"
     },
     "decision": {
      "enum": [
       "unchanged",
       "rewrite"
      ],
      "type": "string"
     },
     "fiveDimensionsReviewed": {
      "type": "boolean"
     },
     "rationale": {
      "minLength": 1,
      "type": "string"
     },
     "reasonCode": {
      "enum": [
       "operational_only",
       "review_only",
       "completion_only",
       "completion_summary_only",
       "historical_time_only",
       "node_completion_only",
       "placement_reviewed_no_semantic_change",
       "title_clarification_no_semantic_change",
       "semantic_change",
       "description_correction",
       "post_completion_revision"
      ],
      "type": "string"
     },
     "reviewedDescriptionSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "reviewedTaskUpdatedAt": {
      "minLength": 1,
      "type": "string"
     },
     "writebackRefs": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "reviewedTaskUpdatedAt",
     "reviewedDescriptionSha256",
     "decision",
     "reasonCode",
     "rationale"
    ],
    "type": "object"
   },
   "dryRun": {
    "default": true,
    "description": "When true, previews the request without writing.",
    "type": "boolean"
   },
   "dueAt": {
    "description": "Explicit task deadline. When milestoneId is supplied and this is omitted, the task inherits the selected milestone deadline. A later explicit date fails closed.",
    "type": "string"
   },
   "expectedUpdatedAt": {
    "format": "date-time",
    "type": "string"
   },
   "milestoneId": {
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "remindAt": {
    "type": "string"
   },
   "status": {
    "minLength": 1,
    "type": "string"
   },
   "taskId": {
    "description": "Granoflow task id.",
    "minLength": 1,
    "type": "string"
   },
   "taskReview": {
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId",
   "descriptionImpactReview"
  ],
  "type": "object"
 },
 "name": "granoflow_task_update_structured"
}

{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get playlist tracks"
 },
 "description": "List the tracks in one of your connected-service playlists.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "description": "Max items to return (default 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "playlistId": {
    "description": "Playlist id from vibo_get_playlists.",
    "type": "string"
   },
   "skip": {
    "description": "Number of items to skip, for paging (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "source": {
    "description": "Streaming source \u2014 must be connected to your Vibo account.",
    "enum": [
     "spotify",
     "appleMusic"
    ],
    "type": "string"
   }
  },
  "required": [
   "playlistId",
   "source"
  ],
  "type": "object"
 },
 "name": "vibo_get_playlist_songs"
}

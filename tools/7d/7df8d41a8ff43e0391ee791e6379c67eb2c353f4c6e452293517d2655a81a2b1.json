{
 "_meta": {
  "xdata.kr/credential": {
   "providers": [
    "kb_fast_account"
   ],
   "register_url": "https://console.xdata.kr/credentials?link=1&priority=kb_fast_account",
   "required": true,
   "windows_pc_needed": false
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "REQUIRES prior kb_fast_account__session__login call with same account_link_id. Search transaction history for one registered KB Kookmin Bank fast-account using the existing provider session.",
 "inputSchema": {
  "properties": {
   "account_link_id": {
    "description": "Account link ID (UUID v4). Optional \u2014 the server auto-resolves from your API key when omitted. Provide explicitly only when you have multiple certificates for the same provider. Each institution has a separate ID (Hometax != NHIS != NPS != FourInsure).",
    "type": "string"
   },
   "bank_account_credential_id": {
    "dynamic_options": {
     "execution_target": true,
     "selection_ids_param": "bank_account_credential_ids",
     "selection_mode_param": "bank_account_selection_mode",
     "service_key": "kb_fast_account",
     "source": "credential_bank_accounts"
    },
    "format": "uuid",
    "type": "string",
    "user_editable": false,
    "visibility": "system"
   },
   "bank_account_credential_ids": {
    "dynamic_options": {
     "execution_target": false,
     "service_key": "kb_fast_account",
     "source": "credential_bank_accounts"
    },
    "items": {
     "format": "uuid",
     "type": "string"
    },
    "type": "array",
    "ui_type": "credential_bank_accounts",
    "visibility": "user"
   },
   "bank_account_selection_mode": {
    "default": "default",
    "enum": [
     "selected",
     "default"
    ],
    "type": "string",
    "ui_type": "select",
    "visibility": "user"
   },
   "end_date": {
    "description": "End date YYYY-MM-DD or YYYYMMDD",
    "type": "string"
   },
   "sort_order": {
    "default": "desc",
    "description": "Transaction time sort order",
    "enum": [
     "desc",
     "asc"
    ],
    "type": "string"
   },
   "start_date": {
    "description": "Start date YYYY-MM-DD or YYYYMMDD",
    "type": "string"
   },
   "transaction_type": {
    "default": "all",
    "description": "Transaction direction filter",
    "enum": [
     "all",
     "deposit",
     "withdrawal"
    ],
    "type": "string"
   }
  },
  "required": [
   "bank_account_credential_id",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "kb_fast_account__accounts__transaction_history__search",
 "securitySchemes": [
  {
   "scopes": [
    "mcp:tools:list",
    "mcp:tools:call"
   ],
   "type": "oauth2"
  }
 ],

{
 "description": "Export ideas from the idea journal as a formatted markdown document.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "priority": {
    "description": "Filter by priority",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status (default: all)",
    "enum": [
     "new",
     "in-progress",
     "published",
     "rejected"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "export_ideas"
}

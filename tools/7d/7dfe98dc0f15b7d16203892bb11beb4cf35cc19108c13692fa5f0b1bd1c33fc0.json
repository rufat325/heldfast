{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "YNAB: Get Transaction Details"
 },
 "description": "Get full details for a single transaction by ID.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - transaction_id (string, required): Transaction UUID.\n  - response_format (string, optional): \"json\" or \"markdown\" (default: \"markdown\").\n\nReturns: transaction (id, date, amount, memo, cleared, approved, account_id, payee_name, category_name, subtransactions), cached, cache_info\n\nErrors:\n  - \"No default budget set\" \u2192 run ynab_set_default_budget first\n  - \"Transaction not found\" \u2192 invalid transaction_id",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   },
   "transaction_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "transaction_id"
  ],
  "type": "object"
 },
 "name": "ynab_get_transaction",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cache_info": {
    "description": "Human-readable cache status message (e.g., \"Cache hit\", \"Cache miss\")",
    "type": "string"
   },
   "cached": {
    "description": "Indicates if data was served from cache",
    "type": "boolean"
   },
   "transaction": {
    "additionalProperties": false,
    "description": "Transaction details",
    "properties": {
     "account_id": {
      "description": "Account ID",
      "type": "string"
     },
     "account_name": {
      "description": "Account name",
      "type": "string"
     },
     "amount": {
      "description": "Transaction amount in dollars",
      "type": "number"
     },
     "approved": {
      "description": "Approved flag",
      "type": "boolean"
     },
     "category_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Category ID"
     },
     "category_name": {
      "description": "Category name",
      "type": "string"
     },
     "cleared": {
      "description": "Cleared status",
      "type": "string"
     },
     "date": {
      "description": "Transaction date",
      "type": "string"
     },
     "deleted": {
      "description": "Deleted flag",
      "type": "boolean"
     },
     "flag_color": {
      "description": "Flag color",
      "type": "string"
     },
     "id": {
      "description": "Transaction ID",
      "type": "string"
     },
     "import_id": {
      "description": "Import ID",
      "type": "string"
     },
     "matched_transaction_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Matched transaction ID"
     },
     "memo": {
      "description": "Transaction memo",
      "type": "string"
     },
     "payee_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Payee ID"
     },
     "payee_name": {
      "description": "Payee name",
      "type": "string"
     },
     "transfer_account_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Transfer account ID"
     },
     "transfer_transaction_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Transfer transaction ID"
     }
    },
    "required": [
     "id",
     "date",
     "amount",
     "cleared",
     "approved",
     "account_id",
     "deleted"
    ],
    "type": "object"
   },
   "usedDelta": {
    "description": "Indicates if delta merge optimization was applied for budgets",
    "type": "boolean"
   }
  },
  "required": [
   "transaction"
  ],
  "type": "object"
 }
}

    "where": "incident_year=2025"
   },
   {
    "_apiKey": "your-data-sf-api-key",
    "group": "incident_category",
    "order": "count(*) DESC",
    "resource_id": "wg3w-h783",
    "select": "incident_category, count(*)"
   }
  ],
  "properties": {

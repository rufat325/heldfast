{
 "description": "List WordPress posts with optional filters",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "author": {
    "description": "Author ID",
    "type": "number"
   },
   "categories": {
    "description": "Category ID(s), comma-separated",
    "type": "string"
   },
   "order": {
    "default": "desc",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "orderby": {
    "default": "date",
    "enum": [
     "date",
     "title",
     "modified",
     "id"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "number"
   },
   "per_page": {
    "default": 10,
    "description": "Posts per page (max 100)",
    "type": "number"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "Post status filter",
    "enum": [
     "publish",
     "future",
     "draft",
     "pending",
     "private",
     "trash"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tag ID(s), comma-separated",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_posts"
}

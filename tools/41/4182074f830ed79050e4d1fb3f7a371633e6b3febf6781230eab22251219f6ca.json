{
 "description": "Start a site audit (crawls for SEO, content-quality, and technical issues). Async: poll get_job_status with the returned id.",
 "inputSchema": {
  "properties": {
   "include_paths": {
    "description": "Path prefixes to limit crawling, e.g. ['/blog', '/products']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "max_pages": {
    "description": "Max pages to crawl, 1-1000 (default 100)",
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "selected_page_urls": {
    "description": "Specific page URLs to audit (max 500)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "settings": {
    "description": "Audit settings object",
    "type": "object"
   },
   "site_id": {
    "type": "string"
   },
   "type": {
    "description": "Default 'full'. Use 'section' for path-scoped audits.",
    "enum": [
     "full",
     "quick",
     "technical",
     "section"
    ],
    "type": "string"
   }
  },
  "required": [
   "site_id"
  ],
  "type": "object"
 },
 "name": "start_audit"
}

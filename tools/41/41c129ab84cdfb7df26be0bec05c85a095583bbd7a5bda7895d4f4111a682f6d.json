    "type": "string"
   },
   "requestedAction": {
    "enum": [
     "find",
     "read",
     "compare",
     "rank",
     "create",
     "update",
     "delete",
     "submit",
     "export",
     "notify",
     "schedule",
     "connect",
     "debug",
     "other"
    ],
    "type": "string"
   },
   "requestedCapability": {
    "enum": [
     "search",
     "inspect",
     "compare",
     "rank",
     "recommend",
     "track",
     "update",
     "apply",
     "submit",
     "export",
     "notify",
     "schedule",
     "integrate",
     "authenticate",
     "debug",
     "other"
    ],
    "type": "string"
   },
   "requestedDestination": {
    "enum": [
     "trackly",
     "external_site",
     "file",
     "email",
     "calendar",
     "crm",
     "browser",
     "other"
    ],
    "type": "string"
   },
   "requestedResource": {

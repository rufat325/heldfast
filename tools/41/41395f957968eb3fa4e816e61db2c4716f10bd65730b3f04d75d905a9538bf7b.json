{
 "description": "List/search a site's CMS posts (paginated). Filter by status, type, category/tag/author slug, updated_since; q = ranked full-text search; sort=demand = visitor-question demand.",
 "inputSchema": {
  "properties": {
   "author": {
    "description": "Author slug (primary or co-author).",
    "type": "string"
   },
   "category": {
    "description": "Category slug.",
    "type": "string"
   },
   "page": {
    "description": "Default 1.",
    "type": "number"
   },
   "page_size": {
    "description": "Max 100, default 20.",
    "type": "number"
   },
   "q": {
    "description": "Full-text search over title + body (ranked).",
    "type": "string"
   },
   "site_id": {
    "description": "From list_sites.",
    "type": "string"
   },
   "sort": {
    "description": "Order. demand = visitor-question demand desc. Default created_at (or relevance when q set).",
    "enum": [
     "created_at",
     "published_at",
     "demand"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "published",
     "scheduled"
    ],
    "type": "string"
   },
   "tag": {
    "description": "Tag slug.",
    "type": "string"
   },
   "type": {
    "enum": [
     "blog_post",
     "page",
     "faq",
     "glossary",
     "comparison",
     "pillar",
     "how_to",
     "landing",
     "listicle",
     "case_study",
     "tutorial",
     "news",
     "product_update",
     "data_report",
     "event",
     "resource",
     "alternative",
     "tool_review"
    ],
    "type": "string"
   },
   "updated_since": {
    "description": "ISO-8601; only posts changed at/after this.",
    "type": "string"
   }
  },
  "required": [
   "site_id"
  ],
  "type": "object"
 },
 "name": "list_cms_posts"
}

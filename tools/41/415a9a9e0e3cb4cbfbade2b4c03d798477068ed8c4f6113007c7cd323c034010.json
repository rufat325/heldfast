{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update a post"
 },
 "description": "Update a post. Edit a draft, scheduled or failed post (409 not_editable otherwise). Send only what changes; tiktok merges field by field; other arrays and objects replace. scheduled_at set moves or schedules it (post.scheduled fires); scheduled_at null turns a scheduled post back into a draft.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "caption": {
    "maxLength": 2200,
    "type": "string"
   },
   "collaborators": {
    "description": "Instagram usernames to invite as collaborators. Instagram only.",
    "items": {
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "comment_auto_reply": {
    "description": "Becomes a comment trigger scoped to this post when it publishes. Instagram and Facebook only.",
    "properties": {
     "buttons": {
      "description": "At least two for any DM mode.",
      "items": {
       "properties": {
        "response": {
         "type": "string"
        },
        "title": {
         "maxLength": 20,
         "type": "string"
        },
        "type": {
         "enum": [
          "text",
          "url"
         ],
         "type": "string"
        },
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "title"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "dm_templates": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "keywords": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "match_type": {
      "default": "contains",
      "enum": [
       "exact",
       "contains",
       "fuzzy"
      ],
      "type": "string"
     },
     "public_replies": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "response_mode": {
      "default": "both",
      "enum": [
       "both",
       "public_only",
       "dm_only"
      ],
      "type": "string"
     }
    },
    "required": [
     "keywords"
    ],
    "type": "object"
   },
   "cover_offset_ms": {
    "description": "Reels: which frame is the cover.",
    "type": [
     "integer",
     "null"
    ]
   },
   "first_comment": {
    "description": "Posted under the post right after publish. Instagram and Facebook only.",
    "type": [
     "string",
     "null"
    ]
   },
   "hashtags": {
    "description": "Without the #.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "Numeric id.",
    "type": "integer"
   },
   "platform": {
    "default": "instagram",
    "description": "A target set. both = Instagram + Facebook; all = all three.",
    "enum": [
     "instagram",
     "facebook",
     "both",
     "tiktok",
     "instagram_tiktok",
     "facebook_tiktok",
     "all"
    ],
    "type": "string"
   },
   "post_type": {
    "default": "feed_post",
    "enum": [
     "feed_post",
     "carousel",
     "reels",
     "story"
    ],
    "type": "string"
   },
   "scheduled_at": {
    "description": "ISO-8601. Null on PATCH turns a scheduled post back into a draft.",
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "tiktok": {
    "description": "TikTok settings. Ignored unless TikTok is a target.",
    "properties": {
     "allow_comments": {
      "type": "boolean"
     },
     "allow_duet": {
      "type": "boolean"
     },
     "allow_stitch": {
      "type": "boolean"
     },
     "content_disclosure": {
      "description": "The \"promote yourself or a third party\" disclosure. When true, set promote_self and/or promote_third_party.",
      "type": "boolean"
     },
     "privacy_level": {
      "description": "Must be one of the creator's options from GET /posts/capabilities.",
      "enum": [
       "PUBLIC_TO_EVERYONE",
       "MUTUAL_FOLLOW_FRIENDS",
       "FOLLOWER_OF_CREATOR",
       "SELF_ONLY"
      ],
      "type": "string"
     },
     "promote_self": {
      "type": "boolean"
     },
     "promote_third_party": {
      "type": "boolean"
     },
     "title": {
      "description": "Defaults to the first 150 characters of the caption.",
      "maxLength": 150,
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_post"
}

  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Portfolio Insights"
 },
 "description": "Retrieve StockLens analysis summaries for the authenticated user's watchlist. Returns available composite scores and grades for watchlisted stocks; either value may be absent when no completed score exists. Returns the full watchlist up to the capacity of the person's current plan; tier_limited says whether it was cut short. Use this to give users an overview of their portfolio's analytical health. Does NOT accept a ticker or filter arguments and does NOT rank or screen stocks outside the user's own watchlist; call discover_stocks for a market-wide ranked or filtered list.",
 "inputSchema": {
  "additionalProperties": false,
  "type": "object"
 },
 "name": "get_portfolio_insights",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "aggregate_signal": {
    "type": [
     "null",
     "string"
    ]
   },
   "scope": {
    "enum": [
     "user_watchlist"
    ],
    "type": "string"
   },
   "tier_limited": {
    "type": "boolean"
   },
   "total_holdings": {
    "type": "integer"
   },
   "watchlist": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "analysis_date": {
       "type": [
        "null",
        "string"
       ]
      },
      "company_name": {
       "type": "string"
      },
      "composite_grade": {
       "type": [
        "null",
        "string"
       ]
      },
      "composite_score": {
       "type": [
        "null",
        "number"
       ]
      },
      "exchange": {
       "type": "string"
      },
      "ticker": {
       "type": "string"
      }
     },
     "required": [
      "ticker",
      "company_name",
      "exchange"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   }
  },
  "required": [
   "watchlist",
   "total_holdings",
   "tier_limited",
   "scope"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Pattern Library & Learnings Engine \u2014 capture and retrieve patterns across pipelines.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Learning category to filter by",
    "type": "string"
   },
   "market_name": {
    "description": "Pipeline name for context",
    "type": "string"
   },
   "mode": {
    "description": "capture: save a new learning | retrieve: search existing learnings",
    "enum": [
     "capture",
     "retrieve"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tags to search for",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "lessons"
}

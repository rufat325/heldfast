{
 "description": "Send a multi-turn conversation to a NVIDIA NIM language model and receive a completion. Supports all major open-source LLMs including Llama 3.1, Mistral, Gemma, Qwen, and more.",
 "inputSchema": {
  "properties": {
   "max_tokens": {
    "maximum": 131072,
    "minimum": 1,
    "type": "integer"
   },
   "messages": {
    "items": {
     "properties": {
      "content": {
       "type": "string"
      },
      "role": {
       "enum": [
        "system",
        "user",
        "assistant"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "model": {
    "description": "NIM model ID (optional, uses default if not set)",
    "type": "string"
   },
   "seed": {
    "type": "integer"
   },
   "stop": {
    "oneOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ]
   },
   "system_prompt": {
    "description": "System prompt to prepend",
    "type": "string"
   },
   "temperature": {
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "top_p": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 },
 "name": "chat_completion"
}

{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs Stylelint and returns structured diagnostics (file, line, column, rule, severity, message).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowEmptyInput": {
    "description": "Prevent errors when no files match the pattern (maps to --allow-empty-input)",
    "type": "boolean"
   },
   "cache": {
    "description": "Cache lint results for faster subsequent runs (maps to --cache)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "config": {
    "description": "Path to Stylelint configuration file (maps to --config)",
    "maxLength": 4096,
    "type": "string"
   },
   "fix": {
    "default": false,
    "description": "Auto-fix problems",
    "type": "boolean"
   },
   "ignoreDisables": {
    "description": "Ignore stylelint-disable comments and enforce all rules (maps to --ignore-disables)",
    "type": "boolean"
   },
   "ignorePath": {
    "description": "Path to a custom ignore file (maps to --ignore-path)",
    "maxLength": 4096,
    "type": "string"
   },
   "maxWarnings": {
    "description": "Maximum number of warnings before failing (maps to --max-warnings)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "."
    ],
    "description": "File patterns to lint (default: ['.'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "quiet": {
    "description": "Report errors only, suppress warnings (maps to --quiet)",
    "type": "boolean"
   },
   "reportNeedlessDisables": {
    "description": "Report unnecessary stylelint-disable comments (maps to --report-needless-disables)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "stylelint",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deprecationCount": {
    "type": "number"
   },
   "deprecations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reference": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "severity",
      "rule",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnosticsTruncated": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "errors": {
    "type": "number"
   },
   "exitCode": {
    "type": "number"
   },
   "filesChecked": {
    "type": "number"
   },
   "fixableErrorCount": {
    "type": "number"
   },
   "fixableWarningCount": {
    "type": "number"
   },
   "omittedCount": {
    "type": "number"
   },
   "warnings": {
    "type": "number"
   }
  },
  "required": [
   "errors",
   "warnings",
   "filesChecked"
  ],
  "type": "object"
 },
 "title": "Stylelint Check"
}

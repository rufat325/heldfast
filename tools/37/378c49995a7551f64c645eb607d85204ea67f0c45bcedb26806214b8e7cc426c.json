{
 "description": "Calculate quarterly estimated tax payments (Form 1040-ES). SE tax + income tax divided by 4. Latest CDN data.",
 "inputSchema": {
  "properties": {
   "annualIncome": {
    "description": "Estimated annual net income",
    "type": "number"
   },
   "businessExpenses": {
    "description": "Estimated expenses",
    "type": "number"
   },
   "filingStatus": {
    "default": "single",
    "description": "Tax filing status",
    "enum": [
     "single",
     "married",
     "head"
    ],
    "type": "string"
   },
   "state": {
    "default": "",
    "description": "US state abbreviation (e.g. CA, NY, TX)",
    "type": "string"
   }
  },
  "required": [
   "annualIncome"
  ],
  "type": "object"
 },
 "name": "calculate_quarterly_tax"
}

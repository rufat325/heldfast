{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Runs go mod tidy to add missing and remove unused module dependencies.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "compat": {
    "description": "Preserve backward compatibility with the specified Go version (-compat=<version>). Example: '1.20'",
    "maxLength": 255,
    "type": "string"
   },
   "continueOnError": {
    "default": false,
    "description": "Attempt to proceed despite errors encountered while loading packages (-e)",
    "type": "boolean"
   },
   "diff": {
    "default": false,
    "description": "Non-destructive check mode: show what changes would be made without modifying files (-diff)",
    "type": "boolean"
   },
   "goVersion": {
    "description": "Set the expected Go language version (-go=<version>). Example: '1.21'",
    "maxLength": 255,
    "type": "string"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "verbose": {
    "default": false,
    "description": "Print information about removed modules (-v)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "mod-tidy",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "addedModuleCount": {
    "type": "number"
   },
   "addedModules": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "errorType": {
    "enum": [
     "network",
     "checksum",
     "syntax",
     "unknown"
    ],
    "type": "string"
   },
   "madeChanges": {
    "type": "boolean"
   },
   "removedModuleCount": {
    "type": "number"
   },
   "removedModules": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Go Mod Tidy"
}

{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Browse recent listings"
 },
 "description": "What's new on Cyclesite right now \u2014 up to 10 of the freshest active UK listings, refreshed every 15 minutes. Use when the user asks 'what's new today?' or 'any new road bikes this week?' rather than for a specific filter. Optional category + maxPrice filters. Live data.",
 "inputSchema": {
  "properties": {
   "category": {
    "enum": [
     "road",
     "mtb",
     "gravel",
     "hybrid",
     "ebike",
     "kids",
     "bmx",
     "folding",
     "city",
     "touring",
     "triathlon",
     "track",
     "cyclocross",
     "cargo",
     "adaptive",
     "other"
    ],
    "type": "string"
   },
   "limit": {
    "description": "How many listings to return (1-10, default 10).",
    "type": "number"
   },
   "maxPrice": {
    "description": "Maximum price in GBP.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "get_recent_listings",
 "outputSchema": {
  "properties": {
   "attribution": {
    "description": "Citation string \u2014 include verbatim when surfacing data.",
    "type": "string"
   },
   "listings": {
    "items": {
     "properties": {
      "brand": {
       "type": [
        "string",
        "null"
       ]
      },
      "city": {
       "type": [
        "string",
        "null"
       ]
      },
      "condition": {
       "type": "string"
      },
      "delivery": {
       "type": [
        "string",
        "null"
       ]
      },
      "distanceMiles": {
       "type": [
        "number",
        "null"
       ]
      },
      "ebikeBatteryWh": {
       "type": [
        "number",
        "null"
       ]
      },
      "ebikeMotor": {
       "type": [
        "string",
        "null"
       ]
      },
      "frameMaterial": {
       "type": [
        "string",
        "null"
       ]
      },
      "frameSize": {
       "type": [
        "string",
        "null"
       ]
      },
      "groupset": {
       "type": [
        "string",
        "null"
       ]
      },
      "imageUrl": {
       "format": "uri",
       "type": [
        "string",
        "null"
       ]
      },
      "isEbike": {
       "type": "boolean"
      },
      "listingId": {
       "type": [
        "string",
        "null"
       ]
      },
      "model": {
       "type": [
        "string",
        "null"
       ]
      },
      "negotiable": {
       "type": "boolean"
      },
      "offer": {
       "description": "UCP/ACP-shaped commerce signal for this listing.",
       "properties": {
        "availability": {
         "type": "string"
        },
        "itemCondition": {
         "type": "string"
        },
        "price": {
         "type": "number"
        },
        "priceCurrency": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "priceGbp": {
       "description": "Price in GBP.",
       "type": "number"
      },
      "slug": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": [
        "string",
        "null"
       ]
      },
      "wheelSize": {
       "type": [
        "string",
        "null"
       ]
      },
      "year": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "resultsCount": {
    "type": "number"
   }
  },
  "required": [
   "attribution",
   "resultsCount",
   "listings"
  ],
  "type": "object"
 }
}

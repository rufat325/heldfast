{
 "description": "Quick view: next N events from now. Default: 5 events. Fast overview of what is coming up.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calendarId": {
    "description": "Calendar ID (default: primary)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "count": {
    "description": "Number of events (default: 5)",
    "maximum": 25,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "calendar_upcoming"
}

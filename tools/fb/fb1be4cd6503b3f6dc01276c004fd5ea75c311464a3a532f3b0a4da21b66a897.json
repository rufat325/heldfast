{
 "description": "Get top-level comments for a Reddit post. Paginate with next_cursor. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Cursor from data.next_cursor.",
    "type": "string"
   },
   "post_id": {
    "description": "Post fullname, e.g. 't3_1v6ngaf'.",
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "default": "TOP",
    "description": "Sort order.",
    "enum": [
     "HOT",
     "NEW",
     "TOP",
     "BEST",
     "CONTROVERSIAL"
    ],
    "type": "string"
   }
  },
  "required": [
   "post_id"
  ],
  "type": "object"
 },
 "name": "get_reddit_post_comments"
}

{
 "description": "Compare models side by side for a fixed token shape, cheapest first, with the multiple of the cheapest. Offline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "inputTokens": {
    "description": "Input tokens for the comparison.",
    "minimum": 0,
    "type": "integer"
   },
   "models": {
    "description": "Models to compare (alias or id).",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "outputTokens": {
    "description": "Output tokens for the comparison.",
    "minimum": 0,
    "type": "integer"
   },
   "providers": {
    "description": "Axis 1: provider availability allowlist (spec 5.4).",
    "items": {
     "enum": [
      "anthropic",
      "gemini",
      "openai",
      "local"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "target": {
    "description": "Axis 2: \"self\" (default) applies the client scope; \"code\" considers all providers.",
    "enum": [
     "self",
     "code"
    ],
    "type": "string"
   }
  },
  "required": [
   "models",
   "inputTokens",
   "outputTokens"
  ],
  "type": "object"
 },
 "name": "compare_models",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "type": "string"
   },
   "catalogVersion": {
    "type": "string"
   },
   "cheaperIfAvailable": {
    "additionalProperties": false,
    "properties": {
     "cost": {
      "additionalProperties": false,
      "properties": {
       "usd": {
        "type": "number"
       },
       "usdMicros": {
        "type": "number"
       }
      },
      "required": [
       "usd",
       "usdMicros"
      ],
      "type": "object"
     },
     "model": {
      "type": "string"
     },
     "provider": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "model",
     "provider",
     "cost",
     "reason"
    ],
    "type": "object"
   },
   "cheapest": {
    "anyOf": [
     {
      "$ref": "#/properties/rows/items"
     },
     {
      "type": "null"
     }
    ]
   },
   "mostCapable": {
    "anyOf": [
     {
      "$ref": "#/properties/rows/items"
     },
     {
      "type": "null"
     }
    ]
   },
   "providerScope": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "capabilities": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cost": {
       "additionalProperties": false,
       "properties": {
        "usd": {
         "type": "number"
        },
        "usdMicros": {
         "type": "number"
        }
       },
       "required": [
        "usd",
        "usdMicros"
       ],
       "type": "object"
      },
      "model": {
       "type": "string"
      },
      "provider": {
       "type": "string"
      },
      "relativeToCheapest": {
       "type": "string"
      },
      "tier": {
       "type": "string"
      }
     },
     "required": [
      "model",
      "provider",
      "tier",
      "capabilities",
      "cost",
      "relativeToCheapest"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scopeSource": {
    "type": "string"
   },
   "unknownModels": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "rows",
   "cheapest",
   "mostCapable",
   "unknownModels",
   "providerScope",
   "scopeSource",
   "catalogVersion",
   "asOf"
  ],
  "type": "object"
 },
 "title": "Compare models"
}

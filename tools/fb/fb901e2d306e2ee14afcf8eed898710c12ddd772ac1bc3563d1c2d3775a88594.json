 "description": "Europe PMC literature database \u2014 the reference list of one biomedical article, identified by source (MED, PMC, PPR) plus its id. Returns each cited work's title, authors, journal, publication year and its own Europe PMC / PubMed identifiers, with the total count and a pageSize control. Answers what prior work a paper cites.",
 "inputSchema": {
  "examples": [
   {
    "id": "32123456",
    "source": "MED"
   },
   {
    "id": "PMC7654321",
    "pageSize": 100,
    "source": "PMC"
   }
  ],
  "properties": {
   "id": {
    "type": "string"
   },
   "pageSize": {
    "description": "1-1000 (default 25)",
    "type": "number"
   },
   "source": {
    "type": "string"
   }
  },
  "required": [
   "source",
   "id"
  ],
  "type": "object"
 },
 "name": "references",

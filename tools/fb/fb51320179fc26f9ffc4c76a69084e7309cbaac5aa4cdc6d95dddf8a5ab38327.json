{
 "description": "Export output/walkthrough/ from the final video: index.html (one card per scene \u2014 payoff frame, title, narration, jump-to-time; \u2190 \u2192 keyboard nav), guide.md (README/SOP-ready), per-scene PNGs, SRT/VTT and a JSON manifest. Needs only the rendered video + report.json (no key, no browser). Returns a jobId immediately \u2014 poll job_status. Rejects if another job is running.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dir": {
    "description": "demo project directory \u2014 pass an absolute path",
    "type": "string"
   },
   "lang": {
    "description": "language variant (final-demo.<lang>.mp4)",
    "type": "string"
   },
   "out": {
    "description": "output directory (default <dir>/output/walkthrough)",
    "type": "string"
   },
   "width": {
    "description": "frame width in px (default 960)",
    "type": "number"
   }
  },
  "required": [
   "dir"
  ],
  "type": "object"
 },
 "name": "walkthrough",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "demoDir": {
    "description": "resolved absolute demo directory",
    "type": "string"
   },
   "jobId": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "logFile": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "kind",
   "demoDir",
   "status",
   "logFile"
  ],
  "type": "object"
 }
}

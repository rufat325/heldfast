    "type": "string"
   },
   "copyright": {
    "description": "Copyright text",
    "type": "string"
   },
   "downloadable": {
    "description": "Whether the version is downloadable",
    "type": "boolean"
   },
   "releaseType": {
    "description": "How to release after approval",
    "enum": [
     "MANUAL",
     "AFTER_APPROVAL",
     "SCHEDULED"
    ],
    "type": "string"
   },
   "versionString": {
    "description": "Version string (e.g. 1.2.0)",
    "type": "string"
   }
  },
  "required": [
   "appStoreVersionId"
  ],
  "type": "object"
 },
 "name": "update-app-store-version",

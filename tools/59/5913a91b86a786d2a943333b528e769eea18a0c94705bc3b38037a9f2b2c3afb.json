{
 "description": "Google Shopping product detail and sellers. Pass catalog_id+query for full data. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "catalog_id": {
    "description": "Product catalog id.",
    "type": "string"
   },
   "device": {
    "description": "Device.",
    "enum": [
     "desktop",
     "mobile",
     "tablet"
    ],
    "type": "string"
   },
   "gl": {
    "description": "Country, e.g. 'us'.",
    "type": "string"
   },
   "google_domain": {
    "description": "e.g. 'google.co.uk'.",
    "type": "string"
   },
   "hl": {
    "description": "Language, e.g. 'en'.",
    "type": "string"
   },
   "immersive_product_page_token": {
    "description": "Product page token.",
    "type": "string"
   },
   "load_all_stores": {
    "description": "Load all stores.",
    "type": "boolean"
   },
   "location": {
    "description": "Location name, auto-encoded to UULE.",
    "type": "string"
   },
   "more_stores": {
    "description": "Fetch more stores.",
    "type": "boolean"
   },
   "page_token": {
    "description": "Alias for immersive_product_page_token.",
    "type": "string"
   },
   "product_id": {
    "description": "Product id.",
    "type": "string"
   },
   "query": {
    "description": "Required with catalog_id.",
    "type": "string"
   },
   "sort_by": {
    "description": "Seller sort.",
    "enum": [
     "base_price",
     "total_price",
     "promotion",
     "seller_rating"
    ],
    "type": "string"
   },
   "uule": {
    "description": "UULE string, overrides location.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "google_shopping_product"
}

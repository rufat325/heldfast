{
 "description": "Ejecuta un request y valida la respuesta con assertions. Retorna resultado pass/fail por cada assertion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assertions": {
    "description": "Lista de assertions a validar contra la respuesta",
    "items": {
     "additionalProperties": false,
     "properties": {
      "expected": {
       "description": "Valor esperado (no necesario para \"exists\")"
      },
      "operator": {
       "description": "Operador: eq (igual), neq (no igual), gt/gte/lt/lte (num\u00e9ricos), contains/not_contains (strings/arrays), exists (campo existe), type (typeof)",
       "enum": [
        "eq",
        "neq",
        "gt",
        "gte",
        "lt",
        "lte",
        "contains",
        "not_contains",
        "exists",
        "type"
       ],
       "type": "string"
      },
      "path": {
       "description": "JSONPath al valor a validar: \"status\", \"body.data.id\", \"headers.content-type\", \"timing.total_ms\"",
       "type": "string"
      }
     },
     "required": [
      "path",
      "operator"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "auth": {
    "additionalProperties": false,
    "description": "Autenticaci\u00f3n",
    "properties": {
     "header": {
      "description": "Header name para API key (default: X-API-Key)",
      "type": "string"
     },
     "key": {
      "description": "API key value",
      "type": "string"
     },
     "password": {
      "description": "Password para Basic auth",
      "type": "string"
     },
     "token": {
      "description": "Token para Bearer auth",
      "type": "string"
     },
     "type": {
      "description": "Tipo de autenticaci\u00f3n",
      "enum": [
       "bearer",
       "api-key",
       "basic"
      ],
      "type": "string"
     },
     "username": {
      "description": "Username para Basic auth",
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "body": {
    "description": "Body del request (JSON)"
   },
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Headers HTTP",
    "type": "object"
   },
   "method": {
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "PATCH",
     "DELETE",
     "HEAD",
     "OPTIONS"
    ],
    "type": "string"
   },
   "query": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Query parameters",
    "type": "object"
   },
   "url": {
    "description": "URL del endpoint (soporta /relativa y {{variables}})",
    "type": "string"
   }
  },
  "required": [
   "method",
   "url",
   "assertions"
  ],
  "type": "object"
 },
 "name": "assert"
}

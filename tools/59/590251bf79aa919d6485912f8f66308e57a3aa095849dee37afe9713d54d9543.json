{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Record or update a spatial relationship between two entities (e.g. on, inside, next_to, above, below, near, contains, occluded_by, connected_to, facing, holding, part_of).",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform (default: add)",
    "type": "string"
   },
   "bidirectional": {
    "description": "If true, automatically sets inverse relationship on target",
    "type": "boolean"
   },
   "distance": {
    "description": "Optional measured distance between entities",
    "type": "number"
   },
   "metadata": {
    "description": "Additional relation metadata",
    "type": "object"
   },
   "offset": {
    "description": "Relative offset vector from source to target",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   },
   "relation": {
    "description": "Type of spatial relation",
    "enum": [
     "on",
     "inside",
     "next_to",
     "above",
     "below",
     "near",
     "contains",
     "occluded_by",
     "connected_to",
     "facing",
     "holding",
     "part_of",
     "custom"
    ],
    "type": "string"
   },
   "source_id": {
    "description": "Source entity ID",
    "type": "string"
   },
   "target_id": {
    "description": "Target entity ID",
    "type": "string"
   }
  },
  "required": [
   "source_id",
   "relation",
   "target_id"
  ],
  "type": "object"
 },
 "name": "set_relation"
}

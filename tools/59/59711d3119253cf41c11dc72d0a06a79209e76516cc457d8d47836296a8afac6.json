{
 "description": "Create a Z Image task on RunAPI (text to image). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "enum": [
     "1:1",
     "4:3",
     "3:4",
     "16:9",
     "9:16"
    ],
    "type": "string"
   },
   "callback_url": {
    "type": "string"
   },
   "enable_safety_checker": {
    "type": "boolean"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "z-image"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "prompt",
   "aspect_ratio"
  ],
  "type": "object"
 },
 "name": "text_to_image"
}

{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Replace a brand's active prompts with an exact supplied set; history is preserved. Example: brand_id='acme', prompts=['What is the best X for Y?'].",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brand_id": {
    "description": "Tracked brand ID to update.",
    "type": "string"
   },
   "prompts": {
    "description": "Exact 1-50 prompt set for future scans.",
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "brand_id",
   "prompts"
  ],
  "type": "object"
 },
 "name": "set_prompts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brand_id": {
    "type": "string"
   },
   "changed": {
    "type": "boolean"
   },
   "next_steps": {
    "type": "string"
   },
   "prompts": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "prompts_inserted": {
    "type": "number"
   }
  },
  "required": [
   "brand_id",
   "prompts_inserted",
   "prompts",
   "changed",
   "next_steps"
  ],
  "type": "object"
 },
 "title": "Set active prompts"
}

{
 "description": "Ask the running Granoflow app to preview an AI-agent memory batch before any write. Granoflow owns project/milestone matching and duplicate signals; this MCP tool only forwards after capability checks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": false,
    "description": "When true, previews the HTTP request without calling the app.",
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "clientItemId": {
       "minLength": 1,
       "type": "string"
      },
      "completedAt": {
       "minLength": 1,
       "type": "string"
      },
      "kind": {
       "default": "task_completion",
       "enum": [
        "task_completion",
        "task_review",
        "review_card_candidate"
       ],
       "type": "string"
      },
      "reviewCardCandidates": {
       "items": {
        "additionalProperties": {},
        "type": "object"
       },
       "type": "array"
      },
      "summary": {
       "minLength": 1,
       "type": "string"
      },
      "title": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "source": {
    "additionalProperties": {},
    "type": "object"
   },
   "target": {
    "additionalProperties": false,
    "properties": {
     "milestoneId": {
      "minLength": 1,
      "type": "string"
     },
     "projectId": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "granoflow_memory_batch_preview"
}

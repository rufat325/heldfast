 },
 "description": "Update timing, trim, layer, or state for up to 100 timeline items in one sequence transaction.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "expectedRevision": {
    "description": "Expected sequence revision, or null.",
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "updates": {
    "description": "Each update needs at least one field to change besides timelineItemId.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "blurredBackground": {
       "type": "boolean"
      },
      "durationSeconds": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "ignored": {
       "type": "boolean"
      },
      "layerIndex": {
       "minimum": 0,
       "type": "integer"
      },
      "startSeconds": {
       "minimum": 0,
       "type": "number"
      },
      "timelineItemId": {
       "format": "uuid",
       "type": "string"
      },
      "trimEndSeconds": {
       "minimum": 0,
       "type": "number"
      },
      "trimStartSeconds": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "timelineItemId"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "updates",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "batch_update_timeline_clips",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "affectedTimelineItemIds": {
    "items": {

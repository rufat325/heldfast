     },
     "status": {
      "enum": [
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "key",
     "operation",
     "status",
     "replayed"
    ],
    "type": "object"
   },
   "operationId": {
    "type": "string"
   },

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search USAJOBS announcements. Returns title, agency, location, salary band, posting/closing dates.",
 "inputSchema": {
  "examples": [
   {
    "keyword": "software engineer",
    "location": "Washington, DC",
    "results_per_page": 25
   },
   {
    "organization": "VATA",
    "pay_grade_high": "GS12",
    "pay_grade_low": "GS9",
    "position_title": "Data Analyst",
    "remote": true
   }
  ],
  "properties": {
   "keyword": {
    "description": "Free-text \u2014 title + description + agency name",
    "type": "string"
   },
   "location": {
    "description": "City/state (e.g. \"San Francisco, CA\")",
    "type": "string"
   },
   "organization": {
    "description": "Agency code or name (e.g. \"VATA\" or \"Veterans\")",
    "type": "string"
   },
   "page": {
    "description": "1-based page",
    "type": "number"
   },
   "pay_grade_high": {
    "type": "string"
   },
   "pay_grade_low": {
    "description": "\"GS5\", \"GS9\", \"SES\", ...",
    "type": "string"
   },
   "position_title": {
    "description": "Restrict to job title field",
    "type": "string"
   },
   "remote": {
    "description": "Telework/remote only",
    "type": "boolean"
   },
   "results_per_page": {
    "description": "1-500 (default 25)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "description": "Search results from USAJOBS API",
  "properties": {
   "JobData": {
    "description": "Array of job posting objects",
    "items": {
     "description": "Individual job posting",
     "properties": {
      "MatchedObjectDescriptor": {
       "description": "Job posting details",
       "properties": {
        "AnnouncementNumber": {
         "description": "USAJOBS announcement number",
         "type": "string"
        },
        "ApplicationCloseDate": {
         "description": "ISO date when applications close",
         "type": "string"
        },
        "JobGrade": {
         "description": "Pay grade codes",
         "items": {
          "properties": {
           "Code": {
            "description": "Pay grade code",
            "type": "string"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "LocationName": {
         "description": "Work locations",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "OrganizationName": {
         "description": "Federal agency name",
         "type": "string"
        },
        "PositionScheduleTypeCode": {
         "description": "Work schedule type",
         "type": "string"
        },
        "PositionTitle": {
         "description": "Job title",
         "type": "string"
        },
        "PublicationStartDate": {
         "description": "ISO date when posting opened",
         "type": "string"
        },
        "SalaryBasis": {
         "description": "Salary basis code (e.g. PA for per annum)",
         "type": "string"
        },
        "SalaryRangeFrom": {
         "description": "Minimum annual salary",
         "type": "number"
        },
        "SalaryRangeTo": {
         "description": "Maximum annual salary",
         "type": "number"
        },
        "TeleworkIndicator": {
         "description": "Whether telework is available",
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "id": {
       "description": "Unique job posting ID",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "SearchResult": {
    "description": "Search result metadata and job postings",
    "properties": {
     "PageNumber": {
      "description": "Current page number",
      "type": "integer"
     },
     "SearchResultCount": {
      "description": "Total number of matching results",
      "type": "integer"
     },
     "SearchResultCountAll": {
      "description": "Total count across all pages",
      "type": "integer"
     },
     "UserArea": {
      "description": "User-specific search result details",
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Search",
 "version": "v1.c4f32cf5"
}

{
 "description": "Get one agent's current effective health status and monitoring detail \u2014 derived from heartbeat freshness for push-mode agents, or the latest pull check otherwise.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "slug": {
    "description": "The agent's URL slug (from its public profile or a list_agents result).",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_agent_health",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "type": "string"
   },
   "checkStatus": {
    "type": [
     "string",
     "null"
    ]
   },
   "httpStatus": {
    "type": [
     "number",
     "null"
    ]
   },
   "lastCheckedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "latencyMs": {
    "type": [
     "number",
     "null"
    ]
   },
   "reliabilityScore": {
    "type": [
     "number",
     "null"
    ]
   },
   "reliabilityScoreComputedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "reliabilityScoreStatus": {
    "enum": [
     "none",
     "fresh",
     "stale"
    ],
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "status": {
    "enum": [
     "unknown",
     "healthy",
     "degraded",
     "down"
    ],
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "slug",
   "status",
   "lastCheckedAt",
   "latencyMs",
   "httpStatus",
   "checkStatus",
   "reliabilityScore",
   "reliabilityScoreStatus",
   "reliabilityScoreComputedAt"
  ],
  "type": "object"
 },
 "title": "Get Agent Health"
}

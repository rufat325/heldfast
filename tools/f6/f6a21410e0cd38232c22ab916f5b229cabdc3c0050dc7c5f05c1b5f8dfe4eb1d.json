{
 "description": "Update an alert rule, including optional severity-threshold lifecycle scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "alertId": {
    "type": "string"
   },
   "bearerToken": {
    "type": "string"
   },
   "channel": {
    "type": "string"
   },
   "conditionType": {
    "type": "string"
   },
   "config": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "cooldownSeconds": {
    "maximum": 604800,
    "minimum": 0,
    "type": "integer"
   },
   "isEnabled": {
    "type": "boolean"
   },
   "projectId": {
    "type": "string"
   },
   "serviceId": {
    "type": [
     "string",
     "null"
    ]
   },
   "severityLifecycleScope": {
    "anyOf": [
     {
      "enum": [
       "new_incident",
       "incident_regressed",
       "both"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "severityMin": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "alertId"
  ],
  "type": "object"
 },
 "name": "update_alert"
}

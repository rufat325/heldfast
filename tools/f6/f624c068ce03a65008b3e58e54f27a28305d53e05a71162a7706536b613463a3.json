   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://mcp.coworkingview.com/icons/operator-light.svg",
   "theme": "light"
  },
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://mcp.coworkingview.com/icons/operator-dark.svg",
   "theme": "dark"
  }
 ],

  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "YNAB: Get Category Details"
 },
 "description": "Get current month details for a specific budget category.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - category_id (string, optional): Category UUID.\n  - response_format (string, optional): \"json\" or \"markdown\" (default: \"markdown\").\n\nReturns: category (id, name, budgeted, activity, balance, goal_type, goal_target, goal_percentage_complete), cached, cache_info\n\nErrors:\n  - \"No default budget set\" \u2192 run ynab_set_default_budget first\n  - \"Category not found\" \u2192 invalid category_id",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "category_id": {
    "minLength": 1,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   }
  },
  "required": [
   "category_id"
  ],
  "type": "object"
 },
 "name": "ynab_get_category",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cache_info": {
    "description": "Human-readable cache status message (e.g., \"Cache hit\", \"Cache miss\")",
    "type": "string"
   },
   "cached": {
    "description": "Indicates if data was served from cache",
    "type": "boolean"
   },
   "category": {
    "additionalProperties": false,
    "description": "Category details",
    "properties": {
     "activity": {
      "description": "Activity in dollars",
      "type": "number"
     },
     "balance": {
      "description": "Balance in dollars",
      "type": "number"
     },
     "budgeted": {
      "description": "Budgeted amount in dollars",
      "type": "number"
     },
     "category_group_id": {
      "description": "Category group ID",
      "type": "string"
     },
     "category_group_name": {
      "description": "Category group name",
      "type": "string"
     },
     "deleted": {
      "description": "Deleted flag",
      "type": "boolean"
     },
     "goal_creation_month": {
      "description": "Goal creation month",
      "type": "string"
     },
     "goal_months_to_budget": {
      "description": "Goal months to budget",
      "type": "number"
     },
     "goal_overall_funded": {
      "description": "Goal overall funded amount in dollars",
      "type": "number"
     },
     "goal_overall_left": {
      "description": "Goal overall left amount in dollars",
      "type": "number"
     },
     "goal_percentage_complete": {
      "description": "Goal percentage complete",
      "type": "number"
     },
     "goal_target": {
      "description": "Goal target amount in dollars",
      "type": "number"
     },
     "goal_target_month": {
      "description": "Goal target month",
      "type": "string"
     },
     "goal_type": {
      "description": "Goal type",
      "type": "string"
     },
     "goal_under_funded": {
      "description": "Goal underfunded amount in dollars",
      "type": "number"
     },
     "hidden": {
      "description": "Hidden flag",
      "type": "boolean"
     },
     "id": {
      "description": "Category ID",
      "type": "string"
     },
     "name": {
      "description": "Category name",
      "type": "string"
     },
     "note": {
      "description": "Category note",
      "type": "string"
     },
     "original_category_group_id": {
      "description": "Original category group ID",
      "type": "string"
     }
    },
    "required": [

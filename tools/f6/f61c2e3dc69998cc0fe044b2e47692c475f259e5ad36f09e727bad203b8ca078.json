     "category_group_id",
     "name",
     "hidden",
     "budgeted",
     "activity",
     "balance"
    ],
    "type": "object"
   },
   "usedDelta": {
    "description": "Indicates if delta merge optimization was applied for budgets",
    "type": "boolean"
   }

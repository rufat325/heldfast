{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate state income tax using an explicit tax-year calculation profile. Unsupported state-year paths fail closed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filingStatus": {
    "description": "Filing status (default: single)",
    "enum": [
     "single",
     "married"
    ],
    "type": "string"
   },
   "incomeBeforeStateDeductions": {
    "description": "State income before the modeled state standard deduction and personal exemption",
    "minimum": 0,
    "type": "number"
   },
   "stateCode": {
    "description": "Two-letter state code",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "taxYear": {
    "description": "Tax year for the versioned state calculation profile",
    "type": "integer"
   },
   "taxableIncome": {
    "description": "Deprecated alias for incomeBeforeStateDeductions",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "stateCode",
   "taxYear"
  ],
  "type": "object"
 },
 "name": "estimate_state_tax",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "suggestion"
    ],
    "type": "object"
   },
   "isError": {
    "type": "boolean"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "isError"
  ],
  "type": "object"
 }
}

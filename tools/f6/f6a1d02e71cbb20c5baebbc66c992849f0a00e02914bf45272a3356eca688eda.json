{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Resolve a provider name, alias, or slug and retrieve its published review summary, Review Score contributors, original source metrics, qualifications, and full Markdown with citations. Unpublished or unavailable review records return found:false.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "provider": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "provider"
  ],
  "type": "object"
 },
 "name": "get_provider_reviews",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "aggregate": {
    "additionalProperties": false,
    "properties": {
     "contributors": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "conversion": {
         "type": "string"
        },
        "observationId": {
         "type": "string"
        },
        "originalMaximum": {
         "type": [
          "number",
          "null"
         ]
        },
        "originalValue": {
         "type": [
          "number",
          "string"
         ]
        },
        "platform": {
         "type": "string"
        },
        "scope": {
         "type": "string"
        },
        "score": {
         "type": "number"
        },
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "observationId",
        "platform",
        "originalValue",
        "originalMaximum",
        "score",
        "url",
        "scope"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "methodology": {
      "type": "string"
     },
     "score": {
      "type": [
       "number",
       "null"
      ]
     },
     "sourceCount": {
      "type": "number"
     }
    },
    "required": [
     "score",
     "sourceCount",
     "contributors",
     "methodology"
    ],
    "type": "object"
   },
   "found": {
    "type": "boolean"
   },
   "markdown": {
    "type": "string"
   },
   "provider": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "slug"
    ],
    "type": "object"
   },
   "spotCallout": {
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "spotCallout",
   "found"
  ],
  "type": "object"
 },
 "title": "Get published provider reviews"
}

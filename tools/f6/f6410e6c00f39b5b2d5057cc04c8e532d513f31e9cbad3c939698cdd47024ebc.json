{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get one coworking space"
 },
 "description": "Returns everything known about a single coworking space: address, capacity, amenities, rating, how its price compares to the local market, the operator description, and its full pricing options. Takes the `slug` returned by search_coworking_spaces or resolve_coworking_query \u2014 not a display name. Use detail \"full\" only when the user is choosing between specific spaces and needs every pricing option; the default summary is much cheaper and answers most questions. A `resource_link` to the main photo is always included at no extra cost; pass `includePhoto: true` only when the user actually wants to see the space, since that inlines the photo itself and costs significantly more tokens and bandwidth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://mcp.coworkingview.com/icons/space-light.svg",
   "theme": "light"
  },
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://mcp.coworkingview.com/icons/space-dark.svg",
   "theme": "dark"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "detail": {
    "default": "concise",
    "description": "'concise' gives one representative price per workspace type and a short description. 'full' gives every pricing option and the complete description.",
    "enum": [
     "concise",
     "full"
    ],
    "type": "string"
   },
   "includePhoto": {
    "default": false,
    "description": "Fetches and inlines the main photo as image bytes in the response, costing significantly more tokens and bandwidth than the rest of this tool combined. Only set this when the user has actually asked to see the space \u2014 a resource_link to the photo is always returned regardless, at no extra cost, for clients that can render it themselves.",
    "type": "boolean"
   },
   "locale": {
    "default": "en",
    "description": "Language for names and descriptions. Set from the user's language: 'de' for German, 'es' for Spanish, otherwise 'en'.",
    "enum": [
     "en",
     "de",
     "es"
    ],
    "type": "string"
   },
   "slug": {
    "description": "The space's slug, exactly as returned by another tool.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_coworking_space",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "citation": {
    "additionalProperties": false,
    "description": "Attribution for this data under its CC BY 4.0 licence.",
    "properties": {
     "accessed": {
      "description": "ISO date (YYYY-MM-DD) the data was served.",
      "type": "string"
     },
     "license": {
      "const": "CC BY 4.0",
      "type": "string"
     },
     "licenseUrl": {
      "type": "string"
     },
     "source": {
      "const": "CoworkingView",
      "type": "string"
     },
     "text": {
      "description": "One-line attribution with a link to the source page.",
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "title",
     "url",
     "accessed",
     "license",
     "licenseUrl",
     "text"
    ],
    "type": "object"
   },
   "pricingWasSummarised": {
    "type": "boolean"
   },
   "space": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "type": "string"
     },
     "amenities": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "capacity": {
      "type": "number"
     },
     "city": {
      "type": "string"
     },
     "coordinates": {
      "additionalProperties": false,
      "properties": {
       "lat": {
        "type": "number"
       },
       "lng": {
        "type": "number"
       }
      },
      "required": [
       "lat",
       "lng"
      ],
      "type": "object"
     },
     "description": {
      "type": "string"
     },
     "fromPrice": {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "type": "number"
       },
       "currency": {
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency"
      ],
      "type": "object"
     },
     "imageUrl": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "operator": {
      "type": "string"
     },
     "priceVsMarket": {
      "enum": [
       "below",
       "around",
       "above"
      ],
      "type": "string"
     },
     "pricing": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "billingPeriod": {
         "type": "string"
        },
        "maxCapacity": {
         "type": "number"
        },
        "minCapacity": {
         "type": "number"
        },
        "optionType": {
         "type": "string"
        },
        "price": {
         "additionalProperties": false,
         "properties": {
          "amount": {
           "type": "number"
          },
          "currency": {
           "type": "string"
          }
         },
         "required": [
          "amount",
          "currency"
         ],
         "type": "object"
        },
        "priceOnRequest": {
         "type": "boolean"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "optionType",
        "title",
        "priceOnRequest",
        "billingPeriod"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "rating": {
      "additionalProperties": false,
      "properties": {
       "reviews": {
        "type": "number"
       },
       "score": {
        "type": "number"
       }
      },
      "required": [
       "score",
       "reviews"
      ],
      "type": "object"
     },
     "slug": {
      "type": "string"
     },
     "updatedAt": {
      "description": "When the CMS record was last updated. A general freshness signal for the listing, NOT a price-verification date: any edit moves it, including one that never touched a price. Absent for rows with no tracked update time.",
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "zone": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "name",
     "url",
     "amenities",
     "pricing"
    ],
    "type": "object"
   }
  },
  "required": [
   "space",
   "pricingWasSummarised",
   "citation"
  ],
  "type": "object"
 },
 "title": "Get one coworking space"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Evidence Group List"
 },
 "description": "Lists all evidence groups in a case file with their current status (OPEN, CLOSING, CLOSED). Use to find an existing group or check which groups are ready for sealing. Requires: caseFileId.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "caseFileId": {
    "type": "string"
   },
   "filter": {
    "properties": {
     "caseFileId": {
      "type": "string"
     },
     "createdById": {
      "type": "string"
     },
     "createdFrom": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "createdUntil": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "ids": {
      "items": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "status": {
      "enum": [
       "OPEN",
       "CLOSED",
       "CLOSING"
      ],
      "type": "string"
     },
     "type": {
      "enum": [
       "FILE",
       "PHOTO",
       "VIDEO",
       "WEB_PLUGIN"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "order": {
    "properties": {
     "createdAt": {
      "enum": [
       "ASC",
       "DESC"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "page": {
    "properties": {
     "number": {
      "default": 1,
      "minimum": 1,
      "type": "number"
     },
     "size": {
      "default": 20,
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "caseFileId"
  ],
  "type": "object"
 },
 "name": "evidence_group_list"
}

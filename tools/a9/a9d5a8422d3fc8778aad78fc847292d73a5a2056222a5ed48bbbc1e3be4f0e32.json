{
 "description": "Add a content idea to the ASTGL idea journal. Use this when you spot a topic gap, get a question you can't answer well, or think of a blog post idea.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "default": "",
    "description": "Longer description of the idea",
    "type": "string"
   },
   "priority": {
    "default": "medium",
    "description": "Priority level",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "related_queries": {
    "default": [],
    "description": "Related query strings that inspired this idea",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "source": {
    "default": "manual",
    "description": "Where this idea came from",
    "enum": [
     "manual",
     "query-gap",
     "low-confidence",
     "trending",
     "alert"
    ],
    "type": "string"
   },
   "tags": {
    "default": [],
    "description": "Tags for categorization",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Idea title (e.g., 'How to use MCP with VS Code')",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "add_idea"
}

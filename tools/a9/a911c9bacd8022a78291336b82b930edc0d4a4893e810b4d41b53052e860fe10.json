{
 "description": "Partially updates an existing press release you own; only supplied fields change. Setting status to 1 (Active) emails followers, once ever, per article. Requires a paid membership (Bronze/Silver/Gold); returns an error for free accounts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "body": {
    "description": "Full article HTML content.",
    "type": "string"
   },
   "intro": {
    "description": "Short introduction text.",
    "type": "string"
   },
   "meta_description": {
    "description": "SEO meta description.",
    "type": "string"
   },
   "press_release_id": {
    "description": "ID of the article to update (must belong to you).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "slug": {
    "description": "URL slug (must be unique).",
    "type": "string"
   },
   "status": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ],
    "description": "1 = Active (emails followers once ever), 0 = Disabled."
   },
   "title": {
    "description": "Article title.",
    "type": "string"
   },
   "url": {
    "description": "HTTPS source URL.",
    "type": "string"
   }
  },
  "required": [
   "press_release_id"
  ],
  "type": "object"
 },
 "name": "update_press_release",
 "title": "Update a press release"
}

{
 "description": "List abandoned checkouts (carts where the customer entered contact info but did not complete checkout). Useful for recovery campaigns.",
 "inputSchema": {
  "properties": {
   "created_at_max": {
    "description": "ISO-8601 maximum created_at",
    "type": "string"
   },
   "created_at_min": {
    "description": "ISO-8601 minimum created_at",
    "type": "string"
   },
   "limit": {
    "description": "Max results per page (1-250, default 50)",
    "type": "number"
   },
   "since_id": {
    "description": "Return only checkouts with IDs greater than this value",
    "type": "string"
   },
   "status": {
    "description": "Checkout status. Defaults to 'open'.",
    "enum": [
     "open",
     "closed"
    ],
    "type": "string"
   },
   "updated_at_min": {
    "description": "ISO-8601 minimum updated_at",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_abandoned_checkouts"
}

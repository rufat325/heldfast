{
 "description": "Update your user profile fields",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ethnicity": {
    "description": "Ethnicity",
    "type": "string"
   },
   "experience": {
    "description": "Years of experience",
    "type": "number"
   },
   "firstName": {
    "description": "Your first name",
    "type": "string"
   },
   "gender": {
    "description": "Gender",
    "enum": [
     "male",
     "female"
    ],
    "type": "string"
   },
   "headline": {
    "description": "Professional headline (e.g., \"Senior Software Engineer at Google\")",
    "type": "string"
   },
   "immigrationSponsorshipRequired": {
    "description": "Whether you require immigration/visa sponsorship (e.g., H1B)",
    "type": "boolean"
   },
   "lastName": {
    "description": "Your last name",
    "type": "string"
   },
   "location": {
    "description": "Your location (e.g., \"San Francisco, CA\")",
    "type": "string"
   },
   "noticePeriodDays": {
    "description": "Notice period in days (0-180)",
    "type": "number"
   },
   "openToRelocation": {
    "description": "Whether you are open to relocating for a job",
    "type": "boolean"
   },
   "phoneCountryCode": {
    "description": "Phone country dial code with + prefix (e.g., \"+1\" for US, \"+91\" for India)",
    "type": "string"
   },
   "phoneCountryIso": {
    "description": "ISO country code for the phone number (e.g., \"US\", \"IN\")",
    "type": "string"
   },
   "phoneNumber": {
    "description": "Phone number without country code (e.g., \"4084586677\")",
    "type": "string"
   },
   "skills": {
    "description": "List of skills (e.g., [\"Python\", \"JavaScript\", \"AWS\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workPermitLocations": {
    "description": "Countries where you have work authorization, as ISO country codes (e.g., [\"US\", \"CA\", \"GB\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "update_profile"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Query time-series observations for any combination of countries and indicators",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Filter by indicator category",
    "type": "string"
   },
   "country_code": {
    "description": "Single ISO alpha-2 code (e.g. \"NG\")",
    "type": "string"
   },
   "country_codes": {
    "description": "Comma-separated codes (e.g. \"NG,KE,ZA\")",
    "type": "string"
   },
   "end_year": {
    "description": "End of year range",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "latest": {
    "default": false,
    "description": "Only return most recent observation per country+indicator",
    "type": "boolean"
   },
   "limit": {
    "default": 100,
    "description": "Max results",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "metric_key": {
    "description": "Single indicator key (e.g. \"gdp_current_usd\")",
    "type": "string"
   },
   "metric_keys": {
    "description": "Comma-separated indicator keys",
    "type": "string"
   },
   "source": {
    "description": "Filter by source code",
    "type": "string"
   },
   "start_year": {
    "description": "Start of year range",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "year": {
    "description": "Exact year (cannot combine with start_year/end_year)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "query_data"
}

{
 "description": "Notes within N hops of a note over the (undirected) wiki-link graph, depth/limit capped.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "depth": {
    "description": "Hops to traverse (default 1)",
    "exclusiveMinimum": 0,
    "maximum": 5,
    "type": "integer"
   },
   "limit": {
    "description": "Max neighbors (default 50)",
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   },
   "name": {
    "description": "Center note",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_neighbors",
 "title": "Get neighbors"
}

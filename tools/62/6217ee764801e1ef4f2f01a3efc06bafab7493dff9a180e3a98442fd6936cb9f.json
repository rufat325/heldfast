{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Simulate Fiat Payout Quote"
 },
 "description": "Estimate exchange rates, processing fees, amount received, and corridor limits for a bank payout before sending money; use it to compare supported rails such as ACH, SEPA, EFT, FPS, IMPS, or SWIFT.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "network": {
    "description": "Fiat payout rail / bank method",
    "enum": [
     "SWIFT",
     "ACH",
     "SEPA",
     "FPS",
     "EFT",
     "FAST",
     "CHATS",
     "KFTC",
     "ZENGIN",
     "INSTAPAY",
     "PESONET",
     "PROMPTPAY",
     "BECS",
     "IMPS",
     "NEFT",
     "BI-FAST",
     "UAEFTS",
     "SPEI",
     "SPID",
     "PIX"
    ],
    "type": "string"
   },
   "portfolioRef": {
    "description": "Portfolio exact name or slug",
    "type": "string"
   },
   "purposeOfPayment": {
    "description": "Purpose-of-payment classification",
    "enum": [
     "payment_for_goods",
     "payment_for_business_services",
     "payment_for_salary_or_benefits",
     "capital_investment_or_item",
     "other"
    ],
    "type": "string"
   },
   "receivingAmount": {
    "description": "Amount the recipient should receive, as a decimal string in the receiving currency (e.g. \"500000\")",
    "type": "string"
   },
   "receivingCurrency": {
    "description": "ISO 4217 receiving currency; defaults to the network default",
    "type": "string"
   },
   "recipientBankCountry": {
    "description": "ISO 3166-1 alpha-2 recipient bank country; defaults to the network default",
    "type": "string"
   },
   "senderCurrency": {
    "description": "Stablecoin funding the payout (default USDC)",
    "enum": [
     "USDC",
     "USDT",
     "USDe"
    ],
    "type": "string"
   },
   "workspaceRef": {
    "description": "Workspace exact name or slug",
    "type": "string"
   }
  },
  "required": [
   "workspaceRef",
   "portfolioRef",
   "network",
   "receivingAmount"
  ],
  "type": "object"
 },
 "name": "simulate_fiat_quote",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "corridor": {
    "additionalProperties": false,
    "properties": {
     "amountBounds": {
      "additionalProperties": false,
      "properties": {
       "maxAmount": {
        "type": "string"
       },
       "minAmount": {
        "type": "string"
       }
      },
      "required": [
       "minAmount",
       "maxAmount"
      ],
      "type": "object"
     },
     "network": {
      "type": "string"
     },
     "receivingCurrency": {
      "type": "string"
     },
     "recipientBankCountry": {
      "type": "string"
     },
     "senderCurrency": {
      "type": "string"
     }
    },
    "required": [
     "network",
     "receivingCurrency",
     "recipientBankCountry",
     "senderCurrency"
    ],
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "quote": {
    "additionalProperties": false,
    "properties": {
     "exchangeRate": {
      "type": "string"
     },
     "itemizedFees": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": "string"
        },
        "key": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "percentage": {
         "type": "string"
        }
       },
       "required": [
        "key",
        "label",
        "amount"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "processingFee": {
      "type": "string"
     },
     "quoteValiditySeconds": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "receivingCurrency": {
      "type": "string"
     },
     "senderCurrency": {
      "type": "string"
     },
     "summary": {
      "type": "string"
     },
     "totalReceivable": {
      "type": "string"
     }
    },
    "required": [
     "exchangeRate",
     "senderCurrency",
     "receivingCurrency",
     "processingFee",
     "itemizedFees",
     "totalReceivable",
     "quoteValiditySeconds",
     "summary"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "quoted",
     "corridor_unavailable",
     "amount_out_of_range",
     "limit_skipped"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "corridor"
  ],
  "type": "object"
 },
 "title": "Simulate Fiat Payout Quote"
}

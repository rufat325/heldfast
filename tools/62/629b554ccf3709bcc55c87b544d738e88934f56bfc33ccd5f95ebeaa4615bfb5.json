{
 "description": "Safely delete a Granoflow project. Defaults to dry-run and requires confirmTitle for writes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowLinkedTasks": {
    "default": false,
    "type": "boolean"
   },
   "confirmTitle": {
    "minLength": 1,
    "type": "string"
   },
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "projectId": {
    "description": "Granoflow project id.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "granoflow_project_delete"
}

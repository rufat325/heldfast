{
 "description": "Creates a new immutable version of an Account Artifact. Requires the base_version returned by vnsh_artifact_read. On conflict, re-read, merge, and retry; never silently overwrite.",
 "inputSchema": {
  "properties": {
   "artifact_id": {
    "description": "UUID returned by create or list",
    "type": "string"
   },
   "base_version": {
    "description": "Version this edit was based on",
    "minimum": 1,
    "type": "integer"
   },
   "change_summary": {
    "description": "Human-readable description of this change",
    "type": "string"
   },
   "content": {
    "description": "Complete replacement UTF-8 content",
    "type": "string"
   },
   "content_type": {
    "type": "string"
   },
   "evidence": {
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "host": {
    "description": "Override the vnsh host URL",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "artifact_id",
   "content",
   "base_version"
  ],
  "type": "object"
 },
 "name": "vnsh_artifact_update"
}

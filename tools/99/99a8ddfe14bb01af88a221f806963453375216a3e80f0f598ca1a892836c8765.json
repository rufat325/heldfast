{
 "description": "List timeline activities (audit trail of everything that happened: notes, emails, stage moves...). The Lawmatics API REQUIRES a filter here \u2014 pass filter_by ('matter_id' or 'contact_id') and filter_on.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fetch_all": {
    "description": "Follow pagination (capped at 1,000 records).",
    "type": "boolean"
   },
   "filter_by": {
    "description": "Required by the API.",
    "enum": [
     "matter_id",
     "contact_id"
    ],
    "type": "string"
   },
   "filter_on": {
    "description": "The matter or contact ID.",
    "type": "string"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "filter_by",
   "filter_on"
  ],
  "type": "object"
 },
 "name": "list-activities"
}

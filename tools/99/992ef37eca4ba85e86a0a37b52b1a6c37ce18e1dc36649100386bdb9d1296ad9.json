{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Analyze Dialogue Edit Candidates"
 },
 "description": "Analyze caller-supplied, revision-bound transcript segments and optional local silence ranges for deterministic dialogue-edit candidates. It never calls a model, persists transcript text, or changes Premiere.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filler_words": {
    "description": "Exact normalized filler words or phrases to flag for review.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 64,
    "type": "array"
   },
   "minimum_silence_seconds": {
    "description": "Minimum silence duration to return; defaults to 0.7 seconds.",
    "maximum": 30,
    "minimum": 0.1,
    "type": "number"
   },
   "segments": {
    "description": "Normalized transcript segments with stable IDs, source IDs, transcript revisions, time ranges, text, and optional speaker labels.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "end_seconds": {
       "description": "Source-time segment end.",
       "exclusiveMinimum": 0,
       "maximum": 86400,
       "type": "number"
      },
      "id": {
       "description": "Caller-stable segment ID.",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "source_project_item_id": {
       "description": "Exact Premiere source project-item ID.",
       "maxLength": 512,
       "minLength": 1,
       "type": "string"
      },
      "speaker_label": {
       "description": "Optional caller-normalized speaker label.",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "start_seconds": {
       "description": "Source-time segment start.",
       "maximum": 86400,
       "minimum": 0,
       "type": "number"
      },
      "text": {
       "description": "Local transcript text for this segment.",
       "maxLength": 1000,
       "type": "string"
      },
      "transcript_revision": {
       "description": "Revision returned by get_clip_transcript_uxp.",
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "id",
      "source_project_item_id",
      "transcript_revision",
      "start_seconds",
      "end_seconds",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 10000,
    "minItems": 1,
    "type": "array"
   },
   "silence_ranges": {
    "description": "Optional source-time silence ranges returned by local analysis.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "end_seconds": {
       "description": "Silence end in source seconds.",
       "exclusiveMinimum": 0,
       "maximum": 86400,
       "type": "number"
      },
      "source_project_item_id": {
       "description": "Exact Premiere source project-item ID.",
       "maxLength": 512,
       "minLength": 1,
       "type": "string"
      },
      "start_seconds": {
       "description": "Silence start in source seconds.",
       "maximum": 86400,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "source_project_item_id",
      "start_seconds",
      "end_seconds"
     ],
     "type": "object"
    },
    "maxItems": 2000,
    "type": "array"
   }
  },
  "required": [
   "segments"
  ],
  "type": "object"
 },
 "name": "analyze_dialogue_edit_candidates",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Analyze Dialogue Edit Candidates"
}

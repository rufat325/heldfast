 "description": "caniuse browser-compatibility database (the dataset behind caniuse.com) \u2014 find web platform feature ids by matching a keyword against feature id, title, keywords and description. Returns each match's caniuse feature id, human-readable title and standards status; feed the id to feature or support. Answers what the caniuse id is for CSS grid, container queries, or WebP.",
 "inputSchema": {
  "examples": [
   {
    "query": "webp"
   },
   {
    "limit": 5,
    "query": "flexbox"
   }
  ],
  "properties": {
   "limit": {
    "description": "1-50 (default 10)",
    "type": "number"
   },
   "query": {
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Number of results returned",
    "type": "number"
   },
   "features": {
    "description": "Matching features",
    "items": {
     "properties": {
      "id": {
       "description": "Feature identifier",
       "type": "string"
      },
      "status": {
       "description": "Feature status",
       "type": "string"
      },
      "title": {
       "description": "Feature title",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "Search query normalized to lowercase",
    "type": "string"
   }
  },
  "required": [
   "query",
   "count",
   "features"
  ],
  "type": "object"
 },
 "title": "Search",

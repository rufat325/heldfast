{
 "description": "Classify normalized commercial events as exposure, operations, candidate signals, qualified demand, validated value, external revenue, or retention without inflating vanity activity. Costs $0.25 USDC on Base mainnet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "events": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "actor_token": {
       "maxLength": 160,
       "minLength": 8,
       "type": "string"
      },
      "amount": {
       "exclusiveMinimum": 0,
       "maximum": 1000000000,
       "type": "number"
      },
      "attribution": {
       "enum": [
        "none",
        "inferred",
        "direct",
        "verified"
       ]
      },
      "currency": {
       "maxLength": 10,
       "type": "string"
      },
      "evidence_ref": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "external_actor": {
       "type": "boolean"
      },
      "id": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "measured_value": {
       "exclusiveMinimum": 0,
       "maximum": 1000000000,
       "type": "number"
      },
      "measurement_unit": {
       "enum": [
        "minutes"
       ]
      },
      "occurred_at": {
       "format": "date-time",
       "type": "string"
      },
      "owner_controlled": {
       "type": "boolean"
      },
      "parent_event_id": {
       "maxLength": 120,
       "type": "string"
      },
      "product_id": {
       "maxLength": 200,
       "type": "string"
      },
      "source": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "transaction_id": {
       "maxLength": 300,
       "type": "string"
      },
      "type": {
       "enum": [
        "page-view",
        "impression",
        "reaction",
        "indexing-event",
        "deployment",
        "directory-listing",
        "scan",
        "sent-message",
        "internal-test",
        "owner-verification-payment",
        "owner-install",
        "owner-click",
        "owner-checkout-open",
        "attributable-click",
        "buyer-reply",
        "buyer-question",
        "checkout-open",
        "install",
        "payment-initiation",
        "measured-review-time-reduction",
        "external-settlement",
        "commission",
        "recurring-use"
       ]
      }
     },
     "required": [
      "id",
      "type",
      "occurred_at",
      "source",
      "evidence_ref",
      "owner_controlled",
      "external_actor",
      "attribution"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "observed_at": {
    "format": "date-time",
    "type": "string"
   },
   "window": {
    "additionalProperties": false,
    "properties": {
     "ended_at": {
      "format": "date-time",
      "type": "string"
     },
     "started_at": {
      "format": "date-time",
      "type": "string"
     }
    },
    "required": [
     "started_at",
     "ended_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "observed_at",
   "window",
   "events"
  ],
  "type": "object"
 },
 "name": "justhandled_qualified_demand_ledger"
}

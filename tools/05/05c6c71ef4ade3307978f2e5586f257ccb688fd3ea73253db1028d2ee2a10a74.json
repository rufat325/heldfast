  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Customer faithfulness (provider share-of-wallet)"
 },
 "description": "Whether a provider's customers keep all their domains with it or spread\nthem across several \u2014 a book-QUALITY signal no single provider can measure about itself, for a\nretention question.\nArguments: no argument = the aggregate loyalty distribution (free): share of owners with a single\nprovider, average wallet share, and the cross-border cut. provider= a consolidator or a brand that\nresolves to one returns its named exclusivity score against peers (analyst tier). chart=true returns\na branded SVG.\nPopulation: owners identified from shared analytics or advertising accounts only, which is\nhost-independent; certificate-based ownership detection is confounded with single-hosting and is\nexcluded. is_layer marks CDN and DNS providers, where low exclusivity is expected.\nMethod and caveats: definitions(section='faithfulness').",
 "inputSchema": {
  "properties": {
   "chart": {
    "default": false,
    "type": "boolean"
   },
   "provider": {
    "default": "",
    "type": "string"
   }
  },
  "type": "object"
 },

       "type": "string"
      },
      "traffic_percent": {
       "description": "Traffic percentage for this variant",
       "type": "integer"
      }
     },
     "required": [
      "page_name",
      "traffic_percent"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },

{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare Companies"
 },
 "description": "Compare hiring profiles of multiple companies side-by-side. Analyst tier. tier. Returns per-company current state (totalJobs, medianSalary, trend, top skills) plus monthly snapshot history for the chosen window. Up to 5 companies. Use for 'compare hiring at Stripe vs Plaid vs Adyen' or 'which of these is growing fastest?'. Not for one company in depth (`get_company_profile`) or the user's personal fit (`company_fit`).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "domains": {
    "description": "Up to 5 company domains to compare side-by-side (e.g. ['stripe.com', 'plaid.com', 'adyen.com'])",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "months": {
    "description": "Months of monthly-snapshot history per company (1-12, default 6). Snapshots began March 2026, so depth is capped by available history.",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "domains"
  ],
  "type": "object"
 },
 "name": "compare_companies",

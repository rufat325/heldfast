{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Attaches a postal address to an SMI subject.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "city": {
    "description": "The city.",
    "minLength": 1,
    "type": "string"
   },
   "country": {
    "description": "The country the address is in, spelled out (e.g. United States).",
    "minLength": 1,
    "type": "string"
   },
   "county": {
    "description": "The county, if the user gave one.",
    "minLength": 1,
    "type": "string"
   },
   "isCurrent": {
    "description": "Whether the subject currently lives at this address, as opposed to a former one. Ask the user directly if it isn't clear from context.",
    "type": "boolean"
   },
   "state": {
    "description": "The state or province.",
    "minLength": 1,
    "type": "string"
   },
   "street1": {
    "description": "The street number and name.",
    "minLength": 1,
    "type": "string"
   },
   "street2": {
    "description": "A second address line, such as an apartment, suite, or unit number.",
    "minLength": 1,
    "type": "string"
   },
   "subjectId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ],
    "description": "The subject's id, from a prior smi_get_subject or subject-enrichment call."
   },
   "zip": {
    "description": "The postal or zip code.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "subjectId",
   "country",
   "isCurrent"
  ],
  "type": "object"
 },
 "name": "smi_add_subject_address",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "recordId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   },
   "subjectId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   }
  },
  "required": [
   "subjectId"
  ],
  "type": "object"
 },
 "title": "Add Subject Address"
}

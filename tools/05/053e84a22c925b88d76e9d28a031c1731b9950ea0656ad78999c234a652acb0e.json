{
 "description": "Build a public URBIS WMS GetMap URL for a layer and bounding box.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bbox": {
    "description": "Bounding box as minX,minY,maxX,maxY",
    "type": "string"
   },
   "crs": {
    "default": "EPSG:31370",
    "description": "Coordinate reference system",
    "type": "string"
   },
   "format": {
    "default": "image/png",
    "description": "Requested WMS image format",
    "type": "string"
   },
   "height": {
    "default": 512,
    "description": "Map image height in pixels",
    "maximum": 4096,
    "minimum": 1,
    "type": "number"
   },
   "layerName": {
    "description": "Exact WMS layer name",
    "type": "string"
   },
   "service": {
    "description": "Which public URBIS WMS service to use",
    "enum": [
     "vector",
     "raster"
    ],
    "type": "string"
   },
   "styles": {
    "default": "",
    "description": "Optional WMS style name",
    "type": "string"
   },
   "transparent": {
    "default": true,
    "description": "Whether the output image should be transparent",
    "type": "boolean"
   },
   "width": {
    "default": 512,
    "description": "Map image width in pixels",
    "maximum": 4096,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "service",
   "layerName",
   "bbox"
  ],
  "type": "object"
 },
 "name": "urbis_build_map_url"
}

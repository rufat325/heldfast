{
 "description": "List wallets saved in the local keystore (~/.printr/wallets.json). Private keys are never returned.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chain": {
    "description": "Filter by CAIP-2 chain ID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "printr_wallet_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "wallets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": "string"
      },
      "chain": {
       "type": "string"
      },
      "created_at": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "label": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "label",
      "chain",
      "address",
      "created_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "wallets"
  ],
  "type": "object"
 }
}

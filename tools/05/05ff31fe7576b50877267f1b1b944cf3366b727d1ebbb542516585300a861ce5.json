{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate ByteDance upscale eligibility and credits for one stored video. Does not spend credits or queue a job. Call this before media_upscale.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "description": "Source video asset UUID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "projectId": {
    "description": "Optional project UUID for the estimate context. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "targetResolution": {
    "description": "Output long-edge target.",
    "enum": [
     "1080p",
     "4k"
    ],
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "assetId",
   "targetResolution"
  ],
  "type": "object"
 },
 "name": "media_upscale_estimate",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "creditsRequired": {
    "type": "number"
   },
   "durationSeconds": {
    "type": "number"
   },
   "eligible": {
    "type": "boolean"
   },
   "ineligibleReason": {
    "type": [
     "string",
     "null"
    ]
   },
   "sourceLongEdge": {
    "type": "number"
   },
   "targetFps": {
    "enum": [
     "30fps",
     "60fps"
    ],
    "type": "string"
   },
   "targetLongEdge": {
    "type": "number"
   },
   "targetResolution": {
    "enum": [
     "1080p",
     "4k"
    ],
    "type": "string"
   }
  },
  "required": [
   "eligible",
   "ineligibleReason",
   "targetResolution",
   "targetFps",
   "creditsRequired",
   "durationSeconds",
   "sourceLongEdge",
   "targetLongEdge"
  ],
  "type": "object"
 },
 "title": "Estimate Video Upscale"
}

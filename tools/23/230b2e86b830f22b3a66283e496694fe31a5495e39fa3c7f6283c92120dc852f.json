{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Source-preview private feedback for a failure in iOS Agent tools, not the user app. First preview fixed categories. Show ALL fields, destination and privacy notice in chat. Submit only after the user explicitly approves that preview; never infer approval from a tool failure. No GitHub login needed for the user. Never send source, diagnostics, paths, credentials or free text. Not available until the operator configures an HTTPS receiver. Do not repeatedly offer after dismissal.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "preview",
     "submit"
    ],
    "type": "string"
   },
   "previewId": {
    "format": "uuid",
    "type": "string"
   },
   "report": {
    "additionalProperties": false,
    "properties": {
     "client": {
      "enum": [
       "claude",
       "chatgpt-codex",
       "gemini-cli",
       "muse",
       "unknown"
      ],
      "type": "string"
     },
     "feature": {
      "enum": [
       "installation",
       "swift-review",
       "local-references",
       "app-starter",
       "asset-generation",
       "simulator",
       "app-loop",
       "client-connection"
      ],
      "type": "string"
     },
     "platform": {
      "enum": [
       "macos",
       "linux",
       "windows",
       "unknown"
      ],
      "type": "string"
     },
     "reproducibility": {
      "enum": [
       "once",
       "repeated",
       "unknown"
      ],
      "type": "string"
     },
     "symptom": {
      "enum": [
       "unexpected-error",
       "timeout",
       "incorrect-result",
       "missing-result",
       "invalid-output",
       "documentation-mismatch"
      ],
      "type": "string"
     }
    },
    "required": [
     "feature",
     "symptom"
    ],
    "type": "object"
   },
   "userApproved": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "private_feedback"
}

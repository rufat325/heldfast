{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Produce evidence-grounded CV improvement recommendations, optional job-specific guidance and ATS actions without inventing candidate facts. Use when a candidate or recruitment agent needs actionable CV improvement guidance.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "candidate_profile": {},
   "cv_text": {
    "maxLength": 200000,
    "type": "string"
   },
   "mode": {
    "default": "recommendations",
    "enum": [
     "recommendations",
     "rewrite_summary",
     "rewrite_experience",
     "ats_optimization",
     "full_improvement_plan"
    ],
    "type": "string"
   },
   "target_job_description": {
    "anyOf": [
     {
      "maxLength": 100000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "name": "cv_improve",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ats_recommendations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "current_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "experience_recommendations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "job_specific_recommendations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "keywords_to_consider": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "priority_actions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rewrite_examples": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "skill_recommendations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary_recommendations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "current_score",
   "priority_actions",
   "summary_recommendations",
   "experience_recommendations",
   "skill_recommendations",
   "ats_recommendations",
   "job_specific_recommendations",
   "rewrite_examples",
   "keywords_to_consider",
   "warnings"
  ],
  "type": "object"
 }
}

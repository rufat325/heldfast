{
 "description": "Analyze and score biomarker values with clinical interpretation. Identifies abnormal values, calculates risk scores, and provides actionable context. Costs 5 credits per call.",
 "inputSchema": {
  "properties": {
   "biomarkers": {
    "description": "Array of biomarker readings to analyze",
    "items": {
     "properties": {
      "flag": {
       "description": "Lab flag if any (e.g. \"H\", \"L\", \"CRITICAL\")",
       "type": "string"
      },
      "name": {
       "description": "Biomarker name (e.g. \"LDL Cholesterol\", \"HbA1c\", \"TSH\")",
       "type": "string"
      },
      "ref_high": {
       "description": "Upper bound of reference range (optional)",
       "type": "number"
      },
      "ref_low": {
       "description": "Lower bound of reference range (optional)",
       "type": "number"
      },
      "unit": {
       "description": "Unit of measurement (e.g. \"mg/dL\", \"%\", \"mIU/L\")",
       "type": "string"
      },
      "value": {
       "description": "Numeric result value",
       "type": "number"
      }
     },
     "required": [
      "name",
      "value",
      "unit"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "biomarkers"
  ],
  "type": "object"
 },
 "name": "analyze_lab_results"
}

{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "title": "Push redirects (add)"
 },
 "description": "Add redirects for specific URLs/paths without touching existing redirects. Non-destructive \u2014 only the listed paths are written. Plugin mode only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "project_id": {
    "description": "Project UUID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "redirect_to": {
    "description": "Custom redirect target URL (default: homepage). Example: \"https://example.com/new-landing/\"",
    "type": "string"
   },
   "urls": {
    "description": "URLs or paths to redirect (e.g. [\"/old-page.html\", \"/category/sub/\"]).",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "wordpress_domain": {
    "description": "Target WordPress domain",
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "wordpress_domain",
   "urls"
  ],
  "type": "object"
 },
 "name": "push_redirects_add"
}

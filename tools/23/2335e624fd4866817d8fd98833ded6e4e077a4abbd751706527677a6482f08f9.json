{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Recommend a set of KIP dashboards for this boat: the use-case dashboards its data supports, each with a preview. Does not write anything.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "intents": {
    "description": "Limit to these intents (default: all that the boat supports).",
    "items": {
     "enum": [
      "general",
      "navigation",
      "sailing",
      "power",
      "environment"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "recommend_dashboard_set",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dashboards": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "unsupported": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "dashboards",
   "unsupported"
  ],
  "type": "object"
 },
 "title": "Recommend a dashboard set"
}

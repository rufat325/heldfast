{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Minimum track record length"
 },
 "description": "Minimum track record length for an observed Sharpe to clear a benchmark Sharpe (default 0) at a confidence level (default 0.95), and, when observations is sent, the probabilistic Sharpe of that record against the benchmark. A deflated Sharpe or overfitting probability above or below any threshold is not admission to anything and is not a forecast.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "benchmark_sharpe_annualized": {
    "maximum": 10,
    "minimum": -10,
    "type": "number"
   },
   "confidence": {
    "exclusiveMaximum": 1,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "non_excess_kurtosis": {
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "observations": {
    "maximum": 1000000,
    "minimum": 2,
    "type": "integer"
   },
   "observed_sharpe_annualized": {
    "maximum": 10,
    "minimum": -10,
    "type": "number"
   },
   "periods_per_year": {
    "maximum": 10000,
    "minimum": 1,
    "type": "number"
   },
   "skew": {
    "maximum": 20,
    "minimum": -20,
    "type": "number"
   }
  },
  "required": [
   "observed_sharpe_annualized",
   "periods_per_year",
   "skew",
   "non_excess_kurtosis"
  ],
  "type": "object"
 },
 "name": "validate_track_record",
 "title": "Minimum track record length"
}

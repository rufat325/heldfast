{
 "description": "Send a task to an autonomous Codex agent. It reads/writes files, runs shell commands, searches codebases, and handles complex software engineering tasks end-to-end. Returns the result text plus a thread_id for follow-ups via codex_reply.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "additionalDirs": {
    "description": "Extra directories the agent can access for this invocation",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "approvalPolicy": {
    "description": "Approval policy override (can only tighten, never loosen)",
    "enum": [
     "on-failure",
     "on-request",
     "untrusted"
    ],
    "type": "string"
   },
   "cwd": {
    "description": "Working directory (overrides CODEX_CWD)",
    "type": "string"
   },
   "effort": {
    "description": "Reasoning effort override",
    "enum": [
     "minimal",
     "low",
     "medium",
     "high",
     "xhigh"
    ],
    "type": "string"
   },
   "instructions": {
    "description": "Additional instructions (prepended to prompt)",
    "type": "string"
   },
   "model": {
    "description": "Model override (e.g. \"gpt-5-codex\", \"o3\", \"codex-1\")",
    "type": "string"
   },
   "networkAccess": {
    "description": "Enable network access from sandbox",
    "type": "boolean"
   },
   "prompt": {
    "description": "Task or question for Codex",
    "type": "string"
   },
   "sandboxMode": {
    "description": "Sandbox mode override (can only tighten, never loosen)",
    "enum": [
     "read-only",
     "workspace-write"
    ],
    "type": "string"
   },
   "webSearchMode": {
    "description": "Web search mode",
    "enum": [
     "disabled",
     "cached",
     "live"
    ],
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "codex"
}

{
 "description": "Find train connections between two Belgian railway stations. Returns routes with departure/arrival times, platforms, delays, and transfers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "datetime": {
    "description": "ISO datetime, e.g. 2026-04-11T14:30",
    "type": "string"
   },
   "from": {
    "description": "Departure station name",
    "type": "string"
   },
   "timeSel": {
    "description": "Search by departure or arrival time",
    "enum": [
     "departure",
     "arrival"
    ],
    "type": "string"
   },
   "to": {
    "description": "Arrival station name",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "irail_get_connections"
}

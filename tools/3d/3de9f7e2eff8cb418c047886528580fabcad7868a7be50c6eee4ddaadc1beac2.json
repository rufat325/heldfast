{
 "description": "Full-text search across event titles, descriptions, and locations. Searches 1 year back and forward.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calendarId": {
    "description": "Calendar ID (default: primary)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "maxResults": {
    "description": "Max results (default: 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search query",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "calendar_search_events"
}

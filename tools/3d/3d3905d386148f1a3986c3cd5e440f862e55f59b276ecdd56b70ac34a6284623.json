{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Fetch / screenshot a web page"
 },
 "description": "Paid tiered Browser-as-a-Service (/browse or /web-act). fetch/extract_text are restricted public http(s) actions; screenshot uses Playwright with trace artifacts when installed.",
 "execution_layer": true,
 "inputSchema": {
  "examples": [
   {
    "action": "fetch",
    "max_bytes": 65536,
    "tier": 1,
    "url": "https://api.bitget.com/api/v2/spot/market/tickers?symbol=BTCUSDT"
   }
  ],
  "properties": {
   "action": {
    "default": "fetch",
    "enum": [
     "fetch",
     "extract_text",
     "screenshot"
    ],
    "type": "string"
   },
   "agent_id": {
    "description": "Optional caller agent ID",
    "type": "string"
   },
   "max_bytes": {
    "default": 65536,
    "maximum": 262144,
    "minimum": 1024,
    "type": "integer"
   },
   "tier": {
    "default": 1,
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   },
   "url": {
    "description": "Public http(s) URL to fetch",
    "type": "string"
   },
   "viewport_height": {
    "default": 900,
    "maximum": 1600,
    "minimum": 320,
    "type": "integer"
   },
   "viewport_width": {
    "default": 1280,
    "maximum": 1920,
    "minimum": 320,
    "type": "integer"
   },
   "wait_ms": {
    "default": 500,
    "maximum": 3000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "browse",
 "pricing": "Tiered from 500 sats fetch/text, 1500 sats screenshot, 2000 sats multi-step",
 "supported_payments": [
  "Bearer Token (credits)"
 ]
}

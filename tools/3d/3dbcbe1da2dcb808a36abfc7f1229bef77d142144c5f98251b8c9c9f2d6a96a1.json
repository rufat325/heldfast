{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate the exact exit price needed to hit a target PnL or ROE percentage. Use when user asks \"at what price do I take profit to make $500?\" or \"where should I set TP for 20% ROE?\". Returns: targetExitPrice.",
 "inputSchema": {
  "properties": {
   "contractType": {
    "description": "linear = USDT-margined (default), inverse = coin-margined. For inverse, pnl-mode targetValue and outputs are in the base coin.",
    "enum": [
     "linear",
     "inverse"
    ],
    "type": "string"
   },
   "entryPrice": {
    "description": "Entry price",
    "type": "number"
   },
   "feeClosePct": {
    "description": "Closing fee fraction, default 0.0005",
    "type": "number"
   },
   "feeOpenPct": {
    "description": "Opening fee fraction, default 0.0002",
    "type": "number"
   },
   "leverage": {
    "description": "Leverage multiplier",
    "type": "number"
   },
   "side": {
    "enum": [
     "long",
     "short"
    ],
    "type": "string"
   },
   "sizeBase": {
    "description": "Position size in base asset",
    "type": "number"
   },
   "targetMode": {
    "description": "\"pnl\" = target in USDT, \"roe\" = target in %",
    "enum": [
     "pnl",
     "roe"
    ],
    "type": "string"
   },
   "targetValue": {
    "description": "Target value (USDT/coin for pnl mode, or %)",
    "type": "number"
   }
  },
  "required": [
   "side",
   "entryPrice",
   "leverage",
   "sizeBase",
   "targetMode",
   "targetValue"
  ],
  "type": "object"
 },
 "name": "workflow.run_exit_target"
}

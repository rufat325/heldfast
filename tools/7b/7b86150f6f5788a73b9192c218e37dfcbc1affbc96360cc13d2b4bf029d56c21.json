{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List optional Series with bounded counts and cover previews.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 30,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "limit",
   "offset",
   "workspaceId"
  ],
  "type": "object"
 },
 "name": "series_list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bounds": {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "offset": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "returned": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "limit",
     "offset",
     "total",
     "returned",
     "hasMore",
     "truncated"
    ],
    "type": "object"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "captionThemeId": {
       "anyOf": [
        {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "coverAssetId": {
       "anyOf": [
        {
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "coverUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "createdAt": {
       "type": "string"
      },
      "defaultCreationMode": {
       "default": "podcast",
       "enum": [
        "podcast",
        "faceless"
       ],
       "type": "string"
      },
      "description": {
       "anyOf": [
        {
         "maxLength": 2000,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "id": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "logoAssetId": {
       "anyOf": [
        {
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "name": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "projectCount": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "revision": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "sourceCount": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "storyKitId": {
       "anyOf": [
        {
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "updatedAt": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "defaultCreationMode",
      "description",
      "coverAssetId",
      "logoAssetId",
      "storyKitId",
      "captionThemeId",
      "id",
      "revision",
      "createdAt",
      "updatedAt",
      "coverUrl",
      "projectCount",
      "sourceCount"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "items",
   "bounds"
  ],
  "type": "object"
 },
 "title": "List Series"
}

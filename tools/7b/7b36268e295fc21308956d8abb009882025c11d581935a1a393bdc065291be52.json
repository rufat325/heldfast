   },
   "mode": {
    "default": "host",
    "description": "\"host\" = free single-IP lookup; \"search\" = faceted query (consumes paid credits).",
    "enum": [
     "host",
     "search"
    ],
    "type": "string"
   },
   "target": {
    "description": "For mode \"host\": an IP address. For mode \"search\": a Shodan search query (e.g. \"org:\\\"Example Inc\\\" port:443\").",
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"

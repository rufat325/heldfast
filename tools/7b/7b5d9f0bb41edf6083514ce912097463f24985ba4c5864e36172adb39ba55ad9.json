{
 "description": "Delete or terminate an asynchronous Outscraper request by request id.\n\nBest for:\n- cleaning up queued or no-longer-needed async jobs\n- stopping work you no longer want to keep polling\n- testing the full async request lifecycle from MCP\n\nUse this carefully:\n- it is intended for cleanup or cancellation\n- only use it when you are sure the request is no longer needed\n- after deletion, the original async request should not be expected to complete normally",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "request_id": {
    "description": "Async request id to delete.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "request_id"
  ],
  "type": "object"
 },
 "name": "requests_delete",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "async": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "is_async_submission": {
      "type": "boolean"
     },
     "next_step": {
      "type": "string"
     },
     "results_location": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "is_async_submission"
    ],
    "type": "object"
   },
   "data": {},
   "meta": {
    "additionalProperties": false,
    "properties": {
     "operation": {
      "type": "string"
     },
     "service": {
      "type": "string"
     }
    },
    "required": [
     "service",
     "operation"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "Outscraper Request Delete"
}

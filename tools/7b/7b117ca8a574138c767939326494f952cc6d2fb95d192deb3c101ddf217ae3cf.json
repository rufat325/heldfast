{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return stored brand citation evidence plus the top engine-native source domains across the same tracked-prompt window. Example: brand_id='acme', days=14, engine='perplexity'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brand_id": {
    "description": "Tracked brand ID to inspect.",
    "type": "string"
   },
   "days": {
    "default": 14,
    "description": "Previous days to search.",
    "maximum": 90,
    "minimum": 1,
    "type": "number"
   },
   "engine": {
    "description": "Engine to filter by; omit for all engines.",
    "enum": [
     "chatgpt",
     "claude",
     "perplexity",
     "gemini",
     "grok",
     "ai_overviews",
     "ai_mode"
    ],
    "type": "string"
   }
  },
  "required": [
   "brand_id"
  ],
  "type": "object"
 },
 "name": "get_citations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brand_id": {
    "type": "string"
   },
   "citations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "citation_type": {
       "type": "string"
      },
      "cited_at": {
       "type": "string"
      },
      "cited_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "engine": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "prompt": {
       "type": "string"
      },
      "response_excerpt": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "engine",
      "prompt",
      "cited_at",
      "citation_type",
      "response_excerpt",
      "cited_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "days": {
    "type": "number"
   },
   "engine": {
    "type": [
     "string",
     "null"
    ]
   },
   "top_sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "citation_count": {
       "type": "number"
      },
      "domain": {
       "type": "string"
      },
      "engines": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "is_brand_domain": {
       "type": "boolean"
      },
      "prompt_count": {
       "type": "number"
      },
      "sample_url": {
       "type": "string"
      }
     },
     "required": [
      "domain",
      "citation_count",
      "prompt_count",
      "engines",
      "sample_url",
      "is_brand_domain"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "brand_id",
   "days",
   "engine",
   "top_sources",
   "citations"
  ],
  "type": "object"
 },
 "title": "Get AI citation evidence"
}

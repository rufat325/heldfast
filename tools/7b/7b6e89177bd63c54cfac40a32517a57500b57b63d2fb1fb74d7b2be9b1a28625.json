{
 "description": "Compare before/after versions of a config file to detect security downgrades: CORS relaxation, CSP weakening, HSTS removal, debug mode, cookie flag changes, TLS disabling, new hardcoded secrets, removed security headers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "New config file content",
    "type": "string"
   },
   "before": {
    "description": "Previous config file content",
    "type": "string"
   },
   "file_path": {
    "default": "config",
    "description": "Config file path for context",
    "type": "string"
   },
   "format": {
    "default": "json",
    "description": "Output format",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   }
  },
  "required": [
   "before",
   "after"
  ],
  "type": "object"
 },
 "name": "scan_config_change"
}

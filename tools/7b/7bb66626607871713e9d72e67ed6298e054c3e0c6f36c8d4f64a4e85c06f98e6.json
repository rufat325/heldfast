{
 "description": "Compare a predeclared channel hypothesis and qualified outcome gate with attributable events, contamination, budgets, changed variables, cooldowns, and a bounded next experiment. Costs $0.25 USDC on Base mainnet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "attribution_complete": {
    "type": "boolean"
   },
   "cost_usd": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "effort_hours": {
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   },
   "events": {
    "items": {
     "additionalProperties": true,
     "required": [
      "id",
      "type",
      "occurred_at",
      "evidence_ref",
      "external_actor",
      "owner_controlled",
      "attribution"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   },
   "experiment": {
    "additionalProperties": false,
    "properties": {
     "changed_variables": {
      "items": {
       "enum": [
        "channel",
        "offer",
        "artifact",
        "audience",
        "timing"
       ]
      },
      "maxItems": 5,
      "type": "array"
     },
     "channel": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "cooldown_days": {
      "maximum": 365,
      "minimum": 0,
      "type": "integer"
     },
     "declared_before_start": {
      "type": "boolean"
     },
     "ended_at": {
      "format": "date-time",
      "type": "string"
     },
     "gate": {
      "additionalProperties": false,
      "properties": {
       "metric": {
        "enum": [
         "attributable-click",
         "buyer-reply",
         "buyer-question",
         "checkout-open",
         "install",
         "payment-initiation",
         "external-settlement",
         "commission",
         "recurring-use",
         "measured-review-time-reduction",
         "page-view",
         "impression",
         "reaction",
         "indexing-event",
         "deployment",
         "directory-listing",
         "scan",
         "sent-message"
        ]
       },
       "threshold": {
        "maximum": 1000000,
        "minimum": 1,
        "type": "integer"
       },
       "window_days": {
        "maximum": 365,
        "minimum": 1,
        "type": "integer"
       }
      },
      "required": [
       "metric",
       "threshold",
       "window_days"
      ],
      "type": "object"
     },
     "hypothesis": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     },
     "id": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "max_cost_usd": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "number"
     },
     "max_effort_hours": {
      "maximum": 100000,
      "minimum": 0,
      "type": "number"
     },
     "objective": {
      "enum": [
       "qualified-demand",
       "revenue",
       "retention",
       "validated-learning"
      ]
     },
     "started_at": {
      "format": "date-time",
      "type": "string"
     },
     "variables": {
      "additionalProperties": false,
      "properties": {
       "artifact": {
        "type": "string"
       },
       "audience": {
        "type": "string"
       },
       "channel": {
        "type": "string"
       },
       "offer": {
        "type": "string"
       },
       "timing": {
        "type": "string"
       }
      },
      "required": [
       "channel",
       "offer",
       "artifact",
       "audience",
       "timing"
      ],
      "type": "object"
     }
    },
    "required": [
     "id",
     "channel",
     "hypothesis",
     "objective",
     "started_at",
     "ended_at",
     "declared_before_start",
     "gate",
     "variables",
     "changed_variables",
     "max_cost_usd",
     "max_effort_hours",
     "cooldown_days"
    ],
    "type": "object"
   },
   "observed_at": {
    "format": "date-time",
    "type": "string"
   },
   "owner_activity_excluded": {
    "type": "boolean"
   }
  },
  "required": [
   "observed_at",
   "experiment",
   "events",
   "cost_usd",
   "effort_hours",
   "attribution_complete",
   "owner_activity_excluded"
  ],
  "type": "object"
 },
 "name": "justhandled_channel_experiment_postmortem"
}

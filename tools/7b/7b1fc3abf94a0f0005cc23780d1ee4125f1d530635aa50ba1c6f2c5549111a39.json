{
 "description": "Run an allowed Granoflow Local HTTP API request. Prefer dedicated tools when available.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": true,
    "description": "When true, previews write requests.",
    "type": "boolean"
   },
   "input": {
    "additionalProperties": {},
    "description": "JSON object sent to the Granoflow Local HTTP API.",
    "type": "object"
   },
   "method": {
    "default": "GET",
    "enum": [
     "GET",
     "POST",
     "PATCH",
     "DELETE"
    ],
    "type": "string"
   },
   "path": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "granoflow_api_request"
}

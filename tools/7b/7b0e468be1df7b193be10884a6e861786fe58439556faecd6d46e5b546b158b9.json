{
 "description": "Get replies to a Reddit comment. Requires post_id and reply_cursor from get_reddit_post_comments. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "reply_cursor from a comment in get_reddit_post_comments.",
    "minLength": 1,
    "type": "string"
   },
   "post_id": {
    "description": "Post fullname, e.g. 't3_1v6ngaf'.",
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "default": "TOP",
    "description": "Sort order.",
    "enum": [
     "HOT",
     "NEW",
     "TOP",
     "BEST",
     "CONTROVERSIAL"
    ],
    "type": "string"
   }
  },
  "required": [
   "post_id",
   "cursor"
  ],
  "type": "object"
 },
 "name": "get_reddit_comment_replies"
}

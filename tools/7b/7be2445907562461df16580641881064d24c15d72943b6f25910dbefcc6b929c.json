{
 "description": "Get recent order fills from the Orderbook subgraph",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "first": {
    "default": 20,
    "description": "Number of trades to return",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "maker": {
    "description": "Optional: filter by maker address",
    "type": "string"
   },
   "taker": {
    "description": "Optional: filter by taker address",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_orderbook_trades"
}

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Side-by-side comparison of 2 to 5 products by SKU: price ex/inc VAT, stock, brand, weight and the specification bullet points, so an agent can recommend between options.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "description": "Storefront locale such as en-GB (default), en-US, de, fr-FR, es-ES, it-IT, nl-NL, pl. Controls product names, slugs and prices.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   },
   "skus": {
    "items": {
     "description": "Product SKU exactly as shown on the site.",
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "skus"
  ],
  "type": "object"
 },
 "name": "compare_products",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comparison": {
    "items": {
     "oneOf": [
      {
       "additionalProperties": false,
       "properties": {
        "found": {
         "const": false,
         "type": "boolean"
        },
        "sku": {
         "type": "string"
        }
       },
       "required": [
        "sku",
        "found"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "brand": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "express_eligible": {
         "anyOf": [
          {
           "type": "boolean"
          },
          {
           "type": "null"
          }
         ]
        },
        "found": {
         "const": true,
         "type": "boolean"
        },
        "in_stock": {
         "type": "boolean"
        },
        "name": {
         "type": "string"
        },
        "price": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "bulk_prices": {
             "description": "Lower unit prices from min_quantity up.",
             "items": {
              "additionalProperties": false,
              "properties": {
               "ex_vat": {
                "type": "number"
               },
               "inc_vat": {
                "type": "number"
               },
               "min_quantity": {
                "type": "number"
               }
              },
              "required": [
               "min_quantity",
               "ex_vat",
               "inc_vat"
              ],
              "type": "object"
             },
             "type": "array"
            },
            "currency": {
             "type": "string"
            },
            "ex_vat": {
             "type": "number"
            },
            "inc_vat": {
             "type": "number"
            },
            "on_sale": {
             "type": "boolean"
            },
            "vat_rate": {
             "anyOf": [
              {
               "type": "number"
              },
              {
               "type": "null"
              }
             ],
             "description": "VAT rate in percent (20 = 20%). null when unknown: ex_vat then equals inc_vat."
            },
            "was_ex_vat": {
             "type": "number"
            },
            "was_inc_vat": {
             "description": "Price before the sale; only when on_sale.",
             "type": "number"
            }
           },
           "required": [
            "currency",
            "ex_vat",
            "inc_vat",
            "on_sale",
            "vat_rate"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "sku": {
         "type": "string"
        },
        "specifications": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "stock_level": {
         "type": "number"
        },
        "summary": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "url": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "weight_kg": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "sku",
        "found",
        "name",
        "brand",
        "url",
        "price",
        "in_stock",
        "stock_level",
        "weight_kg",
        "express_eligible",
        "specifications",
        "summary"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   }
  },
  "required": [
   "comparison"
  ],
  "type": "object"
 },
 "title": "Compare products"
}

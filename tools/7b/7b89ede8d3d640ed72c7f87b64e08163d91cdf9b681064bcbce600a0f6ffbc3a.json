{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Atomically claim a file, directory, interface, or workspace for a work item. Conflicting exclusive claims are rejected by the runtime.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "kind": {
    "enum": [
     "file",
     "directory",
     "interface",
     "workspace"
    ],
    "type": "string"
   },
   "mode": {
    "enum": [
     "exclusive",
     "shared_read"
    ],
    "type": "string"
   },
   "resource": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "minLength": 1,
    "type": "string"
   },
   "ttlSeconds": {
    "maximum": 3600,
    "minimum": 30,
    "type": "integer"
   },
   "workId": {
    "type": "string"
   }
  },
  "required": [
   "workId",
   "sessionId",
   "resource"
  ],
  "type": "object"
 },
 "name": "claim_acquire"
}

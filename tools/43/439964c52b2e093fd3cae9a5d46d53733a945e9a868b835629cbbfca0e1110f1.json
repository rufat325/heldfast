{
 "description": "Add a new task to a section. Use section_id from get_board.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "section_id": {
    "description": "ID of the section to add the task to",
    "type": "string"
   },
   "tag": {
    "description": "\"blocking\" for critical blockers",
    "enum": [
     "blocking",
     "ref"
    ],
    "type": "string"
   },
   "text": {
    "description": "Task description",
    "type": "string"
   }
  },
  "required": [
   "section_id",
   "text"
  ],
  "type": "object"
 },
 "name": "add_task"
}

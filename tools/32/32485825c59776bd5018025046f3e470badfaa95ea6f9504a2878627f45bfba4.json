{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Grant Member Setup"
 },
 "description": "Set a member's producer setup in a community you run: submit permission, optionally with split terms (they keep 70% / community 30%). Activates immediately \u2014 community-set, the member sees it but doesn't confirm. Omit terms = permission-only. Members only (partners use propose_deal). Requires community_id + member_uid.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "community_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "member_uid": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "terms": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "notes": {
        "maxLength": 2000,
        "type": "string"
       },
       "splits": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "recipient_id": {
           "maxLength": 128,
           "minLength": 1,
           "type": "string"
          },
          "recipient_type": {
           "enum": [
            "producer",
            "community"
           ],
           "type": "string"
          },
          "share_value": {
           "maximum": 100,
           "minimum": 0,
           "type": "number"
          }
         },
         "required": [
          "recipient_id",
          "recipient_type",
          "share_value"
         ],
         "type": "object"
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "splits"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "community_id",
   "member_uid"
  ],
  "type": "object"
 },
 "name": "grant_member_setup",
 "title": "Grant Member Setup"
}

        "examples": [
         "will-btc-close-above-100k"
        ],
        "type": "string"
       },
       "volume": {
        "description": "Traded volume in USD.",
        "examples": [
         1834520.5
        ],
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "id",
       "question",
       "implied_probabilities"
      ],
      "type": "object"
     },
     "slug": {
      "description": "The slug queried.",
      "examples": [
       "will-btc-close-above-100k"
      ],
      "type": "string"
     },
     "source": {
      "const": "polymarket-gamma",
      "description": "Data source.",
      "type": "string"
     }
    },
    "required": [

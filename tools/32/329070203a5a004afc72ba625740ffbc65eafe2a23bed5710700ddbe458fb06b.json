  },
  "required": [
   "status",
   "worker",
   "price_usd",
   "result",
   "provenance",
   "receipt_id",
   "receipt_url"
  ],
  "title": "prediction.market response",
  "type": "object"
 },
 "title": "Prediction market by slug"
}

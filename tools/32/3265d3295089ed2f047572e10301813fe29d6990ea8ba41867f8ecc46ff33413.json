{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Downloads and installs Go packages and their dependencies.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "downloadOnly": {
    "default": false,
    "description": "Download the named packages but do not install them (-d)",
    "type": "boolean"
   },
   "packages": {
    "description": "Packages to install (e.g., ['github.com/pkg/errors@latest'])",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "testDeps": {
    "default": false,
    "description": "Also download packages needed to build and test the specified packages (-t)",
    "type": "boolean"
   },
   "update": {
    "description": "Update modules: 'all' maps to -u (update to latest), 'patch' maps to -u=patch (patch-level updates only)",
    "enum": [
     "all",
     "patch"
    ],
    "type": "string"
   },
   "verbose": {
    "default": false,
    "description": "Print information about download and resolution progress (-v)",
    "type": "boolean"
   }
  },
  "required": [
   "packages"
  ],
  "type": "object"
 },
 "name": "get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "goModChanges": {
    "additionalProperties": false,
    "properties": {
     "added": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "removed": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "added",
     "removed"
    ],
    "type": "object"
   },
   "packages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "error": {
       "type": "string"
      },
      "errorType": {
       "enum": [
        "timeout",
        "dns",
        "authentication",
        "network",
        "unknown"
       ],
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "resolvedCount": {
    "type": "number"
   },
   "resolvedPackages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "newVersion": {
       "type": "string"
      },
      "package": {
       "type": "string"
      },
      "previousVersion": {
       "type": "string"
      }
     },
     "required": [
      "package",
      "newVersion"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Go Get"
}

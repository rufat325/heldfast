{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Set or clear your emoji reaction on a message (one reaction per person; a new emoji replaces the previous). Sends a small reaction message to the other participants. Fails on drafts and terminal messages.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "emoji": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "a single emoji; null or empty clears your reaction"
   },
   "id": {
    "description": "fmsg message id",
    "pattern": "^[0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "id",
   "emoji"
  ],
  "type": "object"
 },
 "name": "react",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cleared": {
    "type": "boolean"
   },
   "id": {
    "type": "string"
   },
   "reaction_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "time": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id",
   "reaction_id",
   "time",
   "cleared"
  ],
  "type": "object"
 },
 "title": "React to fmsg message"
}

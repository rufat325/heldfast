{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update fields on the signed-in user's health profile. Only the fields you pass are changed; omit the rest. Returns the full updated profile. Requires the user to be signed in (`supstack login`).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "age": {
    "maximum": 120,
    "minimum": 13,
    "type": "integer"
   },
   "biologicalSex": {
    "enum": [
     "male",
     "female"
    ],
    "type": "string"
   },
   "currentSupplements": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dietType": {
    "enum": [
     "omnivore",
     "vegetarian",
     "vegan",
     "keto",
     "paleo",
     "mediterranean",
     "other"
    ],
    "type": "string"
   },
   "exerciseFrequency": {
    "enum": [
     "none",
     "1-2",
     "3-4",
     "5+"
    ],
    "type": "string"
   },
   "healthConditions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "medications": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "primaryGoals": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sleepHours": {
    "maximum": 24,
    "minimum": 0,
    "type": "number"
   },
   "stressLevel": {
    "enum": [
     "low",
     "moderate",
     "high",
     "very-high"
    ],
    "type": "string"
   },
   "tracksBloodwork": {
    "type": "boolean"
   },
   "weight": {
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "number"
   },
   "weightUnit": {
    "enum": [
     "kg",
     "lbs"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "supstack_profile_set"
}

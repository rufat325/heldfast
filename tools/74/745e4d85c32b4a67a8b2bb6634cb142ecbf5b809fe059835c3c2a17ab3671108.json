{
 "description": "Write evidence-based task timestamps and historical Granoflow facts through the dedicated AI-agent API. AI execution may update startedAt while the task remains pending so it never claims the human doing focus slot; node-managed completion may correct startedAt/endedAt after status=done. Every create mutation requires shared AI/automation authoringEvidence for an action/outcome title, plain language, a real analogy, and a concrete example. Use dryRun first; when dryRun=false, the running app must advertise historical_task_mutations_v1.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "mutations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authoringEvidence": {
       "additionalProperties": {},
       "description": "Required for AI or automation task creation: declare an action/outcome title, plain-language review, and exact analogy/example excerpts from the description.",
       "type": "object"
      },
      "clientMutationId": {
       "minLength": 1,
       "type": "string"
      },
      "descriptionImpactReview": {
       "additionalProperties": false,
       "properties": {
        "authoringEvidence": {
         "$ref": "#/properties/mutations/items/properties/authoringEvidence"
        },
        "decision": {
         "enum": [
          "unchanged",
          "rewrite"
         ],
         "type": "string"
        },
        "fiveDimensionsReviewed": {
         "type": "boolean"
        },
        "rationale": {
         "minLength": 1,
         "type": "string"
        },
        "reasonCode": {
         "enum": [
          "operational_only",
          "review_only",
          "completion_only",
          "completion_summary_only",
          "historical_time_only",
          "node_completion_only",
          "placement_reviewed_no_semantic_change",
          "title_clarification_no_semantic_change",
          "semantic_change",
          "description_correction",
          "post_completion_revision"
         ],
         "type": "string"
        },
        "reviewedDescriptionSha256": {
         "pattern": "^[0-9a-f]{64}$",
         "type": "string"
        },
        "reviewedTaskUpdatedAt": {
         "minLength": 1,
         "type": "string"
        },
        "writebackRefs": {
         "items": {
          "minLength": 1,
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "reviewedTaskUpdatedAt",
        "reviewedDescriptionSha256",
        "decision",
        "reasonCode",
        "rationale"
       ],
       "type": "object"
      },
      "fields": {
       "additionalProperties": {},
       "type": "object"
      },
      "op": {
       "enum": [
        "create",
        "update",
        "softDelete"
       ],
       "type": "string"
      },
      "reason": {
       "minLength": 1,
       "type": "string"
      },
      "taskId": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "clientMutationId",
      "op"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "source": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "mutations"
  ],
  "type": "object"
 },
 "name": "granoflow_task_history_mutate"
}

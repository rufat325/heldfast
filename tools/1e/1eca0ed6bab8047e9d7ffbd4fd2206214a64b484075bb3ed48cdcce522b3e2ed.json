{
 "description": "List, create, or delete email templates",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_account": {
    "description": "Optional. Override identity for THIS call: pass the AgenticMail agent name (e.g. \"Fola\") to authenticate as that agent. Requires AGENTICMAIL_ACCOUNT_KEYS_JSON to contain a matching key. Omit to use the default identity (AGENTICMAIL_API_KEY).",
    "type": "string"
   },
   "action": {
    "description": "Action to perform",
    "enum": [
     "list",
     "create",
     "delete"
    ],
    "type": "string"
   },
   "id": {
    "description": "Template ID (for delete)",
    "type": "string"
   },
   "name": {
    "description": "Template name (for create)",
    "type": "string"
   },
   "subject": {
    "description": "Template subject (for create)",
    "type": "string"
   },
   "text": {
    "description": "Template body text (for create)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_templates"
}

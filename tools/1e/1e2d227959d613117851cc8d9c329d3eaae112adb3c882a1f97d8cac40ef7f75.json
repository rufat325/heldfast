 "description": "Fetch historical time series data for employment, inflation, wages, productivity, or housing. Returns dated data points with values. Provide series ID (e.g., \"PAYEMS\" for total nonfarm employment).",
 "inputSchema": {
  "examples": [
   {
    "series_id": "LNS14000000"
   },
   {
    "end_year": "2024",
    "series_id": "PAYEMS,CES0000000001",
    "start_year": "2020"
   },
   {
    "series_id": "EIUIR",
    "start_year": "2023"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "BLS registration key (optional, increases rate limits)",
    "type": "string"
   },
   "end_year": {
    "description": "End year (e.g., \"2024\"). Default: current year.",
    "type": "string"
   },
   "series_id": {
    "description": "BLS series ID (e.g., \"LNS14000000\" for unemployment rate). For multiple series, comma-separate them (e.g., \"LNS14000000,CES0000000001\").",
    "type": "string"
   },
   "start_year": {
    "description": "Start year (e.g., \"2023\"). Default: current year minus 2.",
    "type": "string"
   }
  },
  "required": [
   "series_id"
  ],
  "type": "object"
 },
 "name": "bls_get_series",
 "outputSchema": {
  "properties": {
   "series": {
    "description": "Array of time series data",
    "items": {
     "properties": {
      "count": {
       "description": "Number of data points for this series \u2014 BLS returns every point in the requested year range, so nothing is truncated.",
       "type": "number"
      },
      "data": {
       "description": "Time series data points",
       "items": {
        "properties": {
         "latest": {
          "description": "Whether this is the latest data point",
          "type": "boolean"
         },
         "period": {
          "description": "Period code (e.g., M01 for January)",
          "type": "string"
         },
         "period_name": {
          "description": "Human-readable period name (e.g., 'January')",
          "type": "string"
         },
         "value": {
          "description": "Data point value",
          "type": "string"
         },
         "year": {
          "description": "Year of the data point",
          "type": "string"
         }
        },
        "required": [
         "year",
         "period",
         "period_name",
         "value",
         "latest"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "observation_order": {
       "description": "Order of the `data` array. BLS returns each series newest-first.",
       "enum": [
        "newest_first"
       ],
       "type": "string"
      },
      "series_id": {
       "description": "BLS series identifier",
       "type": "string"
      }
     },
     "required": [
      "series_id",
      "data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "API response status (e.g., 'REQUEST_PROCESSED')",
    "type": "string"
   }
  },
  "required": [
   "status",
   "series"
  ],
  "type": "object"
 },
 "title": "Bls Get Series",

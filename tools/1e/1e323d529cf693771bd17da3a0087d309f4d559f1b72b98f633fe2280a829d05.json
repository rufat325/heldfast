{
 "_meta": {
  "ui": {
   "resourceUri": "ui://402-mcp/payment-confirmation.html"
  },
  "ui/resourceUri": "ui://402-mcp/payment-confirmation.html"
 },
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Preview payment requirements for a URL without spending any sats. Returns cost, protocol, and payment method so a confirmation dialog can be shown. Use this before l402-fetch to give the user a chance to approve or cancel payment. For widget hosts, the result drives a payment confirmation dialog.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "headers": {
    "additionalProperties": {
     "maxLength": 8000,
     "type": "string"
    },
    "description": "Additional request headers",
    "propertyNames": {
     "maxLength": 1000,
     "type": "string"
    },
    "type": "object"
   },
   "method": {
    "default": "GET",
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "DELETE",
     "PATCH",
     "HEAD",
     "OPTIONS"
    ],
    "type": "string"
   },
   "pubkey": {
    "description": "Nostr pubkey for xcashu auth",
    "maxLength": 128,
    "type": "string"
   },
   "url": {
    "description": "URL to preview payment requirements for",
    "format": "uri",
    "type": "string"
   },
   "urls": {
    "description": "Batch: multiple URLs to preview",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "l402-fetch-preview"
}

{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Update a card"
 },
 "description": "Update an existing card. Change the title, reassign, add a note, set a due date, or change status. Comments cannot be modified via this tool.",
 "inputSchema": {
  "properties": {
   "assignee": {
    "description": "Assignee email(s). Single string or array of strings.",
    "oneOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ]
   },
   "boardId": {
    "description": "Board the card belongs to",
    "type": "number"
   },
   "cardId": {
    "description": "The card ID to update",
    "type": "string"
   },
   "color": {
    "description": "Card color code",
    "type": "string"
   },
   "columnId": {
    "description": "Column the card is in (string column ID like 'Label_1')",
    "type": "string"
   },
   "dueDate": {
    "description": "Due date in ISO-8601 (e.g. 2026-05-20T00:00:00.000Z)",
    "type": "string"
   },
   "note": {
    "description": "New note body",
    "type": "string"
   },
   "status": {
    "description": "Card status",
    "enum": [
     "read",
     "unread",
     "OPEN",
     "PENDING",
     "CLOSED"
    ],
    "type": "string"
   },
   "title": {
    "description": "New card title",
    "type": "string"
   }
  },
  "required": [
   "cardId"
  ],
  "type": "object"
 },
 "name": "update_card",
 "title": "Update a card"
}

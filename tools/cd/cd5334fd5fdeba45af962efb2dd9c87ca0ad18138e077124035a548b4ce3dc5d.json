{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch minified + gzipped bundle size for each of up to 5 specified versions of an npm package and return them side-by-side for size regression tracking.",
 "inputSchema": {
  "examples": [
   {
    "package": "lodash",
    "versions": "4.17.20,4.17.21"
   },
   {
    "package": "typescript",
    "versions": "4.9.0,5.0.0,5.1.0,5.2.0,5.3.0"
   }
  ],
  "properties": {
   "package": {
    "type": "string"
   },
   "versions": {
    "description": "Comma-sep version list (max 5 to avoid timeouts)",
    "type": "string"
   }
  },
  "required": [
   "package",
   "versions"
  ],
  "type": "object"
 },
 "name": "history",
 "outputSchema": {
  "description": "Bundle size history across multiple versions",
  "properties": {
   "history": {
    "description": "Size data for each version",
    "items": {
     "properties": {
      "error": {
       "description": "Error message if fetch failed",
       "type": "string"
      },
      "size": {
       "description": "Bundle size data (if successful)",
       "type": "object"
      },
      "version": {
       "description": "Version number",
       "type": "string"
      }
     },
     "required": [
      "version"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "package": {
    "description": "Package name",
    "type": "string"
   }
  },
  "required": [
   "package",
   "history"
  ],
  "type": "object"
 },
 "title": "History",
 "version": "v1.3a0dfede"
}

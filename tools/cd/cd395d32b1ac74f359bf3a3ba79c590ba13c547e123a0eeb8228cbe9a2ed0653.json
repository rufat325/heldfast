{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Saved Search"
 },
 "description": "Update a saved search. Modify query, filters, alert cadence, name, or quality settings. Can only update your own saved searches.\n\nMODIFIABLE FIELDS: query, name, filters (same schema as save_search), cadence (weekly/daily/never), hidelow (quality filter), emailEnabled (on/off)\n\nTIP: Call list_saved_searches first to see the current settings, then update only the fields that need to change. The response confirms what was updated.\n\nDoes not count toward your monthly searches.",
 "inputSchema": {
  "properties": {
   "cadence": {
    "description": "New alert frequency. daily requires a paid plan (Plus or Pro); free includes weekly. never = turn email alerts off.",
    "enum": [
     "weekly",
     "daily",
     "never"
    ],
    "type": "string"
   },
   "emailEnabled": {
    "description": "Enable or disable email alerts without changing cadence.",
    "type": "boolean"
   },
   "filters": {
    "description": "New filters (same schema as save_search filters). Replaces all existing filters.",
    "properties": {
     "applicantTypes": {
      "description": "Eligible applicant types.",
      "items": {
       "enum": [
        "nonprofit",
        "government",
        "business",
        "tribal",
        "education"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "deadlineRange": {
      "description": "Deadline window.",
      "enum": [
       "next7days",
       "next30days",
       "next60days",
       "next90days",
       "noDeadline"
      ],
      "type": "string"
     },
     "geography": {
      "description": "US state codes (2-letter uppercase).",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "itemTypes": {
      "description": "Opportunity types.",
      "items": {
       "enum": [
        "grant",
        "procurement",
        "prize",
        "financial",
        "other"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "organization": {
      "description": "Agency/organization name.",
      "type": "string"
     },
     "sourceContext": {
      "description": "Source-specific filters (SAM.gov, Grants.gov). See save_search for details.",
      "type": "object"
     },
     "sourceTypes": {
      "description": "Funding source category.",
      "items": {
       "enum": [
        "federal",
        "state",
        "local",
        "foundation",
        "corporate"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "sources": {
      "description": "Specific data sources by slug.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "status": {
      "description": "Status filter.",
      "items": {
       "enum": [
        "open",
        "rolling",
        "coming_soon"
       ],
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "hidelow": {
    "description": "Hide low-confidence results in alerts.",
    "type": "boolean"
   },
   "id": {
    "description": "Saved search ID to update",
    "type": "number"
   },
   "name": {
    "description": "New friendly name",
    "type": "string"
   },
   "query": {
    "description": "New search query text",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_saved_search",
 "title": "Update Saved Search"
}

 "description": "Weekly USDA crop progress + condition by crop and state. For CONDITION queries (\"what % of corn is good or excellent\", \"crop condition this week\") the response includes a condition_summary with the latest national week's ratings AND the standard combined good_or_excellent_pct. For PROGRESS use stat_category=\"PROGRESS\" (planted/emerged/harvested %). Pass stat_category to narrow (otherwise both are returned).",
 "inputSchema": {
  "examples": [
   {
    "commodity": "CORN",
    "state": "IOWA",
    "year": "2026"
   },
   {
    "commodity": "SOYBEANS",
    "year": "2026"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "NASS API key",
    "type": "string"
   },
   "commodity": {
    "description": "Crop: \"CORN\", \"SOYBEANS\", \"WHEAT\", \"COTTON\", \"SORGHUM\"",
    "type": "string"
   },
   "stat_category": {
    "description": "Narrow to \"CONDITION\" (good/excellent ratings) or \"PROGRESS\" (planting/harvest %). Optional \u2014 omit for both.",
    "type": "string"
   },
   "state": {
    "description": "State name (optional, defaults to national)",
    "type": "string"
   },
   "year": {
    "description": "Year, e.g., \"2026\". Optional \u2014 defaults to current year.",
    "type": "string"
   }
  },
  "required": [

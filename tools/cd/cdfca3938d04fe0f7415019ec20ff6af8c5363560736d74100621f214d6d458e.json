{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Log time"
 },
 "description": "Log time spent on a task. minutes must be > 0 and \u2264 1440 (24 hours). Returns the created worklog entry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comment": {
    "description": "Optional note about the work done (max 2000 chars)",
    "type": "string"
   },
   "minutes": {
    "description": "Time spent in minutes (max 1440)",
    "exclusiveMinimum": 0,
    "maximum": 1440,
    "type": "integer"
   },
   "task_id": {
    "description": "Task UUID",
    "format": "uuid",
    "type": "string"
   },
   "worked_at": {
    "description": "ISO datetime when the work was done (defaults to now)",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "minutes"
  ],
  "type": "object"
 },
 "name": "add_task_worklog",
 "title": "Log time"
}

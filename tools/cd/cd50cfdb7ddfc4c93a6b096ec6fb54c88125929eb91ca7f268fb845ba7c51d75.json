{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get one current Topic with its recent context.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "topicId": {
    "description": "Topic ID from list_topics",
    "pattern": "^topic_[a-f\\d]{20}$",
    "type": "string"
   }
  },
  "required": [
   "topicId"
  ],
  "type": "object"
 },
 "name": "get_topic",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "authorCount": {
      "type": "number"
     },
     "clusters": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "cluster": {
         "additionalProperties": false,
         "properties": {
          "id": {
           "type": "string"
          },
          "name": {
           "type": "string"
          }
         },
         "required": [
          "id",
          "name"
         ],
         "type": "object"
        },
        "share": {
         "type": "number"
        }
       },
       "required": [
        "cluster",
        "share"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "lastSeenAt": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "postCount": {
      "type": "number"
     },
     "rank": {
      "type": "number"
     },
     "report": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "publishedAt": {
          "type": "string"
         },
         "revisedAt": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "title": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "title",
         "publishedAt",
         "revisedAt"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "stance": {
      "additionalProperties": false,
      "properties": {
       "buckets": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "dominant": {
           "enum": [
            "supportive",
            "skeptical",
            "neutral",
            "mixed",
            "unknown"
           ],
           "type": "string"
          },
          "from": {
           "type": "string"
          },
          "shares": {
           "additionalProperties": {
            "type": "number"
           },
           "propertyNames": {
            "type": "string"
           },
           "type": "object"
          },
          "to": {
           "type": "string"
          }
         },
         "required": [
          "from",
          "to",
          "dominant",
          "shares"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "buckets"
      ],
      "type": "object"
     },
     "summary": {
      "type": "string"
     },
     "trend": {
      "type": "number"
     }
    },
    "required": [
     "id",
     "rank",
     "name",
     "summary",
     "postCount",
     "authorCount",
     "lastSeenAt"
    ],
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "snapshot": {
      "additionalProperties": false,
      "properties": {
       "completedAt": {
        "type": "string"
       },
       "latestEvidenceAt": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "windowStartedAt": {
        "type": "string"
       }
      },
      "required": [
       "completedAt",
       "latestEvidenceAt",
       "windowStartedAt"
      ],
      "type": "object"
     },
     "versions": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "required": [
     "snapshot"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "Get topic details"
}

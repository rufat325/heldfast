       },
       "limit": {
        "type": "number"
       },
       "maxLimit": {
        "type": "number"
       },
       "offset": {
        "type": "number"
       },
       "returned": {
        "type": "number"
       },
       "total": {
        "type": "number"
       },
       "truncated": {
        "type": "boolean"
       }
      },
      "required": [

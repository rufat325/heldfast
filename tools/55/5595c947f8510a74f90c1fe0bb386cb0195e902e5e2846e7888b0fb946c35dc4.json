{
 "description": "Read App-owned historical task candidate facts and bounded evidence for one current task. The tool never ranks again or turns relationship facts into recommendations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": false,
    "description": "When true, previews the request without calling the app.",
    "type": "boolean"
   },
   "errorText": {
    "maxLength": 1000,
    "type": "string"
   },
   "limit": {
    "default": 8,
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "module": {
    "minLength": 1,
    "type": "string"
   },
   "paths": {
    "items": {
     "maxLength": 240,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "summary": {
    "maxLength": 500,
    "type": "string"
   },
   "taskId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId"
  ],
  "type": "object"
 },
 "name": "granoflow_historical_task_candidates"
}

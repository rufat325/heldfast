{
 "annotations": {
  "destructiveHint": true,
  "title": "Schedule Post"
 },
 "description": "Schedule a social media post via FlowContent Social Scheduler",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "Post content/text",
    "type": "string"
   },
   "image_url": {
    "description": "Image URL to attach",
    "type": "string"
   },
   "platforms": {
    "description": "Target platforms",
    "items": {
     "enum": [
      "facebook",
      "instagram",
      "linkedin",
      "twitter",
      "tiktok"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "scheduled_at": {
    "description": "ISO 8601 datetime for publishing",
    "type": "string"
   }
  },
  "required": [
   "content",
   "platforms",
   "scheduled_at"
  ],
  "type": "object"
 },
 "name": "schedule_post"
}

{
 "_meta": {
  "apiVersion": "1.7.0",
  "examples": [
   {
    "input": {
     "annotations": [
      {
       "color": "#ffe600",
       "contents": "Review this",
       "page": 0,
       "rect": [
        72,
        700,
        300,
        720
       ],
       "type": "highlight"
      }
     ],
     "pdfBase64": "<base64>"
    },
    "title": "Highlight a region on page 1"
   },
   {
    "input": {
     "annotations": [
      {
       "contents": "Check figures",
       "icon": "Note",
       "page": 0,
       "rect": [
        520,
        700,
        540,
        720
       ],
       "type": "text"
      },
      {
       "borderWidth": 2,
       "color": "#d00000",
       "page": 0,
       "rect": [
        72,
        500,
        300,
        560
       ],
       "type": "square"
      }
     ],
     "pdfBase64": "<base64>"
    },
    "title": "Sticky note + red square"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Append markup annotations (ISO 32000-1 \u00a712.5) to an existing PDF as a non-destructive incremental update (original bytes preserved). Types: text (sticky note), highlight | underline | strikeout | squiggly, square | circle, line (needs start/end), freetext. Each needs a 0-based `page` and `rect` [x1,y1,x2,y2]; optional contents, color, opacity, title and type-specific fields. VISUAL OVERLAY ONLY \u2014 nothing is removed or redacted (covered text stays extractable). Encrypted sources \u2192 ENCRYPTED_SOURCE (decrypt_pdf first).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "annotations": {
    "description": "Markup / drawing annotations to add. Each is attached to a 0-based page index.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "borderWidth": {
       "description": "type=square|circle|line: border width in points.",
       "minimum": 0,
       "type": "number"
      },
      "color": {
       "description": "Border / line / icon colour (/C).",
       "oneOf": [
        {
         "description": "Hex (e.g. \"#ffcc00\") or PDF operator string (\"R G B\", or \"C M Y K\" for DeviceCMYK), each operand 0.0\u20131.0.",
         "type": "string"
        },
        {
         "description": "RGB tuple, 0.0\u20131.0.",
         "items": {
          "type": "number"
         },
         "maxItems": 3,
         "minItems": 3,
         "type": "array"
        },
        {
         "description": "DeviceCMYK ink percentages [c, m, y, k], each 0\u2013100.",
         "items": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "maxItems": 4,
         "minItems": 4,
         "type": "array"
        }
       ]
      },
      "contents": {
       "description": "Text content / note body (/Contents).",
       "type": "string"
      },
      "end": {
       "description": "type='line': end point [x, y].",
       "items": {
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "fontSize": {
       "description": "type='freetext': default-appearance font size.",
       "minimum": 1,
       "type": "number"
      },
      "icon": {
       "description": "type='text': icon name (Note, Comment, Key, Help, Insert\u2026).",
       "type": "string"
      },
      "interiorColor": {
       "description": "type=square|circle: interior fill colour (/IC).",
       "oneOf": [
        {
         "description": "Hex (e.g. \"#ffcc00\") or PDF operator string (\"R G B\", or \"C M Y K\" for DeviceCMYK), each operand 0.0\u20131.0.",
         "type": "string"
        },
        {
         "description": "RGB tuple, 0.0\u20131.0.",
         "items": {
          "type": "number"
         },
         "maxItems": 3,
         "minItems": 3,
         "type": "array"
        },
        {
         "description": "DeviceCMYK ink percentages [c, m, y, k], each 0\u2013100.",
         "items": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "maxItems": 4,
         "minItems": 4,
         "type": "array"
        }
       ]
      },
      "opacity": {
       "description": "Constant opacity /CA in [0,1].",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "open": {
       "description": "type='text': whether the note pop-up starts open.",
       "type": "boolean"
      },
      "page": {
       "description": "0-based page index to attach the annotation to.",
       "minimum": 0,
       "type": "integer"
      },
      "quadPoints": {
       "description": "type=highlight|underline|strikeout|squiggly: 8 numbers per marked region.",
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "rect": {
       "description": "Annotation rectangle [x1, y1, x2, y2] in PDF user-space points.",
       "items": {
        "type": "number"
       },
       "maxItems": 4,
       "minItems": 4,
       "type": "array"
      },
      "start": {
       "description": "type='line': start point [x, y].",
       "items": {
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "title": {
       "description": "Author / title (/T).",
       "type": "string"
      },
      "type": {
       "enum": [
        "text",
        "highlight",
        "underline",
        "strikeout",
        "squiggly",
        "square",
        "circle",
        "line",
        "freetext"
       ],
       "type": "string"
      }
     },
     "required": [
      "page",
      "type",
      "rect"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "outputMode": {
    "default": "base64",
    "description": "'base64' (default) returns the PDF inline; 'file' writes it inside the PDFNATIVE_MCP_OUTPUT_DIR sandbox (SECURITY_VIOLATION when the sandbox is not configured).",
    "enum": [
     "base64",
     "file"
    ],
    "type": "string"
   },
   "outputPath": {
    "description": "Required when outputMode='file'. Relative path inside the sandbox; must end with .pdf (no absolute paths, no '..').",
    "type": "string"
   },
   "pdfBase64": {
    "description": "Base64-encoded source PDF to annotate.",
    "minLength": 4,
    "type": "string"
   }
  },
  "required": [
   "pdfBase64",
   "annotations"
  ],
  "type": "object"
 },
 "name": "annotate_pdf",
 "outputSchema": {
  "additionalProperties": false,
  "description": "Result of a PDF-producing tool. base64 mode: the PDF arrives as an embedded `resource` content block (not duplicated here); file mode: `filePath`.",
  "properties": {
   "diagnostics": {
    "description": "Engine diagnostics (when includeDiagnostics=true).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "warning"
       ],
       "type": "string"
      }
     },
     "required": [
      "code",
      "message",
      "severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "filePath": {
    "description": "Sandboxed absolute path (file mode).",
    "type": "string"
   },
   "mode": {
    "enum": [
     "base64",
     "file"
    ],
    "type": "string"
   },
   "sizeBytes": {
    "minimum": 0,
    "type": "integer"
   },
   "summary": {
    "additionalProperties": true,
    "description": "Tool-specific summary, when produced.",
    "type": "object"
   }
  },
  "required": [
   "mode",
   "sizeBytes"
  ],
  "type": "object"
 },
 "title": "Annotate PDF (markup / drawing)"
}

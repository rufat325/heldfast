{
 "description": "Identify species from an image and return Latin names with confidence",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "species category: plant|bug|bird|reptile|mollusc|mammal|fungi|amphibian",
    "minLength": 3,
    "type": "string"
   },
   "image_data": {
    "description": "base64 image to request",
    "minLength": 100,
    "type": "string"
   },
   "image_url": {
    "description": "image url to request",
    "minLength": 10,
    "type": "string"
   },
   "top_k": {
    "description": "top_k",
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "identify_species"
}

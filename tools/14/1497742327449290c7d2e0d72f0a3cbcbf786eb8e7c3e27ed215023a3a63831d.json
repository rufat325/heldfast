  "readOnlyHint": true,
  "title": "Forecast a time series"
 },
 "description": "Time-series forecast from a BigQuery table using Google's pretrained TimesFM model (AI.FORECAST), no model to train: point it at the table, timestamp column and value column and get forecast rows for the horizon you set. Input: table, timestamp_col, data_col, optional horizon and id_cols. $10.00 per call. Returns: table, timestamp_col, data_col, horizon, columns[], rows[], row_count, gib_processed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data_col": {
    "type": "string"
   },
   "horizon": {
    "description": "Periods to forecast, default 10.",
    "type": "integer"
   },
   "id_cols": {
    "description": "Optional: forecast multiple series at once.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "max_scan_gib": {
    "type": "number"
   },
   "table": {
    "description": "project.dataset.table",
    "type": "string"
   },
   "timestamp_col": {
    "type": "string"
   }
  },
  "required": [
   "table",
   "timestamp_col",
   "data_col"
  ],
  "type": "object"
 },
 "name": "hubvibe_data_forecast",
 "outputSchema": {

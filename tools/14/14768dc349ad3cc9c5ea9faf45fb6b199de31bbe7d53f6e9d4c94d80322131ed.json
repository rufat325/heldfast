 "annotations": {
  "cost": {
   "all": 1
  },
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Query any Denver ArcGIS layer by service path + layer id. Full ArcGIS query: where, out_fields, order_by, limit. Use denver_layers to find a service/layer, or denver_recent for the common ones. Epoch dates are converted to ISO.",
 "inputSchema": {
  "examples": [
   {
    "layer": 0,
    "limit": 100,
    "service": "crime",
    "where": "1=1"
   },
   {
    "layer": 324,
    "limit": 200,
    "order_by": "FIRST_OCCURRENCE_DATE DESC",
    "service": "ODC_CRIME_OFFENSES_P/FeatureServer",
    "where": "OFFENSE='ASSAULT'"
   }
  ],
  "properties": {
   "layer": {
    "description": "Layer id within the service (from denver_layers), e.g. 324.",
    "type": "number"
   },
   "limit": {
    "description": "Max rows (default 100, max 2000).",
    "type": "number"
   },
   "order_by": {
    "description": "Sort clause, e.g. \"FIRST_OCCURRENCE_DATE DESC\".",
    "type": "string"
   },
   "out_fields": {
    "description": "Comma-separated fields, or \"*\" (default).",
    "type": "string"
   },
   "service": {
    "description": "ArcGIS service path, e.g. \"ODC_CRIME_OFFENSES_P/FeatureServer\" (or a short name: crime).",
    "type": "string"
   },
   "where": {
    "description": "ArcGIS SQL where (default \"1=1\").",
    "type": "string"
   }
  },
  "required": [
   "service",
   "layer"
  ],
  "type": "object"
 },
 "name": "denver_query",
 "title": "Denver Query",
 "version": "v1.94b87437"
}

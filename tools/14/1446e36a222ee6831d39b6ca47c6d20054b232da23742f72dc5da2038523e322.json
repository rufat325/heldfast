{
 "description": "Request an AnalyticsBundle generation for a project analysis window and focus.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "analysisKind": {
    "enum": [
     "usage_summary",
     "route_health",
     "funnel_dropoff",
     "journey_friction",
     "feature_usage",
     "incident_impact",
     "deploy_comparison",
     "conversion_path"
    ],
    "type": "string"
   },
   "bearerToken": {
    "type": "string"
   },
   "deployId": {
    "type": "string"
   },
   "filters": {
    "additionalProperties": {},
    "type": "object"
   },
   "from": {
    "type": "string"
   },
   "funnel": {
    "type": "string"
   },
   "incidentId": {
    "type": "string"
   },
   "last": {
    "type": "string"
   },
   "opportunityId": {
    "format": "uuid",
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "route": {
    "type": "string"
   },
   "to": {
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "analysisKind"
  ],
  "type": "object"
 },
 "name": "generate_analytics_bundle"
}

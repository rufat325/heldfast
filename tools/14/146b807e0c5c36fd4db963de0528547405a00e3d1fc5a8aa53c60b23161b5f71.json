{
 "description": "\u30c6\u30b9\u30c8\u6761\u4ef6\u30fb\u30c6\u30b9\u30c8\u30b1\u30fc\u30b9\u306e\u6bcd\u96c6\u56e3\u3068\u3001\u305d\u308c\u306b\u5bfe\u3059\u308b\u9078\u629e(include/exclude)\u5224\u5b9a\u30fb\u524d\u30d0\u30fc\u30b8\u30e7\u30f3\u30b9\u30a4\u30fc\u30c8\u30fb\u524a\u9664\u7406\u7531\u304b\u3089\u3001\u30ea\u30b0\u30ec\u30c3\u30b7\u30e7\u30f3\u30b9\u30a4\u30fc\u30c8\u3068\u3057\u3066\u4f55\u3092\u6b8b\u3057\u4f55\u3092\u843d\u3068\u3057\u305f\u304b\u3092\u6c7a\u5b9a\u7684\u306b\u691c\u67fb\u3057\u3066Markdown\u3067\u8fd4\u3059\u3002\u9078\u629e\u30fb\u975e\u9078\u629e\u306e\u7406\u7531\u3001\u975e\u9078\u629e\u3068\u306a\u3063\u305f\u9ad8\u30ea\u30b9\u30af\u9805\u76ee\u306e\u5168\u4ef6\u5217\u6319\u3001\u9078\u629e\u3055\u308c\u305f\u30b1\u30fc\u30b9\u306e\u30c6\u30b9\u30c8\u30b5\u30a4\u30ba\u5206\u5e03\u3068\u63a8\u5b9a\u5b9f\u884c\u6642\u9593\u3001\u524d\u30d0\u30fc\u30b8\u30e7\u30f3\u3068\u306e\u8ffd\u52a0/\u524a\u9664/\u7dad\u6301\u306e\u5dee\u5206\u3068\u524a\u9664\u7406\u7531\u306e\u7a81\u304d\u5408\u308f\u305b\u3001\u5909\u66f4\u5dee\u5206\u533a\u5206(RA-CHANGE)\u3078\u306e\u672a\u7d10\u3065\u3051\u691c\u51fa\u3001\u5f71\u97ff\u7bc4\u56f2\u88ab\u8986\u7387(TTC-COV-18)\u306e\u5ba3\u8a00\u3068\u7b97\u51fa\u5024\u306e\u7167\u5408\u3092\u884c\u3046\u3002reexpand_threshold_changes \u306e\u5f71\u97ff\u5224\u5b9a\u5b9f\u4f53\uff08computedImpactVerdicts\uff09\u3092\u6e21\u3057\u305f\u5834\u5408\u306f\u3001\u5f71\u97ff\u3042\u308a\u3068\u7b97\u51fa\u3055\u308c\u305f\u6761\u4ef6\u304cexisting-unaffected \u3068\u7533\u544a\u3055\u308c\u3066\u3044\u306a\u3044\u304b\u3001\u5f71\u97ff\u3042\u308a\u3068\u7b97\u51fa\u3055\u308c\u305f\u30b1\u30fc\u30b9\u304c\u975e\u9078\u629e\u306b\u306a\u3063\u3066\u3044\u306a\u3044\u304b\u3001\u5f71\u97ff\u306a\u3057\u3068\u7b97\u51fa\u3055\u308c\u305f\u6761\u4ef6\u304c\u904e\u5927\u7533\u544a\u3055\u308c\u3066\u3044\u306a\u3044\u304b\u3092\u5b9f\u4f53\u7167\u5408\u3057\u3001\u88ab\u8986\u7387\u306e\u5206\u6bcd\u3092\u5b9f\u4f53\u5074\u3067\u88dc\u6b63\u3059\u308b\u3002\u672a\u6307\u5b9a\u306e\u5834\u5408\u3001\u88ab\u8986\u7387\u306fbasis: \"declared-only\"\uff08\u7533\u544a\u306e\u307f\uff09\u3068\u3057\u3066\u7b97\u51fa\u3059\u308b\u3002\u95be\u5024\u30fb\u30d1\u30e9\u30e1\u30fc\u30bf\u5909\u66f4\u306b\u4f34\u3046\u8a2d\u8a08\u81ea\u4f53\u306e\u518d\u5c55\u958b\u306freexpand_threshold_changes \u306e\u62c5\u5f53\u3067\u3042\u308a\u3001\u672c\u30c4\u30fc\u30eb\u306f\u5bfe\u8c61\u5916\u3002\u5224\u5b9a\u533a\u5206\u3068\u5bfe\u51e6\u6307\u91dd\u306f testdesign://regression-selection/analysis-criteria \u3092\u53c2\u7167\u3059\u308b\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "claimedImpactScopeCoveragePercent": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "completedTools": {
    "description": "Already executed tools; entries without evidence are treated as not executed",
    "items": {
     "properties": {
      "evidence": {
       "description": "Evidence of execution: an output file path (e.g. docs/test-cases.md) or an output heading line starting with '#'",
       "type": "string"
      },
      "outputExcerpt": {
       "description": "Excerpt of the declared tool's actual output text. Must contain that tool's own H1 heading line; otherwise the declaration is reported as evidence-unverified and still counted as not executed",
       "type": "string"
      },
      "toolName": {
       "description": "Name of an already executed tool in this workflow",
       "type": "string"
      }
     },
     "required": [
      "toolName",
      "evidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "computedImpactVerdicts": {
    "description": "reexpand_threshold_changes \u306e\u300e\u6210\u679c\u7269\u5225\u306e\u5f71\u97ff\u5224\u5b9a\u300f\u884c\u3092\u305d\u306e\u307e\u307e\u6e21\u3059\u3002changeCategory \u306e\u7533\u544a\u3068\u5b9f\u4f53\u3092\u7167\u5408\u3057(RSC-21/RSC-22/RSC-23)\u3001\u5f71\u97ff\u7bc4\u56f2\u88ab\u8986\u7387\u306e\u5206\u6bcd\u3092\u5b9f\u4f53\u5074\u3067\u88dc\u6b63\u3059\u308b\u3002\u672a\u6307\u5b9a\u6642\u306f\u88ab\u8986\u7387\u3092 basis=\"declared-only\" \u3068\u3057\u3066\u7b97\u51fa\u3057\u3001\u5b9f\u4f53\u7167\u5408\u3057\u3066\u3044\u306a\u3044\u65e8\u3092\u660e\u793a\u3059\u308b(RSC-25)\u3002",
    "items": {
     "properties": {
      "categoryIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ownerId": {
       "type": "string"
      },
      "ownerKind": {
       "enum": [
        "testCondition",
        "testCase"
       ],
       "type": "string"
      },
      "parameterNames": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "verdict": {
       "enum": [
        "\u8981\u4fee\u6b63",
        "\u8981\u518d\u78ba\u8a8d",
        "\u5f71\u97ff\u306a\u3057"
       ],
       "type": "string"
      }
     },
     "required": [
      "ownerKind",
      "ownerId",
      "verdict"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "executionTimeBudgetSeconds": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "highRiskMinScore": {
    "description": "Default: riskAnalysisFrame R1.minScore",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "maxItems": {
    "description": "Population size cap (default 2000)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "previousSuite": {
    "description": "Previous version suite composition, used to compute added/removed/kept diff",
    "properties": {
     "items": {
      "items": {
       "properties": {
        "itemId": {
         "type": "string"
        },
        "itemKind": {
         "enum": [
          "condition",
          "case"
         ],
         "type": "string"
        }
       },
       "required": [
        "itemKind",
        "itemId"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "suiteId": {
      "type": "string"
     }
    },
    "required": [
     "items"
    ],
    "type": "object"
   },
   "removalReasons": {
    "items": {
     "properties": {
      "approvedBy": {
       "type": "string"
      },
      "itemId": {
       "type": "string"
      },
      "itemKind": {
       "enum": [
        "condition",
        "case"
       ],
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "itemKind",
      "itemId",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "selectionCriteria": {
    "description": "Declared axes/criteria used to decide what to add or drop",
    "items": {
     "properties": {
      "axis": {
       "enum": [
        "risk",
        "test-size",
        "change-diff",
        "other"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "statement": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "statement"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "selections": {
    "description": "Selection decisions over the population; unlisted population items become undecided (RSC-05)",
    "items": {
     "properties": {
      "criterionIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "decision": {
       "enum": [
        "include",
        "exclude"
       ],
       "type": "string"
      },
      "itemId": {
       "type": "string"
      },
      "itemKind": {
       "enum": [
        "condition",
        "case"
       ],
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "itemKind",
      "itemId",
      "decision"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "suiteId": {
    "description": "Suite id used in headings and summary (default REG)",
    "type": "string"
   },
   "testBasisDocuments": {
    "description": "Test basis documents used to verify that declared labels (factor names, level values, state names, etc.), quoted wordings and referenced ids really exist in the test basis. Pass the full text: passing only excerpts makes existing wordings be reported as ungrounded. When omitted, the grounding check is reported as not inspectable instead of passing silently.",
    "items": {
     "properties": {
      "content": {
       "description": "Full text of the document (any format; caller converts binaries to text)",
       "type": "string"
      },
      "name": {
       "description": "Document name or file name of the test basis document",
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testCases": {
    "description": "Population of test cases the regression suite is selected from",
    "items": {
     "properties": {
      "caseId": {
       "type": "string"
      },
      "declaredTestSize": {
       "enum": [
        "small",
        "medium",
        "large"
       ],
       "type": "string"
      },
      "estimatedDurationSeconds": {
       "minimum": 0,
       "type": "number"
      },
      "externalDependencyIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "testConditionId": {
       "type": "string"
      },
      "testLevel": {
       "enum": [
        "component-testing",
        "integration-testing",
        "system-testing",
        "acceptance-testing"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "caseId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testConditions": {
    "description": "Population of test conditions the regression suite is selected from",
    "items": {
     "properties": {
      "changeCategory": {
       "enum": [
        "new",
        "modified",
        "existing-impacted",
        "existing-unaffected"
       ],
       "type": "string"
      },
      "containerId": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "impact": {
       "maximum": 5,
       "minimum": 1,
       "type": "integer"
      },
      "likelihood": {
       "maximum": 5,
       "minimum": 1,
       "type": "integer"
      },
      "perspectiveCategoryId": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "\u9ad8",
        "\u4e2d",
        "\u4f4e"
       ],
       "type": "string"
      },
      "statement": {
       "type": "string"
      },
      "target": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "testConditions"
  ],
  "type": "object"
 },
 "name": "select_regression_suite",
 "title": "Select Regression Suite"
}

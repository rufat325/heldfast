{
 "description": "Read raw bytes from a .class file as hex dump.",
 "inputSchema": {
  "properties": {
   "class_path": {
    "description": "Path to file",
    "type": "string"
   },
   "length": {
    "description": "Bytes to read (default 256)",
    "type": "number"
   },
   "offset": {
    "description": "Start offset (default 0)",
    "type": "number"
   },
   "session_id": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "class_path"
  ],
  "type": "object"
 },
 "name": "jar_hex_view"
}

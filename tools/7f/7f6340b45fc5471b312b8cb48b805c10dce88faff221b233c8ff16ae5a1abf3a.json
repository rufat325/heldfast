  "properties": {
   "business_name": {
    "description": "The business's name as it appears on its own signage/website.",
    "type": "string"
   },
   "category": {
    "description": "Category if known \u2014 narrows which map-pack searches are the right ones to check.",
    "type": "string"
   },
   "city_metro": {
    "description": "City + state/region, e.g. 'Aurora, CO'.",
    "type": "string"
   }
  },
  "required": [
   "business_name",
   "city_metro"
  ],
  "type": "object"
 },

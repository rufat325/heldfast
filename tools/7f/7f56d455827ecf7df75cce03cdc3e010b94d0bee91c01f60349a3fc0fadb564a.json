{
 "description": "Search emails by subject or sender. Uses IMAP SEARCH \u2014 works with any provider.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "folder": {
    "description": "Folder to search (default: INBOX)",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search term (matches subject and sender)",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "email_search"
}

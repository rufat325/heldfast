{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Call an allowed provider operation with a capability. Enforces scope, call/credit budget and billing before server-side credential injection. Writes require idempotency_key.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "operation",
     "input"
    ]
   },
   {
    "required": [
     "target"
    ]
   }
  ],
  "properties": {
   "body_json": {},
   "capability": {
    "description": "Scoped XGuard capability, never an upstream key.",
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "input": {
    "type": "object"
   },
   "method": {
    "enum": [
     "GET",
     "HEAD",
     "POST",
     "PUT",
     "PATCH",
     "DELETE"
    ],
    "type": "string"
   },
   "operation": {
    "enum": [
     "github.repository.read",
     "github.issue.create",
     "github.issue.comment",
     "github.pull_request.create",
     "cloudflare.zone.read",
     "cloudflare.worker.metadata",
     "slack.channel.read",
     "slack.message.send",
     "notion.page.read",
     "notion.database.read",
     "notion.page.create",
     "notion.page.update",
     "openai.response.create",
     "anthropic.message.create",
     "gemini.content.generate",
     "stripe.customer.read"
    ],
    "type": "string"
   },
   "target": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "capability"
  ],
  "type": "object"
 },
 "name": "xguard_secretless_call"
}

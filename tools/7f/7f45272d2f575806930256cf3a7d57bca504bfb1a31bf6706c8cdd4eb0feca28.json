{
 "description": "Identify tools that can be removed based on usage history. Scores: never_used > not_used_30_days > rarely_used. Returns removal candidates with estimated token savings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "usage_history": {
    "description": "Usage history for each tool",
    "items": {
     "additionalProperties": false,
     "properties": {
      "call_count": {
       "description": "Total number of times this tool has been called",
       "minimum": 0,
       "type": "integer"
      },
      "last_used_days_ago": {
       "description": "Days since last use (0 = today)",
       "minimum": 0,
       "type": "number"
      },
      "tool_name": {
       "description": "Tool name",
       "type": "string"
      }
     },
     "required": [
      "tool_name",
      "call_count",
      "last_used_days_ago"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "usage_history"
  ],
  "type": "object"
 },
 "name": "suggest_removals"
}

{
 "description": "Update an existing reusable checkout. Supply only the fields you want to change (Coinbase replaces the supplied fields). Use to retitle a product, change the price, or adjust which buyer fields are collected.",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "New checkout description",
    "type": "string"
   },
   "id": {
    "description": "Checkout id to update",
    "type": "string"
   },
   "local_price": {
    "description": "New fiat-denominated price",
    "properties": {
     "amount": {
      "description": "Amount as decimal string",
      "type": "string"
     },
     "currency": {
      "description": "ISO-4217 fiat currency code",
      "type": "string"
     }
    },
    "required": [
     "amount",
     "currency"
    ],
    "type": "object"
   },
   "name": {
    "description": "New checkout / product name",
    "type": "string"
   },
   "pricing_type": {
    "description": "Update pricing model",
    "enum": [
     "fixed_price",
     "no_price"
    ],
    "type": "string"
   },
   "requested_info": {
    "description": "New list of buyer fields to collect",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_checkout"
}

{
 "description": "Create an instance variable (then available in workflows as $vars.<key>).",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "Variable key (letters, numbers, underscores)",
    "minLength": 1,
    "type": "string"
   },
   "value": {
    "description": "Variable value (always stored as string)",
    "type": "string"
   }
  },
  "required": [
   "key",
   "value"
  ],
  "type": "object"
 },
 "name": "create_variable"
}

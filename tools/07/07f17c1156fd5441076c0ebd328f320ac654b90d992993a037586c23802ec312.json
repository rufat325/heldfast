 "description": "Find EPA-regulated facilities currently flagged with an identified violation, filterable by state and environmental program (CWA/CAA/RCRA/ALL). EPA ECHO has no server-side violation filter, so this scans up to 1,000 facilities for the state and returns the ones in violation \u2014 it is a sample, not an exhaustive statewide count. Returns facility IDs, names, addresses, and compliance status per program.",
 "inputSchema": {
  "examples": [
   {
    "program": "CWA",
    "state": "DE"
   },
   {
    "limit": 20,
    "state": "VT"
   }
  ],
  "properties": {
   "limit": {
    "description": "Max results to return (default 20, max 100).",
    "type": "number"
   },
   "program": {
    "description": "Program filter: \"CWA\", \"CAA\", \"RCRA\", or \"ALL\" (default \"ALL\").",
    "type": "string"
   },
   "state": {
    "description": "Two-letter state abbreviation (e.g., \"TX\").",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "echo_search_by_violation",

{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Pricing"
 },
 "description": "Look up a single seller's advertised price for one service. Use for point lookups (peerId + service); use list_providers to browse. Returns input/output USDC per million tokens with status INDEXED | PROVIDER_NOT_INDEXED | SERVICE_NOT_OFFERED | PRICE_NOT_PUBLISHED. Refreshed hourly from network.antseed.com.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "peerId": {
    "description": "Seller's on-chain address (0x + 40 hex chars)",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "service": {
    "description": "Service identifier (e.g. 'gpt-5.4', 'code-auditor')",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "peerId",
   "service"
  ],
  "type": "object"
 },
 "name": "get_pricing",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "availableServices": {
    "description": "Returned only on SERVICE_NOT_OFFERED",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "currency": {
    "enum": [
     "USDC"
    ],
    "type": "string"
   },
   "displayName": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputUsdPerMillion": {
    "type": [
     "number",
     "null"
    ]
   },
   "lastUpdated": {
    "description": "ISO timestamp of directory refresh",
    "type": [
     "string",
     "null"
    ]
   },
   "message": {
    "description": "Human-readable explanation of the status",
    "type": "string"
   },
   "outputUsdPerMillion": {
    "type": [
     "number",
     "null"
    ]
   },
   "peerId": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "region": {
    "type": [
     "string",
     "null"
    ]
   },
   "service": {
    "type": "string"
   },
   "status": {
    "enum": [
     "INDEXED",
     "PROVIDER_NOT_INDEXED",
     "SERVICE_NOT_OFFERED",
     "PRICE_NOT_PUBLISHED"
    ],
    "type": "string"
   }
  },
  "required": [
   "peerId",
   "service",
   "status",
   "currency",
   "inputUsdPerMillion",
   "outputUsdPerMillion"
  ],
  "type": "object"
 }
}

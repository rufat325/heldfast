{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search jokes by keyword or phrase. Returns matching jokes with categories, types, and content flags.",
 "inputSchema": {
  "examples": [
   {
    "amount": 10,
    "category": "Programming",
    "query": "programmer"
   },
   {
    "amount": 5,
    "query": "Christmas"
   }
  ],
  "properties": {
   "amount": {
    "description": "Number of jokes to return. Defaults to 5.",
    "type": "number"
   },
   "category": {
    "description": "Limit search to a category. One of: Any, Programming, Misc, Dark, Pun, Spooky, Christmas. Defaults to \"Any\".",
    "type": "string"
   },
   "query": {
    "description": "Keyword or phrase to search for within joke text.",
    "type": "string"
   },
   "safe_mode": {
    "description": "When true (the default), only return jokes JokeAPI flags as safe. Set false to include Dark and other unsafe-flagged categories.",
    "type": "boolean"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_jokes",
 "outputSchema": {
  "properties": {
   "category": {
    "description": "Category searched",
    "type": "string"
   },
   "jokes": {
    "description": "Array of matching jokes",
    "items": {
     "properties": {
      "category": {
       "description": "Joke category",
       "type": "string"
      },
      "delivery": {
       "description": "Punchline for two-part jokes",
       "type": "string"
      },
      "joke": {
       "description": "Full joke text for single-part jokes",
       "type": "string"
      },
      "safe": {
       "description": "Whether joke is flagged as safe",
       "type": "boolean"
      },
      "setup": {
       "description": "Setup text for two-part jokes",
       "type": "string"
      },
      "type": {
       "description": "Joke type",
       "enum": [
        "single",
        "twopart"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "category",
      "safe"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "Search query used",
    "type": "string"
   },
   "total": {
    "description": "Total number of matching jokes",
    "type": "number"
   }
  },
  "required": [
   "total",
   "query",
   "category",
   "jokes"
  ],
  "type": "object"
 },
 "title": "Search Jokes",
 "version": "v1.ba1f400c"
}

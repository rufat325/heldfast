{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "YNAB: Export Transactions"
 },
 "description": "Export all transactions for a budget to a local JSON file.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - account_id (string, optional): Filter by account.\n  - since_date (string, optional): ISO date (YYYY-MM-DD) to filter transactions on or after.\n\nReturns: file_path, transaction_count, file_size_kb\n\nExamples:\n  - Export all transactions: call with no args\n  - Export account: set account_id\n\nErrors:\n  - \"No default budget set\" \u2192 run ynab_set_default_budget first",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "type": "string"
   },
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "category_id": {
    "type": "string"
   },
   "filename": {
    "type": "string"
   },
   "minimal": {
    "default": true,
    "type": "boolean"
   },
   "since_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "type": {
    "enum": [
     "uncategorized",
     "unapproved"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ynab_export_transactions",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "export_directory": {
    "type": "string"
   },
   "export_mode": {
    "enum": [
     "minimal",
     "full"
    ],
    "type": "string"
   },
   "filename": {
    "type": "string"
   },
   "filename_explanation": {
    "type": "string"
   },
   "full_path": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "minimal_fields": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "preview_count": {
    "type": "number"
   },
   "preview_transactions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "type": "number"
      },
      "category_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "date": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "memo": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "payee_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "date",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_count": {
    "type": "number"
   }
  },
  "required": [
   "message",
   "filename",
   "full_path",
   "export_directory",
   "export_mode",
   "minimal_fields",
   "filename_explanation",
   "preview_count",
   "total_count",
   "preview_transactions"
  ],
  "type": "object"
 }
}

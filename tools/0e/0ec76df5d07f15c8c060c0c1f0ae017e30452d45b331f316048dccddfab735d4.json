{
 "description": "Get the filesystem path to an app's container (bundle, data, or shared groups). Use this to find where the app stores its files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundleId": {
    "description": "App bundle identifier",
    "type": "string"
   },
   "containerType": {
    "description": "Container type (default: data)",
    "enum": [
     "app",
     "data",
     "groups"
    ],
    "type": "string"
   },
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   }
  },
  "required": [
   "bundleId"
  ],
  "type": "object"
 },
 "name": "simulator_get_app_container"
}

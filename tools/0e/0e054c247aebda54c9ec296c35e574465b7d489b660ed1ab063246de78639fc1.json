{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Place a limit order on Polymarket",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "neg_risk": {
    "description": "Whether this is a negative risk market",
    "type": "boolean"
   },
   "order_type": {
    "description": "Order type: Good-Til-Cancelled, Good-Til-Date, Fill-Or-Kill",
    "enum": [
     "GTC",
     "GTD",
     "FOK"
    ],
    "type": "string"
   },
   "price": {
    "description": "Limit price between 0.01 and 0.99",
    "maximum": 0.99,
    "minimum": 0.01,
    "type": "number"
   },
   "side": {
    "description": "Order side: buy or sell",
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "size": {
    "description": "Order size in USDC units",
    "minimum": 1,
    "type": "number"
   },
   "tick_size": {
    "description": "Minimum price increment (e.g. 0.01, 0.001)",
    "type": "string"
   },
   "token_id": {
    "description": "Polymarket CLOB token ID to trade",
    "type": "string"
   }
  },
  "required": [
   "token_id",
   "price",
   "side",
   "size"
  ],
  "type": "object"
 },
 "name": "polymarket.trading.place_order",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "description": "Present only when the call failed. Includes error code, message, request_id, and any provider-specific extras."
   },
   "result": {
    "description": "Tool response payload. Shape varies per tool \u2014 consult the tool description and inputSchema. May be an object, array, string, or number depending on the upstream provider response."
   }
  },
  "type": "object"
 },
 "title": "Place Order"
}

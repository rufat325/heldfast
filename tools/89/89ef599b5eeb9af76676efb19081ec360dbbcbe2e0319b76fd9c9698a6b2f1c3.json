{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List all RRSets in a DNS zone, with optional filtering by name, type, or labels.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id_or_name": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^[^/\\s]+$",
      "type": "string"
     }
    ],
    "description": "Zone ID or name"
   },
   "label_selector": {
    "description": "Label filter, e.g. \"env=prod,tier=web\"",
    "type": "string"
   },
   "name": {
    "description": "Filter by name",
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Results per page (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Sort field, e.g. \"id:asc\" or \"name:desc\"",
    "type": "string"
   },
   "type": {
    "description": "Filter by one or more record types",
    "items": {
     "description": "DNS record type (A, AAAA, CNAME, MX, NS, TXT, etc.)",
     "enum": [
      "A",
      "AAAA",
      "CAA",
      "CNAME",
      "DS",
      "HINFO",
      "HTTPS",
      "MX",
      "NS",
      "PTR",
      "RP",
      "SOA",
      "SRV",
      "SVCB",
      "TLSA",
      "TXT"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id_or_name"
  ],
  "type": "object"
 },
 "name": "hetzner_list_zone_rrsets",
 "title": "List DNS Zone RRSets"
}

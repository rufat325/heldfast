{
 "description": "Establece una variable en un entorno. Si no se especifica entorno, usa el activo.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "environment": {
    "description": "Entorno destino (default: entorno activo)",
    "type": "string"
   },
   "key": {
    "description": "Nombre de la variable",
    "type": "string"
   },
   "value": {
    "description": "Valor de la variable",
    "type": "string"
   }
  },
  "required": [
   "key",
   "value"
  ],
  "type": "object"
 },
 "name": "env_set"
}

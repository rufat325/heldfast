{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true,
  "title": "List known issues on a project"
 },
 "description": "Read the known issues recorded on a project \u2014 blockers found in external systems, their severity, status and the tasks fixing them. Read this before you start work so you do not re-discover or duplicate a known problem.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "client": {
    "type": "string"
   },
   "client_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "project": {
    "description": "Name or @handle of the project. Fuzzy-resolved.",
    "type": "string"
   },
   "project_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "status": {
    "description": "Defaults to open + in_progress.",
    "enum": [
     "open",
     "in_progress",
     "resolved",
     "wont_fix",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_project_issues",
 "title": "List known issues on a project"
}

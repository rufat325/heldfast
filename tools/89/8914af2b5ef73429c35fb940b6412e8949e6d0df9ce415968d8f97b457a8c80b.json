{
 "description": "Generate a static PIX QR code for receiving payments",
 "inputSchema": {
  "properties": {
   "addressKey": {
    "description": "Pix key to receive payment",
    "type": "string"
   },
   "allowsMultiplePayments": {
    "description": "Whether multiple payments are allowed",
    "type": "boolean"
   },
   "description": {
    "description": "QR code description",
    "type": "string"
   },
   "expirationDate": {
    "description": "Expiration date (YYYY-MM-DD)",
    "type": "string"
   },
   "expirationSeconds": {
    "description": "Expiration in seconds",
    "type": "number"
   },
   "format": {
    "description": "Response format",
    "enum": [
     "ALL",
     "IMAGE",
     "PAYLOAD"
    ],
    "type": "string"
   },
   "value": {
    "description": "Fixed amount (omit for open value)",
    "type": "number"
   }
  },
  "required": [
   "addressKey"
  ],
  "type": "object"
 },
 "name": "create_pix_qrcode"
}

{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Formats files with Biome (format --write) and returns a structured list of changed files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "changed": {
    "description": "Only format VCS-changed files (maps to --changed)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "configPath": {
    "description": "Path to Biome configuration file (maps to --config-path)",
    "maxLength": 4096,
    "type": "string"
   },
   "indentStyle": {
    "description": "Indent style override (tab or space)",
    "enum": [
     "tab",
     "space"
    ],
    "type": "string"
   },
   "lineEnding": {
    "description": "Line ending style",
    "enum": [
     "lf",
     "crlf",
     "cr"
    ],
    "type": "string"
   },
   "lineWidth": {
    "description": "Line width override",
    "type": "number"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "."
    ],
    "description": "File patterns to format (default: ['.'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "quoteStyle": {
    "description": "Quote style override (single or double)",
    "enum": [
     "single",
     "double"
    ],
    "type": "string"
   },
   "semicolons": {
    "description": "Semicolon style (always or asNeeded)",
    "enum": [
     "always",
     "asNeeded"
    ],
    "type": "string"
   },
   "since": {
    "description": "Only format files changed since this git ref (maps to --since)",
    "maxLength": 65536,
    "type": "string"
   },
   "staged": {
    "description": "Only format staged files (maps to --staged)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "biome-format",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "errorMessage": {
    "type": "string"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filesChanged": {
    "type": "number"
   },
   "filesTruncated": {
    "type": "boolean"
   },
   "filesUnchanged": {
    "type": "number"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "filesChanged",
   "success"
  ],
  "type": "object"
 },
 "title": "Biome Format"
}

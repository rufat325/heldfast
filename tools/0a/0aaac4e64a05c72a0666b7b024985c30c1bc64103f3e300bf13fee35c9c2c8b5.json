{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Cast a ray from camera through screen coordinates and return hit objects",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "maxHits": {
    "description": "Maximum hits to return (default: 10)",
    "type": "number"
   },
   "x": {
    "description": "Normalized device X coordinate (-1 to 1, 0 = center)",
    "type": "number"
   },
   "y": {
    "description": "Normalized device Y coordinate (-1 to 1, 0 = center)",
    "type": "number"
   }
  },
  "required": [
   "x",
   "y"
  ],
  "type": "object"
 },
 "name": "raycast"
}

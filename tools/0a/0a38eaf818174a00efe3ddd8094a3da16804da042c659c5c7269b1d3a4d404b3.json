{
 "description": "Get metadata for a specific public URBIS WMS layer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "layerName": {
    "description": "Exact WMS layer name",
    "type": "string"
   },
   "service": {
    "description": "Which public URBIS WMS service to inspect",
    "enum": [
     "vector",
     "raster"
    ],
    "type": "string"
   }
  },
  "required": [
   "service",
   "layerName"
  ],
  "type": "object"
 },
 "name": "urbis_get_layer"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new network with the specified IP range, and optionally subnets and routes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ip_range": {
    "description": "IP range of the whole network, e.g. \"10.0.0.0/8\"",
    "type": "string"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Labels as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Name of the network",
    "type": "string"
   },
   "routes": {
    "description": "Array of routes to create",
    "items": {
     "properties": {
      "destination": {
       "description": "Destination network of the route",
       "type": "string"
      },
      "gateway": {
       "description": "Gateway for the route",
       "type": "string"
      }
     },
     "required": [
      "destination",
      "gateway"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "subnets": {
    "description": "Array of subnets to create",
    "items": {
     "properties": {
      "ip_range": {
       "description": "IP range of the subnet",
       "type": "string"
      },
      "network_zone": {
       "description": "Name of the network zone, e.g. \"eu-central\"",
       "type": "string"
      },
      "type": {
       "description": "Type of subnet: cloud, server, or vswitch",
       "type": "string"
      },
      "vswitch_id": {
       "description": "ID of the vSwitch (for vswitch type)",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "type",
      "ip_range",
      "network_zone"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "ip_range"
  ],
  "type": "object"
 },
 "name": "hetzner_create_network",
 "title": "Create Network"
}

{
 "description": "Trigger a workflow run via workflow_dispatch. Requires a workflow with workflow_dispatch enabled.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "inputs": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Optional workflow inputs as key-value pairs",
    "type": "object"
   },
   "owner": {
    "description": "Repository owner (username or org)",
    "type": "string"
   },
   "ref": {
    "default": "main",
    "description": "Branch or tag to run on (default: main)",
    "type": "string"
   },
   "repo": {
    "description": "Repository name",
    "type": "string"
   },
   "workflow_id": {
    "description": "Workflow ID or filename (e.g. ci.yml)",
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo",
   "workflow_id"
  ],
  "type": "object"
 },
 "name": "trigger_workflow"
}

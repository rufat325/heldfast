{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Assign a task to another managed identity. The server creates a stamped email thread and wakes that identity's agent route. Typed approval actions are JSON-only, at most 65,536 canonical UTF-8 bytes and depth 10, with expiry at most 30 days from the server clock; approval_action_too_large, approval_action_too_deep, and approval_expiry_too_far are stable client errors. With wait=true it waits up to MCP_MAX_WAIT_SECONDS for completed or failed; call task_get again for longer work.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "approval": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "additionalProperties": false,
      "properties": {
       "arguments": {},
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "type": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "type",
       "name",
       "arguments"
      ],
      "type": "object"
     },
     "expiresAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     }
    },
    "required": [
     "action",
     "expiresAt"
    ],
    "type": "object"
   },
   "body": {
    "description": "Task instructions in plain text",
    "maxLength": 1000000,
    "type": "string"
   },
   "kind": {
    "const": "approval",
    "description": "Use approval with the typed action and expiry below.",
    "type": "string"
   },
   "parentTaskId": {
    "description": "Optional authenticated durable parent task UUID.",
    "type": "string"
   },
   "subject": {
    "description": "Task subject",
    "maxLength": 998,
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "description": "Managed recipient identity address",
    "maxLength": 320,
    "pattern": "^[a-z0-9][a-z0-9._-]{0,62}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.?$",
    "type": "string"
   },
   "wait": {
    "description": "Wait up to MCP_MAX_WAIT_SECONDS for completed or failed (default false; schema legacy max 600)",
    "type": "boolean"
   }
  },
  "required": [
   "to",
   "subject"
  ],
  "type": "object"
 },
 "name": "task_create",

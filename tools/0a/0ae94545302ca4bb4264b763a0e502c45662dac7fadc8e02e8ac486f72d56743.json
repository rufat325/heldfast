{
 "description": "Create a blog article",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blogId": {
    "description": "The blog ID",
    "type": "string"
   },
   "content": {
    "type": "string"
   },
   "image": {
    "additionalProperties": false,
    "properties": {
     "altText": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "type": "object"
   },
   "published": {
    "default": true,
    "type": "boolean"
   },
   "publishedAt": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "blogId",
   "title",
   "content"
  ],
  "type": "object"
 },
 "name": "createArticle"
}

{
 "description": "Validate email addresses with the documented /email-validator endpoint.\n\nBest for:\n- deliverability checks\n- validating outbound lead lists\n- filtering invalid email inputs before enrichment or outreach",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "async": {
    "description": "Deprecated compatibility flag. Prefer execution_mode.",
    "type": "boolean"
   },
   "execution_mode": {
    "description": "Execution strategy. Use auto to let the MCP server choose between sync and async.",
    "enum": [
     "auto",
     "sync",
     "async"
    ],
    "type": "string"
   },
   "query": {
    "description": "One or more email addresses to validate.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "webhook": {
    "description": "Optional webhook URL for async completion.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "emails_validator",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "async": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "is_async_submission": {
      "type": "boolean"
     },
     "next_step": {
      "type": "string"
     },
     "results_location": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "is_async_submission"
    ],
    "type": "object"
   },
   "data": {},
   "meta": {
    "additionalProperties": false,
    "properties": {
     "operation": {
      "type": "string"
     },
     "service": {
      "type": "string"
     }
    },
    "required": [
     "service",
     "operation"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "Emails Validator"
}

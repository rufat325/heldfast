{
 "annotations": {
  "destructiveHint": true,
  "title": "Publish to Medium"
 },
 "description": "Publish an article to Medium (as draft or public). Costs credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "Article content (HTML or markdown)",
    "type": "string"
   },
   "publish_status": {
    "description": "Publication status (default: draft)",
    "enum": [
     "draft",
     "public"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Medium tags (max 5)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Article title",
    "type": "string"
   }
  },
  "required": [
   "title",
   "content"
  ],
  "type": "object"
 },
 "name": "publish_to_medium"
}

{
 "description": "Finish a node-less compatibility task after its required Delivery gate and verify status=done. For AI execution, keep the task pending until this completion action and supply the captured actual startedAt plus confirmed endedAt. Do not use for node-backed tasks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "completionSource": {
    "description": "When ai or human, attach the matching AI/\u4eba\u5de5 source tag after ensuring it exists. Omit or unknown means no source tag.",
    "enum": [
     "ai",
     "human",
     "unknown"
    ],
    "type": "string"
   },
   "confirmComplete": {
    "default": false,
    "type": "boolean"
   },
   "descriptionImpactReview": {
    "additionalProperties": false,
    "properties": {
     "authoringEvidence": {
      "additionalProperties": {},
      "description": "Required for AI or automation task creation: declare an action/outcome title, plain-language review, and exact analogy/example excerpts from the description.",
      "type": "object"
     },
     "decision": {
      "enum": [
       "unchanged",
       "rewrite"
      ],
      "type": "string"
     },
     "fiveDimensionsReviewed": {
      "type": "boolean"
     },
     "rationale": {
      "minLength": 1,
      "type": "string"
     },
     "reasonCode": {
      "enum": [
       "operational_only",
       "review_only",
       "completion_only",
       "completion_summary_only",
       "historical_time_only",
       "node_completion_only",
       "placement_reviewed_no_semantic_change",
       "title_clarification_no_semantic_change",
       "semantic_change",
       "description_correction",
       "post_completion_revision"
      ],
      "type": "string"
     },
     "reviewedDescriptionSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "reviewedTaskUpdatedAt": {
      "minLength": 1,
      "type": "string"
     },
     "writebackRefs": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "reviewedTaskUpdatedAt",
     "reviewedDescriptionSha256",
     "decision",
     "reasonCode",
     "rationale"
    ],
    "type": "object"
   },
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "endedAt": {
    "type": "string"
   },
   "milestoneId": {
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "reviewCardDrafts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "back": {
       "description": "Back of the review card.",
       "minLength": 1,
       "type": "string"
      },
      "backLayout": {
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      },
      "cardType": {
       "default": "basic_qa",
       "enum": [
        "basic_qa",
        "reverse_qa",
        "keyword_cloze"
       ],
       "type": "string"
      },
      "clientCardId": {
       "description": "Stable caller-generated id for this draft, unique within the finish request.",
       "minLength": 1,
       "type": "string"
      },
      "front": {
       "description": "Front of the review card.",
       "minLength": 1,
       "type": "string"
      },
      "frontLayout": {
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      },
      "noteFields": {
       "description": "Optional structured note fields. Check /v1/ai-agent/tools capability first.",
       "items": {
        "additionalProperties": false,
        "properties": {
         "key": {
          "description": "Stable note field key such as phonetic or pronunciation.",
          "minLength": 1,
          "type": "string"
         },
         "label": {
          "description": "Human-readable note field label.",
          "minLength": 1,
          "type": "string"
         },
         "ttsLanguageCode": {
          "description": "Optional BCP-47 language code for text_to_speech fields, such as en-US.",
          "minLength": 1,
          "type": "string"
         },
         "type": {
          "enum": [
           "text",
           "text_to_speech"
          ],
          "type": "string"
         },
         "value": {
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "key",
         "label",
         "type",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "sourceSummary": {
       "description": "Short source note tying this card to the completed task.",
       "type": "string"
      }
     },
     "required": [
      "clientCardId",
      "front",
      "back"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "startedAt": {
    "description": "Actual execution start time captured while AI execution remains pending.",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "taskId": {
    "description": "Granoflow task id.",
    "minLength": 1,
    "type": "string"
   },
   "taskReview": {
    "type": "string"
   }
  },
  "required": [
   "taskId",
   "descriptionImpactReview"
  ],
  "type": "object"
 },
 "name": "granoflow_task_finish"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an outbound webhook subscription. Returns subscription metadata and the displayed signing secret (whs_...). Deny-by-default for OAuth tokens.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "Identity email address to receive events for",
    "pattern": "^[a-z0-9][a-z0-9._-]{0,62}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.?$",
    "type": "string"
   },
   "contentScope": {
    "description": "Payload content scope: 'metadata' (default) or 'preview' (admin only)",
    "enum": [
     "metadata",
     "preview"
    ],
    "type": "string"
   },
   "description": {
    "description": "Optional human-readable description (max 1000 characters)",
    "maxLength": 1000,
    "type": "string"
   },
   "events": {
    "description": "Events to subscribe to ('mail.received', 'approval.requested')",
    "items": {
     "enum": [
      "mail.received",
      "approval.requested"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "url": {
    "description": "Webhook target URL (https:// required unless private target granted)",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "url",
   "address",
   "events"
  ],
  "type": "object"
 },
 "name": "mail_webhook_create",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "contentScope": {
    "type": "string"
   },
   "createdAt": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "events": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "type": "string"
   },
   "secret": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "secretPrefix": {
    "type": "string"
   },
   "signatureScheme": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "timestampToleranceSec": {
    "type": "number"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "url",
   "address",
   "events",
   "state"
  ],
  "type": "object"
 },
 "title": "Create Webhook Subscription"
}

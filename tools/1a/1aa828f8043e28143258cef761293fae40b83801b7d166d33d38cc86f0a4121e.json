{
 "description": "List orders from the Shopify store",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "type": "string"
   },
   "financialStatus": {
    "enum": [
     "paid",
     "pending",
     "refunded",
     "partially_refunded",
     "any"
    ],
    "type": "string"
   },
   "fulfillmentStatus": {
    "enum": [
     "shipped",
     "partial",
     "unshipped",
     "any"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "type": "number"
   },
   "query": {
    "type": "string"
   },
   "status": {
    "enum": [
     "open",
     "closed",
     "cancelled",
     "any"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "listOrders"
}

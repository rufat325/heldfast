{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit one final output containing a canonical LAVIYA_RESULT. Laviya validates, evaluates, and routes the result server-side.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "payload": {
    "additionalProperties": false,
    "properties": {
     "agentType": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "agentVersion": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "aiAgentFlowRunID": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "aiAgentTaskExecutionID": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "finalOutput": {
      "maxLength": 10485760,
      "minLength": 1,
      "type": "string"
     },
     "requestKey": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "taskID": {
      "exclusiveMinimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "taskID",
     "aiAgentFlowRunID",
     "aiAgentTaskExecutionID",
     "finalOutput"
    ],
    "type": "object"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "laviya_complete_execution",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {},
   "result": {}
  },
  "type": "object"
 },
 "title": "Complete Execution"
}

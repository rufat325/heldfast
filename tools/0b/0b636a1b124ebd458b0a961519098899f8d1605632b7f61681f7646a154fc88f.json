{
 "description": "Generate complete BepInEx 5 plugin template with Harmony patching.",
 "inputSchema": {
  "properties": {
   "author": {
    "description": "Author name",
    "type": "string"
   },
   "description": {
    "description": "Plugin description",
    "type": "string"
   },
   "include_config": {
    "description": "Include config system",
    "type": "boolean"
   },
   "include_harmony": {
    "description": "Include Harmony setup",
    "type": "boolean"
   },
   "managed_directory": {
    "description": "Path to game Managed directory",
    "type": "string"
   },
   "plugin_guid": {
    "description": "Plugin GUID (e.g. com.author.pluginname)",
    "type": "string"
   },
   "plugin_name": {
    "description": "Plugin class name",
    "type": "string"
   },
   "version": {
    "description": "Version string (default 1.0.0)",
    "type": "string"
   }
  },
  "required": [
   "plugin_name",
   "plugin_guid"
  ],
  "type": "object"
 },
 "name": "generate_plugin"
}

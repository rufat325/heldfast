{
 "description": "Full context window health check combining audit, removal suggestions, and compression recommendations. Returns an executive summary with health grade and projected savings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "tools": {
    "description": "Array of tool definitions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "description": "Tool description",
       "type": "string"
      },
      "name": {
       "description": "Tool name",
       "type": "string"
      },
      "schema": {
       "additionalProperties": {},
       "description": "Tool input schema",
       "type": "object"
      }
     },
     "required": [
      "name",
      "description",
      "schema"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "usage_history": {
    "description": "Optional usage history for removal analysis",
    "items": {
     "additionalProperties": false,
     "properties": {
      "call_count": {
       "description": "Total call count",
       "minimum": 0,
       "type": "integer"
      },
      "last_used_days_ago": {
       "description": "Days since last use",
       "minimum": 0,
       "type": "number"
      },
      "tool_name": {
       "description": "Tool name",
       "type": "string"
      }
     },
     "required": [
      "tool_name",
      "call_count",
      "last_used_days_ago"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tools"
  ],
  "type": "object"
 },
 "name": "get_optimization_report"
}

{
 "description": "Get a LinkedIn member's posts. Paginate with next_cursor/has_more. 10 credits/page.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "next_cursor from previous response.",
    "type": "string"
   },
   "type": {
    "description": "'posts' (default), 'comments', or 'reactions'.",
    "enum": [
     "posts",
     "comments",
     "reactions"
    ],
    "type": "string"
   },
   "url": {
    "description": "Profile URL (alternative to username).",
    "format": "uri",
    "type": "string"
   },
   "username": {
    "description": "Vanity handle, e.g. 'williamhgates'.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_linkedin_person_posts"
}

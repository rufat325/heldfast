{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve a published, sourced provider comparison. Provider aliases and reversed ordering resolve to the one canonical comparison. Optional coverage (for example \"cyber\", \"D&O\" or \"workers comp\") returns the coverage-line comparison for that pair when one is published; the response lists every available line comparison for the pair. Optional need runs a bounded editorial judgment over that page only; it does not invent a ranking or a purchase recommendation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "coverage": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "need": {
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   },
   "providerA": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "providerB": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "providerA",
   "providerB"
  ],
  "type": "object"
 },
 "name": "compare_providers",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "comparison": {
    "additionalProperties": false,
    "properties": {
     "canonicalUrl": {
      "format": "uri",
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "markdown": {
      "type": "string"
     },
     "pageType": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "path",
     "title",
     "description",
     "canonicalUrl",
     "pageType",
     "markdown",
     "truncated"
    ],
    "type": "object"
   },
   "coverage": {
    "additionalProperties": false,
    "properties": {
     "found": {
      "type": "boolean"
     },
     "key": {
      "type": "string"
     }
    },
    "required": [
     "key",
     "found"
    ],
    "type": "object"
   },
   "found": {
    "type": "boolean"
   },
   "judgment": {
    "additionalProperties": false,
    "properties": {
     "addressesNeed": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "limitation": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "outcome": {
      "type": "string"
     },
     "qualification": {
      "type": "string"
     },
     "reason": {
      "enum": [
       "unsupported_request",
       "inference_unavailable",
       "quota_unavailable",
       "generation_failed",
       "generation_timeout",
       "invalid_judgment",
       "client_rate_limit",
       "daily_generation_limit"
      ],
      "type": "string"
     },
     "status": {
      "enum": [
       "judged",
       "unsupported",
       "limited",
       "unavailable"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "qualification"
    ],
    "type": "object"
   },
   "lineComparisons": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "coverage": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "coverage",
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "providers": {
    "items": {
     "type": "string"
    },
    "maxItems": 2,
    "type": "array"
   },
   "spotCallout": {
    "type": "string"
   }
  },
  "required": [
   "spotCallout",
   "found",
   "providers"
  ],
  "type": "object"
 },
 "title": "Compare published insurance providers"
}

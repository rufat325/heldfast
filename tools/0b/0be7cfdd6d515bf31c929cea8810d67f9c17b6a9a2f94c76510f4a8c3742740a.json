{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Start scrcpy Session"
 },
 "description": "Start a scrcpy session for fast input control and screenshots. When a session is active, tap/swipe/text/screenshot are 10-50x faster. Requires scrcpy-server to be installed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxFps": {
    "default": 30,
    "description": "Max frames per second (default 30)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "maxSize": {
    "default": 1024,
    "description": "Max screen dimension in pixels (default 1024)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "start_session",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Human-readable status message",
    "type": "string"
   },
   "screenSize": {
    "additionalProperties": false,
    "description": "Native display resolution \u2014 tap/swipe use these native coordinates, matching ui_dump / ui_find_element bounds directly (no scaling)",
    "properties": {
     "height": {
      "description": "Native display height",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "width": {
      "description": "Native display width",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height"
    ],
    "type": "object"
   },
   "serial": {
    "description": "Resolved device serial",
    "type": "string"
   },
   "status": {
    "description": "Session status (e.g. 'connected')",
    "type": "string"
   },
   "videoAvailable": {
    "description": "Whether the scrcpy video stream is up. When false, the session still works for input/clipboard but screenshots fall back to adb screencap.",
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "serial",
   "screenSize",
   "videoAvailable",
   "message"
  ],
  "type": "object"
 }
}

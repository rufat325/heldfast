{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Preview the ContextBundle (workspace rules, frameworks, target-model capabilities, resolved analysis, session history) without running optimization. Returns the same bundle that optimize_prompt would assemble.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "chat",
     "image",
     "voice",
     "video",
     "music",
     "code",
     "document"
    ],
    "type": "string"
   },
   "cwd": {
    "type": "string"
   },
   "file_excerpt": {
    "type": "string"
   },
   "file_language": {
    "type": "string"
   },
   "file_path": {
    "type": "string"
   },
   "prompt": {
    "type": "string"
   },
   "session_id": {
    "type": "string"
   },
   "skip_intent_resolution": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "inspect_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "analysis": {},
   "environment": {},
   "git": {}
  },
  "type": "object"
 },
 "title": "Inspect the context bundle"
}

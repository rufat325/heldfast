    "minimum": 0,
    "title": "Guests",
    "type": "integer"
   },
   "language": {
    "default": "de",
    "description": "'de' (default) or 'en' \u2014 the language of the conversation",
    "title": "Language",
    "type": "string"
   },
   "month": {
    "default": "",

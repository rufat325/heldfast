  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Show the month's prices as an interactive card. Same arguments and data as get_rates.",
 "inputSchema": {
  "properties": {
   "adults": {
    "default": 2,
    "description": "Adults in one apartment",
    "maximum": 5,
    "minimum": 1,
    "title": "Adults",
    "type": "integer"
   },
   "children": {
    "default": "",

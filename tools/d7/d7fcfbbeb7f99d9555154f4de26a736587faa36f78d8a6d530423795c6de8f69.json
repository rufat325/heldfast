{
 "description": "Rank models and providers by various metrics: total cost, cost-efficiency (cost per 1M tokens), total tokens, cache efficiency, reasoning usage, and output volume. Use this to find the best value models or identify the heaviest hitters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entity": {
    "description": "Rank models or providers (default: models)",
    "enum": [
     "models",
     "providers"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Top N to show (default: 10)",
    "type": "number"
   },
   "project": {
    "description": "Filter by project name/path substring",
    "type": "string"
   },
   "rank_by": {
    "description": "Ranking metric (default: cost)",
    "enum": [
     "cost",
     "cost_efficiency",
     "tokens",
     "cache_rate",
     "reasoning_rate",
     "output_volume",
     "records"
    ],
    "type": "string"
   },
   "scope": {
    "description": "Time scope: today, week (last 7d), month (calendar month), or all (default)",
    "enum": [
     "today",
     "week",
     "month",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "drishti_leaderboard"
}

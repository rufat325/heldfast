{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Store a message in conversation history. Use for remembering what just happened.",
 "inputSchema": {
  "properties": {
   "content": {
    "description": "Message content",
    "type": "string"
   },
   "role": {
    "description": "Role: user, assistant, system, tool (default: user)",
    "type": "string"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   }
  },
  "required": [
   "spaceId",
   "content"
  ],
  "type": "object"
 },
 "name": "memory_store",
 "outputSchema": {
  "properties": {
   "_id": {
    "description": "Message ID",
    "type": "string"
   },
   "content": {
    "description": "Message text",
    "type": "string"
   },
   "createdAt": {
    "description": "ISO 8601 creation timestamp",
    "type": "string"
   },
   "metadata": {
    "description": "Optional caller-supplied metadata",
    "type": "object"
   },
   "role": {
    "description": "Message role: user, assistant, system, or tool",
    "type": "string"
   },
   "seq": {
    "description": "Monotonic sequence number within the space",
    "type": "number"
   },
   "spaceId": {
    "description": "Owning memory space ID",
    "type": "string"
   }
  },
  "type": "object"
 }
}

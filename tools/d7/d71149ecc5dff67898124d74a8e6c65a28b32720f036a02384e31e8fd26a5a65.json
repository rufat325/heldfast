{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "LAST RESORT after help explicitly returns reportRecommended:true. Prepare and submit a sanitized product bug report using helpAuthorization from that diagnosis. Only whitelisted structured diagnostics are sent (tool name, error code/message, site id, bound domain, deployment id, timestamps, client/MCP version, request id) \u2014 NEVER file contents, source code, secrets, .env values or credentials. Without confirmSubmit: true the exact payload is shown for user review and nothing is submitted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentContext": {
    "description": "YOUR OWN factual account of the session as the AI: which tools you called, what they returned, expected vs actual. Write it yourself from your observations \u2014 never ask the user to compose it, and do not read it back to them; it travels alongside the user's description as a second witness. No secrets, no file contents.",
    "type": "string"
   },
   "confirmSubmit": {
    "description": "User reviewed the report payload and approved submission.",
    "type": "boolean"
   },
   "contactEmail": {
    "description": "OPTIONAL. Before submitting, ask the user ONCE whether they want to leave a contact for follow-up. Omit entirely if they decline \u2014 never require it.",
    "type": "string"
   },
   "deploymentId": {
    "type": "string"
   },
   "description": {
    "description": "What happened, in the user's words (no secrets).",
    "type": "string"
   },
   "errorCode": {
    "type": "string"
   },
   "errorMessage": {
    "description": "Sanitized error message (no secrets).",
    "type": "string"
   },
   "helpAuthorization": {
    "description": "Short-lived authorization returned only by help when report is recommended.",
    "type": "string"
   },
   "requestId": {
    "type": "string"
   },
   "severity": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "toolName": {
    "description": "The Sakupa tool that failed, e.g. \"deploy\".",
    "type": "string"
   }
  },
  "required": [
   "toolName",
   "helpAuthorization"
  ],
  "type": "object"
 },
 "name": "report",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "decision": {
    "additionalProperties": false,
    "properties": {
     "decisionVersion": {
      "const": 1,
      "type": "number"
     },
     "defaultOptionId": {
      "type": "null"
     },
     "options": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "consequences": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "description": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "nextAction": {
         "oneOf": [
          {
           "additionalProperties": false,
           "properties": {
            "arguments": {
             "additionalProperties": {},
             "propertyNames": {
              "type": "string"
             },
             "type": "object"
            },
            "reasonCode": {
             "type": "string"
            },
            "tool": {
             "enum": [
              "init",
              "help",
              "analyze",
              "deploy",
              "refresh",
              "status",
              "rotate",
              "plans",
              "subscribe",
              "bind",
              "billing",
              "portal",
              "recover",
              "change",
              "support",
              "report",
              "apps",
              "delete"
             ],
             "type": "string"
            },
            "type": {
             "const": "call_tool",
             "type": "string"
            }
           },
           "required": [
            "type",
            "tool",
            "arguments"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "type": {
             "const": "open_url",
             "type": "string"
            },
            "url": {
             "type": "string"
            }
           },
           "required": [
            "type",
            "url"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "type": {
             "const": "none",
             "type": "string"
            }
           },
           "required": [
            "type"
           ],
           "type": "object"
          }
         ]
        }
       },
       "required": [
        "id",
        "label",
        "description",
        "consequences",
        "nextAction"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "prompt": {
      "type": "string"
     },
     "selectionMode": {
      "const": "single",
      "type": "string"
     },
     "selectionRequired": {
      "const": true,
      "type": "boolean"
     }
    },
    "required": [
     "decisionVersion",
     "prompt",
     "selectionMode",
     "selectionRequired",
     "defaultOptionId",
     "options"
    ],
    "type": "object"
   },
   "nextActions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "allowed": {
       "type": "boolean"
      },
      "arguments": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "reasonCode": {
       "type": "string"
      },
      "tool": {
       "enum": [
        "init",
        "help",
        "analyze",
        "deploy",
        "refresh",
        "status",
        "rotate",
        "plans",
        "subscribe",
        "bind",
        "billing",
        "portal",
        "recover",
        "change",
        "support",
        "report",
        "apps",
        "delete"
       ],
       "type": "string"
      }
     },
     "required": [
      "tool",
      "allowed"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "operationId": {
    "type": "string"
   },
   "outcome": {
    "enum": [
     "completed",
     "preview",
     "waiting_user",
     "pending_provider",
     "blocked",
     "expired",
     "failed"
    ],
    "type": "string"
   },
   "presentation": {
    "additionalProperties": false,
    "properties": {
     "agentInstructions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "answerScope": {
      "const": "current_user_question",
      "type": "string"
     },
     "clientTimeZone": {
      "type": "string"
     },
     "mustTellUser": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "nonProductionEnvironmentDisclosure": {
      "const": "always",
      "type": "string"
     },
     "preserveExactFields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "productionEnvironmentDisclosure": {
      "const": "only_when_asked_or_relevant",
      "type": "string"
     },
     "retainTechnicalContext": {
      "const": true,
      "type": "boolean"
     },
     "tellWhenRelevant": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "timestampDisplay": {
      "const": "user_local_with_explicit_zone_and_exact_source",
      "type": "string"
     },
     "translateFields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "unlabeledTimestampsForbidden": {
      "const": true,
      "type": "boolean"
     },
     "userLanguage": {
      "const": "infer_from_conversation",
      "type": "string"
     },
     "userTimeZone": {
      "const": "infer_from_conversation",
      "type": "string"
     }
    },
    "required": [
     "userLanguage",
     "userTimeZone",
     "clientTimeZone",
     "timestampDisplay",
     "unlabeledTimestampsForbidden",
     "answerScope",
     "retainTechnicalContext",
     "productionEnvironmentDisclosure",
     "nonProductionEnvironmentDisclosure",
     "translateFields",
     "preserveExactFields",
     "mustTellUser",
     "tellWhenRelevant",
     "agentInstructions"
    ],
    "type": "object"
   },
   "resultCode": {
    "type": "string"
   },
   "schemaVersion": {
    "const": 1,
    "type": "number"
   },
   "summary": {
    "type": "string"
   },
   "userAction": {
    "additionalProperties": false,
    "properties": {
     "expectedOutcome": {
      "type": "string"
     },
     "expiresAt": {
      "type": "string"
     },
     "options": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "expectedOutcome": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "label",
        "value",
        "expectedOutcome"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "provider": {
      "enum": [
       "stripe",
       "sakupa"
      ],
      "type": "string"
     },
     "resumeWith": {
      "additionalProperties": false,
      "properties": {
       "arguments": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "tool": {
        "enum": [
         "init",
         "help",
         "analyze",
         "deploy",
         "refresh",
         "status",
         "rotate",
         "plans",
         "subscribe",
         "bind",
         "billing",
         "portal",
         "recover",
         "change",
         "support",
         "report",
         "apps",
         "delete"
        ],
        "type": "string"
       }
      },
      "required": [
       "tool",
       "arguments"
      ],
      "type": "object"
     },
     "type": {
      "enum": [
       "open_url",
       "confirm_in_mcp",
       "configure_dns",
       "select_site"
      ],
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "type",
     "expectedOutcome"
    ],
    "type": "object"
   }
  },
  "required": [
   "schemaVersion",
   "outcome",
   "resultCode",
   "summary",
   "data",
   "nextActions"
  ],
  "type": "object"
 },
 "title": "Bug report"
}

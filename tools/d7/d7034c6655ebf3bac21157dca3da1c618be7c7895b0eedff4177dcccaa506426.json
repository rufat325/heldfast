{
 "description": "Search Belgian postal information records in the official BeST address registry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum number of postal info records to return",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "name": {
    "description": "Postal locality name",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Result page number",
    "minimum": 1,
    "type": "number"
   },
   "postCode": {
    "description": "Belgian postal code",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "best_search_postal_infos"
}

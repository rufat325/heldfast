{
 "description": "Update an AI visibility prompt's status, frequency, platforms, or brand variants.",
 "inputSchema": {
  "properties": {
   "brand_variants": {
    "description": "Alternative brand spellings to match",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "frequency": {
    "enum": [
     "daily",
     "weekly"
    ],
    "type": "string"
   },
   "id": {
    "description": "Prompt ID",
    "type": "string"
   },
   "platforms": {
    "description": "AI platforms to track (e.g. chatgpt, perplexity, claude, gemini, google_ai, grok, copilot, deepseek)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "active",
     "paused",
     "archived"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_prompt"
}

{
 "description": "Log a single action during a recording session. Captures input, output, reasoning, and timing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action_type": {
    "description": "Type of action (tool_call, llm_response, decision, error)",
    "type": "string"
   },
   "duration_ms": {
    "default": 0,
    "description": "Duration in milliseconds",
    "type": "number"
   },
   "input": {
    "description": "Input to the action"
   },
   "output": {
    "description": "Output from the action"
   },
   "reasoning": {
    "default": "",
    "description": "Agent reasoning for this step",
    "type": "string"
   },
   "session_id": {
    "description": "Session ID returned by record_session",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "action_type"
  ],
  "type": "object"
 },
 "name": "log_action"
}

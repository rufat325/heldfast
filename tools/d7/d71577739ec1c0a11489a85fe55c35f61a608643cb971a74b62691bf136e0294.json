  "additionalProperties": false,
  "properties": {
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "invite_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "max_affiliates": {
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "profile_name": {
    "maxLength": 160,
    "type": "string"
   },
   "tiers": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "commission_type": {
       "enum": [
        "percent",
        "fixed"
       ],
       "type": "string"
      },
      "commission_value": {
       "maximum": 1000000,
       "minimum": 0,
       "type": "number"
      },
      "discount_type": {
       "enum": [
        "percent",
        "fixed"
       ],
       "type": "string"
      },
      "discount_value": {
       "exclusiveMinimum": 0,
       "maximum": 1000000,
       "type": "number"
      },
      "max_redemptions": {
       "maximum": 10000000,
       "minimum": 0,
       "type": "integer"
      },
      "ticket_class_name": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "ticket_class_name",
      "discount_type",
      "discount_value"
     ],
     "type": "object"
    },
    "propertyNames": {
     "maxLength": 128,
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "event_id",
   "invite_id",
   "tiers"
  ],
  "type": "object"
 },

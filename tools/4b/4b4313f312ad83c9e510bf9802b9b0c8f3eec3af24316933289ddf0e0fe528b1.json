{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Batch-screen a list of IMO numbers and wait for the results (up to two minutes). Returns one verdict per hull plus the batch status. Needs ARCNAUTICAL_API_KEY. Each hull spends one screening unit unless it was already screened today.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "imos": {
    "description": "Up to 50 seven-digit IMO numbers",
    "items": {
     "description": "Seven-digit IMO number of the vessel",
     "pattern": "^\\d{7}$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "include_vetting": {
    "description": "false skips the vetting grade for a faster sanctions-only screen",
    "type": "boolean"
   }
  },
  "required": [
   "imos"
  ],
  "type": "object"
 },
 "name": "screen_vessels",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batch": {
    "additionalProperties": true,
    "description": "The batch as last read",
    "properties": {
     "id": {
      "type": "string"
     },
     "status": {
      "description": "queued | running | completed | partial | failed",
      "type": "string"
     }
    },
    "type": "object"
   },
   "items": {
    "description": "One row per hull",
    "items": {
     "additionalProperties": true,
     "properties": {
      "imo": {
       "type": [
        "string",
        "null"
       ]
      },
      "result_body": {
       "anyOf": [
        {
         "additionalProperties": true,
         "properties": {
          "sanctions": {
           "additionalProperties": true,
           "properties": {
            "status": {
             "type": "string"
            }
           },
           "type": "object"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "screening_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "batch",
   "items"
  ],
  "type": "object"
 },
 "title": "Screen up to 50 vessels (API key)"
}

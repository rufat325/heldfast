{
 "description": "Create a Wan task on RunAPI (animate). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "callback_url": {
    "type": "string"
   },
   "enable_safety_checker": {
    "type": "boolean"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "wan-2.2-animate-move",
     "wan-2.2-animate-replace"
    ],
    "type": "string"
   },
   "output_resolution": {
    "enum": [
     "480p",
     "580p",
     "720p"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "reference_video_url": {
    "type": "string"
   },
   "source_image_url": {
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "source_image_url",
   "reference_video_url"
  ],
  "type": "object"
 },
 "name": "animate"
}

{
 "description": "Track a search query to monitor how AI search results respond for your brand.",
 "inputSchema": {
  "properties": {
   "brand_variants": {
    "description": "Alternative brand spellings to match",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "category": {
    "description": "default: product",
    "enum": [
     "brand",
     "competitors",
     "product",
     "problem",
     "commercial",
     "custom"
    ],
    "type": "string"
   },
   "frequency": {
    "description": "Crawl frequency (default: daily)",
    "enum": [
     "daily",
     "weekly"
    ],
    "type": "string"
   },
   "location": {
    "description": "Defaults to site country",
    "enum": [
     "global",
     "us",
     "uk",
     "eu",
     "apac",
     "latam"
    ],
    "type": "string"
   },
   "platforms": {
    "description": "AI platforms to track (e.g. chatgpt, perplexity, claude, gemini, google_ai, grok, copilot, deepseek)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "prompt_text": {
    "description": "Query to track (10-1000 chars)",
    "type": "string"
   },
   "site_id": {
    "description": "Strongly recommended \u2014 prompts without a site_id will NOT appear in the Frase app. From list_sites.",
    "type": "string"
   },
   "target_brand": {
    "description": "Brand name to track visibility for",
    "type": "string"
   }
  },
  "required": [
   "prompt_text",
   "target_brand"
  ],
  "type": "object"
 },
 "name": "create_prompt"
}

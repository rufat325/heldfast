{
 "description": "Quick keyword search. Lighter than recall \u2014 no scoring or budget logic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "namespace": {
    "description": "Filter by namespace (also includes \"default\" namespace automatically)",
    "type": "string"
   },
   "q": {
    "description": "Search query",
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "engram_search"
}

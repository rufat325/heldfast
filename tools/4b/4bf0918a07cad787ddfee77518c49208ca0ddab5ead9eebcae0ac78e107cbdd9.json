{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create Blueprint"
 },
 "description": "Creates a new tech stack blueprint for a project.\n\nThe blueprint generation is asynchronous. By default, this tool waits for completion and returns the full blueprint.\nSet waitForCompletion=false to get the job ID immediately for manual polling.\n\nExample usage:\n- Create a SaaS MVP: projectType=\"saas\", scale=\"mvp\", priorities=[\"time-to-market\", \"cost-efficiency\"]\n- Create an enterprise API: projectType=\"api\", scale=\"enterprise\", priorities=[\"security\", \"scalability\"]",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "constraints": {
    "description": "Technology constraint IDs (optional)",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "priorities": {
    "description": "Top 3 priorities (optional)",
    "items": {
     "enum": [
      "time-to-market",
      "scalability",
      "developer-experience",
      "cost-efficiency",
      "performance",
      "security",
      "maintainability"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "projectDescription": {
    "description": "Brief description (optional)",
    "maxLength": 2000,
    "type": "string"
   },
   "projectName": {
    "description": "Project name (optional)",
    "maxLength": 100,
    "type": "string"
   },
   "projectType": {
    "description": "Type of project",
    "enum": [
     "web-app",
     "mobile-app",
     "api",
     "desktop",
     "cli",
     "library",
     "e-commerce",
     "saas",
     "marketplace"
    ],
    "type": "string"
   },
   "scale": {
    "description": "Project scale",
    "enum": [
     "mvp",
     "startup",
     "growth",
     "enterprise"
    ],
    "type": "string"
   },
   "waitForCompletion": {
    "description": "Wait for completion (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "projectType",
   "scale"
  ],
  "type": "object"
 },
 "name": "create_blueprint",
 "title": "Create Blueprint"
}

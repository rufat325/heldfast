 "description": "Get the anime/manga related to a given title (prequels, sequels, side stories, adaptations, spin-offs) with the relation type. Use search_media first to resolve a title to its AniList ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "AniList anime/manga ID.",
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   },
   "type": {
    "description": "Whether `id` refers to anime or manga.",
    "enum": [
     "ANIME",
     "MANGA"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "id"
  ],
  "type": "object"
 },
 "name": "get_media_relations",

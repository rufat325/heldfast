{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compute the fastest route between two or more waypoints.",
 "inputSchema": {
  "examples": [
   {
    "coordinates": "-122.42,37.77;-122.39,37.78"
   },
   {
    "alternatives": true,
    "coordinates": "-122.42,37.77;-122.39,37.78;-122.41,37.80",
    "profile": "bike",
    "steps": true
   }
  ],
  "properties": {
   "alternatives": {
    "description": "Return alternative routes (default false)",
    "type": "boolean"
   },
   "annotations": {
    "description": "duration | nodes | distance | weight | datasources | speed | true | false",
    "type": "string"
   },
   "coordinates": {
    "description": "Semicolon-separated lon,lat pairs (e.g. \"-122.42,37.77;-122.39,37.78\")",
    "type": "string"
   },
   "overview": {
    "description": "simplified (default) | full | false",
    "type": "string"
   },
   "profile": {
    "description": "car (default) | bike | foot",
    "type": "string"
   },
   "steps": {
    "description": "Include turn-by-turn steps (default false)",
    "type": "boolean"
   }
  },
  "required": [
   "coordinates"
  ],
  "type": "object"
 },
 "name": "route",
 "outputSchema": {
  "description": "Route response from OSRM",
  "properties": {
   "code": {
    "description": "Status code (Ok or error)",
    "type": "string"
   },
   "routes": {
    "description": "Array of routes",
    "items": {
     "properties": {
      "distance": {
       "description": "Total distance in meters",
       "type": "number"
      },
      "duration": {
       "description": "Total duration in seconds",
       "type": "number"
      },
      "geometry": {
       "description": "GeoJSON LineString geometry",
       "type": "object"
      },
      "legs": {
       "description": "Array of route legs",
       "items": {
        "properties": {
         "annotations": {
          "description": "Per-leg annotations if requested",
          "type": "object"
         },
         "distance": {
          "description": "Distance in meters",
          "type": "number"
         },
         "duration": {
          "description": "Duration in seconds",
          "type": "number"
         },
         "steps": {
          "description": "Turn-by-turn instructions",
          "type": "array"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "weight": {
       "description": "Total route weight",
       "type": "number"
      },
      "weight_name": {
       "description": "Name of the weight function used",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "waypoints": {
    "description": "Array of waypoint objects",
    "items": {
     "properties": {
      "distance": {
       "description": "Distance to nearest road",
       "type": "number"
      },
      "hint": {
       "description": "Hint for snapping",
       "type": "string"
      },
      "location": {
       "description": "Snapped [lon, lat] coordinates",
       "type": "array"
      },
      "name": {
       "description": "Name of the nearest street",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Route",
 "version": "v1.d335b75f"
}

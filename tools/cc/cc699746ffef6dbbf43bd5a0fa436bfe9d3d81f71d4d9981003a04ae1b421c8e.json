{
 "description": "List WordPress options with optional prefix filter",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "per_page": {
    "default": 50,
    "description": "Results per page",
    "type": "number"
   },
   "prefix": {
    "description": "Filter by option name prefix",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "mcp_list_options"
}

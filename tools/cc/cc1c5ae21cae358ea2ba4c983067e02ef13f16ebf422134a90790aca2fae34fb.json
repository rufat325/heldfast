{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Bulk Lookup"
 },
 "description": "Live lookup for up to 100 North American phone numbers in one call (carrier, line type, routing; optional cnam/spam/messaging). Each number is a fresh paid read \u2014 spend scope required.",
 "inputSchema": {
  "properties": {
   "phone_numbers": {
    "description": "US/Canada numbers, any common format (max 100)",
    "items": {
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "products": {
    "description": "Data sets per number. Default ['lrn'].",
    "items": {
     "enum": [
      "lrn",
      "cnam",
      "spam",
      "messaging"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "phone_numbers"
  ],
  "type": "object"
 },
 "name": "vri_bulk_lookup",
 "outputSchema": {
  "additionalProperties": true,
  "description": "Per-number results plus total charged",
  "properties": {
   "results": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "total_charged": {
    "description": "USD amount billed for this call",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Bulk Lookup"
}

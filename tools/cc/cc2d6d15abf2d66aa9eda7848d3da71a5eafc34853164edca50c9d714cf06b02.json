{
 "description": "Edit a tracked keyword \u2014 including is_active=false to pause tracking without losing history.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aliases": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "brand_context": {
    "type": "string"
   },
   "exclude_terms": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "Keyword id from list_keywords.",
    "type": "string"
   },
   "is_active": {
    "description": "false pauses tracking, true resumes.",
    "type": "boolean"
   },
   "keyword": {
    "type": "string"
   },
   "platforms": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "require_terms": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "role": {
    "enum": [
     "brand",
     "competitor",
     "topic"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_keyword"
}

{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Audit the current screen within bounded Fiber traversal limits. Checks labels, roles, testIDs, and alt text; returns issues, summary, and traversal coverage.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "maxDepth": {
    "default": 200,
    "description": "Maximum Fiber depth to inspect",
    "maximum": 600,
    "minimum": 0,
    "type": "integer"
   },
   "maxNodes": {
    "default": 1200,
    "description": "Maximum Fibers to inspect",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "severity": {
    "default": "all",
    "description": "Filter by severity level",
    "enum": [
     "all",
     "error",
     "warning",
     "info"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "audit_accessibility"
}

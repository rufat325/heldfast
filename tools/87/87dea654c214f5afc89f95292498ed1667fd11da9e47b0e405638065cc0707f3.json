{
 "description": "Run a side-effect-free test for a hosted health-check target.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "expectedStatusMax": {
    "type": "number"
   },
   "expectedStatusMin": {
    "type": "number"
   },
   "method": {
    "enum": [
     "GET",
     "HEAD"
    ],
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "timeoutMs": {
    "type": "number"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "url"
  ],
  "type": "object"
 },
 "name": "test_health_check"
}

 },
 "description": "Search YouTube for videos, channels, or playlists. Returns snippet info including title, description, channel, thumbnails, and publish date.",
 "inputSchema": {
  "examples": [
   {
    "_apiKey": "your-youtube-api-key",
    "query": "machine learning tutorial"
   },
   {
    "_apiKey": "your-youtube-api-key",
    "max_results": 20,
    "order": "viewCount",
    "published_after": "2024-01-01T00:00:00Z",
    "query": "Python programming",
    "type": "video"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "YouTube Data API v3 key from Google Cloud Console",
    "type": "string"
   },
   "channel_id": {
    "description": "Filter results to a specific channel ID",
    "type": "string"
   },
   "max_results": {
    "description": "Number of results to return (default 10, max 50)",
    "type": "number"
   },
   "order": {
    "description": "Sort order: \"date\", \"rating\", \"relevance\", or \"viewCount\" (default: \"relevance\")",
    "type": "string"
   },
   "published_after": {
    "description": "Filter results published after this ISO 8601 date (e.g. \"2024-01-01T00:00:00Z\")",
    "type": "string"
   },
   "query": {
    "description": "Search term",
    "type": "string"
   },
   "type": {
    "description": "Resource type to search: \"video\", \"channel\", or \"playlist\" (default: \"video\")",
    "type": "string"
   }
  },
  "required": [
   "_apiKey",
   "query"
  ],
  "type": "object"
 },
 "name": "yt_search",
 "outputSchema": {
  "properties": {
   "results": {
    "description": "Array of search result items",
    "items": {
     "properties": {
      "channel_id": {
       "description": "Channel ID",
       "type": "string"
      },
      "channel_title": {
       "description": "Channel title",
       "type": "string"
      },
      "description": {
       "description": "Resource description",
       "type": "string"
      },
      "id": {
       "description": "Video, channel, or playlist ID",
       "type": [
        "string",
        "null"
       ]
      },
      "kind": {
       "description": "Resource kind (youtube#video, youtube#channel, etc.)",
       "type": "string"
      },
      "published_at": {
       "description": "ISO 8601 publish date",
       "type": "string"
      },
      "thumbnail": {
       "description": "Default thumbnail URL",
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "description": "Resource title",
       "type": "string"
      }
     },
     "required": [
      "id",
      "kind",
      "title",
      "description",
      "channel_title",
      "channel_id",
      "published_at",
      "thumbnail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_results": {
    "description": "Total number of search results available",
    "type": "number"
   }
  },
  "required": [
   "total_results",
   "results"

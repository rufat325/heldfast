{
 "description": "Update a slide's title, layout, and/or position.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "layout": {
    "description": "New layout",
    "enum": [
     "title",
     "title-body",
     "split-text-viz",
     "split-viz-text",
     "viz-full",
     "stat",
     "section-divider",
     "freeform"
    ],
    "type": "string"
   },
   "presentationId": {
    "description": "The presentation ID",
    "type": "string"
   },
   "slideId": {
    "description": "The slide ID",
    "type": "string"
   },
   "sortOrder": {
    "description": "New position (0-based)",
    "type": "number"
   },
   "title": {
    "description": "New title (null to clear)",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "presentationId",
   "slideId"
  ],
  "type": "object"
 },
 "name": "update_slide"
}

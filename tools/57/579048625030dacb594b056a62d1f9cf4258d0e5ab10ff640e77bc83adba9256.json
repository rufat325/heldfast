{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Case File List"
 },
 "description": "Lists all case files in your GoCertius account. Pass userId (from session_login or session_info) to scope results to your account. Returns paginated list with IDs, names, and status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filter": {
    "properties": {
     "createdById": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "ownerId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "ownerOrSharedWithId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "search": {
      "type": "string"
     },
     "status": {
      "enum": [
       "OPEN",
       "CLOSED"
      ],
      "type": "string"
     },
     "statuses": {
      "items": {
       "enum": [
        "OPEN",
        "CLOSED"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "useCaseId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "order": {
    "properties": {
     "createdAt": {
      "enum": [
       "ASC",
       "DESC"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "page": {
    "properties": {
     "number": {
      "default": 1,
      "minimum": 1,
      "type": "number"
     },
     "size": {
      "default": 20,
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "userId": {
    "type": "string"
   }
  },
  "required": [
   "userId"
  ],
  "type": "object"
 },
 "name": "case_file_list"
}

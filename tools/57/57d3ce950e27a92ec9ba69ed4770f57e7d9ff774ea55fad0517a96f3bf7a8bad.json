{
 "description": "Get the full details of a single licita\u00e7\u00e3o (procurement bid) on PNCP. Provide either numeroControlePNCP (the full PNCP control number string) or all three of orgaoCnpj, ano, sequencial.",
 "inputSchema": {
  "properties": {
   "ano": {
    "description": "Year of the bid (e.g. 2024)",
    "type": "integer"
   },
   "numeroControlePNCP": {
    "description": "PNCP control number, format like 00000000000000-1-000001/2024",
    "type": "string"
   },
   "orgaoCnpj": {
    "description": "Procuring agency CNPJ (14 digits)",
    "type": "string"
   },
   "sequencial": {
    "description": "Sequential number of the bid",
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_licitacao"
}

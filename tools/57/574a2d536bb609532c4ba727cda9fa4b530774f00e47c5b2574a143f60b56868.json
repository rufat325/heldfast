{
 "description": "Search bounded public catalog rows with summary=1, filters, limit, cursor, and optional semantic reranking.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "commercial": {
    "enum": [
     "1",
     "true"
    ],
    "type": "string"
   },
   "cursor": {
    "type": "string"
   },
   "explain": {
    "enum": [
     "1",
     "true"
    ],
    "type": "string"
   },
   "format": {
    "type": "string"
   },
   "framework": {
    "type": "string"
   },
   "hosting": {
    "type": "string"
   },
   "license": {
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "number"
   },
   "q": {
    "type": "string"
   },
   "reviewStatus": {
    "enum": [
     "first-review",
     "needs-evidence",
     "reviewed",
     "verified-run",
     "benchmark"

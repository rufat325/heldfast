    "type": "string"
   },
   "sort": {
    "enum": [
     "best",
     "ready",
     "mirrorable",
     "trust",
     "updated",
     "downloads",
     "stars",
     "demand",
     "mirrors",
     "name",
     "size",
     "license"
    ],
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "task": {
    "type": "string"
   },
   "type": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_artifacts"
}

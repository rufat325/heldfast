{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Evidence Group Create"
 },
 "description": "Creates an evidence group inside a case file. Requires: case_file_create \u2192 caseFileId. Generate a UUID v4 for `id`. Set evidenceType to FILE, PHOTO, VIDEO, or WEB_PLUGIN. Returns evidenceGroupId. One group can contain multiple evidence records.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "attestation": {
    "properties": {
     "app": {
      "enum": [
       "App",
       "AppPro"
      ],
      "type": "string"
     },
     "assertion": {
      "type": "string"
     },
     "keyId": {
      "type": "string"
     },
     "provider": {
      "enum": [
       "PlayIntegrity",
       "AppAttest"
      ],
      "type": "string"
     },
     "token": {
      "type": "string"
     }
    },
    "required": [
     "provider",
     "app"
    ],
    "type": "object"
   },
   "caseFileId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "description": {
    "maxLength": 160,
    "type": "string"
   },
   "evidenceType": {
    "enum": [
     "FILE",
     "PHOTO",
     "VIDEO",
     "WEB_PLUGIN"
    ],
    "type": "string"
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "name": {
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "id",
   "evidenceType",
   "name",
   "caseFileId"
  ],
  "type": "object"
 },
 "name": "evidence_group_create"
}

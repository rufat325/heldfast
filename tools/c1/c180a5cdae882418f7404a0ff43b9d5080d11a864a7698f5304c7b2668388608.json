{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a company's profile \u2014 sector, market cap, price, P/E ratio, 52-week range, beta, dividend yield, and other key financials.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ticker": {
    "description": "Stock ticker symbol (e.g. 'AAPL', 'NVDA', 'MSFT')",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "get_stock_profile",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "position_basis": {
    "$ref": "#/properties/stock/properties/sector"
   },
   "stock": {
    "additionalProperties": false,
    "properties": {
     "avg_volume": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "beta": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "current_price": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "dividend_yield_pct": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "eps": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "fifty_two_week_high": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "fifty_two_week_low": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "industry": {
      "$ref": "#/properties/stock/properties/sector"
     },
     "market_cap": {
      "anyOf": [
       {
        "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
     },
     "pe_ratio": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "previous_close": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "price_date": {
      "$ref": "#/properties/stock/properties/sector"
     },
     "profit_margins": {
      "$ref": "#/properties/stock/properties/market_cap"
     },
     "sector": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "sector",
     "industry",
     "market_cap",
     "current_price",
     "price_date",
     "previous_close",
     "fifty_two_week_high",
     "fifty_two_week_low",
     "pe_ratio",
     "eps",
     "beta",
     "dividend_yield_pct",
     "profit_margins",
     "avg_volume"
    ],
    "type": "object"
   },
   "ticker": {
    "type": "string"
   },
   "top_holders": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "call_shares": {
       "$ref": "#/properties/stock/properties/market_cap"
      },
      "cik": {
       "$ref": "#/properties/stock/properties/sector"
      },
      "equity_shares": {
       "$ref": "#/properties/stock/properties/market_cap"
      },
      "has_option_legs": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "holding_value": {
       "$ref": "#/properties/stock/properties/market_cap"
      },
      "name": {
       "$ref": "#/properties/stock/properties/sector"
      },
      "portfolio_weight_pct": {
       "$ref": "#/properties/stock/properties/market_cap"
      },
      "put_shares": {
       "$ref": "#/properties/stock/properties/market_cap"
      },
      "shares_held": {
       "$ref": "#/properties/stock/properties/market_cap"
      }
     },
     "required": [
      "cik",
      "name",
      "shares_held",
      "holding_value",
      "portfolio_weight_pct",
      "equity_shares",
      "call_shares",
      "put_shares",
      "has_option_legs"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ticker",
   "stock",
   "position_basis",
   "top_holders"
  ],
  "type": "object"
 }
}

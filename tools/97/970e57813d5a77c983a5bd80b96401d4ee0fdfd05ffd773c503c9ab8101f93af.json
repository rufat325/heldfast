{
 "description": "Write goal canon by op. Ordinary cuts require elicited clauses, provocation, and owner ratification. Every non-migrate op is migration-locked while a live legacy objective requires migration; migrate is the one-shot, fail-closed cutover that lifts the lock and takes no payload. joint_link/load_link support create and remove. Provenance and intents are writer-owned.",
 "inputSchema": {
  "properties": {
   "carries": {
    "type": "string"
   },
   "clause": {
    "description": "load_link create branch v<N>#c<N> reference.",
    "type": "string"
   },
   "clause_id": {
    "description": "correct branch clause ID.",
    "type": "string"
   },
   "clauses": {
    "description": "cut: {text, channel, elicitation, secondhand source attribution?}[]",
    "type": "array"
   },
   "diff_note": {
    "type": "string"
   },
   "idempotency_key": {
    "type": "string"
   },
   "joint": {
    "description": "joint_link create branch joint slug.",
    "type": "string"
   },
   "joint_link_id": {
    "type": "string"
   },
   "load_link_id": {
    "type": "string"
   },
   "op": {
    "enum": [
     "cut",
     "correct",
     "joint_link",
     "load_link",
     "migrate"
    ],
    "type": "string"
   },
   "provocation": {
    "description": "cut: {quote, at}",
    "type": "object"
   },
   "ratification": {
    "description": "cut: {asked, answered_at, answer_ref, quote}",
    "type": "object"
   },
   "reason": {
    "type": "string"
   },
   "remove": {
    "type": "boolean"
   },
   "text": {
    "description": "correct branch replacement wording.",
    "type": "string"
   }
  },
  "required": [
   "op"
  ],
  "type": "object"
 },
 "name": "judgment_goal_write"
}

{
 "description": "Ejecuta dos requests y compara sus respuestas. \u00datil para detectar regresiones o comparar entornos.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "request_a": {
    "additionalProperties": false,
    "description": "Primer request",
    "properties": {
     "auth": {
      "additionalProperties": false,
      "properties": {
       "header": {
        "description": "Header name para API key (default: X-API-Key)",
        "type": "string"
       },
       "key": {
        "description": "API key value",
        "type": "string"
       },
       "password": {
        "description": "Password para Basic auth",
        "type": "string"
       },
       "token": {
        "description": "Token para Bearer auth",
        "type": "string"
       },
       "type": {
        "description": "Tipo de autenticaci\u00f3n",
        "enum": [
         "bearer",
         "api-key",
         "basic"
        ],
        "type": "string"
       },
       "username": {
        "description": "Username para Basic auth",
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     "body": {},
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "label": {
      "description": "Etiqueta (ej: \"antes\", \"dev\", \"v1\")",
      "type": "string"
     },
     "method": {
      "enum": [
       "GET",
       "POST",
       "PUT",
       "PATCH",
       "DELETE",
       "HEAD",
       "OPTIONS"
      ],
      "type": "string"
     },
     "query": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "method",
     "url"
    ],
    "type": "object"
   },
   "request_b": {
    "additionalProperties": false,
    "description": "Segundo request",
    "properties": {
     "auth": {
      "$ref": "#/properties/request_a/properties/auth"
     },
     "body": {
      "$ref": "#/properties/request_a/properties/body"
     },
     "headers": {
      "$ref": "#/properties/request_a/properties/headers"
     },
     "label": {
      "$ref": "#/properties/request_a/properties/label"
     },
     "method": {
      "$ref": "#/properties/request_a/properties/method"
     },
     "query": {
      "$ref": "#/properties/request_a/properties/query"
     },
     "url": {
      "$ref": "#/properties/request_a/properties/url"
     }
    },
    "required": [
     "method",
     "url"
    ],
    "type": "object"
   }
  },
  "required": [
   "request_a",
   "request_b"
  ],
  "type": "object"
 },
 "name": "diff_responses"
}

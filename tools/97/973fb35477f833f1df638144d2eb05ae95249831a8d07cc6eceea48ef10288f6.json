{
 "description": "[GA4 WRITE] Update a property's event data retention (2/14/26/38/50 months; the longer options are 360-only) and whether it resets on new activity. Requires GA4_MCP_ENABLE_WRITES=true and confirm=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "type": "boolean"
   },
   "eventDataRetention": {
    "enum": [
     "TWO_MONTHS",
     "FOURTEEN_MONTHS",
     "TWENTY_SIX_MONTHS",
     "THIRTY_EIGHT_MONTHS",
     "FIFTY_MONTHS"
    ],
    "type": "string"
   },
   "property": {
    "description": "GA4 property ID, e.g. \"123456789\" or \"properties/123456789\".",
    "minLength": 1,
    "type": "string"
   },
   "resetUserDataOnNewActivity": {
    "type": "boolean"
   }
  },
  "required": [
   "property",
   "confirm"
  ],
  "type": "object"
 },
 "name": "ga4_update_data_retention"
}

{
 "annotations": {
  "cost": {
   "all": 10
  },
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get message history from a Slack channel. Bot auto-joins the channel if needed.",
 "inputSchema": {
  "examples": [
   {
    "channel": "C01234ABCDE",
    "limit": 20
   },
   {
    "channel": "C01234ABCDE",
    "limit": 100,
    "oldest": "1609459200"
   }
  ],
  "properties": {
   "channel": {
    "description": "Channel ID (e.g., \"C01234ABCDE\")",
    "type": "string"
   },
   "cursor": {
    "description": "Pagination cursor for next page of results",
    "type": "string"
   },
   "latest": {
    "description": "Only messages before this Unix timestamp",
    "type": "string"
   },
   "limit": {
    "description": "Max number of messages to return (default 20, max 1000)",
    "type": "number"
   },
   "oldest": {
    "description": "Only messages after this Unix timestamp",
    "type": "string"
   }
  },
  "required": [
   "channel"
  ],
  "type": "object"
 },
 "name": "slack_channel_history",
 "outputSchema": {
  "properties": {
   "error": {
    "description": "Error code if API call failed",
    "type": "string"
   },
   "message": {
    "description": "Error message or connection message",
    "type": "string"
   },
   "messages": {
    "description": "List of messages in the channel",
    "items": {
     "properties": {
      "reply_count": {
       "description": "Number of replies in thread",
       "type": "number"
      },
      "reply_users_count": {
       "description": "Number of unique users who replied",
       "type": "number"
      },
      "text": {
       "description": "Message text content",
       "type": "string"
      },
      "thread_ts": {
       "description": "Thread timestamp if message is in a thread",
       "type": "string"
      },
      "ts": {
       "description": "Unix timestamp with milliseconds",
       "type": "string"
      },
      "type": {
       "description": "Message type (e.g., 'message')",
       "type": "string"
      },
      "user": {
       "description": "User ID of message sender",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "ok": {
    "description": "Whether the API call succeeded",
    "type": "boolean"
   },
   "response_metadata": {
    "description": "Pagination metadata",
    "properties": {
     "next_cursor": {
      "description": "Cursor for next page of results",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Slack Channel History",
 "version": "v1.51aeb030"
}

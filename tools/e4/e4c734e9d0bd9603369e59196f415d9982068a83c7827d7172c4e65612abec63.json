{
 "description": "Updates an API key with the given Id.",
 "inputSchema": {
  "properties": {
   "keyId": {
    "description": "The Id of the API key. If not provided a secure random api key will be generated.",
    "type": "string"
   },
   "requestBody": {
    "description": "Authentication key request object.",
    "properties": {
     "apiKey": {
      "description": "domain POJO to represent AuthenticationKey",
      "properties": {
       "expirationInstant": {
        "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
        "format": "int64",
        "type": "number"
       },
       "id": {
        "format": "uuid",
        "type": "string"
       },
       "insertInstant": {
        "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
        "format": "int64",
        "type": "number"
       },
       "ipAccessControlListId": {
        "format": "uuid",
        "type": "string"
       },
       "key": {
        "type": "string"
       },
       "keyManager": {
        "type": "boolean"
       },
       "lastUpdateInstant": {
        "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
        "format": "int64",
        "type": "number"
       },
       "metaData": {
        "properties": {
         "attributes": {
          "additionalProperties": {
           "type": "string"
          },
          "type": "object"
         }
        },
        "type": "object"
       },
       "name": {
        "type": "string"
       },
       "permissions": {
        "properties": {
         "endpoints": {
          "additionalProperties": {
           "items": {},
           "type": "array",
           "uniqueItems": true
          },
          "type": "object"
         }
        },
        "type": "object"
       },
       "retrievable": {
        "type": "boolean"
       },
       "tenantId": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "sourceKeyId": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "keyId"
  ],
  "type": "object"
 },
 "name": "patchAPIKeyWithId"
}

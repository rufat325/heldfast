{
 "description": "Search and page through the full niubiagent archive by keyword, category, tag, and sort order. Returns source-backed results and pageCount.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "agent-infrastructure",
     "model-behavior",
     "safety-research",
     "open-source",
     "agent-economy"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Keyword query",
    "maxLength": 160,
    "type": "string"
   },
   "sort": {
    "default": "latest",
    "enum": [
     "latest",
     "usefulness",
     "confidence"
    ],
    "type": "string"
   },
   "tag": {
    "maxLength": 80,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_signals",
 "title": "Search agent ecosystem signals"
}

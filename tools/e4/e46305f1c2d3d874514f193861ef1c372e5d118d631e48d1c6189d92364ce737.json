{
 "_meta": {
  "openai/outputTemplate": "ui://audiala/card-v1.html",
  "openai/toolInvocation/invoked": "Audio guide ready",
  "openai/toolInvocation/invoking": "Finding the audio guide\u2026",
  "ui": {
   "resourceUri": "ui://audiala/card-v1.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Audio guide for a place"
 },
 "description": "Look up the Audiala audio guide for a specific landmark, museum or place in a city (45,000+ places). Shows a card with a photo, a short summary and a playable 45-second preview of the narration, plus a link to the full guide in the Audiala app (first 5 guides free, works offline). If the place is not found, returns the closest guides in that city. Use this whenever a user asks about a specific landmark or wants to hear about it.",
 "inputSchema": {
  "properties": {
   "city": {
    "description": "City name or slug (e.g. 'rome' or 'Rome').",
    "type": "string"
   },
   "lang": {
    "description": "Content language. Defaults to en.",
    "enum": [
     "en",
     "fr",
     "de",
     "es",
     "it",
     "pt",
     "ru",
     "ja",
     "zh",
     "cs",
     "ar",
     "hi"
    ],
    "type": "string"
   },
   "monument": {
    "description": "Monument / place name (e.g. 'Colosseum').",
    "type": "string"
   }
  },
  "required": [
   "city",
   "monument"
  ],
  "type": "object"
 },
 "name": "audiala_audio_guide",
 "outputSchema": {
  "properties": {
   "city": {
    "description": "The resolved city.",
    "properties": {
     "app_url": {
      "description": "Opens the city in the signed-in Audiala web app.",
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "guides_count": {
      "description": "Number of audio guides in the city.",
      "type": [
       "integer",
       "null"
      ]
     },
     "image": {
      "description": "Hero image URL.",
      "type": [
       "string",
       "null"
      ]
     },
     "image_fallbacks": {
      "description": "Images to try if `image` fails.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "summary": {
      "description": "Short editorial summary.",
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "description": "Public audiala.com city page.",
      "type": "string"
     }
    },
    "required": [
     "name",
     "country",
     "url"
    ],
    "type": "object"
   },
   "kind": {
    "enum": [
     "place",
     "place_candidates",
     "not_found"
    ],
    "type": "string"
   },
   "lang": {
    "type": "string"
   },
   "links": {
    "description": "UTM-tagged links into Audiala.",
    "properties": {
     "app_url": {
      "description": "Signed-in Audiala web app.",
      "type": "string"
     },
     "download": {
      "description": "App download page.",
      "type": "string"
     },

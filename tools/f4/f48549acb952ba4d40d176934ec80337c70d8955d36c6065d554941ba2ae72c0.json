  "title": "YNAB: Update Transaction"
 },
 "description": "Update fields on an existing YNAB transaction.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - transaction_id (string, required): Transaction UUID to update.\n  - amount_decimal (number, preferred): New amount in decimal currency units.\n  - amount_milliunits (int, alternative): Explicit raw YNAB milliunits.\n  - amount (int, deprecated): Backward-compatible alias for amount_milliunits.\n  - date (string, optional): New date YYYY-MM-DD.\n  - payee_name / payee_id (string, optional): New payee.\n  - category_id (string, optional): New category UUID.\n  - memo (string, optional): New memo.\n  - cleared (string, optional): \"cleared\", \"uncleared\", or \"reconciled\".\n  - approved (boolean, optional): Approval status.\n  - dry_run (boolean, optional): Preview without saving.\n\nReturns: updated transaction with updated_balance.\n\nWrite safety: call without confirmation_token to preview. Execute the identical validated request with the short-lived confirmation_token returned by that preview.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "type": "string"
   },
   "amount": {
    "description": "Deprecated legacy alias for amount_milliunits. Use amount_decimal for currency input or amount_milliunits for raw YNAB values.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "amount_decimal": {
    "description": "Preferred: amount in decimal currency units (for example, -12.34). Rounded exactly to the nearest YNAB milliunit.",
    "type": "number"
   },
   "amount_milliunits": {
    "description": "Raw YNAB milliunits. Use only when the value is already converted.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "approved": {
    "type": "boolean"
   },
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "category_id": {
    "type": "string"
   },
   "cleared": {
    "enum": [
     "cleared",
     "uncleared",
     "reconciled"
    ],
    "type": "string"
   },
   "confirmation_token": {
    "description": "Short-lived, single-use token returned by the immediately preceding preview of this exact validated request.",
    "minLength": 16,
    "type": "string"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   },
   "flag_color": {
    "enum": [
     "red",
     "orange",
     "yellow",
     "green",
     "blue",
     "purple"
    ],
    "type": "string"
   },
   "memo": {
    "type": "string"
   },
   "payee_id": {
    "type": "string"
   },
   "payee_name": {
    "type": "string"
   },
   "transaction_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "transaction_id"
  ],
  "type": "object"
 },

   },
   "dataStreamId": {
    "description": "Data stream ID (numeric) or \"dataStreams/{id}\".",
    "minLength": 1,
    "type": "string"
   },
   "emailRedactionEnabled": {
    "type": "boolean"
   },
   "property": {
    "description": "GA4 property ID, e.g. \"123456789\" or \"properties/123456789\".",

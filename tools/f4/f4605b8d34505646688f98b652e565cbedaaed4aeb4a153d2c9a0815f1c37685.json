    "type": "string"
   },
   "queryParameterKeys": {
    "description": "Query params to redact, e.g. [\"email\", \"phone\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "queryParameterRedactionEnabled": {
    "type": "boolean"
   }
  },
  "required": [

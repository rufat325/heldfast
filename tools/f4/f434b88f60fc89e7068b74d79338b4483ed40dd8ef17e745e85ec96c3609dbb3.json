    "type": [
     "string",
     "null"
    ]
   },
   "goal": {
    "type": "string"
   },
   "id": {
    "description": "ID do sprint (ver list_sprints).",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "startDate": {
    "description": "YYYY-MM-DD ou null.",

{
 "description": "Submit a new fix to FixGraph. Requires FIXGRAPH_API_KEY env var.",
 "inputSchema": {
  "properties": {
   "issue_id": {
    "description": "Issue ID to attach the fix to",
    "type": "string"
   },
   "risk_level": {
    "description": "Risk level of applying the fix",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "root_cause": {
    "description": "Why the issue occurs",
    "type": "string"
   },
   "steps": {
    "description": "Ordered fix steps",
    "items": {
     "properties": {
      "code": {
       "type": "string"
      },
      "codeLanguage": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "order": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "order",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Short title for the fix",
    "type": "string"
   },
   "validation": {
    "description": "How to verify the fix worked",
    "type": "string"
   }
  },
  "required": [
   "issue_id",
   "title",
   "root_cause",
   "steps"
  ],
  "type": "object"
 },
 "name": "fixgraph_submit_fix"
}

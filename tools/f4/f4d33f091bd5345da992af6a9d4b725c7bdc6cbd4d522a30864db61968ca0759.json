{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List live (non-invalidated) facts in persistent memory, optionally filtered by scope and predicate. Sorted by most-recently-observed first. Useful for inspecting what the engine knows, or finding fact ids to forget.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "description": "Max facts to return. Default 50, hard max 100.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "predicate": {
    "description": "Optional predicate filter (e.g., only 'prefers' facts).",
    "type": "string"
   },
   "scope": {
    "default": "user",
    "description": "Memory scope to filter by. Default 'user'. Examples: 'user', 'project:myapp', 'session:abc'.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "memory_list_facts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "facts": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "predicate": {
    "type": [
     "string",
     "null"
    ]
   },
   "scope": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "List remembered facts"
}

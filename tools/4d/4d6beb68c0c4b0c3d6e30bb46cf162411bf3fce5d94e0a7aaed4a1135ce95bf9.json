    "default": false,
    "description": "Also give each line with its items, client IDs and prices.",
    "type": "boolean"
   },
   "text": {
    "description": "Loot messages, one per line.",
    "maxLength": 20000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },

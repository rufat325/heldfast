{
 "description": "Manually trigger a cron hook",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hook": {
    "description": "Cron hook name to run",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "hook"
  ],
  "type": "object"
 },
 "name": "mcp_run_cron"
}

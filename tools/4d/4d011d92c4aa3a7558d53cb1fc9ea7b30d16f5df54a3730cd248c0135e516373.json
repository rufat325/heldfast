 "description": "VizieR astronomical catalogue service at CDS Strasbourg \u2014 return data rows from one published catalogue, identified by its VizieR id such as \"I/345/gaia2\" (Gaia DR2). Takes optional column selection and a numeric constraint expression, up to 50000 rows. Answers what a published astronomy catalogue records for stars, galaxies or other objects meeting a cut.",
 "inputSchema": {
  "examples": [
   {
    "catalog": "I/345/gaia2"
   },
   {
    "catalog": "J/ApJ/896/72/table1",
    "columns": "RAJ2000,DEJ2000,Plx",
    "constraint": "Plx>20",
    "max": 1000
   }
  ],
  "properties": {
   "catalog": {
    "type": "string"
   },
   "columns": {
    "description": "Comma-sep columns to return.",
    "type": "string"
   },
   "constraint": {
    "description": "Solr-style constraints, e.g. \"Plx>20\"",
    "type": "string"
   },
   "max": {
    "description": "1-50000 (default 50).",
    "type": "number"
   }
  },
  "required": [
   "catalog"
  ],
  "type": "object"
 },

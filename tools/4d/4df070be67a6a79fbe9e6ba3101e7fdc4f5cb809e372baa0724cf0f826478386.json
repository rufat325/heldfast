{
 "description": "Create a custom detection rule in the backend. Requires API key (Pro+).",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "Optional description",
    "type": "string"
   },
   "detection_pattern": {
    "description": "Compiled regex detection pattern",
    "type": "string"
   },
   "name": {
    "description": "Rule name",
    "type": "string"
   },
   "pattern": {
    "description": "Detection pattern (regex or keyword)",
    "type": "string"
   },
   "severity": {
    "description": "Severity on match",
    "enum": [
     "block",
     "warn",
     "log"
    ],
    "type": "string"
   },
   "tier": {
    "description": "Optional tier restriction",
    "type": "string"
   }
  },
  "required": [
   "name",
   "severity"
  ],
  "type": "object"
 },
 "name": "add_custom_rule"
}

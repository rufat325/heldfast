{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Test Run"
 },
 "description": "Create a test run in BrowserStack Test Management. Requires a project identifier (PR-*). No tool here lists projects, so if you do not have one, call askBrowserStackAI with product \"tm\" and ask which projects exist, then retry this tool with the identifier it returns.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "project_identifier": {
    "description": "Identifier of the project in which to create the test run.",
    "type": "string"
   },
   "test_run": {
    "properties": {
     "description": {
      "description": "Brief information about the test run",
      "type": "string"
     },
     "folder_ids": {
      "description": "Folder IDs to include",
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "issue_tracker": {
      "description": "Issue tracker configuration",
      "properties": {
       "host": {
        "format": "uri",
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "host"
      ],
      "type": "object"
     },
     "issues": {
      "description": "Linked issue IDs",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "description": "Name of the test run",
      "type": "string"
     },
     "run_state": {
      "description": "State of the test run. One of new_run, in_progress, under_review, rejected, done, closed",
      "enum": [
       "new_run",
       "in_progress",
       "under_review",
       "rejected",
       "done",
       "closed"
      ],
      "type": "string"
     },
     "test_cases": {
      "description": "List of test case IDs",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   }
  },
  "required": [
   "project_identifier",
   "test_run"
  ],
  "type": "object"
 },
 "name": "createTestRun"
}

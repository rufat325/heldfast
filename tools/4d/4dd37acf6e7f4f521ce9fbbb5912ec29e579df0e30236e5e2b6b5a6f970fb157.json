{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add new records to an existing RRSet without removing existing ones. Optionally update the RRSet TTL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id_or_name": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^[^/\\s]+$",
      "type": "string"
     }
    ],
    "description": "Zone ID or name"
   },
   "name": {
    "description": "RRSet name",
    "pattern": "^[^/\\s]+$",
    "type": "string"
   },
   "records": {
    "description": "Records to add to the RRSet",
    "items": {
     "properties": {
      "comment": {
       "description": "Optional human-readable comment for this record",
       "type": "string"
      },
      "value": {
       "description": "Record value, e.g. \"1.2.3.4\" or \"10 mail.example.com.\"",
       "type": "string"
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "ttl": {
    "description": "Optional new TTL applied alongside the addition",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "DNS record type (A, AAAA, CNAME, MX, NS, TXT, etc.)",
    "enum": [
     "A",
     "AAAA",
     "CAA",
     "CNAME",
     "DS",
     "HINFO",
     "HTTPS",
     "MX",
     "NS",
     "PTR",
     "RP",
     "SOA",
     "SRV",
     "SVCB",
     "TLSA",
     "TXT"
    ],
    "type": "string"
   }
  },
  "required": [
   "id_or_name",
   "name",
   "type",
   "records"
  ],
  "type": "object"
 },
 "name": "hetzner_add_zone_rrset_records",
 "title": "Add Records to DNS Zone RRSet"
}

{
 "description": "Browse and filter ideas in the ASTGL idea journal by status, priority, or source.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum ideas to return (default: 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "priority": {
    "description": "Filter by priority",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "source": {
    "description": "Filter by source",
    "enum": [
     "manual",
     "query-gap",
     "low-confidence",
     "trending",
     "alert"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "new",
     "in-progress",
     "published",
     "rejected"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_ideas"
}

{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Validate a storyboard against the engine schema without running anything. Pass exactly one of: dir (uses generated/storyboard.json), path (a storyboard file), or json (storyboard JSON as a string). relaxed makes narration optional (probe semantics).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dir": {
    "description": "demo dir \u2192 generated/storyboard.json",
    "type": "string"
   },
   "json": {
    "description": "storyboard JSON as a string",
    "type": "string"
   },
   "params": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "storyboard template params (name \u2192 value); each must be declared in the storyboard's params block. Substitutes {{name}} across all stages.",
    "type": "object"
   },
   "path": {
    "description": "path to a storyboard .json file",
    "type": "string"
   },
   "relaxed": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "validate_storyboard",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "message",
      "code"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "lint": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "type": "number"
      },
      "code": {
       "type": "string"
      },
      "fix": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "scene": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warn",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "severity",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sceneCount": {
    "type": "number"
   },
   "storyboardPath": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "valid": {
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "valid",
   "issues",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Validate a storyboard"
}

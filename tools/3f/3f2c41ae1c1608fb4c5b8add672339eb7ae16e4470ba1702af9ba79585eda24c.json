{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Preview Transaction Classification"
 },
 "description": "Preview how selected wallet movements would be grouped and labeled as accounting transactions. Returns every proposal in order and saves nothing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "operations": {
    "description": "Exact transfer-operation handles returned by transaction reads, including the accounting transaction each operation currently belongs to",
    "items": {
     "additionalProperties": false,
     "properties": {
      "portfolioTransactionId": {
       "description": "Accounting transaction the movement currently belongs to.",
       "minLength": 1,
       "type": "string"
      },
      "txIndex": {
       "description": "Position of the movement within that source transaction, from the same walletOperation.",
       "maximum": 2147483647,
       "minimum": 0,
       "type": "integer"
      },
      "walletTransactionId": {
       "description": "Source transaction the wallet movement belongs to, from a walletOperation in a read tool result.",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "portfolioTransactionId",
      "walletTransactionId",
      "txIndex"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "portfolioRef": {
    "description": "Portfolio name or slug inside that workspace. Call list_portfolios to resolve it.",
    "minLength": 1,
    "type": "string"
   },
   "workspaceRef": {
    "description": "Workspace name or slug. Call list_workspaces to resolve it.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "workspaceRef",
   "portfolioRef",
   "operations"
  ],
  "type": "object"
 },
 "name": "preview_transaction_classification",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "transactions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "operationType": {
       "enum": [
        "DEPOSIT_FIAT",
        "INCOME",
        "REFUND",
        "WITHDRAWAL_FIAT",
        "EXPENSE",
        "BUY",
        "SELL",
        "EXCHANGE",
        "SWAP",
        "MOVE",
        "INTERCOMPANY_SEND",
        "INTERCOMPANY_RECEIVE",
        "STAKE",
        "UNSTAKE",
        "PROTOCOL_DEPOSIT",
        "PROTOCOL_WITHDRAW",
        "VAULT_DEPOSIT",
        "VAULT_WITHDRAW",
        "LP_IN",
        "LP_OUT",
        "LOAN_BORROW",
        "LOAN_REPAY",
        "LOAN_LIQUIDATION",
        "LEND_GIVE",
        "LEND_WITHDRAW",
        "ADJUSTMENT",
        "UNCATEGORIZED",
        "SPAM"
       ],
       "type": "string"
      },
      "operations": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "portfolioTransactionId": {
          "minLength": 1,
          "type": "string"
         },
         "txIndex": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
         },
         "walletTransactionId": {
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "portfolioTransactionId",
         "walletTransactionId",
         "txIndex"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "subType": {
       "type": "string"
      },
      "systemNotes": {
       "type": "string"
      },
      "timestamp": {
       "format": "date-time",
       "type": "string"
      }
     },
     "required": [
      "operationType",
      "timestamp",
      "operations"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "transactions"
  ],
  "type": "object"
 },
 "title": "Preview Transaction Classification"
}

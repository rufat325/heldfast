{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Compare two values (e.g. amount > 1000) and return the True or False branch. Free, no token.",
 "inputSchema": {
  "properties": {
   "label": {
    "type": "string"
   },
   "left": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ],
    "description": "Left-hand value \u2014 a literal or a value from a previous step."
   },
   "operator": {
    "description": "How to compare, e.g. \">\" for \"Invoice amount > 1000\".",
    "enum": [
     ">",
     ">=",
     "<",
     "<=",
     "equals",
     "not_equals",
     "contains"
    ],
    "type": "string"
   },
   "right": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ],
    "description": "Right-hand value to compare against."
   }
  },
  "required": [
   "left",
   "operator",
   "right"
  ],
  "type": "object"
 },
 "name": "core_condition",
 "outputSchema": {
  "properties": {
   "data": {
    "type": "object"
   },
   "kind": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "data"
  ],
  "type": "object"
 }
}

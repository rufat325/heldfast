{
 "description": "Create a Wan task on RunAPI (text to video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acceleration": {
    "type": "string"
   },
   "aspect_ratio": {
    "type": "string"
   },
   "background_audio_url": {
    "type": "string"
   },
   "callback_url": {
    "type": "string"
   },
   "duration_seconds": {
    "type": "number"
   },
   "enable_prompt_expansion": {
    "type": "boolean"
   },
   "enable_safety_checker": {
    "type": "boolean"
   },
   "first_frame_image_url": {
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "wan-2.2-a14b-text-to-video-turbo",
     "wan-2.5-text-to-video",
     "wan-2.6-text-to-video",
     "wan-2.7-r2v",
     "wan-2.7-text-to-video"
    ],
    "type": "string"
   },
   "negative_prompt": {
    "type": "string"
   },
   "output_resolution": {
    "enum": [
     "480p",
     "580p",
     "720p",
     "1080p"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "ratio": {
    "type": "string"
   },
   "reference_audio_url": {
    "type": "string"
   },
   "reference_image_urls": {
    "items": {},
    "type": "array"
   },
   "reference_video_urls": {
    "items": {},
    "type": "array"
   },
   "seed": {
    "type": "number"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   },
   "watermark": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "text_to_video"
}

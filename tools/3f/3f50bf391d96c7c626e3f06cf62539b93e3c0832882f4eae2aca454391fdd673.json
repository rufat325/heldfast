{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Full-text search across all ontologies (or one).",
 "inputSchema": {
  "examples": [
   {
    "query": "diabetes"
   },
   {
    "exact": true,
    "ontology": "efo",
    "query": "cancer",
    "rows": 50
   }
  ],
  "properties": {
   "exact": {
    "description": "Exact-match (default false).",
    "type": "boolean"
   },
   "ontology": {
    "description": "Restrict to one ontology id (optional).",
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "rows": {
    "description": "1-1000 (default 20).",
    "type": "number"
   },
   "type": {
    "description": "class | property | individual",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "description": "Full-text search results across ontologies",
  "properties": {
   "response": {
    "description": "Search response containing matching terms",
    "properties": {
     "docs": {
      "description": "Array of matching term documents",
      "items": {
       "description": "Term search result with IRI, label, and ontology info",
       "type": "object"
      },
      "type": "array"
     },
     "numFound": {
      "description": "Total number of matches found",
      "type": "number"
     },
     "rows": {
      "description": "Number of results returned",
      "type": "number"
     },
     "start": {
      "description": "Starting position in result set",
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Search",
 "version": "v1.38beeb23"
}

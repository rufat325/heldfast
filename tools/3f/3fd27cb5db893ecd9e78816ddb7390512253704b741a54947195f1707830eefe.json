{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Preview Mogrt Batch"
 },
 "description": "Preview up to 20 bounded MOGRT recipe exports from a workspace-contained JSON or CSV data file. It does not contact Adobe or create any compositions or files.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "approved_workspace_path": {
    "description": "Absolute operator-approved workspace root.",
    "type": "string"
   },
   "brand_kit": {
    "additionalProperties": false,
    "description": "Optional validated brand-kit values applied to every batch recipe.",
    "properties": {
     "accent_color": {
      "type": "string"
     },
     "font_family": {
      "type": "string"
     },
     "logo_path": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "name_prefix": {
      "type": "string"
     },
     "safe_margin_percent": {
      "type": "number"
     },
     "text_color": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "data_file_path": {
    "description": "Existing workspace-contained .json or .csv file with recipe rows.",
    "type": "string"
   },
   "output_directory": {
    "description": "Existing workspace-contained directory for every batch artifact.",
    "type": "string"
   }
  },
  "required": [
   "approved_workspace_path",
   "output_directory",
   "data_file_path"
  ],
  "type": "object"
 },
 "name": "preview_mogrt_batch",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Preview Mogrt Batch"
}

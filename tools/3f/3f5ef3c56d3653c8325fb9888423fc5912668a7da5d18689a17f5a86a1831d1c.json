{
 "description": "List all blockchain networks supported by Printr MCP. Returns chain IDs, names, native token info, and RPC availability.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "printr_supported_chains",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chains": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "chain_id": {
       "description": "CAIP-2 chain ID",
       "type": "string"
      },
      "decimals": {
       "description": "Native token decimals",
       "type": "number"
      },
      "has_rpc": {
       "description": "Whether a default RPC endpoint is configured",
       "type": "boolean"
      },
      "name": {
       "description": "Human-readable chain name",
       "type": "string"
      },
      "symbol": {
       "description": "Native token symbol",
       "type": "string"
      }
     },
     "required": [
      "chain_id",
      "name",
      "symbol",
      "decimals",
      "has_rpc"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "chains"
  ],
  "type": "object"
 }
}

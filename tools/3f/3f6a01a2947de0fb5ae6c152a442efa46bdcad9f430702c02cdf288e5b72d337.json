{
 "description": "Enables or bypasses a device on a track. Useful for A/B comparison. Always confirm with the user before toggling.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "active": {
    "description": "true = device on, false = bypassed",
    "type": "boolean"
   },
   "device_name": {
    "type": "string"
   },
   "track_name": {
    "type": "string"
   }
  },
  "required": [
   "track_name",
   "device_name",
   "active"
  ],
  "type": "object"
 },
 "name": "toggle_device_bypass"
}

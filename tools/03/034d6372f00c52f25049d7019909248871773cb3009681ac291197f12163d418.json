{
 "description": "List GitHub dispatch delivery history for a project.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "projectId": {
    "type": "string"
   },
   "status": {
    "enum": [
     "pending",
     "retrying",
     "delivered",
     "failed",
     "skipped"
    ],
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId"
  ],
  "type": "object"
 },
 "name": "list_github_deliveries"
}

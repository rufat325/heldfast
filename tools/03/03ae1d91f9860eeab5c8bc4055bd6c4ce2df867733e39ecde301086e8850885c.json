{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List one bounded level of media-library folders and direct asset counts.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "description": "Maximum folders to return (1-50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Folder offset.",
    "minimum": 0,
    "type": "integer"
   },
   "parentFolderId": {
    "description": "Parent folder UUID, or null for root folders.",
    "format": "uuid",
    "type": "string"
   },
   "workspaceId": {
    "description": "Workspace UUID, or null for the default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "media_folders_list",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "bounds": {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "type": "number"
     },
     "maxLimit": {
      "type": "number"
     },
     "offset": {
      "type": "number"
     },
     "returned": {
      "type": "number"
     },
     "total": {
      "type": "number"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "limit",
     "maxLimit",
     "offset",
     "total",
     "returned",
     "hasMore",
     "truncated"
    ],
    "type": "object"
   },
   "folders": {
    "items": {
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "folders",
   "bounds"
  ],
  "type": "object"
 },
 "title": "List Media Folders"
}

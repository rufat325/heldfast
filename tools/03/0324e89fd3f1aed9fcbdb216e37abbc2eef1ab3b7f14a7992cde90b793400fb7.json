{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search across institutions, stocks, and insider traders in the ko.io SEC database. Institutions match by firm name OR manager name ('Seth Klarman' -> Baupost, 'Ackman' -> Pershing Square; person hits carry matched_person). Use this first when you have a name but need the CIK number, ticker, or slug to use with other tools.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "description": "Max results per category",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query \u2014 company name, ticker, person name, or institution name (min 2 characters)",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "congress": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "$ref": "#/properties/institutions/items/properties/cik"
      },
      "type": {
       "$ref": "#/properties/institutions/items/properties/cik"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "insiders": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "$ref": "#/properties/institutions/items/properties/cik"
      },
      "ticker": {
       "$ref": "#/properties/institutions/items/properties/cik"
      },
      "type": {
       "$ref": "#/properties/institutions/items/properties/cik"
      }
     },
     "required": [
      "name",
      "ticker",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "institutions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "aum": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
      },
      "category": {
       "$ref": "#/properties/institutions/items/properties/cik"
      },
      "cik": {
       "type": [
        "string",
        "null"
       ]
      },
      "matched_person": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "name": {
           "$ref": "#/properties/institutions/items/properties/cik"
          },
          "role": {
           "$ref": "#/properties/institutions/items/properties/cik"
          }
         },
         "required": [
          "name",
          "role"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "$ref": "#/properties/institutions/items/properties/cik"
      },
      "rank": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "slug": {
       "$ref": "#/properties/institutions/items/properties/cik"
      }
     },
     "required": [
      "cik",
      "name",
      "slug",
      "category",
      "aum",
      "rank",
      "matched_person"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "stocks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "industry": {
       "$ref": "#/properties/institutions/items/properties/cik"
      },
      "market_cap": {
       "$ref": "#/properties/institutions/items/properties/aum"
      },
      "name": {
       "$ref": "#/properties/institutions/items/properties/cik"
      },
      "sector": {
       "$ref": "#/properties/institutions/items/properties/cik"
      },
      "ticker": {
       "$ref": "#/properties/institutions/items/properties/cik"
      }
     },
     "required": [
      "ticker",
      "name",
      "sector",
      "industry",
      "market_cap"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "institutions",
   "stocks",
   "insiders",
   "congress"
  ],
  "type": "object"
 }
}

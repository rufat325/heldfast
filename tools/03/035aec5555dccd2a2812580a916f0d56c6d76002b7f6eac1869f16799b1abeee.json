{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Recall recent messages from conversation history. Returns newest first.",
 "inputSchema": {
  "properties": {
   "before": {
    "description": "Cursor: return messages before this message ID",
    "type": "string"
   },
   "limit": {
    "description": "Number of messages to return (default: 20)",
    "type": "number"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   }
  },
  "required": [
   "spaceId"
  ],
  "type": "object"
 },
 "name": "memory_recall",
 "outputSchema": {
  "properties": {
   "encrypted": {
    "description": "True if the space is end-to-end encrypted (content is ciphertext)",
    "type": "boolean"
   },
   "messages": {
    "description": "Recalled messages, newest first",
    "items": {
     "properties": {
      "_id": {
       "description": "Message ID",
       "type": "string"
      },
      "content": {
       "description": "Message text",
       "type": "string"
      },
      "createdAt": {
       "description": "ISO 8601 creation timestamp",
       "type": "string"
      },
      "metadata": {
       "description": "Optional caller-supplied metadata",
       "type": "object"
      },
      "role": {
       "description": "Message role: user, assistant, system, or tool",
       "type": "string"
      },
      "seq": {
       "description": "Monotonic sequence number within the space",
       "type": "number"
      },
      "spaceId": {
       "description": "Owning memory space ID",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 }
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List messages sent by this address (including unsent drafts, shown with time null), newest first, with per-recipient delivery state. Use delivery_status for one message's detail.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_reactions": {
    "default": false,
    "description": "also list reaction messages (normally hidden)",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "page size (host maximum 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "number of newest messages to skip",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_sent",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "messages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "added": {
       "description": "recipients added later via add-to",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "attachments": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "filename": {
          "type": "string"
         },
         "size": {
          "type": "number"
         }
        },
        "required": [
         "filename",
         "size"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "delivery": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "addr": {
          "type": "string"
         },
         "code": {
          "type": [
           "number",
           "null"
          ]
         },
         "status": {
          "enum": [
           "delivered",
           "pending",
           "failed"
          ],
          "type": "string"
         },
         "time": {
          "type": [
           "string",
           "null"
          ]
         },
         "via": {
          "enum": [
           "to",
           "add_to"
          ],
          "type": "string"
         }
        },
        "required": [
         "addr",
         "status",
         "time",
         "code",
         "via"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "from": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "important": {
       "type": "boolean"
      },
      "no_reply": {
       "type": "boolean"
      },
      "pid": {
       "type": [
        "string",
        "null"
       ]
      },
      "preview": {
       "type": "string"
      },
      "reactions": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "emoji": {
          "type": "string"
         },
         "from": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "emoji",
         "from"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "read": {
       "description": "null when not applicable (your own sent messages)",
       "type": [
        "boolean",
        "null"
       ]
      },
      "size": {
       "type": "number"
      },
      "terminal": {
       "type": "boolean"
      },
      "time": {
       "description": "ISO-8601; null for drafts",
       "type": [
        "string",
        "null"
       ]
      },
      "time_posix": {
       "type": [
        "number",
        "null"
       ]
      },
      "to": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "topic": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "pid",
      "from",
      "to",
      "added",
      "topic",
      "time",
      "time_posix",
      "read",
      "important",
      "no_reply",
      "terminal",
      "type",
      "size",
      "preview",
      "attachments",
      "reactions",
      "delivery"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_offset": {
    "type": [
     "number",
     "null"
    ]
   },
   "offset": {
    "type": "number"
   }
  },
  "required": [
   "messages",
   "count",
   "offset",
   "next_offset"
  ],
  "type": "object"
 },
 "title": "List sent messages"
}

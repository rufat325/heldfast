 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search Austrian district administrative authority announcements (Kundmachungen der Bezirksverwaltungsbeh\u00f6rden).\n\nUse this tool to find announcements and ordinances from district administrative authorities.\n\nNote: Only certain states publish here: Nieder\u00f6sterreich, Ober\u00f6sterreich, Tirol, Vorarlberg, Burgenland, Steiermark.\n\nExample queries:\n  - bundesland=\"Nieder\u00f6sterreich\", suchworte=\"Bauordnung\"\n  - bezirksverwaltungsbehoerde=\"Bezirkshauptmannschaft Innsbruck\"",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bezirksverwaltungsbehoerde": {
    "description": "District authority name (e.g., \"Bezirkshauptmannschaft Innsbruck\", \"Bezirkshauptmannschaft Amstetten\")",
    "maxLength": 200,
    "type": "string"
   },
   "bundesland": {
    "description": "Filter by state - Burgenland, K\u00e4rnten, Nieder\u00f6sterreich, Ober\u00f6sterreich, Salzburg, Steiermark, Tirol, Vorarlberg, Wien",
    "enum": [
     "Wien",
     "Nieder\u00f6sterreich",
     "Ober\u00f6sterreich",
     "Steiermark",
     "Tirol",
     "K\u00e4rnten",
     "Salzburg",
     "Vorarlberg",
     "Burgenland"
    ],
    "type": "string"
   },
   "im_ris_seit": {
    "description": "Filter by time in RIS",
    "enum": [
     "EinerWoche",
     "ZweiWochen",
     "EinemMonat",
     "DreiMonaten",
     "SechsMonaten",
     "EinemJahr"
    ],
    "type": "string"
   },
   "kundmachungsdatum_bis": {
    "description": "Announcement date to (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "kundmachungsdatum_von": {
    "description": "Announcement date from (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "kundmachungsnummer": {
    "description": "Announcement number",
    "maxLength": 100,
    "type": "string"
   },
   "limit": {
    "anyOf": [
     {
      "const": 10,
      "type": "number"
     },
     {
      "const": 20,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     },
     {
      "const": 100,
      "type": "number"
     }
    ],
    "default": 20,
    "description": "Results per page: 10, 20, 50 or 100 (default: 20). Every hit costs about 1k characters of structured payload, so prefer 20 for browsing and 50 for a broad survey; a page that would exceed the payload budget is delivered at the next smaller page size and says so (page_size, query.limit and notice)."
   },
   "response_format": {
    "default": "markdown",
    "description": "\"markdown\" (default) or \"json\"",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "seite": {
    "default": 1,
    "description": "Page number (default: 1)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "suchworte": {
    "description": "Full-text search terms",
    "maxLength": 1000,
    "type": "string"
   },
   "titel": {
    "description": "Search in titles",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ris_bezirke",

    "properties": {
     "tool": {
      "description": "Name of the tool that produced this result \u2014 call it again to paginate",
      "type": "string"
     }
    },
    "required": [
     "tool"
    ],
    "type": "object"
   },
   "total_hits": {
    "description": "Total number of documents in RIS matching the search",
    "type": "number"
   }
  },
  "required": [
   "total_hits",
   "page",
   "page_size",
   "has_more",
   "documents"
  ],
  "type": "object"
 },
 "title": "Bezirksverwaltungsbeh\u00f6rden durchsuchen"
}

{
 "description": "Get personalized model recommendations based on use case, budget, and requirements. Returns top 3 picks with reasoning (~350 tokens).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "max_input_price": {
    "description": "Max input price in USD per 1M tokens",
    "type": "number"
   },
   "max_output_price": {
    "description": "Max output price in USD per 1M tokens",
    "type": "number"
   },
   "min_context": {
    "description": "Minimum context window in tokens",
    "type": "number"
   },
   "min_release_date": {
    "description": "Minimum release date (YYYY-MM-DD). Excludes older models",
    "type": "string"
   },
   "require_open_source": {
    "description": "Require open-source license",
    "type": "boolean"
   },
   "require_tools": {
    "description": "Require function/tool calling support",
    "type": "boolean"
   },
   "require_vision": {
    "description": "Require vision/image input support",
    "type": "boolean"
   },
   "use_case": {
    "description": "Primary use case",
    "enum": [
     "coding",
     "math",
     "general",
     "vision",
     "creative",
     "reasoning",
     "cost-effective"
    ],
    "type": "string"
   }
  },
  "required": [
   "use_case"
  ],
  "type": "object"
 },
 "name": "recommend_model"
}

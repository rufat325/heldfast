 },
 "description": "Full-text search the ChEMBL drug-discovery database for molecules, targets, assays, or documents; returns ChEMBL IDs and summary fields you can pass to `molecule`, `target`, or `activities`. Pair with `chembl_mechanism`, which takes a drug name directly and returns its mechanism of action and target.",
 "inputSchema": {
  "examples": [
   {
    "query": "aspirin"
   },
   {
    "limit": 50,
    "query": "kinase inhibitor",
    "type": "molecule"
   }
  ],
  "properties": {
   "limit": {
    "description": "1-1000 (default 25).",
    "type": "number"
   },
   "query": {
    "description": "Free-text query.",
    "type": "string"
   },
   "type": {
    "description": "molecule (default) | target | assay | document",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "description": "Search results from ChEMBL database",
  "properties": {
   "assays": {
    "description": "Assay search results",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "documents": {
    "description": "Document search results",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "molecules": {
    "description": "Molecule search results",
    "items": {
     "properties": {
      "molecule_chembl_id": {
       "type": "string"
      },
      "molecule_structures": {
       "type": "object"
      },
      "molecule_type": {
       "type": [
        "string",
        "null"
       ]
      },
      "pref_name": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "page_meta": {

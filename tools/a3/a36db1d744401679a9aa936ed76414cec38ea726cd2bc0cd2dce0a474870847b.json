{
 "description": "Wait for a UI element to appear on screen. Polls every 500ms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "by": {
    "description": "How to find the element",
    "enum": [
     "resource-id",
     "text",
     "content-desc"
    ],
    "type": "string"
   },
   "device_id": {
    "description": "Device ID (optional if only one device)",
    "type": "string"
   },
   "timeout_ms": {
    "default": 10000,
    "description": "Timeout in ms (default 10000)",
    "type": "number"
   },
   "value": {
    "description": "Value to match",
    "type": "string"
   }
  },
  "required": [
   "by",
   "value"
  ],
  "type": "object"
 },
 "name": "wait_for_element"
}

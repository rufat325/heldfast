{
 "description": "Simulate movement along a custom route with waypoints. Specify GPS coordinates and speed for realistic location testing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "speed": {
    "description": "Speed in meters/second (default: ~walking speed)",
    "type": "number"
   },
   "waypoints": {
    "description": "Array of {lat, lng} waypoints to traverse",
    "items": {
     "additionalProperties": false,
     "properties": {
      "lat": {
       "description": "Latitude",
       "type": "number"
      },
      "lng": {
       "description": "Longitude",
       "type": "number"
      }
     },
     "required": [
      "lat",
      "lng"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "waypoints"
  ],
  "type": "object"
 },
 "name": "simulator_location_route"
}

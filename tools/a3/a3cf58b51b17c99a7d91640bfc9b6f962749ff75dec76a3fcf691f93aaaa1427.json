{
 "description": "Read local image bytes at the MCP boundary, upload them through Local HTTP as Base64 onto a persisted review note image field (App compresses to WebP \u2264300KB). Optionally place the field on a card front/back layout via cardId+layoutSide. The file path is not sent to or opened by the Granoflow app.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cardId": {
    "minLength": 1,
    "type": "string"
   },
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "ensureField": {
    "default": true,
    "type": "boolean"
   },
   "fieldKey": {
    "default": "custom_uit_screenshot",
    "minLength": 1,
    "type": "string"
   },
   "fieldLabel": {
    "default": "UIT screenshot",
    "minLength": 1,
    "type": "string"
   },
   "fieldType": {
    "default": "image",
    "enum": [
     "image",
     "image_grid"
    ],
    "type": "string"
   },
   "filePath": {
    "minLength": 1,
    "type": "string"
   },
   "layoutSide": {
    "default": "back",
    "enum": [
     "front",
     "back"
    ],
    "type": "string"
   },
   "noteId": {
    "minLength": 1,
    "type": "string"
   },
   "slot": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "noteId",
   "filePath"
  ],
  "type": "object"
 },
 "name": "granoflow_review_note_field_media_upload"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Compare coworking spaces side by side"
 },
 "description": "Fetches full details for 2 to 5 coworking spaces at once and returns them side by side, ready to compare on price, capacity, amenities and rating \u2014 the tool to use instead of calling get_coworking_space once per space in a row, which wastes tokens on repeated boilerplate for the exact same result. Takes slugs, not display names: resolve each one with resolve_coworking_query or search_coworking_spaces first. If one slug does not exist, the others are still returned along with which one failed and why \u2014 the whole comparison never fails just because of one bad slug.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://mcp.coworkingview.com/icons/compare-light.svg",
   "theme": "light"
  },
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://mcp.coworkingview.com/icons/compare-dark.svg",
   "theme": "dark"
  }
 ],
 "inputSchema": {

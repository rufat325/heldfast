    "default": "concise",
    "description": "'concise' gives one representative price per workspace type for each space. 'full' gives every pricing option \u2014 use it when the user is down to these specific spaces and needs the complete price list.",
    "enum": [
     "concise",
     "full"
    ],
    "type": "string"
   },
   "locale": {
    "default": "en",
    "description": "Language for names and descriptions. Set from the user's language: 'de' for German, 'es' for Spanish, otherwise 'en'.",
    "enum": [
     "en",
     "de",
     "es"
    ],
    "type": "string"
   },
   "slugs": {
    "description": "Between 2 and 5 space slugs, exactly as returned by another tool.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "slugs"
  ],
  "type": "object"
 },
 "name": "compare_coworking_spaces",

{
 "description": "Query the guardrail decisions ledger for recent governed actions. Filter by agent, action type, decision verdict, or time window. Use for in-session retrospection \u2014 \"what have I done recently?\"",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action_type": {
    "type": "string"
   },
   "agent_id": {
    "type": "string"
   },
   "decision": {
    "enum": [
     "allow",
     "warn",
     "block",
     "require_approval"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 20)",
    "type": "integer"
   },
   "since": {
    "description": "ISO timestamp lower bound",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "dashclaw_decisions_recent"
}

  "additionalProperties": false,
  "properties": {
   "caveats": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "framework": {
    "type": "string"
   },
   "notice": {
    "additionalProperties": false,
    "description": "Present ONLY when the request was denied by usage policy instead of executed. When present, every other field is an empty placeholder and must not be reported as a framework.",
    "properties": {
     "message": {
      "type": "string"
     },
     "status": {
      "const": "usage_limit_reached",
      "type": "string"
     },
     "upgrade_url": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "message",
     "upgrade_url"
    ],
    "type": "object"
   },
   "output_schema": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "quality_rubric": {
    "additionalProperties": false,
    "properties": {
     "common_failure_modes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "good_looks_like": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [

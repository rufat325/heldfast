{
 "description": "Simulate thermal pressure changes (nominal, fair, serious, critical). Test how your app responds to device overheating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "level": {
    "description": "Thermal pressure level to simulate",
    "enum": [
     "nominal",
     "fair",
     "serious",
     "critical"
    ],
    "type": "string"
   }
  },
  "required": [
   "level"
  ],
  "type": "object"
 },
 "name": "simulator_thermal_state"
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Place an audio asset onto a BlitzReels project timeline at a timestamp for voiceover, music, or sound.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "description": "Audio media asset ID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "durationSeconds": {
    "description": "Optional duration. Required if the audio asset duration is not known yet.",
    "minimum": 0,
    "type": "number"
   },
   "fadeInSeconds": {
    "default": 0,
    "description": "Fade-in length in seconds",
    "minimum": 0,
    "type": "number"
   },
   "fadeOutSeconds": {
    "default": 0,
    "description": "Fade-out length in seconds",
    "minimum": 0,
    "type": "number"
   },
   "loop": {
    "default": false,
    "description": "Loop audio to fill requested duration",
    "type": "boolean"
   },
   "projectId": {
    "description": "BlitzReels project ID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "startSeconds": {
    "default": 0,
    "description": "Timeline start time in seconds",
    "minimum": 0,
    "type": "number"
   },
   "volume": {
    "default": 1,
    "description": "Audio volume multiplier, 1 is normal",
    "type": "number"
   }
  },
  "required": [
   "projectId",
   "assetId"
  ],
  "type": "object"
 },
 "name": "timeline_audio_add",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Add Audio To Timeline"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Free preview of a paid capability: checks whether useful data/analysis is available for a given input, before paying \u2014 proof of \"I have information for this request,\" never the paid analysis itself. No payment, charge or account is ever involved. Not every capability supports preview (status is \"unavailable\" when it doesn't). Recommended flow: discover -> preview -> evaluate -> pay -> execute.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "description": "A capability name from this tool list, e.g. \"research_company\".",
    "type": "string"
   },
   "input": {
    "description": "The same input the paid capability accepts. Optional for a capability whose preview needs no input fields."
   }
  },
  "required": [
   "capability"
  ],
  "type": "object"
 },
 "name": "preview_capability",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "type": "string"
   },
   "fullResult": {
    "additionalProperties": false,
    "properties": {
     "capability": {
      "type": "string"
     },
     "endpoint": {
      "type": "string"
     },
     "paymentMethods": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "enabled": {
         "const": true,
         "type": "boolean"
        },
        "endpoint": {
         "type": "string"
        },
        "id": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "enabled",
        "endpoint"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "price": {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "type": "string"
       },
       "currency": {
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency"
      ],
      "type": "object"
     }
    },
    "required": [
     "capability",
     "price"
    ],
    "type": "object"
   },
   "inputRecognized": {
    "type": "boolean"
   },
   "preview": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "status": {
    "enum": [
     "available",
     "limited",
     "unavailable",
     "invalid_input"
    ],
    "type": "string"
   }
  },
  "required": [
   "capability",
   "status",
   "inputRecognized",
   "preview",
   "fullResult"
  ],
  "type": "object"
 }
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update pipeline-state.json. Use dot-notation paths to set values. Can create new pipelines and rapid tests.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget": {
    "description": "For rapid tests: test budget (default: 75)",
    "type": "number"
   },
   "create_pipeline": {
    "description": "If true, creates a new pipeline entry if it doesn't exist",
    "type": "boolean"
   },
   "create_rapid_test": {
    "description": "If true, creates a new rapid test entry",
    "type": "boolean"
   },
   "duration_days": {
    "description": "For rapid tests: test duration (default: 5)",
    "type": "number"
   },
   "idea": {
    "description": "For rapid tests: the original idea description",
    "type": "string"
   },
   "market_name": {
    "description": "The market/pipeline slug",
    "type": "string"
   },
   "path": {
    "description": "Dot-notation path to update, e.g. 'pipelines.my-market.layer_1.scout.status'",
    "type": "string"
   },
   "value": {
    "description": "The value to set at the path"
   }
  },
  "required": [
   "market_name",
   "path"
  ],
  "type": "object"
 },
 "name": "update_pipeline_state"
}

{
 "description": "Create an ACF field group with fields",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "description": "Array of field definitions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "default_value": {
       "default": "",
       "type": "string"
      },
      "instructions": {
       "default": "",
       "type": "string"
      },
      "key": {
       "description": "Field key (auto-generated if omitted)",
       "type": "string"
      },
      "label": {
       "description": "Field label",
       "type": "string"
      },
      "name": {
       "description": "Field name",
       "type": "string"
      },
      "required": {
       "default": 0,
       "description": "1 = required",
       "type": "number"
      },
      "settings": {
       "additionalProperties": {},
       "description": "ACF field settings (choices, min, max, etc.)",
       "type": "object"
      },
      "type": {
       "default": "text",
       "description": "Field type",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hide_on_screen": {
    "default": [],
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "key": {
    "description": "Field group key (auto-generated if omitted)",
    "type": "string"
   },
   "location": {
    "description": "Location rules (defaults to post_type == post)",
    "items": {
     "items": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "type": "array"
    },
    "type": "array"
   },
   "position": {
    "default": "normal",
    "enum": [
     "normal",
     "acf_after_title",
     "side"
    ],
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "style": {
    "default": "default",
    "enum": [
     "default",
     "seamless"
    ],
    "type": "string"
   },
   "title": {
    "description": "Field group title",
    "type": "string"
   }
  },
  "required": [
   "site",
   "title",
   "fields"
  ],
  "type": "object"
 },
 "name": "acf_create_field_group"
}

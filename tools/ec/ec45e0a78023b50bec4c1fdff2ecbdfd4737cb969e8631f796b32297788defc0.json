{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Task-to-Slot Schedule Optimizer"
 },
 "description": "Assign tasks to time slots to maximize total score by matching each task's energy requirement to a slot's energy level (and respecting duration). Use for deep-work blocking, shift or session planning, or any task-to-slot fit where high-energy work should land in high-energy slots. Returns the assignments, any unassigned task IDs, and a total score. For arbitrary linear constraints use solve_constraints; for routing use plan_pathfind.",
 "inputSchema": {
  "properties": {
   "slots": {
    "items": {
     "properties": {
      "durationMinutes": {
       "description": "Slot duration in minutes.",
       "type": "number"
      },
      "energyLevel": {
       "description": "Slot energy level.",
       "enum": [
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "startTime": {
       "description": "Slot start as a Unix timestamp (number, not a string like '09:00').",
       "type": "number"
      }
     },
     "required": [
      "id",
      "startTime",
      "durationMinutes",
      "energyLevel"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "tasks": {
    "items": {
     "properties": {
      "category": {
       "description": "Optional.",
       "type": "string"
      },
      "deadline": {
       "description": "Optional. Unix timestamp (ms).",
       "type": "number"
      },
      "durationMinutes": {
       "description": "Required duration in minutes.",
       "type": "number"
      },
      "energyRequired": {
       "description": "Energy demand.",
       "enum": [
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "priority": {
       "description": "Higher = more important.",
       "type": "number"
      }
     },
     "required": [
      "id",
      "name",
      "durationMinutes",
      "priority",
      "energyRequired"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "tasks",
   "slots"
  ],
  "type": "object"
 },
 "name": "solve_schedule",
 "outputSchema": {
  "properties": {
   "assignments": {
    "items": {
     "properties": {
      "score": {
       "type": "number"
      },
      "slotId": {
       "type": "string"
      },
      "taskId": {
       "type": "string"
      }
     },
     "required": [
      "taskId",
      "slotId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalScore": {
    "type": "number"
   },
   "unassignedTasks": {
    "description": "Task IDs that did not fit.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "assignments"
  ],
  "type": "object"
 }
}

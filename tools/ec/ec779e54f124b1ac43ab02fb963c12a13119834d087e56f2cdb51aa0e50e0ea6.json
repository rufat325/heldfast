{
 "description": "Search Google Shopping for products with prices across retailers. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device.",
    "enum": [
     "desktop",
     "mobile"
    ],
    "type": "string"
   },
   "free_shipping": {
    "description": "Free shipping only.",
    "type": "boolean"
   },
   "gl": {
    "description": "Country, e.g. 'us'.",
    "type": "string"
   },
   "google_domain": {
    "description": "e.g. 'google.co.uk'.",
    "type": "string"
   },
   "hl": {
    "description": "Language, e.g. 'en'.",
    "type": "string"
   },
   "location": {
    "description": "Location name, auto-encoded to UULE.",
    "type": "string"
   },
   "max_price": {
    "description": "Max price.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "min_price": {
    "description": "Min price.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "on_sale": {
    "description": "On sale only.",
    "type": "boolean"
   },
   "query": {
    "description": "Product query.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "shoprs": {
    "description": "Shopping filter token.",
    "type": "string"
   },
   "sort_by": {
    "description": "0=relevance, 1=price asc, 2=price desc.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "start": {
    "description": "Result offset.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "uule": {
    "description": "UULE string, overrides location.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "google_shopping"
}

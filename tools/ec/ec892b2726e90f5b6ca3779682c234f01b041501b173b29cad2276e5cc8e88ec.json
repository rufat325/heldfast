{
 "description": "Create a bank transaction (SPEND = money out, RECEIVE = money in) directly on a bank account \u2014 for transactions without a matching invoice/bill (fees, transfers, one-off expenses).",
 "inputSchema": {
  "properties": {
   "BankAccount": {
    "description": "Bank account reference \u2014 provide AccountID or Code.",
    "properties": {
     "AccountID": {
      "description": "Xero Account UUID (Type=BANK).",
      "type": "string"
     },
     "Code": {
      "description": "Account code (alternative to AccountID).",
      "type": "string"
     }
    },
    "type": "object"
   },
   "Contact": {
    "description": "Contact reference \u2014 provide ContactID.",
    "properties": {
     "ContactID": {
      "description": "Xero Contact UUID.",
      "type": "string"
     }
    },
    "required": [
     "ContactID"
    ],
    "type": "object"
   },
   "CurrencyCode": {
    "description": "ISO-4217 currency code.",
    "type": "string"
   },
   "Date": {
    "description": "Transaction date YYYY-MM-DD.",
    "type": "string"
   },
   "IsReconciled": {
    "description": "Mark as reconciled on creation.",
    "type": "boolean"
   },
   "LineAmountTypes": {
    "description": "Line amount tax treatment.",
    "enum": [
     "Exclusive",
     "Inclusive",
     "NoTax"
    ],
    "type": "string"
   },
   "LineItems": {
    "description": "Array of line items (Description, Quantity, UnitAmount, AccountCode, TaxType).",
    "type": "array"
   },
   "Reference": {
    "description": "Free-text reference.",
    "type": "string"
   },
   "Type": {
    "description": "Transaction type. SPEND/RECEIVE are the common values.",
    "enum": [
     "SPEND",
     "RECEIVE",
     "SPEND-OVERPAYMENT",
     "RECEIVE-OVERPAYMENT",
     "SPEND-PREPAYMENT",
     "RECEIVE-PREPAYMENT",
     "SPEND-TRANSFER",
     "RECEIVE-TRANSFER"
    ],
    "type": "string"
   }
  },
  "required": [
   "Type",
   "Contact",
   "BankAccount",
   "LineItems"
  ],
  "type": "object"
 },
 "name": "create_bank_transaction"
}

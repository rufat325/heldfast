{
 "description": "Submit a new agent, tool, or API entry to the AgentPedia knowledge base (requires API key)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capabilities": {
    "description": "List of capabilities",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "category": {
    "description": "Category this agent belongs to",
    "type": "string"
   },
   "documentation_url": {
    "description": "Optional URL to documentation",
    "type": "string"
   },
   "name": {
    "description": "The name of the agent or tool to submit",
    "type": "string"
   },
   "short_description": {
    "description": "Brief description (max 200 chars)",
    "type": "string"
   },
   "slug": {
    "description": "Unique slug identifier (lowercase, hyphens)",
    "type": "string"
   },
   "type": {
    "description": "Type of submission",
    "enum": [
     "agent",
     "api",
     "tool"
    ],
    "type": "string"
   },
   "website": {
    "description": "Optional URL to the agent or tool's homepage",
    "type": "string"
   }
  },
  "required": [
   "name",
   "slug",
   "type",
   "category",
   "short_description"
  ],
  "type": "object"
 },
 "name": "submit_agent"
}

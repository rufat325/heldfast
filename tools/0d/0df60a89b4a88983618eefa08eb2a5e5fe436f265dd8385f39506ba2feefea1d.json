{
 "description": "Decrypt a stored keystore wallet with its password and set it as the active wallet for its chain type. Once unlocked, signing tools use it automatically for the rest of the session (until the MCP server restarts).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "password": {
    "description": "Decryption password",
    "minLength": 1,
    "type": "string"
   },
   "wallet_id": {
    "description": "Keystore wallet ID \u2014 from printr_wallet_list",
    "type": "string"
   }
  },
  "required": [
   "wallet_id",
   "password"
  ],
  "type": "object"
 },
 "name": "printr_wallet_unlock",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Wallet address",
    "type": "string"
   },
   "chain": {
    "description": "CAIP-2 chain ID",
    "type": "string"
   }
  },
  "required": [
   "address",
   "chain"
  ],
  "type": "object"
 }
}

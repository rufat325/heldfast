{
 "description": "List workflow runs for a repository. Optionally filter by workflow or status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "owner": {
    "description": "Repository owner (username or org)",
    "type": "string"
   },
   "per_page": {
    "default": 10,
    "description": "Number of runs to return (default 10)",
    "type": "number"
   },
   "repo": {
    "description": "Repository name",
    "type": "string"
   },
   "status": {
    "description": "Filter by status: completed, in_progress, queued, etc.",
    "type": "string"
   },
   "workflow_id": {
    "description": "Workflow ID to filter runs (from list_workflows)",
    "type": "number"
   }
  },
  "required": [
   "owner",
   "repo"
  ],
  "type": "object"
 },
 "name": "list_runs"
}

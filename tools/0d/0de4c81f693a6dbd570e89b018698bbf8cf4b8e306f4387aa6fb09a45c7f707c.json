{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Lists Go packages or modules and returns structured information. When `modules` is true, lists modules (with path, version, dir); otherwise lists packages (with dir, importPath, name, goFiles, testGoFiles).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "deps": {
    "default": false,
    "description": "List not just the named packages but also all their transitive dependencies (-deps)",
    "type": "boolean"
   },
   "find": {
    "default": false,
    "description": "Find packages matching the patterns without resolving dependencies (-find). Faster for simple listing.",
    "type": "boolean"
   },
   "jsonFields": {
    "description": "Selective JSON fields for go1.22+ (-json=Field1,Field2). Reduces output volume for large workspaces.",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "modules": {
    "default": false,
    "description": "List modules instead of packages (-m). When true, output uses the modules field with path, version, dir, goMod, goVersion, main, indirect.",
    "type": "boolean"
   },
   "packages": {
    "default": [
     "./..."
    ],
    "description": "Package patterns to list (default: ['./...'])",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "tags": {
    "description": "Build tags that may affect which packages are listed (-tags)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "tolerateErrors": {
    "default": false,
    "description": "Tolerate errors in packages -- useful for listing packages in partially broken projects (-e)",
    "type": "boolean"
   },
   "updates": {
    "default": false,
    "description": "Show available module updates (-u). Requires module mode (-m) which will be auto-enabled.",
    "type": "boolean"
   },
   "versions": {
    "default": false,
    "description": "Show all known versions of each module (-versions). Requires module mode (-m) which will be auto-enabled.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "modules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dir": {
       "type": "string"
      },
      "goMod": {
       "type": "string"
      },
      "goVersion": {
       "type": "string"
      },
      "indirect": {
       "type": "boolean"
      },
      "main": {
       "type": "boolean"
      },
      "path": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "packageCount": {
    "type": "number"
   },
   "packages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dir": {
       "type": "string"
      },
      "error": {
       "additionalProperties": false,
       "properties": {
        "err": {
         "type": "string"
        }
       },
       "required": [
        "err"
       ],
       "type": "object"
      },
      "goFiles": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "importPath": {
       "type": "string"
      },
      "imports": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "module": {
       "additionalProperties": false,
       "properties": {
        "path": {
         "type": "string"
        },
        "version": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "stale": {
       "type": "boolean"
      },
      "standard": {
       "type": "boolean"
      },
      "testGoFiles": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "dir",
      "importPath",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Go List"
}

  "additionalProperties": false,
  "properties": {
   "requests": {
    "description": "Array of requests to synchronize",
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "description": "Request body",
       "type": "string"
      },
      "headers": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Additional headers as key-value pairs",
       "type": "object"
      },
      "method": {
       "description": "HTTP method",
       "type": "string"
      },
      "path": {
       "description": "Request path, e.g. /api/redeem",
       "type": "string"
      }
     },
     "required": [
      "method",
      "path"
     ],
     "type": "object"
    },
    "minItems": 2,
    "type": "array"
   },
   "target_url": {
    "description": "Base target URL, e.g. https://example.com",
    "type": "string"
   }
  },
  "required": [
   "target_url",
   "requests"
  ],
  "type": "object"
 },
 "name": "race_last_byte_sync"
}

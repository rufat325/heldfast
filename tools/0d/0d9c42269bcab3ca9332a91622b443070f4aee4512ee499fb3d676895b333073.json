{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create one media-library folder in a workspace and return a retry-safe mutation receipt.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Optional folder description.",
    "maxLength": 1000,
    "type": "string"
   },
   "iconType": {
    "default": "folder",
    "description": "Folder icon type.",
    "enum": [
     "folder",
     "code",
     "video",
     "audio",
     "image",
     "document",
     "star",
     "spark"
    ],
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "type": "string"
   },
   "name": {
    "description": "Folder name.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "parentFolderId": {
    "description": "Parent folder UUID, or null for the root.",
    "format": "uuid",
    "type": "string"
   },
   "workspaceId": {
    "description": "Workspace UUID, or null for the default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "media_folders_create",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "folder": {
    "type": "object"
   },
   "mutationReceipt": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ]
     },
     "operation": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "key",
     "operation",
     "status",
     "replayed"
    ],
    "type": "object"
   }
  },
  "required": [
   "folder",
   "mutationReceipt"
  ],
  "type": "object"
 },
 "title": "Create Media Folder"
}

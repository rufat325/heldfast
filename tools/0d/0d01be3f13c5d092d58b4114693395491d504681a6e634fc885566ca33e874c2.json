{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get water logs for a date. Requires nutrition scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "default": "today",
    "description": "Date as yyyy-MM-dd or today. ISO date-times are accepted and reduced to the written calendar day.",
    "type": "string"
   },
   "privacy_mode": {
    "description": "Optional per-call privacy override. Defaults to FITBIT_PRIVACY_MODE or structured. raw returns upstream Fitbit JSON. summary removes GPS/map details.",
    "enum": [
     "summary",
     "structured",
     "raw"
    ],
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "fitbit_get_water_day",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {},
   "endpoint": {
    "type": "string"
   },
   "privacy_mode": {
    "enum": [
     "summary",
     "structured",
     "raw"
    ],
    "type": "string"
   }
  },
  "required": [
   "endpoint",
   "privacy_mode",
   "data"
  ],
  "type": "object"
 },
 "title": "Fitbit Water Logs"
}

{
 "description": "Returns the text of a chunk from a page prepared earlier with sieve_page (same url).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Chunk id such as c3.",
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "id"
  ],
  "type": "object"
 },
 "name": "sieve_chunk",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "anchor": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "tokens": {
    "type": "number"
   }
  },
  "required": [
   "id",
   "text",
   "tokens"
  ],
  "type": "object"
 },
 "title": "Read one chunk"
}

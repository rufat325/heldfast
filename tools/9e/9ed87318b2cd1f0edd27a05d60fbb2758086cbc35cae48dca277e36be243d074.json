{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve a published reliability assessment and Spot Score for one provider. Provider aliases resolve to the canonical assessment. This is an editorial score for a stated role and scope, not an AM Best rating or a recommendation. Optional need runs a bounded editorial judgment over that assessment only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "need": {
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   },
   "provider": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "provider"
  ],
  "type": "object"
 },
 "name": "get_provider_score",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assessment": {
    "additionalProperties": false,
    "properties": {
     "canonicalUrl": {
      "format": "uri",
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "markdown": {
      "type": "string"
     },
     "pageType": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "path",
     "title",
     "description",
     "canonicalUrl",
     "pageType",
     "markdown",
     "truncated"
    ],
    "type": "object"
   },
   "found": {
    "type": "boolean"
   },
   "judgment": {
    "additionalProperties": false,
    "properties": {
     "addressesNeed": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "limitation": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "outcome": {
      "type": "string"
     },
     "qualification": {
      "type": "string"
     },
     "reason": {
      "enum": [
       "unsupported_request",
       "inference_unavailable",
       "quota_unavailable",
       "generation_failed",
       "generation_timeout",
       "invalid_judgment",
       "client_rate_limit",
       "daily_generation_limit"
      ],
      "type": "string"
     },
     "status": {
      "enum": [
       "judged",
       "unsupported",
       "limited",
       "unavailable"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "qualification"
    ],
    "type": "object"
   },
   "provider": {
    "type": "string"
   },
   "spotCallout": {
    "type": "string"
   }
  },
  "required": [
   "spotCallout",
   "found"
  ],
  "type": "object"
 },
 "title": "Get a published provider Spot Score"
}

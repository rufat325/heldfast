{
 "description": "Update the scheduled-scan configuration for the active organization. Only specified fields are changed; unspecified fields keep their current value. When schedule is \"custom\", customCron is required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "customCron": {
    "description": "Cron expression (required when schedule=custom).",
    "type": "string"
   },
   "enabled": {
    "description": "Enable or disable scheduled scans.",
    "type": "boolean"
   },
   "maxBudgetUSD": {
    "description": "Max budget per scheduled scan.",
    "maximum": 500,
    "minimum": 0.5,
    "type": "number"
   },
   "modelTier": {
    "description": "Model tier for scheduled scans.",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "postAsIssue": {
    "description": "Whether to open scan reports as repository issues.",
    "type": "boolean"
   },
   "repositoryIds": {
    "description": "List of repository ids to include in scheduled scans. Replaces the existing list.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "schedule": {
    "description": "Scan frequency. If \"custom\", provide customCron.",
    "enum": [
     "weekly",
     "monthly",
     "quarterly",
     "custom"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_security_config"
}

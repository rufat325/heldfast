      },
      "floors": {
       "type": [
        "number",
        "null"
       ]
      },
      "isGuildhall": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "rent": {
       "type": [
        "number",
        "null"
       ]
      },
      "rooms": {
       "type": [
        "number",
        "null"
       ]
      },
      "size": {
       "type": [
        "number",
        "null"
       ]
      },
      "street": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      }
     },
     "required": [

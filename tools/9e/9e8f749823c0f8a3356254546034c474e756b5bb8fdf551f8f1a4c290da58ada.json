{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find Tibia houses and guildhalls by city, rent, beds and size. Use this for questions like \"cheapest house in Thais with two beds\". Call tibia_get with a title for its location and position.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "beds_min": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "city": {
    "description": "Exact city name, e.g. \"Thais\", any case.",
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "type": "string"
   },
   "include_inactive": {
    "default": false,
    "type": "boolean"
   },
   "is_guildhall": {
    "type": "boolean"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "rent_max": {
    "description": "Highest monthly rent in gold.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "size_min": {
    "description": "Fewest tiles.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "default": "rent",
    "description": "rent ascends, size descends, title is alphabetical.",
    "enum": [
     "rent",
     "size",
     "title"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tibia_find_houses",

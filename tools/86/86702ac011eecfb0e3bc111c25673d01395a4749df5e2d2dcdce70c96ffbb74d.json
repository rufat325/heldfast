{
 "description": "Get top performing pages from Google Search Console for a site.",
 "inputSchema": {
  "properties": {
   "days": {
    "description": "1-90, default 28",
    "type": "number"
   },
   "page_size": {
    "description": "default 20, max 100",
    "type": "number"
   },
   "site_id": {
    "type": "string"
   },
   "sort_by": {
    "description": "default clicks",
    "enum": [
     "clicks",
     "impressions",
     "ctr",
     "position"
    ],
    "type": "string"
   }
  },
  "required": [
   "site_id"
  ],
  "type": "object"
 },
 "name": "get_gsc_pages"
}

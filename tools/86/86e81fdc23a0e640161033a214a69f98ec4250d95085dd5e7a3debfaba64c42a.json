{
 "description": "Search Google Hotels. Pass detail_token from results to google_hotels_detail. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amenities": {
    "description": "Amenity ids, comma-separated.",
    "type": "string"
   },
   "check_in_date": {
    "description": "YYYY-MM-DD.",
    "type": "string"
   },
   "check_out_date": {
    "description": "YYYY-MM-DD.",
    "type": "string"
   },
   "currency": {
    "description": "e.g. 'USD'.",
    "type": "string"
   },
   "eco_certified": {
    "description": "Eco-certified only.",
    "type": "boolean"
   },
   "free_cancellation": {
    "description": "Free cancellation only.",
    "type": "boolean"
   },
   "gl": {
    "description": "Country, e.g. 'us'.",
    "type": "string"
   },
   "hl": {
    "description": "Language, e.g. 'en'.",
    "type": "string"
   },
   "hotel_class": {
    "description": "Star ratings, e.g. '4,5'.",
    "type": "string"
   },
   "limit": {
    "description": "Results to return, 1-20.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "max_price": {
    "description": "Max nightly price.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "min_price": {
    "description": "Min nightly price.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "next_page_token": {
    "description": "Pagination cursor.",
    "type": "string"
   },
   "property_types": {
    "description": "Property-type ids, e.g. '12'.",
    "type": "string"
   },
   "query": {
    "description": "e.g. 'Austin hotels'.",
    "type": "string"
   },
   "rating": {
    "description": "7=3.5+, 8=4.0+, 9=4.5+.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sort_by": {
    "description": "3=lowest price, 8=highest rating, 13=most reviewed.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "special_offers": {
    "description": "Special offers only.",
    "type": "boolean"
   }
  },
  "required": [
   "query",
   "check_in_date",
   "check_out_date"
  ],
  "type": "object"
 },
 "name": "google_hotels"
}

{
 "description": "Search and filter transactions by sender, recipient, input object, changed object, or Move function.",
 "inputSchema": {
  "properties": {
   "filter": {
    "description": "Transaction filter. Examples: { \"FromAddress\": \"0x...\" }, { \"ToAddress\": \"0x...\" }, { \"InputObject\": \"0x...\" }, { \"ChangedObject\": \"0x...\" }, { \"MoveFunction\": { \"package\": \"0x2\", \"module\": \"coin\", \"function\": \"transfer\" } }",
    "type": "object"
   },
   "limit": {
    "description": "Max transactions (default: 50)",
    "type": "number"
   },
   "order": {
    "description": "Sort order (default: descending)",
    "enum": [
     "ascending",
     "descending"
    ],
    "type": "string"
   }
  },
  "required": [
   "filter"
  ],
  "type": "object"
 },
 "name": "query_transactions"
}

{
 "description": "Get records from an Infrabel dataset using the public ODS records endpoint.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "datasetId": {
    "description": "OpenDataSoft dataset identifier",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of records to return",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "where": {
    "description": "Optional ODS where clause",
    "type": "string"
   }
  },
  "required": [
   "datasetId"
  ],
  "type": "object"
 },
 "name": "infrabel_get_records"
}

 "description": "Fetch Level 2 corporate hierarchy for an LEI: direct parent, ultimate parent, and direct children. Use to map ownership trees across multinational groups. Accepts a company NAME as well as an LEI.",
 "inputSchema": {
  "examples": [
   {
    "lei": "5493001KJTIIGC8Y1R12"
   }
  ],
  "properties": {
   "lei": {
    "description": "20-character LEI code (e.g. \"HWUPKR0MPOU8FGXBT394\") OR the company NAME (e.g. \"Apple Inc\") \u2014 a name is resolved here automatically and the match is echoed back as resolved_from_name. Do not guess an LEI: a wrong-but-well-formed code used to return an empty hierarchy, which reads as \"this company has no parent or subsidiaries\" rather than as an error.",
    "type": "string"
   }
  },
  "required": [
   "lei"
  ],
  "type": "object"
 },

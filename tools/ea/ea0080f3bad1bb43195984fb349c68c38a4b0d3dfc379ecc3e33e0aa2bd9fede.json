{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List long-term memory entries. Filter by tags.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max entries (default: 20)",
    "type": "number"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   },
   "tags": {
    "description": "Comma-separated tags to filter by",
    "type": "string"
   }
  },
  "required": [
   "spaceId"
  ],
  "type": "object"
 },
 "name": "entries_list",
 "outputSchema": {
  "properties": {
   "encrypted": {
    "description": "True if the space is end-to-end encrypted (content is ciphertext)",
    "type": "boolean"
   },
   "entries": {
    "description": "Matching long-term entries",
    "items": {
     "properties": {
      "_id": {
       "description": "Entry ID",
       "type": "string"
      },
      "content": {
       "description": "Entry body",
       "type": "string"
      },
      "createdAt": {
       "description": "ISO 8601 creation timestamp",
       "type": "string"
      },
      "tags": {
       "description": "Tags for filtering",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Entry title",
       "type": "string"
      },
      "type": {
       "description": "Entry type: extraction, summary, decision, or artifact",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 }
}

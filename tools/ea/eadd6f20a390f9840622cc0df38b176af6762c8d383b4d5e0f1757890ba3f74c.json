{
 "description": "Safely update a task description that already preserves all user text and contains exactly one Task Completion Summary managed block.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "minLength": 1,
    "type": "string"
   },
   "descriptionImpactReview": {
    "additionalProperties": false,
    "properties": {
     "authoringEvidence": {
      "additionalProperties": {},
      "description": "Required for AI or automation task creation: declare an action/outcome title, plain-language review, and exact analogy/example excerpts from the description.",
      "type": "object"
     },
     "decision": {
      "enum": [
       "unchanged",
       "rewrite"
      ],
      "type": "string"
     },
     "fiveDimensionsReviewed": {
      "type": "boolean"
     },
     "rationale": {
      "minLength": 1,
      "type": "string"
     },
     "reasonCode": {
      "enum": [
       "operational_only",
       "review_only",
       "completion_only",
       "completion_summary_only",
       "historical_time_only",
       "node_completion_only",
       "placement_reviewed_no_semantic_change",
       "title_clarification_no_semantic_change",
       "semantic_change",
       "description_correction",
       "post_completion_revision"
      ],
      "type": "string"
     },
     "reviewedDescriptionSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "reviewedTaskUpdatedAt": {
      "minLength": 1,
      "type": "string"
     },
     "writebackRefs": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "reviewedTaskUpdatedAt",
     "reviewedDescriptionSha256",
     "decision",
     "reasonCode",
     "rationale"
    ],
    "type": "object"
   },
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "expectedUpdatedAt": {
    "format": "date-time",
    "type": "string"
   },
   "taskId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId",
   "description",
   "expectedUpdatedAt",
   "descriptionImpactReview"
  ],
  "type": "object"
 },
 "name": "granoflow_task_completion_summary_update"
}

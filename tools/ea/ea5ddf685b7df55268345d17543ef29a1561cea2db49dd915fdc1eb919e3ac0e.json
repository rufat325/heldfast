{
 "description": "Get recent device/app logs. Filter by process name, subsystem, log level, time range, and message content. Essential for debugging app behavior.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by log category",
    "type": "string"
   },
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "level": {
    "description": "Minimum log level (default: default)",
    "enum": [
     "debug",
     "info",
     "default",
     "error",
     "fault"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max number of log lines to return (default: 100)",
    "type": "number"
   },
   "messageContains": {
    "description": "Filter messages containing this text",
    "type": "string"
   },
   "process": {
    "description": "Filter by process name (e.g., \"MyApp\", \"SpringBoard\")",
    "type": "string"
   },
   "since": {
    "description": "Time range: \"5m\", \"1h\", \"30s\", or ISO date (default: \"1m\")",
    "type": "string"
   },
   "subsystem": {
    "description": "Filter by log subsystem (e.g., \"com.apple.UIKit\")",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "simulator_get_logs"
}

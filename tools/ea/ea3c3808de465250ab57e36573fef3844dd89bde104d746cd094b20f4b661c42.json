{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add a timed transition effect, optionally attached to one timeline item and paired with sound.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "durationSeconds": {
    "default": 0.6,
    "exclusiveMinimum": 0,
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "easing": {
    "default": "easeInOut",
    "enum": [
     "linear",
     "easeIn",
     "easeOut",
     "easeInOut"
    ],
    "type": "string"
   },
   "expectedRevision": {
    "description": "Expected sequence revision, or null.",
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "includeSfx": {
    "default": false,
    "type": "boolean"
   },
   "intensity": {
    "default": 0.5,
    "maximum": 2,
    "minimum": 0.2,
    "type": "number"
   },
   "layerIndex": {
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "preset": {
    "default": "flash",
    "enum": [
     "flash",
     "film-flash",
     "whip-left",
     "whip-right",
     "zoom-punch",
     "glitch"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "startSeconds": {
    "minimum": 0,
    "type": "number"
   },
   "timelineItemId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "startSeconds",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "add_transition",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "affectedTimelineItemIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "baseRevision": {
    "type": "integer"
   },
   "createdTimelineItemIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "deletedTimelineItemIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "mutationReceipt": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ]
     },
     "operation": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "key",
     "operation",
     "status",
     "replayed"
    ],
    "type": "object"
   },
   "operationId": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "replayed": {
    "type": "boolean"
   },
   "result": {
    "type": "object"
   },
   "revision": {
    "type": "integer"
   },
   "txid": {
    "type": "number"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "operationId",
   "projectId",
   "baseRevision",
   "revision",
   "replayed",
   "txid",
   "affectedTimelineItemIds",
   "createdTimelineItemIds",
   "deletedTimelineItemIds",
   "warnings",
   "result",
   "mutationReceipt"
  ],
  "type": "object"
 },
 "title": "Add Transition"
}

 "description": "List available tags for a Docker image sorted by recency. Returns tag name, digest, size, and push date. Use to find and select specific versions to pull.",
 "inputSchema": {
  "examples": [
   {
    "name": "postgres",
    "namespace": "library"
   },
   {
    "limit": 50,
    "name": "node",
    "namespace": "library"
   }
  ],
  "properties": {
   "limit": {
    "description": "Number of tags to return (default 20, max 100)",
    "type": "number"
   },
   "name": {
    "description": "Repository name",
    "type": "string"
   },
   "namespace": {
    "description": "Repository namespace (use \"library\" for official images)",
    "type": "string"
   }
  },
  "required": [
   "namespace",
   "name"
  ],
  "type": "object"
 },
 "name": "get_tags",
 "outputSchema": {

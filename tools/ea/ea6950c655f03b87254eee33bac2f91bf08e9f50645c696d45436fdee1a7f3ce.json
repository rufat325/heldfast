{
 "description": "Record an engineering task completion through Granoflow's controlled work-memory API and existing task write/complete paths.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client": {
    "default": "mcp",
    "minLength": 1,
    "type": "string"
   },
   "decisions": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "dryRun": {
    "default": true,
    "description": "When true, previews the request without writing.",
    "type": "boolean"
   },
   "outcome": {
    "enum": [
     "success",
     "failed"
    ],
    "type": "string"
   },
   "repo": {
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "commit": {
      "minLength": 1,
      "type": "string"
     },
     "taskId": {
      "minLength": 1,
      "type": "string"
     },
     "threadId": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "summary": {
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "summary",
   "outcome"
  ],
  "type": "object"
 },
 "name": "granoflow_task_completion_record"
}

{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Recommend bikes for budget"
 },
 "description": "Curated picks from Cyclesite's live UK inventory for a budget and intent. Prefers higher-engagement listings. Returns up to 5 picks with a one-line rationale each. Example queries: 'a road bike for \u00a31,500 for weekend rides', 'best e-MTB I can buy under \u00a33,000', 'commuter bike in London under \u00a3400'.",
 "inputSchema": {
  "properties": {
   "budgetGbp": {
    "description": "Maximum budget in GBP.",
    "type": "number"
   },
   "category": {
    "enum": [
     "road",
     "mtb",
     "gravel",
     "hybrid",
     "ebike",
     "kids",
     "bmx",
     "folding",
     "city",
     "touring",
     "triathlon",
     "track",
     "cyclocross",
     "cargo",
     "adaptive",
     "other"
    ],
    "type": "string"
   },
   "city": {
    "description": "UK city to focus on (optional).",
    "type": "string"
   },
   "limit": {
    "description": "1-10, default 5.",
    "type": "number"
   },
   "useCase": {
    "description": "Free-text intent (e.g. \"commuting\", \"weekend trail\", \"first road bike\").",
    "type": "string"
   }
  },
  "required": [
   "budgetGbp"
  ],
  "type": "object"
 },
 "name": "recommend_bike_for_budget",
 "outputSchema": {
  "type": "object"
 }
}

{
 "description": "Update a workflow partially: fetches the current version, merges only the fields you pass (name, nodes, connections, settings), validates offline and PUTs the result. Pass full nodes/connections arrays when changing them \u2014 they replace the existing ones.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "connections": {
    "additionalProperties": {},
    "type": "object"
   },
   "id": {
    "description": "Workflow ID",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "nodes": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "credentials": {
       "additionalProperties": {},
       "type": "object"
      },
      "disabled": {
       "type": "boolean"
      },
      "name": {
       "description": "Unique node name",
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "type": "object"
      },
      "position": {
       "items": [
        {
         "type": "number"
        },
        {
         "type": "number"
        }
       ],
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "type": {
       "description": "Node type, e.g. n8n-nodes-base.httpRequest",
       "type": "string"
      },
      "typeVersion": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "settings": {
    "additionalProperties": {},
    "type": "object"
   },
   "skipValidation": {
    "default": false,
    "description": "Update even if offline validation finds errors",
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_workflow"
}

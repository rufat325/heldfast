{
 "description": "List products with optional filters. Each product includes variants, images, and options.",
 "inputSchema": {
  "properties": {
   "collection_id": {
    "description": "Filter to products in a specific collection",
    "type": "string"
   },
   "created_at_min": {
    "description": "ISO-8601 minimum created_at",
    "type": "string"
   },
   "ids": {
    "description": "Comma-separated list of product IDs",
    "type": "string"
   },
   "limit": {
    "description": "Max results per page (1-250, default 50)",
    "type": "number"
   },
   "product_type": {
    "description": "Filter by product_type",
    "type": "string"
   },
   "status": {
    "description": "Filter by product status",
    "enum": [
     "active",
     "archived",
     "draft"
    ],
    "type": "string"
   },
   "updated_at_min": {
    "description": "ISO-8601 minimum updated_at",
    "type": "string"
   },
   "vendor": {
    "description": "Filter by vendor name",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_products"
}

       ],
       "type": "object"
      },
      "type": "array"
     },
     "specialisms": {
      "type": "string"
     }
    },
    "required": [
     "clinic_id",
     "name",
     "services",
     "practitioners",
     "availability"
    ],
    "type": "object"
   },
   "data_as_of": {
    "description": "Age of the underlying reading, when different from generated_at.",
    "type": [
     "string",
     "null"
    ]
   },
   "generated_at": {
    "description": "When this response was produced. ISO 8601, Europe/London.",
    "type": "string"
   },
   "price_promise": {
    "type": "string"
   }
  },
  "required": [
   "about",
   "booking_rule",
   "price_promise",
   "generated_at",
   "data"
  ],
  "type": "object"
 },
 "title": "Get clinic details"
}

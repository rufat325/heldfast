        "specialism": {
         "description": "Treatment slug: physiotherapy, chiropractic, osteopathy.",
         "type": "string"
        },
        "treatment_included": {
         "description": "Present and false only when the clinic states this appointment is assessment only.",
         "type": "boolean"
        },
        "treatment_note": {

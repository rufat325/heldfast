        "type": [
         "string",
         "null"
        ]
       },
       "horizon_days": {
        "type": "integer"
       },
       "note": {
        "type": [
         "string",
         "null"
        ]
       },
       "reason": {
        "type": [
         "string",
         "null"
        ]
       },
       "scope": {
        "type": "string"
       },
       "state": {
        "enum": [
         "available",
         "none",
         "stale",
         "unknown"
        ],
        "type": "string"
       }
      },
      "required": [
       "state"
      ],
      "type": "object"
     },
     "cancellation_policy": {

 "description": "Return the full public profile of one MediMo clinic: description, address, the treatments it offers with prices and durations, its practitioners with profession, regulator registration, gender and languages spoken besides English, its parking and step-free access, the insurers it accepts, and current availability. Pass insurer for that insurer's appointments, prices and approved practitioners. Prices are the clinic's own \u2014 booking through MediMo costs the same as booking direct. Contains no phone numbers, emails or review text. Use it after search_clinics when someone wants detail on a specific clinic; call start_booking when they have chosen.",
 "inputSchema": {
  "properties": {
   "clinic_id": {
    "description": "The clinic id from search_clinics. Accepts the slug or the ULID.",
    "type": "string"
   },
   "insurer": {
    "description": "Optional. The health insurer paying, e.g. \"Bupa\". Services, prices and practitioners become that insurer's. Leave out for self-pay.",
    "type": "string"
   }
  },
  "required": [
   "clinic_id"
  ],
  "type": "object"
 },
 "name": "get_clinic",

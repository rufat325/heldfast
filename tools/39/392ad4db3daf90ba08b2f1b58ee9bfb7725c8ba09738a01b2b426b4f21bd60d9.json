{
 "description": "Validate a release file manifest against required paths, allowed prefixes, hashes, size limits, and sensitive-file rules. Costs $0.05 USDC on Base mainnet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "executable": {
       "type": "boolean"
      },
      "path": {
       "type": "string"
      },
      "role": {
       "type": "string"
      },
      "sha256": {
       "type": "string"
      },
      "size_bytes": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "path",
      "sha256",
      "size_bytes"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "minItems": 1,
    "type": "array"
   },
   "policy": {
    "additionalProperties": false,
    "properties": {
     "allowed_prefixes": {
      "items": {
       "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
     },
     "max_total_bytes": {
      "minimum": 0,
      "type": "integer"
     },
     "required_paths": {
      "items": {
       "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "files",
   "policy"
  ],
  "type": "object"
 },
 "name": "justhandled_release_artifact_manifest_validator"
}

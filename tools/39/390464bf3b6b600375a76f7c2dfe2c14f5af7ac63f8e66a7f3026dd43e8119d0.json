{
 "description": "Guarda un request en la colecci\u00f3n local. Si ya existe un request con el mismo nombre, lo sobreescribe.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Nombre \u00fanico del request guardado",
    "type": "string"
   },
   "request": {
    "additionalProperties": false,
    "description": "Configuraci\u00f3n del request a guardar",
    "properties": {
     "auth": {
      "additionalProperties": false,
      "properties": {
       "header": {
        "description": "Header name para API key (default: X-API-Key)",
        "type": "string"
       },
       "key": {
        "description": "API key value",
        "type": "string"
       },
       "password": {
        "description": "Password para Basic auth",
        "type": "string"
       },
       "token": {
        "description": "Token para Bearer auth",
        "type": "string"
       },
       "type": {
        "description": "Tipo de autenticaci\u00f3n",
        "enum": [
         "bearer",
         "api-key",
         "basic"
        ],
        "type": "string"
       },
       "username": {
        "description": "Username para Basic auth",
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     "body": {},
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "method": {
      "enum": [
       "GET",
       "POST",
       "PUT",
       "PATCH",
       "DELETE",
       "HEAD",
       "OPTIONS"
      ],
      "type": "string"
     },
     "query": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "method",
     "url"
    ],
    "type": "object"
   },
   "tags": {
    "description": "Tags para organizar (ej: [\"auth\", \"users\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "request"
  ],
  "type": "object"
 },
 "name": "collection_save"
}

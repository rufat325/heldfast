{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Preview without mutation. Trim or extend one timeline item. Split one timeline item at an exact sequence position.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "expectedRevision": {
    "description": "Expected sequence revision, or null.",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "operation": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "operationId": {
        "const": "timeline.item.trim",
        "type": "string"
       },
       "snapToFrame": {
        "type": "boolean"
       },
       "timelineItemId": {
        "format": "uuid",
        "type": "string"
       },
       "trimEndDeltaSeconds": {
        "type": "number"
       },
       "trimStartDeltaSeconds": {
        "type": "number"
       }
      },
      "required": [
       "operationId",
       "timelineItemId",
       "trimStartDeltaSeconds",
       "trimEndDeltaSeconds",
       "snapToFrame"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "operationId": {
        "const": "timeline.item.split",
        "type": "string"
       },
       "snapToFrame": {
        "type": "boolean"
       },
       "splitAtSeconds": {
        "minimum": 0,
        "type": "number"
       },
       "timelineItemId": {
        "format": "uuid",
        "type": "string"
       }
      },
      "required": [
       "operationId",
       "timelineItemId",
       "splitAtSeconds",
       "snapToFrame"
      ],
      "type": "object"
     }
    ]
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "operation",
   "expectedRevision"
  ],
  "type": "object"
 },
 "name": "timeline_edit_preview",
 "outputSchema": {
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "plan": {
      "additionalProperties": false,
      "properties": {
       "affected_timeline_item_ids": {
        "items": {
         "format": "uuid",
         "type": "string"
        },
        "type": "array"
       },
       "change_count": {
        "minimum": 0,
        "type": "number"
       },
       "current_revision": {
        "minimum": 0,
        "type": "number"
       },
       "destructive": {
        "type": "boolean"
       },
       "expected_revision": {
        "minimum": 0,
        "type": [
         "number",
         "null"
        ]
       },
       "operation_id": {
        "enum": [
         "timeline.item.trim",
         "timeline.item.split"
        ],
        "type": "string"
       },
       "project_id": {
        "format": "uuid",
        "type": "string"
       },
       "warnings": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "would_create_timeline_item_ids": {
        "items": {
         "format": "uuid",
         "type": "string"
        },
        "type": "array"
       },
       "would_delete_timeline_item_ids": {
        "items": {
         "format": "uuid",
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "operation_id",
       "project_id",
       "current_revision",
       "expected_revision",
       "destructive",
       "affected_timeline_item_ids",
       "would_create_timeline_item_ids",
       "would_delete_timeline_item_ids",
       "change_count",
       "warnings"
      ],
      "type": "object"
     }
    },
    "required": [
     "plan"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "enum": [
         "validation_error",
         "not_found",
         "permission_denied",
         "revision_conflict",
         "idempotency_conflict",
         "operation_in_progress",
         "operation_previous_failure",
         "sequence_busy",
         "mutation_failed"
        ],
        "type": "string"
       },
       "details": {
        "additionalProperties": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "number"
          },
          {
           "type": "boolean"
          },
          {
           "type": "null"
          }
         ]
        },
        "type": "object"
       },
       "message": {
        "type": "string"
       },
       "retryable": {
        "type": "boolean"
       }
      },
      "required": [
       "code",
       "message",
       "retryable",
       "details"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Preview Timeline Edit"
}

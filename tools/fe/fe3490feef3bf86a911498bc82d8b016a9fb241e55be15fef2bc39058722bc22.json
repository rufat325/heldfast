{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get form responses"
 },
 "description": "List a form's submissions (newest first) so you can read or summarize them \u2014 e.g. 'summarize this week's feedback' or 'any complaints in the responses?'.",
 "inputSchema": {
  "properties": {
   "id": {
    "description": "Form id.",
    "type": "string"
   },
   "page": {
    "description": "1-based page number.",
    "type": "integer"
   },
   "page_size": {
    "description": "Responses per page (max 100, default 25).",
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_form_responses",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "description": "Total matching rows across all pages.",
    "type": "integer"
   },
   "error": {
    "additionalProperties": true,
    "description": "Present only when the tool failed (the result is also flagged isError).",
    "properties": {
     "cause": {
      "description": "Machine-readable failure category: invalid_argument, not_found, forbidden, plan_limit, rate_limited, or server_error.",
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retryable": {
      "description": "Whether repeating the same call could succeed.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "message": {
    "description": "Set when there are no responses yet.",
    "type": "string"
   },
   "next": {
    "description": "URL of the next page, or null on the last page.",
    "type": [
     "string",
     "null"
    ]
   },
   "previous": {
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "completion_time_seconds": {
       "type": [
        "number",
        "null"
       ]
      },
      "field_responses": {
       "description": "One entry per answered field.",
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "is_complete": {
       "type": "boolean"
      },
      "outcome": {},
      "submitted_at": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}

     "propulsion",
     "sun-sensors",
     "magnetometers",
     "magnetorquers",
     "imus-gyros",
     "gnss-receivers",
     "eps",
     "deployers",
     "thermal",
     "antennas",
     "sdr-modems",
     "cameras",
     "structures",
     "platforms",
     "ground-stations",
     "sadm",
     "tanks-valves",
     "separation-systems",
     "pointing-mechanisms"
    ],
    "type": "string"
   },
   "product_id": {

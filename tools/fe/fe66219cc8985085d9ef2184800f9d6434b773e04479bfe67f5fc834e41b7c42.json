{
 "description": "Create a new Longhorn volume. Longhorn docs: https://longhorn.io/docs/1.12.1/nodes-and-volumes/volumes/create-volumes/",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "accessMode": {
    "description": "\"rwo\" or \"rwx\".",
    "type": "string"
   },
   "backingImage": {
    "type": "string"
   },
   "dataLocality": {
    "type": "string"
   },
   "diskSelector": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "extra": {
    "additionalProperties": {},
    "description": "Additional Longhorn fields not covered by the named parameters above, merged verbatim into the request body.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "fromBackup": {
    "description": "Backup URL to restore from.",
    "type": "string"
   },
   "frontend": {
    "description": "e.g. \"blockdev\" or \"iscsi\".",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "nodeSelector": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "numberOfReplicas": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "size": {
    "description": "Bytes, or a size string like \"10Gi\".",
    "type": "string"
   },
   "staleReplicaTimeout": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "name",
   "size",
   "numberOfReplicas"
  ],
  "type": "object"
 },
 "name": "volume_create",
 "title": "Create volume"
}

{
 "description": "Async bulk import of CMS posts (max 100). Returns a job ID; poll get_cms_import_status for completion.",
 "inputSchema": {
  "properties": {
   "options": {
    "properties": {
     "default_status": {
      "description": "Default draft.",
      "enum": [
       "draft",
       "published",
       "scheduled"
      ],
      "type": "string"
     },
     "on_conflict": {
      "description": "On existing slug. Default skip.",
      "enum": [
       "skip",
       "overwrite"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "posts": {
    "description": "Max 100. Each requires title and content.",
    "items": {
     "description": "slug, excerpt, featured_image, seo_title, seo_description, focus_keyword, canonical_url, published_at, content_type_config.",
     "properties": {
      "authors": {
       "description": "Names or { name, bio?, avatar_url?, email?, social_links? }; first = primary.",
       "items": {},
       "type": "array"
      },
      "categories": {
       "description": "Names; find-or-create.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "content": {
       "description": "HTML",
       "type": "string"
      },
      "faqs": {
       "description": "{ question, answer } \u2192 FAQPage schema.",
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "status": {
       "enum": [
        "draft",
        "published",
        "scheduled"
       ],
       "type": "string"
      },
      "tags": {
       "description": "Names; find-or-create.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "enum": [
        "blog_post",
        "page",
        "faq",
        "glossary",
        "comparison",
        "pillar",
        "how_to",
        "landing",
        "listicle",
        "case_study",
        "tutorial",
        "news",
        "product_update",
        "data_report",
        "event",
        "resource",
        "alternative",
        "tool_review"
       ],
       "type": "string"
      }
     },
     "required": [
      "title",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "site_id": {
    "type": "string"
   }
  },
  "required": [
   "site_id",
   "posts"
  ],
  "type": "object"
 },
 "name": "import_cms_posts"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Register a new custom AI platform for prompt optimization.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category this platform belongs to",
    "enum": [
     "chat",
     "image",
     "voice",
     "video",
     "music",
     "code",
     "document"
    ],
    "type": "string"
   },
   "description": {
    "description": "Short description",
    "type": "string"
   },
   "id": {
    "description": "Unique platform ID (lowercase, alphanumeric with hyphens)",
    "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
    "type": "string"
   },
   "instructions": {
    "type": "string"
   },
   "instructions_file": {
    "type": "string"
   },
   "label": {
    "description": "Human-readable platform name",
    "type": "string"
   },
   "syntax_hints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "category",
   "label",
   "description"
  ],
  "type": "object"
 },
 "name": "register_platform",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "config_dir": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "platform": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "success": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "Register a custom platform"
}

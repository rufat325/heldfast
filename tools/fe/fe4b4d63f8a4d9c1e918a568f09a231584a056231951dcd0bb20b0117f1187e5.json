{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search the SupStack supplement library. Provide a free-text query to find supplements by name, and/or structured filters (goal id, category, supplement type, minimum evidence level, safety rating). Returns a ranked list with slug, name, type, and evidence score.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "type": "string"
   },
   "evidence": {
    "enum": [
     "emerging",
     "moderate",
     "strong",
     "very-strong"
    ],
    "type": "string"
   },
   "goal": {
    "type": "string"
   },
   "limit": {
    "default": 10,
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   },
   "query": {
    "type": "string"
   },
   "safety": {
    "enum": [
     "high",
     "moderate",
     "caution"
    ],
    "type": "string"
   },
   "sort": {
    "enum": [
     "evidence",
     "name",
     "category"
    ],
    "type": "string"
   },
   "type": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "supstack_search"
}

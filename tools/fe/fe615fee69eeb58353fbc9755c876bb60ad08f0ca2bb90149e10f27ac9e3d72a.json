{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://widget/projects.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the user's BlitzReels projects with status, duration, and basic metadata.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum number of projects to return (1-50)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Project offset.",
    "minimum": 0,
    "type": "number"
   },
   "search": {
    "description": "Search projects by name",
    "type": "string"
   },
   "status": {
    "default": "active",
    "description": "Filter by project status",
    "enum": [
     "active",
     "archived",
     "all"
    ],
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "projects_list",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "bounds": {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "type": "number"
     },
     "maxLimit": {
      "type": "number"
     },
     "offset": {
      "type": "number"
     },
     "returned": {
      "type": "number"
     },
     "total": {
      "type": "number"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "limit",
     "maxLimit",
     "offset",
     "total",
     "returned",
     "hasMore",
     "truncated"
    ],
    "type": "object"
   },
   "projects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "clipCount": {
       "type": "number"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "durationSeconds": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "lastExportAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "projectUrl": {
       "type": "string"
      },
      "status": {
       "enum": [
        "ready",
        "exporting",
        "needs_captions",
        "processing"
       ],
       "type": "string"
      },
      "thumbnailUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "updatedAt": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "description",
      "updatedAt",
      "lastExportAt",
      "durationSeconds",
      "clipCount",
      "thumbnailUrl",
      "status",
      "projectUrl"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "projects",
   "bounds"
  ],
  "type": "object"
 },
 "title": "List Projects"
}

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Safety data sheets, specification sheets and COSHH hazard codes for a product (by slug or SKU). Returns document URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "description": "Storefront locale such as en-GB (default), en-US, de, fr-FR, es-ES, it-IT, nl-NL, pl. Controls product names, slugs and prices.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   },
   "sku": {
    "description": "Product SKU.",
    "maxLength": 64,
    "type": "string"
   },
   "slug": {
    "description": "Product slug from a product URL (\u2026/product/<slug>).",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_product_documents",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "coshh_codes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "description": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "documents": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "type": {
       "description": "safety_sheet or specification_sheet.",
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hazardous": {
    "type": "boolean"
   },
   "product": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "sku": {
      "type": "string"
     }
    },
    "required": [
     "sku",
     "name"
    ],
    "type": "object"
   }
  },
  "required": [
   "product",
   "hazardous",
   "documents",
   "coshh_codes"
  ],
  "type": "object"
 },
 "title": "Get product documents"
}

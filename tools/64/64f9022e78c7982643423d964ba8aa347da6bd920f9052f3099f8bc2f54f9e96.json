{
 "description": "Handles login via third-parties including Social login, external OAuth and OpenID Connect, and other login systems.",
 "inputSchema": {
  "properties": {
   "X-FusionAuth-TenantId": {
    "description": "The unique Id of the tenant used to scope this API request. Only required when there is more than one tenant and the API key is not tenant-scoped.",
    "format": "UUID",
    "type": "string"
   },
   "requestBody": {
    "description": "Login API request object used for login to third-party systems (i.e. Login with Facebook).",
    "properties": {
     "applicationId": {
      "format": "uuid",
      "type": "string"
     },
     "data": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "encodedJWT": {
      "type": "string"
     },
     "identityProviderId": {
      "format": "uuid",
      "type": "string"
     },
     "ipAddress": {
      "type": "string"
     },
     "metaData": {
      "properties": {
       "data": {
        "additionalProperties": {
         "type": "object"
        },
        "type": "object"
       },
       "device": {
        "description": "",
        "properties": {
         "description": {
          "type": "string"
         },
         "lastAccessedAddress": {
          "type": "string"
         },
         "lastAccessedInstant": {
          "description": "The number of milliseconds since the unix epoch: January 1, 1970 00:00:00 UTC. This value is always in UTC.",
          "format": "int64",
          "type": "number"
         },
         "name": {
          "type": "string"
         },
         "type": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "scopes": {
        "items": {},
        "type": "array",
        "uniqueItems": true
       }
      },
      "type": "object"
     },
     "newDevice": {
      "type": "boolean"
     },
     "noJWT": {
      "type": "boolean"
     },
     "noLink": {
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "identityProviderLoginWithId"
}

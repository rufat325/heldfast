{
 "description": "List your recent reports (most recent first).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "queued",
     "running",
     "completed",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_reports"
}

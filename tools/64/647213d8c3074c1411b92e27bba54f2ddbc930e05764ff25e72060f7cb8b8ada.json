{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Recover interrupted outbound sends after a crash: reclassify stuck queued/unknown records and close them with caller-verified provider receipts (never auto-resends).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "conversationId": {
    "type": "string"
   },
   "observedReceipts": {
    "items": {
     "properties": {
      "idempotencyKey": {
       "minLength": 1,
       "type": "string"
      },
      "receipt": {
       "properties": {
        "accepted": {
         "type": "boolean"
        },
        "detail": {},
        "nativeId": {
         "type": "string"
        },
        "operation": {
         "type": "string"
        },
        "provider": {
         "enum": [
          "freebuff",
          "opencode",
          "codex",
          "claude-code",
          "cursor"
         ],
         "type": "string"
        },
        "status": {
         "type": "string"
        }
       },
       "required": [
        "provider",
        "nativeId",
        "operation",
        "accepted",
        "status"
       ],
       "type": "object"
      }
     },
     "required": [
      "idempotencyKey",
      "receipt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "conversation_reconcile"
}

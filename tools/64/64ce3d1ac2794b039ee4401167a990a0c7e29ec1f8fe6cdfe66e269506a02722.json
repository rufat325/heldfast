{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate gross/net rental yield, income, operating costs and simple payback in OMR. Calculations only. Use when an agent needs financial metrics (yield, income, payback) for a single property.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "annualRent": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "maintenance": {
    "description": "Legacy alias for maintenanceCost; supply only one",
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "maintenanceCost": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "otherAnnualCosts": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "propertyValue": {
    "maximum": 1000000000000,
    "minimum": 0.01,
    "type": "number"
   },
   "serviceCharge": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "vacancyRatePct": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "propertyValue",
   "annualRent"
  ],
  "type": "object"
 },
 "name": "analyze_property",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "annualNetIncome": {
    "type": "number"
   },
   "annualOperatingCost": {
    "type": "number"
   },
   "annualOperatingCosts": {
    "type": "number"
   },
   "annualRent": {
    "type": "number"
   },
   "currency": {
    "const": "OMR",
    "type": "string"
   },
   "effectiveAnnualRent": {
    "type": "number"
   },
   "grossAnnualIncome": {
    "type": "number"
   },
   "grossYield": {
    "type": "number"
   },
   "grossYieldPct": {
    "type": "number"
   },
   "netYield": {
    "type": "number"
   },
   "netYieldPct": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "paybackYears": {
    "type": [
     "number",
     "null"
    ]
   },
   "propertyValue": {
    "type": "number"
   }
  },
  "required": [
   "propertyValue",
   "annualRent",
   "grossAnnualIncome",
   "grossYield",
   "netYield",
   "annualOperatingCost",
   "annualNetIncome",
   "effectiveAnnualRent",
   "paybackYears",
   "grossYieldPct",
   "netYieldPct",
   "annualOperatingCosts",
   "currency",
   "note"
  ],
  "type": "object"
 }
}

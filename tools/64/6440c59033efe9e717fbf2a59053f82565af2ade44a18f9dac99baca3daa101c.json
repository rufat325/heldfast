         "description": "Width in the given unit.",
         "exclusiveMinimum": 0,
         "type": "number"
        }
       },
       "required": [
        "l",
        "w",
        "h",
        "unit"
       ],
       "type": "object"
      },
      "hs_code": {
       "description": "Optional HS commodity code (6-10 digits).",
       "type": "string"
      },
      "quantity": {
       "description": "Number of identical pieces on this line.",
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "stackable": {
       "description": "Stack two-high (halves the loading-metre footprint).",
       "type": "boolean"
      },
      "un_number": {
       "description": "Optional UN number \u2014 triggers the dangerous-goods advisory flag.",
       "type": "string"
      },
      "weight": {
       "additionalProperties": false,
       "description": "Per-piece weight with unit.",
       "properties": {

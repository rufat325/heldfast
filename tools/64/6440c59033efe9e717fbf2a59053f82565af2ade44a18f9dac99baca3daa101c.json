      "exclusiveMinimum": 0,
      "type": "number"
     },
     "awb_number": {
      "description": "IATA 11-digit air waybill number \u2014 check-digit validated into flags.",
      "type": "string"
     },
     "container_number": {
      "description": "ISO 6346 container number \u2014 check-digit validated into flags.",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },

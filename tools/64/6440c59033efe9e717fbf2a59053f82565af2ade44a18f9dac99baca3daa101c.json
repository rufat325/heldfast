         "description": "Weight unit.",
         "enum": [
          "kg",
          "g",
          "t",
          "lb"
         ],
         "type": "string"
        },
        "value": {
         "description": "Gross weight per piece.",
         "exclusiveMinimum": 0,
         "type": "number"
        }
       },
       "required": [
        "value",
        "unit"
       ],
       "type": "object"
      }
     },
     "required": [
      "quantity",
      "dims",
      "weight"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "mode": {
    "description": "Transport mode: sea | air | road. Default: road.",
    "enum": [
     "sea",
     "air",
     "road"
    ],
    "type": "string"
   },
   "options": {
    "additionalProperties": false,
    "description": "Optional settings.",
    "properties": {
     "air_volumetric_divisor": {

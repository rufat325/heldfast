{
 "description": "Create a new App Store version. After creating, set What's New, attach a build, and submit for review.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "appId": {
    "description": "App ID",
    "type": "string"
   },
   "platform": {
    "default": "IOS",
    "description": "Platform",
    "enum": [
     "IOS",
     "MAC_OS",
     "TV_OS",
     "VISION_OS"
    ],
    "type": "string"
   },
   "releaseType": {
    "default": "MANUAL",
    "description": "Release type",
    "enum": [
     "MANUAL",
     "AFTER_APPROVAL",
     "SCHEDULED"
    ],
    "type": "string"
   },
   "versionString": {
    "description": "Version string (e.g., 2.1.0)",
    "type": "string"
   }
  },
  "required": [
   "appId",
   "versionString"
  ],
  "type": "object"
 },
 "name": "asc_create_version"
}

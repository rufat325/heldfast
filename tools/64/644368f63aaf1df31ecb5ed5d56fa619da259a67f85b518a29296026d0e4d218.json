{
 "description": "Get performance and power metrics for an app (battery, launch time, memory, hangs, disk, animation, termination).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "appId": {
    "description": "App ID",
    "type": "string"
   },
   "metricType": {
    "description": "Filter by metric type",
    "enum": [
     "DISK",
     "HANG",
     "BATTERY",
     "LAUNCH",
     "MEMORY",
     "ANIMATION",
     "TERMINATION"
    ],
    "type": "string"
   },
   "platform": {
    "description": "Filter by platform (e.g., IOS)",
    "type": "string"
   }
  },
  "required": [
   "appId"
  ],
  "type": "object"
 },
 "name": "asc_get_perf_metrics"
}

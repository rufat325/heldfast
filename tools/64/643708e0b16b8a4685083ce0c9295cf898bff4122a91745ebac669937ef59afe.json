{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create or replace a carousel project from a slide document. Server owns chip layout, safezones, and exact export pixels.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "clear_existing": {
    "type": "boolean"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "locale": {
    "maxLength": 12,
    "minLength": 2,
    "type": "string"
   },
   "name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "platform": {
    "enum": [
     "tiktok_photo",
     "instagram_4x5",
     "linkedin"
    ],
    "type": "string"
   },
   "project_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "series_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "slides": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "layout": {
       "enum": [
        "chip_stack_ui",
        "chip_stack_face_safe",
        "chip_stack_top",
        "title_body_card"
       ],
       "type": "string"
      },
      "layout_overrides": {
       "additionalProperties": false,
       "properties": {
        "top_px": {
         "maximum": 1920,
         "minimum": 0,
         "type": "integer"
        }
       },
       "type": "object"
      },
      "lines": {
       "default": [],
       "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 6,
       "type": "array"
      },
      "role": {
       "enum": [
        "hook",
        "body",
        "proof",
        "cta"
       ],
       "type": "string"
      },
      "slots": {
       "additionalProperties": {
        "maxLength": 4000,
        "type": "string"
       },
       "propertyNames": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       },
       "type": "object"
      },
      "visual": {
       "additionalProperties": false,
       "properties": {
        "color": {
         "pattern": "^#[0-9a-fA-F]{6}$",
         "type": "string"
        },
        "colors": {
         "items": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
         },
         "maxItems": 2,
         "minItems": 1,
         "type": "array"
        },
        "html": {
         "maxLength": 80000,
         "minLength": 20,
         "type": "string"
        },
        "kind": {
         "enum": [
          "media_asset",
          "generate",
          "solid",
          "gradient",
          "html",
          "template"
         ],
         "type": "string"
        },
        "media_asset_id": {
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        "model_id": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "prompt": {
         "maxLength": 1000,
         "minLength": 3,
         "type": "string"
        },
        "source_media_asset_id": {
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        "template_id": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "kind"
       ],
       "type": "object"
      }
     },
     "required": [
      "lines",
      "visual"
     ],
     "type": "object"
    },
    "maxItems": 35,
    "minItems": 1,
    "type": "array"
   },
   "style": {
    "additionalProperties": false,
    "properties": {
     "chip": {
      "additionalProperties": false,
      "properties": {
       "background": {
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
       },
       "color": {
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
       },
       "font_family": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       },
       "font_size": {
        "maximum": 120,
        "minimum": 12,
        "type": "integer"
       },
       "font_weight": {
        "anyOf": [
         {
          "maximum": 900,
          "minimum": 100,
          "type": "integer"
         },
         {
          "type": "string"
         }
        ]
       },
       "max_lines_per_chip": {
        "maximum": 4,
        "minimum": 1,
        "type": "integer"
       },
       "padding_x": {
        "maximum": 80,
        "minimum": 0,
        "type": "integer"
       },
       "padding_y": {
        "maximum": 80,
        "minimum": 0,
        "type": "integer"
       },
       "radius": {
        "maximum": 48,
        "minimum": 0,
        "type": "integer"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "platform",
   "name",
   "slides",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "carousels_compile",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "ai_image_run_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "frame": {
    "additionalProperties": false,
    "properties": {
     "aspect_ratio": {
      "type": "string"
     },
     "height": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "width": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height",
     "aspect_ratio"
    ],
    "type": "object"
   },
   "job_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "mutationReceipt": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ]
     },
     "operation": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "key",
     "operation",
     "status",
     "replayed"
    ],
    "type": "object"
   },
   "next_actions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "enum": [
        "GET",
        "POST",
        "PATCH",
        "DELETE"
       ],
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "method",
      "path",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "platform": {
    "enum": [
     "tiktok_photo",
     "instagram_4x5",
     "linkedin"
    ],
    "type": "string"
   },
   "project_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "slide_count": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "slides": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "chip_band_px": {
       "additionalProperties": false,
       "properties": {
        "bottom": {
         "type": "number"
        },
        "top": {
         "type": "number"
        }
       },
       "required": [
        "top",
        "bottom"
       ],
       "type": "object"
      },
      "index": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "layout_applied": {
       "enum": [
        "chip_stack_ui",
        "chip_stack_face_safe",
        "chip_stack_top",
        "title_body_card"
       ],
       "type": "string"
      },
      "overlay_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "role": {
       "anyOf": [
        {
         "enum": [
          "hook",
          "body",
          "proof",
          "cta"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "timeline_item_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "index",
      "role",
      "timeline_item_ids",
      "overlay_ids",
      "layout_applied",
      "chip_band_px"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "field": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "repair": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "project_id",
   "revision",
   "platform",
   "slide_count",
   "slides",
   "frame",
   "warnings",
   "next_actions",
   "mutationReceipt"
  ],
  "type": "object"
 },
 "title": "Compile Carousel"
}

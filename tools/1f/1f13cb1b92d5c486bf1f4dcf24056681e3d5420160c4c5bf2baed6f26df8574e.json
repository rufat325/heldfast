{
 "description": "List memories in a store, newest first, with optional scope and tag filters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentId": {
    "description": "Filter by agent ID",
    "type": "string"
   },
   "instanceId": {
    "description": "Optional instance ID override",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "memory_name": {
    "description": "The memory store name (from memory_stores)",
    "minLength": 1,
    "type": "string"
   },
   "namespace": {
    "description": "Filter by namespace",
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "tags": {
    "description": "Filter by tags (AND)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "threadId": {
    "description": "Filter by thread ID",
    "type": "string"
   }
  },
  "required": [
   "memory_name"
  ],
  "type": "object"
 },
 "name": "memory_list"
}

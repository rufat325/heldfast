{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Vendor"
 },
 "description": "Add a vendor (supplier) to a live event's production graph \u2014 name, service, pipeline status, contact info, itemized list, notes, tags, linked projects. Requires event_id + name; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "itemized_list": {
    "maxLength": 4000,
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "maxLength": 4000,
    "type": "string"
   },
   "phone": {
    "maxLength": 40,
    "type": "string"
   },
   "point_of_contact": {
    "maxLength": 160,
    "type": "string"
   },
   "project_ids": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "service": {
    "maxLength": 200,
    "type": "string"
   },
   "status": {
    "enum": [
     "no_contact",
     "in_contact",
     "order_requested",
     "contract_received",
     "invoice_received",
     "deposit_sent",
     "full_payment_sent",
     "recurring"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "url": {
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "name"
  ],
  "type": "object"
 },
 "name": "add_vendor",
 "title": "Add Vendor"
}

  "additionalProperties": false,
  "properties": {
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   }
  },
  "required": [
   "budget_id"
  ],
  "type": "object"
 },

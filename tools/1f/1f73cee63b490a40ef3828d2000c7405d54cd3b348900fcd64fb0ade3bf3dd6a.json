 "description": "Search Wikidata entities by label or alias (e.g., \"Albert Einstein\", \"Python programming language\", \"Tokyo\"). Returns entity IDs, labels, descriptions, and aliases. Useful for finding the Wikidata ID of any concept.",
 "inputSchema": {
  "examples": [
   {
    "query": "Albert Einstein"
   },
   {
    "language": "en",
    "limit": 5,
    "query": "Python programming language"
   }
  ],
  "properties": {
   "language": {
    "description": "Language code for labels (default \"en\"). E.g., \"fr\", \"de\", \"ja\"",
    "type": "string"
   },
   "limit": {
    "description": "Max results to return (1-50, default 10)",
    "type": "number"
   },
   "query": {
    "description": "Search query (e.g., \"Marie Curie\", \"Bitcoin\", \"Great Wall of China\")",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_entities",
 "outputSchema": {
  "properties": {
   "results": {
    "description": "Array of search results",
    "items": {
     "properties": {
      "aliases": {
       "description": "Alternative names for the entity",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "description": "Entity description in requested language",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Wikidata entity ID (e.g., Q42)",
       "type": "string"
      },
      "label": {
       "description": "Entity label in requested language",
       "type": [
        "string",
        "null"
       ]
      },
      "uri": {
       "description": "Concept URI (e.g., http://www.wikidata.org/entity/Q42)",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "label",
      "description",
      "aliases",
      "uri"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },

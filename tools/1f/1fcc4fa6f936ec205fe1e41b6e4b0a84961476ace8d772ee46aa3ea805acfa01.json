   },
   "search": {
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "has_criteria",
     "open",
     "in_progress",
     "completed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vibemap_list_user_stories"

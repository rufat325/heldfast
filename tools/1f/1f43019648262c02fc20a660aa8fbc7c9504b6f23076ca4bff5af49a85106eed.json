{
 "description": "Update a single ACF field value for a post",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "field": {
    "description": "Field name",
    "type": "string"
   },
   "post_id": {
    "description": "Post ID",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "value": {
    "description": "New value"
   }
  },
  "required": [
   "site",
   "post_id",
   "field"
  ],
  "type": "object"
 },
 "name": "acf_update_post_field"
}

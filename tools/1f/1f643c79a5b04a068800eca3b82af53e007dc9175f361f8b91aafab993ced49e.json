 "description": "Search global sanctions, watchlists, and PEP (politically exposed persons) databases. Returns matched entities with names, countries, datasets, and sanctions details. Example: search_entities(\"Vladimir Putin\") or search_entities(\"Huawei\", schema=\"Company\"). Requires your own OpenSanctions API key, passed as _apiKey.",
 "inputSchema": {
  "examples": [
   {
    "_apiKey": "your-opensanctions-api-key",
    "query": "Gazprom"
   },
   {
    "_apiKey": "your-opensanctions-api-key",
    "countries": "kp",
    "query": "Kim Jong",
    "schema": "Person"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "Your own OpenSanctions API key (BYO \u2014 Pipeworx does not supply one; OpenSanctions is a commercial service). Get one at opensanctions.org/api \u2014 free for non-commercial use, paid for commercial. For a keyless US sanctions/export-control screen, use the sanctions-screening pack (sanctions_screen) instead.",
    "type": "string"
   },
   "countries": {
    "description": "Comma-separated country codes (e.g., \"ru,cn,ir\")",
    "type": "string"
   },
   "query": {
    "description": "Name or keyword to search (e.g., \"Gazprom\", \"Kim Jong\")",
    "type": "string"
   },
   "schema": {
    "description": "Entity type: \"Person\", \"Company\", \"Organization\", \"Vessel\", \"Aircraft\"",
    "type": "string"
   }
  },
  "required": [
   "query",
   "_apiKey"
  ],
  "type": "object"
 },

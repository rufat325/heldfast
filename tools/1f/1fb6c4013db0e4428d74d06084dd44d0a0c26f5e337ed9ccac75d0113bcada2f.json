{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Build a UBL 2.1 / Peppol BIS Billing 3.0 invoice XML from structured invoice fields. It never transmits. 5 credits (EUR 0.05) per successful call; needs a bearer token.",
 "inputSchema": {
  "properties": {
   "buyerReference": {
    "description": "Buyer reference (BT-10), e.g. a PO or cost-centre code.",
    "type": "string"
   },
   "currency": {
    "default": "EUR",
    "description": "ISO 4217 currency code (uppercase).",
    "type": "string"
   },
   "customer": {
    "description": "Buyer / accounting customer party.",
    "properties": {
     "city": {
      "type": "string"
     },
     "countryCode": {
      "description": "ISO 3166-1 alpha-2 country code (uppercase), e.g. BE.",
      "type": "string"
     },
     "endpointId": {
      "description": "Peppol participant endpoint identifier, e.g. a GLN.",
      "type": "string"
     },
     "endpointScheme": {
      "description": "Endpoint scheme id (EAS code).",
      "maxLength": 10,
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "postalZone": {
      "maxLength": 20,
      "type": "string"
     },
     "registrationName": {
      "type": "string"
     },
     "street": {
      "type": "string"
     },
     "vatId": {
      "description": "Legal / VAT registration id, e.g. \"BE0123456789\".",
      "type": "string"
     }
    },
    "required": [
     "name",
     "countryCode"
    ],
    "type": "object"
   },
   "dueDate": {
    "format": "date",
    "type": "string"
   },
   "invoiceNumber": {
    "description": "Human-readable invoice number, e.g. \"INV-2026-0001\".",
    "type": "string"
   },
   "issueDate": {
    "format": "date",
    "type": "string"
   },
   "lines": {
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "taxCategory": {
       "description": "Override the derived UNCL5305 VAT category.",
       "enum": [
        "S",
        "Z",
        "E",
        "AE",
        "K",
        "G",
        "O",
        "L",
        "M"
       ],
       "type": "string"
      },
      "unitCode": {
       "default": "EA",
       "description": "UN/ECE Rec 20 unit code.",
       "maxLength": 10,
       "type": "string"
      },
      "unitPrice": {
       "description": "Price per unit, excluding VAT.",
       "minimum": 0,
       "type": "number"
      },
      "vatPercent": {
       "default": 0,
       "description": "VAT rate as a percentage (0\u2013100).",
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "description",
      "quantity",
      "unitPrice"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "orderReference": {
    "description": "Purchase order reference (BT-13). Peppol requires this OR a buyer reference.",
    "type": "string"
   },
   "supplier": {
    "description": "Seller / accounting supplier party.",
    "properties": {
     "city": {
      "type": "string"
     },
     "countryCode": {
      "description": "ISO 3166-1 alpha-2 country code (uppercase), e.g. BE.",
      "type": "string"
     },
     "endpointId": {
      "description": "Peppol participant endpoint identifier, e.g. a GLN.",
      "type": "string"
     },
     "endpointScheme": {
      "description": "Endpoint scheme id (EAS code).",
      "maxLength": 10,
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "postalZone": {
      "maxLength": 20,
      "type": "string"
     },
     "registrationName": {
      "type": "string"
     },
     "street": {
      "type": "string"
     },
     "vatId": {
      "description": "Legal / VAT registration id, e.g. \"BE0123456789\".",
      "type": "string"
     }
    },
    "required": [
     "name",
     "countryCode"
    ],
    "type": "object"
   }
  },
  "required": [
   "invoiceNumber",
   "issueDate",
   "supplier",
   "customer",
   "lines"
  ],
  "type": "object"
 },
 "name": "format_peppol_invoice",
 "outputSchema": {
  "properties": {
   "billing": {
    "type": "object"
   },
   "data": {
    "type": "object"
   },
   "kind": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "data",
   "billing"
  ],
  "type": "object"
 }
}

 "description": "Europe PMC search for biomedical literature and preprints \u2014 the preprint server index for medicine and life sciences (bioRxiv, medRxiv, Research Square), for drug/clinical/disease preprint questions where arXiv (physics/CS) has nothing. Lucene-style query \u2014 use SRC:PPR to filter to preprints only (e.g. \"lecanemab AND alzheimer AND SRC:PPR\"), AUTH: for author, ABSTRACT: for abstract text. Returns metadata for matching articles.",
 "inputSchema": {
  "examples": [
   {
    "query": "CRISPR AND gene editing"
   },
   {
    "page": 1,
    "pageSize": 50,
    "query": "AUTH:Doudna AND ABSTRACT:cas9"
   },
   {
    "query": "lecanemab AND alzheimer AND SRC:PPR"
   }
  ],
  "properties": {
   "page": {
    "description": "1-based page (default 1)",
    "type": "number"
   },
   "pageSize": {
    "description": "1-100 (default 25)",
    "type": "number"
   },
   "query": {
    "description": "e.g. \"CRISPR OR Cas9\", \"AUTH:Doudna AND ABSTRACT:editing\", \"lecanemab AND SRC:PPR\" (SRC:PPR = preprints only)",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },

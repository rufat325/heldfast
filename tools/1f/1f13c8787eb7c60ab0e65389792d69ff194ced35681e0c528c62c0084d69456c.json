{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Screen one vessel by IMO number against OFAC SDN, EU, UN, UK OFSI and OpenSanctions, with an ownership-opacity score and an A\u2013E vetting grade from port-state-control history. Works with no API key. Rate-limited to 100 requests per hour per IP. Returns the VERDICT SUMMARY only; for every sanctions match with its source list and confidence class use screen_vessel (needs a key).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "imo": {
    "description": "Seven-digit IMO number of the vessel",
    "pattern": "^\\d{7}$",
    "type": "string"
   }
  },
  "required": [
   "imo"
  ],
  "type": "object"
 },
 "name": "check_vessel",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assessed": {
    "description": "false means ownership and vetting are defaults, not findings",
    "type": "boolean"
   },
   "checkedAt": {
    "description": "ISO-8601 time the sources were read; designations change daily",
    "type": "string"
   },
   "fullReport": {
    "description": "Human-readable report URL for this hull",
    "type": "string"
   },
   "imo": {
    "description": "The seven-digit IMO number screened",
    "type": "string"
   },
   "ownership": {
    "additionalProperties": true,
    "properties": {
     "opacity": {
      "type": [
       "string",
       "null"
      ]
     },
     "score": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "rate_limit": {
    "additionalProperties": false,
    "description": "Keyless allowance for the caller's address",
    "properties": {
     "limit": {
      "type": [
       "number",
       "null"
      ]
     },
     "remaining": {
      "type": [
       "number",
       "null"
      ]
     },
     "reset": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "limit",
     "remaining",
     "reset"
    ],
    "type": "object"
   },
   "sanctions": {
    "additionalProperties": true,
    "properties": {
     "coverageComplete": {
      "description": "false when a supplementary list was unavailable \u2014 re-screen before relying on a GREEN",
      "type": "boolean"
     },
     "detail": {
      "description": "One sentence explaining the status",
      "type": "string"
     },
     "status": {
      "description": "RED | AMBER | GREEN | INCOMPLETE",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "vetting": {
    "additionalProperties": true,
    "properties": {
     "grade": {
      "type": [
       "string",
       "null"
      ]
     },
     "score": {
      "type": [
       "number",
       "null"
      ]
     },
     "status": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "imo",
   "sanctions",
   "checkedAt",
   "rate_limit"
  ],
  "type": "object"
 },
 "title": "Check a vessel (no key)"
}

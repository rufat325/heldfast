{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get a comprehensive safety profile for a vehicle. Combines NCAP crash test ratings, recalls, and complaint summary into a single response. Use as the default when asked about vehicle safety, reliability, or purchase decisions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "make": {
    "description": "Vehicle manufacturer (e.g., \"Toyota\", \"Ford\"). Case-insensitive.",
    "type": "string"
   },
   "model": {
    "description": "Vehicle model (e.g., \"Camry\", \"F-150\"). Case-insensitive.",
    "type": "string"
   },
   "modelYear": {
    "description": "Model year, a whole number (e.g., 2020).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "make",
   "model",
   "modelYear"
  ],
  "type": "object"
 },
 "name": "nhtsa_get_vehicle_safety",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "sectionStatus",
     "warnings",
     "effectiveQuery"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "complaintSummary": {
    "additionalProperties": false,
    "description": "Summary of consumer complaints",
    "properties": {
     "componentBreakdown": {
      "description": "Complaints grouped by component",
      "items": {
       "additionalProperties": false,
       "description": "Complaint counts for a single component",
       "properties": {
        "component": {
         "description": "Component name",
         "type": "string"
        },
        "count": {
         "description": "Number of complaints",
         "type": "number"
        },
        "crashCount": {
         "description": "Complaints involving crashes",
         "type": "number"
        },
        "deathCount": {
         "description": "Total deaths reported",
         "type": "number"
        },
        "fireCount": {
         "description": "Complaints involving fires",
         "type": "number"
        },
        "injuryCount": {
         "description": "Total injuries reported",
         "type": "number"
        }
       },
       "required": [
        "component",
        "count",
        "crashCount",
        "fireCount",
        "injuryCount",
        "deathCount"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "crashCount": {
      "description": "Total complaints involving crashes",
      "type": "number"
     },
     "deathCount": {
      "description": "Total deaths across all complaints",
      "type": "number"
     },
     "fireCount": {
      "description": "Total complaints involving fires",
      "type": "number"
     },
     "injuryCount": {
      "description": "Total injuries across all complaints",
      "type": "number"
     },
     "totalCount": {
      "description": "Total complaints filed",
      "type": "number"
     }
    },
    "required": [
     "totalCount",
     "componentBreakdown",
     "crashCount",
     "fireCount",
     "injuryCount",
     "deathCount"
    ],
    "type": "object"
   },
   "effectiveQuery": {
    "description": "The vehicle queried, as \"make model modelYear\".",
    "type": "string"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode.",
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "notice": {
    "description": "Guidance when no NHTSA records matched the vehicle \u2014 e.g. how to verify make/model/year spelling.",
    "type": "string"
   },
   "recalls": {
    "description": "All recalls for this vehicle when available",
    "items": {
     "additionalProperties": false,
     "description": "A single recall campaign",
     "properties": {
      "campaignNumber": {
       "description": "NHTSA campaign number",
       "type": "string"
      },
      "component": {
       "description": "Affected component",
       "type": "string"
      },
      "consequence": {
       "description": "Safety consequence",
       "type": "string"
      },
      "manufacturer": {
       "description": "Vehicle/equipment manufacturer",
       "type": "string"
      },
      "overTheAirUpdate": {
       "description": "OTA update availability when provided by NHTSA",
       "type": "boolean"
      },
      "parkIt": {
       "description": "Do-not-drive advisory when provided by NHTSA",
       "type": "boolean"
      },
      "parkOutSide": {
       "description": "Park-outside advisory when provided by NHTSA",
       "type": "boolean"
      },
      "remedy": {
       "description": "Corrective action",
       "type": "string"
      },
      "reportReceivedDate": {
       "description": "Date recall was reported",
       "type": "string"
      },
      "summary": {
       "description": "Recall summary",
       "type": "string"
      }
     },
     "required": [
      "campaignNumber",
      "manufacturer",
      "component",
      "summary",
      "consequence",
      "remedy",
      "reportReceivedDate"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "safetyRatings": {
    "description": "Crash test ratings per vehicle variant (e.g., FWD vs AWD)",
    "items": {
     "additionalProperties": false,
     "description": "Safety ratings for a single vehicle variant",
     "properties": {
      "adasFeatures": {
       "additionalProperties": false,
       "description": "Advanced driver assistance features",
       "properties": {
        "electronicStabilityControl": {
         "description": "ESC availability",
         "type": "string"
        },
        "forwardCollisionWarning": {
         "description": "FCW availability",
         "type": "string"
        },
        "laneDepartureWarning": {
         "description": "LDW availability",
         "type": "string"
        }
       },
       "type": "object"
      },
      "frontalCrash": {
       "additionalProperties": false,
       "description": "Frontal crash test ratings",
       "properties": {
        "driverSide": {
         "description": "Driver-side frontal crash rating",
         "type": "string"
        },
        "overall": {
         "description": "Overall frontal crash rating",
         "type": "string"
        },
        "passengerSide": {
         "description": "Passenger-side frontal crash rating",
         "type": "string"
        }
       },
       "type": "object"
      },
      "overallRating": {
       "description": "Overall safety rating (1-5 stars or \"Not Rated\")",
       "type": "string"
      },
      "rollover": {
       "additionalProperties": false,
       "description": "Rollover risk assessment",
       "properties": {
        "dynamicTipResult": {
         "description": "Dynamic tip test result",
         "type": "string"
        },
        "probability": {
         "description": "Rollover probability (0-1 scale)",
         "type": "number"
        },
        "rating": {
         "description": "Rollover resistance rating",
         "type": "string"
        }
       },
       "type": "object"
      },
      "sideCrash": {
       "additionalProperties": false,
       "description": "Side crash test ratings",
       "properties": {
        "barrierOverall": {
         "description": "Side barrier overall rating",
         "type": "string"
        },
        "combinedBarrierPoleFront": {
         "description": "Combined barrier/pole front rating",
         "type": "string"
        },
        "combinedBarrierPoleRear": {
         "description": "Combined barrier/pole rear rating",
         "type": "string"
        },
        "driverSide": {
         "description": "Driver-side rating",
         "type": "string"
        },
        "overall": {
         "description": "Overall side crash rating",
         "type": "string"
        },
        "passengerSide": {
         "description": "Passenger-side rating",
         "type": "string"
        },
        "pole": {
         "description": "Side pole crash rating",
         "type": "string"
        }
       },
       "type": "object"
      },
      "vehicleDescription": {
       "description": "Vehicle variant description",
       "type": "string"
      },
      "vehicleId": {
       "description": "NCAP vehicle ID for follow-up queries",
       "type": "number"
      }
     },
     "required": [
      "vehicleId",
      "frontalCrash",
      "sideCrash",
      "rollover",
      "adasFeatures"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sectionStatus": {
    "additionalProperties": false,
    "description": "Availability of each data section in this response",
    "properties": {
     "complaints": {
      "description": "Availability of complaint data in this response",
      "enum": [
       "available",
       "partial",
       "unavailable"
      ],
      "type": "string"
     },
     "recalls": {
      "description": "Availability of recall data in this response",
      "enum": [
       "available",
       "partial",
       "unavailable"
      ],
      "type": "string"
     },
     "safetyRatings": {
      "description": "Availability of NCAP safety ratings in this response",
      "enum": [
       "available",
       "partial",
       "unavailable"
      ],
      "type": "string"
     }
    },
    "required": [
     "safetyRatings",
     "recalls",
     "complaints"
    ],
    "type": "object"
   },
   "warnings": {
    "description": "Warnings about sections that could not be loaded from NHTSA",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Nhtsa Get Vehicle Safety"
}

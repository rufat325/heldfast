{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Evidence List"
 },
 "description": "Lists all evidence records in a specific evidence group. Use to review uploaded documents before sealing the group, or to find a specific evidenceId. Requires: caseFileId and evidenceGroupId. Returns paginated list with IDs, titles, status, and timestamps.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "caseFileId": {
    "type": "string"
   },
   "evidenceGroupId": {
    "type": "string"
   },
   "filter": {
    "properties": {
     "capturedFrom": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "capturedUntil": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "caseFileId": {
      "type": "string"
     },
     "collectionMetadata": {
      "type": "boolean"
     },
     "evidenceGroupIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "evidenceGroupTypes": {
      "items": {
       "enum": [
        "FILE",
        "PHOTO",
        "VIDEO",
        "WEB_PLUGIN"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "favorite": {
      "type": "boolean"
     },
     "id": {
      "type": "string"
     },
     "ids": {
      "items": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "type": "array"
     },
     "relevant": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "COMPLETED",
       "IN_PROCESS",
       "ERROR"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "order": {
    "properties": {
     "capturedAt": {
      "enum": [
       "ASC",
       "DESC"
      ],
      "type": "string"
     },
     "evidenceGroupName": {
      "enum": [
       "ASC",
       "DESC"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "page": {
    "properties": {
     "number": {
      "default": 1,
      "minimum": 1,
      "type": "number"
     },
     "size": {
      "default": 20,
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "caseFileId",
   "evidenceGroupId"
  ],
  "type": "object"
 },
 "name": "evidence_list"
}

{
 "description": "Generate a set of images for visual exploration and discovery \u2014 diverse results from a prompt, no fine-grained style/color control. Returns image IDs usable with recraft_explore_similar.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "controls": {
    "description": "Generation controls",
    "properties": {
     "artistic_level": {
      "description": "Artistic level 0-5 (V3 only)",
      "maximum": 5,
      "minimum": 0,
      "type": "integer"
     },
     "background_color": {
      "description": "Background color RGB (0-255)",
      "properties": {
       "b": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "g": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "r": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "r",
       "g",
       "b"
      ],
      "type": "object"
     },
     "colors": {
      "description": "Preferred color palette, e.g. [[255,0,0],[0,255,0]]",
      "items": {
       "items": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "type": "array"
      },
      "type": "array"
     },
     "no_text": {
      "description": "Exclude text layouts (V3 only)",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "model": {
    "default": "recraftv4_1",
    "description": "Model: recraftv4_1, recraftv4_1_vector, recraftv4_1_pro, recraftv4_1_pro_vector, recraftv4, recraftv4_vector, recraftv4_pro, recraftv4_pro_vector",
    "type": "string"
   },
   "prompt": {
    "description": "Image description",
    "type": "string"
   },
   "response_format": {
    "default": "url",
    "description": "Response format",
    "enum": [
     "url",
     "b64_json"
    ],
    "type": "string"
   },
   "size": {
    "default": "1:1",
    "description": "Image size or ratio",
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "recraft_explore"
}

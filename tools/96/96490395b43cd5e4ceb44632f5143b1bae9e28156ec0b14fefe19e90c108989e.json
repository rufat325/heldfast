{
 "description": "Generate a styled QR code image. Supports custom colors, error correction, and frame templates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "background": {
    "description": "Background hex color without # (default: ffffff)",
    "type": "string"
   },
   "data": {
    "description": "Data to encode (URL, text, WiFi, email, phone, or SMS)",
    "maxLength": 2953,
    "type": "string"
   },
   "errorCorrectionLevel": {
    "description": "Error correction level (default: M)",
    "enum": [
     "L",
     "M",
     "Q",
     "H"
    ],
    "type": "string"
   },
   "foreground": {
    "description": "Foreground hex color without # (default: 000000)",
    "type": "string"
   },
   "format": {
    "description": "Output format (default: png)",
    "enum": [
     "png",
     "svg"
    ],
    "type": "string"
   },
   "frameId": {
    "description": "Frame template ID from list_frames",
    "type": "string"
   },
   "margin": {
    "description": "Quiet zone margin (default: 4)",
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "size": {
    "description": "Image size in pixels (default: 512)",
    "maximum": 2048,
    "minimum": 64,
    "type": "number"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "name": "generate_qr"
}

{
 "description": "Run a memory consolidation cycle. Promotes important memories upward, drops decayed entries. With merge=true, uses LLM to merge similar memories.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "decay_drop_threshold": {
    "description": "Drop below this recency (default 0.01)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "merge": {
    "description": "Use LLM to merge similar memories",
    "type": "boolean"
   },
   "promote_min_importance": {
    "description": "Min importance to promote (default 0.6)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "promote_threshold": {
    "description": "Min access count to promote (default 3)",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "engram_consolidate"
}

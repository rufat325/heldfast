{
 "description": "List submissions for a custom form, each with label/value pairs and the matter it created.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fetch_all": {
    "description": "Follow pagination (capped at 1,000 records).",
    "type": "boolean"
   },
   "form_uuid": {
    "description": "The form's UUID (from list-forms).",
    "type": "string"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "form_uuid"
  ],
  "type": "object"
 },
 "name": "get-form-entries"
}

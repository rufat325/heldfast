{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Render a PDF invoice, returned as base64, from structured invoice data. 2 credits (EUR 0.02) per successful call; needs a bearer token.",
 "inputSchema": {
  "properties": {
   "currency": {
    "default": "EUR",
    "description": "ISO 4217 currency code (uppercase).",
    "type": "string"
   },
   "customer": {
    "description": "The company being BILLED.",
    "properties": {
     "address": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     },
     "registrationNumber": {
      "description": "Company registration number (KBO/BCE for Belgium).",
      "type": "string"
     },
     "vatId": {
      "description": "VAT / registration id, e.g. BE0123456789.",
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "dueDate": {
    "description": "Optional due date (ISO 8601).",
    "maxLength": 40,
    "type": "string"
   },
   "invoiceNumber": {
    "description": "Invoice number, e.g. \"INV-2026-0001\".",
    "type": "string"
   },
   "issueDate": {
    "description": "Issue date (ISO 8601), e.g. 2026-06-06.",
    "maxLength": 40,
    "type": "string"
   },
   "lines": {
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "quantity": {
       "minimum": 0,
       "type": "number"
      },
      "unitPrice": {
       "description": "Unit price, excluding VAT.",
       "type": "number"
      },
      "vatPercent": {
       "default": 0,
       "description": "VAT rate as a percentage, e.g. 21.",
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "description",
      "quantity",
      "unitPrice"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "notes": {
    "type": "string"
   },
   "supplier": {
    "description": "The company ISSUING the invoice (you / your business).",
    "properties": {
     "address": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     },
     "registrationNumber": {
      "description": "Company registration number (KBO/BCE for Belgium).",
      "type": "string"
     },
     "vatId": {
      "description": "VAT / registration id, e.g. BE0123456789.",
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   }
  },
  "required": [
   "invoiceNumber",
   "issueDate",
   "supplier",
   "customer",
   "lines"
  ],
  "type": "object"
 },
 "name": "generate_pdf_invoice",
 "outputSchema": {
  "properties": {
   "billing": {
    "type": "object"
   },
   "data": {
    "type": "object"
   },
   "kind": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "data",
   "billing"
  ],
  "type": "object"
 }
}

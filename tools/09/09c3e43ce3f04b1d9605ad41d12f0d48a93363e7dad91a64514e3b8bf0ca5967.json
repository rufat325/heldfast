{
 "description": "Lista citas del negocio. \u00datil para '\u00bfqu\u00e9 tengo hoy?', '\u00bfqu\u00e9 hay ma\u00f1ana?'. Acepta rango de fechas ISO y filtros.",
 "inputSchema": {
  "properties": {
   "attended": {
    "type": "boolean"
   },
   "customerId": {
    "type": "string"
   },
   "from": {
    "description": "ISO date inicio (inclusive)",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "type": "number"
   },
   "serviceId": {
    "type": "string"
   },
   "status": {
    "enum": [
     "CONFIRMED",
     "pending",
     "CANCELLED"
    ],
    "type": "string"
   },
   "to": {
    "description": "ISO date fin (inclusive)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_events"
}

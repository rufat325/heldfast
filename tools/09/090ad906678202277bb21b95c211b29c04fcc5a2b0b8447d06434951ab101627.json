{
 "description": "Create a custom Granoflow tag. Defaults to dry-run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": true,
    "description": "When true, previews the request without writing.",
    "type": "boolean"
   },
   "iconKey": {
    "type": "string"
   },
   "label": {
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "label"
  ],
  "type": "object"
 },
 "name": "granoflow_tag_create"
}

{
 "description": "Muestra el detalle completo de un endpoint: par\u00e1metros, body schema, y respuestas. \u00datil para saber qu\u00e9 datos enviar.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "method": {
    "description": "M\u00e9todo HTTP del endpoint",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "PATCH",
     "DELETE",
     "HEAD",
     "OPTIONS"
    ],
    "type": "string"
   },
   "name": {
    "description": "Nombre del API importada. Si se omite y solo hay un spec, lo usa autom\u00e1ticamente",
    "type": "string"
   },
   "path": {
    "description": "Path exacto del endpoint (ej: \"/blog\", \"/auth/login\")",
    "type": "string"
   }
  },
  "required": [
   "method",
   "path"
  ],
  "type": "object"
 },
 "name": "api_endpoint_detail"
}

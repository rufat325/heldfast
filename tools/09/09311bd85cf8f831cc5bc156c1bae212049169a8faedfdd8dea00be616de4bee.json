 "description": "SEC Form 8-K material event filings for a US-listed company, with the 8-K item codes decoded (earnings release, acquisition completed, officer departure, material agreement, delisting notice\u2026). Answers what significant corporate events a company has disclosed and when.",
 "inputSchema": {
  "examples": [
   {
    "ticker": "AAPL"
   },
   {
    "days": 180,
    "limit": 10,
    "ticker": "NVDA"
   }
  ],
  "properties": {
   "days": {
    "description": "Look back period in days (default: 180)",
    "type": "number"
   },
   "limit": {
    "description": "Max filings to return (default: 15, max 200)",
    "type": "number"
   },
   "ticker": {
    "description": "Stock ticker (\"AAPL\"), company name, or CIK",
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "insider_8k",
 "outputSchema": {
  "properties": {
   "cik": {
    "description": "SEC CIK the ticker resolved to (unpadded)",
    "type": "string"
   },
   "company_name": {
    "description": "Canonical SEC registrant name",
    "type": "string"
   },
   "filings": {
    "items": {
     "properties": {
      "accession": {
       "description": "SEC accession number",
       "type": "string"
      },

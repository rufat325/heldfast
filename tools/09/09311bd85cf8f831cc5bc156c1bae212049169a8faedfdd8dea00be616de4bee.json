      },
      "date": {
       "description": "Filing date",
       "type": "string"
      },
      "filing_url": {
       "description": "URL to SEC filing document",
       "type": "string"
      },
      "items": {
       "items": {
        "properties": {
         "code": {
          "description": "8-K item code (e.g., 2.02, 5.02)",
          "type": "string"
         },
         "description": {
          "description": "Human-readable description of the event type",
          "type": "string"
         }
        },
        "required": [
         "code",
         "description"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "date",
      "company",
      "items",
      "accession",
      "filing_url"
     ],
     "type": "object"
    },
    "type": "array"
   },

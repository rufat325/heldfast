{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Send an evidence-backed review request; the repository-diff fallback requires the subject session workspace and never guesses process.cwd().",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "acceptanceCriteria": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "objective": {
    "type": "string"
   },
   "reviewerNativeId": {
    "type": "string"
   },
   "reviewerProvider": {
    "enum": [
     "freebuff",
     "opencode",
     "codex",
     "claude-code",
     "cursor"
    ],
    "type": "string"
   },
   "subjectNativeId": {
    "type": "string"
   },
   "subjectProvider": {
    "enum": [
     "freebuff",
     "opencode",
     "codex",
     "claude-code",
     "cursor"
    ],
    "type": "string"
   },
   "workId": {
    "type": "string"
   }
  },
  "required": [
   "workId",
   "subjectProvider",
   "subjectNativeId",
   "reviewerProvider",
   "reviewerNativeId",
   "objective",
   "acceptanceCriteria"
  ],
  "type": "object"
 },
 "name": "review_request"
}

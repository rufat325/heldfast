{
 "description": "Add spoken dialogue to an event page in one call \u2014 builds the Show Text (101) and text-line (401) commands automatically, splitting into multiple message boxes every 4 lines. Inserted before the page's end, like add_event_command.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "background": {
    "default": 0,
    "description": "0 window, 1 dim, 2 transparent",
    "maximum": 2,
    "minimum": 0,
    "type": "integer"
   },
   "eventId": {
    "minimum": 1,
    "type": "integer"
   },
   "faceIndex": {
    "default": 0,
    "maximum": 7,
    "minimum": 0,
    "type": "integer"
   },
   "faceName": {
    "default": "",
    "description": "Face image file (e.g. 'Actor1'), empty for none",
    "type": "string"
   },
   "lines": {
    "description": "Dialogue lines (a new message box starts every 4 lines)",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "mapId": {
    "minimum": 1,
    "type": "integer"
   },
   "pageIndex": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "position": {
    "default": 2,
    "description": "0 top, 1 middle, 2 bottom",
    "maximum": 2,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "mapId",
   "eventId",
   "lines"
  ],
  "type": "object"
 },
 "name": "add_dialogue",
 "title": "Add dialogue"
}

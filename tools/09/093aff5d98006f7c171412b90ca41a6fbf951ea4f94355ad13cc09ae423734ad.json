{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "List features for a VibeMap project. Supports filtering by status, priority, category, and search. Returns paginated results.",
 "inputSchema": {
  "properties": {
   "category": {
    "enum": [
     "core",
     "enhancement",
     "infrastructure"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "type": "number"
   },
   "priority": {
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "search": {
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "open",
     "in_progress",
     "completed"
    ],
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "vibemap_list_features"
}

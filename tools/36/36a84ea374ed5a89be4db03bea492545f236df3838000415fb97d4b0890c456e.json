{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new server with the specified type, image, and configuration options.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "automount": {
    "description": "Auto-mount the volumes passed in \"volumes\" after attach",
    "type": "boolean"
   },
   "firewalls": {
    "description": "Firewalls to apply to the server",
    "items": {
     "properties": {
      "firewall": {
       "description": "Firewall ID",
       "type": "number"
      }
     },
     "required": [
      "firewall"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "image": {
    "description": "Image name or ID to use (e.g. \"ubuntu-22.04\", \"debian-12\")",
    "type": "string"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Labels as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "location": {
    "description": "Location name (e.g. \"fsn1\", \"nbg1\", \"hel1\")",
    "type": "string"
   },
   "name": {
    "description": "Name of the server",
    "type": "string"
   },
   "networks": {
    "description": "Network IDs to attach the server to",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "placement_group": {
    "description": "Placement group ID",
    "type": "number"
   },
   "public_net": {
    "description": "Public network configuration",
    "properties": {
     "enable_ipv4": {
      "description": "Enable public IPv4 address",
      "type": "boolean"
     },
     "enable_ipv6": {
      "description": "Enable public IPv6 address",
      "type": "boolean"
     },
     "ipv4": {
      "description": "Primary IP ID for IPv4",
      "type": "number"
     },
     "ipv6": {
      "description": "Primary IP ID for IPv6",
      "type": "number"
     }
    },
    "type": "object"
   },
   "server_type": {
    "description": "Server type name or ID (e.g. \"cx22\", \"cpx11\")",
    "type": "string"
   },
   "ssh_keys": {
    "description": "SSH key names or IDs to inject",
    "items": {
     "type": [
      "string",
      "number"
     ]
    },
    "type": "array"
   },
   "start_after_create": {
    "description": "Start server after creation (default: true)",
    "type": "boolean"
   },
   "user_data": {
    "description": "Cloud-init user data (base64 or plain text)",
    "type": "string"
   },
   "volumes": {
    "description": "Volume IDs to attach at creation",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "server_type",
   "image"
  ],
  "type": "object"
 },
 "name": "hetzner_create_server",
 "title": "Create Server"
}

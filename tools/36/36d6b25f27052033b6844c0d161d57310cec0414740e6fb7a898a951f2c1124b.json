{
 "description": "Retrieve bank account statement (extrato) for a period from Omie ERP",
 "inputSchema": {
  "properties": {
   "cCodIntCC": {
    "description": "Bank account integration code (alternative to nCodCC)",
    "type": "string"
   },
   "cExibirApenasSaldo": {
    "description": "Show only balances (S/N)",
    "enum": [
     "S",
     "N"
    ],
    "type": "string"
   },
   "dPeriodoFinal": {
    "description": "End date (DD/MM/YYYY)",
    "type": "string"
   },
   "dPeriodoInicial": {
    "description": "Start date (DD/MM/YYYY)",
    "type": "string"
   },
   "nCodCC": {
    "description": "Bank account ID",
    "type": "number"
   }
  },
  "required": [
   "dPeriodoInicial",
   "dPeriodoFinal"
  ],
  "type": "object"
 },
 "name": "get_bank_statement"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update an FAQ"
 },
 "description": "Update an FAQ. Partial update. Changing question, answer or keywords re-embeds it; changing only active does not.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "active": {
    "type": "boolean"
   },
   "answer": {
    "maxLength": 10000,
    "type": "string"
   },
   "category_id": {
    "type": [
     "integer",
     "null"
    ]
   },
   "id": {
    "description": "Numeric id.",
    "type": "integer"
   },
   "keywords": {
    "description": "Comma-separated hints for matching.",
    "maxLength": 1000,
    "type": [
     "string",
     "null"
    ]
   },
   "question": {
    "maxLength": 1000,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_faq"
}

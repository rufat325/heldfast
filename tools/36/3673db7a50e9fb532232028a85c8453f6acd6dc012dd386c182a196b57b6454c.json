 "description": "Screen an Oman supplier for procurement using company identity, business activity, website, contact consistency, address signals, public-risk indicators and sanctions screening. Use before adding an Oman supplier to an RFQ, vendor shortlist, procurement process or supplier onboarding workflow.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "address": {
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   },
   "companyName": {
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "crNumber": {
    "maxLength": 30,
    "minLength": 3,
    "pattern": "^[0-9A-Za-z][0-9A-Za-z\\s\\-/.]*$",
    "type": "string"
   },
   "email": {
    "maxLength": 254,
    "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
    "type": "string"
   },
   "phone": {
    "maxLength": 30,
    "minLength": 6,
    "pattern": "^[+0-9\\s()\\-.xX*]+$",
    "type": "string"
   },
   "requiredProductOrService": {
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "website": {
    "maxLength": 300,
    "minLength": 4,
    "type": "string"
   }
  },
  "required": [
   "companyName"
  ],
  "type": "object"
 },

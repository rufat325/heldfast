{
 "description": "Audit webhook deliveries for declared events, allowed versions, required payload fields, signature evidence, freshness, idempotency, and replay. Costs $0.05 USDC on Base mainnet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contracts": {
    "items": {
     "additionalProperties": true,
     "required": [
      "event"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "deliveries": {
    "items": {
     "additionalProperties": true,
     "required": [
      "id",
      "event",
      "payload"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "observed_at": {
    "type": "string"
   }
  },
  "required": [
   "observed_at",
   "contracts",
   "deliveries"
  ],
  "type": "object"
 },
 "name": "justhandled_webhook_contract_replay_auditor"
}

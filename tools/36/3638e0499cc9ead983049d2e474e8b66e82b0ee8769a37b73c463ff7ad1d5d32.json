{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new firewall with optional rules and resource assignments.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apply_to": {
    "description": "Resources to apply the firewall to",
    "items": {
     "properties": {
      "label_selector": {
       "description": "Label selector (for type \"label_selector\")",
       "properties": {
        "selector": {
         "description": "Label selector",
         "type": "string"
        }
       },
       "required": [
        "selector"
       ],
       "type": "object"
      },
      "server": {
       "description": "Server to apply to (for type \"server\")",
       "properties": {
        "id": {
         "description": "Server ID",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        }
       },
       "required": [
        "id"
       ],
       "type": "object"
      },
      "type": {
       "description": "Resource type to apply to",
       "enum": [
        "server",
        "label_selector"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Labels as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Name of the firewall",
    "type": "string"
   },
   "rules": {
    "description": "Array of firewall rules",
    "items": {
     "properties": {
      "description": {
       "description": "Description of the rule",
       "type": "string"
      },
      "destination_ips": {
       "description": "CIDR destination IPs (required for direction \"out\")",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "direction": {
       "description": "Direction of traffic: in or out",
       "enum": [
        "in",
        "out"
       ],
       "type": "string"
      },
      "port": {
       "description": "Port or port range (e.g. \"80\" or \"1-1024\"), required for tcp/udp",
       "type": "string"
      },
      "protocol": {
       "description": "Network protocol",
       "enum": [
        "tcp",
        "udp",
        "icmp",
        "esp",
        "gre"
       ],
       "type": "string"
      },
      "source_ips": {
       "description": "CIDR source IPs (required for direction \"in\")",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "direction",
      "protocol"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "hetzner_create_firewall",
 "title": "Create Firewall"
}

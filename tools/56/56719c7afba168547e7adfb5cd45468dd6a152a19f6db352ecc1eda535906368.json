{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Log a supplement dose for the signed-in user. Omit `supplement` to log the user's whole stack for the day. Defaults to today / taken. Requires the user to be signed in (`supstack login`).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "block": {
    "enum": [
     "morning",
     "breakfast",
     "midday",
     "dinner",
     "bedtime"
    ],
    "type": "string"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "status": {
    "default": "taken",
    "enum": [
     "taken",
     "skipped"
    ],
    "type": "string"
   },
   "supplement": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "supstack_track_log"
}

{
 "description": "Set the GPS location of a running emulator.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "latitude": {
    "description": "Latitude in decimal degrees",
    "type": "number"
   },
   "longitude": {
    "description": "Longitude in decimal degrees",
    "type": "number"
   },
   "serial": {
    "description": "Emulator serial (defaults to session or the only device)",
    "type": "string"
   }
  },
  "required": [
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
 "name": "set_emulator_location",
 "title": "Set emulator location"
}

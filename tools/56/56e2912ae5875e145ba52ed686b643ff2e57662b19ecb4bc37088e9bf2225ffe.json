{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Make an HTTP GET/POST through Gatekeeper. The destination host is subject to egress policy (allow / approve / deny). Returns status/headers/body on allow.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "type": "string"
   },
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "method": {
    "enum": [
     "GET",
     "POST"
    ],
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "url": {
    "description": "Absolute URL.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "method"
  ],
  "type": "object"
 },
 "name": "http_request",
 "title": "Make an HTTP request (policy-gated)"
}

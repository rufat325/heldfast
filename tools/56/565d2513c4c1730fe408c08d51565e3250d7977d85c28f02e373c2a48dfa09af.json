{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:scan"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a full-site scan run's findings"
 },
 "description": "Run-level, rule-deduplicated findings for a scan_site run \u2014 one entry per rule, with the WCAG success criteria it maps to. Pro+. For a single-page scan from scan_url, use get_findings instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "runId": {
    "description": "The id returned by scan_site.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "runId"
  ],
  "type": "object"
 },
 "name": "get_run_findings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "violations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "failureSummary": {
       "type": "string"
      },
      "helpUrl": {
       "type": "string"
      },
      "htmlSnippet": {
       "type": "string"
      },
      "impact": {
       "type": "string"
      },
      "ruleId": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      },
      "wcagSc": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "ruleId",
      "impact",
      "wcagSc",
      "helpUrl",
      "target",
      "htmlSnippet",
      "failureSummary"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "violations"
  ],
  "type": "object"
 },
 "title": "Get a full-site scan run's findings"
}

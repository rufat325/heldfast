{
 "description": "Execute a custom GraphQL query against a Polymarket subgraph",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "query": {
    "description": "GraphQL query string",
    "type": "string"
   },
   "subgraph": {
    "description": "Subgraph identifier: main, beefy_pnl, slimmed_pnl, activity, or orderbook",
    "enum": [
     "main",
     "beefy_pnl",
     "slimmed_pnl",
     "activity",
     "orderbook",
     "open_interest",
     "resolution",
     "traders",
     "v2_orderbook",
     "v2_pnl",
     "v2_main"
    ],
    "type": "string"
   },
   "variables": {
    "additionalProperties": {},
    "description": "Optional GraphQL variables as key-value pairs",
    "type": "object"
   }
  },
  "required": [
   "subgraph",
   "query"
  ],
  "type": "object"
 },
 "name": "query_subgraph"
}

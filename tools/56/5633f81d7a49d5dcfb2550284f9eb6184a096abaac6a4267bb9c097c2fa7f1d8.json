           {
            "additionalProperties": {},
            "properties": {
             "count": {
              "anyOf": [
               {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
               },
               {
                "type": "null"
               }
              ]
             },
             "episodesWatched": {
              "anyOf": [

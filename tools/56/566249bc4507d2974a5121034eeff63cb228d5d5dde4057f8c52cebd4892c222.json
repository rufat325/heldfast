{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Start a media upload"
 },
 "description": "Reserve an id and get a short-lived URL to PUT the file to. The bytes go straight to storage, not through this API. Call media_confirm with the same id once the PUT succeeds \u2014 nothing is recorded until then.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "kind": {
    "description": "What the file is.",
    "enum": [
     "image",
     "video",
     "audio"
    ],
    "type": "string"
   },
   "mime_type": {
    "description": "The exact Content-Type the PUT will send, e.g. video/mp4.",
    "type": "string"
   }
  },
  "required": [
   "kind",
   "mime_type"
  ],
  "type": "object"
 },
 "name": "media_upload",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expires_in_seconds": {
    "type": "number"
   },
   "id": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "url",
   "expires_in_seconds"
  ],
  "type": "object"
 },
 "title": "Start a media upload"
}

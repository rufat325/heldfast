{
 "description": "Update fields of an existing memory by its numeric ID. Only provided fields are changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "New full content",
    "maxLength": 5000,
    "type": "string"
   },
   "importance": {
    "description": "New importance score 0-1",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "memory_id": {
    "description": "Numeric ID of the memory to update",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "memory_type": {
    "description": "New memory type",
    "enum": [
     "episodic",
     "semantic",
     "procedural",
     "self_model",
     "introspective"
    ],
    "type": "string"
   },
   "summary": {
    "description": "New summary text",
    "maxLength": 500,
    "type": "string"
   },
   "tags": {
    "description": "Replacement tag list",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "memory_id"
  ],
  "type": "object"
 },
 "name": "update_memory"
}

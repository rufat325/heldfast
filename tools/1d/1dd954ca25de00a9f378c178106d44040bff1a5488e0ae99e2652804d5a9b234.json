{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Turn a named recipe or a brief into compile-ready named-template slides. Expand never publishes and never invents metrics.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "brief": {
    "maxLength": 8000,
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "maxLength": 12,
    "minLength": 2,
    "type": "string"
   },
   "name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "offer": {
    "maxLength": 400,
    "minLength": 1,
    "type": "string"
   },
   "platform": {
    "enum": [
     "tiktok_photo",
     "instagram_4x5",
     "linkedin"
    ],
    "type": "string"
   },
   "product": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "recipeId": {
    "enum": [
     "curiosity_gap_ugc_7",
     "result_first_demo_6",
     "myth_guillotine_8",
     "before_after_5",
     "from_brief"
    ],
    "type": "string"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "recipeId"
  ],
  "type": "object"
 },
 "name": "carousels_expand_recipe",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "type": "string"
   },
   "platform": {
    "enum": [
     "tiktok_photo",
     "instagram_4x5",
     "linkedin"
    ],
    "type": "string"
   },
   "recipe_id": {
    "enum": [
     "curiosity_gap_ugc_7",
     "result_first_demo_6",
     "myth_guillotine_8",
     "before_after_5",
     "from_brief"
    ],
    "type": "string"
   },
   "slides": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "layout": {
       "enum": [
        "chip_stack_ui",
        "chip_stack_face_safe",
        "chip_stack_top",
        "title_body_card"
       ],
       "type": "string"
      },
      "layout_overrides": {
       "additionalProperties": false,
       "properties": {
        "top_px": {
         "maximum": 1920,
         "minimum": 0,
         "type": "integer"
        }
       },
       "type": "object"
      },
      "lines": {
       "default": [],
       "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 6,
       "type": "array"
      },
      "role": {
       "enum": [
        "hook",
        "body",
        "proof",
        "cta"
       ],
       "type": "string"
      },
      "slots": {
       "additionalProperties": {
        "maxLength": 4000,
        "type": "string"
       },
       "propertyNames": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       },
       "type": "object"
      },
      "visual": {
       "additionalProperties": false,
       "properties": {
        "color": {
         "pattern": "^#[0-9a-fA-F]{6}$",
         "type": "string"
        },
        "colors": {
         "items": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
         },
         "maxItems": 2,
         "minItems": 1,
         "type": "array"
        },
        "html": {
         "maxLength": 80000,
         "minLength": 20,
         "type": "string"
        },
        "kind": {
         "enum": [
          "media_asset",
          "generate",
          "solid",
          "gradient",
          "html",
          "template"
         ],
         "type": "string"
        },
        "media_asset_id": {
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        "model_id": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "prompt": {
         "maxLength": 1000,
         "minLength": 3,
         "type": "string"
        },
        "source_media_asset_id": {
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        "template_id": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "kind"
       ],
       "type": "object"
      }
     },
     "required": [
      "lines",
      "visual"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "recipe_id",
   "name",
   "platform",
   "slides"
  ],
  "type": "object"
 },
 "title": "Expand Carousel Recipe"
}

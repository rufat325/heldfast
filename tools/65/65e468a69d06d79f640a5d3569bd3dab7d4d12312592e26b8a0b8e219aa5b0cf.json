{
 "description": "Record value-free current-epoch inventory, missing-tab, close-receipt, post-close absence, or close-failure evidence. closed_verified requires complete controller+user union inventory, an explicit close receipt, and post-close union absence.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adapterCode": {
    "pattern": "^[a-z0-9][a-z0-9_:-]{0,99}$",
    "type": "string"
   },
   "batchId": {
    "minimum": 1,
    "type": "integer"
   },
   "browserBindingHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "browserSurface": {
    "enum": [
     "codex_in_app",
     "chrome_extension",
     "claude_in_chrome"
    ],
    "type": "string"
   },
   "completeInventory": {
    "type": "boolean"
   },
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "evidenceType": {
    "enum": [
     "surface_inventory_reconciled",
     "surface_missing",
     "surface_close_attempted",
     "surface_close_receipt",
     "surface_post_close_absent",
     "surface_close_failed"
    ],
    "type": "string"
   },
   "expectedInspectionEpoch": {
    "minimum": 1,
    "type": "integer"
   },
   "expectedMemberVersion": {
    "minimum": 1,
    "type": "integer"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 16,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "leaseToken": {
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "memberId": {
    "minimum": 1,
    "type": "integer"
   },
   "ownershipState": {
    "enum": [
     "controller_owned",
     "user_owned",
     "controller_user_union",
     "unresolved"
    ],
    "type": "string"
   },
   "runId": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "batchId",
   "memberId",
   "runId",
   "expectedMemberVersion",
   "expectedInspectionEpoch",
   "leaseToken",
   "browserBindingHash",
   "browserSurface",
   "adapterCode",
   "ownershipState",
   "completeInventory",
   "evidenceType",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "trackly_record_apply_surface_evidence"
}

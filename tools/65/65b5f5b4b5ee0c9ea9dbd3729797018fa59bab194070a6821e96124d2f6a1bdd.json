{
 "description": "Add a new event to a map at (x, y). If no pages are given, a single empty page (action-button trigger, no commands) is created. Returns the new event id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "mapId": {
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "note": {
    "default": "",
    "type": "string"
   },
   "pages": {
    "description": "Optional event pages; defaults to one empty page",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "x": {
    "minimum": 0,
    "type": "integer"
   },
   "y": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "mapId",
   "name",
   "x",
   "y"
  ],
  "type": "object"
 },
 "name": "create_event",
 "title": "Create map event"
}

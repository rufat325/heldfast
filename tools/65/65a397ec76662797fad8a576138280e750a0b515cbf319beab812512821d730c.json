     "set",
     "get",
     "keys",
     "get_field",
     "del_field",
     "delete",
     "setnx",
     "cas"
    ],
    "type": "string"
   },
   "deleteField": {
    "description": "CAS: delete the field instead of setting (cas)",
    "type": "boolean"
   },
   "expected": {
    "description": "Expected current value (cas \u2014 omit to require absent)"
   },
   "field": {

    "type": "string"
   },
   "fields": {
    "description": "Fields to set (set)",
    "type": "object"
   },
   "name": {
    "description": "Hash name",
    "type": "string"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   },
   "value": {
    "description": "Value (setnx/cas)"
   }
  },
  "required": [
   "spaceId",
   "name",
   "action"
  ],
  "type": "object"
 },
 "name": "kv_hash",

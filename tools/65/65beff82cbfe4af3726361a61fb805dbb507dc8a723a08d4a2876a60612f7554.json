{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Start Video Stream"
 },
 "description": "Start an HTTP MJPEG video stream of the device screen and open a viewer window (ffplay). Starts a scrcpy session automatically if needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "port": {
    "default": 7183,
    "description": "HTTP port for the MJPEG stream (default 7183)",
    "maximum": 65535,
    "minimum": 1024,
    "type": "integer"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "start_video_stream",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "screenSize": {
    "additionalProperties": false,
    "description": "Native display resolution \u2014 tap/swipe use these native coordinates (no scaling)",
    "properties": {
     "height": {
      "description": "Native display height",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "width": {
      "description": "Native display width",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height"
    ],
    "type": "object"
   },
   "status": {
    "description": "Stream status (e.g. 'started')",
    "type": "string"
   },
   "url": {
    "description": "HTTP URL of the MJPEG stream",
    "type": "string"
   },
   "viewer": {
    "description": "Viewer status message",
    "type": "string"
   }
  },
  "required": [
   "status",
   "url",
   "screenSize",
   "viewer"
  ],
  "type": "object"
 }
}

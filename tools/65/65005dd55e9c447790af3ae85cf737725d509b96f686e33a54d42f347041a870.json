{
 "description": "Create a GitHub dispatch automation rule for a project.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "bundleType": {
    "enum": [
     "failure",
     "improvement"
    ],
    "type": "string"
   },
   "cooldownSeconds": {
    "type": "number"
   },
   "enabled": {
    "type": "boolean"
   },
   "environments": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "eventTypes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "incidentStatus": {
    "enum": [
     "new_only",
     "reopened_only",
     "new_or_reopened"
    ],
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "services": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "severityMin": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "name",
   "eventTypes",
   "environments",
   "services",
   "severityMin",
   "bundleType",
   "incidentStatus",
   "cooldownSeconds"
  ],
  "type": "object"
 },
 "name": "create_github_dispatch_rule"
}

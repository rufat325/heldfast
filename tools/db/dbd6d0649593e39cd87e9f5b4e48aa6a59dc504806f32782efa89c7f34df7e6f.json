  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "channelId": {
    "type": "string"
   },
   "config": {
    "additionalProperties": {},
    "type": "object"
   },
   "isEnabled": {
    "type": "boolean"
   },
   "schedule": {
    "additionalProperties": false,
    "properties": {
     "dayOfWeek": {
      "type": "string"
     },
     "hourOfDay": {
      "type": "number"
     },
     "timezone": {
      "type": "string"
     }
    },
    "required": [
     "dayOfWeek",
     "hourOfDay",
     "timezone"
    ],
    "type": "object"
   }
  },
  "required": [
   "bearerToken",
   "channelId"
  ],
  "type": "object"
 },
 "name": "update_weekly_report_channel"
}

{
 "description": "Resolve a company to an AnchorID using domain, name, city/state, or external identifiers. Returns status (resolved | needs_review | not_found), confidence score, the canonical AnchorID, match reasons, and any ambiguous candidates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City for geo-matching",
    "type": "string"
   },
   "domain": {
    "description": "Company domain (e.g. acme.com)",
    "type": "string"
   },
   "identifiers": {
    "additionalProperties": false,
    "description": "External system identifiers",
    "properties": {
     "hubspot_company_id": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "salesforce_account_id": {
      "type": "string"
     },
     "stripe_customer_id": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "min_confidence": {
    "description": "Minimum confidence threshold (0-1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "name": {
    "description": "Company name",
    "type": "string"
   },
   "state": {
    "description": "State for geo-matching",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "resolve_company"
}

{
 "description": "Record a reusable review-card lesson through Granoflow's controlled work-memory API. The app may fail closed until controlled review-card import/create paths are available.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client": {
    "default": "mcp",
    "minLength": 1,
    "type": "string"
   },
   "dryRun": {
    "default": true,
    "description": "When true, previews the request without writing.",
    "type": "boolean"
   },
   "problem": {
    "minLength": 1,
    "type": "string"
   },
   "solution": {
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "commit": {
      "minLength": 1,
      "type": "string"
     },
     "taskId": {
      "minLength": 1,
      "type": "string"
     },
     "threadId": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "tags": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "problem",
   "solution"
  ],
  "type": "object"
 },
 "name": "granoflow_review_card_record"
}

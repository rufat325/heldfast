  "properties": {
   "command": {
    "description": "Shell command to execute on the device",
    "type": "string"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   }
  },
  "required": [
   "command"
  ],
  "type": "object"
 },
 "name": "shell_exec",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "output": {
    "description": "Combined stdout/stderr text from the command",
    "type": "string"
   }
  },
  "required": [
   "output"
  ],
  "type": "object"
 }
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compares two or more BuyAPI vendors for a specific workload or decision.\n\nUse this for head-to-head questions like \"Convex vs Supabase vs Neon for a realtime SaaS\" or \"Stripe vs Paddle for a marketplace\".",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "query": {
    "description": "The user's decision context",
    "type": "string"
   },
   "vendorIds": {
    "description": "BuyAPI vendor IDs, e.g. ['/database/convex', '/database/neon']",
    "items": {
     "type": "string"
    },
    "minItems": 2,
    "type": "array"
   },
   "workload": {
    "description": "Explicit workload assumptions for deterministic cost estimates. Missing fields become assumptions, not fabricated precision.",
    "properties": {
     "authMau": {
      "type": "number"
     },
     "averageTransactionUsd": {
      "type": "number"
     },
     "databaseSizeGb": {
      "type": "number"
     },
     "emailSendsPerMonth": {
      "type": "number"
     },
     "monthlyActiveUsers": {
      "type": "number"
     },
     "monthlyRevenueUsd": {
      "type": "number"
     },
     "monthlyTransactions": {
      "type": "number"
     },
     "notes": {
      "type": "string"
     },
     "regions": {
      "type": "number"
     },
     "storageGb": {
      "type": "number"
     },
     "teamSeats": {
      "type": "number"
     },
     "users": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "vendorIds",
   "query"
  ],
  "type": "object"
 },
 "name": "vendors.compare",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "availableCategories": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "decisionMatrix": {
    "items": {},
    "type": "array"
   },
   "kind": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "suggestedNextSteps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}

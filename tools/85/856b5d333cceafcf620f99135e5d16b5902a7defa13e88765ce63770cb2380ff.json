{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List Installed Apps"
 },
 "description": "List installed packages on the device. Optionally filter by name or restrict to system/third-party apps.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filter": {
    "description": "Filter packages by name (partial match, case-insensitive)",
    "type": "string"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   },
   "system": {
    "description": "true = system apps only, false = third-party only, omit = all",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "app_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Number of packages returned",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "packages": {
    "description": "Installed package names",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "packages"
  ],
  "type": "object"
 }
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Transmission loss (RAM PE)"
 },
 "description": "Run a physically grounded transmission-loss simulation (RAM parabolic\n    equation) from a source at (lat, lon or `place`, depth) along a compass bearing.\n    Bathymetry, the seasonal sound-speed profile (`month`) and\n    seabed parameters are fetched for the location automatically. Returns TL\n    vs range at the receiver depths (default: source depth, 10 m, 100 m,\n    mid-water), grid statistics, and the full replication bundle. Show\n    `open_url` to the user as a clickable link.",
 "inputSchema": {
  "properties": {
   "bearing_deg": {
    "title": "Bearing Deg",
    "type": "number"
   },
   "frequency_hz": {
    "title": "Frequency Hz",
    "type": "number"
   },
   "lat": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lat"
   },
   "lon": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lon"
   },
   "month": {
    "default": 6,
    "title": "Month",
    "type": "integer"
   },
   "place": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Place"
   },
   "range_km": {
    "default": 20.0,
    "title": "Range Km",
    "type": "number"
   },
   "receiver_depths_m": {
    "anyOf": [
     {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Receiver Depths M"
   },
   "source_depth_m": {
    "title": "Source Depth M",
    "type": "number"
   }
  },
  "required": [
   "source_depth_m",
   "frequency_hz",
   "bearing_deg"
  ],
  "title": "run_transmission_lossArguments",
  "type": "object"
 },
 "name": "run_transmission_loss",

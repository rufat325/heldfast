{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a character's profile by AniList character ID: name, image, description, and the anime/manga they appear in (`media`, up to 25 by popularity, with their `characterRole` \u2014 MAIN/SUPPORTING/BACKGROUND \u2014 in each). Use search_character first to resolve a name to its ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "AniList character ID.",
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_character",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "character": {
    "additionalProperties": {},
    "properties": {
     "description": {
      "type": [
       "string",
       "null"
      ]
     },
     "favourites": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "exclusiveMinimum": 0,
      "maximum": 2147483647,
      "type": "integer"
     },
     "image": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "large": {
          "anyOf": [
           {
            "format": "uri",
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "isFavourite": {
      "description": "[Requires login] Whether this character is in the caller's favourites. Has a brief read-after-write lag on AniList's own backend \u2014 confirmed live, a re-check right after toggle_favourite can briefly still show the pre-toggle value.",
      "type": [
       "boolean",
       "null"
      ]
     },
     "media": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "edges": {
          "items": {
           "additionalProperties": {},
           "properties": {
            "characterRole": {
             "type": [
              "string",
              "null"
             ]
            },
            "node": {
             "anyOf": [
              {
               "additionalProperties": {},
               "properties": {
                "format": {
                 "type": [
                  "string",
                  "null"
                 ]
                },
                "id": {
                 "exclusiveMinimum": 0,
                 "maximum": 2147483647,
                 "type": "integer"
                },
                "title": {
                 "anyOf": [
                  {
                   "additionalProperties": false,
                   "properties": {
                    "english": {
                     "type": [
                      "string",
                      "null"
                     ]
                    },
                    "romaji": {
                     "type": [
                      "string",
                      "null"
                     ]
                    }
                   },
                   "type": "object"
                  },
                  {
                   "type": "null"
                  }
                 ]
                },
                "type": {
                 "type": [
                  "string",
                  "null"
                 ]
                }
               },
               "required": [
                "id"
               ],
               "type": "object"
              },
              {
               "type": "null"
              }
             ]
            }
           },
           "type": "object"
          },
          "type": "array"
         }
        },
        "required": [
         "edges"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "full": {
          "type": [
           "string",
           "null"
          ]
         },
         "native": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "siteUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "character"
  ],
  "type": "object"
 },
 "title": "Get character details"
}

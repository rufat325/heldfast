{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find Tibia game updates by text and release date, for questions like \"what changed for knights in 2026\" or \"which update added X\". Matches the text, case-insensitive for ASCII letters, in an update's title, name, summary and change list, newest first, and returns the matching change lines. For the full changes, call tibia_get with type \"update\" and the returned title.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "released_after": {
    "description": "YYYY-MM-DD, inclusive.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "released_before": {
    "description": "YYYY-MM-DD, inclusive.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "text": {
    "description": "Literal substring, e.g. \"knight\".",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tibia_find_updates",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "indexGeneratedAt": {
    "type": "string"
   },
   "nextCursor": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "matchingLines": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "releaseDate": {
       "type": [
        "string",
        "null"
       ]
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "updateType": {
       "type": [
        "string",
        "null"
       ]
      },
      "version": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "title",
      "name",
      "releaseDate",
      "version",
      "updateType",
      "summary",
      "matchingLines"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalMatches": {
    "type": "number"
   }
  },
  "required": [
   "results",
   "totalMatches",
   "indexGeneratedAt"
  ],
  "type": "object"
 }
}

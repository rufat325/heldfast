{
 "annotations": {
  "openWorldHint": true,
  "title": "Scrape page"
 },
 "description": "Scrape a single page from the Wayback Machine archive. Costs 1 credit. Async \u2014 returns a job_id. Pages with status='haloscan' have no Wayback snapshot and cannot be scraped (use rewrite_page with wisewand=true instead).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content_type": {
    "description": "Content extraction type (default: article)",
    "enum": [
     "article",
     "product",
     "productList",
     "jina"
    ],
    "type": "string"
   },
   "page_id": {
    "description": "Page UUID to scrape",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "page_id"
  ],
  "type": "object"
 },
 "name": "scrape_page"
}

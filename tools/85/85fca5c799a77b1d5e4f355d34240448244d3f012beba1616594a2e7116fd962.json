{
 "description": "Per-sensor min/mean/max and anomaly flag counts over the SensorMesh data, optionally scoped by filters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "anomaly": {
    "description": "Anomaly flag filter, e.g. spike, stuck, flatline, passby; empty string = normal rows",
    "type": "string"
   },
   "device": {
    "description": "Device ID, e.g. sm-004",
    "type": "string"
   },
   "sensor": {
    "description": "Sensor type",
    "enum": [
     "air_quality",
     "temperature",
     "noise"
    ],
    "type": "string"
   },
   "since": {
    "description": "ISO timestamp lower bound",
    "type": "string"
   },
   "site": {
    "description": "Site slug",
    "enum": [
     "metro-core",
     "riverside-park",
     "north-industrial"
    ],
    "type": "string"
   },
   "until": {
    "description": "ISO timestamp upper bound",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "sensor_stats"
}

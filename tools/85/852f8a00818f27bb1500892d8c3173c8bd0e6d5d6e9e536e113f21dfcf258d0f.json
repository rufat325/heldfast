{
 "description": "Write UserDefaults values inside the simulator. Set feature flags, change app configuration, or inject test data.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "domain": {
    "description": "Defaults domain (bundle ID)",
    "type": "string"
   },
   "key": {
    "description": "Key to write",
    "type": "string"
   },
   "type": {
    "description": "Value type (default: string)",
    "enum": [
     "string",
     "int",
     "float",
     "bool"
    ],
    "type": "string"
   },
   "value": {
    "description": "Value to set",
    "type": "string"
   }
  },
  "required": [
   "domain",
   "key",
   "value"
  ],
  "type": "object"
 },
 "name": "simulator_defaults_write"
}

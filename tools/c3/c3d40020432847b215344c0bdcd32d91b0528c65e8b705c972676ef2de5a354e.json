{
 "description": "Split a local PDF by page ranges, specific pages, or into every page. Outputs are written to a directory.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input": {
    "description": "Path to the input PDF",
    "type": "string"
   },
   "mode": {
    "enum": [
     "ranges",
     "pages",
     "every"
    ],
    "type": "string"
   },
   "outputDir": {
    "description": "Directory to write the parts into",
    "type": "string"
   },
   "pages": {
    "description": "1-based page numbers for mode \"pages\"",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "ranges": {
    "description": "Inclusive 1-based ranges for mode \"ranges\"",
    "items": {
     "items": [
      {
       "type": "integer"
      },
      {
       "type": "integer"
      }
     ],
     "maxItems": 2,
     "minItems": 2,
     "type": "array"
    },
    "type": "array"
   }
  },
  "required": [
   "input",
   "outputDir",
   "mode"
  ],
  "type": "object"
 },
 "name": "pdf_split",
 "title": "Split a PDF (local, private)"
}

 "name": "invoice_anomaly_check",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "anomalies": {
    "description": "Most severe first. At most one record per anomaly code; sub-findings are in evidence.issues.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "description": "Stable machine code of the anomaly type.",
       "enum": [
        "SUBTOTAL_MISMATCH",
        "TAX_MISMATCH",
        "TOTAL_MISMATCH",
        "LINE_TOTAL_MISMATCH",
        "DUPLICATE_INVOICE",
        "POSSIBLE_DUPLICATE",
        "UNUSUAL_AMOUNT",
        "SUPPLIER_PATTERN_DEVIATION",
        "UNUSUAL_CURRENCY",
        "UNUSUAL_PAYMENT_TERMS",
        "INVOICE_NUMBER_ANOMALY",
        "BANK_ACCOUNT_CHANGED",
        "UNKNOWN_BANK_ACCOUNT",
        "PO_MISMATCH",
        "PO_AMOUNT_EXCEEDED",
        "CONTRACT_LIMIT_EXCEEDED",
        "APPROVAL_THRESHOLD_EXCEEDED",
        "SPLIT_INVOICE_PATTERN",
        "DATE_ANOMALY",
        "DUE_DATE_ANOMALY",
        "DUPLICATE_LINE_ITEM",
        "MISSING_REQUIRED_FIELD"
       ],
       "type": "string"
      },
      "confidence": {
       "description": "0\u20131 strength of the supporting evidence (not a probability of fraud).",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "evidence": {
       "additionalProperties": {},
       "description": "Structured, factual evidence for the finding (matched records, expected vs stated values, baselines, thresholds). Bank accounts appear only masked (****1234).",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "explanation": {
       "description": "One factual sentence, phrased as a risk indicator (never an accusation).",
       "type": "string"
      },
      "field": {
       "description": "Primary invoice field concerned (e.g. invoiceNumber, bankAccount, total), or null.",
       "type": [
        "string",
        "null"
       ]
      },
      "severity": {
       "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
       ],
       "type": "string"
      }
     },
     "required": [
      "code",
      "severity",
      "confidence",
      "field",
      "explanation",
      "evidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "anomalyCount": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "asOfDate": {
    "description": "Reference date (UTC) used for date checks.",
    "type": "string"
   },
   "checkedAt": {
    "description": "ISO timestamp of the as-of date (UTC start of day). Deliberately day-granular so identical inputs give identical output; pass options.asOfDate for full reproducibility.",
    "type": "string"
   },
   "contextUsed": {
    "additionalProperties": false,
    "properties": {
     "approvalContext": {
      "type": "boolean"
     },
     "contract": {
      "type": "boolean"
     },
     "historicalInvoices": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "paymentHistory": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "purchaseOrder": {
      "type": "boolean"
     },
     "supplierHistoryMatched": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "supplierProfile": {
      "type": "boolean"
     }
    },
    "required": [
     "historicalInvoices",
     "supplierHistoryMatched",
     "paymentHistory",
     "supplierProfile",
     "purchaseOrder",
     "contract",
     "approvalContext"
    ],
    "type": "object"
   },
   "dataCompleteness": {
    "additionalProperties": false,
    "properties": {
     "missingRecommendedFields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "missingRequiredFields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "missingRequiredFields",

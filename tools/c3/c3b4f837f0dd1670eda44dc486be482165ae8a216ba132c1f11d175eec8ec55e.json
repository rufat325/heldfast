{
 "_meta": {
  "openai/outputTemplate": "ui://audiala/card-v1.html",
  "openai/toolInvocation/invoked": "Trip handoff ready",
  "openai/toolInvocation/invoking": "Gathering must-see places\u2026",
  "ui": {
   "resourceUri": "ui://audiala/card-v1.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan a trip in Audiala"
 },
 "description": "Hand a trip-planning request to the Audiala app. Shows the city's must-see places (each with an audio guide) and a button to build the personalized N-day itinerary in Audiala. This tool does NOT return an itinerary \u2014 Audiala's planner builds it in the app with the user's pace and interests. Call this when a user asks to plan a trip to a city.",
 "inputSchema": {
  "properties": {
   "city": {
    "type": "string"
   },
   "days": {
    "maximum": 14,
    "minimum": 1,
    "type": "integer"
   },
   "interests": {
    "items": {
     "enum": [
      "architecture",
      "food",
      "history",
      "art",
      "nature",
      "family",
      "nightlife"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "lang": {
    "enum": [
     "en",
     "fr",
     "de",
     "es",
     "it",
     "pt",
     "ru",
     "ja",
     "zh",
     "cs",
     "ar",
     "hi"
    ],
    "type": "string"
   }
  },
  "required": [
   "city",
   "days"
  ],
  "type": "object"
 },
 "name": "audiala_plan_trip",
 "outputSchema": {
  "properties": {
   "city": {
    "description": "The resolved city.",
    "properties": {
     "app_url": {
      "description": "Opens the city in the signed-in Audiala web app.",
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "guides_count": {
      "description": "Number of audio guides in the city.",
      "type": [
       "integer",
       "null"
      ]
     },
     "image": {
      "description": "Hero image URL.",
      "type": [
       "string",
       "null"
      ]
     },
     "image_fallbacks": {
      "description": "Images to try if `image` fails.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "summary": {
      "description": "Short editorial summary.",
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "description": "Public audiala.com city page.",
      "type": "string"
     }
    },
    "required": [
     "name",
     "country",
     "url"
    ],
    "type": "object"
   },
   "days": {
    "type": "integer"
   },
   "interests": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "kind": {
    "enum": [
     "plan",
     "not_found"
    ],
    "type": "string"
   },
   "lang": {
    "type": "string"
   },
   "links": {
    "description": "UTM-tagged links into Audiala.",
    "properties": {
     "app_url": {
      "description": "Signed-in Audiala web app.",
      "type": "string"
     },
     "download": {
      "description": "App download page.",
      "type": "string"
     },
     "listen_in_app": {
      "description": "Deep link to the full guide in the Audiala app.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "message": {
    "description": "Why nothing matched and what to try instead.",
    "type": "string"
   },
   "open_in_app": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "recommendation": {
    "type": "string"
   },
   "top_places": {
    "description": "Must-see places; not an itinerary.",
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "url": {
       "description": "Public audiala.com page for the place.",
       "type": "string"
      }
     },
     "required": [
      "name",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "kind"
  ],
  "type": "object"
 },
 "title": "Plan a trip in Audiala"
}

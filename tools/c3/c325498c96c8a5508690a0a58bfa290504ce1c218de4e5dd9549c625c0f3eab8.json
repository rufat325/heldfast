{
 "description": "List pending cache proposals for the active instance, newest first. Optionally filter by cache_name.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cache_name": {
    "description": "Restrict to a single cache",
    "minLength": 1,
    "type": "string"
   },
   "instanceId": {
    "description": "Connection ID; defaults to the active instance",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "description": "Max proposals to return (default 100, max 200)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "cache_list_pending_proposals"
}

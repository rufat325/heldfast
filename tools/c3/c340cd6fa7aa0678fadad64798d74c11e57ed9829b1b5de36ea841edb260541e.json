 "description": "Preview or post a complete CSV or XLSX file of balanced manual adjustment journals for one portfolio. Preview first; post only after reviewing every blocking issue, then resend the unchanged source with its preview token and any resolutions.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "preview: Parse the file and report what it would import, writing nothing. Always preview before posting. post: Commit the import that a preview of the same file produced.",
    "enum": [
     "preview",
     "post"
    ],
    "type": "string"
   },
   "contentBase64": {
    "description": "CSV or XLSX source file content as base64-encoded bytes (max 5 MiB).",
    "minLength": 1,
    "type": "string"
   },
   "fileName": {
    "description": "Original CSV or XLSX source filename.",
    "maxLength": 255,
    "minLength": 1,
    "pattern": "^[^/\\\\]+\\.(?:csv|xlsx)$",
    "type": "string"
   },
   "portfolioRef": {
    "description": "Portfolio name or slug inside that workspace. Call list_portfolios to resolve it.",
    "minLength": 1,
    "type": "string"
   },
   "previewToken": {
    "description": "Token returned by the matching preview, proving the file has not changed since. Only for action post; required for each.",
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "resolutions": {
    "description": "Only for action post; required for each.",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "accountNumber": {
         "description": "Ledger account to use for that row, from list_journal_line_assignment_options (type: ledger_account).",
         "minLength": 1,
         "type": "string"
        },
        "kind": {
         "description": "Kind of reference this row fixes.",
         "enum": [
          "account"
         ],
         "type": "string"
        },
        "locator": {
         "oneOf": [
          {
           "additionalProperties": false,
           "properties": {
            "format": {
             "description": "Source file format.",
             "enum": [
              "csv"
             ],
             "type": "string"
            },
            "lineNumber": {
             "description": "1-based line number in the CSV file.",
             "maximum": 9007199254740991,
             "minimum": 1,
             "type": "integer"
            }
           },
           "required": [
            "format",
            "lineNumber"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "format": {
             "description": "Source file format.",
             "enum": [
              "xlsx"
             ],
             "type": "string"
            },
            "rowNumber": {
             "description": "1-based row number within the sheet.",
             "maximum": 9007199254740991,
             "minimum": 1,
             "type": "integer"
            },
            "sheetName": {
             "description": "Worksheet the row belongs to.",
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "format",
            "rowNumber",
            "sheetName"
           ],
           "type": "object"
          }
         ]
        }
       },
       "required": [
        "accountNumber",
        "kind",
        "locator"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "externalId": {
         "description": "Counterparty's external identifier, as recorded on the counterparty.",
         "minLength": 1,
         "type": "string"
        },
        "kind": {
         "description": "Kind of reference this row fixes.",
         "enum": [
          "counterparty"
         ],
         "type": "string"
        },
        "locator": {
         "oneOf": [
          {
           "additionalProperties": false,
           "properties": {

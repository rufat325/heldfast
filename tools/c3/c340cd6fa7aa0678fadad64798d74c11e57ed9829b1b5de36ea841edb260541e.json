            "sheetName"
           ],
           "type": "object"
          }
         ]
        },
        "name": {
         "description": "Counterparty name to use for that row, from list_journal_line_assignment_options (type: counterparty).",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "kind",
        "locator",
        "name"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "centerName": {
         "description": "Responsibility center to use for that row, from list_journal_line_assignment_options (type: responsibility_center).",
         "minLength": 1,
         "type": "string"
        },
        "kind": {
         "description": "Kind of reference this row fixes.",
         "enum": [
          "responsibilityCenter"
         ],
         "type": "string"
        },
        "locator": {
         "oneOf": [
          {
           "additionalProperties": false,
           "properties": {
            "format": {
             "description": "Source file format.",
             "enum": [
              "csv"
             ],
             "type": "string"
            },
            "lineNumber": {
             "description": "1-based line number in the CSV file.",
             "maximum": 9007199254740991,
             "minimum": 1,
             "type": "integer"
            }
           },
           "required": [
            "format",
            "lineNumber"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "format": {
             "description": "Source file format.",

{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List anime/manga AniList users recommend as similar to a given title, ranked by rating (highest first). Use search_media first to resolve the title to its AniList ID. Each result's `mediaRecommendation.mediaListEntry` (requires login) shows whether it's already on your own list \u2014 set `excludeInList: true` to filter those out server-side instead of checking each one yourself.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "excludeInList": {
    "default": false,
    "description": "[Requires login] Omit recommendations already on your own list. Filtered after fetching this page, so a page can come back with fewer than `perPage` results \u2014 not an error, just fewer new ones on that page. No-ops (nothing filtered) if not logged in, since there's no list to check against.",
    "type": "boolean"
   },
   "mediaId": {
    "description": "AniList ID of the anime/manga to get recommendations for.",
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number for pagination. AniList's paginated connections (search results, a title's characters/staff/reviews, activity feeds, forum comments) reject a page whose page \u00d7 perPage exceeds ~5000 entries with an upstream error, so paging that deep fails rather than returning more results.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "perPage": {
    "default": 10,
    "description": "Results per page (max 50, AniList's own ceiling \u2014 it silently clamps anything higher).",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   }
  },
  "required": [
   "mediaId"
  ],
  "type": "object"
 },
 "name": "get_recommendations_for_media",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "recommendations": {
    "additionalProperties": {},
    "properties": {
     "nodes": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": {},
         "properties": {
          "id": {
           "exclusiveMinimum": 0,
           "maximum": 2147483647,
           "type": "integer"
          },
          "mediaRecommendation": {
           "anyOf": [
            {
             "additionalProperties": {},
             "properties": {
              "id": {
               "exclusiveMinimum": 0,
               "maximum": 2147483647,
               "type": "integer"
              },
              "mediaListEntry": {
               "anyOf": [
                {
                 "additionalProperties": {},
                 "properties": {
                  "id": {
                   "exclusiveMinimum": 0,
                   "maximum": 2147483647,
                   "type": "integer"
                  },
                  "status": {
                   "type": [
                    "string",
                    "null"
                   ]
                  }
                 },
                 "required": [
                  "id"
                 ],
                 "type": "object"
                },
                {
                 "type": "null"
                }
               ],
               "description": "Whether this recommended title is on the caller's own list \u2014 viewer-relative, so it only resolves when logged in; null both when logged out and when the title just isn't on the list (the two cases aren't distinguishable from this field alone)."
              },
              "siteUrl": {
               "anyOf": [
                {
                 "format": "uri",
                 "type": "string"
                },
                {
                 "type": "null"
                }
               ]
              },
              "title": {
               "anyOf": [
                {
                 "additionalProperties": false,
                 "properties": {
                  "english": {
                   "type": [
                    "string",
                    "null"
                   ]
                  },
                  "romaji": {
                   "type": [
                    "string",
                    "null"
                   ]
                  }
                 },
                 "type": "object"
                },
                {
                 "type": "null"
                }
               ]
              }
             },
             "required": [
              "id"
             ],
             "type": "object"
            },
            {
             "type": "null"
            }
           ]
          },
          "rating": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": -9007199254740991,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ],
           "description": "Net rating (RATE_UP minus RATE_DOWN votes across all users), not the caller's own."
          },
          "userRating": {
           "anyOf": [
            {
             "enum": [
              "NO_RATING",
              "RATE_UP",
              "RATE_DOWN"
             ],
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "id"
         ],
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "pageInfo": {
      "additionalProperties": {},
      "description": "Whether another page exists \u2014 use this to decide whether to paginate.",
      "properties": {
       "hasNextPage": {
        "type": [
         "boolean",
         "null"
        ]
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "recommendations"
  ],
  "type": "object"
 },
 "title": "Get recommendations for a title"
}

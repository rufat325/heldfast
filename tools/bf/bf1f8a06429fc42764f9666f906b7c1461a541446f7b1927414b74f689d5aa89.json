{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Runs go generate directives in Go source files. WARNING: may execute untrusted code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "commands": {
    "default": false,
    "description": "Print commands as they are executed (-x)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "dryRun": {
    "default": false,
    "description": "Print the commands that would be executed but do not run them (-n). Essential for safe previewing.",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "./..."
    ],
    "description": "Packages to generate (default: ./...)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "run": {
    "description": "Run only generators whose directive matches this regexp (-run <regexp>). Reduces execution scope and risk.",
    "maxLength": 255,
    "type": "string"
   },
   "skip": {
    "description": "Skip generators whose directive matches this regexp (-skip <regexp>). Useful to exclude known-slow or broken generators.",
    "maxLength": 255,
    "type": "string"
   },
   "tags": {
    "description": "Build tags for conditional compilation (-tags)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "timeout": {
    "description": "Execution timeout in milliseconds for go generate",
    "maximum": 600000,
    "minimum": 1000,
    "type": "integer"
   },
   "verbose": {
    "default": false,
    "description": "Print the names of packages and files as they are processed (-v)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "generate",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "directiveCount": {
    "type": "number"
   },
   "directives": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "command": {
       "type": "string"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "status": {
       "enum": [
        "running",
        "completed",
        "failed"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "command"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "output": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   },
   "timedOut": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Go Generate"
}

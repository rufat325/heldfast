{
 "description": "Rerank a list of passages by relevance to a query using NVIDIA NIM reranking models. Essential for RAG pipelines to improve retrieval quality.",
 "inputSchema": {
  "properties": {
   "model": {
    "description": "Reranking model ID",
    "type": "string"
   },
   "passages": {
    "items": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "properties": {
        "text": {
         "type": "string"
        }
       },
       "required": [
        "text"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   },
   "top_k": {
    "description": "Return top K results",
    "minimum": 1,
    "type": "integer"
   },
   "truncate": {
    "enum": [
     "NONE",
     "END"
    ],
    "type": "string"
   }
  },
  "required": [
   "query",
   "passages"
  ],
  "type": "object"
 },
 "name": "rerank_passages"
}

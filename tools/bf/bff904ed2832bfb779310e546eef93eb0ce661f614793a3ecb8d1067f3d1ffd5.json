{
 "description": "Configure email provider. For Gmail/Outlook: provide clientId + clientSecret + refreshToken (from OAuth2 flow). For IMAP: provide host + user + password.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clientId": {
    "description": "OAuth2 Client ID (Gmail/Outlook)",
    "type": "string"
   },
   "clientSecret": {
    "description": "OAuth2 Client Secret (Gmail/Outlook)",
    "type": "string"
   },
   "email": {
    "description": "Email address",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "imapHost": {
    "description": "IMAP host (for generic IMAP)",
    "type": "string"
   },
   "imapPass": {
    "description": "IMAP password",
    "type": "string"
   },
   "imapPort": {
    "description": "IMAP port (default 993)",
    "type": "number"
   },
   "imapUser": {
    "description": "IMAP username",
    "type": "string"
   },
   "provider": {
    "description": "Email provider",
    "enum": [
     "gmail",
     "outlook",
     "imap"
    ],
    "type": "string"
   },
   "refreshToken": {
    "description": "OAuth2 Refresh Token (Gmail/Outlook)",
    "type": "string"
   },
   "smtpHost": {
    "description": "SMTP host",
    "type": "string"
   },
   "smtpPass": {
    "description": "SMTP password",
    "type": "string"
   },
   "smtpPort": {
    "description": "SMTP port (default 587)",
    "type": "number"
   },
   "smtpUser": {
    "description": "SMTP username",
    "type": "string"
   }
  },
  "required": [
   "provider",
   "email"
  ],
  "type": "object"
 },
 "name": "email_setup"
}

{
 "description": "Restore session data from a cleanup backup. Requires confirm='RESTORE' as a safety guard.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backup_id": {
    "description": "Backup ID to restore (from drishti_backups)",
    "type": "string"
   },
   "confirm": {
    "description": "Must be exactly 'RESTORE' to proceed",
    "type": "string"
   }
  },
  "required": [
   "backup_id",
   "confirm"
  ],
  "type": "object"
 },
 "name": "drishti_restore"
}

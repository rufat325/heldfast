{
 "description": "Combine the four sub-scores into a final ranking. popularity_score and maintenance_score come from repo_search/repo_enrich; relevance_score and completeness_score are your 0-1 judgments. Weights default to relevance 0.4, popularity 0.2, maintenance 0.2, completeness 0.2 and are normalized. Optional hard_filters drop candidates before ranking.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "candidates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "completeness_score": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "full_name": {
       "type": "string"
      },
      "has_license": {
       "type": "boolean"
      },
      "language": {
       "type": [
        "string",
        "null"
       ]
      },
      "maintenance_score": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "note": {
       "type": "string"
      },
      "popularity_score": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "pushed_at": {
       "type": "string"
      },
      "relevance_score": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "stars": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "full_name",
      "popularity_score",
      "maintenance_score",
      "relevance_score",
      "completeness_score"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "hard_filters": {
    "additionalProperties": false,
    "properties": {
     "language": {
      "type": "string"
     },
     "max_days_since_push": {
      "minimum": 0,
      "type": "integer"
     },
     "min_stars": {
      "minimum": 0,
      "type": "integer"
     },
     "require_license": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "weights": {
    "additionalProperties": false,
    "properties": {
     "completeness": {
      "minimum": 0,
      "type": "number"
     },
     "maintenance": {
      "minimum": 0,
      "type": "number"
     },
     "popularity": {
      "minimum": 0,
      "type": "number"
     },
     "relevance": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "candidates"
  ],
  "type": "object"
 },
 "name": "repo_rank",
 "title": "Rank repos by weighted score"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Submit a quote on an open quote request. The provider sets the estimated price, optional duration and availability, and a short message to the requester. The quote is not a financial commitment \u2014 the requester still has to accept (which itself goes through a deep-link confirmation on tewdy.com). Requires authentication.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "availability_date": {
    "maxLength": 40,
    "type": "string"
   },
   "business_id": {
    "maxLength": 120,
    "type": "string"
   },
   "currency": {
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "estimated_duration": {
    "maxLength": 120,
    "type": "string"
   },
   "estimated_price": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "message": {
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "provider_type": {
    "enum": [
     "individual",
     "business"
    ],
    "type": "string"
   },
   "quote_request_id": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "terms_conditions": {
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "quote_request_id",
   "provider_type",
   "estimated_price",
   "currency",
   "message"
  ],
  "type": "object"
 },
 "name": "submit_quote",
 "title": "Submit a quote on a request"
}

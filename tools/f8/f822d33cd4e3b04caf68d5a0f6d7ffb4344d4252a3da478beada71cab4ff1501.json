 "description": "Look up ONE aircraft by ICAO24 transponder hex (e.g. \"a4d97e\"). Returns registry details \u2014 registration/tail number, manufacturer, type, and registered owner/operator \u2014 plus its LIVE position if it is currently transmitting. No key required. Use for \"what is aircraft <hex>\", \"who operates <hex>\", \"where is <hex> now\". If you only have a flight number/callsign, use get_flight_route instead.",
 "inputSchema": {
  "examples": [
   {
    "icao24": "a0b1c2"
   },
   {
    "icao24": "4b1d0f"
   }
  ],
  "properties": {
   "icao24": {
    "description": "ICAO24 transponder address \u2014 6 hex characters, e.g. \"a4d97e\" (case-insensitive)",
    "type": "string"
   }
  },
  "required": [
   "icao24"
  ],
  "type": "object"
 },

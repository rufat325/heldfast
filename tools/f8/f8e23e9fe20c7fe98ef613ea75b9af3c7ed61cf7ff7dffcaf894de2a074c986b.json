{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Simulate the queue customer by customer (discrete events, fixed seed, so the result is reproducible). Its job is to CROSS-CHECK the analytic answer: if the simulation and the formula disagree, one of them is wrong.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "arrivalsPerHour": {
    "description": "Arrivals per hour (lambda), e.g. 12 groups/hour.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "avgServiceMinutes": {
    "description": "Mean time one resource stays occupied, in minutes, e.g. 75.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "customers": {
    "default": 50000,
    "maximum": 500000,
    "minimum": 100,
    "type": "integer"
   },
   "seed": {
    "default": 1,
    "minimum": 0,
    "type": "integer"
   },
   "servers": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "waitingRoom": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "arrivalsPerHour",
   "avgServiceMinutes",
   "servers"
  ],
  "type": "object"
 },
 "name": "queue_simulate"
}

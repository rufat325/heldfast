   "icebreak": {
    "description": "\u7834\u51b0\u4ecb\u7ecd\uff1afalse = \u4ece\u6b64\u4e0d\u88ab\u5b98\u65b9\u62c9\u8fdb\u7834\u51b0\u4ecb\u7ecd\u4e09\u4eba\u7fa4\uff08\u9009\u5019\u9009\u9636\u6bb5\u5c31\u6392\u9664\uff0c\u8fde\u7fa4\u90fd\u4e0d\u5efa\uff09",
    "type": "boolean"
   },
   "icebreakPace": {

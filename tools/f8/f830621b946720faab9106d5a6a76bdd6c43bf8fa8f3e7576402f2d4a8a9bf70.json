     "less",
     "normal",
     "more"
    ],
    "type": "string"
   },
   "icebreakRole": {
    "description": "\u53ea\u4f5c\u9700\u6c42\u65b9 seeker_only / \u53ea\u4f5c\u63d0\u4f9b\u65b9 helper_only / \u90fd\u884c both",
    "enum": [

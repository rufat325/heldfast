     }
    ],
    "description": "\u7834\u51b0\u5148\u505c\u4e00\u9635\uff1aISO 8601 \u542b\u65f6\u533a\uff1b\u4f20 null = \u53d6\u6d88\u505c\u4e00\u9635\uff08\u670d\u52a1\u5c42\u4e0d\u6821\u9a8c\u683c\u5f0f\uff0c\u683c\u5f0f\u95f8\u53ea\u6709\u8fd9\u4e00\u5c42\uff09"
   },
   "matches": {
    "description": "\u64ae\u5408\u63a8\u9001\uff1a\u65b0\u9700\u6c42\u4e0e\u6211\u4ef7\u503c\u5339\u914d\u65f6",
    "type": "boolean"
   },
   "nudge": {
    "description": "\u672a\u8bfb\u79c1\u4fe1\u7684\u90ae\u4ef6/\u77ed\u4fe1\u89e6\u8fbe\u63d0\u9192\uff08\u90ae\u4ef6\u4e00\u952e\u9000\u8ba2\u843d\u8fd9\u91cc\uff1b\u7528\u6237\u6ca1\u63d0\u5c31\u522b\u52a8\u5b83\uff09",
    "type": "boolean"
   },
   "recall": {
    "description": "\u53ec\u56de\u63d0\u9192\uff1a\u6709\u4eba\u5728\u5173\u6ce8\u4f60 / \u6709\u5339\u914d\u7684\u9700\u6c42\u627e\u4f60\uff08\u72ec\u7acb\u4e8e matches\uff09",
    "type": "boolean"
   }
  },
  "type": "object"

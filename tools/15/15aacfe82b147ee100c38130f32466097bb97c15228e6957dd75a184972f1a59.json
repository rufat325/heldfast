{
 "description": "Fetch GeoJSON features from a KMI/IRM WFS layer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bbox": {
    "description": "Optional bounding box as minX,minY,maxX,maxY",
    "type": "string"
   },
   "count": {
    "default": 10,
    "description": "Maximum number of features to return",
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "cqlFilter": {
    "description": "Optional GeoServer CQL filter",
    "type": "string"
   },
   "typeName": {
    "description": "Exact WFS feature type name, e.g. aws:aws_1hour",
    "type": "string"
   }
  },
  "required": [
   "typeName"
  ],
  "type": "object"
 },
 "name": "kmi_get_features"
}

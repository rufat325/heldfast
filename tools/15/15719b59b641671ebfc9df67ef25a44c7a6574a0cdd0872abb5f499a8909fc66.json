{
 "description": "Update the name or ordered steps of a saved AnalyticsBundle funnel.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "displayName": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "funnelKey": {
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "steps": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "display_name": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "step_key": {
       "maxLength": 120,
       "minLength": 1,
       "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
       "type": "string"
      }
     },
     "required": [
      "step_key",
      "display_name"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "funnelKey"
  ],
  "type": "object"
 },
 "name": "update_saved_analytics_funnel"
}

{
 "description": "Get staking positions with claimable rewards. Returns positions for the treasury wallet by default, or for a specific owner if provided. Shows claimable and historically claimed quote/telecoin rewards for each position. Use printr_claim_staking_rewards to claim rewards (or withdraw unlocked principal) from a position.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Pagination cursor from previous response.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of positions to return (default: 50).",
    "type": "number"
   },
   "owner": {
    "description": "CAIP-10 owner address to filter positions by. If omitted, uses treasury wallet addresses.",
    "type": "string"
   },
   "token_id": {
    "description": "Telecoin ID (hex) to filter positions by. Optional.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "printr_get_staking_positions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Status message",
    "type": "string"
   },
   "next_cursor": {
    "description": "Cursor for pagination",
    "type": "string"
   },
   "positions": {
    "description": "List of staking positions with rewards",
    "items": {
     "additionalProperties": false,
     "properties": {
      "claimable_quote_rewards": {
       "description": "Claimable quote rewards (display)",
       "type": "string"
      },
      "claimable_quote_rewards_atomic": {
       "description": "Claimable quote rewards (atomic)",
       "type": "string"
      },
      "claimable_telecoin_rewards": {
       "description": "Claimable telecoin rewards (display)",
       "type": "string"
      },
      "claimable_telecoin_rewards_atomic": {
       "description": "Claimable telecoin rewards (atomic)",
       "type": "string"
      },
      "claimed_quote_rewards": {
       "description": "Historically claimed quote rewards (display)",
       "type": "string"
      },
      "claimed_quote_rewards_atomic": {
       "description": "Historically claimed quote rewards (atomic)",
       "type": "string"
      },
      "claimed_telecoin_rewards": {
       "description": "Historically claimed telecoin rewards (display)",
       "type": "string"
      },
      "claimed_telecoin_rewards_atomic": {
       "description": "Historically claimed telecoin rewards (atomic)",
       "type": "string"
      },
      "created_at": {
       "description": "Position creation timestamp (ISO)",
       "type": "string"
      },
      "creation_tx": {
       "description": "Transaction ID that created this position",
       "type": "string"
      },
      "has_claimable_rewards": {
       "description": "Whether position has claimable rewards",
       "type": "boolean"
      },
      "is_unlocked": {
       "description": "Whether the position is unlocked",
       "type": "boolean"
      },
      "lock_period": {
       "description": "Lock period (7_DAYS, 30_DAYS, etc.)",
       "type": "string"
      },
      "owner": {
       "description": "CAIP-10 owner address",
       "type": "string"
      },
      "position": {
       "description": "CAIP-10 position address",
       "type": "string"
      },
      "share_in_pool_bps": {
       "description": "Share in stake pool (basis points)",
       "type": "number"
      },
      "staked_amount": {
       "description": "Staked amount (display format)",
       "type": "string"
      },
      "staked_amount_atomic": {
       "description": "Staked amount (atomic)",
       "type": "string"
      },
      "telecoin_id": {
       "description": "Telecoin ID",
       "type": "string"
      },
      "unlocks_at": {
       "description": "Position unlock timestamp (ISO)",
       "type": "string"
      },
      "was_closed": {
       "description": "Whether the position was closed",
       "type": "boolean"
      }
     },
     "required": [
      "telecoin_id",
      "lock_period",
      "is_unlocked",
      "was_closed",
      "creation_tx",
      "has_claimable_rewards"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_positions": {
    "description": "Total number of positions",
    "type": "number"
   },
   "total_unlocked": {
    "description": "Unlocked positions ready for principal withdrawal",
    "type": "number"
   },
   "total_with_claimable_rewards": {
    "description": "Positions with claimable rewards",
    "type": "number"
   }
  },
  "required": [
   "positions",
   "total_positions",
   "total_with_claimable_rewards",
   "total_unlocked",
   "message"
  ],
  "type": "object"
 }
}

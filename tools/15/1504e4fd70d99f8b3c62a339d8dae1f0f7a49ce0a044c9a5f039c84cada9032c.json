{
 "description": "[WRITE] Revert workspace changes to a GTM template back to its last container-version state. Requires GTM_MCP_ENABLE_WRITES=true and confirm=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "description": "The GTM account ID.",
    "type": "string"
   },
   "confirm": {
    "description": "Must be true to confirm this write operation.",
    "type": "boolean"
   },
   "containerId": {
    "description": "The GTM container ID.",
    "type": "string"
   },
   "fingerprint": {
    "description": "Current fingerprint (for optimistic locking).",
    "type": "string"
   },
   "templateId": {
    "description": "The templates ID to revert.",
    "type": "string"
   },
   "workspaceId": {
    "description": "The GTM workspace ID.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "containerId",
   "workspaceId",
   "templateId",
   "confirm"
  ],
  "type": "object"
 },
 "name": "templates_revert"
}

{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Add a member to a SignUpGenius group by email address. First/last name are optional. Writes data \u2014 confirm with the user before invoking.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "emailaddress": {
    "description": "Email of the member to add to the group.",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "firstname": {
    "type": "string"
   },
   "groupId": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "lastname": {
    "type": "string"
   }
  },
  "required": [
   "groupId",
   "emailaddress"
  ],
  "type": "object"
 },
 "name": "signupgenius_add_group_member"
}

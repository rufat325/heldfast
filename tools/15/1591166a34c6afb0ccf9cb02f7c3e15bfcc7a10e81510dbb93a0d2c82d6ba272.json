{
 "description": "List, add, or delete contacts",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_account": {
    "description": "Optional. Override identity for THIS call: pass the AgenticMail agent name (e.g. \"Fola\") to authenticate as that agent. Requires AGENTICMAIL_ACCOUNT_KEYS_JSON to contain a matching key. Omit to use the default identity (AGENTICMAIL_API_KEY).",
    "type": "string"
   },
   "action": {
    "description": "Action to perform",
    "enum": [
     "list",
     "add",
     "delete"
    ],
    "type": "string"
   },
   "email": {
    "description": "Contact email (for add)",
    "type": "string"
   },
   "id": {
    "description": "Contact ID (for delete)",
    "type": "string"
   },
   "name": {
    "description": "Contact name (for add)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_contacts"
}

{
 "description": "Search X tweets and people. Paginate with next_cursor/has_more. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "next_cursor from previous response.",
    "type": "string"
   },
   "search": {
    "description": "Search query.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "search_type": {
    "description": "Top (default), Latest, People, Photos, Videos.",
    "enum": [
     "Top",
     "Latest",
     "People",
     "Photos",
     "Videos"
    ],
    "type": "string"
   }
  },
  "required": [
   "search"
  ],
  "type": "object"
 },
 "name": "search_x"
}

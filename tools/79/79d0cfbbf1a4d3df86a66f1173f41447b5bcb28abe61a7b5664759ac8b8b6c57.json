{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find nearby flight destinations",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currency": {
    "description": "Currency code for prices (default usd)",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "depart_date": {
    "description": "Departure date in YYYY-MM-DD format",
    "type": "string"
   },
   "destination": {
    "description": "Target destination IATA code \u2014 also searches nearby airports",
    "maxLength": 4,
    "minLength": 2,
    "type": "string"
   },
   "flexibility": {
    "description": "Date flexibility in days (+/- from given dates)",
    "maximum": 7,
    "minimum": 0,
    "type": "integer"
   },
   "origin": {
    "description": "Departure city IATA code (e.g. MOW)",
    "maxLength": 4,
    "minLength": 2,
    "type": "string"
   },
   "return_date": {
    "description": "Return date in YYYY-MM-DD format",
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination"
  ],
  "type": "object"
 },
 "name": "aviasales.flights.nearby",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "description": "Present only when the call failed. Includes error code, message, request_id, and any provider-specific extras."
   },
   "result": {
    "description": "Tool response payload. Shape varies per tool \u2014 consult the tool description and inputSchema. May be an object, array, string, or number depending on the upstream provider response."
   }
  },
  "type": "object"
 },
 "title": "Nearby Destinations"
}

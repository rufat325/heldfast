{
 "description": "Record a file edit as a first-class audit event (event_type=code_change). Call after every Edit or Write tool call with the unified diff. Diff content is included in the hash chain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "diff": {
    "description": "Unified diff string (before/after)",
    "type": "string"
   },
   "file_path": {
    "description": "Path of the file that was changed",
    "type": "string"
   },
   "operation": {
    "description": "Type of file operation",
    "enum": [
     "create",
     "edit",
     "delete"
    ],
    "type": "string"
   },
   "session_id": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "file_path",
   "diff",
   "operation"
  ],
  "type": "object"
 },
 "name": "log_code_change"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create LCA Steps"
 },
 "description": "Generate Low Code Automation (LCA) steps for a test case in BrowserStack Test Management using the Low Code Automation Agent. Requires a project identifier (PR-*). No tool here lists projects, so if you do not have one, call askBrowserStackAI with product \"tm\" and ask which projects exist, then retry this tool with the identifier it returns.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "base_url": {
    "description": "Base URL for the test (e.g., 'google.com')",
    "type": "string"
   },
   "credentials": {
    "description": "Login credentials; omit to have them requested from the user.",
    "properties": {
     "password": {
      "description": "Password for authentication",
      "type": "string"
     },
     "username": {
      "description": "Username for authentication",
      "type": "string"
     }
    },
    "required": [
     "username",
     "password"
    ],
    "type": "object"
   },
   "local_enabled": {
    "default": false,
    "description": "Whether local testing is enabled",
    "type": "boolean"
   },
   "project_identifier": {
    "description": "ID of the project (Starts with 'PR-')",
    "type": "string"
   },
   "requires_authentication": {
    "default": false,
    "description": "Set true if the test case requires login.",
    "type": "boolean"
   },
   "test_case_details": {
    "description": "Test case details including steps",
    "properties": {
     "description": {
      "description": "Description of the test case",
      "type": "string"
     },
     "name": {
      "description": "Name of the test case",
      "type": "string"
     },
     "preconditions": {
      "description": "Preconditions for the test case",
      "type": "string"
     },
     "test_case_steps": {
      "description": "Array of test case steps with expected results",
      "items": {
       "properties": {
        "result": {
         "description": "Expected result",
         "type": "string"
        },
        "step": {
         "description": "Test step description",
         "type": "string"
        }
       },
       "required": [
        "step",
        "result"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "name",
     "description",
     "preconditions",
     "test_case_steps"
    ],
    "type": "object"
   },
   "test_case_identifier": {
    "description": "Identifier of the test case (e.g., 'TC-12345')",
    "type": "string"
   },
   "test_name": {
    "description": "Name of the test",
    "type": "string"
   },
   "wait_for_completion": {
    "default": true,
    "description": "Whether to wait for LCA build completion (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "project_identifier",
   "test_case_identifier",
   "base_url",
   "test_name",
   "test_case_details"
  ],
  "type": "object"
 },
 "name": "createLCASteps"
}

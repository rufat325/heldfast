{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Press a device button (HOME, BACK, VOLUME_UP, etc.).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "button": {
    "description": "Button to press",
    "enum": [
     "HOME",
     "BACK",
     "VOLUME_UP",
     "VOLUME_DOWN",
     "POWER",
     "ENTER",
     "DELETE"
    ],
    "type": "string"
   },
   "platform": {
    "default": "auto",
    "enum": [
     "ios",
     "android",
     "auto"
    ],
    "type": "string"
   }
  },
  "required": [
   "button"
  ],
  "type": "object"
 },
 "name": "press_button"
}

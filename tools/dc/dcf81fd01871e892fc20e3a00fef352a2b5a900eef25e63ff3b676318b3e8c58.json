{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an uploaded certificate (provide PEM data) or a managed certificate (provide domain names).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "certificate": {
    "description": "PEM-encoded certificate (required for uploaded type)",
    "type": "string"
   },
   "domain_names": {
    "description": "Domain names (required for managed type)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Labels as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Name of the certificate",
    "type": "string"
   },
   "private_key": {
    "description": "PEM-encoded private key (required for uploaded type)",
    "type": "string"
   },
   "type": {
    "description": "Certificate type (default: uploaded)",
    "enum": [
     "uploaded",
     "managed"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "hetzner_create_certificate",
 "title": "Create Certificate"
}

{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "FREE real-time price snapshot for any EVM token by contract address: USD price, 5m/1h/6h/24h change, liquidity, 24h volume, market cap/FDV and the most-liquid DEX pair (DexScreener). Or pass a major symbol (ETH/BTC) for a Coinbase spot price. Read-only, free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "description": "Chain slug: base (default), ethereum, polygon, arbitrum, optimism, bsc, avalanche",
    "type": "string"
   },
   "symbol": {
    "description": "Major asset symbol (e.g. ETH, BTC) \u2014 used when no contract address is given",
    "type": "string"
   },
   "token": {
    "description": "ERC-20 contract address (0x\u2026) \u2014 preferred",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "token_price",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "description": "ISO 8601 time the snapshot was read",
    "type": "string"
   },
   "chain": {
    "description": "Chain the quoted pair trades on",
    "type": "string"
   },
   "fdvUsd": {
    "description": "Fully-diluted valuation in USD",
    "type": [
     "number",
     "null"
    ]
   },
   "liquidityUsd": {
    "description": "Pair liquidity in USD",
    "type": [
     "number",
     "null"
    ]
   },
   "marketCapUsd": {
    "description": "Market cap in USD",
    "type": [
     "number",
     "null"
    ]
   },
   "name": {
    "description": "Token name",
    "type": "string"
   },
   "note": {
    "description": "Human-readable caveat about the snapshot, if any",
    "type": "string"
   },
   "priceChange": {
    "additionalProperties": false,
    "description": "Percent price change by window",
    "properties": {
     "h1": {
      "type": [
       "number",
       "null"
      ]
     },
     "h24": {
      "type": [
       "number",
       "null"
      ]
     },
     "h6": {
      "type": [
       "number",
       "null"
      ]
     },
     "m5": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "m5",
     "h1",
     "h6",
     "h24"
    ],
    "type": "object"
   },
   "priceUsd": {
    "description": "Current USD price (most-liquid pair)",
    "type": [
     "number",
     "null"
    ]
   },
   "query": {
    "additionalProperties": {},
    "description": "The resolved lookup this snapshot answers (echoed so an agent can confirm what was priced)",
    "type": "object"
   },
   "recommend": {
    "additionalProperties": false,
    "description": "Recommended paid next step (token_safety) \u2014 present for contract-address lookups where a rug/honeypot check matters",
    "properties": {
     "alternatives": {
      "description": "Higher-value paid next steps beyond the primary token_safety \u2014 the token_report bundle and an address_intel screen of the contract (ADR-0063)",
      "items": {
       "additionalProperties": false,
       "properties": {
        "call": {
         "additionalProperties": false,
         "properties": {
          "args": {
           "additionalProperties": false,
           "properties": {
            "address": {
             "type": "string"
            },
            "chain": {
             "type": "string"
            },
            "token": {
             "type": "string"
            }
           },
           "type": "object"
          },
          "mcpTool": {
           "type": "string"
          },
          "rest": {
           "type": "string"
          }
         },
         "required": [
          "mcpTool",
          "rest",
          "args"
         ],
         "type": "object"
        },
        "priceUsd": {
         "type": "number"
        },
        "reason": {
         "type": "string"
        },
        "tool": {
         "type": "string"
        }
       },
       "required": [
        "tool",
        "priceUsd",
        "reason",
        "call"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "call": {
      "additionalProperties": false,
      "description": "The exact next call to make",
      "properties": {
       "args": {
        "additionalProperties": false,
        "properties": {
         "address": {
          "type": "string"
         },
         "chain": {
          "type": "string"
         },
         "token": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "mcpTool": {
        "type": "string"
       },
       "rest": {
        "type": "string"
       }
      },
      "required": [
       "mcpTool",
       "rest",
       "args"
      ],
      "type": "object"
     },
     "mcpTool": {
      "description": "For a listing whose endpoint is an MCP SERVER: the tool call_service invokes there. When present, args are wrapped in a JSON-RPC tools/call envelope",
      "type": "string"
     },
     "priceUsd": {
      "description": "Its price in USD (x402)",
      "type": "number"
     },
     "reason": {
      "description": "Why to run it before trading",
      "type": "string"
     },
     "tool": {
      "description": "Suggested next tool (token_safety)",
      "type": "string"
     },
     "x402PriceUsd": {
      "description": "REAL per-call x402 price for a first-party listing whose endpoint sits behind FiatDock's own paywall. priceUsd is 0 there only because such listings are not gateway-routed \u2014 budget from THIS field when present",
      "type": "number"
     }
    },
    "required": [
     "tool",
     "priceUsd",
     "reason",
     "call"
    ],
    "type": "object"
   },
   "source": {
    "description": "Data source",
    "type": "string"
   },
   "symbol": {
    "description": "Token symbol",
    "type": "string"
   },
   "topPair": {
    "additionalProperties": false,
    "description": "The most-liquid DEX pair used",
    "properties": {
     "dex": {
      "type": "string"
     },
     "pairAddress": {
      "type": "string"
     },
     "quote": {

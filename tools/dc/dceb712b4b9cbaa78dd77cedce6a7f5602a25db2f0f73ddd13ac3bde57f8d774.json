     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "txns24h": {
    "additionalProperties": false,
    "description": "24h buy/sell transaction counts on the top pair",
    "properties": {
     "buys": {
      "type": [
       "number",
       "null"
      ]
     },
     "sells": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "volume24hUsd": {
    "description": "24h trading volume in USD",
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "priceUsd",
   "source",
   "asOf"
  ],
  "type": "object"
 },
 "title": "Token price & liquidity (free)"
}

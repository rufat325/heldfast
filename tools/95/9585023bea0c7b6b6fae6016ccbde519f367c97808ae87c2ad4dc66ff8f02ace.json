{
 "description": "Forward an email to another address. Includes original message as quoted text. Get UIDs from email_list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "attachments": {
    "description": "Additional file attachments",
    "items": {
     "properties": {
      "filename": {
       "description": "Override filename",
       "type": "string"
      },
      "path": {
       "description": "Absolute file path on disk",
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "folder": {
    "description": "Folder of the original email (default: INBOX)",
    "type": "string"
   },
   "text": {
    "description": "Optional message to prepend before the forwarded content",
    "type": "string"
   },
   "to": {
    "description": "Recipient email address",
    "type": "string"
   },
   "uid": {
    "description": "Email UID to forward",
    "type": "number"
   }
  },
  "required": [
   "uid",
   "to"
  ],
  "type": "object"
 },
 "name": "email_forward"
}

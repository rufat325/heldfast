{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this to prototype the FinchNode connection journey. Returns a non-persistent synthetic session: complete for a record or behavior scenario, or the connect-cancelled or connect-failed outcome with no patient.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "categories": {
    "description": "Requested fictional record categories.",
    "items": {
     "enum": [
      "demographics",
      "medications",
      "conditions",
      "labs",
      "vitals",
      "allergies",
      "immunizations",
      "encounters"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "external_user_id": {
    "description": "Optional non-sensitive prototype identifier. Never send a real patient identifier.",
    "maxLength": 100,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "scenario": {
    "description": "Optional scenario id from list_demo_scenarios. Omitted means baseline-adult; connect-cancelled and connect-failed end without a patient.",
    "enum": [
     "baseline-adult",
     "polypharmacy-senior",
     "pediatric-asthma",
     "multi-source-overlap",
     "sparse-record",
     "messy-coding",
     "rate-limited",
     "consent-revoked",
     "consent-partial",
     "source-unavailable",
     "connect-cancelled",
     "connect-failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "simulate_demo_connect",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "session": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "session"
  ],
  "type": "object"
 },
 "title": "Simulate FinchNode Connect"
}

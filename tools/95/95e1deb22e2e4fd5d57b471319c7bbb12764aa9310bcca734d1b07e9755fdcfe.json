 "description": "Departures/arrivals at an airport \u2014 a live board of flights leaving from or arriving at an airport on a given date/hour. Example: flightstats_airport_status({ airport: \"JFK\", type: \"dep\", year: 2026, month: 7, day: 2, hour: 14, _apiKey: \"appId:appKey\" })",
 "inputSchema": {
  "examples": [
   {
    "_apiKey": "your-flightstats-appId:your-flightstats-appKey",
    "airport": "JFK",
    "day": 2,
    "hour": 14,
    "month": 7,
    "type": "dep",
    "year": 2026
   },
   {
    "_apiKey": "your-flightstats-appId:your-flightstats-appKey",
    "airport": "LHR",
    "day": 15,
    "month": 3,
    "year": 2026
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "FlightStats/Cirium credentials as \"appId:appKey\" (developer.cirium.com; free eval = 20,000 lifetime calls)",
    "type": "string"
   },
   "airport": {
    "description": "Airport IATA code, e.g. \"JFK\", \"LHR\", \"SFO\"",
    "type": "string"
   },
   "day": {
    "description": "Day of month 1-31",
    "type": "integer"
   },
   "hour": {
    "description": "Local hour 0-23 (optional, default 0)",

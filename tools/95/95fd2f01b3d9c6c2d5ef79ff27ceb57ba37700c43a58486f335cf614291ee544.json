{
 "description": "Create a Kubernetes cluster",
 "inputSchema": {
  "properties": {
   "flavor": {
    "description": "Worker node flavor",
    "type": "string"
   },
   "name": {
    "description": "Cluster name",
    "type": "string"
   },
   "subnet_id": {
    "description": "Subnet ID for VPC clusters",
    "type": "string"
   },
   "version": {
    "description": "Kubernetes version",
    "type": "string"
   },
   "vpc_id": {
    "description": "VPC ID for VPC clusters",
    "type": "string"
   },
   "workers": {
    "description": "Number of workers",
    "type": "number"
   },
   "zone": {
    "description": "Zone (e.g., dal10)",
    "type": "string"
   }
  },
  "required": [

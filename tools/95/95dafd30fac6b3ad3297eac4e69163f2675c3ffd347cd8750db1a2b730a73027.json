{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get quarterly or annual financial statements for a company (revenue, net income, EPS, margins, cash flow, debt ratios) from SEC 10-K/10-Q filings. Plan limits: the Free plan and keyless access return only the latest quarterly statement; annual statements and earlier quarters require Pro (a request for them returns an explicit plan-limit error, never 'no data'). structuredContent carries the exact reported values.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 8,
    "description": "Number of periods to return (default 8)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "period_type": {
    "default": "quarterly",
    "description": "Period type \u2014 quarterly (10-Q) or annual (10-K)",
    "enum": [
     "quarterly",
     "annual"
    ],
    "type": "string"
   },
   "ticker": {
    "description": "Stock ticker symbol (e.g. 'AAPL', 'MSFT')",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "get_stock_financials",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "period_type": {
    "enum": [
     "quarterly",
     "annual"
    ],
    "type": "string"
   },
   "periods": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "eps_basic": {
       "$ref": "#/properties/periods/items/properties/revenue"
      },
      "eps_diluted": {
       "$ref": "#/properties/periods/items/properties/revenue"
      },
      "gross_profit": {
       "$ref": "#/properties/periods/items/properties/revenue"
      },
      "long_term_debt": {
       "$ref": "#/properties/periods/items/properties/revenue"
      },
      "net_income": {
       "$ref": "#/properties/periods/items/properties/revenue"
      },
      "operating_cashflow": {
       "$ref": "#/properties/periods/items/properties/revenue"
      },
      "operating_income": {
       "$ref": "#/properties/periods/items/properties/revenue"
      },
      "period_end": {
       "type": [
        "string",
        "null"
       ]
      },
      "revenue": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
      },
      "short_term_debt": {
       "$ref": "#/properties/periods/items/properties/revenue"
      },
      "stockholders_equity": {
       "$ref": "#/properties/periods/items/properties/revenue"
      }
     },
     "required": [
      "period_end",
      "revenue",
      "net_income",
      "eps_basic",
      "eps_diluted",
      "gross_profit",
      "operating_income",
      "operating_cashflow",
      "long_term_debt",
      "short_term_debt",
      "stockholders_equity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "plan_limit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "continuation": {
        "$ref": "#/properties/periods/items/properties/period_end"
       },
       "date_basis": {
        "$ref": "#/properties/periods/items/properties/period_end"
       },
       "effective_period": {
        "$ref": "#/properties/periods/items/properties/period_end"
       },
       "policy_version": {
        "$ref": "#/properties/periods/items/properties/period_end"
       },
       "row_cap": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "truncated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "window_end": {
        "$ref": "#/properties/periods/items/properties/period_end"
       },
       "window_start": {
        "$ref": "#/properties/periods/items/properties/period_end"
       }
      },
      "required": [
       "policy_version",
       "window_start",
       "window_end",
       "effective_period",
       "date_basis",
       "row_cap",
       "truncated",
       "continuation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The Free/keyless plan limits ko.io applied to this answer (null for paid callers)"
   },
   "plan_note": {
    "description": "Set when the caller's plan limited which periods were returned",
    "type": [
     "string",
     "null"
    ]
   },
   "ticker": {
    "type": "string"
   }
  },
  "required": [
   "ticker",
   "period_type",
   "periods",
   "plan_note",
   "plan_limit"
  ],
  "type": "object"
 }
}

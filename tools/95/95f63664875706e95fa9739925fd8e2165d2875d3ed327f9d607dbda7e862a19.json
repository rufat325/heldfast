 "description": "\u0414\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0447\u0430\u0441\u0442\u043e\u0442\u043d\u043e\u0441\u0442\u0438 \u0444\u0440\u0430\u0437\u044b: { results: [{ date, count, share }] }. \u0412\u0410\u0416\u041d\u041e: \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b (\u00ab!\u00bb, \u043a\u0430\u0432\u044b\u0447\u043a\u0438) \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438 period=daily; monthly \u0442\u0440\u0435\u0431\u0443\u0435\u0442 fromDate = 1-\u0435 \u0447\u0438\u0441\u043b\u043e \u0438 toDate = \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0434\u0435\u043d\u044c \u043c\u0435\u0441\u044f\u0446\u0430, weekly \u2014 fromDate \u043f\u043e\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u0438\u043a. \u0414\u0430\u043d\u043d\u044b\u0435 weekly/monthly \u0441 2018 \u0433\u043e\u0434\u0430, daily \u2014 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 60 \u0434\u043d\u0435\u0439. \u0414\u0430\u0442\u044b \u0432\u0430\u043b\u0438\u0434\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0434\u043e \u0437\u0430\u043f\u0440\u043e\u0441\u0430.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,

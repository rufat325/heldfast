{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Sends student names to ClassDojo only after explicit confirmation, then verifies each class by reading it back.",
 "execution": {
  "taskSupport": "forbidden"
 },

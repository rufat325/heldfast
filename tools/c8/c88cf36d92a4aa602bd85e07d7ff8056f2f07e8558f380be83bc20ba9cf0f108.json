{
 "description": "Create a note from a template, substituting {{date}}, {{time}}, {{title}}, and any extra vars.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Name for the new note",
    "type": "string"
   },
   "template": {
    "description": "Template name (see list_templates)",
    "type": "string"
   },
   "vars": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Extra {{key}} substitutions",
    "type": "object"
   }
  },
  "required": [
   "template",
   "name"
  ],
  "type": "object"
 },
 "name": "create_from_template",
 "title": "Create note from template"
}

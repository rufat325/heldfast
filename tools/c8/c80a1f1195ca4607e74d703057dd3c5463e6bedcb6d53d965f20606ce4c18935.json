{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Consumer-group operations on a stream: create, destroy, read (XREADGROUP), ack (XACK), pending (XPENDING), claim (XCLAIM/XAUTOCLAIM).",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Operation",
    "enum": [
     "create",
     "destroy",
     "read",
     "ack",
     "pending",
     "claim"
    ],
    "type": "string"
   },
   "consumer": {
    "description": "Consumer name (read/pending/claim)",
    "type": "string"
   },
   "count": {
    "description": "Max entries (read/pending/claim)",
    "type": "number"
   },
   "from": {
    "description": "Start position for create (default $ = new entries only, use 0 for all)",
    "type": "string"
   },
   "group": {
    "description": "Consumer group name",
    "type": "string"
   },
   "ids": {
    "description": "Entry IDs (ack/claim)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "minIdleMs": {
    "description": "Min idle ms before claim (claim)",
    "type": "number"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   },
   "start": {
    "description": "Autoclaim scan start (claim)",
    "type": "string"
   },
   "stream": {
    "description": "Stream name",
    "type": "string"
   },
   "waitSeconds": {
    "description": "Long-poll seconds \u226425 (read)",
    "type": "number"
   }
  },
  "required": [
   "spaceId",
   "stream",
   "action",
   "group"
  ],
  "type": "object"
 },
 "name": "stream_group",
 "outputSchema": {
  "properties": {},
  "type": "object"
 }
}

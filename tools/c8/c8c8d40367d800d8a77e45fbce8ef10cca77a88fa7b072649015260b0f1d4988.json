 },
 "description": "Look up a threat indicator in OTX: an IPv4 or IPv6 address, a domain or hostname, a URL, an MD5/SHA1/SHA256 file hash, or a CVE id such as CVE-2021-4034. Returns the threat-intel pulses referencing that indicator plus observed-context fields, so it answers questions like which campaigns exploit a given CVE or whether an IP is known-malicious. type is auto-detected when omitted.",
 "inputSchema": {
  "examples": [
   {
    "indicator": "192.0.2.1"
   },
   {
    "indicator": "example.com",
    "type": "domain"
   },
   {
    "indicator": "d41d8cd98f00b204e9800998ecf8427e",
    "type": "file"
   },
   {
    "indicator": "CVE-2021-4034",
    "type": "cve"
   }
  ],
  "properties": {
   "indicator": {
    "description": "The value to look up: IPv4, IPv6, domain, hostname, URL, MD5/SHA1/SHA256 hash, or a CVE id such as CVE-2021-4034. Auto-detected \u2014 you do not need to pass `type`.",
    "type": "string"
   },
   "type": {
    "description": "Force a type instead of auto-detecting. Case-insensitive and forgiving \u2014 \"ip\"/\"ipv4\"/\"ip_address\" all mean IPv4, \"CVE\" means cve, \"md5\"/\"sha256\"/\"hash\" all mean file. Leave it off unless auto-detection gets it wrong.",
    "enum": [
     "IPv4",
     "IPv6",
     "domain",
     "hostname",
     "url",
     "file",
     "cve"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "lookup_indicator",

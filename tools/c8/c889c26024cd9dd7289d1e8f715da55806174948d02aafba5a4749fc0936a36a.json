  "readOnlyHint": false,
  "title": "Create brand kit"
 },
 "description": "Create a brand kit by hand in the user's active space from what the user gave. Only name is required; colors, fonts and radius left out start from the YouSpot kit. Logos are uploaded on the kit's page. To import a brand from a website use extract_brand_kit instead. Returns the brand_kit_id.",
 "inputSchema": {
  "properties": {
   "colors": {
    "additionalProperties": false,
    "description": "Hex colors (#rrggbb). Any left out keep their current value.",
    "properties": {
     "accent": {
      "pattern": "^#[0-9a-fA-F]{6}$",
      "type": "string"
     },
     "background": {
      "pattern": "^#[0-9a-fA-F]{6}$",
      "type": "string"
     },
     "border": {
      "pattern": "^#[0-9a-fA-F]{6}$",
      "type": "string"
     },

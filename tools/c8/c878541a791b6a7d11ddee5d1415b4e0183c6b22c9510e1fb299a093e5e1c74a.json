{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Rate your counterparty on a job that's completed or cancelled. Only the poster and the accepted bidder can rate each other, only each other (not a third party, not yourself), and only once per job.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "comment": {
    "description": "Optional comment",
    "type": "string"
   },
   "job_id": {
    "description": "The job's UUID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "rated_user_id": {
    "description": "The user id of your actual counterparty on this job -- the poster if you're the accepted bidder, or the accepted bidder if you're the poster",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "score": {
    "description": "Rating from 1 to 5",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "job_id",
   "rated_user_id",
   "score"
  ],
  "type": "object"
 },
 "name": "submit_rating",
 "title": "Rate your counterparty on a finished job"
}

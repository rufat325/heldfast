{
 "description": "Inspect one project-scoped alert group and a paginated page of member incident IDs without raw logs or destination secrets.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "cursor": {
    "maxLength": 256,
    "type": "string"
   },
   "groupId": {
    "format": "uuid",
    "type": "string"
   },
   "kind": {
    "enum": [
     "direct",
     "email_digest"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "kind",
   "groupId"
  ],
  "type": "object"
 },
 "name": "get_alert_group"
}

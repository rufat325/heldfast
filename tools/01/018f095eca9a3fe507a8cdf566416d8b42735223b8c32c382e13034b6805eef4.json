       "coolingMode": {
        "enum": [
         "air",
         "hybrid",
         "liquid"
        ],
        "type": "string"
       },
       "pueTarget": {
        "maximum": 2.5,
        "minimum": 1,
        "type": "number"
       },
       "redundancy": {
        "enum": [
         "n",
         "n_plus_1",
         "2n"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "parcels": {
      "description": "Optional bounded GeoJSON parcel features.",

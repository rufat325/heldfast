{
 "description": "Generate profile-aware physical rack blocks, rack-plan candidates, and site layout data from a nested design request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "design": {
    "additionalProperties": {},
    "description": "Nested design request that drives layout.",
    "properties": {
     "customInputs": {
      "additionalProperties": {},
      "description": "Optional project-specific design inputs.",
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "gpuGen": {
      "description": "NVIDIA GPU generation: hopper, blackwell, or rubin.",
      "enum": [
       "hopper",
       "blackwell",
       "rubin"
      ],
      "type": "string"
     },
     "hallCount": {
      "description": "Optional requested data-hall count.",
      "exclusiveMinimum": 0,
      "maximum": 48,
      "type": "integer"
     },
     "itLoadMw": {
      "description": "IT load in megawatts. 0 < x <= 1000.",
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "number"
     },
     "options": {
      "description": "Optional redundancy, cooling-mode, and PUE overrides.",

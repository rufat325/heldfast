{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send an email from an existing identity address. 'from' must be an identity created with mail_new_identity.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "description": "Sender address (must be an existing identity)",
    "maxLength": 320,
    "pattern": "^[a-z0-9][a-z0-9._-]{0,62}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.?$",
    "type": "string"
   },
   "html": {
    "description": "Optional HTML body",
    "maxLength": 1000000,
    "type": "string"
   },
   "subject": {
    "description": "Subject line",
    "maxLength": 998,
    "type": "string"
   },
   "text": {
    "description": "Plain-text body",
    "maxLength": 1000000,
    "type": "string"
   },
   "to": {
    "description": "Recipient address",
    "maxLength": 320,
    "pattern": "^[a-z0-9][a-z0-9._-]{0,62}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.?$",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to",
   "subject",
   "text"
  ],
  "type": "object"
 },
 "name": "mail_send",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "messageId": {
    "type": "string"
   },
   "queued": {
    "type": "boolean"
   }
  },
  "required": [
   "queued",
   "messageId"
  ],
  "type": "object"
 },
 "title": "Send Email"
}

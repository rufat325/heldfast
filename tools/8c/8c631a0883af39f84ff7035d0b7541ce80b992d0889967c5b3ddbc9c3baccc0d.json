{
 "description": "Add multiple blocks to a document in one call. If a block's sortOrder is omitted, it is appended to the end. Block types: 'text' (Tiptap JSON), 'interactive' (AI HTML viz), 'html' (static HTML), 'table'. New blocks appear live for any open editor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blocks": {
    "description": "Array of blocks to add in order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {},
      "html": {
       "type": "string"
      },
      "sortOrder": {
       "type": "number"
      },
      "type": {
       "enum": [
        "text",
        "interactive",
        "html",
        "table"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "documentId": {
    "description": "The document ID",
    "type": "string"
   }
  },
  "required": [
   "documentId",
   "blocks"
  ],
  "type": "object"
 },
 "name": "add_blocks"
}

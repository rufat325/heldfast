{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List authenticated athlete routes. GPS/map geometry is redacted unless raw mode is requested.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "after": {
    "description": "Only return activities after this time. Converted to Strava epoch seconds.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "all_pages": {
    "default": false,
    "description": "Fetch multiple pages up to max_pages.",
    "type": "boolean"
   },
   "before": {
    "description": "Only return activities before this time. Converted to Strava epoch seconds.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "explicit_user_intent": {
    "description": "Required true when privacy_mode=raw or include_gps=true (agent escalation of redaction).",
    "type": "boolean"
   },
   "limit": {
    "default": 30,
    "description": "Strava per_page value. Strava allows up to 200.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "max_pages": {
    "default": 1,
    "description": "Maximum pages to fetch when all_pages is true.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Strava page number.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "privacy_mode": {
    "description": "Optional per-call privacy override. Defaults to STRAVA_PRIVACY_MODE or structured. raw returns upstream Strava JSON. summary removes GPS/map details.",
    "enum": [
     "summary",
     "structured",
     "raw"
    ],
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "strava_list_routes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "endpoint": {
    "type": "string"
   },
   "has_more": {
    "type": "boolean"
   },
   "next_page": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "pages_fetched": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "privacy_mode": {
    "enum": [
     "summary",
     "structured",
     "raw"
    ],
    "type": "string"
   },
   "records": {
    "items": {},
    "type": "array"
   }
  },
  "required": [
   "endpoint",
   "privacy_mode",
   "count",
   "records",
   "has_more",
   "pages_fetched"
  ],
  "type": "object"
 },
 "title": "Strava Routes"
}

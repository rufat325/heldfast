{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search network requests by URL pattern, method, or status code.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "device": {
    "description": "Device key or \"all\". Defaults to current device.",
    "type": "string"
   },
   "errorsOnly": {
    "default": false,
    "description": "Show only failed requests",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of results to return",
    "type": "number"
   },
   "method": {
    "description": "HTTP method filter",
    "type": "string"
   },
   "statusCode": {
    "description": "HTTP status code filter",
    "type": "number"
   },
   "urlPattern": {
    "description": "URL substring or regex pattern",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_network"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate deterministic commercial-intelligence signals, risk flags and positive signals for one Oman company by companyId, for a stated evaluation purpose. Use when an agent needs to assess whether an Oman company looks like a serious, established operating business \u2014 as a supplier, customer, partner or investment target.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "purpose": {
    "enum": [
     "general",
     "supplier",
     "customer",
     "partner",
     "investor"
    ],
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "purpose"
  ],
  "type": "object"
 },
 "name": "analyze_oman_company",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "commercialSignals": {
    "additionalProperties": false,
    "properties": {
     "businessMaturity": {
      "enum": [
       "new",
       "early_stage",
       "growing",
       "established"
      ],
      "type": "string"
     },
     "dataCompletenessScore": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "digitalPresenceScore": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "governmentProcurementActivity": {
      "enum": [
       "active",
       "limited",
       "none"
      ],
      "type": "string"
     },
     "operatingStatus": {
      "type": "string"
     },
     "yearsActive": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "yearsActive",
     "operatingStatus",
     "digitalPresenceScore",
     "dataCompletenessScore",
     "businessMaturity",
     "governmentProcurementActivity"
    ],
    "type": "object"
   },
   "companyId": {
    "type": "string"
   },
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "confidenceReasons": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dataCoverage": {
    "additionalProperties": false,
    "properties": {
     "demoSources": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "latestVerifiedAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "realSources": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "realSources",
     "demoSources",
     "latestVerifiedAt"
    ],
    "type": "object"
   },
   "positiveSignals": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recommendedChecks": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "riskFlags": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      }
     },
     "required": [
      "code",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "fields": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "observedAt": {
       "type": "string"
      },
      "sourceAuthority": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "sourceName": {
       "type": "string"
      },
      "sourceRecordId": {
       "type": [
        "string",
        "null"
       ]
      },
      "sourceType": {
       "enum": [
        "government",
        "public_registry",
        "tax_authority",
        "government_procurement",
        "company_website",
        "licensed_feed",
        "directory",
        "news",
        "demo",
        "other",
        "admin_manual"
       ],
       "type": "string"
      },
      "sourceUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "verificationStatus": {
       "enum": [
        "verified",
        "reported",
        "estimated",
        "inferred",
        "stale",
        "conflicting",
        "unknown"
       ],
       "type": "string"
      }
     },
     "required": [
      "sourceName",
      "sourceType",
      "sourceAuthority",
      "sourceUrl",
      "sourceRecordId",
      "observedAt",
      "verificationStatus",
      "fields"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "companyId",
   "commercialSignals",
   "riskFlags",
   "positiveSignals",
   "recommendedChecks",
   "confidence",
   "confidenceReasons",
   "dataCoverage",
   "sources"
  ],
  "type": "object"
 }
}

{
 "description": "\u30c6\u30b9\u30c8\u6761\u4ef6\u7fa4\u3092\u30c6\u30b9\u30c8\u30b3\u30f3\u30c6\u30ca\u3078\u675f\u306d\u3001\u5404\u30b3\u30f3\u30c6\u30ca\u306e\u8cac\u52d9\u30fb\u30c6\u30b9\u30c8\u30ec\u30d9\u30eb\u30fb\u30c6\u30b9\u30c8\u30bf\u30a4\u30d7\u30fb\u512a\u5148\u5ea6\u30af\u30e9\u30b9\u30fb\u62c5\u5f53\u89b3\u70b9\u30ab\u30c6\u30b4\u30ea\u3068\u3001\u30c6\u30b9\u30c8\u30b9\u30b3\u30fc\u30d7\u306e\u5ba3\u8a00\u3092\u3001\u5b9f\u969b\u306b\u5e30\u5c5e\u3057\u305f\u30c6\u30b9\u30c8\u6761\u4ef6\u30fb\u30c6\u30b9\u30c8\u30b1\u30fc\u30b9\u306e\u5b9f\u4f53\u3068\u6c7a\u5b9a\u7684\u306b\u7167\u5408\u3057\u3066Markdown\u3067\u8fd4\u3059\u3002\u30c6\u30b9\u30c8\u30b9\u30b3\u30fc\u30d7\u3001\u30b3\u30f3\u30c6\u30ca\u4e00\u89a7\u3001\u968e\u5c64\u56f3\u3001\u6761\u4ef6\u306e\u30b3\u30f3\u30c6\u30ca\u5e30\u5c5e\u3001\u30ec\u30d9\u30eb/\u30bf\u30a4\u30d7/\u512a\u5148\u5ea6\u30af\u30e9\u30b9\u306e\u5206\u5e03\u3001\u30b3\u30f3\u30c6\u30ca\u5225\u30c6\u30b9\u30c8\u30b5\u30a4\u30ba\u5206\u5e03\u3001\u6761\u4ef6\u2192\u30b1\u30fc\u30b9\u306e\u30c8\u30ec\u30fc\u30b5\u30d3\u30ea\u30c6\u30a3\u3001\u6c7a\u5b9a\u7684\u691c\u67fb\u3001\u30b5\u30de\u30ea\u306e9\u7bc0\u3092\u51fa\u529b\u3059\u308b\u3002\u5e30\u5c5e\u7387\u30fb\u69cb\u6210\u6bd4\u306f\u5fc5\u305a\u5206\u6bcd\u3068\u672a\u5e30\u5c5e\u6761\u4ef6ID\u306e\u5168\u5217\u6319\u3092\u4f75\u8a18\u3057\u3001\u30c6\u30b9\u30c8\u30b1\u30fc\u30b9\u672a\u6307\u5b9a\u6642\u306f\u30b3\u30f3\u30c6\u30ca\u5225\u30b5\u30a4\u30ba\u5206\u5e03\u3092\u6570\u5024\u3067\u51fa\u3055\u305a\u672a\u7b97\u51fa\uff08\u7406\u7531\uff09\u3068\u660e\u8a18\u3059\u308b\u3002\u30b3\u30f3\u30c6\u30ca\u9593\u306e\u5b9f\u884c\u9806\u5e8f\u30fb\u4f9d\u5b58\u95a2\u4fc2\u30fb\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d1\u30b9\u306f\u5bfe\u8c61\u5916\u3002\u5224\u5b9a\u533a\u5206\u3068\u5bfe\u51e6\u6307\u91dd\u306f testarch://container/design-principles \u3092\u53c2\u7167\u3059\u308b\u3002\u4e0b\u6d41\u30c4\u30fc\u30eb\u306e\u5165\u529b\u5f62\u5f0f\u305d\u306e\u307e\u307e\u306e\u5f15\u304d\u6e21\u3057JSON\u3092 `emitHandoverPayload: true` \u3067\u51fa\u529b\u3057\u3001\u53d7\u3051\u5074\u306e\u7b97\u51fa\u30ed\u30b8\u30c3\u30af\u3067\u5f80\u5fa9\u7167\u5408\u3057\u305f\u7d50\u679c\u3092\u4f75\u8a18\u3059\u308b\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "completedTools": {
    "description": "Already executed tools; entries without evidence are treated as not executed",
    "items": {
     "properties": {
      "evidence": {
       "description": "Evidence of execution: an output file path (e.g. docs/test-cases.md) or an output heading line starting with '#'",
       "type": "string"
      },
      "outputExcerpt": {
       "description": "Excerpt of the declared tool's actual output text. Must contain that tool's own H1 heading line; otherwise the declaration is reported as evidence-unverified and still counted as not executed",
       "type": "string"
      },
      "toolName": {
       "description": "Name of an already executed tool in this workflow",
       "type": "string"
      }
     },
     "required": [
      "toolName",
      "evidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "containers": {
    "description": "Test containers to organize the test conditions into",
    "items": {
     "properties": {
      "entryCriteria": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "environment": {
       "type": "string"
      },
      "exitCriteria": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "description": "Container id, unique across the spec, e.g. TCN-01",
       "type": "string"
      },
      "nameJa": {
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "objective": {
       "type": "string"
      },
      "parentId": {
       "description": "Parent container id; omit for a root container",
       "type": "string"
      },
      "perspectiveCategoryIds": {
       "description": "Test perspective category ids (TPC-xx) this container declares responsibility for",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "priorityClass": {
       "description": "Execution necessity class; see testarch://container/design-principles",
       "enum": [
        "must",
        "conditional",
        "optional"
       ],
       "type": "string"
      },
      "responsibility": {
       "description": "What this container guarantees (required)",
       "type": "string"
      },
      "targets": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "testLevel": {
       "enum": [
        "component-testing",
        "integration-testing",
        "system-testing",
        "acceptance-testing"
       ],
       "type": "string"
      },
      "testTypes": {
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "id",
      "nameJa",
      "responsibility",
      "testLevel",
      "testTypes",
      "priorityClass"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "decompositionAxisIds": {
    "description": "Declared container decomposition axis ids (TAX-xx); reconciled against the actual containers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "emitHandoverPayload": {
    "description": "If true, emits the full downstream-ready payload JSON. Default false: only the reconciliation summary, counts and the non-generatable field list are emitted.",
    "type": "boolean"
   },
   "maxContainers": {
    "description": "Container count cap (default 200)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "maxDepth": {
    "description": "Hierarchy depth cap (default 5)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "scope": {
    "description": "Declared test scope; out-of-scope items require a reason",
    "properties": {
     "inScope": {
      "items": {
       "properties": {
        "item": {
         "type": "string"
        },
        "reason": {
         "type": "string"
        }
       },
       "required": [
        "item"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "outOfScope": {
      "items": {
       "properties": {
        "item": {
         "type": "string"
        },
        "reason": {
         "type": "string"
        },
        "reasonKind": {
         "description": "Set to \"not-in-basis\" when the out-of-scope reason itself is \"this item has no description in the test basis\" (e.g. excluding screens because the basis documents contain no UI description). When set, TBG-01 label grounding is skipped for this item, and instead TAC-14 verifies the reverse: that the item text truly does not appear in the basis.",
         "enum": [
          "not-in-basis"
         ],
         "type": "string"
        }
       },
       "required": [
        "item"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "inScope",
     "outOfScope"
    ],
    "type": "object"
   },
   "testBasisDocuments": {
    "description": "Test basis documents used to verify that declared labels (factor names, level values, state names, etc.), quoted wordings and referenced ids really exist in the test basis. Pass the full text: passing only excerpts makes existing wordings be reported as ungrounded. When omitted, the grounding check is reported as not inspectable instead of passing silently.",
    "items": {
     "properties": {
      "content": {
       "description": "Full text of the document (any format; caller converts binaries to text)",
       "type": "string"
      },
      "name": {
       "description": "Document name or file name of the test basis document",
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testCases": {
    "description": "Test cases; when given, per-container test size distribution and condition-to-case traceability are computed",
    "items": {
     "properties": {
      "caseId": {
       "description": "Test case id, e.g. TCS-001",
       "type": "string"
      },
      "coverageTargets": {
       "description": "Coverage target ids from section 2 that this case satisfies (required)",
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "declaredTestSize": {
       "description": "Test size declared by the caller; compared against the classified size",
       "enum": [
        "small",
        "medium",
        "large"
       ],
       "type": "string"
      },
      "derivedFrom": {
       "description": "Requirement/feature/screen/scenario/risk ids this case was derived from (required). Plain id string, or {kind, id} to disambiguate across requirement/risk/stakeholder/guideword namespaces",
       "items": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "properties": {
           "id": {
            "minLength": 1,
            "type": "string"
           },
           "kind": {
            "enum": [
             "requirement",
             "risk",
             "stakeholder",
             "guideword"
            ],
            "type": "string"
           }
          },
          "required": [
           "kind",
           "id"
          ],
          "type": "object"
         }
        ]
       },
       "minItems": 1,
       "type": "array"
      },
      "estimatedDurationSeconds": {
       "description": "Estimated execution time in seconds at design time, used for test size classification",
       "minimum": 0,
       "type": "number"
      },
      "externalDependencyIds": {
       "description": "External dependency axis ids (TSD-01..TSD-08 from testdesign://testsize/classification-criteria); pass an empty array to declare no external dependency",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "note": {
       "type": "string"
      },
      "perspectiveCategoryId": {
       "type": "string"
      },
      "postconditions": {
       "items": {
        "properties": {
         "name": {
          "description": "State variable name",
          "type": "string"
         },
         "value": {
          "description": "State variable value",
          "type": "string"
         }
        },
        "required": [
         "name",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "preconditions": {
       "description": "Precondition state variables (required)",
       "items": {
        "properties": {
         "name": {
          "description": "State variable name",
          "type": "string"
         },
         "value": {
          "description": "State variable value",
          "type": "string"
         }
        },
        "required": [
         "name",
         "value"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "priority": {
       "enum": [
        "\u9ad8",
        "\u4e2d",
        "\u4f4e"
       ],
       "type": "string"
      },
      "result": {
       "properties": {
        "defectNo": {
         "description": "Linked defect number",
         "type": "string"
        },
        "executedBy": {
         "description": "Executor name",
         "type": "string"
        },
        "executedDate": {
         "description": "Execution date",
         "type": "string"
        },
        "verdict": {
         "description": "Execution verdict",
         "enum": [
          "\u5408\u683c",
          "\u4e0d\u5408\u683c",
          "\u672a\u5b9f\u65bd",
          "\u5bfe\u8c61\u5916"
         ],
         "type": "string"
        }
       },
       "type": "object"
      },
      "sourceRefs": {
       "description": "Explicit source locations in the test basis; takes precedence over other resolution",
       "items": {
        "properties": {
         "document": {
          "description": "Test basis document name",
          "type": "string"
         },
         "endLine": {
          "description": "1-based end line in the document",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
         },
         "heading": {
          "description": "Nearest heading in the document",
          "type": "string"
         },
         "label": {
          "description": "Display label, e.g. 'EH-100 Ticket gate startup'",
          "type": "string"
         },
         "startLine": {
          "description": "1-based start line in the document",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
         }
        },
        "required": [
         "document",
         "startLine"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "steps": {
       "description": "Ordered steps, one operation per step (required)",
       "items": {
        "properties": {
         "action": {
          "description": "A single operation for this step",
          "type": "string"
         },
         "expected": {
          "description": "Observable expected result for this step",
          "type": "string"
         },
         "no": {
          "description": "1-based sequential step number",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "no",
         "action",
         "expected"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "techniqueId": {
       "description": "Applied technique id (required)",
       "type": "string"
      },
      "testConditionId": {
       "description": "Origin test condition id (required)",
       "type": "string"
      },
      "testLevel": {
       "description": "Declared test level for this case; used to check test level allocation against the test size",
       "enum": [
        "component-testing",
        "integration-testing",
        "system-testing",
        "acceptance-testing"
       ],
       "type": "string"
      },
      "testType": {
       "description": "Test type label",
       "type": "string"
      },
      "title": {
       "description": "Test case title",
       "type": "string"
      }
     },
     "required": [
      "caseId",
      "title",
      "testConditionId",
      "derivedFrom",
      "techniqueId",
      "coverageTargets",
      "preconditions",
      "steps"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testConditions": {
    "description": "Test conditions from extract_test_conditions, with their container assignment",
    "items": {
     "properties": {
      "containerIds": {
       "description": "Container ids this condition belongs to",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "perspectiveCategoryId": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "\u9ad8",
        "\u4e2d",
        "\u4f4e"
       ],
       "type": "string"
      },
      "statement": {
       "type": "string"
      },
      "target": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "containerIds"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "containers",
   "testConditions"
  ],
  "type": "object"
 },
 "name": "design_test_architecture",
 "title": "Design Test Architecture"
}

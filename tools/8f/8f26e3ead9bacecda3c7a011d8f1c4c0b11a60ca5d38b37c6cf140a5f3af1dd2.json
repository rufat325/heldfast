{
 "description": "Post a message or internal note on a record (requires mail.thread). message_type: \"comment\" (sent to followers) or \"note\" (internal log note, not emailed). Returns {message_id} or {error}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "type": "string"
   },
   "message_type": {
    "default": "comment",
    "enum": [
     "comment",
     "note"
    ],
    "type": "string"
   },
   "model": {
    "type": "string"
   },
   "record_id": {
    "type": "integer"
   }
  },
  "required": [
   "model",
   "record_id",
   "body"
  ],
  "type": "object"
 },
 "name": "post_message"
}

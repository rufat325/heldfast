{
 "description": "Get conversation history from a platform API. Unlike channel_receive (which reads the local buffer), this fetches older messages directly from the platform.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "before": {
    "description": "Unix timestamp (ms) \u2014 messages before this time",
    "type": "number"
   },
   "channelId": {
    "description": "Channel/chat ID",
    "type": "string"
   },
   "limit": {
    "description": "Max messages to return (default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "platform": {
    "description": "Platform to query",
    "enum": [
     "telegram",
     "discord",
     "slack",
     "whatsapp"
    ],
    "type": "string"
   },
   "threadId": {
    "description": "Thread ID for thread-specific history",
    "type": "string"
   }
  },
  "required": [
   "platform",
   "channelId"
  ],
  "type": "object"
 },
 "name": "channel_history"
}

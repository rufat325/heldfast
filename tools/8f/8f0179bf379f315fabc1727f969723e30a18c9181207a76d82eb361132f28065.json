 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Build one payroll payslip workbook (xlsx) with one sheet per employee from attribution_ym, payment_date, and employees[]. Platform key Job \u2014 no account_link_id. Result is a single signed download_url (not composite merge; not Gmail).",
 "inputSchema": {
  "properties": {
   "attribution_ym": {
    "description": "Payroll attribution month as YYYYMM (e.g. 202603).",
    "maxLength": 6,
    "minLength": 6,
    "pattern": "^[0-9]{6}$",
    "type": "string"
   },
   "business_registration_no": {
    "type": "string"
   },
   "company_name": {
    "description": "Alias for workplace_name (runtime accepts either).",
    "type": "string"
   },
   "employees": {
    "description": "Employee rows for payslip sheets (amounts already computed).",
    "items": {
     "properties": {
      "base_salary_won": {
       "type": "integer"
      },
      "basic_salary_won": {
       "type": "integer"
      },
      "birth_date": {
       "description": "YYYY-MM-DD or YYYYMMDD",
       "type": "string"
      },
      "children_count_8_to_20": {
       "description": "ADR-069 D-4: >=0; omit \u2192 0 when monthly pay + dependent_count present",
       "minimum": 0,
       "type": "integer"
      },
      "dependent_count": {
       "description": "ADR-069 D-4: >=1 includes self; never invent",
       "minimum": 1,
       "type": "integer"
      },
      "employee_key": {
       "description": "Stable employee id within the request",
       "type": "string"
      },
      "employee_name": {
       "type": "string"
      },
      "employment_insurance_won": {
       "type": "integer"
      },
      "gross_pay_won": {
       "type": "integer"
      },
      "health_insurance_won": {
       "type": "integer"
      },
      "income_tax_won": {
       "type": "integer"
      },
      "local_income_tax_won": {
       "type": "integer"
      },
      "long_term_care_won": {
       "type": "integer"
      },
      "monthly_pay_won": {
       "description": "Canonical monthly pay / gross (ADR-069). Wins over monthly_salary_won when both are set.",
       "type": "integer"
      },
      "monthly_salary_won": {
       "description": "Alias for monthly_pay_won when pay is absent",
       "type": "integer"
      },
      "national_pension_won": {
       "type": "integer"
      },
      "net_pay_won": {
       "type": "integer"
      },
      "total_deduction_won": {
       "type": "integer"
      }
     },
     "required": [
      "employee_key",
      "employee_name",
      "birth_date",
      "monthly_pay_won",
      "dependent_count",
      "national_pension_won",
      "health_insurance_won",
      "long_term_care_won",
      "employment_insurance_won",
      "income_tax_won",
      "local_income_tax_won",
      "total_deduction_won",
      "net_pay_won"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "payment_date": {
    "description": "Payment date YYYY-MM-DD.",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "workplace_address": {
    "type": "string"
   },
   "workplace_name": {
    "description": "Workplace / company display name (required for payslip).",
    "type": "string"
   }
  },
  "required": [
   "attribution_ym",
   "payment_date",
   "employees",
   "workplace_name",
   "business_registration_no",
   "workplace_address"
  ],
  "type": "object"
 },
 "name": "payroll_artifact__payslip_xlsx",
 "securitySchemes": [
  {
   "scopes": [
    "mcp:tools:list",
    "mcp:tools:call"
   ],
   "type": "oauth2"
  }
 ],
 "title": "\uae09\uc5ec\uba85\uc138\uc11c \uc5d1\uc140 \uc0dd\uc131"

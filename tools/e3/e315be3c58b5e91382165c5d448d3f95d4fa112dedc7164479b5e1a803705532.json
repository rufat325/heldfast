{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Crear campa\u00f1a"
 },
 "description": "Crea una campa\u00f1a en estado \"draft\" (NO empieza a enviar hasta start_campaign). Define mensaje (con variantes A/B/C que rotan), follow-ups y targets. Respeta l\u00edmites de plan y dedup.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client_reference": {
    "type": "string"
   },
   "follow_ups": {
    "description": "Secuencia de follow-ups (se paran solos si el lead responde).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "variants": {
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "wait_days": {
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "wait_days",
      "variants"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "variants": {
        "items": {
         "type": "string"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "variants"
      ],
      "type": "object"
     }
    ],
    "description": "Texto del DM inicial, o {variants:[...]} para rotaci\u00f3n A/B/C. Soporta {{variables}}."
   },
   "name": {
    "type": "string"
   },
   "settings": {
    "additionalProperties": false,
    "properties": {
     "daily_limit_per_sender": {
      "type": "integer"
     },
     "dedupe_across_campaigns": {
      "type": "boolean"
     },
     "rate_limit_seconds": {
      "maximum": 300,
      "minimum": 3,
      "type": "integer"
     },
     "sender_ids": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sender_pool": {
      "type": "boolean"
     },
     "stop_on_reply": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "targets": {
    "description": "Destinatarios iniciales (tambi\u00e9n con add_targets).",
    "items": {
     "anyOf": [
      {
       "description": "@username de TikTok",
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "username": {
         "type": "string"
        },
        "variables": {
         "additionalProperties": {
          "type": "string"
         },
         "description": "Variables de personalizaci\u00f3n ({{first_name}}\u2026).",
         "type": "object"
        }
       },
       "required": [
        "username"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 1000,
    "type": "array"
   }
  },
  "required": [
   "name",
   "message"
  ],
  "type": "object"
 },
 "name": "create_campaign",
 "title": "Crear campa\u00f1a"
}

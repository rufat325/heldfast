{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a structured work handoff between exact native sessions. The durable record keeps every field; the bounded delivery packet preserves deterministic continuation state and explicit omissions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "acceptanceCriteria": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "assumptions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "authorityBoundaries": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "changedFiles": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "continuationState": {
    "enum": [
     "not_started",
     "in_progress",
     "needs_completion",
     "likely_complete",
     "existing_behavior_broken"
    ],
    "type": "string"
   },
   "destinationSession": {
    "type": "string"
   },
   "evidenceIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "latestValidation": {
    "properties": {
     "command": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "observedAt": {
      "type": "string"
     },
     "outcome": {
      "enum": [
       "passed",
       "failed",
       "unknown"
      ],
      "type": "string"
     }
    },
    "required": [
     "outcome"
    ],
    "type": "object"
   },
   "nextAction": {
    "type": "string"
   },
   "objective": {
    "type": "string"
   },
   "repositoryRevision": {
    "type": "string"
   },
   "risks": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rollbackNotes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sourceSession": {
    "type": "string"
   },
   "unresolvedQuestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workId": {
    "type": "string"
   }
  },
  "required": [
   "workId",
   "sourceSession",
   "objective",
   "acceptanceCriteria",
   "evidenceIds",
   "changedFiles",
   "risks",
   "unresolvedQuestions",
   "authorityBoundaries"
  ],
  "type": "object"
 },
 "name": "handoff_create"
}

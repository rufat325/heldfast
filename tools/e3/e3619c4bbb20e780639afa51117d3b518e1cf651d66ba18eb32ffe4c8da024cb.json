{
 "description": "Switch the simulator between light and dark mode.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "mode": {
    "description": "Appearance mode",
    "enum": [
     "light",
     "dark"
    ],
    "type": "string"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "simulator_set_appearance"
}

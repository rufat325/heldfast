{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Replace all rules of a firewall with a new set of rules.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Resource ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "rules": {
    "description": "New set of firewall rules (replaces all existing)",
    "items": {
     "properties": {
      "description": {
       "description": "Description of the rule",
       "type": "string"
      },
      "destination_ips": {
       "description": "CIDR destination IPs (required for direction \"out\")",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "direction": {
       "description": "Direction of traffic: in or out",
       "enum": [
        "in",
        "out"
       ],
       "type": "string"
      },
      "port": {
       "description": "Port or port range (e.g. \"80\" or \"1-1024\"), required for tcp/udp",
       "type": "string"
      },
      "protocol": {
       "description": "Network protocol",
       "enum": [
        "tcp",
        "udp",
        "icmp",
        "esp",
        "gre"
       ],
       "type": "string"
      },
      "source_ips": {
       "description": "CIDR source IPs (required for direction \"in\")",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "direction",
      "protocol"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "rules"
  ],
  "type": "object"
 },
 "name": "hetzner_set_firewall_rules",
 "title": "Set Firewall Rules"
}

{
 "description": "Log architectural/operational decision to institutional memory",
 "inputSchema": {
  "properties": {
   "alternatives_considered": {
    "description": "Alternatives that were rejected",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "decision": {
    "description": "What was decided",
    "type": "string"
   },
   "docs_affected": {
    "description": "Docs/files affected by this decision (relative paths from repo root)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "linear_issue": {
    "description": "Associated Linear issue",
    "type": "string"
   },
   "personas_involved": {
    "description": "Personas involved in decision",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "project": {
    "description": "Project namespace (e.g., 'my-project'). Scopes sessions and searches.",
    "type": "string"
   },
   "rationale": {
    "description": "Why this decision was made",
    "type": "string"
   },
   "session_id": {
    "description": "Current session ID",
    "type": "string"
   },
   "title": {
    "description": "Decision title",
    "type": "string"
   }
  },
  "required": [
   "title",
   "decision",
   "rationale"
  ],
  "type": "object"
 },
 "name": "create_decision"
}

{
 "description": "Creates a new identity in the workspace. Identities capture voice, tone, role, and audience context so AI produces work from the right perspective.",
 "inputSchema": {
  "properties": {
   "alwaysDo": {
    "description": "Things to always do.",
    "type": "string"
   },
   "audience": {
    "description": "Intended audience.",
    "type": "string"
   },
   "background": {
    "description": "Background information.",
    "type": "string"
   },
   "brandColors": {
    "description": "Brand colours.",
    "type": "string"
   },
   "brandVisuals": {
    "description": "Visual style description.",
    "type": "string"
   },
   "linkedLibraryIds": {
    "description": "Context library IDs to link.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Identity name (required).",
    "type": "string"
   },
   "neverDo": {
    "description": "Things to never do.",
    "type": "string"
   },
   "recurringTopics": {
    "description": "Recurring topics.",
    "type": "string"
   },
   "roleContext": {
    "description": "Role and context description.",
    "type": "string"
   },
   "scope": {
    "description": "user: personal; workspace: shared. Defaults to user.",
    "enum": [
     "user",
     "workspace"
    ],
    "type": "string"
   },
   "type": {
    "description": "Identity type. Defaults to person.",
    "enum": [
     "person",
     "company",
     "hybrid"
    ],
    "type": "string"
   },
   "valuesPriorities": {
    "description": "Values and priorities.",
    "type": "string"
   },
   "voiceDescriptors": {
    "description": "Voice and tone descriptors (e.g. \"concise, direct, warm\").",
    "type": "string"
   },
   "workspaceId": {
    "description": "Workspace ID. If not provided, uses your default workspace.",
    "type": "string"
   },
   "writingSamples": {
    "description": "Writing samples.",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_identity"
}

{
 "description": "Resolve incidents in bulk by incident id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "incidentIds": {
    "items": {
     "type": "string"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "source": {
    "enum": [
     "local",
     "cloud"
    ],
    "type": "string"
   }
  },
  "required": [
   "incidentIds"
  ],
  "type": "object"
 },
 "name": "resolve_incidents"
}

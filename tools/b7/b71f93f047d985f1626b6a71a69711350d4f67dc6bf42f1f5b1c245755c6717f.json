{
 "description": "Compare normalized robots, sitemap, canonical, title, and structured-data evidence across two dated site snapshots. Costs $0.25 USDC on Base mainnet.",
 "inputSchema": {
  "$defs": {
   "snapshot": {
    "additionalProperties": false,
    "properties": {
     "canonical": {
      "type": "string"
     },
     "captured_at": {
      "format": "date-time",
      "type": "string"
     },
     "robots_text": {
      "maxLength": 32768,
      "type": "string"
     },
     "schema_types": {
      "items": {
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "sitemap_urls": {
      "items": {
       "type": "string"
      },
      "maxItems": 5000,
      "type": "array"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "captured_at",
     "url",
     "robots_text",
     "sitemap_urls",
     "canonical",
     "schema_types"
    ],
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "baseline": {
    "$ref": "#/$defs/snapshot"
   },
   "current": {
    "$ref": "#/$defs/snapshot"
   }
  },
  "required": [
   "baseline",
   "current"
  ],
  "type": "object"
 },
 "name": "justhandled_site_discovery_change_packet"
}

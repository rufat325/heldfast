{
 "annotations": {
  "idempotentHint": false,
  "readOnlyHint": false,
  "title": "Upload Editor Media"
 },
 "description": "Upload an image, video, or audio file directly into your real Switch Editor project. First call with presign=true, PUT the bytes to upload_url, then confirm_path in a second call; no browser file picker is needed.",
 "inputSchema": {
  "properties": {
   "confirm_path": {
    "type": "string"
   },
   "duration_seconds": {
    "type": "number"
   },
   "file_size": {
    "description": "Bytes; required for presign.",
    "type": "integer"
   },
   "filename": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "image",
     "video",
     "audio"
    ],
    "type": "string"
   },
   "mime": {
    "type": "string"
   },
   "presign": {
    "type": "boolean"
   },
   "project_id": {
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "kind"
  ],
  "type": "object"
 },
 "name": "upload_editor_media",
 "title": "Upload Editor Media"
}

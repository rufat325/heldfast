        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "confirmationProofs": {
       "description": "What proves employerConfirmed: \"receipt\" and/or \"screenshot\".",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "createdAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "employerConfirmed": {
       "description": "True ONLY when the employer sent a receipt or showed its confirmation page.",
       "type": "boolean"
      },
      "jobMatchId": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "jobTitle": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "jobUrl": {
       "type": "string"
      },
      "status": {
       "description": "Our own record of the application. Never proof the employer received it; see employerConfirmed.",
       "type": "string"
      },
      "trackingUrl": {
       "type": "string"
      },
      "waitingForReview": {
       "description": "True when the application waits for the user's approval.",
       "type": "boolean"
      }
     },
     "required": [
      "applicationId",
      "jobMatchId",
      "jobTitle",
      "company",
      "jobUrl",
      "status",
      "applyMode",
      "waitingForReview",
      "employerConfirmed",
      "confirmationProofs",
      "createdAt",
      "appliedAt",
      "trackingUrl"
     ],
     "type": "object"
    },
    "type": "array"

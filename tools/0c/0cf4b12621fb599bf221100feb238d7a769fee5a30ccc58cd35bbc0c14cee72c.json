{
 "description": "List posts of any custom post type",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "order": {
    "default": "DESC",
    "description": "Sort direction",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "orderby": {
    "default": "date",
    "description": "Order by field",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "number"
   },
   "per_page": {
    "default": 20,
    "description": "Posts per page",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "default": "any",
    "description": "Post status filter",
    "type": "string"
   },
   "type": {
    "description": "Post type name",
    "type": "string"
   }
  },
  "required": [
   "site",
   "type"
  ],
  "type": "object"
 },
 "name": "mcp_list_cpt_posts"
}

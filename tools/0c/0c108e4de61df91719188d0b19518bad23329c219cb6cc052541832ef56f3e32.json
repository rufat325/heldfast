{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Device Info"
 },
 "description": "Get detailed info about a device: model, Android version, screen size, SDK level, battery level",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "serial": {
    "description": "Device serial number. If omitted, uses the only connected device.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "device_info",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "androidVersion": {
    "description": "Android release version",
    "type": [
     "string",
     "null"
    ]
   },
   "batteryLevel": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Battery level percentage"
   },
   "brand": {
    "description": "Device brand",
    "type": [
     "string",
     "null"
    ]
   },
   "manufacturer": {
    "description": "Device manufacturer",
    "type": [
     "string",
     "null"
    ]
   },
   "model": {
    "description": "Device model",
    "type": [
     "string",
     "null"
    ]
   },
   "screenHeight": {
    "description": "Screen height in pixels",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "screenWidth": {
    "description": "Screen width in pixels",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sdkLevel": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Android SDK API level"
   },
   "serial": {
    "description": "Resolved device serial",
    "type": "string"
   }
  },
  "required": [
   "serial",
   "model",
   "brand",
   "manufacturer",
   "androidVersion",
   "sdkLevel",
   "screenWidth",
   "screenHeight",
   "batteryLevel"
  ],
  "type": "object"
 }
}

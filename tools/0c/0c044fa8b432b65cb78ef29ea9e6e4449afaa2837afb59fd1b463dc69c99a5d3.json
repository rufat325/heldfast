{
 "description": "Find prompts for a task, with optional category, persona, and tag filters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "type": "string"
   },
   "include_prompt_text": {
    "default": false,
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "persona": {
    "type": "string"
   },
   "query": {
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "tag": {
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_prompts"
}

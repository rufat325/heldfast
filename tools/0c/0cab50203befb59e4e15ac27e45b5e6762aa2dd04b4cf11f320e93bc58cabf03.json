{
 "description": "Items dated in the future (releases, launches, deadlines), soonest first.",
 "inputSchema": {
  "properties": {
   "bbox": {
    "description": "west,south,east,north; west > east crosses the antimeridian",
    "type": "string"
   },
   "collection": {
    "description": "Collection slug",
    "type": "string"
   },
   "days": {
    "description": "Horizon, default 30",
    "type": "integer"
   },
   "lat": {
    "description": "Query center latitude; requires long",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "description": "Default 50",
    "type": "integer"
   },
   "long": {
    "description": "Query center longitude; requires lat",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "radius": {
    "description": "Default 10; maximum 1000 km",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "sort": {
    "enum": [
     "id",
     "published",
     "updated",
     "distance"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Default km",
    "enum": [
     "km",
     "mi"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "upcoming"
}

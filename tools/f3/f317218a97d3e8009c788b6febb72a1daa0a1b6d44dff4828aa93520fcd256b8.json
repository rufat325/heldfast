{
 "description": "Return up to `limit` rows from a table (SELECT * \u2026 LIMIT).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "connection": {
    "description": "Configured connection name (see list_connections)",
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "schema": {
    "type": "string"
   },
   "table": {
    "type": "string"
   }
  },
  "required": [
   "connection",
   "table"
  ],
  "type": "object"
 },
 "name": "sample_table",
 "title": "Sample table"
}

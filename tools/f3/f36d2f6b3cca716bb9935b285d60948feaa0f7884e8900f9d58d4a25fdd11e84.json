{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get SEC Form 144 filings \u2014 notices of proposed sale of restricted/controlled securities by insiders. Filed before selling, these signal upcoming insider sales. Complements Form 4 (post-trade) with pre-trade intent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "insider_cik": {
    "description": "Filter by insider's CIK number",
    "maxLength": 200,
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max notices to return",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "ticker": {
    "description": "Filter by stock ticker (e.g. 'AAPL')",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_form144_notices",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "properties": {
     "insider_cik": {
      "$ref": "#/properties/filters/properties/ticker"
     },
     "ticker": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "ticker",
     "insider_cik"
    ],
    "type": "object"
   },
   "paging": {
    "additionalProperties": false,
    "description": "Paging state reconciled from ko.io meta.total_count and meta.softwall",
    "properties": {
     "continuation": {
      "description": "SIGNIN_REQUIRED = page>1 needs a (free) ko.io API key",
      "type": [
       "string",
       "null"
      ]
     },
     "has_more": {
      "description": "null = a full page came back and more MAY exist",
      "type": [
       "boolean",
       "null"
      ]
     },
     "next_page": {
      "anyOf": [
       {
        "$ref": "#/properties/paging/properties/total_count/anyOf/0"
       },
       {
        "type": "null"
       }
      ],
      "description": "Next page THIS caller can open; null when there is none (or sign-in is required)"
     },
     "page": {
      "type": "integer"
     },
     "per_page": {
      "type": "integer"
     },
     "plan_row_cap": {
      "anyOf": [
       {
        "$ref": "#/properties/paging/properties/total_count/anyOf/0"
       },
       {
        "type": "null"
       }
      ],
      "description": "Row cap the caller's plan applied to this page, if any"
     },
     "returned": {
      "type": "integer"
     },
     "total_count": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Total rows matching the request, when ko.io reported it"
     },
     "truncated_by_plan": {
      "description": "True when the plan's row cap withheld rows from this page",
      "type": "boolean"
     }
    },
    "required": [
     "page",
     "per_page",
     "returned",
     "total_count",
     "has_more",
     "next_page",
     "continuation",
     "plan_row_cap",
     "truncated_by_plan"
    ],
    "type": "object"
   },
   "plan_limit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "continuation": {
        "$ref": "#/properties/filters/properties/ticker"
       },
       "date_basis": {
        "$ref": "#/properties/filters/properties/ticker"
       },
       "effective_period": {
        "$ref": "#/properties/filters/properties/ticker"
       },
       "policy_version": {
        "$ref": "#/properties/filters/properties/ticker"
       },
       "row_cap": {
        "anyOf": [
         {
          "$ref": "#/properties/paging/properties/total_count/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "truncated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "window_end": {
        "$ref": "#/properties/filters/properties/ticker"
       },
       "window_start": {
        "$ref": "#/properties/filters/properties/ticker"
       }
      },
      "required": [
       "policy_version",
       "window_start",
       "window_end",
       "effective_period",
       "date_basis",
       "row_cap",
       "truncated",
       "continuation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The Free/keyless plan limits ko.io applied to this answer (null for paid callers)"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accession_no": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "aggregate_market_value": {
       "anyOf": [
        {
         "$ref": "#/properties/rows/items/properties/units_to_sell/anyOf/0"
        },
        {
         "type": "null"
        }
       ],
       "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
      },
      "approx_sale_date": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "broker_name": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "filed_date": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "has_10b5_1_plan": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "issuer_cik": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "issuer_name": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "issuer_ticker": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "relationship": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "securities_class": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "seller_name": {
       "$ref": "#/properties/filters/properties/ticker"
      },
      "units_to_sell": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Units the filer NOTIFIED an intent to sell -- not a completed sale"
      }
     },
     "required": [
      "accession_no",
      "filed_date",
      "issuer_ticker",
      "issuer_name",
      "issuer_cik",
      "seller_name",
      "relationship",
      "securities_class",
      "units_to_sell",
      "aggregate_market_value",
      "approx_sale_date",
      "broker_name",
      "has_10b5_1_plan"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "filters",
   "rows",
   "paging",
   "plan_limit"
  ],
  "type": "object"
 }
}

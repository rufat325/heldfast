{
 "description": "List media library items",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "media_type": {
    "description": "Filter by type",
    "enum": [
     "image",
     "video",
     "audio",
     "application"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "number"
   },
   "per_page": {
    "default": 20,
    "description": "Items per page (max 100)",
    "type": "number"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_media"
}

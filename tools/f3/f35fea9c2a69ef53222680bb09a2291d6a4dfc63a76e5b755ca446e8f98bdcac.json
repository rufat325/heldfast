{
 "description": "Read a structured Granoflow work-memory context pack for the current agent task. Returns typed facts and match signals, not planning hints or recommendations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client": {
    "default": "mcp",
    "minLength": 1,
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "When true, previews the request without calling the app.",
    "type": "boolean"
   },
   "limit": {
    "default": 12,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "minLength": 1,
    "type": "string"
   },
   "repo": {
    "minLength": 1,
    "type": "string"
   },
   "scope": {
    "default": "repo",
    "enum": [
     "task",
     "project",
     "repo"
    ],
    "type": "string"
   },
   "taskId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "granoflow_context_pack"
}

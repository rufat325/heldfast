{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Project"
 },
 "description": "Create a production project on a live event \u2014 the container for tasks, roles, vendors, and budget. Name, description, category, priority, status, deliverable, dates. Requires event_id + name; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category": {
    "maxLength": 80,
    "type": "string"
   },
   "deliverable": {
    "maxLength": 1000,
    "type": "string"
   },
   "description": {
    "maxLength": 4000,
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "maxLength": 4000,
    "type": "string"
   },
   "overall_status": {
    "enum": [
     "not_started",
     "on_hold",
     "blocked",
     "complete",
     "cancelled"
    ],
    "type": "string"
   },
   "priority": {
    "enum": [
     "explore",
     "low",
     "medium",
     "high",
     "urgent"
    ],
    "type": "string"
   },
   "start_date": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "target_date": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "name"
  ],
  "type": "object"
 },
 "name": "add_project",
 "title": "Add Project"
}

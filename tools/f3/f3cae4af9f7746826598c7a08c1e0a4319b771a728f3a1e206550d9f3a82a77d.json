{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Active promotions that apply to one SKU (discounts, free gifts, end dates).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "description": "Storefront locale such as en-GB (default), en-US, de, fr-FR, es-ES, it-IT, nl-NL, pl. Controls product names, slugs and prices.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   },
   "sku": {
    "description": "Product SKU exactly as shown on the site.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sku"
  ],
  "type": "object"
 },
 "name": "get_product_promotions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "promotions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "brands": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "discount_value": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Percent or amount off, depending on type."
      },
      "ends_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "free_gift": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "name": {
           "type": "string"
          },
          "sku": {
           "type": "string"
          }
         },
         "required": [
          "sku",
          "name"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "scope": {
       "type": "string"
      },
      "terms_url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "type": {
       "description": "percentage_discount, fixed_discount or free_gift.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "description",
      "type",
      "discount_value",
      "ends_at",
      "scope",
      "brands",
      "free_gift",
      "terms_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sku": {
    "type": "string"
   }
  },
  "required": [
   "sku",
   "promotions"
  ],
  "type": "object"
 },
 "title": "Get product promotions"
}

   "count": {
    "default": 5,
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "expr": {
    "description": "e.g. \"*/15 9-17 * * 1-5\"",
    "type": "string"
   },
   "tz": {
    "description": "IANA timezone, e.g. \"Europe/Madrid\"",
    "type": "string"
   }
  },
  "required": [
   "expr"
  ],
  "type": "object"
 },
 "name": "cron_next"
}

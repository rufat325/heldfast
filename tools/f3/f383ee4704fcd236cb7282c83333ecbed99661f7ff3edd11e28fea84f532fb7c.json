    "type": "number"
   },
   "children": {
    "description": "Number of children",
    "type": "number"
   },
   "collegeFund": {
    "description": "College fund per child",
    "type": "number"
   },
   "debt": {
    "description": "Outstanding debt (excluding mortgage)",
    "type": "number"
   },
   "mortgage": {
    "description": "Mortgage balance",
    "type": "number"
   },
   "savings": {
    "description": "Existing savings/insurance",
    "type": "number"
   },
   "yearsToReplace": {
    "description": "Years to replace income (default 10)",
    "type": "number"
   }
  },
  "required": [

{
 "description": "Create a new audit session or resume an existing one by title. Call this at the start of every conversation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ai_tool": {
    "description": "AI tool name: \"claude\", \"cursor\", \"windsurf\", etc.",
    "type": "string"
   },
   "external_ref": {
    "description": "External ticket/PR reference, e.g. \"jira:ENG-123\"",
    "type": "string"
   },
   "parent_session_id": {
    "description": "Parent session ID if this is a subagent session",
    "type": "string"
   },
   "title": {
    "description": "Descriptive session title, e.g. \"Contract review \u2014 2026-05-08\"",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "start_session"
}

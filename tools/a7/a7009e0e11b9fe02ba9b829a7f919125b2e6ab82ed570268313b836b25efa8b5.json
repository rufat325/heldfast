{
 "description": "Query on-chain events by type, sender, package, module, or transaction digest.",
 "inputSchema": {
  "properties": {
   "filter": {
    "description": "Event filter. Examples: { \"MoveEventType\": \"0x2::coin::CoinEvent\" }, { \"Sender\": \"0x...\" }, { \"Package\": \"0x2\" }, { \"Transaction\": \"digest...\" }",
    "type": "object"
   },
   "limit": {
    "description": "Max events (default: 50)",
    "type": "number"
   },
   "order": {
    "description": "Sort order (default: descending)",
    "enum": [
     "ascending",
     "descending"
    ],
    "type": "string"
   }
  },
  "required": [
   "filter"
  ],
  "type": "object"
 },
 "name": "query_events"
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Queue a ByteDance upscale of one stored video asset to 1080p or 4k. Call media_upscale_estimate first. Spends AI credits and returns a new pending media asset to poll with media_assets_get.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "description": "Source video asset UUID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "type": "string"
   },
   "projectId": {
    "description": "Optional project UUID to attach the credit spend. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "targetResolution": {
    "description": "Output long-edge target.",
    "enum": [
     "1080p",
     "4k"
    ],
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "assetId",
   "targetResolution"
  ],
  "type": "object"
 },
 "name": "media_upscale",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "type": "string"
   },
   "creditsRequired": {
    "type": "number"
   },
   "mutationReceipt": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ]
     },
     "operation": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "key",
     "operation",
     "status",
     "replayed"
    ],
    "type": "object"
   },
   "runId": {
    "type": "string"
   },
   "sourceAssetId": {
    "type": "string"
   },
   "status": {
    "enum": [
     "queued"
    ],
    "type": "string"
   },
   "targetResolution": {
    "enum": [
     "1080p",
     "4k"
    ],
    "type": "string"
   }
  },
  "required": [
   "assetId",
   "sourceAssetId",
   "targetResolution",
   "creditsRequired",
   "runId",
   "status",
   "mutationReceipt"
  ],
  "type": "object"
 },
 "title": "Upscale Video"
}

{
 "description": "Stop a log capture session and return the file path plus the last lines.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "sessionId": {
    "description": "Session id from start_log_capture",
    "type": "string"
   },
   "tailLines": {
    "description": "Lines of tail to inline (default 60)",
    "type": "integer"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "stop_log_capture",
 "title": "Stop log capture"
}

    "cik": "320193",
    "tag": "Revenue",
    "taxonomy": "us-gaap"
   },
   {
    "cik": "789019",
    "tag": "NetIncomeLoss",
    "taxonomy": "us-gaap"
   }
  ],
  "properties": {
   "cik": {

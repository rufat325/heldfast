{
 "description": "Write a draft fact under kasa/_oneriler/ (or quarantine). Secret patterns are rejected before any write; the matching text is never returned. type=boundary is always quarantined. Fake mcp:// sources are not injected.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent": {
    "description": "authorization agent id",
    "type": "string"
   },
   "body": {
    "type": "string"
   },
   "source": {
    "description": "real evidence; if omitted, kaynak is written empty \u2014 mcp:// is not injected",
    "items": {
     "properties": {
      "inherited": {
       "type": "boolean"
      },
      "pointer": {
       "type": "string"
      },
      "taken": {
       "type": "string"
      },
      "type": {
       "enum": [
        "sql",
        "file",
        "mail",
        "measurement",
        "human",
        "web",
        "clipboard",
        "window"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "pointer"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "topic": {
    "type": "string"
   },
   "type": {
    "description": "stored as tur; boundary is always quarantined",
    "enum": [
     "fact",
     "decision",
     "rule",
     "observation",
     "boundary"
    ],
    "type": "string"
   },
   "world": {
    "type": "string"
   }
  },
  "required": [
   "title",
   "body",
   "agent"
  ],
  "type": "object"
 },
 "name": "fact_propose"
}

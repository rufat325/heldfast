     {
      "from": "sender@example.com",
      "subject": "Batch email 1",
      "textbody": "Hello user 1",
      "to": "user1@example.com"
     },
     {
      "from": "sender@example.com",
      "subject": "Batch email 2",
      "textbody": "Hello user 2",
      "to": "user2@example.com"
     }
    ]
   }
  ],
  "properties": {

{
 "description": "Create a new workflow. Put the WORKFLOW NAME in the \"name\" parameter.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Workflow name (REQUIRED)",
    "type": "string"
   },
   "steps": {
    "description": "Workflow steps definition",
    "type": "string"
   },
   "type": {
    "default": "custom",
    "description": "Workflow type (default: custom)",
    "enum": [
     "code-review",
     "brainstorm",
     "debug",
     "research",
     "custom"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_workflow"
}

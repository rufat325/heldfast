{
 "description": "Read a file from a remote server. Returns the file contents with line numbers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max lines to return",
    "maximum": 999999,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Start at line N (1-based)",
    "maximum": 999999,
    "minimum": 1,
    "type": "integer"
   },
   "path": {
    "description": "Absolute path on the server (e.g. /root/project/src/app.ts)",
    "type": "string"
   },
   "server": {
    "description": "Server name (auto-selects if only one is running)",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "vm_read"
}

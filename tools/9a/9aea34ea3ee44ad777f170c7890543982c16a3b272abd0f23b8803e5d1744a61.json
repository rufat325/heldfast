{
 "description": "Find free time slots on a given day. Useful for meeting planning \u2014 returns available slots with minimum duration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calendarId": {
    "description": "Calendar ID (default: primary)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "date": {
    "description": "Date to check (YYYY-MM-DD)",
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   },
   "durationMinutes": {
    "description": "Minimum slot duration in minutes (default: 30)",
    "maximum": 480,
    "minimum": 15,
    "type": "number"
   },
   "endHour": {
    "description": "Business day end hour (default: 18)",
    "maximum": 24,
    "minimum": 1,
    "type": "number"
   },
   "startHour": {
    "description": "Business day start hour (default: 9)",
    "maximum": 23,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "date"
  ],
  "type": "object"
 },
 "name": "calendar_check_availability"
}

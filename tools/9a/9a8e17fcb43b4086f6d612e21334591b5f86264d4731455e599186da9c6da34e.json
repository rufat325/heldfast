  "title": "YNAB: Update Multiple Transactions"
 },
 "description": "Update 1\u2013100 transactions in a single batch with dry-run preview.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - transactions (array, required): Up to 100 objects, each requires id plus fields to update. Amount updates use one of amount_decimal (preferred), amount_milliunits, or deprecated amount.\n  - dry_run (boolean, optional): Preview changes without saving. Default: false.\n\nReturns: summary (updated, failed), results[], transactions[].\n\nExamples:\n  - Dry run: set dry_run=true to preview before/after for first 10 items\n\nWrite safety: call without confirmation_token to preview. Execute the identical validated request with the short-lived confirmation_token returned by that preview.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "confirmation_token": {
    "description": "Short-lived, single-use token returned by the immediately preceding preview of this exact validated request.",
    "minLength": 16,
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   },
   "transactions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "Deprecated legacy alias for amount_milliunits. Use amount_decimal for currency input or amount_milliunits for raw YNAB values.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "amount_decimal": {
       "description": "Preferred: amount in decimal currency units (for example, -12.34). Rounded exactly to the nearest YNAB milliunit.",
       "type": "number"
      },
      "amount_milliunits": {
       "description": "Raw YNAB milliunits. Use only when the value is already converted.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "approved": {
       "type": "boolean"
      },
      "category_id": {
       "type": "string"
      },
      "cleared": {
       "enum": [
        "cleared",
        "uncleared",
        "reconciled"
       ],
       "type": "string"
      },
      "date": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "flag_color": {
       "enum": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple"
       ],
       "type": "string"
      },
      "id": {
       "minLength": 1,
       "type": "string"
      },
      "memo": {
       "type": "string"
      },
      "original_account_id": {
       "type": "string"
      },
      "original_date": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "payee_id": {
       "type": "string"
      },
      "payee_name": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "transactions"
  ],
  "type": "object"
 },

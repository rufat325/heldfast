    },
    "maxItems": 12,
    "type": "array"
   },
   "limit": {
    "default": 8,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "summary": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "summary"
  ],
  "type": "object"
 },
 "name": "granoflow_review_card_similar"
}

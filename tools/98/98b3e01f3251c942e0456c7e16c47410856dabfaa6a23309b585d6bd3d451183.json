    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Annualise la consommation et/ou le total TTC d'une p\u00e9riode avec les coefficients officiels du profil Enedis correspondant au segment, \u00e0 l'option et \u00e0 la puissance. Si les coefficients sont indisponibles, le repli lin\u00e9aire est explicite et born\u00e9 pour les kWh.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "period_kwh"
    ]
   },
   {
    "required": [
     "period_total_ttc_eur"
    ]
   }
  ],
  "properties": {
   "option": {
    "enum": [
     "base",
     "hp_hc",
     "tempo"
    ],
    "type": "string"
   },
   "period_end": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "period_kwh": {
    "minimum": 0,
    "type": "number"
   },
   "period_start": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "period_total_ttc_eur": {
    "minimum": 0,
    "type": "number"
   },
   "puissance_kva": {
    "exclusiveMinimum": 0,
    "maximum": 250,
    "type": "number"
   },
   "segment": {
    "enum": [
     "residentiel",
     "pro_bt36",
     "pro_bt36plus"
    ],
    "type": "string"
   }
  },
  "required": [
   "period_start",
   "period_end",
   "segment",
   "puissance_kva"
  ],
  "type": "object"
 },
 "name": "annualize_invoice",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Annualiser une facture"
}

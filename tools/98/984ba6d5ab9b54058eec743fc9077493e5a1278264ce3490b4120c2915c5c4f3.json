{
 "description": "Settle / record payment (baixa) for an AP title in Omie ERP",
 "inputSchema": {
  "properties": {
   "codigo_baixa": {
    "description": "Settlement integration code (unique)",
    "type": "string"
   },
   "codigo_conta_corrente": {
    "description": "Bank account ID used for the payment",
    "type": "number"
   },
   "codigo_lancamento": {
    "description": "Omie AP title ID",
    "type": "number"
   },
   "codigo_lancamento_integracao": {
    "description": "Integration code (alternative to codigo_lancamento)",

    "type": "string"
   },
   "observacao": {
    "description": "Payment notes",
    "type": "string"
   },
   "valor": {
    "description": "Paid amount in BRL",
    "type": "number"
   }
  },
  "required": [
   "codigo_baixa",
   "valor",
   "data",
   "codigo_conta_corrente"
  ],
  "type": "object"
 },
 "name": "pay_account_payable"
}

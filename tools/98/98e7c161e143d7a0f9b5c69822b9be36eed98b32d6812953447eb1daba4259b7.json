    "enum": [
     "create",
     "project_update",
     "show",
     "search",
     "record",
     "record_batch",
     "get",
     "get_batch",
     "context",
     "timeline",
     "diff",
     "sync",
     "job_status",
     "job_wait",
     "job_cancel",
     "query_status",
     "query_cancel",
     "verify",
     "current",

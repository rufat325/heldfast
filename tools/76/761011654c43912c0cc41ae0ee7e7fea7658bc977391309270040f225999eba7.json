{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Turn a DDL into classes in your language: Java/JPA, TypeScript, Python (SQLAlchemy 2.0), C#/EF Core or Go. Types are respected \u2014 `numeric` becomes BigDecimal/decimal, never a double \u2014 and so is which fields are optional.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ddl": {
    "description": "CREATE TABLE\u2026 (PostgreSQL)",
    "type": "string"
   },
   "namespace": {
    "description": "Package (Java) or namespace (C#)",
    "type": "string"
   },
   "target": {
    "description": "Target language",
    "enum": [
     "java",
     "typescript",
     "python",
     "csharp",
     "go"
    ],
    "type": "string"
   }
  },
  "required": [
   "ddl",
   "target"
  ],
  "type": "object"
 },
 "name": "db_entities",
 "title": "Generate code entities from a schema"
}

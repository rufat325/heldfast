{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Capture a reusable learning/pattern to learnings.json. Called after key decisions, verdicts, and pipeline milestones.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applies_to": {
    "description": "What future decisions this informs",
    "type": "string"
   },
   "category": {
    "description": "Learning category",
    "enum": [
     "market_selection",
     "offer_design",
     "creative",
     "traffic",
     "funnel",
     "product",
     "scaling",
     "process",
     "distribution",
     "relationship_marketing"
    ],
    "type": "string"
   },
   "confidence": {
    "description": "Confidence level based on evidence strength",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "evidence": {
    "description": "What data supports this pattern",
    "type": "string"
   },
   "pattern": {
    "description": "One sentence \u2014 the reusable insight",
    "type": "string"
   },
   "pipeline": {
    "description": "Market name / pipeline that produced this learning",
    "type": "string"
   },
   "stage": {
    "description": "Which SOP/stage generated this learning (e.g. 'scout', 'stress-test')",
    "type": "string"
   },
   "tags": {
    "description": "Searchable keywords for retrieval",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "pipeline",
   "stage",
   "category",
   "pattern",
   "evidence",
   "confidence",
   "applies_to",
   "tags"
  ],
  "type": "object"
 },
 "name": "capture_learning"
}

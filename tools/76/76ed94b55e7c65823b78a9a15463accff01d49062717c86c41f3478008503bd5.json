{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get menu for a day"
 },
 "description": "Get the orderable menu for one student on one date \u2014 the vendor, items, sizes, add-ons, prices and the ordering deadline. This is the read half of placing an order.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "description": "The lunch date (YYYY-MM-DD).",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "studentId": {
    "description": "Student id from mhlb_list_students.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "studentId",
   "date"
  ],
  "type": "object"
 },
 "name": "mhlb_get_menu"
}

{
 "description": "Google News results. Query or browse via topic/story/publication token. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "gl": {
    "description": "Country, e.g. 'us'.",
    "type": "string"
   },
   "google_domain": {
    "description": "e.g. 'google.co.uk'.",
    "type": "string"
   },
   "hl": {
    "description": "Language, e.g. 'en'.",
    "type": "string"
   },
   "kgmid": {
    "description": "Knowledge Graph entity id.",
    "type": "string"
   },
   "publication_token": {
    "description": "Publication token.",
    "type": "string"
   },
   "query": {
    "description": "Keyword search.",
    "type": "string"
   },
   "section_token": {
    "description": "Section token.",
    "type": "string"
   },
   "so": {
    "description": "0=relevance, 1=date.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "story_token": {
    "description": "Story token.",
    "type": "string"
   },
   "topic_token": {
    "description": "Topic token.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "google_news"
}

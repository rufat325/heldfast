{
 "description": "Run a Volatility 2 Linux plugin against a memory dump. Returns plugin, profile, success, output, and errors. Read-only analysis. Requires volatility2 (vol.py) on PATH.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dump_path": {
    "description": "Path to the Linux memory dump file",
    "type": "string"
   },
   "plugin": {
    "description": "Volatility 2 Linux plugin to run",
    "enum": [
     "linux_banner",
     "linux_bash",
     "linux_pslist",
     "linux_pstree",
     "linux_netstat",
     "linux_enumerate_files",
     "linux_check_syscall",
     "linux_hidden_modules",
     "linux_lsmod",
     "linux_mount",
     "linux_ifconfig",
     "linux_route_cache"
    ],
    "type": "string"
   },
   "profile": {
    "description": "Volatility 2 profile name, e.g. 'LinuxCentOS7_7_1908x64'",
    "type": "string"
   }
  },
  "required": [
   "dump_path",
   "profile",
   "plugin"
  ],
  "type": "object"
 },
 "name": "volatility_linux"
}

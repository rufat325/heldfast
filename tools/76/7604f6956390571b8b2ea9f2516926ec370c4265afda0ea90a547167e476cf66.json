{
 "description": "Update an existing Code Engine application (image, scaling, etc.)",
 "inputSchema": {
  "properties": {
   "app_name": {
    "type": "string"
   },
   "image": {
    "description": "New container image reference",
    "type": "string"
   },
   "image_secret": {
    "description": "Registry secret name for pulling the image",
    "type": "string"
   },
   "project_id": {
    "type": "string"
   },
   "run_args": {
    "description": "Arguments passed to the container entrypoint (run_arguments)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "run_commands": {
    "description": "Override the container entrypoint (run_commands)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scale_cpu_limit": {
    "type": "string"
   },
   "scale_max_instances": {
    "type": "number"
   },
   "scale_memory_limit": {
    "type": "string"
   },
   "scale_min_instances": {
    "type": "number"
   }
  },
  "required": [
   "project_id",
   "app_name"
  ],
  "type": "object"
 },
 "name": "ce_update_application"
}

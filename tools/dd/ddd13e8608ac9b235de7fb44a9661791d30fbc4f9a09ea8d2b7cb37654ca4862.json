{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Show/hide axis-aligned bounding boxes for scene objects. Runtime only \u2014 for debugging frustum culling and object bounds.\n\nDebug only \u2014 page reload will reset. No code changes needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clear": {
    "description": "Remove all bounding boxes",
    "type": "boolean"
   },
   "color": {
    "description": "Box color as hex (default: 0x00ff00)",
    "type": "number"
   },
   "enabled": {
    "description": "true=show (default), false=remove all",
    "type": "boolean"
   },
   "limit": {
    "description": "Max boxes to add (default: 50)",
    "type": "number"
   },
   "name": {
    "description": "Target object name (omit for all meshes)",
    "type": "string"
   },
   "onlyVisible": {
    "description": "Only visible objects (default: true)",
    "type": "boolean"
   },
   "recursive": {
    "description": "Include children of target",
    "type": "boolean"
   },
   "uuid": {
    "description": "Target object UUID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "bounding_boxes"
}

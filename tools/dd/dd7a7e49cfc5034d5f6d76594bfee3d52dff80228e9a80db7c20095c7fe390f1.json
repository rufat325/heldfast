{
 "description": "Reply to an email by UID. Automatically sets In-Reply-To, References headers, and \"Re:\" subject prefix. Get UIDs from email_list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "attachments": {
    "description": "File attachments",
    "items": {
     "properties": {
      "filename": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "folder": {
    "description": "Folder where the original email is (default: INBOX)",
    "type": "string"
   },
   "html": {
    "description": "Reply HTML body",
    "type": "string"
   },
   "text": {
    "description": "Reply text",
    "type": "string"
   },
   "uid": {
    "description": "UID of the email to reply to (from email_list)",
    "type": "number"
   }
  },
  "required": [
   "uid",
   "text"
  ],
  "type": "object"
 },
 "name": "email_reply"
}

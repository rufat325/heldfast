{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Full-text search the official Japanese Diet proceedings archive (\u56fd\u4f1a\u4f1a\u8b70\u9332), filterable by date, house, committee, and speaker.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "committee": {
    "description": "Committee name, e.g. \u8ca1\u52d9\u91d1\u878d\u59d4\u54e1\u4f1a.",
    "type": "string"
   },
   "from_date": {
    "description": "Start date, YYYY-MM-DD.",
    "type": "string"
   },
   "house": {
    "description": "Restrict to one chamber: shugiin or sangiin.",
    "enum": [
     "shugiin",
     "sangiin"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results, 1-100. Default 20.",
    "type": "number"
   },
   "offset": {
    "description": "1-based result offset for pagination. Default 1.",
    "type": "number"
   },
   "query": {
    "description": "Search keyword.",
    "type": "string"
   },
   "speaker": {
    "description": "Restrict to a speaker's remarks.",
    "type": "string"
   },
   "to_date": {
    "description": "End date, YYYY-MM-DD.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "diet_minutes_search"
}

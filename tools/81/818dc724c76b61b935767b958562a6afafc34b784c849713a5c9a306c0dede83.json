{
 "description": "Capture a previously authorized OneClick Mall charge (deferred-capture flow). One capture per child detail.",
 "inputSchema": {
  "properties": {
   "authorization_code": {
    "description": "Authorization code returned from oneclick_authorize",
    "type": "string"
   },
   "buy_order": {
    "description": "Child buy_order used at authorize",
    "type": "string"
   },
   "capture_amount": {
    "description": "Amount to capture in CLP (integer)",
    "type": "number"
   },
   "commerce_code": {
    "description": "Child commerce_code used at authorize",
    "type": "string"
   }
  },
  "required": [
   "commerce_code",
   "buy_order",
   "authorization_code",
   "capture_amount"
  ],
  "type": "object"
 },
 "name": "oneclick_capture"
}

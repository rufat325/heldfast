{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Save one complete producer-approved birth bundle. Only call after the producer explicitly approves the exact preview. Preserve its request_id, bundle, and confirmation_hash; never generate the hash or silently obtain and approve a fresh preview. A stale preview must be reviewed again.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bundle": {
    "additionalProperties": false,
    "properties": {
     "additional_source_sms_ids": {
      "default": [],
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "birth_date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "current_location": {
      "description": "Explicitly reviewed current location only; does not create movement history.",
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "dam_id": {
      "format": "uuid",
      "type": "string"
     },
     "dam_update": {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       },
       "notes": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "evidence": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "file_id": {
         "format": "uuid",
         "type": "string"
        },
        "link_to_dam": {
         "default": false,
         "type": "boolean"
        },
        "media_id": {
         "format": "uuid",
         "type": "string"
        },
        "offspring_label": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "file_id"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "follow_up": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "due_date": {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        "name": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "offspring_labels": {
         "items": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
         },
         "maxItems": 20,
         "minItems": 1,
         "type": "array"
        }
       },
       "required": [
        "name",
        "offspring_labels"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "group_ids": {
      "default": [],
      "description": "Explicitly reviewed current group memberships. Does not record movement.",
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "lactation_observations": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "date": {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        "text": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "date",
        "text"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "maternal_observations": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "date": {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        "text": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "date",
        "text"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "offspring": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "birth_weight": {
         "additionalProperties": false,
         "properties": {
          "unit": {
           "enum": [
            "kg",
            "lb"
           ],
           "type": "string"
          },
          "value": {
           "exclusiveMinimum": 0,
           "maximum": 1000,
           "type": "number"
          }
         },
         "required": [
          "value",
          "unit"
         ],
         "type": "object"
        },
        "review_label": {
         "description": "Temporary review label only; never an invented identifier.",
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        "sex": {
         "enum": [
          "male",
          "female",
          "unknown"
         ],
         "type": "string"
        },
        "supplementation": {
         "default": [],
         "items": {
          "additionalProperties": false,
          "properties": {
           "amount": {
            "exclusiveMinimum": 0,
            "maximum": 100000,
            "type": "number"
           },
           "date": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
           },
           "source": {
            "description": "Producer-stated source, e.g. own dam. Never prescribe care.",
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
           },
           "substance": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
           },
           "unit": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "date",
           "substance",
           "amount",
           "unit",
           "source"
          ],
          "type": "object"
         },
         "maxItems": 20,
         "type": "array"
        },
        "vigor": {
         "default": [],
         "items": {
          "additionalProperties": false,
          "properties": {
           "date": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
           },
           "text": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "date",
           "text"
          ],
          "type": "object"
         },
         "maxItems": 20,
         "type": "array"
        }
       },
       "required": [
        "review_label",
        "sex"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "protocol": {
      "additionalProperties": false,
      "properties": {
       "claimed_name": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       },
       "completed_date": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       "offspring_labels": {
        "items": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array"
       },
       "version_id": {
        "format": "uuid",
        "type": "string"
       }
      },
      "required": [
       "claimed_name",
       "completed_date",
       "offspring_labels"
      ],
      "type": "object"
     },
     "sire": {
      "additionalProperties": false,
      "default": {
       "status": "unknown"
      },
      "properties": {
       "animal_id": {
        "format": "uuid",
        "type": "string"
       },
       "confidence": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "provenance": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       },
       "status": {
        "enum": [
         "unknown",
         "presumed",
         "confirmed"
        ],
        "type": "string"
       }
      },
      "required": [
       "status"
      ],
      "type": "object"
     },
     "source_message_id": {
      "format": "uuid",
      "type": "string"
     },
     "source_sms_id": {
      "format": "uuid",
      "type": "string"
     },
     "time_precision": {
      "default": "date_only",
      "enum": [
       "date_only",
       "morning",
       "afternoon",
       "evening",
       "night"
      ],
      "type": "string"
     },
     "unresolved": {
      "default": [],
      "items": {
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 30,
      "type": "array"
     }
    },
    "required": [
     "dam_id",
     "birth_date",
     "offspring"
    ],
    "type": "object"
   },
   "confirmation_hash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "farm_id": {
    "format": "uuid",
    "type": "string"
   },
   "request_id": {
    "description": "Stable request UUID. Preserve it across preview, confirmation, and retries.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "request_id",
   "bundle",
   "confirmation_hash"
  ],
  "type": "object"
 },
 "name": "confirm_birth_event"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a human-alert notification. Identity tokens need the server-side can_notify_user grant; this tool never needs a topic or ntfy credential.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "level": {
    "description": "urgent, normal (default), or low",
    "enum": [
     "urgent",
     "normal",
     "low"
    ],
    "type": "string"
   },
   "message": {
    "description": "Notification body",
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "description": "Optional ntfy tags",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "title": {
    "description": "Short notification title",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "message"
  ],
  "type": "object"
 },
 "name": "notify_user",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "level": {
    "enum": [
     "urgent",
     "normal",
     "low"
    ],
    "type": "string"
   },
   "target": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "target",
   "title",
   "level"
  ],
  "type": "object"
 },
 "title": "Notify User"
}

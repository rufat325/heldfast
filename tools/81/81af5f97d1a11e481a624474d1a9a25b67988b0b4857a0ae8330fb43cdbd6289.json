  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "description": "16:9 or 9:16. Default 16:9.",
    "type": "string"
   },
   "duration_seconds": {
    "description": "4, 6 or 8. Default 6.",
    "type": "integer"
   },
   "generate_audio": {
    "description": "Default false.",
    "type": "boolean"
   },
   "prompt": {
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "hubvibe_video_generate",

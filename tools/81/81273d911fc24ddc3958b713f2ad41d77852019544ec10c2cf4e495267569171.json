{
 "description": "Edit a DM automation rule \u2014 most commonly active=false/true to pause or resume it. comment_keyword rules cannot drop opening_message or button_label.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "active": {
    "type": "boolean"
   },
   "ai_enabled": {
    "type": "boolean"
   },
   "ai_prompt": {
    "type": "string"
   },
   "button_label": {
    "type": "string"
   },
   "id": {
    "description": "Rule id from list_dm_automations.",
    "type": "string"
   },
   "keywords": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "match_type": {
    "enum": [
     "exact",
     "contains",
     "begins_with"
    ],
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "once_per_user_hours": {
    "type": "number"
   },
   "opening_message": {
    "type": "string"
   },
   "public_reply_variants": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reply_variants": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_dm_automation"
}

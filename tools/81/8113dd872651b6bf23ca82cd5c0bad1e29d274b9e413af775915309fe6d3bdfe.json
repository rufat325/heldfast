{
 "description": "[GA4 WRITE] Create a custom dimension. Requires GA4_MCP_ENABLE_WRITES=true and confirm=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "Must be true to apply the change.",
    "type": "boolean"
   },
   "description": {
    "type": "string"
   },
   "disallowAdsPersonalization": {
    "description": "If true, exclude from ads personalization (USER scope).",
    "type": "boolean"
   },
   "displayName": {
    "description": "UI display name.",
    "minLength": 1,
    "type": "string"
   },
   "parameterName": {
    "description": "Event/user/item parameter name to register.",
    "minLength": 1,
    "type": "string"
   },
   "property": {
    "description": "GA4 property ID, e.g. \"123456789\" or \"properties/123456789\".",
    "minLength": 1,
    "type": "string"
   },
   "scope": {
    "description": "Dimension scope.",
    "enum": [
     "EVENT",
     "USER",
     "ITEM"
    ],
    "type": "string"
   }
  },
  "required": [
   "property",
   "parameterName",
   "displayName",
   "scope",
   "confirm"
  ],
  "type": "object"
 },
 "name": "ga4_create_custom_dimension"
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Queue an AI image generation into the BlitzReels media library. Spends AI credits and returns a job to poll with generation_jobs_get.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "aspectRatio": {
    "default": "1:1",
    "description": "Output aspect ratio.",
    "enum": [
     "1:1",
     "16:9",
     "9:16",
     "4:3",
     "3:4",
     "3:2",
     "2:3",
     "5:4",
     "4:5",
     "21:9"
    ],
    "type": "string"
   },
   "enhancePrompt": {
    "default": false,
    "description": "Enhance using BlitzReels model grammar and actual input context.",
    "type": "boolean"
   },
   "folderId": {
    "description": "Optional media library folder ID.",
    "format": "uuid",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "model": {
    "default": "fal-ai/nano-banana-2",
    "description": "Image model. Call generation_options_list for costs.",
    "enum": [
     "fal-ai/gpt-image-1",
     "fal-ai/gpt-image-1.5",
     "fal-ai/gpt-image-2",
     "fal-ai/gpt-image-2.5-flare",
     "fal-ai/gpt-image-2.5-sunburst",
     "xai/grok-imagine-image-2.0",
     "fal-ai/bytedance/seedream/v5/lite/text-to-image",
     "bytedance/seedream/v5/pro/text-to-image",
     "fal-ai/krea-2/turbo",
     "fal-ai/krea/v2/medium/turbo/text-to-image",
     "fal-ai/krea/v2/medium/text-to-image",
     "fal-ai/nano-banana-2",
     "google/nano-banana-2-lite",
     "fal-ai/nano-banana-pro"
    ],
    "type": "string"
   },
   "prompt": {
    "description": "What the image should show (8-5000 characters).",
    "maxLength": 5000,
    "minLength": 8,
    "type": "string"
   },
   "referenceAssetIds": {
    "default": [],
    "description": "Ordered image references. Model-specific limits are listed in generation_options_list; unsupported references fail.",
    "items": {
     "format": "uuid",
     "type": "string"
    },
    "maxItems": 14,
    "type": "array"
   },
   "resolution": {
    "anyOf": [
     {
      "enum": [
       "0.5k",
       "1k",
       "2k",
       "4k"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Native image resolution. Call generation_options_list for model support and resolution pricing. Unsupported settings are rejected."
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "generation_image_create",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "generation": {
    "properties": {
     "estimated_credits": {
      "type": [
       "number",
       "null"
      ]
     },
     "job_id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "image",
       "video",
       "voiceover",
       "music",
       "sound",
       "faceless"
      ],
      "type": "string"
     },
     "media_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "mutationReceipt": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "key": {
        "type": [
         "string",
         "null"
        ]
       },
       "operation": {
        "type": "string"
       },
       "replayed": {
        "type": "boolean"
       },
       "status": {
        "enum": [
         "completed"
        ],
        "type": "string"
       }
      },
      "required": [
       "id",
       "key",
       "operation",
       "status",
       "replayed"
      ],
      "type": "object"
     },
     "project_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "job_id",
     "kind",
     "status",
     "mutationReceipt"
    ],
    "type": "object"
   }
  },
  "required": [
   "generation"
  ],
  "type": "object"
 },
 "title": "Generate Image"
}

 "description": "Daily vessel counts and aggregate capacity (deadweight tonnage) transiting a specific chokepoint. Returns time series ordered most-recent-first, with per-cargo-type breakdown (container / dry bulk / general cargo / RoRo / tanker). Use for \"is Suez traffic back to normal after the Houthi attacks\", \"Hormuz throughput vs 30d average\", or any bet predicated on a chokepoint disruption persisting. Accepts friendly names (suez / panama / hormuz / bab-el-mandeb / etc.) or PortWatch portid (chokepoint1..8).",
 "inputSchema": {
  "examples": [
   {
    "chokepoint": "Hormuz",
    "days": 30
   },
   {
    "chokepoint": "Suez Canal"
   }
  ],
  "properties": {
   "chokepoint": {
    "description": "Friendly name (e.g. \"Hormuz\", \"Suez Canal\") or portid (\"chokepoint7\")",
    "type": "string"
   },
   "days": {
    "description": "Lookback window in days (default 30, max 365). Data is daily.",
    "type": "number"
   }
  },
  "required": [
   "chokepoint"
  ],
  "type": "object"
 },

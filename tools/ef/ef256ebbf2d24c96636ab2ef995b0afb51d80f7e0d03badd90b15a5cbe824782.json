{
 "description": "Create a product variation",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attributes": {
    "description": "Variation attributes",
    "items": {
     "additionalProperties": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "manage_stock": {
    "default": false,
    "type": "boolean"
   },
   "product_id": {
    "description": "Parent product ID",
    "type": "number"
   },
   "regular_price": {
    "default": "",
    "type": "string"
   },
   "sale_price": {
    "default": "",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "sku": {
    "default": "",
    "type": "string"
   },
   "stock_quantity": {
    "type": "number"
   },
   "stock_status": {
    "default": "instock",
    "type": "string"
   }
  },
  "required": [
   "site",
   "product_id",
   "attributes"
  ],
  "type": "object"
 },
 "name": "woo_create_variation"
}

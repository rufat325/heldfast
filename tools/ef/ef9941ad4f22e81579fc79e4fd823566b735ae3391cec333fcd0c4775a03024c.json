{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Event Host"
 },
 "description": "Invite a co-host to a live event by email. role 'producer' = full permissions; role 'co_host' = display + invite-from-own-list. They get an email and join on accept. Requires event_id; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "role": {
    "enum": [
     "producer",
     "co_host"
    ],
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "email",
   "role"
  ],
  "type": "object"
 },
 "name": "add_event_host",
 "title": "Add Event Host"
}

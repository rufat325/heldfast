{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Dossier Evidence List By Dossier"
 },
 "description": "Lists every evidence item linked to a dossier, across all of its evidence groups. Requires: caseFileId and dossierId. This is the dossier-wide view; dossier_evidence_list is the narrower per-group one and additionally needs a dossierEvidenceGroupId. Supports filter, order and page. Returns { data, meta.totalElements }.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "caseFileId": {
    "type": "string"
   },
   "dossierId": {
    "type": "string"
   },
   "filter": {
    "properties": {
     "capturedFrom": {
      "type": "string"
     },
     "capturedUntil": {
      "type": "string"
     },
     "dossierEvidenceGroupId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "dossierId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "evidenceIds": {
      "items": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "order": {
    "properties": {
     "capturedAt": {
      "enum": [
       "ASC",
       "DESC"
      ],
      "type": "string"
     },
     "createdAt": {
      "enum": [
       "ASC",
       "DESC"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "page": {
    "properties": {
     "number": {
      "default": 1,
      "minimum": 1,
      "type": "number"
     },
     "size": {
      "default": 20,
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "caseFileId",
   "dossierId"
  ],
  "type": "object"
 },
 "name": "dossier_evidence_list_by_dossier"
}

    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      },
      "suggestion": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "column",
      "severity",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "path": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "path"
  ],
  "type": "object"
 }

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Attaches an email address to an SMI subject.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "email": {
    "description": "The email address to attach to the subject.",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "subjectId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ],
    "description": "The subject's id, from a prior smi_get_subject or subject-enrichment call."
   }
  },
  "required": [
   "subjectId",
   "email"
  ],
  "type": "object"
 },
 "name": "smi_add_subject_email",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "recordId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   },
   "subjectId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   }
  },
  "required": [
   "subjectId"
  ],
  "type": "object"
 },
 "title": "Add Subject Email"
}

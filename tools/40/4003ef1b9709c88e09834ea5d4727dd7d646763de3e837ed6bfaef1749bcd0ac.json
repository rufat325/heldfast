 },
 "description": "Upload image bytes to Dayze storage (WebP re-encode strips EXIF/AI metadata). Returns asset_id. For inventory item photos: pass entity_type=inventory, entity_id=inventory_id, role=photo, image_base64 from chat images. Or upload then attach_asset. ($0.15; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "asset_type": {
    "description": "photo | receipt | certificate | document | thumbnail | \u2026",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "entity_id": {
    "type": "string"
   },
   "entity_type": {
    "description": "inventory_item maps to inventory",
    "type": "string"
   },
   "filename": {
    "type": "string"
   },
   "idempotency_key": {
    "description": "Alias for request_id.",
    "type": "string"
   },
   "image_base64": {
    "type": "string"
   },
   "metadata": {
    "type": "object"
   },
   "mime_type": {
    "type": "string"
   },
   "parent_asset_id": {
    "type": "string"
   },
   "request_id": {
    "description": "Client idempotency key (retries return original result).",
    "type": "string"
   },
   "role": {
    "description": "original | cover | thumbnail | \u2026",
    "enum": [
     "original",
     "processed",
     "thumbnail",
     "cover",
     "document",
     "receipt",
     "certificate",
     "photo",
     "other"
    ],
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "upload_asset",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "asset": {
    "additionalProperties": true,
    "type": "object"
   },
   "asset_id": {
    "type": "string"
   },
   "message": {
    "type": [
     "string",
     "null"
    ]
   },
   "metadata_stripped": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "readOnlyHint": false,
 "securitySchemes": [
  {
   "scopes": [
    "context.write"
   ],
   "type": "oauth2"
  }
 ],

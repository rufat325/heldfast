{
 "description": "Get a cost estimate for creating a token on Printr. Returns itemized costs per chain, total cost in USD and native tokens, and the number of tokens from the initial buy. Use this before printr_create_token to understand costs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chains": {
    "description": "Chains to deploy on",
    "items": {
     "description": "CAIP-2 chain ID (e.g. 'eip155:8453' for Base, 'solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp' for Solana)",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "graduation_threshold_per_chain_usd": {
    "anyOf": [
     {
      "const": 69000,
      "type": "number"
     },
     {
      "const": 250000,
      "type": "number"
     }
    ],
    "description": "Graduation threshold in USD (default: 69000)"
   },
   "initial_buy": {
    "properties": {
     "spend_native": {
      "description": "Spend a native token amount (atomic units, '0' for no buy)",
      "type": "string"
     },
     "spend_usd": {
      "description": "Spend a fixed USD amount (0 for no buy)",
      "minimum": 0,
      "type": "number"
     },
     "supply_percent": {
      "description": "Buy a percentage of total supply (0.01\u201369%)",
      "maximum": 69,
      "minimum": 0.01,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "chains",
   "initial_buy"
  ],
  "type": "object"
 },
 "name": "printr_quote",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assets": {
    "description": "Involved assets",
    "items": {
     "additionalProperties": false,
     "properties": {
      "decimals": {
       "description": "Decimal precision",
       "type": "number"
      },
      "id": {
       "description": "CAIP-10 asset identifier",
       "type": "string"
      },
      "name": {
       "description": "Display name",
       "type": "string"
      },
      "price_usd": {
       "description": "USD price estimate",
       "type": "number"
      },
      "symbol": {
       "description": "Ticker symbol",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "symbol",
      "decimals",
      "price_usd"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "costs": {
    "description": "Itemized cost breakdown",
    "items": {
     "additionalProperties": false,
     "properties": {
      "asset_id": {
       "description": "CAIP-10 reference asset",
       "type": "string"
      },
      "cost_asset_atomic": {
       "description": "Cost in atomic units of the reference asset",
       "type": "string"
      },
      "cost_usd": {
       "description": "Cost in USD",
       "type": "number"
      },
      "description": {
       "description": "Cost label (e.g. 'Gas', 'X-Chain Fee')",
       "type": "string"
      },
      "limit": {
       "description": "Upper bound spending limit",
       "type": "number"
      }
     },
     "required": [
      "asset_id",
      "cost_usd",
      "cost_asset_atomic"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "description": "Quote identifier",
    "type": "string"
   },
   "initial_buy_amount": {
    "description": "Token amount from initial buy",
    "type": "string"
   },
   "router": {
    "description": "Routing provider type",
    "type": "string"
   },
   "total": {
    "additionalProperties": false,
    "description": "Aggregated total cost",
    "properties": {
     "asset_id": {
      "description": "CAIP-10 reference asset",
      "type": "string"
     },
     "cost_asset_atomic": {
      "description": "Cost in atomic units of the reference asset",
      "type": "string"
     },
     "cost_usd": {
      "description": "Cost in USD",
      "type": "number"
     },
     "description": {
      "description": "Cost label (e.g. 'Gas', 'X-Chain Fee')",
      "type": "string"
     },
     "limit": {
      "description": "Upper bound spending limit",
      "type": "number"
     }
    },
    "required": [
     "asset_id",
     "cost_usd",
     "cost_asset_atomic"
    ],
    "type": "object"
   }
  },
  "required": [
   "id",
   "router",
   "assets",
   "costs",
   "total"
  ],
  "type": "object"
 }
}

{
 "description": "Estimate tax on 1099-K income (reselling, gig work). SE tax, QBI, quarterly 1040-ES. Uses latest CDN data.",
 "inputSchema": {
  "properties": {
   "costOfGoodsSold": {
    "description": "COGS",
    "type": "number"
   },
   "filingStatus": {
    "default": "single",
    "description": "Tax filing status",
    "enum": [
     "single",
     "married",
     "head"
    ],
    "type": "string"
   },
   "grossReceipts": {
    "description": "Total 1099-K receipts",
    "type": "number"
   },
   "otherExpenses": {
    "description": "Other expenses",
    "type": "number"
   },
   "state": {
    "default": "",
    "description": "US state abbreviation (e.g. CA, NY, TX)",
    "type": "string"
   }
  },
  "required": [
   "grossReceipts"
  ],
  "type": "object"
 },
 "name": "calculate_1099k_tax"
}

{
 "description": "List content optimization sessions; each holds suggestions to improve content.",
 "inputSchema": {
  "properties": {
   "content_id": {
    "type": "string"
   },
   "page": {
    "description": "default 1",
    "type": "number"
   },
   "page_size": {
    "description": "default 20, max 100",
    "type": "number"
   },
   "status": {
    "enum": [
     "pending",
     "analyzing",
     "ready",
     "applied",
     "auto_applying",
     "dismissed",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_optimizations"
}

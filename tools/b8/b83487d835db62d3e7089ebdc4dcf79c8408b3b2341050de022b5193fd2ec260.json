{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List Directory"
 },
 "description": "List directory contents on the device.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "path": {
    "description": "Absolute path to the directory on the device (e.g., /sdcard/)",
    "type": "string"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "file_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Number of entries returned",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "entries": {
    "description": "Directory entries",
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "description": "Modification date/time",
       "type": "string"
      },
      "group": {
       "description": "Owner group",
       "type": "string"
      },
      "isDirectory": {
       "description": "Whether the entry is a directory",
       "type": "boolean"
      },
      "name": {
       "description": "Entry name",
       "type": "string"
      },
      "owner": {
       "description": "Owner user",
       "type": "string"
      },
      "permissions": {
       "description": "Permission string (e.g. -rw-r--r--)",
       "type": "string"
      },
      "size": {
       "description": "Size in bytes (0 for special files)",
       "type": "number"
      }
     },
     "required": [
      "name",
      "permissions",
      "owner",
      "group",
      "size",
      "date",
      "isDirectory"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "path": {
    "description": "The directory that was listed",
    "type": "string"
   }
  },
  "required": [
   "path",
   "count",
   "entries"
  ],
  "type": "object"
 }
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "YNAB: Get Month Details"
 },
 "description": "Get full budget data for a specific month including all category balances.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - month (string, required): Month in YYYY-MM-DD format (use first day, e.g. \"2025-01-01\").\n  - response_format (string, optional): \"json\" or \"markdown\" (default: \"markdown\").\n\nReturns: month (month, income, budgeted, activity, to_be_budgeted, age_of_money, categories[]), cached, cache_info\n\nExamples:\n  - Get January 2025: set month=\"2025-01-01\"\n\nErrors:\n  - \"No default budget set\" \u2192 run ynab_set_default_budget first",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "month": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   }
  },
  "required": [
   "month"
  ],
  "type": "object"
 },
 "name": "ynab_get_month",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cache_info": {
    "description": "Human-readable cache status message (e.g., \"Cache hit\", \"Cache miss\")",
    "type": "string"
   },
   "cached": {
    "description": "Indicates if data was served from cache",
    "type": "boolean"
   },
   "month": {
    "additionalProperties": false,
    "description": "Month details",
    "properties": {
     "activity": {
      "description": "Activity in dollars",
      "type": "number"
     },
     "age_of_money": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "Age of money in days"
     },
     "budgeted": {
      "description": "Budgeted amount in dollars",
      "type": "number"
     },
     "categories": {
      "description": "Categories for this month",
      "items": {
       "additionalProperties": false,
       "properties": {
        "activity": {
         "description": "Activity in dollars",
         "type": "number"
        },
        "balance": {
         "description": "Balance in dollars",
         "type": "number"
        },
        "budgeted": {
         "description": "Budgeted amount in dollars",
         "type": "number"
        },
        "category_group_id": {
         "description": "Category group ID",
         "type": "string"
        },
        "category_group_name": {
         "description": "Category group name",
         "type": "string"
        },
        "deleted": {
         "description": "Deleted flag",
         "type": "boolean"
        },
        "goal_creation_month": {
         "description": "Goal creation month",
         "type": "string"
        },
        "goal_months_to_budget": {
         "description": "Goal months to budget",
         "type": "number"
        },
        "goal_overall_funded": {
         "description": "Goal overall funded amount",
         "type": "number"
        },
        "goal_overall_left": {
         "description": "Goal overall left amount",
         "type": "number"
        },
        "goal_percentage_complete": {
         "description": "Goal percentage complete",
         "type": "number"
        },
        "goal_target": {
         "description": "Goal target in milliunits",
         "type": "number"
        },
        "goal_target_month": {
         "description": "Goal target month",
         "type": "string"
        },
        "goal_type": {
         "description": "Goal type",
         "type": "string"
        },
        "goal_under_funded": {
         "description": "Goal under funded amount",
         "type": "number"
        },
        "hidden": {
         "description": "Hidden flag",
         "type": "boolean"
        },
        "id": {
         "description": "Category ID",
         "type": "string"
        },
        "name": {
         "description": "Category name",
         "type": "string"
        },
        "note": {
         "description": "Category note",
         "type": "string"
        },
        "original_category_group_id": {
         "description": "Original category group ID",
         "type": "string"
        }
       },
       "required": [
        "id",
        "category_group_id",
        "name",
        "hidden",
        "budgeted",
        "activity",
        "balance",
        "deleted"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "deleted": {
      "description": "Deleted flag",
      "type": "boolean"
     },
     "income": {
      "description": "Income in dollars",
      "type": "number"
     },
     "month": {
      "description": "Month identifier",
      "type": "string"
     },
     "note": {
      "description": "Month note",
      "type": "string"
     },
     "to_be_budgeted": {
      "description": "To be budgeted in dollars",
      "type": "number"
     }
    },
    "required": [
     "month",
     "income",
     "budgeted",
     "activity",
     "to_be_budgeted",
     "deleted"
    ],
    "type": "object"
   },
   "usedDelta": {
    "description": "Indicates if delta merge optimization was applied for budgets",
    "type": "boolean"
   }
  },
  "required": [
   "month"
  ],
  "type": "object"
 }

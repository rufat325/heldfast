{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve one registered public page by canonical path, including provider profiles, comparisons, provider reviews, reliability assessments, rankings, and methodology. Drafts, guides, submissions, and unknown paths are unavailable.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "path": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "get_page",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "found": {
    "type": "boolean"
   },
   "page": {
    "additionalProperties": false,
    "properties": {
     "canonicalUrl": {
      "format": "uri",
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "markdown": {
      "type": "string"
     },
     "pageType": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "path",
     "title",
     "description",
     "canonicalUrl",
     "pageType",
     "markdown",
     "truncated"
    ],
    "type": "object"
   },
   "spotCallout": {
    "type": "string"
   }
  },
  "required": [
   "spotCallout",
   "found"
  ],
  "type": "object"
 },
 "title": "Get a published Spot page"
}

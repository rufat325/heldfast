{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find boat, carpet and other travel routes to or from a place, with fares. Each row is one leg with its start (origin) and the NPC's recorded city, location and position. Rows are single legs: this does not plan journeys.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "type": "string"
   },
   "from": {
    "description": "Exact start place of the leg, e.g. \"Meriana\", any case.",
    "minLength": 1,
    "type": "string"
   },
   "include_inactive": {
    "default": false,
    "type": "boolean"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "default": "price",
    "description": "price ascends with 0 fares last, npc is alphabetical.",
    "enum": [
     "price",
     "npc"
    ],
    "type": "string"
   },
   "to": {
    "description": "Exact destination, e.g. \"Svargrond\", any case.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tibia_find_travel",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "indexGeneratedAt": {
    "type": "string"
   },
   "nextCursor": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "city": {
       "type": [
        "string",
        "null"
       ]
      },
      "location": {
       "type": [
        "string",
        "null"
       ]
      },
      "notes": {
       "type": [
        "string",
        "null"
       ]
      },
      "npc": {
       "type": "string"
      },
      "origin": {
       "description": "Where the leg starts. null: not recorded, it starts at one of the NPC's positions.",
       "type": [
        "string",
        "null"
       ]
      },
      "position": {
       "additionalProperties": false,
       "properties": {
        "x": {
         "type": [
          "number",
          "null"
         ]
        },
        "y": {
         "type": [
          "number",
          "null"
         ]
        },
        "z": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "required": [
        "x",
        "y",
        "z"
       ],
       "type": "object"
      },
      "price": {
       "description": "Route price in gold. 0: free or not recorded, see notes.",
       "type": [
        "number",
        "null"
       ]
      },
      "subarea": {
       "type": [
        "string",
        "null"
       ]
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "npc",
      "city",
      "subarea",
      "location",
      "position",
      "to",
      "origin",
      "price",
      "notes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalMatches": {
    "type": "number"
   }
  },
  "required": [
   "results",
   "totalMatches",
   "indexGeneratedAt"
  ],
  "type": "object"
 }
}

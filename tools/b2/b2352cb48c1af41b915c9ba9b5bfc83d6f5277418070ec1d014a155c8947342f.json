{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Place an asynchronous appointment call to propose, book, confirm, reschedule or cancel a slot through a calendar-provider abstraction. Use when an authorized agent must coordinate a customer appointment by telephone and return a machine-readable scheduling result.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "propose",
     "book",
     "confirm",
     "reschedule",
     "cancel"
    ],
    "type": "string"
   },
   "appointmentType": {
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "availableSlots": {
    "default": [],
    "items": {
     "format": "date-time",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "context": {
    "additionalProperties": {
     "maxLength": 500,
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "language": {
    "enum": [
     "en",
     "ar"
    ],
    "type": "string"
   },
   "maxDurationSeconds": {
    "default": 300,
    "maximum": 3600,
    "minimum": 1,
    "type": "integer"
   },
   "phoneNumber": {
    "pattern": "^\\+[1-9]\\d{7,14}$",
    "type": "string"
   },
   "safety": {
    "properties": {
     "consentNotice": {
      "maxLength": 500,
      "type": "string"
     },
     "recording": {
      "default": false,
      "type": "boolean"
     },
     "timezone": {
      "maxLength": 100,
      "type": "string"
     },
     "transcription": {
      "default": false,
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "timezone": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "phoneNumber",
   "action",
   "appointmentType",
   "timezone",
   "language"
  ],
  "type": "object"
 },
 "name": "appointment_call_agent",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "calendarEventId": {
    "type": [
     "string",
     "null"
    ]
   },
   "callId": {
    "type": "string"
   },
   "confirmedSlot": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "customerNotes": {
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "enum": [
     "proposed",
     "confirmed",
     "rescheduled",
     "cancelled",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "callId",
   "status",
   "confirmedSlot",
   "customerNotes",
   "calendarEventId"
  ],
  "type": "object"
 }
}

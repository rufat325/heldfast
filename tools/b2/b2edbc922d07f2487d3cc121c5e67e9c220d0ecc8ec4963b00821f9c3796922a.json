{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs go vet and returns structured static analysis diagnostics with analyzer names. Uses -json flag for native JSON output with automatic text fallback.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "analyzers": {
    "description": "Specific analyzers to enable or disable. Prefix with '-' to disable. Example: ['shadow', '-printf']",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "contextLines": {
    "description": "Number of context lines to include around each diagnostic (-c=N)",
    "maximum": 50,
    "minimum": 0,
    "type": "integer"
   },
   "packages": {
    "default": [
     "./..."
    ],
    "description": "Packages to vet (default: ./...)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "tags": {
    "description": "Build tags for correct vetting of conditionally compiled code (-tags)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "vettool": {
    "description": "Path to a custom analyzer tool binary (-vettool)",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vet",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compilationErrors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "analyzer": {
       "type": "string"
      },
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Go Vet"
}

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Income/expense/transfer write. direction=from + type=income for Venmo/Stripe/refunds received. Positive amount; external_id dedupes imports. Optional project/tags. Zelle always USD. Optional mirror_event creates a calendar Money \u00b7 annotation (ledger is still the source of truth for /money). ($0.10; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "account_id": {
    "description": "Stable provider account identity for imported payments.",
    "type": "string"
   },
   "amount": {
    "type": "number"
   },
   "currency": {
    "type": "string"
   },
   "date": {
    "type": "string"
   },
   "direction": {
    "enum": [
     "from",
     "to"
    ],
    "type": "string"
   },
   "external_id": {
    "type": "string"
   },
   "extractor_version": {
    "type": "string"
   },
   "idempotency_key": {
    "description": "Alias for request_id.",
    "type": "string"
   },
   "merchant": {
    "type": "string"
   },
   "message_id": {
    "type": "string"
   },
   "mirror_event": {
    "description": "Also insert optional Money \u00b7 calendar event (default false)",
    "type": "boolean"
   },
   "notes": {
    "type": "string"
   },
   "payment_method": {
    "type": "string"
   },
   "person_id": {
    "type": "string"
   },
   "project": {
    "description": "Venture/project label \u2192 stored as project:{slug} tag (e.g. Max Soko poker venture)",
    "type": "string"
   },
   "request_id": {
    "description": "Client idempotency key (retries return original result).",
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "tags": {
    "description": "Optional tags. Prefer project: / ext: / rail: grammar.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "enum": [
     "income",
     "expense",
     "transfer"
    ],
    "type": "string"
   }
  },
  "required": [
   "amount",
   "direction"
  ],
  "type": "object"
 },
 "name": "log_transaction",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "direction": {
    "type": "string"
   },
   "duplicate": {
    "type": "boolean"
   },
   "event_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "expense_id": {
    "type": "string"
   },
   "message": {
    "type": [
     "string",
     "null"
    ]
   },
   "transaction": {
    "additionalProperties": true,
    "description": "Expense/income transaction row.",
    "type": "object"
   },
   "transaction_id": {
    "type": "string"
   },
   "type": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "readOnlyHint": false,
 "securitySchemes": [
  {
   "scopes": [
    "context.write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Log Transaction"
}

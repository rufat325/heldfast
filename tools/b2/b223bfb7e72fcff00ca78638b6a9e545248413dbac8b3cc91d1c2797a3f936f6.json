{
 "description": "Get content gap opportunities - topics your competitors rank for that you don't.",
 "inputSchema": {
  "properties": {
   "include_off_strategy": {
    "description": "Include rows withheld as off-strategy (no cluster fit or competitor evidence awaiting review).",
    "type": "boolean"
   },
   "page": {
    "description": "default 1",
    "type": "number"
   },
   "page_size": {
    "description": "default 20, max 100",
    "type": "number"
   },
   "site_id": {
    "description": "Filter by site ID",
    "type": "string"
   },
   "status": {
    "enum": [
     "new",
     "reviewed",
     "in_progress",
     "dismissed",
     "completed",
     "auto_resolved"
    ],
    "type": "string"
   },
   "type": {
    "description": "Opportunity type filter",
    "enum": [
     "missing_content",
     "thin_content",
     "outdated_content",
     "competitor_gap"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_content_gaps"
}

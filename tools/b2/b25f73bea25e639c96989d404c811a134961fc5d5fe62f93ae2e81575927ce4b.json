{
 "description": "Create a recurring subscription",
 "inputSchema": {
  "properties": {
   "billingType": {
    "description": "Payment method",
    "enum": [
     "BOLETO",
     "CREDIT_CARD",
     "PIX"
    ],
    "type": "string"
   },
   "customer": {
    "description": "Customer ID",
    "type": "string"
   },
   "cycle": {
    "description": "Billing cycle",
    "enum": [
     "WEEKLY",
     "BIWEEKLY",
     "MONTHLY",
     "QUARTERLY",
     "SEMIANNUALLY",
     "YEARLY"
    ],
    "type": "string"
   },
   "description": {
    "description": "Subscription description",
    "type": "string"
   },
   "nextDueDate": {
    "description": "First due date (YYYY-MM-DD)",
    "type": "string"
   },
   "value": {
    "description": "Amount per cycle",
    "type": "number"
   }
  },
  "required": [
   "customer",
   "billingType",
   "value",
   "cycle",
   "nextDueDate"
  ],
  "type": "object"
 },
 "name": "create_subscription"
}

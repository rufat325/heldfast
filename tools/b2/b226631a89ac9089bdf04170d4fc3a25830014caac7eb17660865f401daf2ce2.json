{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs Hadolint (Dockerfile linter) and returns structured diagnostics (file, line, rule, severity, message).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "config": {
    "description": "Path to Hadolint configuration file (maps to --config)",
    "maxLength": 4096,
    "type": "string"
   },
   "errorRules": {
    "description": "Rule codes to treat as errors (maps to --error)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "failureThreshold": {
    "description": "Minimum severity to cause a non-zero exit code (maps to --failure-threshold)",
    "enum": [
     "error",
     "warning",
     "info",
     "style",
     "ignore",
     "none"
    ],
    "type": "string"
   },
   "ignoreRules": {
    "description": "Rule codes to ignore (e.g., ['DL3008', 'DL3013'])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "infoRules": {
    "description": "Rule codes to treat as info (maps to --info)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "noFail": {
    "description": "Always exit with 0 for informational-only runs (maps to --no-fail)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "Dockerfile"
    ],
    "description": "Dockerfile paths to check (default: ['Dockerfile'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "requireLabel": {
    "description": "Required labels in Dockerfiles, e.g. ['maintainer:text'] (maps to --require-label)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "shell": {
    "description": "Default shell for RUN instruction linting, e.g. '/bin/bash' (maps to --shell)",
    "maxLength": 65536,
    "type": "string"
   },
   "strictLabels": {
    "description": "Enforce strict label schema (maps to --strict-labels)",
    "type": "boolean"
   },
   "trustedRegistries": {
    "description": "Trusted Docker registries (e.g., ['docker.io', 'ghcr.io'])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "verbose": {
    "description": "Enable verbose output (maps to --verbose)",
    "type": "boolean"
   },
   "warningRules": {
    "description": "Rule codes to treat as warnings (maps to --warning)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "hadolint",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deprecationCount": {
    "type": "number"
   },
   "deprecations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reference": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "severity",
      "rule",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnosticsTruncated": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "errors": {
    "type": "number"
   },
   "exitCode": {
    "type": "number"
   },
   "filesChecked": {
    "type": "number"
   },
   "fixableErrorCount": {
    "type": "number"
   },
   "fixableWarningCount": {
    "type": "number"
   },
   "omittedCount": {
    "type": "number"
   },
   "warnings": {
    "type": "number"
   }
  },
  "required": [
   "errors",
   "warnings",
   "filesChecked"
  ],
  "type": "object"
 },
 "title": "Hadolint"
}

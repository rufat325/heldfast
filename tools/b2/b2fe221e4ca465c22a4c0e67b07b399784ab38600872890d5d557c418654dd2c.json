 "description": "Europe PMC literature database \u2014 the citing side of the citation graph: the biomedical articles that cite one article, identified by source (MED, PMC, PPR) plus its id. Returns each citing work's title, authors, journal, publication year and Europe PMC / PubMed identifiers, with the total citation count and a pageSize control. Answers who has cited a paper and how many times it has been cited.",
 "inputSchema": {
  "examples": [
   {
    "id": "32123456",
    "source": "MED"
   },
   {
    "id": "PMC7654321",
    "pageSize": 50,
    "source": "PMC"
   }
  ],
  "properties": {
   "id": {
    "type": "string"
   },
   "pageSize": {
    "description": "1-1000 (default 25)",
    "type": "number"
   },
   "source": {
    "type": "string"
   }
  },
  "required": [
   "source",
   "id"
  ],
  "type": "object"
 },
 "name": "citations",
 "outputSchema": {

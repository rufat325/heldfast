{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Research a company from public web sources: overview, products, leadership, funding, competitors, technology signals, recent developments and risk flags, with cited sources and a confidence score. Use when an agent needs a structured research brief on a named company \u2014 for sales/investment/partnership research, competitive analysis, or general company background \u2014 beyond what a structured company registry alone provides.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "company": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "country": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "depth": {
    "default": "standard",
    "enum": [
     "quick",
     "standard",
     "deep"
    ],
    "type": "string"
   },
   "focusAreas": {
    "items": {
     "enum": [
      "overview",
      "products",
      "leadership",
      "funding",
      "competitors",
      "technology",
      "recent_news",
      "market_position",
      "risks"
     ],
     "type": "string"
    },
    "maxItems": 9,
    "type": "array"
   },
   "website": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "company"
  ],
  "type": "object"
 },
 "name": "research_company",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cached": {
    "type": "boolean"
   },
   "company": {
    "additionalProperties": false,
    "properties": {
     "founded": {
      "type": [
       "string",
       "null"
      ]
     },
     "headquarters": {
      "type": [
       "string",
       "null"
      ]
     },
     "industry": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": "string"
     },
     "website": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "name",
     "website",
     "industry",
     "headquarters",
     "founded"
    ],
    "type": "object"
   },
   "competitors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "dataFreshness": {
    "additionalProperties": false,
    "properties": {
     "freshnessDays": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "latestSourceDate": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "latestSourceDate",
     "freshnessDays"
    ],
    "type": "object"
   },
   "dataMode": {
    "enum": [
     "live",
     "not_configured"
    ],
    "type": "string"
   },
   "funding": {
    "additionalProperties": false,
    "properties": {
     "knownRounds": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": [
          "string",
          "null"
         ]
        },
        "date": {
         "type": [
          "string",
          "null"
         ]
        },
        "investors": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "round": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "round",
        "amount",
        "date",
        "investors"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "summary": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "summary",
     "knownRounds"
    ],
    "type": "object"
   },
   "leadership": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "overview": {
    "type": [
     "string",
     "null"
    ]
   },
   "productsAndServices": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recentDevelopments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": [
        "string",
        "null"
       ]
      },
      "summary": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "date",
      "summary",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "riskFlags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "observedAt": {
       "type": "string"
      },
      "publisher": {
       "type": [
        "string",
        "null"
       ]
      },
      "sourceType": {
       "enum": [
        "web_search",
        "company_website",
        "news",
        "government_registry",
        "regulatory_registry",
        "sanctions_list",
        "domain_registry",
        "rafid_oman_registry",
        "not_configured"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "url",
      "title",
      "publisher",
      "sourceType",
      "observedAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "technologySignals": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "company",
   "overview",
   "productsAndServices",
   "leadership",
   "funding",
   "competitors",
   "technologySignals",
   "recentDevelopments",
   "riskFlags",
   "sources",
   "confidence",
   "dataFreshness",
   "cached",
   "dataMode",
   "limitations"
  ],
  "type": "object"
 }
}

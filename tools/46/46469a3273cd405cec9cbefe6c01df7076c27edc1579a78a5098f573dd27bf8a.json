 "description": "List the trials a company LEADS on ClinicalTrials.gov, by sponsor or organization name. Returns status, phase, and conditions to map a research pipeline. Matches the registered lead-sponsor field, so trials another organisation runs using the company's drug are excluded unless sponsor_match asks for them.",
 "inputSchema": {
  "examples": [
   {
    "limit": 25,
    "sponsor": "Pfizer"
   },
   {
    "phase": "PHASE4",
    "sponsor": "Novo Nordisk",
    "status": "COMPLETED"
   },
   {
    "limit": 6,
    "sponsor": "Merck Sharp & Dohme LLC",
    "sponsor_match": "lead_or_collaborator"
   }
  ],
  "properties": {
   "limit": {
    "description": "Number of results (1-100, default 20)",
    "type": "number"
   },
   "phase": {
    "description": "Optional phase filter",
    "type": "string"
   },
   "sponsor": {
    "description": "Sponsor or company name (e.g., \"Pfizer\", \"Novo Nordisk\", \"Moderna\"). Matched against the registered LEAD sponsor by default.",
    "type": "string"
   },
   "sponsor_match": {
    "description": "Which sponsor role the name must fill. \"lead\" (the default) returns only trials whose registered LEAD sponsor is that company. \"lead_or_collaborator\" also returns trials led by someone else that list the company as a collaborator \u2014 typically academic trials of the company's drug. Every returned study carries sponsor_match_field naming which one matched.",
    "enum": [
     "lead",
     "lead_or_collaborator"
    ],
    "type": "string"
   },
   "status": {
    "description": "Optional status filter",
    "type": "string"
   }
  },
  "required": [
   "sponsor"
  ],
  "type": "object"
 },
 "name": "ct_sponsor_trials",

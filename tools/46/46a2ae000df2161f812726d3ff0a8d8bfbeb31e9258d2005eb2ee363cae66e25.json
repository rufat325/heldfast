{
 "description": "Read an environment variable from the running simulator device (e.g., HOME, TMPDIR, PATH).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "variable": {
    "description": "Environment variable name to read (e.g., \"HOME\", \"TMPDIR\", \"PATH\")",
    "type": "string"
   }
  },
  "required": [
   "variable"
  ],
  "type": "object"
 },
 "name": "simulator_get_env"
}

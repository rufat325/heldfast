{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compute the cross-chart aspects between two people's natal charts \u2014 the\nclassic relationship-compatibility technique. Every aspect from person A's\nbodies/points to person B's is returned, along with both sets of positions.\n\nLocations are not needed: synastry aspects depend only on planetary positions.\n(House overlays would need both birth locations \u2014 compute the two natal charts\nseparately for that.)\n\nExample:\n  - { datetime_a: \"1990-03-15T15:45\", timezone_a: \"Europe/Riga\",\n      datetime_b: \"1992-07-22T08:30\", timezone_b: \"America/New_York\" }",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "datetime_a": {
    "description": "Person A's birth date and time.",
    "minLength": 4,
    "type": "string"
   },
   "datetime_b": {
    "description": "Person B's birth date and time.",
    "minLength": 4,
    "type": "string"
   },
   "timezone_a": {
    "description": "IANA timezone the datetime is local to, e.g. \"Europe/Riga\" or \"America/New_York\". Omit when the datetime already carries Z or a UTC offset.",
    "minLength": 1,
    "type": "string"
   },
   "timezone_b": {
    "description": "IANA timezone the datetime is local to, e.g. \"Europe/Riga\" or \"America/New_York\". Omit when the datetime already carries Z or a UTC offset.",
    "minLength": 1,
    "type": "string"
   },
   "zodiac": {
    "default": "tropical",
    "description": "Zodiac frame: tropical (Western default), sidereal-lahiri (Vedic), or sidereal-fagan-bradley (Western sidereal).",
    "enum": [
     "tropical",
     "sidereal-lahiri",
     "sidereal-fagan-bradley"
    ],
    "type": "string"
   }
  },
  "required": [
   "datetime_a",
   "datetime_b"
  ],
  "type": "object"
 },
 "name": "compute_synastry",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "angle": {
       "type": "number"
      },
      "aspect": {
       "type": "string"
      },
      "bodyA": {
       "type": "string"
      },
      "bodyB": {
       "type": "string"
      },
      "orb": {
       "type": "number"
      }
     },
     "required": [
      "bodyA",
      "bodyB",
      "aspect",
      "angle",
      "orb"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "positionsA": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "declination": {
       "type": "number"
      },
      "degreeInSign": {
       "type": "number"
      },
      "latitude": {
       "type": "number"
      },
      "longitude": {
       "type": "number"
      },
      "retrograde": {
       "type": "boolean"
      },
      "sign": {
       "type": "string"
      },
      "speed": {
       "type": "number"
      }
     },
     "required": [
      "body",
      "longitude",
      "sign",
      "degreeInSign",
      "speed",
      "retrograde",
      "declination",
      "latitude"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "positionsB": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "declination": {
       "type": "number"
      },
      "degreeInSign": {
       "type": "number"
      },
      "latitude": {
       "type": "number"
      },
      "longitude": {
       "type": "number"
      },
      "retrograde": {
       "type": "boolean"
      },
      "sign": {
       "type": "string"
      },
      "speed": {
       "type": "number"
      }
     },
     "required": [
      "body",
      "longitude",
      "sign",
      "degreeInSign",
      "speed",
      "retrograde",
      "declination",
      "latitude"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "aspects",
   "positionsA",
   "positionsB"
  ],
  "type": "object"
 },
 "title": "Compute Synastry"
}

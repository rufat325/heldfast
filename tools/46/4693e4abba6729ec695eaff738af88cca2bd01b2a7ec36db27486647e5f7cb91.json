{
 "description": "Search Belgian addresses using the official BeST public address API.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "boxNumber": {
    "description": "Optional box or apartment number",
    "type": "string"
   },
   "crs": {
    "description": "Coordinate reference system",
    "enum": [
     "wgs84",
     "lam72",
     "lam08"
    ],
    "type": "string"
   },
   "houseNumber": {
    "description": "House number",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of addresses to return",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "municipalityName": {
    "description": "Municipality name, e.g. Bruxelles",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Result page number",
    "minimum": 1,
    "type": "number"
   },
   "postCode": {
    "description": "Belgian postal code",
    "type": "string"
   },
   "radius": {
    "default": 100,
    "description": "Radius in meters when searching by coordinates",
    "maximum": 1000,
    "minimum": 1,
    "type": "number"
   },
   "streetName": {
    "description": "Street name",
    "type": "string"
   },
   "xLong": {
    "description": "Longitude or X coordinate",
    "type": "number"
   },
   "yLat": {
    "description": "Latitude or Y coordinate",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "best_search_addresses"
}

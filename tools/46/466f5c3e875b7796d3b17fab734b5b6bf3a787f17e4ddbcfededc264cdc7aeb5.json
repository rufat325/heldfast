{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Buyer"
 },
 "description": "Look up a single buyer by 0x address. Use when you have an address; for browsing the directory of sellers use list_providers. Returns trust score breakdown (volume/consistency/diversity/reliability), aggregate session stats, the last 20 recent settled sessions, and the buyer's top sellers by spend.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Buyer's on-chain address (0x + 40 hex chars)",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_buyer",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "qualified": {
    "description": "True when the buyer meets the network's Qualified threshold (\u22653 unique sellers).",
    "type": "boolean"
   },
   "recentSessions": {
    "items": {
     "properties": {
      "seller": {
       "pattern": "^0x[0-9a-fA-F]{40}$",
       "type": [
        "string",
        "null"
       ]
      },
      "service": {
       "description": "Service identifier \u2014 not currently indexed; always null in v0.2.",
       "type": [
        "string",
        "null"
       ]
      },
      "sessionId": {
       "description": "channel_id (bytes32 hex) when present",
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "description": "Event type (e.g. deposited, settled, ghost).",
       "type": "string"
      },
      "timestamp": {
       "description": "ISO timestamp",
       "type": [
        "string",
        "null"
       ]
      },
      "usdc": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "sessionId",
      "seller",
      "service",
      "status",
      "usdc",
      "timestamp"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "sessions": {
    "properties": {
     "monthlyVolume": {
      "items": {
       "properties": {
        "month": {
         "description": "YYYY-MM",
         "type": "string"
        },
        "sessions": {
         "type": "integer"
        },
        "volumeUsdc": {
         "type": "number"
        }
       },
       "required": [
        "month",
        "sessions",
        "volumeUsdc"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "settledUsdc": {
      "type": "number"
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "total",
     "settledUsdc",
     "monthlyVolume"
    ],
    "type": "object"
   },
   "topSellers": {
    "items": {
     "properties": {
      "address": {
       "pattern": "^0x[0-9a-fA-F]{40}$",
       "type": "string"
      },
      "displayName": {
       "type": [
        "string",
        "null"
       ]
      },
      "sessionCount": {
       "type": "integer"
      },
      "usdc": {
       "type": "number"
      }
     },
     "required": [
      "address",
      "sessionCount",
      "usdc"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "trustScore": {
    "properties": {
     "consistency": {
      "type": "number"
     },
     "diversity": {
      "type": "number"
     },
     "reliability": {
      "type": "number"
     },
     "total": {
      "type": "number"
     },
     "volume": {
      "type": "number"
     }
    },
    "required": [
     "total",
     "volume",
     "consistency",
     "diversity",
     "reliability"
    ],
    "type": "object"
   }
  },
  "required": [
   "address",
   "qualified",
   "trustScore",
   "sessions",
   "recentSessions",
   "topSellers"
  ],
  "type": "object"
 }
}

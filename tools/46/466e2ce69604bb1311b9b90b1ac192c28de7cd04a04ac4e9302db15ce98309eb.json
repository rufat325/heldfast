{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a flow"
 },
 "description": "Create a flow. Creates a DRAFT from a definition (see GET /flows/nodes for the catalogue). The definition is validated first: structure, per-node config, the plan's node cap, channel compatibility with the trigger source, keyword collisions with active flows, and references to custom fields, comment triggers and other flows (422 invalid_definition with errors[] and warnings[]). Nothing runs until you publish and activate. The visual builder lays the nodes out the first time the flow is opened.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channels": {
    "default": [
     "facebook",
     "instagram"
    ],
    "description": "Must be channels the trigger source can fire on.",
    "items": {
     "enum": [
      "facebook",
      "instagram",
      "whatsapp"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "definition": {
    "description": "A flow as a graph. Read GET /flows/nodes for every node type, port and config field.",
    "properties": {
     "edges": {
      "items": {
       "properties": {
        "from": {
         "type": "string"
        },
        "from_port": {
         "default": "output_1",
         "description": "One of the source node's output ports, for example output_1, output_2, output_timeout.",
         "type": "string"
        },
        "to": {
         "type": "string"
        },
        "to_port": {
         "default": "input_1",
         "enum": [
          "input_1"
         ],
         "type": "string"
        }
       },
       "required": [
        "from",
        "to"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "nodes": {
      "items": {
       "properties": {
        "config": {
         "description": "Per type; see GET /flows/nodes nodes.<type>.config.",
         "type": "object"
        },
        "id": {
         "description": "String id; \"1\" is the trigger.",
         "type": "string"
        },
        "type": {
         "enum": [
          "trigger",
          "message",
          "collect_input",
          "condition",
          "action",
          "delay",
          "ai_step",
          "ai_handoff",
          "randomizer",
          "book_appointment",
          "http_request",
          "goto_flow"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "type"
       ],
       "type": "object"
      },
      "minItems": 2,
      "type": "array"
     },
     "trigger": {
      "description": "What starts the flow. Also the config of node \"1\". Per-source fields are in GET /flows/nodes sources.*.config.",
      "properties": {
       "ad_ref": {
        "type": [
         "string",
         "null"
        ]
       },
       "comment_keywords": {
        "description": "comment source, native mode.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "comment_match_type": {
        "enum": [
         "contains",
         "exact"
        ],
        "type": "string"
       },
       "comment_post_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "comment_trigger_id": {
        "description": "comment source, linked mode: a standalone comment trigger id.",
        "type": [
         "integer",
         "null"
        ]
       },
       "intent_description": {
        "type": [
         "string",
         "null"
        ]
       },
       "keywords": {
        "description": "dm source: any of these starts the flow.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "match_type": {
        "default": "contains",
        "enum": [
         "contains",
         "exact"
        ],
        "type": "string"
       },
       "source": {
        "default": "dm",
        "enum": [
         "dm",
         "comment",
         "ad_referral",
         "story_mention",
         "story_reply",
         "ig_reel_share",
         "ig_post_share",
         "ig_unsupported_attachment",
         "image_received",
         "audio_received",
         "video_received",
         "file_received",
         "ai_intent"
        ],
        "type": "string"
       }
      },
      "required": [
       "source"
      ],
      "type": "object"
     }
    },
    "required": [
     "trigger",
     "nodes",
     "edges"
    ],
    "type": "object"
   },
   "name": {
    "maxLength": 100,
    "type": "string"
   },
   "tag_id": {
    "description": "Tag applied to people who enter the flow. Pro plans and above; ignored otherwise.",
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "required": [
   "name",
   "definition"
  ],
  "type": "object"
 },
 "name": "create_flow"
}

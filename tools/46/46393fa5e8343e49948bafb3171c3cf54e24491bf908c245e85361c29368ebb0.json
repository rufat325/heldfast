 "description": "Search DataCite-registered DOIs (research datasets, software, etc.). Filter by free-text query, resource type, year, publisher, or affiliation, and SORT by relevance, recency, citations, downloads, or views \u2014 e.g. \"most-downloaded climate datasets\" (sort=downloads), \"newest genomics datasets\" (sort=recent), \"most-cited datasets on X\" (sort=citations). Returns DOI, title, creators, publisher, type, year, and citation/download/view counts.",
 "inputSchema": {
  "examples": [
   {
    "query": "climate change temperature anomaly",
    "resource_type": "Dataset",
    "year": 2023
   },
   {
    "page": 1,
    "page_size": 50,
    "publisher": "Zenodo",
    "query": "machine learning",
    "resource_type": "Software"
   }
  ],
  "properties": {
   "affiliation": {
    "description": "Creator affiliation",
    "type": "string"
   },
   "page": {
    "description": "1-based page (default 1)",
    "type": "number"
   },
   "page_size": {
    "description": "1-1000 (default 25)",
    "type": "number"
   },
   "publisher": {
    "description": "Publisher name filter",
    "type": "string"
   },
   "query": {
    "description": "Free-text query (titles, descriptions, creators)",
    "type": "string"
   },
   "resource_type": {
    "description": "Dataset | Software | Text | Image | Sound | Other (case-sensitive)",
    "type": "string"
   },
   "sort": {
    "description": "Result ordering: relevance (default), recent (newest registered), oldest, published (newest publication year), citations (most-cited), downloads (most-downloaded), views (most-viewed).",
    "enum": [
     "relevance",
     "recent",
     "oldest",
     "published",
     "citations",
     "downloads",
     "views"
    ],
    "type": "string"
   },
   "year": {
    "description": "Publication year",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Unified query tool for refresh, filter, search, and sort operations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "graphql": {
    "maxLength": 65536,
    "type": "string"
   },
   "includeClosed": {
    "type": "boolean"
   },
   "mode": {
    "enum": [
     "status-priority-type-title",
     "updated",
     "created",
     "id"
    ],
    "type": "string"
   },
   "operation": {
    "default": "refresh",
    "enum": [
     "refresh",
     "filter",
     "search",
     "sort",
     "ready",
     "llm_context",
     "open_config",
     "graphql"
    ],
    "type": "string"
   },
   "search": {
    "maxLength": 1024,
    "type": "string"
   },
   "statuses": {
    "anyOf": [
     {
      "items": {
       "maxLength": 128,
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "tags": {
    "anyOf": [
     {
      "items": {
       "maxLength": 128,
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "types": {
    "anyOf": [
     {
      "items": {
       "maxLength": 128,
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "variables": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "writeToWorkspaceInstructions": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "beans_query",
 "title": "Query Beans"
}

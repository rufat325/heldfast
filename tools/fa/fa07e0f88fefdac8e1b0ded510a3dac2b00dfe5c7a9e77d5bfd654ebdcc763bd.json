{
 "description": "Update a WooCommerce product",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categories": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "description": {
    "type": "string"
   },
   "id": {
    "description": "Product ID",
    "type": "number"
   },
   "manage_stock": {
    "type": "boolean"
   },
   "meta_data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "key"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "regular_price": {
    "type": "string"
   },
   "sale_price": {
    "type": "string"
   },
   "short_description": {
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "sku": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "stock_quantity": {
    "type": "number"
   },
   "stock_status": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "number"
    },
    "type": "array"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "woo_update_product"
}

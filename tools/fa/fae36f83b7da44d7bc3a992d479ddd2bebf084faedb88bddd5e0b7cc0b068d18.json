 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "type": "string"
   },
   "confirm": {
    "type": "boolean"
   },
   "containerId": {
    "type": "string"
   },
   "name": {
    "description": "Version name/label.",
    "type": "string"
   },
   "notes": {
    "description": "Version notes / change description.",
    "type": "string"
   },
   "workspaceId": {
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "containerId",
   "workspaceId",
   "confirm"
  ],
  "type": "object"
 },
 "name": "versions_create"
}

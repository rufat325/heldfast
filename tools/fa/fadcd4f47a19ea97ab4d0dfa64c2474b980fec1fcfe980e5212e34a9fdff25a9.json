{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Publish a listing"
 },
 "description": "Publish a Cyclesite listing on the user's behalf. Multi-step: first call (no draftId) returns a phone-friendly photo upload URL; once 3+ photos are uploaded, the next call returns either step:'live' (listing is free, no payment needed) or step:'payment_required' with a Stripe Checkout URL. Idempotent \u2014 keep calling with the same draftId until step:'live'. Requires OAuth scope `listings:publish`. Example flow: user says 'sell my Trek Domane' \u2192 call publish_listing \u2192 assistant directs user to upload URL \u2192 user uploads \u2192 call again \u2192 step:'live' \u2192 seller receives a confirmation email with a 24h undo link.",
 "inputSchema": {
  "properties": {
   "batteryCycles": {
    "description": "Charge cycles as the seller reports them.",
    "type": "number"
   },
   "batteryHealthPercent": {
    "description": "Battery health as the seller reports it, 0-100.",
    "type": "number"
   },
   "brand": {
    "type": "string"
   },
   "category": {
    "enum": [
     "road",
     "mtb",
     "gravel",
     "hybrid",
     "ebike",
     "kids",
     "bmx",
     "folding",
     "city",
     "touring",
     "triathlon",
     "track",
     "cyclocross",
     "cargo",
     "adaptive",
     "other"
    ],
    "type": "string"
   },
   "city": {
    "description": "UK city.",
    "type": "string"
   },
   "condition": {
    "enum": [
     "Excellent",
     "Very_Good",
     "Good",
     "Fair",
     "Poor",
     "For_Parts"
    ],
    "type": "string"
   },
   "description": {
    "description": "Listing description (30-5000 chars).",
    "type": "string"
   },
   "draftId": {
    "description": "Returned by a previous call. Omit on first call.",
    "type": "string"
   },
   "ebikeBatteryWh": {
    "description": "Battery capacity in watt-hours (100-3000).",
    "type": "number"
   },
   "frameSerial": {
    "description": "Frame/serial number \u2014 runs a stolen-bike check before publish.",
    "type": "string"
   },
   "frameSize": {
    "type": "string"
   },
   "groupset": {
    "type": "string"
   },
   "isEbike": {
    "description": "True for an electric bike.",
    "type": "boolean"
   },
   "itemCondition": {
    "description": "Whether the bike is new (never ridden) or used. Defaults to used.",
    "enum": [
     "new",
     "used"
    ],
    "type": "string"
   },
   "knownIssues": {
    "type": "string"
   },
   "model": {
    "type": "string"
   },
   "motorBrand": {
    "description": "E-bike motor make, e.g. \"Bosch\", \"Shimano\", \"Bafang\".",
    "type": "string"
   },
   "motorModel": {
    "description": "E-bike motor model, e.g. \"Performance Line CX\".",
    "type": "string"
   },
   "motorPosition": {
    "enum": [
     "Mid-drive",
     "Rear hub",
     "Front hub"
    ],
    "type": "string"
   },
   "priceGbp": {
    "type": "number"
   },
   "rangeEstimateMiles": {
    "description": "Range the seller claims on one charge, in miles.",
    "type": "number"
   },
   "title": {
    "description": "Listing title (10-160 chars).",
    "type": "string"
   },
   "willShip": {
    "type": "boolean"
   },
   "year": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "publish_listing",
 "outputSchema": {
  "properties": {
   "draftId": {
    "format": "uuid",
    "type": "string"
   },
   "listingFeeGbp": {
    "description": "Price in GBP.",
    "type": "number"
   },
   "listingUrl": {
    "format": "uri",
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "paymentUrl": {
    "format": "uri",
    "type": "string"
   },
   "photoUploadUrl": {
    "format": "uri",
    "type": "string"
   },
   "photosNeeded": {
    "type": "number"
   },
   "step": {
    "enum": [
     "photos_required",
     "payment_required",
     "live"
    ],
    "type": "string"
   }
  },
  "required": [
   "step",
   "message"
  ],
  "type": "object"
 }
}

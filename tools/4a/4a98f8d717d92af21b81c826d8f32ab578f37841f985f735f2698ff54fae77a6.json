    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 2147483647,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "AniList user ID, or username."
   }
  },
  "required": [
   "user"
  ],
  "type": "object"
 },

{
 "_meta": {
  "anthropic/maxResultSizeChars": 500000
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search recent crypto developments using text and filters.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "activity": {
    "description": "Activity rows to include: all (default), source observations only, or none",
    "enum": [
     "all",
     "observations",
     "none"
    ],
    "type": "string"
   },
   "address": {
    "description": "Token contract address",
    "type": "string"
   },
   "assetTypes": {
    "description": "Comma-separated asset types; use get_vocabulary to list them",
    "type": "string"
   },
   "categories": {
    "description": "Comma-separated Intel category names; use get_vocabulary and choose intelCategories[].name",
    "type": "string"
   },
   "clusterIds": {
    "description": "Comma-separated cluster IDs",
    "type": "string"
   },
   "cursor": {
    "description": "Cursor returned in meta.nextCursor from the previous page",
    "type": "string"
   },
   "detectedAfter": {
    "description": "Detected at or after this time (ISO 8601)",
    "type": "string"
   },
   "detectedBefore": {
    "description": "Detected at or before this time (ISO 8601)",
    "type": "string"
   },
   "grades": {
    "type": "string"
   },
   "hasOfficialSource": {
    "description": "Set true to return only Intel with an official Project source",
    "type": "boolean"
   },
   "limit": {
    "description": "Results per page (default and maximum: 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "marketCap": {
    "description": "Only return Intel for Projects whose current market cap is in this band: low (under $80M), mid ($80M to $500M), or large ($500M and above). Projects without a current market cap are excluded",
    "enum": [
     "low",
     "mid",
     "large"
    ],
    "type": "string"
   },
   "minClusters": {
    "description": "Minimum number of community clusters represented",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "names": {
    "description": "Comma-separated Project names",
    "type": "string"
   },
   "projectIds": {
    "description": "Comma-separated Project IDs",
    "type": "string"
   },
   "projectRanking": {
    "description": "Only return Intel for Projects in the current trend ranking",
    "enum": [
     "trend"
    ],
    "type": "string"
   },
   "projectSlugs": {
    "description": "Comma-separated Project slugs",
    "type": "string"
   },
   "reinforcedAfter": {
    "description": "Reinforced at or after this time (ISO 8601)",
    "type": "string"
   },
   "reinforcedBefore": {
    "description": "Reinforced at or before this time (ISO 8601)",
    "type": "string"
   },
   "search": {
    "description": "Any text to match across Project identity and Intel content; combines with all filters",
    "type": "string"
   },
   "sentiments": {
    "description": "Comma-separated sentiments: positive, neutral, negative",
    "type": "string"
   },
   "sort": {
    "description": "Order by first detection (default) or latest reinforcement",
    "enum": [
     "reinforcedAt",
     "detectedAt"
    ],
    "type": "string"
   },
   "tickers": {
    "description": "Comma-separated tickers",
    "type": "string"
   },
   "xHandles": {
    "description": "Comma-separated X handles",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_intel",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "activity": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "action": {
          "enum": [
           "observation",
           "official_statement",
           "correction",
           "merge"
          ],
          "type": "string"
         },
         "clusters": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "id": {
             "type": "string"
            },
            "name": {
             "type": "string"
            }
           },
           "required": [
            "id",
            "name"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "detectedAt": {
          "type": "string"
         },
         "eventTime": {
          "oneOf": [
           {
            "additionalProperties": false,
            "properties": {
             "at": {
              "type": "string"
             },
             "precision": {
              "enum": [
               "instant",
               "day",
               "week",
               "month"
              ],
              "type": "string"
             },
             "relationToSource": {
              "enum": [
               "current",
               "historical",
               "future"
              ],
              "type": "string"
             },
             "status": {
              "const": "instant",
              "type": "string"
             }
            },
            "required": [
             "status",
             "at",
             "precision",
             "relationToSource"
            ],
            "type": "object"
           },
           {
            "additionalProperties": false,
            "properties": {
             "endAt": {
              "type": "string"
             },
             "precision": {
              "enum": [
               "day",
               "week",
               "month"
              ],
              "type": "string"
             },
             "relationToSource": {
              "enum": [
               "current",
               "historical",
               "future"
              ],
              "type": "string"
             },
             "startAt": {
              "type": "string"
             },
             "status": {
              "const": "interval",
              "type": "string"
             }
            },
            "required": [
             "status",
             "startAt",
             "endAt",
             "precision",
             "relationToSource"
            ],
            "type": "object"
           },
           {
            "additionalProperties": false,
            "properties": {
             "relationToSource": {
              "enum": [
               "before_post",
               "after_post",
               "around_post"
              ],
              "type": "string"
             },
             "status": {
              "const": "relative_unresolved",
              "type": "string"
             }
            },
            "required": [
             "status",
             "relationToSource"
            ],
            "type": "object"
           },
           {
            "additionalProperties": false,
            "properties": {
             "reason": {
              "enum": [
               "not_stated",
               "ambiguous",
               "ongoing"
              ],
              "type": "string"
             },
             "status": {
              "const": "unknown",
              "type": "string"
             }
            },
            "required": [
             "status",
             "reason"
            ],
            "type": "object"
           }
          ]
         },
         "headline": {
          "type": "string"
         },
         "occurredAt": {
          "type": "string"
         },
         "sentiment": {
          "additionalProperties": false,
          "properties": {
           "value": {
            "enum": [
             "positive",
             "neutral",
             "negative"
            ],
            "type": "string"
           }
          },
          "required": [
           "value"
          ],
          "type": "object"
         },
         "source": {
          "additionalProperties": false,
          "properties": {
           "official": {
            "type": "boolean"
           },
           "url": {
            "type": "string"
           }
          },
          "required": [
           "url",
           "official"
          ],
          "type": "object"
         }
        },
        "required": [
         "action",
         "detectedAt",
         "occurredAt"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "category": {
       "type": "string"
      },
      "citations": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "clusters": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "description": {
       "type": "string"
      },
      "detectedAt": {
       "type": "string"
      },
      "grade": {
       "enum": [
        "chipped",
        "flawed",
        "cut",
        "polished",
        "flawless"
       ],
       "type": "string"
      },
      "hasOfficialSource": {
       "type": "boolean"
      },
      "headline": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "observationCount": {
       "type": "number"
      },
      "officialSourceUrl": {
       "format": "uri",
       "type": "string"
      },
      "project": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "slug": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "slug",
        "name"
       ],
       "type": "object"
      },
      "reinforcedAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "searchMatches": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "excerpt": {
          "type": "string"
         },
         "kind": {
          "enum": [
           "contract_address",
           "canonical_chain",
           "current_official_x_handle",
           "project_identity",
           "asset_profile",
           "current_official_x_profile",
           "project_profile",
           "intel_text"
          ],
          "type": "string"
         },
         "term": {
          "type": "string"
         }
        },
        "required": [
         "kind",
         "term"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "sentiment": {
       "additionalProperties": false,
       "properties": {
        "value": {
         "enum": [
          "positive",
          "neutral",
          "negative"
         ],
         "type": "string"
        }
       },
       "required": [
        "value"
       ],
       "type": "object"
      }
     },
     "required": [
      "id",
      "description",
      "grade",
      "project",
      "category",
      "observationCount",
      "hasOfficialSource",
      "citations",
      "detectedAt",
      "reinforcedAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "executedSearch": {
      "description": "Normalized terms attempted within a bounded search",
      "type": "string"
     },
     "nextCursor": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "searchCoverage": {
      "description": "Present when responsiveness bounds may omit matching results",
      "enum": [
       "bounded_candidates",
       "bounded_recent",
       "bounded_candidates_recent"
      ],
      "type": "string"
     },
     "searchQuery": {
      "description": "Normalized query requested by the caller",
      "type": "string"
     }
    },
    "required": [
     "nextCursor"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "Search crypto intel"
}

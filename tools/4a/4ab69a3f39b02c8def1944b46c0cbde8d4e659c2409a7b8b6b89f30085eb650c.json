{
 "description": "Generate a UBL 2.1 PINT AE-shaped Invoice/CreditNote XML stub from invoice JSON. Runs the 51-field checklist first; with strict=true refuses to emit XML when mandatory applicable fields are incomplete.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "invoiceData": {
    "properties": {
     "allowanceTotal": {
      "type": "number"
     },
     "billingReference": {
      "description": "Original invoice id for credit notes",
      "type": "string"
     },
     "buyer": {
      "properties": {
       "addressLine": {
        "type": "string"
       },
       "cityOrEmirate": {
        "type": "string"
       },
       "contactName": {
        "type": "string"
       },
       "countryCode": {
        "type": "string"
       },
       "email": {
        "type": "string"
       },
       "legalName": {
        "type": "string"
       },
       "peppolId": {
        "type": "string"
       },
       "phone": {
        "type": "string"
       },
       "postalZone": {
        "type": "string"
       },
       "tin": {
        "type": "string"
       },
       "tradeName": {
        "type": "string"
       },
       "trn": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "buyerReference": {
      "type": "string"
     },
     "chargeTotal": {
      "type": "number"
     },
     "currencyCode": {
      "description": "Typically AED",
      "type": "string"
     },
     "customizationId": {
      "description": "PINT AE CustomizationID, e.g. urn:peppol:pint:billing-1@ae-1",
      "type": "string"
     },
     "documentType": {
      "description": "Defaults to tax_invoice",
      "enum": [
       "tax_invoice",
       "commercial_invoice",
       "credit_note"
      ],
      "type": "string"
     },
     "dueDate": {
      "type": "string"
     },
     "invoiceNumber": {
      "type": "string"
     },
     "issueDate": {
      "description": "ISO date YYYY-MM-DD",
      "type": "string"
     },
     "lineNetTotal": {
      "type": "number"
     },
     "lines": {
      "items": {
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "netAmount": {
         "type": "number"
        },
        "quantity": {
         "type": "number"
        },
        "taxCategoryCode": {
         "type": "string"
        },
        "taxPercent": {
         "type": "number"
        },
        "unitCode": {
         "type": "string"
        },
        "unitPrice": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "payableAmount": {
      "type": "number"
     },
     "periodEnd": {
      "type": "string"
     },
     "periodStart": {
      "type": "string"
     },
     "prepaidAmount": {
      "type": "number"
     },
     "profileId": {
      "type": "string"
     },
     "seller": {
      "properties": {
       "addressLine": {
        "type": "string"
       },
       "cityOrEmirate": {
        "type": "string"
       },
       "contactName": {
        "type": "string"
       },
       "countryCode": {
        "type": "string"
       },
       "email": {
        "type": "string"
       },
       "legalName": {
        "type": "string"
       },
       "peppolId": {
        "type": "string"
       },
       "phone": {
        "type": "string"
       },
       "postalZone": {
        "type": "string"
       },
       "tin": {
        "type": "string"
       },
       "tradeName": {
        "type": "string"
       },
       "trn": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "taxBreakdown": {
      "items": {
       "properties": {
        "exemptionReason": {
         "type": "string"
        },
        "exemptionReasonCode": {
         "type": "string"
        },
        "taxAmount": {
         "type": "number"
        },
        "taxCategoryCode": {
         "type": "string"
        },
        "taxPercent": {
         "type": "number"
        },
        "taxableAmount": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "taxCurrencyCode": {
      "type": "string"
     },
     "taxExclusiveTotal": {
      "type": "number"
     },
     "taxInclusiveTotal": {
      "type": "number"
     },
     "taxPointDate": {
      "type": "string"
     },
     "taxTotal": {
      "type": "number"
     },
     "taxTotalAed": {
      "type": "number"
     },
     "typeCode": {
      "description": "380 invoice / 381 credit note",
      "type": "string"
     }
    },
    "type": "object"
   },
   "strict": {
    "description": "If true, do not generate XML when checklist has gaps (default false)",
    "type": "boolean"
   }
  },
  "required": [
   "invoiceData"
  ],
  "type": "object"
 },
 "name": "generate_pint_ae_xml"
}

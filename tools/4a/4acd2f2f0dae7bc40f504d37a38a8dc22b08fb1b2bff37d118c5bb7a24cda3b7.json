{
 "description": "List all installed apps on the simulator with their bundle IDs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device UDID, name, or \"booted\" (default: booted)",
    "type": "string"
   },
   "includeSystem": {
    "description": "Include system apps (default: false)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "simulator_list_apps"
}

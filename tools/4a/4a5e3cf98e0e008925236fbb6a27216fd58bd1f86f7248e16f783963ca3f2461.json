    "type": "string"
   },
   "query": {
    "description": "Candidate name to search (e.g., \"Sanders\")",
    "type": "string"
   },
   "state": {
    "description": "Two-letter state code (e.g., \"CA\", \"NY\")",
    "type": "string"
   }
  },
  "required": [

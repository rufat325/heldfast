{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Validate Platform Publish Package"
 },
 "description": "Validate a rendered file plus title, description, hashtags, and content flags against one platform's approximate 2026 publish limits. Returns hard violations, soft warnings, normalized hashtags, and character counts. Local-only; never uploads or changes Premiere.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "audio_codec": {
    "description": "Audio codec name such as AAC.",
    "maxLength": 64,
    "type": "string"
   },
   "container": {
    "description": "Container extension such as mp4 or mov.",
    "maxLength": 32,
    "type": "string"
   },
   "content_flags": {
    "description": "Disclosure flags that trigger platform label reminders.",
    "items": {
     "description": "Content disclosure flag.",
     "enum": [
      "ai_generated",
      "paid_partnership",
      "music_licensed"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array",
    "uniqueItems": true
   },
   "description": {
    "description": "Post caption or description body.",
    "maxLength": 10000,
    "type": "string"
   },
   "duration_seconds": {
    "description": "Rendered file duration in seconds.",
    "maximum": 172800,
    "minimum": 0,
    "type": "number"
   },
   "file_size_bytes": {
    "description": "Rendered file size in bytes.",
    "maximum": 10000000000000,
    "minimum": 0,
    "type": "number"
   },
   "frame_rate": {
    "description": "Rendered frame rate in frames per second.",
    "maximum": 240,
    "minimum": 1,
    "type": "number"
   },
   "has_captions": {
    "description": "Whether captions are burned in or attached.",
    "type": "boolean"
   },
   "hashtags": {
    "description": "Hashtags to publish with the post.",
    "items": {
     "description": "One hashtag, ideally starting with '#'.",
     "maxLength": 150,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "height": {
    "description": "Rendered frame height in pixels.",
    "maximum": 16384,
    "minimum": 1,
    "type": "integer"
   },
   "platform": {
    "description": "Target platform id.",
    "enum": [
     "tiktok",
     "instagram_reels",
     "instagram_feed",
     "instagram_story",
     "youtube_shorts",
     "youtube",
     "linkedin",
     "x",
     "facebook_reels"
    ],
    "type": "string"
   },
   "title": {
    "description": "Post or video title.",
    "maxLength": 1000,
    "type": "string"
   },
   "video_codec": {
    "description": "Video codec name such as H.264.",
    "maxLength": 64,
    "type": "string"
   },
   "width": {
    "description": "Rendered frame width in pixels.",
    "maximum": 16384,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "platform",
   "duration_seconds",
   "width",
   "height",
   "frame_rate"
  ],
  "type": "object"
 },
 "name": "validate_platform_publish_package",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Validate Platform Publish Package"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Build a practical daily training/load summary from recent Strava activities. Read-only and non-medical.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "default": 7,
    "description": "Lookback window for recent training context.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "timezone": {
    "default": "UTC",
    "description": "IANA timezone used only for display, e.g. America/New_York.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "strava_daily_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "generated_at": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "daily_summary",
     "weekly_summary"
    ],
    "type": "string"
   }
  },
  "required": [
   "kind",
   "generated_at"
  ],
  "type": "object"
 },
 "title": "Strava Daily Training Summary"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get daily U.S. policy and money-market interest rates as a markdown table: Effective Fed Funds Rate, SOFR, Prime Rate, and benchmark Treasury yields (3M, 2Y, 10Y, 30Y) per date, newest first. Use for monetary-policy questions like 'Where is the Fed funds rate now?' or 'How has SOFR moved this quarter?', or to compare policy rates against long-end yields for inversion analysis. Covers up to 10 years of daily history. For the full Treasury curve across all maturities, use get_treasury_yields instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "default": 30,
    "description": "Number of days of history (default 30)",
    "maximum": 3650,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_fed_rates",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": [
        "string",
        "null"
       ]
      },
      "fed_funds_rate": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
      },
      "prime_rate": {
       "$ref": "#/properties/rows/items/properties/fed_funds_rate"
      },
      "sofr": {
       "$ref": "#/properties/rows/items/properties/fed_funds_rate"
      },
      "treasury_10y": {
       "$ref": "#/properties/rows/items/properties/fed_funds_rate"
      },
      "treasury_2y": {
       "$ref": "#/properties/rows/items/properties/fed_funds_rate"
      },
      "treasury_30y": {
       "$ref": "#/properties/rows/items/properties/fed_funds_rate"
      },
      "treasury_3m": {
       "$ref": "#/properties/rows/items/properties/fed_funds_rate"
      }
     },
     "required": [
      "date",
      "fed_funds_rate",
      "sofr",
      "prime_rate",
      "treasury_3m",
      "treasury_2y",
      "treasury_10y",
      "treasury_30y"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "unit": {
    "const": "percent",
    "type": "string"
   }
  },
  "required": [
   "unit",
   "rows"
  ],
  "type": "object"
 }
}

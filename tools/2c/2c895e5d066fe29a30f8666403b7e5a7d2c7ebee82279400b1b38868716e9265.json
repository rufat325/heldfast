{
 "description": "Full-text search over titles, summaries and tags. Use this first when you know a name.",
 "inputSchema": {
  "properties": {
   "bbox": {
    "description": "west,south,east,north; west > east crosses the antimeridian",
    "type": "string"
   },
   "collection": {
    "description": "Collection slug",
    "type": "string"
   },
   "kind": {
    "description": "Item kind",
    "type": "string"
   },
   "lat": {
    "description": "Query center latitude; requires long",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "description": "Default 20, max 100",
    "type": "integer"
   },
   "long": {
    "description": "Query center longitude; requires lat",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "q": {
    "description": "Query",
    "type": "string"
   },
   "radius": {
    "description": "Default 10; maximum 1000 km",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "sort": {
    "enum": [
     "id",
     "published",
     "updated",
     "distance"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Default km",
    "enum": [
     "km",
     "mi"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_items"
}

{
 "description": "Update an existing Xero contact. POSTs to /Contacts/{ContactID}. Only include fields you want changed; Xero merges updates.",
 "inputSchema": {
  "properties": {
   "AccountNumber": {
    "description": "Merchant-side account number.",
    "type": "string"
   },
   "Addresses": {
    "description": "Addresses array (replaces existing).",
    "type": "array"
   },
   "ContactID": {
    "description": "Xero Contact UUID to update.",
    "type": "string"
   },
   "ContactNumber": {
    "description": "External system identifier.",
    "type": "string"
   },
   "DefaultCurrency": {
    "description": "ISO-4217 default currency.",
    "type": "string"
   },
   "EmailAddress": {
    "description": "Primary email address.",
    "type": "string"
   },
   "FirstName": {
    "description": "Contact first name.",
    "type": "string"
   },
   "LastName": {
    "description": "Contact last name.",
    "type": "string"
   },
   "Name": {
    "description": "Updated name (must remain unique within tenant).",
    "type": "string"
   },
   "Phones": {
    "description": "Phones array (replaces existing).",
    "type": "array"
   },
   "TaxNumber": {
    "description": "Tax number (VAT/ABN/GST/EIN).",
    "type": "string"
   }
  },
  "required": [
   "ContactID"
  ],
  "type": "object"
 },
 "name": "update_contact"
}

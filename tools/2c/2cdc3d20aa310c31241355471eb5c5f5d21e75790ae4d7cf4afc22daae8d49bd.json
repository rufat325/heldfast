{
 "description": "Check normalized SPF, DKIM, DMARC, and MX evidence for missing, conflicting, invalid, or monitor-only authentication policy. Costs $0.05 USDC on Base mainnet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "domain": {
    "type": "string"
   },
   "observed_at": {
    "format": "date-time",
    "type": "string"
   },
   "records": {
    "additionalProperties": false,
    "properties": {
     "dkim": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "selector": {
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "selector",
        "value"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "dmarc": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "mx": {
      "items": {
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "spf": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     }
    },
    "required": [
     "spf",
     "dkim",
     "dmarc",
     "mx"
    ],
    "type": "object"
   }
  },
  "required": [
   "domain",
   "observed_at",
   "records"
  ],
  "type": "object"
 },
 "name": "justhandled_email_dns_auth_evidence_check"
}

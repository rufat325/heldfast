{
 "description": "Updates an existing identity by ID. Only the fields you provide are changed.",
 "inputSchema": {
  "properties": {
   "alwaysDo": {
    "description": "Things to always do.",
    "type": "string"
   },
   "audience": {
    "description": "Intended audience.",
    "type": "string"
   },
   "background": {
    "description": "Background information.",
    "type": "string"
   },
   "brandColors": {
    "description": "Brand colours.",
    "type": "string"
   },
   "brandVisuals": {
    "description": "Visual style description.",
    "type": "string"
   },
   "identityId": {
    "description": "The ID of the identity to update.",
    "type": "string"
   },
   "linkedLibraryIds": {
    "description": "Context library IDs to link.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Identity name.",
    "type": "string"
   },
   "neverDo": {
    "description": "Things to never do.",
    "type": "string"
   },
   "recurringTopics": {
    "description": "Recurring topics.",
    "type": "string"
   },
   "roleContext": {
    "description": "Role and context description.",
    "type": "string"
   },
   "scope": {
    "description": "user: personal (only visible to you); workspace: shared with all members.",
    "enum": [
     "user",
     "workspace"
    ],
    "type": "string"
   },
   "type": {
    "description": "Identity type: person, company, or hybrid.",
    "enum": [
     "person",
     "company",
     "hybrid"
    ],
    "type": "string"
   },
   "valuesPriorities": {
    "description": "Values and priorities.",
    "type": "string"
   },
   "voiceDescriptors": {
    "description": "Voice and tone descriptors (e.g. \"concise, direct, warm\").",
    "type": "string"
   },
   "workspaceId": {
    "description": "Workspace ID. If not provided, uses your default workspace.",
    "type": "string"
   },
   "writingSamples": {
    "description": "Writing samples.",
    "type": "string"
   }
  },
  "required": [
   "identityId"
  ],
  "type": "object"
 },
 "name": "update_identity"
}

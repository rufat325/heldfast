{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Return the current stored KIP config so it can be kept as a backup before changes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "configName": {
    "type": "string"
   },
   "fileVersion": {
    "type": "number"
   },
   "scope": {
    "enum": [
     "user",
     "global"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "backup_kip_config",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backup": {},
   "exists": {
    "type": "boolean"
   }
  },
  "required": [
   "exists"
  ],
  "type": "object"
 },
 "title": "Back up KIP config"
}

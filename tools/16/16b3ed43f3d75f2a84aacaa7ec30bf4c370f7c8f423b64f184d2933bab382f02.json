{
 "description": "Assign taxonomy terms to a post",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "append": {
    "default": false,
    "description": "Append to existing terms (false = replace)",
    "type": "boolean"
   },
   "post_id": {
    "description": "Post ID",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "taxonomy": {
    "description": "Taxonomy name",
    "type": "string"
   },
   "terms": {
    "description": "Array of term IDs",
    "items": {
     "type": "number"
    },
    "type": "array"
   }
  },
  "required": [
   "site",
   "post_id",
   "taxonomy",
   "terms"
  ],
  "type": "object"
 },
 "name": "mcp_assign_terms"
}

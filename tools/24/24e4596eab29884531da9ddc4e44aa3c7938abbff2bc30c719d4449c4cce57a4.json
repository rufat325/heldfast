{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Replaces a node\u2019s effects with the list you give. An empty list clears them. Elevation in most design systems is a drop shadow, so this is what \"make it look raised\" means.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "effects": {
    "description": "In back-to-front order. Empty clears every effect.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "alpha": {
       "description": "Shadow opacity. Default 0.25.",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "color": {
       "description": "Hex colour of the shadow. Default black.",
       "type": "string"
      },
      "offsetX": {
       "description": "Default 0.",
       "type": "number"
      },
      "offsetY": {
       "description": "Default 2.",
       "type": "number"
      },
      "radius": {
       "description": "Blur radius. Default 4.",
       "minimum": 0,
       "type": "number"
      },
      "spread": {
       "description": "Default 0.",
       "type": "number"
      },
      "type": {
       "enum": [
        "DROP_SHADOW",
        "INNER_SHADOW",
        "LAYER_BLUR",
        "BACKGROUND_BLUR"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nodeId": {
    "description": "Figma node id, like \"21:10314\". Omit to use whatever is selected on the canvas.",
    "type": "string"
   }
  },
  "required": [
   "nodeId",
   "effects"
  ],
  "type": "object"
 },
 "name": "figma_set_effects",
 "title": "Set shadows and blurs"
}

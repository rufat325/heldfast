{
 "description": "Get details about a Printr token by its telecoin ID or CAIP-10 contract address. Returns name, symbol, description, image, creator addresses, deployed chains, bonding curve properties, and external links.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Telecoin ID (hex, e.g. '0x3a7a8d...') or CAIP-10 address (e.g. 'eip155:8453:0x742d...')",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "printr_get_token",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chains": {
    "description": "CAIP-2 chain IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "creatorAddresses": {
    "description": "CAIP-10 creator addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "curveProperties": {
    "additionalProperties": false,
    "properties": {
     "basePairAddresses": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "completionThresholdBasisPoints": {
      "type": "number"
     },
     "graduationThresholdRefAtomic": {
      "type": "string"
     },
     "homeChain": {
      "description": "Home chain (CAIP-2)",
      "type": "string"
     },
     "initialPriceRefAtomic": {
      "type": "string"
     },
     "maxSupplyExponent": {
      "description": "8 = 100M, 9 = 1B, 10 = 10B",
      "type": "number"
     },
     "referenceAssetId": {
      "type": "string"
     }
    },
    "required": [
     "homeChain",
     "basePairAddresses",
     "referenceAssetId",
     "maxSupplyExponent",
     "completionThresholdBasisPoints",
     "graduationThresholdRefAtomic",
     "initialPriceRefAtomic"
    ],
    "type": "object"
   },
   "description": {
    "type": "string"
   },
   "externalLinks": {
    "additionalProperties": false,
    "properties": {
     "github": {
      "type": "string"
     },
     "telegram": {
      "type": "string"
     },
     "website": {
      "type": "string"
     },
     "x": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "id": {
    "description": "Telecoin ID (hex)",
    "type": "string"
   },
   "imageUrl": {
    "description": "URL to token image",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "symbol": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "symbol",
   "description",
   "imageUrl",
   "creatorAddresses",
   "chains",
   "curveProperties"
  ],
  "type": "object"
 }
}

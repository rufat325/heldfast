{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false,
  "title": "Revoke a signing key"
 },
 "description": "Mark a key revoked from now on. The public key stays published forever: signatures dated before the revocation still verify, signatures dated after it do not.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "kid": {
    "description": "The key identifier to revoke.",
    "minLength": 4,
    "type": "string"
   },
   "reason": {
    "description": "Why the key is being revoked.",
    "maxLength": 280,
    "minLength": 1,
    "type": "string"
   },
   "worker_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "worker_id",
   "kid",
   "reason"
  ],
  "type": "object"
 },
 "name": "revoke_worker_key",
 "title": "Revoke a signing key"
}

       ]
      },
      "experience": {
       "type": [
        "number",
        "null"
       ]
      },
      "goldPerKill": {
       "description": "Estimated gross loot value at NPC prices. Drops without a recorded chance are left out, and items that sell only on the market count as 0.",
       "type": [
        "number",
        "null"
       ]
      },
      "hitpoints": {
       "type": [
        "number",
        "null"
       ]
      },
      "isBoss": {
       "type": "boolean"
      },
      "modifiers": {
       "additionalProperties": {
        "type": [
         "number",
         "null"
        ]
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "name": {
       "description": "Name as the game prints it.",
       "type": [
        "string",
        "null"
       ]
      },
      "paralysable": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "pushable": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "runsAt": {
       "description": "Hit points at which it flees. 0: never flees.",
       "type": [
        "number",
        "null"
       ]
      },
      "seesInvisible": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "summonCost": {
       "description": "Mana. 0: cannot be summoned.",
       "type": [
        "number",
        "null"
       ]
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "name",
      "hitpoints",
      "experience",
      "bestiaryClass",
      "isBoss",
      "modifiers",
      "runsAt",
      "seesInvisible",
      "paralysable",
      "pushable",
      "summonCost",
      "convinceCost",
      "goldPerKill"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalMatches": {
    "type": "number"
   }
  },
  "required": [
   "results",
   "totalMatches",
   "indexGeneratedAt"
  ],
  "type": "object"
 }
}

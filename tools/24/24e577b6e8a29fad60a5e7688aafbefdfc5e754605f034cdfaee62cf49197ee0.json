{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find Tibia creatures matching stat filters. Damage modifiers are percentages where 100 is neutral: \"weak_to\" means the creature takes MORE than 100% damage from that element, \"resistant_to\" means less. Use this for questions like \"which creatures are weak to fire and give over 500 experience\". Behaviour filters skip creatures whose value is unrecorded.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bestiary_class": {
    "description": "e.g. \"Dragon\", \"Human\".",
    "type": "string"
   },
   "bestiary_level": {
    "description": "Creatures with no recorded bestiary level are excluded from this filter.",
    "enum": [
     "harmless",
     "trivial",
     "easy",
     "medium",
     "hard",
     "challenging"
    ],
    "type": "string"
   },
   "convinceable": {
    "description": "true: convince cost above 0. false: 0.",
    "type": "boolean"
   },
   "cursor": {
    "type": "string"
   },
   "experience_max": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "experience_min": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "hitpoints_max": {
    "description": "Creatures whose hitpoints are unrecorded are excluded from this filter.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "hitpoints_min": {
    "description": "Creatures whose hitpoints are unrecorded are excluded from this filter.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "include_inactive": {
    "default": false,
    "type": "boolean"
   },
   "is_boss": {
    "type": "boolean"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "location_contains": {
    "description": "Substring of the location text.",
    "type": "string"
   },
   "paralysable": {
    "type": "boolean"
   },
   "pushable": {
    "type": "boolean"
   },
   "resistant_to": {
    "items": {
     "enum": [
      "physical",
      "earth",
      "fire",
      "ice",
      "energy",
      "death",
      "holy",
      "drown",
      "lifedrain",
      "healing"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "sees_invisible": {
    "type": "boolean"
   },
   "sort": {
    "default": "experience",
    "description": "experience, hitpoints and gold_per_kill: highest first.",
    "enum": [
     "experience",
     "hitpoints",
     "title",
     "gold_per_kill"
    ],
    "type": "string"
   },
   "summonable": {
    "description": "true: summon cost above 0. false: 0.",
    "type": "boolean"
   },
   "weak_to": {
    "description": "Elements the creature takes extra damage from.",
    "items": {
     "enum": [
      "physical",
      "earth",
      "fire",
      "ice",
      "energy",
      "death",
      "holy",
      "drown",
      "lifedrain",
      "healing"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "tibia_find_creatures",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "indexGeneratedAt": {
    "type": "string"
   },
   "nextCursor": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bestiaryClass": {
       "type": [
        "string",
        "null"
       ]
      },
      "convinceCost": {
       "description": "Mana. 0: cannot be convinced.",

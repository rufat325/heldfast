{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage feature dependencies. Methods: add, remove, get_graph",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dep_type": {
    "description": "Dependency type (for: add)",
    "enum": [
     "blocks",
     "relates_to"
    ],
    "type": "string"
   },
   "dependency_id": {
    "description": "Dependency ID (required for: remove)",
    "type": "string"
   },
   "depends_on_id": {
    "description": "Depends-on feature ID (required for: add)",
    "type": "string"
   },
   "feature_id": {
    "description": "Feature ID (required for: add)",
    "type": "string"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "add",
     "remove",
     "get_graph"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (for: add, get_graph \u2014 auto-detected if omitted)",
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "dependencies"
}

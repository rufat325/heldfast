{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "UPDATE a Robinhood Chain coordination alert rule (PATCH \u2014 this writes). Send only the fields you want changed; is_active:false pauses the rule without deleting it. The min_mc_usd <= max_mc_usd check is only applied when BOTH bounds arrive in the same call, so send both together when narrowing a band. Pass null for name, webhook_url, min_mc_usd or max_mc_usd to clear them. Tier: PRO+.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cooldown_min": {
    "description": "Silence per (rule, token) in minutes (1-1440)",
    "maximum": 1440,
    "minimum": 1,
    "type": "integer"
   },
   "delivery_mode": {
    "description": "Where fires are delivered",
    "enum": [
     "websocket",
     "webhook",
     "both"
    ],
    "type": "string"
   },
   "id": {
    "description": "Coordination rule id (UUID)",
    "type": "string"
   },
   "is_active": {
    "description": "false pauses the rule without deleting it",
    "type": "boolean"
   },
   "max_mc_usd": {
    "anyOf": [
     {
      "maximum": 1000000000000,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Maximum market cap, or null to clear the ceiling"
   },
   "min_kols": {
    "description": "Minimum distinct KOL buyers (2-50)",
    "maximum": 50,
    "minimum": 2,
    "type": "integer"
   },
   "min_mc_usd": {
    "anyOf": [
     {
      "maximum": 1000000000000,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum market cap, or null to clear the floor"
   },
   "min_score": {
    "description": "Minimum composite score 0-100",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "anyOf": [
     {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "New label, or null to clear"
   },
   "score_jump_break": {
    "description": "Re-fire threshold in score points (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "webhook_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "New HTTPS webhook URL, or null to clear"
   },
   "window_minutes": {
    "description": "Rolling cluster window in minutes (1-60)",
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "rhc_coordination_alerts_update"
}

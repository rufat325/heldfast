   },
   {
    "mbid": "79239b12-edad-4280-a524-8344d868a69e"
   },
   {
    "mbid": "79239b12-edad-4280-a524-8344d868a69e",
    "p": 2
   }
  ],
  "properties": {
   "artist_name": {
    "description": "Band or performer name, e.g. \"Radiohead\". Either this or mbid is required.",

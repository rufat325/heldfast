{
 "_meta": {
  "category": "capture",
  "examples": [
   "Capture a full-page PNG of https://snapshot-site.com",
   "Render a PDF invoice page and return the download URL"
  ]
 },
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Capture Screenshot"
 },
 "description": "Capture a live webpage with Snapshot Site. Use this for screenshots, PDFs, HTML capture, device-sized renders, cookie hiding, custom JS injection, and export retrieval.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "convert": {
    "type": "boolean"
   },
   "country": {
    "type": "string"
   },
   "delay": {
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "format": {
    "enum": [
     "png",
     "jpeg",
     "jpg",
     "webp",
     "pdf",
     "base64",
     "html"
    ],
    "type": "string"
   },
   "fullSize": {
    "type": "boolean"
   },
   "height": {
    "maximum": 9999,
    "minimum": 100,
    "type": "integer"
   },
   "hide": {
    "type": "string"
   },
   "hideCookie": {
    "type": "boolean"
   },
   "javascriptCode": {
    "type": "string"
   },
   "language": {
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "width": {
    "maximum": 9999,
    "minimum": 100,
    "type": "integer"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "screenshot",
 "title": "Capture Screenshot"
}

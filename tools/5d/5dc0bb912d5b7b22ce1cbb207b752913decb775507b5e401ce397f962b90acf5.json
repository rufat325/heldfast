 "description": "Get full version history for a Ruby gem. Returns every published version with release date, download count, Ruby version compatibility, and licenses. Use for \"what versions of X exist?\" or \"when did Y release version Z?\".",
 "inputSchema": {
  "examples": [
   {
    "name": "rails"
   },
   {
    "limit": 50,
    "name": "rspec"
   }
  ],
  "properties": {
   "limit": {
    "description": "Max versions to return (default 25, max 200). Latest first.",
    "type": "number"
   },
   "name": {
    "description": "Gem name (e.g., \"rails\")",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_versions",
 "outputSchema": {
  "properties": {

{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Export redirects"
 },
 "description": "Export URL mappings (old URL \u2192 new WordPress URL) for all published pages. Two formats: 'redirection' (John Godley plugin JSON) or 'rankmath' (Rank Math import). In plugin mode this is unnecessary because URL mappings are pushed automatically during publish.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "format": {
    "description": "Export format: 'redirection' (default) or 'rankmath'.",
    "enum": [
     "redirection",
     "rankmath"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Project UUID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "project_id"
  ],
  "type": "object"
 },
 "name": "export_redirects"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Event Series"
 },
 "description": "Turn an existing event into a recurring series \u2014 pattern (daily/weekly/biweekly/monthly) + end (end_after total occurrences, or end_date). The source becomes occurrence 1; the rest are created on cadence with its tickets/promo/forms replayed. Requires source_event_id + pattern; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "end_after": {
    "maximum": 52,
    "minimum": 2,
    "type": "integer"
   },
   "end_date": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "pattern": {
    "enum": [
     "daily",
     "weekly",
     "biweekly",
     "monthly"
    ],
    "type": "string"
   },
   "source_event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "source_event_id",
   "pattern"
  ],
  "type": "object"
 },
 "name": "create_event_series",
 "title": "Create Event Series"
}

{
 "description": "Generate a @mostajs/orm EntitySchema (TypeScript) from an entity name + fields (+ optional relations). Returns ready-to-paste TS and runs the 24-rule validator on the result.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collection": {
    "description": "Table/collection name; defaults to lowercased name + \"s\"",
    "type": "string"
   },
   "fields": {
    "description": "Field definitions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "default": {},
      "name": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "type": {
       "enum": [
        "string",
        "text",
        "number",
        "boolean",
        "date",
        "json",
        "array"
       ],
       "type": "string"
      },
      "unique": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Entity name in PascalCase, e.g. \"Post\"",
    "type": "string"
   },
   "relations": {
    "description": "Relations to other entities",
    "items": {
     "additionalProperties": false,
     "properties": {
      "mappedBy": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "onDelete": {
       "enum": [
        "cascade",
        "set-null",
        "restrict",
        "no-action"
       ],
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "target": {
       "type": "string"
      },
      "type": {
       "enum": [
        "one-to-one",
        "one-to-many",
        "many-to-one",
        "many-to-many"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "target",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "softDelete": {
    "description": "Enable soft delete (deletedAt + auto-filter)",
    "type": "boolean"
   },
   "timestamps": {
    "description": "Auto-manage createdAt/updatedAt (default true)",
    "type": "boolean"
   }
  },
  "required": [
   "name",
   "fields"
  ],
  "type": "object"
 },
 "name": "mostajs_generate_schema"
}

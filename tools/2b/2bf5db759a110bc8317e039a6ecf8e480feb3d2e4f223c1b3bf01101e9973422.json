{
 "description": "Request payment authorization with scoped limits. Returns an authorization token that can be used to execute the payment.",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Payment amount (e.g. '25.00')",
    "type": "string"
   },
   "currency": {
    "description": "Currency code (e.g. 'USD')",
    "type": "string"
   },
   "expiresIn": {
    "description": "Authorization validity in seconds (default: 3600)",
    "type": "number"
   },
   "metadata": {
    "description": "Custom metadata key-value pairs",
    "type": "object"
   },
   "paymentMethod": {
    "description": "Preferred payment method",
    "enum": [
     "card",
     "bank_transfer",
     "wallet",
     "x402"
    ],
    "type": "string"
   },
   "purpose": {
    "description": "Payment purpose / description",
    "type": "string"
   },
   "recipientAgentId": {
    "description": "Recipient agent ID",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "currency",
   "recipientAgentId",
   "purpose"
  ],
  "type": "object"
 },
 "name": "authorize_payment"
}

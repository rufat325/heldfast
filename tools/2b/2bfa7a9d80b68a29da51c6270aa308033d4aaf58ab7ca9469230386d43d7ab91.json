{
 "description": "Verify that requests matching criteria were received by MockServer. Returns verification result with match count.",
 "inputSchema": {
  "properties": {
   "httpRequest": {
    "description": "Request matching criteria",
    "properties": {
     "body": {
      "description": "Body matcher configuration",
      "properties": {
       "matchType": {
        "enum": [
         "STRICT",
         "ONLY_MATCHING_FIELDS"
        ],
        "type": "string"
       },
       "type": {
        "enum": [
         "STRING",
         "JSON",
         "REGEX",
         "XPATH",
         "JSON_PATH"
        ],
        "type": "string"
       },
       "value": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "headers": {
      "description": "Headers to match",
      "type": "object"
     },
     "method": {
      "description": "HTTP method to match",
      "type": "string"
     },
     "path": {
      "description": "URL path to match",
      "type": "string"
     },
     "pathParameters": {
      "description": "Path parameters to match",
      "type": "object"
     },
     "queryStringParameters": {
      "description": "Query string parameters to match",
      "type": "object"
     }
    },
    "type": "object"
   },
   "times": {
    "description": "Expected number of matching requests",
    "properties": {
     "atLeast": {
      "description": "Minimum number of expected requests",
      "type": "number"
     },
     "atMost": {
      "description": "Maximum number of expected requests",
      "type": "number"
     },
     "exactly": {
      "description": "Exact number of expected requests",
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "httpRequest"
  ],
  "type": "object"
 },
 "name": "mockserver_verify"
}

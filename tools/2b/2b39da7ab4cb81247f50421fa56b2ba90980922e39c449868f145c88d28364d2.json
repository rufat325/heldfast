{
 "description": "Encrypt and store a fact (server-sealed). Same as REST operation store with value.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fact_key": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "user_id": {
    "description": "Logical scope (same string you use when calling HTTPS). Omit for \"\".",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "value": {
    "maxLength": 100000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "fact_key",
   "value"
  ],
  "type": "object"
 },
 "name": "zkshare_store"
}

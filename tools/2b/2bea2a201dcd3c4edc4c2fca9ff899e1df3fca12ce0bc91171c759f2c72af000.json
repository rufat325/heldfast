{
 "description": "What a feed selects, newest first. Page with before_id.",
 "inputSchema": {
  "properties": {
   "bbox": {
    "description": "west,south,east,north; west > east crosses the antimeridian",
    "type": "string"
   },
   "before_id": {
    "description": "Keyset cursor; cannot combine with distance sorting",
    "type": "integer"
   },
   "feed": {
    "description": "Feed slug",
    "type": "string"
   },
   "lat": {
    "description": "Query center latitude; requires long",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "description": "Default 30, max 200",
    "type": "integer"
   },
   "long": {
    "description": "Query center longitude; requires lat",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "offset": {
    "description": "Distance pagination offset",
    "type": "integer"
   },
   "radius": {
    "description": "Default 10; maximum 1000 km",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "sort": {
    "enum": [
     "id",
     "published",
     "updated",
     "distance"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Default km",
    "enum": [
     "km",
     "mi"
    ],
    "type": "string"
   }
  },
  "required": [
   "feed"
  ],
  "type": "object"
 },
 "name": "feed_items"
}

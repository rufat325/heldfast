{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search individual stock trades disclosed by U.S. Congress members (House and Senate) under the STOCK Act. Returns a markdown table of transactions: member name, chamber, ticker, buy/sell type, transaction date, disclosure date (the gap between the two reveals reporting delay), dollar amount range, and owner (self/spouse/joint). Use for questions like 'What did Nancy Pelosi trade recently?', 'Which members bought NVDA?', or 'Show the largest Senate trades this quarter'. Filter by chamber, ticker, or member name; sort by traded value, trade count, or recency. For one member's profile and complete trading history, use get_congress_member instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chamber": {
    "default": "all",
    "description": "Congressional chamber: house, senate, or all (default all)",
    "enum": [
     "house",
     "senate",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Trades per page, 1-50 (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number for pagination (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Full or partial member name, e.g. 'Pelosi' or 'Dan Crenshaw'",
    "maxLength": 200,
    "type": "string"
   },
   "sort": {
    "default": "volume",
    "description": "Sort order \u2014 volume (most traded value), trades (most trades), recent (latest first)",
    "enum": [
     "volume",
     "trades",
     "recent"
    ],
    "type": "string"
   },
   "ticker": {
    "description": "Stock ticker symbol to filter by, e.g. NVDA or AAPL",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_congress_trades",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "properties": {
     "chamber": {
      "type": [
       "string",
       "null"
      ]
     },
     "search": {
      "$ref": "#/properties/filters/properties/chamber"
     },
     "sort": {
      "$ref": "#/properties/filters/properties/chamber"
     },
     "ticker": {
      "$ref": "#/properties/filters/properties/chamber"
     }
    },
    "required": [
     "chamber",
     "ticker",
     "search",
     "sort"
    ],
    "type": "object"
   },
   "paging": {
    "additionalProperties": false,
    "description": "Paging state reconciled from ko.io meta.total_count and meta.softwall",
    "properties": {
     "continuation": {
      "description": "SIGNIN_REQUIRED = page>1 needs a (free) ko.io API key",
      "type": [
       "string",
       "null"
      ]
     },
     "has_more": {
      "description": "null = a full page came back and more MAY exist",
      "type": [
       "boolean",
       "null"
      ]
     },
     "next_page": {
      "anyOf": [
       {
        "$ref": "#/properties/paging/properties/total_count/anyOf/0"
       },
       {
        "type": "null"
       }
      ],
      "description": "Next page THIS caller can open; null when there is none (or sign-in is required)"
     },
     "page": {
      "type": "integer"
     },
     "per_page": {
      "type": "integer"
     },
     "plan_row_cap": {
      "anyOf": [
       {
        "$ref": "#/properties/paging/properties/total_count/anyOf/0"
       },
       {
        "type": "null"
       }
      ],
      "description": "Row cap the caller's plan applied to this page, if any"
     },
     "returned": {
      "type": "integer"
     },
     "total_count": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Total rows matching the request, when ko.io reported it"
     },
     "truncated_by_plan": {
      "description": "True when the plan's row cap withheld rows from this page",
      "type": "boolean"
     }
    },
    "required": [
     "page",
     "per_page",
     "returned",
     "total_count",
     "has_more",
     "next_page",
     "continuation",
     "plan_row_cap",
     "truncated_by_plan"
    ],
    "type": "object"
   },
   "plan_limit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "continuation": {
        "$ref": "#/properties/filters/properties/chamber"
       },
       "date_basis": {
        "$ref": "#/properties/filters/properties/chamber"
       },
       "effective_period": {
        "$ref": "#/properties/filters/properties/chamber"
       },
       "policy_version": {
        "$ref": "#/properties/filters/properties/chamber"
       },
       "row_cap": {
        "anyOf": [
         {
          "$ref": "#/properties/paging/properties/total_count/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "truncated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "window_end": {
        "$ref": "#/properties/filters/properties/chamber"
       },
       "window_start": {
        "$ref": "#/properties/filters/properties/chamber"
       }
      },
      "required": [
       "policy_version",
       "window_start",
       "window_end",
       "effective_period",
       "date_basis",
       "row_cap",
       "truncated",
       "continuation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The Free/keyless plan limits ko.io applied to this answer (null for paid callers)"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount_range": {
       "description": "The disclosed dollar RANGE (STOCK Act bands), not an exact amount",
       "type": [
        "string",
        "null"
       ]
      },
      "asset_description": {
       "$ref": "#/properties/filters/properties/chamber"
      },
      "chamber": {
       "$ref": "#/properties/filters/properties/chamber"
      },
      "disclosure_date": {
       "$ref": "#/properties/filters/properties/chamber"
      },
      "member_name": {
       "$ref": "#/properties/filters/properties/chamber"
      },
      "owner": {
       "$ref": "#/properties/filters/properties/chamber"
      },
      "ticker": {
       "$ref": "#/properties/filters/properties/chamber"
      },
      "transaction_date": {
       "$ref": "#/properties/filters/properties/chamber"
      },
      "transaction_type": {
       "$ref": "#/properties/filters/properties/chamber"
      }
     },
     "required": [
      "member_name",
      "chamber",
      "ticker",
      "asset_description",
      "transaction_type",
      "transaction_date",
      "disclosure_date",
      "amount_range",
      "owner"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "filters",
   "rows",
   "paging",
   "plan_limit"
  ],
  "type": "object"
 }
}

{
 "description": "Record redacted request, success-page, explicit user-confirmation, or provider-receipt evidence for the current batch member and inspection epoch. Never send page text, receipt identifiers, or external references.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batchId": {
    "minimum": 1,
    "type": "integer"
   },
   "browserBindingHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "evidenceFingerprint": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "evidenceSource": {
    "enum": [
     "submission_request",
     "success_page",
     "user_confirmation",
     "provider_receipt",
     "post_submit_receipt"
    ],
    "type": "string"
   },
   "evidenceType": {
    "enum": [
     "request_accepted",
     "confirmation_detected",
     "provider_receipt_detected"
    ],
    "type": "string"
   },
   "expectedInspectionEpoch": {
    "minimum": 1,
    "type": "integer"
   },
   "expectedMemberVersion": {
    "minimum": 1,
    "type": "integer"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 16,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "leaseToken": {
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "memberId": {
    "minimum": 1,
    "type": "integer"
   },
   "runId": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "batchId",
   "memberId",
   "runId",
   "expectedMemberVersion",
   "expectedInspectionEpoch",
   "leaseToken",
   "browserBindingHash",
   "evidenceType",
   "evidenceSource",
   "evidenceFingerprint",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "trackly_record_apply_submission_evidence"
}

  "properties": {
   "session_id": {
    "description": "V2 workflow session UUID returned by assetfare_v2_session_create. Use only with assetfare_v2_session_* tools; do not pass a legacy session ID.",
    "format": "uuid",
    "type": "string"
   },
   "session_token": {
    "description": "Sensitive caller-generated v2 session capability: at least 32 CSPRNG bytes encoded as 43-128 URL-safe base64 characters. Generate it locally; never log it or substitute a private key or legacy access token.",
    "pattern": "^[A-Za-z0-9_-]{43,128}$",
    "type": "string"
   },
   "verification_context": {
    "additionalProperties": false,

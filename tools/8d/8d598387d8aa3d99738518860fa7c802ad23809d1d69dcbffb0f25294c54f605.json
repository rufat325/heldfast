        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
       },
       "quote_id": {
        "format": "uuid",
        "type": "string"
       },
       "selected_mode": {
        "const": "session",
        "type": "string"
       },
       "selection_status": {
        "const": "selected",
        "type": "string"
       },
       "version": {
        "const": "assetfare-quote-bound-approval-v3",

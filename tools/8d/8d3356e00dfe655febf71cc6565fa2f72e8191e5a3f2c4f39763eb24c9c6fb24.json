{
 "description": "Install a plugin from a ZIP URL (GitHub releases, custom sources)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activate": {
    "default": false,
    "description": "Activate after install",
    "type": "boolean"
   },
   "overwrite": {
    "default": true,
    "description": "Overwrite if plugin already exists",
    "type": "boolean"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "url": {
    "description": "URL to plugin ZIP file",
    "type": "string"
   }
  },
  "required": [
   "site",
   "url"
  ],
  "type": "object"
 },
 "name": "mcp_install_plugin_zip"
}

  "readOnlyHint": true,
  "title": "YNAB: List Accounts"
 },
 "description": "List all accounts for a budget.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - limit (int, optional): Max results per page. Default: 50.\n  - offset (int, optional): Zero-based offset for pagination. Default: 0.\n  - response_format (string, optional): \"json\" or \"markdown\" (default: \"markdown\").\n\nReturns: accounts[], total_count, returned_count, offset, has_more, next_offset, cached, cache_info\n\nExamples:\n  - List all accounts (default budget): call with no args\n  - Page 2: set limit=20, offset=20\n\nErrors:\n  - \"No default budget set\" \u2192 run ynab_set_default_budget first\n  - \"UNAUTHORIZED\" \u2192 YNAB token expired",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ynab_list_accounts",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "accounts": {
    "description": "List of accounts",
    "items": {
     "additionalProperties": false,
     "properties": {
      "balance": {
       "description": "Account balance in dollars",
       "type": "number"
      },
      "cleared_balance": {
       "description": "Cleared balance in dollars",
       "type": "number"
      },
      "closed": {
       "description": "Closed flag",
       "type": "boolean"
      },
      "direct_import_in_error": {
       "description": "Direct import error flag",
       "type": "boolean"
      },
      "direct_import_linked": {
       "description": "Direct import linked flag",
       "type": "boolean"
      },
      "id": {
       "description": "Account ID",
       "type": "string"
      },
      "name": {
       "description": "Account name",
       "type": "string"
      },
      "note": {
       "description": "Account note",
       "type": "string"
      },
      "on_budget": {
       "description": "On-budget flag",
       "type": "boolean"
      },
      "transfer_payee_id": {
       "description": "Transfer payee ID",
       "type": "string"
      },
      "type": {
       "description": "Account type",
       "type": "string"
      },
      "uncleared_balance": {
       "description": "Uncleared balance in dollars",
       "type": "number"
      }
     },
     "required": [
      "id",
      "name",
      "type",
      "on_budget",
      "closed",
      "balance",
      "cleared_balance",
      "uncleared_balance",
      "transfer_payee_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cache_info": {
    "description": "Human-readable cache status message (e.g., \"Cache hit\", \"Cache miss\")",
    "type": "string"
   },
   "cached": {
    "description": "Indicates if data was served from cache",

    "minimum": 1,
    "type": "integer"
   },
   "order_by": {
    "description": "Sort field (default: relevance)",
    "enum": [
     "title",
     "start_date",
     "end_date",
     "episodes",
     "score",
     "rank",
     "popularity",
     "favorites",

{
 "description": "Perform a swipe gesture on the screen",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_id": {
    "description": "Device ID (optional if only one device)",
    "type": "string"
   },
   "duration_ms": {
    "default": 300,
    "description": "Swipe duration in ms (default 300)",
    "type": "number"
   },
   "end_x": {
    "description": "End X coordinate",
    "type": "number"
   },
   "end_y": {
    "description": "End Y coordinate",
    "type": "number"
   },
   "start_x": {
    "description": "Start X coordinate",
    "type": "number"
   },
   "start_y": {
    "description": "Start Y coordinate",
    "type": "number"
   }
  },
  "required": [
   "start_x",
   "start_y",
   "end_x",
   "end_y"
  ],
  "type": "object"
 },
 "name": "swipe"
}

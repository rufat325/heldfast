{
 "description": "Create a new product",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "productType": {
    "type": "string"
   },
   "status": {
    "default": "ACTIVE",
    "enum": [
     "ACTIVE",
     "DRAFT",
     "ARCHIVED"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "variants": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "inventoryQuantity": {
       "type": "number"
      },
      "price": {
       "type": "string"
      },
      "sku": {
       "type": "string"
      }
     },
     "required": [
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "vendor": {
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "createProduct"
}

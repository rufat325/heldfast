  "readOnlyHint": true,
  "title": "List review submissions"
 },
 "description": "List App Store review submissions for an app (submission history). Filter by state (e.g. UNRESOLVED_ISSUES for rejected). Note: the actual rejection message is only visible in App Store Connect \u2192 Version \u2192 Resolution Center, not in the API.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filter.app": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "App ID(s) (required). Submission history for this app."
   },
   "filter.platform": {
    "anyOf": [
     {
      "enum": [
       "IOS",
       "MAC_OS",
       "TV_OS",
       "VISION_OS"
      ],
      "type": "string"
     },
     {
      "items": {
       "enum": [
        "IOS",
        "MAC_OS",
        "TV_OS",
        "VISION_OS"
       ],
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Filter by platform(s)"
   },
   "filter.state": {
    "anyOf": [
     {
      "enum": [
       "READY_FOR_REVIEW",
       "WAITING_FOR_REVIEW",
       "IN_REVIEW",
       "UNRESOLVED_ISSUES",
       "CANCELING",
       "COMPLETING",
       "COMPLETE"
      ],
      "type": "string"
     },
     {
      "items": {
       "enum": [
        "READY_FOR_REVIEW",
        "WAITING_FOR_REVIEW",
        "IN_REVIEW",
        "UNRESOLVED_ISSUES",
        "CANCELING",
        "COMPLETING",
        "COMPLETE"
       ],
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Filter by submission state(s)"
   },
   "limit": {
    "default": 100,
    "description": "Maximum number of review submissions to return (default 100, max 200)",
    "type": "number"
   }

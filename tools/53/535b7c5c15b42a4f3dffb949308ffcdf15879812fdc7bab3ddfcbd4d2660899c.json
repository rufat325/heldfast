{
 "description": "Start a negotiation: draft from a template + parties, SIGN as Party A, and write the state file. Signs a negotiating commitment. Needs nda_setup first.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "effective_date": {
    "description": "Effective date.",
    "type": "string"
   },
   "governing_law": {
    "description": "Governing law.",
    "type": "string"
   },
   "out": {
    "description": "Output path for the negotiation state file.",
    "type": "string"
   },
   "party_a_address": {
    "description": "Party A address.",
    "type": "string"
   },
   "party_a_name": {
    "description": "Party A name.",
    "type": "string"
   },
   "party_b_address": {
    "description": "Party B address.",
    "type": "string"
   },
   "party_b_name": {
    "description": "Party B name.",
    "type": "string"
   },
   "purpose": {
    "description": "Purpose / deal description.",
    "type": "string"
   },
   "template": {
    "description": "Which built-in template (default mutual).",
    "enum": [
     "common-paper-mutual",
     "mutual",
     "one-way-out"
    ],
    "type": "string"
   }
  },
  "required": [
   "out",
   "purpose"
  ],
  "type": "object"
 },
 "name": "negotiate_init"
}

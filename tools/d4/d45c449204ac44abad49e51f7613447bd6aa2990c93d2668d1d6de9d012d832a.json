{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create or update an entity in the spatial world model. Allows specifying position (3D coordinates), orientation (pitch/yaw/roll), bounding box volume, custom properties, tags, and confidence score.",
 "inputSchema": {
  "properties": {
   "bounding_box": {
    "description": "AABB bounding volume size",
    "properties": {
     "depth": {
      "description": "Depth along Z axis",
      "type": "number"
     },
     "height": {
      "description": "Height along Y axis",
      "type": "number"
     },
     "width": {
      "description": "Width along X axis",
      "type": "number"
     }
    },
    "type": "object"
   },
   "confidence": {
    "description": "Object permanence confidence score from 0.0 to 1.0 (default: 1.0)",
    "type": "number"
   },
   "id": {
    "description": "Optional entity ID (auto-generated ULID if omitted for creation)",
    "type": "string"
   },
   "name": {
    "description": "Human-readable name or label of the entity",
    "type": "string"
   },
   "orientation": {
    "description": "3D Euler orientation angles in degrees",
    "properties": {
     "pitch": {
      "type": "number"
     },
     "roll": {
      "type": "number"
     },
     "yaw": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "parent_id": {
    "description": "Optional parent entity ID for hierarchical containment or attachments",
    "type": "string"
   },
   "position": {
    "description": "3D world position coordinates",
    "properties": {
     "x": {
      "description": "X coordinate",
      "type": "number"
     },
     "y": {
      "description": "Y coordinate",
      "type": "number"
     },
     "z": {
      "description": "Z coordinate",
      "type": "number"
     }
    },
    "type": "object"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   },
   "properties": {
    "description": "Arbitrary JSON key-value properties (physics, materials, interactive state)",
    "type": "object"
   },
   "region_id": {
    "description": "Optional named region ID where this entity resides",
    "type": "string"
   },
   "status": {
    "description": "Entity lifecycle status (default: active)",
    "enum": [
     "active",
     "hidden",
     "lost",
     "destroyed"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Array of searchable string tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Categorical entity type",
    "enum": [
     "object",
     "agent",
     "landmark",
     "region",
     "waypoint",
     "container",
     "surface",
     "npc",
     "item",
     "obstacle",
     "custom"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "type"
  ],
  "type": "object"
 },
 "name": "update_entity"
}

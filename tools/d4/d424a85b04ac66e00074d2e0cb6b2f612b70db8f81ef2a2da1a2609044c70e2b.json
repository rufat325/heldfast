{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "What-If Scenario Comparison + Sensitivity"
 },
 "description": "Compare named what-if scenarios against a base case where the outcome metric is the sum of the input variables, and rank which variables swing the outcome most. Use for budget sensitivity, deal/forecast what-ifs, or capacity planning across demand assumptions: define a base case of variable=value, then scenarios that override a subset. Returns the base outcome, each scenario's outcome with absolute and percent delta and per-variable changes, plus a sensitivity ranking by total absolute swing. For random sampling from a distribution, use simulate_montecarlo.",
 "inputSchema": {
  "properties": {
   "baseCase": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "Variable name \u2192 baseline value.",
    "type": "object"
   },
   "scenarios": {
    "description": "Named what-if scenarios. Each overrides any subset of baseCase variables.",
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "variables": {
       "additionalProperties": {
        "type": "number"
       },
       "type": "object"
      }
     },
     "required": [
      "name",
      "variables"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "baseCase",
   "scenarios"
  ],
  "type": "object"
 },
 "name": "simulate_scenario",
 "outputSchema": {
  "properties": {
   "baseCase": {
    "properties": {
     "outcome": {
      "type": "number"
     },
     "variables": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "properties": {
      "delta": {
       "description": "outcome \u2212 baseCase.outcome",
       "type": "number"
      },
      "deltaPercent": {
       "type": "number"
      },
      "outcome": {
       "type": "number"
      },
      "scenario": {
       "type": "string"
      },
      "variables": {
       "additionalProperties": {
        "properties": {
         "change": {
          "type": "number"
         },
         "changePercent": {
          "type": "number"
         },
         "value": {
          "type": "number"
         }
        },
        "type": "object"
       },
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "scenarioCount": {
    "type": "integer"
   },
   "sensitivityRanking": {
    "description": "Variables ranked by total absolute swing across scenarios.",
    "items": {
     "properties": {
      "totalSwing": {
       "type": "number"
      },
      "variable": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "baseCase",
   "results",
   "scenarioCount"
  ],
  "type": "object"
 }
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:scan"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a scan run's root causes"
 },
 "description": "Returns deterministic repeated DOM patterns and factual blast-radius counts for a full-site run. Grouping does not expand automated-test coverage and may not match the site's real component boundaries. Pro+.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "runId": {
    "description": "The id returned by scan_site.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "runId"
  ],
  "type": "object"
 },
 "name": "get_root_causes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "rootCauses": {
    "additionalProperties": false,
    "properties": {
     "clusters": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "component": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "label": {
             "type": "string"
            },
            "platform": {
             "type": [
              "string",
              "null"
             ]
            },
            "source": {
             "type": "string"
            }
           },
           "required": [
            "label",
            "source"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "exampleFix": {
         "type": [
          "string",
          "null"
         ]
        },
        "guidance": {
         "type": [
          "string",
          "null"
         ]
        },
        "helpUrl": {
         "type": "string"
        },
        "impact": {
         "type": "string"
        },
        "key": {
         "type": "string"
        },
        "nodesCount": {
         "type": "number"
        },
        "pagesCount": {
         "type": [
          "number",
          "null"
         ]
        },
        "pattern": {
         "type": "string"
        },
        "ruleId": {
         "type": "string"
        },
        "samplePages": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "sampleSelectors": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "selectorSignature": {
         "type": "string"
        },
        "wcagSc": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "key",
        "ruleId",
        "impact",
        "wcagSc",
        "pattern",
        "selectorSignature",
        "nodesCount",
        "samplePages",
        "sampleSelectors",
        "helpUrl"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "coverageDisclaimer": {
      "type": "string"
     },
     "scope": {
      "type": "string"
     },
     "signatureVersion": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "summary": {
      "additionalProperties": false,
      "properties": {
       "analyzedFindings": {
        "type": "number"
       },
       "clusteredFindings": {
        "type": "number"
       },
       "clustersTotal": {
        "type": "number"
       },
       "findingsTotal": {
        "type": "number"
       },
       "pagesTotal": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "findingsTotal",
       "analyzedFindings",
       "clustersTotal",
       "clusteredFindings"
      ],
      "type": "object"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "scope",
     "status",
     "signatureVersion",
     "summary",
     "truncated",
     "clusters",
     "coverageDisclaimer"
    ],
    "type": "object"
   }
  },
  "required": [
   "rootCauses"
  ],
  "type": "object"
 },
 "title": "Get a scan run's root causes"
}

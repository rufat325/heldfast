{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Turn a script into a full faceless video project: scene plan, generated visuals, optional voiceover, captions, music, and sound. Spends AI credits and returns a job to poll with generation_jobs_get.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "captionStyleId": {
    "description": "Optional caption theme ID from captions_themes_list.",
    "maxLength": 200,
    "type": "string"
   },
   "generateBackgroundMusic": {
    "default": false,
    "description": "Add a generated background track.",
    "type": "boolean"
   },
   "generateSoundEffects": {
    "default": false,
    "description": "Add generated sound effects.",
    "type": "boolean"
   },
   "generateVoiceover": {
    "default": true,
    "description": "Narrate the script with a generated voice.",
    "type": "boolean"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "imageModelId": {
    "default": "fal-ai/nano-banana-pro",
    "description": "Model used to generate scene images.",
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   },
   "includeCaptions": {
    "default": true,
    "description": "Burn captions into the timeline.",
    "type": "boolean"
   },
   "plannerModelId": {
    "default": "google/gemini-3.8-flash",
    "description": "Model used to plan the video scenes.",
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   },
   "projectName": {
    "default": "Faceless Video",
    "description": "Name for the created BlitzReels project.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "script": {
    "description": "The narration or story to turn into a video.",
    "maxLength": 30000,
    "minLength": 1,
    "type": "string"
   },
   "seriesId": {
    "description": "Optional Series UUID. Inherits its Story Kit and branding defaults for this new video.",
    "type": "string"
   },
   "storyKitId": {
    "description": "Reusable Story Kit UUID for characters, references, locations, style, and narrator voice.",
    "type": "string"
   },
   "styleReferenceAssetIds": {
    "default": [],
    "description": "Optional stills that lock rendering medium, palette, lighting and texture. Not used as scene frames.",
    "items": {
     "format": "uuid",
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "targetDurationSeconds": {
    "default": 45,
    "description": "Target runtime between 10 and 120 seconds.",
    "maximum": 120,
    "minimum": 10,
    "type": "number"
   },
   "videoModel": {
    "default": "seedance-2.0-ref2v",
    "description": "Image-to-video model used to animate scenes.",
    "enum": [
     "seedance-2.5-edit",
     "kling-o3-standard-edit",
     "kling-o3-pro-edit",
     "kling-v3-standard-motion-control",
     "kling-v3-pro-motion-control",
     "wan-2.2-animate-replace",
     "kling-2.1",
     "kling-2.6-pro",
     "kling-o1",
     "kling-3.0",
     "kling-o3-standard",
     "kling-o3-pro",
     "kling-o3-4k",
     "kling-v3-pro",
     "minimax-01",
     "minimax-hailuo-02",
     "minimax-hailuo-2.3-pro",
     "minimax-h3-max",
     "luma-ray-2",
     "luma-ray-3.2",
     "sora-2",
     "sora-2-pro",
     "veo3",
     "veo3.1",
     "veo3.1-fast",
     "gemini-omni-flash-ref2v",
     "gemini-omni-flash-edit",
     "gemini-omni-flash",
     "wan-2.7",
     "wan-2.7-ref2v",
     "wan-3.0",
     "happy-horse",
     "happy-horse-ref2v",
     "pixverse-v6",
     "grok-imagine",
     "seedance-2.0-pro",
     "seedance-2.5",
     "seedance-2.0-pro-fast",
     "seedance-2.0-ref2v",
     "seedance-2.0-ref2v-fast",
     "seedance-1.5-pro",
     "seedance-1.0-pro",
     "seedance-1.0-pro-fast",
     "seedance-1.0-lite",
     "seedance-1.0-lite-ref2v",
     "ltx-2-19b",
     "ltx-2-19b-distilled",
     "ltx-2.3",
     "ltx-2.3-fast"
    ],
    "type": "string"
   },
   "visualStyle": {
    "description": "Optional art direction override. A Story Kit style is used when omitted.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "voiceId": {
    "description": "Optional voice override from the BlitzReels voice catalog. The Story Kit narrator voice is used when omitted.",
    "maxLength": 200,
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional workspace ID. Defaults to the user's default workspace. UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "script"
  ],
  "type": "object"
 },
 "name": "generation_faceless_create",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "generation": {
    "properties": {
     "estimated_credits": {
      "type": [
       "number",
       "null"
      ]
     },
     "job_id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "image",
       "video",
       "voiceover",
       "music",
       "sound",
       "faceless"
      ],
      "type": "string"
     },
     "media_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "mutationReceipt": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "key": {
        "type": [
         "string",
         "null"
        ]
       },
       "operation": {
        "type": "string"
       },
       "replayed": {
        "type": "boolean"
       },
       "status": {
        "enum": [
         "completed"
        ],
        "type": "string"
       }
      },
      "required": [
       "id",
       "key",
       "operation",
       "status",
       "replayed"
      ],
      "type": "object"
     },
     "project_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "job_id",
     "kind",
     "status",
     "mutationReceipt"
    ],
    "type": "object"
   }
  },
  "required": [
   "generation"
  ],
  "type": "object"
 },
 "title": "Generate Faceless Video"
}

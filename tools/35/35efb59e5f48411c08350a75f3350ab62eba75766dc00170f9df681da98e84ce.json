  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find private physiotherapy, osteopathy or chiropractic clinics near a UK postcode or town that can be booked online through MediMo. Each result carries the clinic's next available first appointment, read from its own diary and refreshed every ten minutes, plus distance, Google rating and the treatments it offers. Returns no appointment times beyond the next available slot and does not book. Pass a date, a date range and/or a time of day to get only the clinics free then, with that day's appointment times \u2014 \"a chiropractic appointment next Tuesday afternoon within 5 miles of WA14\". Narrow to clinics with a practitioner of a given gender or language, or with free parking on site or step-free access, using the same rules as the website's filters. Pass insurer when someone is paying through their health insurance: only clinics accepting it are returned, with that insurer's appointments, prices and checkout. Each result lists its parking, access and accepted insurers. Start here; use get_clinic for detail on one result and start_booking when the person has chosen.",
 "inputSchema": {
  "properties": {
   "date": {
    "description": "Optional single date, ISO format (2026-09-22). Returns only clinics with an appointment that day, and that day's times.",
    "type": "string"
   },
   "date_from": {
    "description": "Optional start of a date range, ISO format. Use with date_to.",
    "type": "string"
   },
   "date_to": {
    "description": "Optional end of a date range, ISO format. At most 7 days from date_from.",
    "type": "string"
   },
   "facilities": {
    "description": "Optional. \"free_parking\": free parking on site. \"accessible\": step-free access, an accessible toilet, and a treatment room reachable without stairs. Every one listed must apply.",
    "items": {
     "enum": [
      "free_parking",
      "accessible"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "insurer": {
    "description": "Optional. The health insurer paying, e.g. \"Bupa\", \"AXA\", \"Vitality\". Only clinics accepting it are returned, and prices and checkout links become that insurer's. Leave out for self-pay.",
    "type": "string"
   },
   "language": {
    "description": "Optional. Only clinics with a practitioner who speaks this language and delivers the treatment searched for, e.g. \"Polish\". English is assumed everywhere and is not a filter.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum clinics to return, 1\u201320. Default 10.",
    "type": "integer"
   },
   "location": {
    "description": "A UK postcode (\"M33 7XS\"), postcode district (\"SK8\") or town (\"Altrincham\"). A full postcode gives the most accurate distances.",
    "type": "string"
   },
   "practitioner_gender": {
    "description": "Optional. Only clinics with a practitioner of this gender who delivers the treatment searched for.",
    "enum": [
     "female",
     "male"
    ],
    "type": "string"
   },
   "radius_miles": {
    "description": "Search radius, 1\u201320 miles. Default 10. Widens once to 20 if fewer than 3 clinics are found.",
    "type": "integer"
   },
   "service": {
    "description": "Optional treatment: \"physiotherapy\", \"osteopathy\", \"chiropractic\" (short forms like \"physio\" are fine). Leave empty to search all treatments.",
    "type": "string"
   },
   "sort": {
    "description": "Order of results. \"nearest\" (default) lists clinics with an appointment first, then by distance; \"soonest\" by next available appointment; \"rating\" by Google rating.",
    "enum": [
     "nearest",
     "soonest",
     "rating"
    ],
    "type": "string"
   },
   "time_of_day": {
    "description": "Optional. Only clinics with a slot in the morning (before noon), afternoon (noon to 5pm) or evening (5pm on).",
    "enum": [
     "morning",
     "afternoon",
     "evening"
    ],
    "type": "string"
   }
  },
  "required": [
   "location"
  ],
  "type": "object"
 },

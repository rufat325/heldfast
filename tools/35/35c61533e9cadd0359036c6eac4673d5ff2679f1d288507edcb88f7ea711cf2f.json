{
 "description": "Search for a hex pattern in a binary file.",
 "inputSchema": {
  "properties": {
   "file_path": {
    "description": "Path to the file",
    "type": "string"
   },
   "hex_pattern": {
    "description": "Hex pattern to search for (e.g. \"48 8B 05 ?? ?? ?? ??\")",
    "type": "string"
   },
   "max_results": {
    "description": "Max results (default 20)",
    "type": "number"
   }
  },
  "required": [
   "file_path",
   "hex_pattern"
  ],
  "type": "object"
 },
 "name": "hex_search"
}

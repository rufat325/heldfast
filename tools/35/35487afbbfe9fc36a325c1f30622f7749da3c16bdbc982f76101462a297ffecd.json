   {
    "query": "BRCA1"
   },
   {
    "query": "symbol:TP53 AND taxid:9606",
    "size": 20
   }
  ],
  "properties": {
   "fields": {
    "description": "Comma-sep return fields.",
    "type": "string"
   },
   "query": {
    "description": "e.g. \"BRCA1\", \"symbol:TP53 AND taxid:9606\"",
    "type": "string"
   },
   "size": {
    "description": "1-1000 (default 10).",
    "type": "number"
   },
   "sort": {
    "type": "string"
   },
   "species": {

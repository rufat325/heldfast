 "description": "List an anime/manga's staff (director, writer, character designer, author, illustrator, etc.) with their role. Use search_media first to resolve a title to its AniList ID. No explicit ordering is requested \u2014 don't assume results are sorted by role or popularity (unlike get_staff's reverse-direction lookup, which IS popularity-sorted).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "AniList ID.",
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number for pagination. AniList's paginated connections (search results, a title's characters/staff/reviews, activity feeds, forum comments) reject a page whose page \u00d7 perPage exceeds ~5000 entries with an upstream error, so paging that deep fails rather than returning more results.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "perPage": {
    "default": 25,
    "description": "Results per page (max 50, AniList's own ceiling \u2014 it silently clamps anything higher).",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   },
   "type": {
    "description": "Whether `id` refers to anime or manga.",
    "enum": [
     "ANIME",
     "MANGA"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "id"
  ],
  "type": "object"
 },

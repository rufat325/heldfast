{
 "description": "List available NVIDIA NIM models with detailed metadata for agent selection, optionally filtered by category (language, embedding, reranking, vision, code, multimodal, image_generation) and advanced filters.",
 "inputSchema": {
  "properties": {
   "category": {
    "default": "all",
    "description": "Filter by model category",
    "enum": [
     "language",
     "embedding",
     "reranking",
     "vision",
     "code",
     "multimodal",
     "image_generation",
     "all"
    ],
    "type": "string"
   },
   "commercial_use": {
    "description": "Filter by commercial license availability",
    "type": "boolean"
   },
   "hardware": {
    "description": "Filter by GPU hardware type (e.g., Hopper, Blackwell, Ampere)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "include_details": {
    "default": false,
    "description": "Include detailed model metadata for agent selection",
    "type": "boolean"
   },
   "min_context_length": {
    "description": "Minimum context length in tokens",
    "minimum": 1,
    "type": "integer"
   },
   "supports_function_calling": {
    "description": "Filter by function calling capability",
    "type": "boolean"
   },
   "supports_multimodal": {
    "description": "Filter by multimodal input capability",
    "type": "boolean"
   },
   "supports_reasoning": {
    "description": "Filter by reasoning capability",
    "type": "boolean"
   },
   "supports_vision": {
    "description": "Filter by vision capability",
    "type": "boolean"
   },
   "tags": {
    "description": "Filter by use case tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "list_models"
}

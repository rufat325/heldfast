{
 "description": "Newest items, optionally narrowed to a collection, source or kind.",
 "inputSchema": {
  "properties": {
   "bbox": {
    "description": "west,south,east,north; west > east crosses the antimeridian",
    "type": "string"
   },
   "before_id": {
    "description": "Keyset cursor; cannot combine with distance sorting",
    "type": "integer"
   },
   "collection": {
    "description": "Collection slug",
    "type": "string"
   },
   "kind": {
    "description": "Item kind",
    "type": "string"
   },
   "lat": {
    "description": "Query center latitude; requires long",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "description": "Default 30, max 200",
    "type": "integer"
   },
   "long": {
    "description": "Query center longitude; requires lat",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "offset": {
    "description": "Distance pagination offset",
    "type": "integer"
   },
   "radius": {
    "description": "Default 10; maximum 1000 km",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "sort": {
    "enum": [
     "id",
     "published",
     "updated",
     "distance"
    ],
    "type": "string"
   },
   "source": {
    "description": "Source slug",
    "type": "string"
   },
   "unit": {
    "description": "Default km",
    "enum": [
     "km",
     "mi"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "recent_items"
}

{
 "description": "Download and parse App Store sales report. Shows units, revenue by product.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "frequency": {
    "default": "DAILY",
    "description": "Report frequency",
    "enum": [
     "DAILY",
     "WEEKLY",
     "MONTHLY",
     "YEARLY"
    ],
    "type": "string"
   },
   "reportDate": {
    "description": "Report date (YYYY-MM-DD for daily, YYYY-MM for monthly)",
    "type": "string"
   },
   "reportSubType": {
    "default": "SUMMARY",
    "description": "Report sub type",
    "enum": [
     "SUMMARY",
     "DETAILED",
     "OPT_IN"
    ],
    "type": "string"
   },
   "vendorNumber": {
    "description": "Vendor number (find in App Store Connect > Payments and Financial Reports)",
    "type": "string"
   }
  },
  "required": [
   "vendorNumber",
   "reportDate"
  ],
  "type": "object"
 },
 "name": "asc_sales_report"
}

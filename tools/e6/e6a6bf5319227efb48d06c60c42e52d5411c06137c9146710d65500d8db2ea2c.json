{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true
 },
 "description": "Create or schedule a post to one or more connected social media accounts. Omit targets and scheduled_at to create a draft. Provide targets to publish; omit scheduled_at for immediate publish, or provide an RFC3339 timestamp to schedule. Attach media by first uploading via social_api_get_media_upload_url, verifying with social_api_verify_media_upload, then passing the media_ids here. Consumes 1 post credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "first_comment": {
    "description": "First comment posted after publish",
    "type": "string"
   },
   "media_ids": {
    "description": "Media IDs from upload",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "publish_now": {
    "description": "Publish immediately when no scheduled_at",
    "type": "boolean"
   },
   "scheduled_at": {
    "description": "RFC3339 timestamp; omit for immediate publish",
    "type": "string"
   },
   "skip_duplicate_check": {
    "description": "Skip 24h duplicate content check",
    "type": "boolean"
   },
   "targets": {
    "description": "Per-account targets with overrides",
    "items": {
     "additionalProperties": false,
     "properties": {
      "account_id": {
       "description": "Connected account ID",
       "type": "string"
      },
      "first_comment": {
       "description": "First comment for this target",
       "type": "string"
      },
      "media_ids": {
       "description": "Override media IDs",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "page_id": {
       "description": "Optional page ID for multi-page accounts (e.g. Facebook Pages). If omitted, uses the default page.",
       "type": "string"
      },
      "platform_data": {
       "additionalProperties": {},
       "description": "Platform-specific settings",
       "type": "object"
      },
      "scheduled_at": {
       "description": "Override schedule time (RFC3339)",
       "type": "string"
      },
      "text": {
       "description": "Override text for this target",
       "type": "string"
      },
      "title": {
       "description": "Override title",
       "type": "string"
      },
      "visibility": {
       "description": "Override visibility",
       "type": "string"
      }
     },
     "required": [
      "account_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "text": {
    "description": "Post text content",
    "type": "string"
   },
   "title": {
    "description": "Post title (YouTube, Pinterest)",
    "type": "string"
   },
   "visibility": {
    "description": "public, private, or unlisted (default public)",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "social_api_create_post",
 "title": "Create Post"
}

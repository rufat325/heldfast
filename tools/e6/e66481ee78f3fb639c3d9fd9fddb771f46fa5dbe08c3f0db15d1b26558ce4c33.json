{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get transcript summary metadata or a bounded window of transcription segments for a video asset.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "description": "The media asset ID to get transcript for. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Maximum transcript segments to return (1-200).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "summary",
    "description": "Summary returns metadata only. Text returns joined text for a bounded segment window. Full returns the bounded segment objects without duplicating their text.",
    "enum": [
     "summary",
     "text",
     "full"
    ],
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Transcript segment offset.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "assetId"
  ],
  "type": "object"
 },
 "name": "media_transcript_get",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "error": {
    "type": "string"
   },
   "transcript": {
    "properties": {
     "segmentBounds": {
      "additionalProperties": false,
      "properties": {
       "hasMore": {
        "type": "boolean"
       },
       "limit": {
        "type": "number"
       },
       "maxLimit": {
        "type": "number"
       },
       "offset": {
        "type": "number"
       },
       "returned": {
        "type": "number"
       },
       "total": {
        "type": "number"
       },
       "truncated": {
        "type": "boolean"
       }
      },
      "required": [
       "limit",
       "maxLimit",
       "offset",
       "total",
       "returned",
       "hasMore",
       "truncated"
      ],
      "type": "object"
     },
     "segments": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "text": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "text",
     "segments",
     "segmentBounds"
    ],
    "type": [
     "object",
     "null"
    ]
   }
  },
  "required": [
   "transcript"
  ],
  "type": "object"
 },
 "title": "Get Media Transcript"
}

{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Checks or fixes Go source formatting using gofmt. In check mode (-l), lists unformatted files. In fix mode (-w), rewrites files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allErrors": {
    "default": false,
    "description": "Report all errors, not just the first 10 per file (-e)",
    "type": "boolean"
   },
   "check": {
    "default": false,
    "description": "Check mode: list unformatted files without fixing (default: false)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "diff": {
    "default": false,
    "description": "Display diffs instead of rewriting files (-d)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "."
    ],
    "description": "File patterns to format (default: ['.'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "simplify": {
    "default": false,
    "description": "Try to simplify code in addition to formatting (-s)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "fmt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "changes": {
    "description": "Per-file diff snippets when -d output is available",
    "items": {
     "additionalProperties": false,
     "properties": {
      "diff": {
       "type": "string"
      },
      "file": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "diff"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filesChanged": {
    "type": "number"
   },
   "parseErrors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "filesChanged"
  ],
  "type": "object"
 },
 "title": "Go Fmt"
}

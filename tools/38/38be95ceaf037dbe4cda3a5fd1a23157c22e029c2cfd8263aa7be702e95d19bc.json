{
 "description": "Record up to 20 typed, value-free live-probe access classifications, each bound to the exact current batch, member, run, and browser surface. Cache hints and static policy are server-owned. Never include URLs, labels, answers, credentials, OTPs, CAPTCHA text, or page content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "dispositions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "batchId": {
       "minimum": 1,
       "type": "integer"
      },
      "browserSurface": {
       "enum": [
        "codex_in_app",
        "chrome_extension",
        "claude_in_chrome"
       ],
       "type": "string"
      },
      "classification": {
       "enum": [
        "accessible",
        "authentication_required",
        "account_creation_required",
        "otp_required",
        "captcha_before_form",
        "captcha_at_submit",
        "manual_only",
        "unknown_unobservable"
       ],
       "type": "string"
      },
      "expectedInspectionEpoch": {
       "minimum": 0,
       "type": "integer"
      },
      "expectedMemberVersion": {
       "minimum": 1,
       "type": "integer"
      },
      "jobId": {
       "minimum": 1,
       "type": "integer"
      },
      "memberId": {
       "minimum": 1,
       "type": "integer"
      },
      "probeOnlyNoDraft": {
       "type": "boolean"
      },
      "runId": {
       "minimum": 1,
       "type": "integer"
      },
      "source": {
       "enum": [
        "live_probe"
       ],
       "type": "string"
      }
     },
     "required": [
      "jobId",
      "classification",
      "source",
      "batchId",
      "memberId",
      "runId",
      "expectedMemberVersion",
      "expectedInspectionEpoch",
      "browserSurface"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "executionId": {
    "minimum": 1,
    "type": "integer"
   },
   "expectedRevision": {
    "minimum": 1,
    "type": "integer"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 16,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   }
  },
  "required": [
   "executionId",
   "expectedRevision",
   "idempotencyKey",
   "dispositions"
  ],
  "type": "object"
 },
 "name": "trackly_record_apply_execution_dispositions"
}

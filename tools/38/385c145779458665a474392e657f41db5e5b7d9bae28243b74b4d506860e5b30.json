{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Render JPEG stills for a compiled carousel at the exact platform frame and return them as MCP images so you can inspect chips on the real slides.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "chrome": {
    "default": "none",
    "enum": [
     "tiktok",
     "instagram",
     "none"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "slideIndexes": {
    "items": {
     "maximum": 34,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 35,
    "type": "array"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "projectId",
   "chrome"
  ],
  "type": "object"
 },
 "name": "carousels_preview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "frame": {
    "additionalProperties": false,
    "properties": {
     "aspect_ratio": {
      "type": "string"
     },
     "height": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "width": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height",
     "aspect_ratio"
    ],
    "type": "object"
   },
   "next_actions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "enum": [
        "GET",
        "POST",
        "PATCH",
        "DELETE"
       ],
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "method",
      "path",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "platform": {
    "anyOf": [
     {
      "enum": [
       "tiktok_photo",
       "instagram_4x5",
       "linkedin"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "project_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "slides": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "expires_at": {
       "type": "string"
      },
      "height": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "index": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "preview_url": {
       "type": "string"
      },
      "print": {
       "enum": [
        "slots",
        "ingested"
       ],
       "type": "string"
      },
      "width": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "index",
      "preview_url",
      "width",
      "height",
      "expires_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "field": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "repair": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "project_id",
   "revision",
   "platform",
   "frame",
   "slides",
   "warnings",
   "next_actions"
  ],
  "type": "object"
 },
 "title": "Preview Carousel"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Normalize Fitbit sleep and activity load into the shared wellness_context shape for recommendation engines.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "default": 7,
    "description": "Lookback window for normalized Fitbit wellness context.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "injury_flags": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "maxLength": 500,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "soreness": {
    "default": [],
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "default": "UTC",
    "description": "IANA timezone used only for display, e.g. America/New_York.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "fitbit_wellness_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "generated_at": {
    "type": "string"
   },
   "injury_flags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recent_training_load": {
    "enum": [
     "low",
     "normal",
     "high",
     "unknown"
    ],
    "type": "string"
   },
   "soreness": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "source": {
    "const": "fitbit",
    "type": "string"
   }
  },
  "required": [
   "source",
   "generated_at",
   "recent_training_load",
   "soreness",
   "injury_flags",
   "notes"
  ],
  "type": "object"
 },
 "title": "Fitbit Wellness Context"
}

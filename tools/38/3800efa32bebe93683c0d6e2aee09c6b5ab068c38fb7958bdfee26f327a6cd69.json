{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a public order-book snapshot. Precision must be valid for the selected pair.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "depth": {
    "anyOf": [
     {
      "const": 5,
      "type": "number"
     },
     {
      "const": 10,
      "type": "number"
     },
     {
      "const": 20,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     },
     {
      "const": 100,
      "type": "number"
     },
     {
      "const": 200,
      "type": "number"
     },
     {
      "const": 500,
      "type": "number"
     }
    ]
   },
   "precision": {
    "description": "Exact positive decimal string; never use a JSON number",
    "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
    "type": "string"
   },
   "symbol": {
    "description": "Exact current xRocket symbol, for example GRAM-USDT",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "xrocket_market_orderbook",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {}
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "xRocket order book"
}

{
 "description": "Latest headlines, optionally by category (markets, crypto, tech, world, business, energy). Costs $0.005 via x402 (USDC on Base).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "enum": [
     "markets",
     "crypto",
     "tech",
     "world",
     "business",
     "energy"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "Freshness window (default 6h)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_headlines"
}

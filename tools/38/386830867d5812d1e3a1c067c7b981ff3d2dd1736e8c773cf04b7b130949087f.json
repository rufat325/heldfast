{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Manage scheduled tasks (cron jobs) for an application or service. Actions: list, create (name, command, frequency), update, delete, list_executions (all but list/create need task_uuid).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "create",
     "update",
     "delete",
     "list_executions"
    ],
    "type": "string"
   },
   "command": {
    "type": "string"
   },
   "container": {
    "type": "string"
   },
   "enabled": {
    "type": "boolean"
   },
   "frequency": {
    "description": "Cron expression",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "resource": {
    "enum": [
     "application",
     "service"
    ],
    "type": "string"
   },
   "task_uuid": {
    "type": "string"
   },
   "timeout": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "uuid": {
    "description": "Resource UUID",
    "type": "string"
   }
  },
  "required": [
   "resource",
   "uuid",
   "action"
  ],
  "type": "object"
 },
 "name": "scheduledTasks",
 "title": "Manage scheduled tasks"
}

 "description": "Search IMDB titles by primary_title (case-insensitive substring). Joins ratings inline so each hit includes average_rating + num_votes. Optionally filter by title_type, year range, or genre. Returns up to `limit` matches sorted by num_votes desc (popular first).",
 "inputSchema": {
  "examples": [
   {
    "query": "godfather"
   },
   {
    "limit": 10,
    "min_votes": 1000,
    "query": "succession",
    "title_type": "tvSeries",
    "year_from": 2015
   }
  ],
  "properties": {
   "genre": {
    "description": "Genre to filter by (e.g. \"Comedy\", \"Drama\")",
    "type": "string"
   },
   "limit": {
    "description": "1-100 (default 20)",
    "type": "number"
   },
   "min_votes": {
    "description": "Minimum num_votes (default 0 \u2014 no filter)",
    "type": "number"
   },
   "query": {
    "description": "Title substring (e.g. \"godfather\", \"succession\")",
    "type": "string"
   },
   "title_type": {

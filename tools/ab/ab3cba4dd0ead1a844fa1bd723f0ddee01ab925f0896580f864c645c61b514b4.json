{
 "description": "Search US government surplus auctions from GSA (General Services Administration). Find vehicles, electronics, equipment, and more at below-market prices.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agency": {
    "description": "Agency filter (e.g. \"DoD\", \"GSA\")",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_bid": {
    "description": "Maximum bid amount",
    "type": "number"
   },
   "min_bid": {
    "description": "Minimum bid amount",
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Offset for pagination",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Search term (e.g. \"computer\", \"vehicle\", \"furniture\")",
    "type": "string"
   },
   "state": {
    "description": "State filter (e.g. \"CA\", \"TX\")",
    "type": "string"
   },
   "status": {
    "description": "Auction status filter",
    "enum": [
     "active",
     "preview"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_gsa_auctions"
}

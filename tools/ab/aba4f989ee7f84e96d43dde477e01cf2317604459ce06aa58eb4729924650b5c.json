{
 "description": "Get USDC deposit/withdrawal history for a trader. Shows inbound and outbound USDC transfers, useful for tracking when traders fund or withdraw from Polymarket.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Ethereum address of the trader",
    "type": "string"
   },
   "direction": {
    "default": "both",
    "description": "Filter by transfer direction",
    "enum": [
     "inbound",
     "outbound",
     "both"
    ],
    "type": "string"
   },
   "first": {
    "default": 50,
    "description": "Number of transfers to return",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_trader_usdc_flows"
}

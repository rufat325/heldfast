{
 "description": "List performance alerts such as traffic drops, ranking changes, and other significant events.",
 "inputSchema": {
  "properties": {
   "page": {
    "description": "default 1",
    "type": "number"
   },
   "page_size": {
    "description": "default 20, max 100",
    "type": "number"
   },
   "severity": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "status": {
    "description": "default all",
    "enum": [
     "unresolved",
     "resolved",
     "all"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "ranking_drop",
     "traffic_drop",
     "decay_detected"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_performance_alerts"
}

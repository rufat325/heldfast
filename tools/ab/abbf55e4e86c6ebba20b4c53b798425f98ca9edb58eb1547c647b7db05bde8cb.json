{
 "description": "Send a base64-encoded message to a Kafka, RocketMQ, or RabbitMQ topic/queue",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "connection_id": {
    "description": "Unique ID of the DBX connection",
    "type": "string"
   },
   "connection_name": {
    "description": "Name of the DBX connection",
    "type": "string"
   },
   "exchange": {
    "default": null,
    "description": "RabbitMQ exchange name",
    "type": "string"
   },
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "default": {},
    "description": "Optional message headers",
    "type": "object"
   },
   "key": {
    "default": null,
    "description": "Optional message key used for partitioning",
    "type": "string"
   },
   "namespace": {
    "default": null,
    "description": "RabbitMQ virtual-host namespace",
    "type": "string"
   },
   "partition": {
    "default": null,
    "description": "Optional target partition",
    "format": "int32",
    "type": "integer"
   },
   "payload_base64": {
    "description": "Message payload encoded as standard base64",
    "type": "string"
   },
   "payload_text": {
    "default": null,
    "description": "Optional UTF-8 text preview of the payload",
    "type": "string"
   },
   "routing_key": {
    "default": null,
    "description": "RabbitMQ routing key",
    "type": "string"
   },
   "topic": {
    "description": "Message queue topic name",
    "type": "string"
   }
  },
  "required": [
   "topic",
   "payload_base64"
  ],
  "type": "object"
 },
 "name": "dbx_send_message"
}

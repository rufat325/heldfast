{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "streamingHint": true,
  "title": "OpenAI Web Search"
 },
 "description": "Web search with OpenAI's real-time web access. Use when you want search results reasoned over and synthesized rather than listed. Put your QUERY in the 'query' parameter.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City for location-aware results",
    "type": "string"
   },
   "country": {
    "description": "Country for location-aware results (e.g., 'US', 'UK')",
    "type": "string"
   },
   "query": {
    "description": "The search query (REQUIRED - put your question here)",
    "type": "string"
   },
   "searchContextSize": {
    "default": "medium",
    "description": "Search depth - low (fast), medium (balanced), high (comprehensive)",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "openai_search"
}

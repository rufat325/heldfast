{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create an order and payment link"
 },
 "description": "Create an order and get a Stripe payment link the customer opens to pay. Requires authentication (send a valid X-Api-Key header). Shipping to RO, HU or DE only. Prices include VAT and match get_product for the same destination.",
 "inputSchema": {
  "properties": {
   "buyer": {
    "properties": {
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "email"
    ],
    "type": "object"
   },
   "expected_total": {
    "description": "Optional. If set, the call is rejected when the live total moved more than 2%.",
    "type": "number"
   },
   "items": {
    "description": "Products to buy.",
    "items": {
     "properties": {
      "product_id": {
       "type": "integer"
      },
      "quantity": {
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "product_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shipping_address": {
    "properties": {
     "city": {
      "type": "string"
     },
     "country": {
      "enum": [
       "RO",
       "HU",
       "DE"
      ],
      "type": "string"
     },
     "county": {
      "type": "string"
     },
     "postcode": {
      "type": "string"
     },
     "street": {
      "type": "string"
     }
    },
    "required": [
     "country",
     "street",
     "city"
    ],
    "type": "object"
   }
  },
  "required": [
   "items",
   "buyer",
   "shipping_address"
  ],
  "type": "object"
 },
 "name": "create_checkout",
 "title": "Create checkout"
}

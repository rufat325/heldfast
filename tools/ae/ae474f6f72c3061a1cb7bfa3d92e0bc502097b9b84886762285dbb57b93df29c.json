 "description": "Get near-Earth asteroids approaching within a date range (max 7 days). Returns size, velocity, and miss distance. Example: get_asteroids({ start_date: \"2024-01-01\", end_date: \"2024-01-07\", _apiKey: \"DEMO_KEY\" })",
 "inputSchema": {
  "examples": [
   {
    "end_date": "2024-01-07",
    "start_date": "2024-01-01"
   },
   {
    "end_date": "2024-02-15",
    "start_date": "2024-02-10"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "NASA API key (optional, defaults to DEMO_KEY)",
    "type": "string"
   },
   "end_date": {
    "description": "End date in YYYY-MM-DD format (max 7 days after start)",
    "type": "string"
   },
   "start_date": {
    "description": "Start date in YYYY-MM-DD format",
    "type": "string"
   }
  },
  "required": [
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "get_asteroids",
 "outputSchema": {
  "properties": {
   "asteroids": {
    "description": "List of near-Earth asteroids (up to 30)",
    "items": {
     "properties": {
      "date": {
       "description": "Date of close approach in YYYY-MM-DD format",
       "type": "string"
      },
      "diameter_max_m": {
       "description": "Maximum estimated diameter in meters",
       "type": "number"
      },
      "diameter_min_m": {
       "description": "Minimum estimated diameter in meters",
       "type": "number"
      },
      "hazardous": {
       "description": "Whether asteroid is potentially hazardous",
       "type": "boolean"
      },
      "id": {
       "description": "NASA JPL unique asteroid identifier",
       "type": "string"
      },
      "jpl_url": {
       "description": "NASA JPL URL for detailed asteroid information",
       "type": "string"
      },
      "miss_distance_km": {
       "description": "Miss distance from Earth in kilometers",
       "type": [
        "number",
        "null"
       ]
      },
      "name": {
       "description": "Asteroid name or designation",
       "type": "string"
      },
      "velocity_km_h": {
       "description": "Relative velocity in kilometers per hour",
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name",
      "date",
      "hazardous",
      "diameter_min_m",
      "diameter_max_m",
      "jpl_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_count": {
    "description": "Total count of near-Earth objects in the date range",
    "type": "number"
   }
  },
  "required": [
   "total_count",
   "asteroids"
  ],
  "type": "object"
 },
 "title": "Get Asteroids",
 "version": "v1.1884c0e2"
}

  "properties": {
   "sessions": {
    "description": "Session requests to create",
    "items": {
     "properties": {
      "autoApprove": {
       "default": true,
       "type": "boolean"
      },
      "autoCreatePR": {
       "default": false,
       "type": "boolean"
      },
      "branch": {
       "default": "main",
       "type": "string"
      },
      "prompt": {
       "type": "string"
      },
      "repoName": {
       "type": "string"
      },
      "repoOwner": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "repoOwner",
      "repoName",
      "prompt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "sessions"
  ],
  "type": "object"
 },
 "name": "jules_bulk_create_sessions",
 "title": "Bulk Create Jules Sessions"
}

{
 "description": "Fetch a compact, bounded projection for one Apply execution. Request only the current members and profile keys needed for the visible form. The response owns mutability, allowed operations, milestones, lease timing, and progress.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "browserSurface": {
    "enum": [
     "codex_in_app",
     "chrome_extension",
     "claude_in_chrome"
    ],
    "type": "string"
   },
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "executionId": {
    "minimum": 1,
    "type": "integer"
   },
   "memberIds": {
    "items": {
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "officeProjections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "memberId": {
       "minimum": 1,
       "type": "integer"
      },
      "office": {
       "pattern": "^[1-9]\\d*:[A-Za-z0-9][A-Za-z0-9._-]{0,150}$",
       "type": "string"
      },
      "profileKeys": {
       "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 100,
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "memberId",
      "office",
      "profileKeys"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "profileKeys": {
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "executionId",
   "memberIds",
   "browserSurface"
  ],
  "type": "object"
 },
 "name": "trackly_get_apply_execution_snapshot"
}

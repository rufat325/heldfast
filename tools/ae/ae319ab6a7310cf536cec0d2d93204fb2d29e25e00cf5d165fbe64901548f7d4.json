{
 "description": "Generate variations of an existing image. Produces similar but different versions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "file_path": {
    "description": "Local path to source image",
    "type": "string"
   },
   "image_format": {
    "description": "Output format",
    "enum": [
     "png",
     "webp"
    ],
    "type": "string"
   },
   "n": {
    "default": 1,
    "description": "Number of images to generate (1-6)",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "random_seed": {
    "description": "Random seed for reproducibility",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "response_format": {
    "default": "url",
    "description": "Response format",
    "enum": [
     "url",
     "b64_json"
    ],
    "type": "string"
   },
   "size": {
    "description": "Output size (WxH format, required)",
    "type": "string"
   }
  },
  "required": [
   "file_path",
   "size"
  ],
  "type": "object"
 },
 "name": "recraft_variate_image"
}

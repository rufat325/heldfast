{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate culturally correct Japanese form markup with proper field order (\u59d3\u2192\u540d), furigana, 3-field phone, \u3012 postal address, \u5e74\u6708\u65e5 dates, and context-appropriate keigo. Use this when building any form for a Japanese audience.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "context": {
    "description": "Business context \u2014 determines keigo politeness level",
    "enum": [
     "b2b_saas",
     "consumer_app",
     "government",
     "ecommerce",
     "corporate"
    ],
    "title": "Context",
    "type": "string"
   },
   "fields": {
    "description": "Fields to include in the form",
    "items": {
     "enum": [
      "name",
      "email",
      "phone",
      "address",
      "date_of_birth",
      "company"
     ],
     "type": "string"
    },
    "title": "Fields",
    "type": "array"
   },
   "format": {
    "default": "html",
    "description": "Output format",
    "enum": [
     "html",
     "jsx",
     "tsx"
    ],
    "title": "Format",
    "type": "string"
   },
   "include_labels": {
    "default": true,
    "description": "Include field labels",
    "title": "Include Labels",
    "type": "boolean"
   },
   "include_validation": {
    "default": true,
    "description": "Include validation patterns",
    "title": "Include Validation",
    "type": "boolean"
   },
   "language": {
    "default": "ja",
    "description": "Label language",
    "enum": [
     "ja",
     "en",
     "bilingual"
    ],
    "title": "Language",
    "type": "string"
   },
   "type": {
    "description": "Type of form to generate",
    "enum": [
     "registration",
     "contact",
     "checkout",
     "inquiry",
     "login"
    ],
    "title": "Type",
    "type": "string"
   }
  },
  "required": [
   "type",
   "context",
   "fields"
  ],
  "type": "object"
 },
 "name": "generate_jp_form",
 "title": "Generate JP Form"
}

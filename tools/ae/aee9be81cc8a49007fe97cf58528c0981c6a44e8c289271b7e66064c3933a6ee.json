{
 "description": "Change the version string of a draft/rejected version (e.g., 1.5.0 \u2192 1.6.0). Only works for editable versions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "newVersionString": {
    "description": "New version string (e.g., 2.0.0)",
    "type": "string"
   },
   "versionId": {
    "description": "Version ID (from asc_list_versions)",
    "type": "string"
   }
  },
  "required": [
   "versionId",
   "newVersionString"
  ],
  "type": "object"
 },
 "name": "asc_update_version_string"
}

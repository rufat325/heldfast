{
 "description": "Clips for the authenticated user. With projectId -> GET /clips/project/:projectId; otherwise GET /clips (the clip library) with paging/status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "page": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "projectId": {
    "type": "string"
   },
   "status": {
    "enum": [
     "pending",
     "processing",
     "completed",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_clips",
 "title": "List clips"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find a planet's retrograde periods in a date range: exact station-retrograde\nand station-direct moments, with the longitude and sign at each end. Periods\noverlapping the range edges are included whole.\n\nExamples:\n  - \"When is Mercury retrograde in 2026?\" ->\n    { body: \"Mercury\", from_datetime: \"2026-01-01\", to_datetime: \"2027-01-01\" }\n\nThe Sun and Moon never retrograde and are rejected.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "body": {
    "description": "Which planet (not Sun/Moon).",
    "enum": [
     "Sun",
     "Moon",
     "Mercury",
     "Venus",
     "Mars",
     "Jupiter",
     "Saturn",
     "Uranus",
     "Neptune",
     "Pluto"
    ],
    "type": "string"
   },
   "from_datetime": {
    "description": "Start of the search window.",
    "minLength": 4,
    "type": "string"
   },
   "to_datetime": {
    "description": "End of the search window (max 50 years after start).",
    "minLength": 4,
    "type": "string"
   }
  },
  "required": [
   "body",
   "from_datetime",
   "to_datetime"
  ],
  "type": "object"
 },
 "name": "find_retrograde_periods",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "periods": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "endLongitude": {
       "type": "number"
      },
      "endSign": {
       "type": "string"
      },
      "startLongitude": {
       "type": "number"
      },
      "startSign": {
       "type": "string"
      },
      "stationDirect": {
       "type": "string"
      },
      "stationRetrograde": {
       "type": "string"
      }
     },
     "required": [
      "body",
      "stationRetrograde",
      "stationDirect",
      "startLongitude",
      "startSign",
      "endLongitude",
      "endSign"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "periods"
  ],
  "type": "object"
 },
 "title": "Find Retrograde Periods"
}

{
 "description": "Update settings on a single Elementor element (merge, not replace)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "element_id": {
    "description": "Elementor element ID",
    "type": "string"
   },
   "id": {
    "description": "Post/page ID",
    "type": "number"
   },
   "settings": {
    "additionalProperties": {},
    "description": "Settings to merge into the element",
    "type": "object"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id",
   "element_id",
   "settings"
  ],
  "type": "object"
 },
 "name": "mcp_update_elementor_element"
}

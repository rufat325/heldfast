{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Generate an image from text, optionally with reference images for style/content guidance. MODELS: gen4_image (high quality), gen4_image_turbo (fast/cheap), gemini_2.5_flash (Google Gemini). REFERENCE IMAGES: Tag with short label (e.g., \"cat\"), use @tag in prompt. WORKFLOW: Returns task_id \u2192 poll with check_runway_task or use wait_for_runway_task.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content_moderation": {
    "description": "Public figure threshold.",
    "enum": [
     "auto",
     "low"
    ],
    "type": "string"
   },
   "model": {
    "description": "Default: gen4_image.",
    "enum": [
     "gen4_image",
     "gen4_image_turbo",
     "gemini_2.5_flash"
    ],
    "type": "string"
   },
   "prompt_text": {
    "description": "Text description. Use @tag to reference images.",
    "type": "string"
   },
   "ratio": {
    "description": "Output resolution. Default: 1920:1080.",
    "enum": [
     "1024:1024",
     "1080:1080",
     "1168:880",
     "1360:768",
     "1440:1080",
     "1080:1440",
     "1808:768",
     "1920:1080",
     "1080:1920",
     "2112:912",
     "1280:720",
     "720:1280",
     "720:720",
     "960:720",
     "720:960",
     "1680:720"
    ],
    "type": "string"
   },
   "reference_images": {
    "description": "Optional 1-3 reference images.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "tag": {
       "description": "Tag for @mention in prompt. 3-16 lowercase chars.",
       "type": "string"
      },
      "uri": {
       "description": "HTTPS URL, Runway URI, or local file path.",
       "type": "string"
      }
     },
     "required": [
      "uri"
     ],
     "type": "object"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "seed": {
    "description": "Random seed (0-4294967295).",
    "type": "integer"
   }
  },
  "required": [
   "prompt_text"
  ],
  "type": "object"
 },
 "name": "generate_image"
}

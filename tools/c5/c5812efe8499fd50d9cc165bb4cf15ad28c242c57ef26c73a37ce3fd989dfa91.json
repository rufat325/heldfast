{
 "description": "Locally validate a caller-supplied session-finalizer keep set against complete controller and user tab inventories. This pure helper never enumerates, focuses, closes, hands off, or finalizes browser tabs and never sends tab IDs to Trackly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "controllerInventory": {
    "additionalProperties": false,
    "properties": {
     "complete": {
      "type": "boolean"
     },
     "tabIds": {
      "items": {
       "$ref": "#/properties/expectedTabIds/items"
      },
      "maxItems": 1000,
      "type": "array"
     }
    },
    "required": [
     "complete",
     "tabIds"
    ],
    "type": "object"
   },
   "expectedTabIds": {
    "items": {
     "anyOf": [
      {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      {
       "maxLength": 512,
       "minLength": 1,
       "type": "string"
      }
     ]
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "keepTabIds": {
    "items": {
     "$ref": "#/properties/expectedTabIds/items"
    },
    "maxItems": 100,
    "type": "array"
   },
   "userInventory": {
    "additionalProperties": false,
    "properties": {
     "complete": {
      "type": "boolean"
     },
     "tabIds": {
      "items": {
       "$ref": "#/properties/expectedTabIds/items"
      },
      "maxItems": 1000,
      "type": "array"
     }
    },
    "required": [
     "complete",
     "tabIds"
    ],
    "type": "object"
   }
  },
  "required": [
   "expectedTabIds",
   "keepTabIds",
   "controllerInventory",
   "userInventory"
  ],
  "type": "object"
 },
 "name": "trackly_validate_apply_tab_keep_set"
}

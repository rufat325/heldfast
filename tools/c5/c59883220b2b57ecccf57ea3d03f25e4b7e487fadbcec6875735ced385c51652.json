{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update multiple beans in one call. Optionally assign all of them (or a subset) to a shared parent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "beans": {
    "items": {
     "properties": {
      "beanId": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "blockedBy": {
       "items": {
        "maxLength": 128,
        "type": "string"
       },
       "type": "array"
      },
      "blocking": {
       "items": {
        "maxLength": 128,
        "type": "string"
       },
       "type": "array"
      },
      "body": {
       "maxLength": 65536,
       "type": "string"
      },
      "bodyAppend": {
       "maxLength": 65536,
       "type": "string"
      },
      "bodyReplace": {
       "items": {
        "properties": {
         "new": {
          "maxLength": 65536,
          "type": "string"
         },
         "old": {
          "maxLength": 65536,
          "type": "string"
         }
        },
        "required": [
         "old",
         "new"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "clearParent": {
       "type": "boolean"
      },
      "ifMatch": {
       "maxLength": 128,
       "type": "string"
      },
      "parent": {
       "description": "Override the top-level parent for this item",
       "maxLength": 128,
       "type": "string"
      },
      "priority": {
       "maxLength": 128,
       "type": "string"
      },
      "status": {
       "maxLength": 128,
       "type": "string"
      },
      "type": {
       "maxLength": 128,
       "type": "string"
      }
     },
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "parent": {
    "description": "Default parent ID applied to any bean that does not specify its own parent",
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "beans"
  ],
  "type": "object"
 },
 "name": "beans_bulk_update",
 "title": "Bulk Update Beans"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search Deezer for tracks/albums/artists/playlists.",
 "inputSchema": {
  "examples": [
   {
    "query": "Daft Punk Get Lucky"
   },
   {
    "limit": 10,
    "query": "The Beatles",
    "type": "artist"
   }
  ],
  "properties": {
   "limit": {
    "description": "1-100 (default 25)",
    "type": "number"
   },
   "query": {
    "description": "e.g. \"Daft Punk Get Lucky\"",
    "type": "string"
   },
   "type": {
    "description": "track | album | artist | playlist (default track)",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "properties": {
   "data": {
    "description": "Array of search results (tracks, albums, artists, or playlists)",
    "items": {
     "properties": {
      "album": {
       "description": "Album info for tracks",
       "type": "object"
      },
      "artist": {
       "description": "Artist info for tracks",
       "type": "object"
      },
      "duration": {
       "description": "Duration in seconds (for tracks)",
       "type": "number"
      },
      "id": {
       "description": "Resource ID",
       "type": "number"
      },
      "name": {
       "description": "Resource name (for artists/playlists)",
       "type": "string"
      },
      "picture": {
       "description": "Image URL",
       "type": "string"
      },
      "preview": {
       "description": "Preview URL",
       "type": "string"
      },
      "title": {
       "description": "Resource title or name",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "next": {
    "description": "URL to next page of results",
    "type": "string"
   },
   "total": {
    "description": "Total number of results",
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Search",
 "version": "v1.cadb2b16"
}

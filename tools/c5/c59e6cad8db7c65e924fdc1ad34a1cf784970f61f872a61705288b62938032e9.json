{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add an opening title card (hook) or generic text overlay to a project timeline. Defaults to classic white: black text on a white card.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "durationSeconds": {
    "default": 4,
    "exclusiveMinimum": 0,
    "maximum": 3600,
    "minimum": 0,
    "type": "number"
   },
   "expectedRevision": {
    "description": "Expected sequence revision, or null.",
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "kind": {
    "default": "title_card",
    "description": "title_card is an opening hook. overlay is generic on-video text.",
    "enum": [
     "overlay",
     "title_card"
    ],
    "type": "string"
   },
   "layerIndex": {
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "size": {
    "default": "default",
    "description": "Title-card size. Ignored for overlay.",
    "enum": [
     "compact",
     "default",
     "bold"
    ],
    "type": "string"
   },
   "startSeconds": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "text": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "theme": {
    "default": "classic_white",
    "description": "Title-card look. classic_white is black text on a white card. Ignored for overlay.",
    "enum": [
     "classic_white",
     "legend_white",
     "white_black_outline",
     "stacked_black_white",
     "red_on_black",
     "black_on_yellow",
     "red_block"
    ],
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "text",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "add_text_overlay",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "affectedTimelineItemIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "baseRevision": {
    "type": "integer"
   },
   "createdTimelineItemIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "deletedTimelineItemIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "mutationReceipt": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ]
     },
     "operation": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "key",
     "operation",
     "status",
     "replayed"
    ],
    "type": "object"
   },
   "operationId": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "replayed": {
    "type": "boolean"
   },
   "result": {
    "type": "object"
   },
   "revision": {
    "type": "integer"
   },
   "txid": {
    "type": "number"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "operationId",
   "projectId",
   "baseRevision",
   "revision",
   "replayed",
   "txid",
   "affectedTimelineItemIds",
   "createdTimelineItemIds",
   "deletedTimelineItemIds",
   "warnings",
   "result",
   "mutationReceipt"
  ],
  "type": "object"
 },
 "title": "Add Title Card"
}

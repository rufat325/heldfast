{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search active for-sale property listings across the US \u2014 filter by city, state, ZIP, price range, bedrooms, bathrooms, sqft, property type. Returns address, price, specs, photos. Millions of MLS listings (RapidAPI / Realtor.com data)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baths_min": {
    "description": "Minimum number of bathrooms",
    "minimum": 1,
    "type": "integer"
   },
   "beds_min": {
    "description": "Minimum number of bedrooms",
    "minimum": 1,
    "type": "integer"
   },
   "city": {
    "description": "City name, e.g. \"Austin\" (use with state_code)",
    "type": "string"
   },
   "limit": {
    "description": "Number of results (default 10, max 42)",
    "maximum": 42,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset (default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "postal_code": {
    "description": "ZIP code, e.g. \"78701\" (alternative to city+state)",
    "type": "string"
   },
   "price_max": {
    "description": "Maximum listing price in USD",
    "type": "integer"
   },
   "price_min": {
    "description": "Minimum listing price in USD",
    "type": "integer"
   },
   "property_type": {
    "description": "Property type filter",
    "enum": [
     "single_family",
     "multi_family",
     "condo",
     "townhomes",
     "mobile",
     "land",
     "farm"
    ],
    "type": "string"
   },
   "sort": {
    "description": "Sort order (default: relevant)",
    "enum": [
     "relevant",
     "newest",
     "price_low",
     "price_high",
     "open_house_date",
     "sqft_high",
     "price_reduced_date"
    ],
    "type": "string"
   },
   "sqft_min": {
    "description": "Minimum square footage",
    "type": "integer"
   },
   "state_code": {
    "description": "Two-letter US state code, e.g. \"TX\"",
    "maxLength": 2,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "realestate.listings.for_sale",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "description": "Present only when the call failed. Includes error code, message, request_id, and any provider-specific extras."
   },
   "result": {
    "description": "Tool response payload. Shape varies per tool \u2014 consult the tool description and inputSchema. May be an object, array, string, or number depending on the upstream provider response."
   }
  },
  "type": "object"
 },
 "title": "Search US Properties For Sale"
}

    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   },
   "role": {
    "default": "all",
    "enum": [
     "all",
     "requester",
     "provider"
    ],
    "type": "string"
   },
   "state": {
    "default": "all",
    "enum": [
     "all",
     "INITIATED",
     "QUOTED",
     "COMMITTED",
     "IN_PROGRESS",
     "DELIVERED",
     "SETTLED",
     "DISPUTED",
     "CANCELLED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "agirails_list_transactions"
}

{
 "description": "Add a new database connection to DBX",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "database": {
    "type": "string"
   },
   "db_type": {
    "type": "string"
   },
   "driver_profile": {
    "type": "string"
   },
   "host": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "password": {
    "default": "",
    "type": "string"
   },
   "port": {
    "format": "uint16",
    "maximum": 65535,
    "minimum": 0,
    "type": "integer"
   },
   "ssl": {
    "default": false,
    "type": "boolean"
   },
   "username": {
    "default": "",
    "type": "string"
   }
  },
  "required": [
   "name",
   "db_type",
   "host"
  ],
  "type": "object"
 },
 "name": "dbx_add_connection"
}

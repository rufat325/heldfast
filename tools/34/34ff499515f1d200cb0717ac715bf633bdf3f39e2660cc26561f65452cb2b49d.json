{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:scan"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a PDF check by id"
 },
 "description": "Polls a PDF check started by check_pdf \u2014 status, failed-rule and failed-check counts, and a failure reason if it did not complete.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checkId": {
    "description": "The id returned by check_pdf.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "checkId"
  ],
  "type": "object"
 },
 "name": "get_pdf_check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "coverageDisclaimer": {
    "description": "Why this result is not a compliance verdict. Always relay it; never present a scan as proof of conformance.",
    "type": "string"
   },
   "pdfCheck": {
    "additionalProperties": false,
    "properties": {
     "failureReason": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "string"
         },
         "reason": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "code"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "profile": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "summary": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "failedCheckCount": {
          "type": [
           "number",
           "null"
          ]
         },
         "failedRuleCount": {
          "type": [
           "number",
           "null"
          ]
         },
         "reportTruncated": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "totalAssertions": {
          "type": [
           "number",
           "null"
          ]
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "status",
     "profile"
    ],
    "type": "object"
   },
   "scoringGuidance": {
    "description": "Binding instruction for the assistant reading this result. Follow it literally.",
    "type": "string"
   },
   "standard": {
    "description": "The standard the checks were run against, e.g. \"WCAG 2.1 AA\".",
    "type": "string"
   }
  },
  "required": [
   "pdfCheck",
   "coverageDisclaimer",
   "scoringGuidance",
   "standard"
  ],
  "type": "object"
 },
 "title": "Get a PDF check by id"
}

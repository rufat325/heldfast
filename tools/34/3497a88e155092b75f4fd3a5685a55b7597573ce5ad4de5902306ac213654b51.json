   },
   "instance": {
    "description": "Default public.opendatasoft.com.",
    "type": "string"
   },
   "q": {
    "type": "string"
   },
   "rows": {
    "type": "number"
   },
   "sort": {
    "type": "string"
   },
   "start": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "datasets",

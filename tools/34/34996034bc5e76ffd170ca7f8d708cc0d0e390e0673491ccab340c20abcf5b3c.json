{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs ShellCheck (shell script linter) and returns structured diagnostics (file, line, column, rule, severity, message).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checkSourced": {
    "description": "Check sourced/included files (maps to --check-sourced)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "enable": {
    "description": "Optional checks to enable, e.g. ['add-default-case', 'require-variable-braces'] (maps to --enable)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "exclude": {
    "description": "Check codes to exclude, e.g. ['SC2086', 'SC2034'] (maps to --exclude)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "externalSources": {
    "description": "Allow following source statements to external files (maps to --external-sources)",
    "type": "boolean"
   },
   "include": {
    "description": "Only report these check codes (maps to --include)",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "norc": {
    "description": "Disable .shellcheckrc config file lookup (maps to --norc)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "."
    ],
    "description": "File paths or glob patterns to check (default: ['.']). Directories are automatically expanded to include *.sh, *.bash, *.zsh, *.ksh, *.dash files.",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "rcfile": {
    "description": "Path to a custom ShellCheck config file (maps to --rcfile)",
    "maxLength": 4096,
    "type": "string"
   },
   "severity": {
    "description": "Minimum severity level to report (default: style)",
    "enum": [
     "error",
     "warning",
     "info",
     "style"
    ],
    "type": "string"
   },
   "shell": {
    "description": "Shell dialect to assume (maps to --shell)",
    "enum": [
     "sh",
     "bash",
     "dash",
     "ksh"
    ],
    "type": "string"
   },
   "sourcePath": {
    "description": "Path to resolve source commands (maps to --source-path)",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "shellcheck",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deprecationCount": {
    "type": "number"
   },
   "deprecations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reference": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "severity",
      "rule",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnosticsTruncated": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "errors": {
    "type": "number"
   },
   "exitCode": {
    "type": "number"
   },
   "filesChecked": {
    "type": "number"
   },
   "fixableErrorCount": {
    "type": "number"
   },
   "fixableWarningCount": {
    "type": "number"
   },
   "omittedCount": {
    "type": "number"
   },
   "warnings": {
    "type": "number"
   }
  },
  "required": [
   "errors",
   "warnings",
   "filesChecked"
  ],
  "type": "object"
 },
 "title": "ShellCheck"
}

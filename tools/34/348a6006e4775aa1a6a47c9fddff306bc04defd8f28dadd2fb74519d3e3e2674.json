{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Get or set OSS Autopilot configuration values. With no args, shows all config. With key and value, sets the value.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "key": {
    "description": "Configuration key to get or set. Must be one of the known keys (derived from @oss-autopilot/core config-registry). Examples: \"username\", \"languages\", \"minStars\". Run the tool with no args to see all current config.",
    "enum": [
     "username",
     "maxActivePRs",
     "dormantDays",
     "approachingDays",
     "languages",
     "labels",
     "scope",
     "minStars",
     "includeDocIssues",
     "maxIssueAgeDays",
     "skipBroadWhenSufficientResults",
     "minRepoScoreThreshold",
     "projectCategories",
     "preferredOrgs",
     "aiPolicyBlocklist",
     "avoidRepos",
     "boostIssueTypes",
     "issueListPath",
     "skippedIssuesPath",
     "diffTool",
     "diffToolCustomCommand",
     "squashByDefault",
     "persistence",
     "autoExtractLearnings",
     "autoFormatBeforePush",
     "trustOwnRepoWrites",
     "healthCheckFreshnessMinutes",
     "reviewMaxPasses",
     "complete",
     "add-language",
     "add-label",
     "remove-label",
     "add-scope",
     "remove-scope",
     "exclude-repo",
     "exclude-org",
     "add-avoid-repo",
     "remove-avoid-repo",
     "add-boost-issue-type",
     "remove-boost-issue-type"
    ],
    "type": "string"
   },
   "value": {
    "description": "Value to set for the given key. Omit to read the current value.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "config"
}

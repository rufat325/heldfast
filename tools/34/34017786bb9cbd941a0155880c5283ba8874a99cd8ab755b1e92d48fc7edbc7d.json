{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get one institution's spot crypto-ETF holdings (Bitcoin ETF complex): its per-ETF positions in the latest filed quarter (shares, USD, QoQ change, action) plus its rank among all crypto-ETF holders. Use a CIK number (find it with get_crypto_holders or the search tool).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "institution": {
    "description": "Institution CIK number (e.g. '1512857' for Brevan Howard) or name (e.g. 'BlackRock').",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "institution"
  ],
  "type": "object"
 },
 "name": "get_crypto_holder",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cik": {
    "type": [
     "string",
     "null"
    ]
   },
   "institution": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "latest_quarter": {
        "$ref": "#/properties/cik"
       },
       "name": {
        "$ref": "#/properties/cik"
       },
       "portfolio_weight_pct": {
        "$ref": "#/properties/institution/anyOf/0/properties/total_usd"
       },
       "qoq_change": {
        "$ref": "#/properties/institution/anyOf/0/properties/total_usd"
       },
       "rank": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "total_holders": {
        "$ref": "#/properties/institution/anyOf/0/properties/rank"
       },
       "total_usd": {
        "anyOf": [
         {
          "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
       }
      },
      "required": [
       "name",
       "latest_quarter",
       "total_usd",
       "qoq_change",
       "rank",
       "total_holders",
       "portfolio_weight_pct"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "plan_limit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "continuation": {
        "$ref": "#/properties/cik"
       },
       "date_basis": {
        "$ref": "#/properties/cik"
       },
       "effective_period": {
        "$ref": "#/properties/cik"
       },
       "policy_version": {
        "$ref": "#/properties/cik"
       },
       "row_cap": {
        "$ref": "#/properties/institution/anyOf/0/properties/rank"
       },
       "truncated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "window_end": {
        "$ref": "#/properties/cik"
       },
       "window_start": {
        "$ref": "#/properties/cik"
       }
      },
      "required": [
       "policy_version",
       "window_start",
       "window_end",
       "effective_period",
       "date_basis",
       "row_cap",
       "truncated",
       "continuation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The Free/keyless plan limits ko.io applied to this answer (null for paid callers)"
   },
   "positions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "$ref": "#/properties/cik"
      },
      "product_name": {
       "$ref": "#/properties/cik"
      },
      "product_ticker": {
       "$ref": "#/properties/cik"
      },
      "qoq_value_change": {
       "$ref": "#/properties/institution/anyOf/0/properties/total_usd"
      },
      "shares_held": {
       "$ref": "#/properties/institution/anyOf/0/properties/total_usd"
      },
      "usd_value": {
       "$ref": "#/properties/institution/anyOf/0/properties/total_usd"
      }
     },
     "required": [
      "product_ticker",
      "product_name",
      "shares_held",
      "usd_value",
      "qoq_value_change",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "requested": {
    "type": "string"
   }
  },
  "required": [
   "requested",
   "cik",
   "institution",
   "positions",
   "plan_limit"
  ],
  "type": "object"
 }
}

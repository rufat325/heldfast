{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "List DNS records in a service zone, with paging and server-side filtering. Returns the API pagination envelope unflattened.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "descending": {
    "description": "Reverse the sort order.",
    "type": "boolean"
   },
   "filters": {
    "additionalProperties": false,
    "description": "Server-side filters. Note the type list here excludes DNSSEC and NS, which are creatable but not filterable.",
    "properties": {
     "content": {
      "type": "string"
     },
     "flags": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "name": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "port": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "priority": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "tag": {
      "items": {
       "enum": [
        "issue",
        "issuewild",
        "iodef"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "ttl": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "type": {
      "items": {
       "enum": [
        "A",
        "AAAA",
        "ANAME",
        "CAA",
        "CNAME",
        "MX",
        "SRV",
        "TXT",
        "CERT",
        "LOC",
        "SSHFP",
        "TLSA",
        "DS"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "weight": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "page": {
    "description": "1-based page number.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "rowsPerPage": {
    "description": "Records per page.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "service": {
    "description": "Service identifier the zone belongs to. See ws_service_list for the account's services.",
    "minLength": 1,
    "type": "string"
   },
   "sortBy": {
    "description": "Field name to sort by.",
    "type": "string"
   }
  },
  "required": [
   "service"
  ],
  "type": "object"
 },
 "name": "ws_dns_record_list",
 "title": "List DNS records"
}

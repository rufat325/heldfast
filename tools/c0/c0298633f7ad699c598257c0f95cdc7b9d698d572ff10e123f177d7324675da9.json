{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when a prototype or test needs the complete fictional FinchNode FHIR R4 Bundle for one scenario and its resource references. Behaviors apply to record reads only, so every scenario returns its Bundle.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "scenario": {
    "description": "Optional scenario id from list_demo_scenarios. Omitted means baseline-adult.",
    "enum": [
     "baseline-adult",
     "polypharmacy-senior",
     "pediatric-asthma",
     "multi-source-overlap",
     "sparse-record",
     "messy-coding",
     "rate-limited",
     "consent-revoked",
     "consent-partial",
     "source-unavailable"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_demo_fhir_bundle",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundle": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "bundle"
  ],
  "type": "object"
 },
 "title": "Get synthetic FHIR Bundle"
}

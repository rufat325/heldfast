 "description": "Relationship timeline for one CRM person: interactions rows (message/call/meeting/note + extended kinds like visit/gift/stayed_over encoded in summary) plus co-tagged calendar events. Prefer this over dumping people.notes for \u201cwhen did I last see X?\u201d. Pass person_id or name. ($0.10; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Inclusive YYYY-MM-DD filter",
    "type": "string"
   },
   "kind": {
    "description": "Optional filter: meeting, visit, gift, stayed_over, met, \u2026",
    "type": "string"
   },
   "limit": {
    "description": "Max rows 1\u2013100, default 40",
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "person_id": {
    "type": "string"
   },
   "to": {
    "description": "Inclusive YYYY-MM-DD filter",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_person_interactions",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "events": {
    "items": {
     "additionalProperties": true,

{
 "description": "Returns carrier matches and market budget estimates. Supply confirmed classification and actual exposures. Missing inputs, unsupported terms and partial coverage are returned explicitly. State-fund WC is returned separately in stateFundEstimates, including an Ohio BWC estimate from published rates that is not a BWC quote.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "annual_payroll": {
    "description": "Actual annual payroll; never infer from revenue",
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "annual_revenue": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "building_value": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "business_description": {
    "maxLength": 4000,
    "type": "string"
   },
   "business_property_value": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "city": {
    "maxLength": 200,
    "type": "string"
   },
   "coverage_limits": {
    "additionalProperties": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "propertyNames": {
     "enum": [
      "BOP",
      "GL",
      "WC",
      "commercial_auto"
     ],
     "type": "string"
    },
    "type": "object"
   },
   "current_carrier": {
    "maxLength": 200,
    "type": "string"
   },
   "current_policy_expiration": {
    "description": "When the current policy expires or renews (YYYY-MM-DD), if known. Omit dates more than 365 days past or 730 days ahead",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "deductibles": {
    "additionalProperties": {
     "maximum": 1000000000000,
     "minimum": 0,
     "type": "number"
    },
    "propertyNames": {
     "enum": [
      "BOP",
      "GL",
      "WC",
      "commercial_auto"
     ],
     "type": "string"
    },
    "type": "object"
   },
   "desired_coverages": {
    "items": {
     "enum": [
      "BOP",
      "GL",
      "WC",
      "commercial_auto"
     ],
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "effective_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "employee_count": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "experience_modifier": {
    "exclusiveMinimum": 0,
    "maximum": 10,
    "type": "number"
   },
   "has_alcohol": {
    "type": "boolean"
   },
   "has_delivery": {
    "type": "boolean"
   },
   "iso_gl_code": {
    "pattern": "^\\d{3,6}$",
    "type": "string"
   },
   "naics_code": {
    "pattern": "^\\d{6}$",
    "type": "string"
   },
   "payroll_by_class": {
    "description": "Actual payroll split by state and workers compensation classification",
    "items": {
     "properties": {
      "class_code": {
       "pattern": "^\\d{1,6}$",
       "type": "string"
      },
      "class_system": {
       "maxLength": 30,
       "minLength": 1,
       "type": "string"
      },
      "payroll": {
       "exclusiveMinimum": 0,
       "maximum": 1000000000000,
       "type": "number"
      },
      "state": {
       "type": "string"
      }
     },
     "required": [
      "state",
      "class_code",
      "payroll"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "prior_loss_details": {
    "maxLength": 4000,
    "type": "string"
   },
   "prior_losses": {
    "type": "boolean"
   },
   "serves_food": {
    "type": "boolean"
   },
   "source": {
    "maxLength": 50,
    "type": "string"
   },
   "square_footage": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "state": {
    "type": "string"
   },
   "vehicle_count": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "vehicle_types": {
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "years_in_business": {
    "maximum": 300,
    "minimum": 0,
    "type": "number"
   },
   "zip_code": {
    "pattern": "^\\d{5}(-\\d{4})?$",
    "type": "string"
   }
  },
  "required": [
   "state",
   "annual_revenue",
   "desired_coverages"
  ],
  "type": "object"
 },
 "name": "get_carrier_recommendations"
}

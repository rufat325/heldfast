{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Life Context pack: identity, pulse, people, next actions, memories, quizzes, recent consented place visits, and traced facts. Use include_*=false to omit default sections; current location and money stay opt-in. Spec: https://dayze.com/docs/life-context ($0.20; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "focus": {
    "description": "Optional focus hint echoed in the pack (e.g. places, travel, people)",
    "type": "string"
   },
   "include_location": {
    "default": false,
    "description": "Include city/country label; never returns a precise address",
    "type": "boolean"
   },
   "include_memories": {
    "default": true,
    "description": "Include recent memories.",
    "type": "boolean"
   },
   "include_money": {
    "default": false,
    "description": "Include the private cashflow summary",
    "type": "boolean"
   },
   "include_place_visits": {
    "default": true,
    "description": "Include recent venue visits; never a GPS trail",
    "type": "boolean"
   },
   "include_places": {
    "default": false,
    "description": "Include recent canonical places.",
    "type": "boolean"
   },
   "include_quiz_results": {
    "default": true,
    "description": "Include latest quiz results.",
    "type": "boolean"
   },
   "include_relationships": {
    "default": true,
    "description": "Include people and relationship context.",
    "type": "boolean"
   },
   "include_trips": {
    "default": false,
    "description": "Include recent/upcoming trips from completed travel history",
    "type": "boolean"
   },
   "query": {
    "description": "Question that guides facts and memories.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_context_pack",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "error": {
    "description": "Present when life state is unavailable.",
    "type": "string"
   },
   "facts": {
    "description": "Question-aware personal facts, in selection order.",
    "items": {
     "additionalProperties": true,
     "description": "One personal fact chosen for the question. Same ids as Dayze chat.",
     "properties": {
      "age_label": {
       "type": [
        "string",
        "null"
       ]
      },
      "confidence": {
       "type": [
        "number",
        "null"
       ]
      },
      "evidence_ref": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Table-qualified record id, e.g. people:<uuid> or events:<id>.",
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "last_confirmed_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "observed_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "provenance": {
       "description": "stated, observed, inferred or imported.",
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "source_label": {
       "description": "Where the fact came from, e.g. \"from Contacts\".",
       "type": "string"
      },
      "source_ref": {
       "type": [
        "string",
        "null"
       ]
      },
      "state": {
       "description": "current, planned, completed, stale (age_label set) or disputed.",
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "tier": {
       "description": "entity, join, static, dynamic or vector.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "kind",
      "text",
      "state",
      "source_label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "focus": {
    "type": [
     "string",
     "null"
    ]
   },
   "generated_at": {
    "type": "string"
   },
   "identity": {
    "additionalProperties": true,
    "type": "object"
   },
   "known_facts": {
    "items": {
     "additionalProperties": true,
     "description": "A correctable contact, learned fact or memory from the facts slice: ref (in trace.fact_ids), kind, text, source. Disputed or no-longer-true facts are left out.",
     "type": "object"
    },
    "type": "array"
   },
   "memories": {
    "additionalProperties": true,
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "omitted": {
    "description": "Facts left out, counted by reason.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "count": {
       "type": "number"
      },
      "kind": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "reason",
      "kind",
      "count"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "partial": {
    "type": "boolean"
   },
   "place_visits": {
    "items": {
     "additionalProperties": true,
     "description": "Recent place visit.",
     "type": "object"
    },
    "type": "array"
   },
   "places": {
    "additionalProperties": true,
    "description": "Recent canonical places when include_places=true.",
    "type": "object"
   },
   "preferred_tool": {
    "type": "string"
   },
   "protocol": {
    "additionalProperties": true,
    "description": "Life Context metadata.",
    "type": "object"
   },
   "pulse": {
    "additionalProperties": true,
    "type": "object"
   },
   "query": {
    "type": [
     "string",
     "null"
    ]
   },
   "redaction": {
    "additionalProperties": true,
    "description": "pii redacted|raw; sensitive_topics the caller may receive; counts of sensitive trackers / memories withheld.",
    "type": "object"
   },
   "sections": {
    "additionalProperties": true,
    "description": "Per-section ok/error status for partial packs.",
    "type": "object"
   },
   "trace": {
    "additionalProperties": true,
    "description": "Which facts were supplied and why. fact_ids equals facts[].id.",
    "properties": {
     "assembler": {
      "type": "string"
     },
     "budget_tokens": {
      "type": "number"
     },
     "caller": {
      "type": "string"
     },
     "fact_ids": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "question": {
      "type": "string"
     },
     "scope_key": {
      "type": "string"
     },
     "selection_notes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "used_tokens": {
      "type": "number"
     }
    },
    "required": [
     "fact_ids",
     "assembler"
    ],
    "type": "object"
   },
   "trips": {
    "additionalProperties": true,
    "description": "Recent trips when include_trips=true.",
    "type": "object"
   },
   "whats_next": {
    "additionalProperties": true,
    "type": "object"
   },
   "who_matters": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "protocol",
   "preferred_tool",
   "identity",
   "pulse",
   "whats_next"
  ],
  "type": "object"
 },
 "readOnlyHint": true,
 "securitySchemes": [
  {
   "scopes": [
    "context.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Life Context Pack"
}

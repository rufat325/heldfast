{
 "description": "Fetch Google Maps reviews for place ids or place queries.\n\nBest for:\n- review analysis\n- recent-review monitoring\n- targeted review extraction for specific places\n\nPrefer this tool when:\n- the user needs review text, review counts, or review metadata\n- you already know the place or can identify it from a query\n- async polling is acceptable for heavier review jobs\n\nUse async mode when:\n- review volume is large\n- you query many places in one request\n- you want to poll progress later with requests_get\n\nDo not use this for basic place discovery:\n- use google_maps_search first\n- then use google_maps_reviews once you know the target place or query set",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "async": {
    "description": "Deprecated compatibility flag. Prefer execution_mode.",
    "type": "boolean"
   },
   "cutoff": {
    "description": "Cutoff date/timestamp accepted by Outscraper.",
    "type": "string"
   },
   "cutoff_rating": {
    "description": "Minimum rating cutoff.",
    "maximum": 5,
    "minimum": 1,
    "type": "number"
   },
   "execution_mode": {
    "description": "Execution strategy. Use auto to let the MCP server choose between sync and async.",
    "enum": [
     "auto",
     "sync",
     "async"
    ],
    "type": "string"
   },
   "fields": {
    "description": "Specific review fields to return.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ignore_empty": {
    "description": "Skip places without reviews.",
    "type": "boolean"
   },
   "language": {
    "description": "Language code, for example en.",
    "type": "string"
   },
   "last_pagination_id": {
    "description": "Resume token from previous page.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of places to process.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "One or more place ids or Google Maps business queries.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "region": {
    "description": "Region code, for example us.",
    "type": "string"
   },
   "reviews_limit": {
    "description": "Maximum reviews per place.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "reviews_query": {
    "description": "Optional keyword filter inside reviews.",
    "type": "string"
   },
   "sort": {
    "description": "Review sorting mode.",
    "enum": [
     "most_relevant",
     "newest",
     "highest_rating",
     "lowest_rating"
    ],
    "type": "string"
   },
   "source": {
    "description": "Review source.",
    "enum": [
     "google",
     "tripadvisor",
     "booking",
     "yelp"
    ],
    "type": "string"
   },
   "start": {
    "description": "Start date or offset accepted by Outscraper.",
    "type": "string"
   },
   "webhook": {
    "description": "Optional webhook URL for async completion.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "google_maps_reviews",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "async": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "is_async_submission": {
      "type": "boolean"
     },
     "next_step": {
      "type": "string"
     },
     "results_location": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "is_async_submission"
    ],
    "type": "object"
   },
   "data": {},
   "meta": {
    "additionalProperties": false,
    "properties": {
     "operation": {
      "type": "string"
     },
     "service": {
      "type": "string"
     }
    },
    "required": [
     "service",
     "operation"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "Google Maps Reviews"
}

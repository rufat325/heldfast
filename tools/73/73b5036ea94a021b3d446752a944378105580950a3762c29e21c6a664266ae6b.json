{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List contacts"
 },
 "description": "List contacts. Cursor-paginated, newest first. Filters combine with AND.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel": {
    "description": "Channel the contact was seen on.",
    "enum": [
     "facebook",
     "instagram",
     "sms",
     "telegram",
     "whatsapp"
    ],
    "type": "string"
   },
   "email": {
    "description": "Exact email match.",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Page size, 1 to 100. Default 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Substring match on the display name.",
    "type": "string"
   },
   "phone": {
    "description": "Exact phone match.",
    "type": "string"
   },
   "stage": {
    "description": "Pipeline stage.",
    "enum": [
     "new",
     "contacted",
     "qualified",
     "customer",
     "lost"
    ],
    "type": "string"
   },
   "starting_after": {
    "description": "The next_cursor from the previous page.",
    "type": "string"
   },
   "tag": {
    "description": "Exact tag name the contact carries.",
    "type": "string"
   },
   "updated_since": {
    "description": "ISO-8601 UTC. Contacts updated at or after this time.",
    "format": "date-time",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_contacts"
}

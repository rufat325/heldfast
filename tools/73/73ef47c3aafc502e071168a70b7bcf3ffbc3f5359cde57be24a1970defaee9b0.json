{
 "description": "Set What's New text for a TestFlight build (shown to testers)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "buildId": {
    "description": "Build ID",
    "type": "string"
   },
   "locale": {
    "default": "en-US",
    "description": "Locale code (en-US, tr, de-DE, es-MX, fr-FR, ru, ar-SA)",
    "enum": [
     "en-US",
     "tr",
     "de-DE",
     "es-MX",
     "fr-FR",
     "ru",
     "ar-SA"
    ],
    "type": "string"
   },
   "whatsNew": {
    "description": "What's New text for testers",
    "type": "string"
   }
  },
  "required": [
   "buildId",
   "whatsNew"
  ],
  "type": "object"
 },
 "name": "asc_set_testflight_whats_new"
}

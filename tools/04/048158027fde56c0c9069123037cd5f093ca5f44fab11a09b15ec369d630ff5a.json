 "description": "Get ranked SeatGeek event recommendations SIMILAR TO a seed you supply \u2014 a performer id, an event id, or the performers of an event. Requires at least one seed; it is not a personalized feed for an anonymous user. Optional filters (geoip, lat/lon, postal_code, datetime_utc, per_page) narrow the result.",
 "inputSchema": {
  "examples": [
   {
    "per_page": 10,
    "performers.id": 35
   }
  ],
  "properties": {
   "datetime_utc.gte": {
    "description": "Only recommend events at or after this UTC datetime, e.g. \"2026-09-01T00:00:00\".",
    "type": "string"
   },
   "events.id": {
    "description": "Seed: recommend events similar to this event id. Get one from the events tool.",
    "type": "number"
   },
   "events.performers.id": {
    "description": "Seed: recommend events similar to the performers appearing at this event id.",
    "type": "number"
   },
   "lat": {
    "description": "Latitude to rank recommendations around; pair with lon.",
    "type": "number"
   },
   "lon": {
    "description": "Longitude to rank recommendations around; pair with lat.",
    "type": "number"
   },
   "per_page": {
    "description": "Results per page (default 10).",
    "type": "number"
   },
   "performers.id": {
    "description": "Seed: recommend events similar to this performer id (e.g. 35). Get one from the performers tool.",
    "type": "number"
   },
   "postal_code": {
    "description": "Restrict recommendations to a US postal code, e.g. \"94002\".",
    "type": "string"
   }
  },
  "type": "object"
 },

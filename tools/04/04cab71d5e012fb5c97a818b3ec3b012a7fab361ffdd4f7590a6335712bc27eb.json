{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Multi-agent shared spatial blackboard for intent publishing and claiming mutex locks. Actions: get, set, delete, lease, list (legacy: post, read, claim, release).",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform (default: get)",
    "type": "string"
   },
   "agent_id": {
    "description": "Agent identifier (alias for sender)",
    "type": "string"
   },
   "duration_seconds": {
    "description": "Lease duration in seconds (default: 60)",
    "type": "number"
   },
   "id": {
    "description": "Blackboard entry identifier for get or delete",
    "type": "string"
   },
   "include_expired": {
    "description": "Whether to include expired entries",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum number of items or topics to return",
    "type": "number"
   },
   "mode": {
    "description": "Lease action mode: acquire or release (default: acquire)",
    "enum": [
     "acquire",
     "release"
    ],
    "type": "string"
   },
   "payload": {
    "description": "Payload object (supports coordinates for collision alerts)",
    "type": "object"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   },
   "resource_id": {
    "description": "Resource or entity ID to lease or release",
    "type": "string"
   },
   "sender": {
    "description": "Agent identifier posting or claiming",
    "type": "string"
   },
   "topic": {
    "description": "Blackboard topic name",
    "type": "string"
   },
   "topic_prefix": {
    "description": "Prefix filter for listing topics",
    "type": "string"
   },
   "ttl_seconds": {
    "description": "Post TTL expiration in seconds",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "use_spatial_blackboard"
}

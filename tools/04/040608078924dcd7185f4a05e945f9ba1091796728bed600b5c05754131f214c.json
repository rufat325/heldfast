 },
 "description": "Return bounded Plausible metrics grouped by day, week, month, or hour. Answers when traffic, engagement, conversions, or revenue changed during a period.",
 "inputSchema": {
  "examples": [
   {
    "_apiKey": "your-plausible-stats-api-key",
    "date_range": "30d",
    "interval": "day",
    "metrics": [
     "visitors",
     "pageviews"
    ],
    "site_id": "example.com"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "Plausible Stats API key",
    "type": "string"
   },
   "date_range": {
    "anyOf": [
     {
      "enum": [
       "day",
       "24h",
       "7d",
       "28d",
       "30d",
       "91d",
       "month",
       "6mo",
       "12mo",
       "year",
       "all"
      ],
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
     }
    ],
    "description": "Plausible date range preset or a two-item ISO date array"
   },
   "goal": {
    "description": "Limit metrics to one configured goal display name",
    "type": "string"
   },
   "interval": {
    "description": "Time bucket",
    "enum": [
     "hour",
     "day",
     "week",
     "month"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Maximum rows, default 100 and maximum 500",
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "metrics": {
    "description": "Plausible metric names; defaults to visitors and pageviews",
    "items": {
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "site_id": {
    "description": "Plausible site ID, usually the configured domain such as example.com",
    "type": "string"
   }
  },
  "required": [
   "_apiKey",
   "site_id",
   "date_range",
   "interval"
  ],
  "type": "object"
 },

{
 "description": "Update an existing product",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "id": {
    "description": "The product ID to update",
    "type": "string"
   },
   "productType": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ACTIVE",
     "DRAFT",
     "ARCHIVED"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "vendor": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "updateProduct"
}

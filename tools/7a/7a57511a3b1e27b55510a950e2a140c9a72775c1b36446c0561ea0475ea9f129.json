{
 "_meta": {
  "fastmcp": {
   "tags": []
  },
  "ui": {
   "resourceUri": "ui://agentic-atlas/card.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read Atlas Cards"
 },
 "description": "Read 1-4 canonical ids as one ordered Card per id: identity,\nHook, and sealed claims with source addresses. Set provenance=true\nto expand every cited source's Release-bound audit facts in the same\natomic response.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "expected_revision": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "A prior payload's 'coherence'; 'revision_changed' refuses a moved Release."
   },
   "ids": {
    "description": "1-4 distinct canonical node ids.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "provenance": {
    "default": false,
    "description": "Include expanded audit facts for cited sources.",
    "type": "boolean"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "atlas_cards",
 "outputSchema": {
  "properties": {
   "coherence": {
    "type": "string"
   },
   "data": {
    "type": "object"
   },
   "payload_class": {
    "enum": [
     "cards"
    ],
    "type": "string"
   },
   "projection": {
    "const": "agent-projection/v6"
   },
   "scope": {
    "type": "object"
   }
  },
  "required": [
   "projection",
   "coherence",
   "payload_class",
   "scope",
   "data"
  ],
  "type": "object"
 },
 "title": "Read Atlas Cards"
}

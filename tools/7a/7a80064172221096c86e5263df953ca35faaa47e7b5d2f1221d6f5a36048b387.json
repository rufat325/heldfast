 "description": "Find which documentation SETS exist whose NAME matches a substring (e.g. \"python\" \u2192 Python 3.x, \"react\" \u2192 React). Returns doc SETS, NOT their content \u2014 this does NOT look up a function/method/API name. To search inside a doc for an entry like \"Array.map\" or \"fetch\", use search_index (slug + query).",
 "inputSchema": {
  "examples": [
   {
    "query": "javascript"
   },
   {
    "query": "react hooks"
   }
  ],
  "properties": {
   "query": {
    "description": "Substring of a documentation-set name, e.g. \"javascript\", \"postgres\".",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_docs",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Number of items returned.",
    "type": "integer"
   },
   "items": {
    "items": {
     "properties": {

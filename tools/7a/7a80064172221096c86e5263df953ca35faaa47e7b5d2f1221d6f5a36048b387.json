       "type": "string"
      },
      "slug": {
       "description": "URL slug identifier for the documentation",
       "type": "string"
      },
      "type": {
       "description": "Type category of the documentation",
       "type": "string"
      },
      "version": {
       "description": "Version number if applicable",
       "type": "string"
      }
     },
     "required": [
      "name",
      "slug",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [

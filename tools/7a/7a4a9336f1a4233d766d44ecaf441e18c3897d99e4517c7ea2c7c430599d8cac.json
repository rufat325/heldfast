{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Write operation: create a hosted ZEN checkout link and QR code for a customer to pay.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ]
   },
   "currency": {
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "customIpnUrl": {
    "format": "uri",
    "type": "string"
   },
   "description": {
    "maxLength": 500,
    "type": "string"
   },
   "expiresAt": {
    "format": "date-time",
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "merchantTransactionId": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "amount",
   "currency",
   "merchantTransactionId"
  ],
  "type": "object"
 },
 "name": "create_payment_link",
 "title": "Create payment link"
}

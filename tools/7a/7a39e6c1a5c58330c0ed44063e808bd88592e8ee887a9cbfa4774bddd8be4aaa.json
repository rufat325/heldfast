{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare stored brand and competitor mentions, share of voice, and prompt wins over a time window. Example: brand_id='acme', competitor_domains=['rival.com'], days=7.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brand_id": {
    "description": "Tracked brand ID to compare.",
    "type": "string"
   },
   "competitor_domains": {
    "description": "Competitor domains; omit to use the brand's configured list.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "days": {
    "default": 7,
    "description": "Previous days to compare.",
    "maximum": 90,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "brand_id"
  ],
  "type": "object"
 },
 "name": "compare_competitors",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brand_id": {
    "type": "string"
   },
   "competitors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "domain": {
       "type": "string"
      },
      "mentions": {
       "type": "number"
      },
      "prompts_won_against_you": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "share_of_voice_pct": {
       "type": "number"
      }
     },
     "required": [
      "domain",
      "share_of_voice_pct",
      "mentions",
      "prompts_won_against_you"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "days": {
    "type": "number"
   },
   "prompts_you_win": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "competitors_cited": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "prompt": {
       "type": "string"
      },
      "you_cited_by": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "prompt",
      "you_cited_by",
      "competitors_cited"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "requested_competitor_domains": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "your_mentions": {
    "type": "number"
   },
   "your_share_of_voice_pct": {
    "type": "number"
   }
  },
  "required": [
   "brand_id",
   "days",
   "your_share_of_voice_pct",
   "your_mentions",
   "competitors",
   "prompts_you_win",
   "requested_competitor_domains"
  ],
  "type": "object"
 },
 "title": "Compare competitor AI visibility"
}

{
 "description": "Check multiple URLs at once and get a summary table. Great for auditing an entire site or comparing competitors.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "urls": {
    "description": "List of URLs to check (max 20)",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "urls"
  ],
  "type": "object"
 },
 "name": "batch_check"
}

{
 "description": "Resolve multiple people to AnchorIDs in a single call (max 200). Each item needs a client_ref for correlation and at least one identifying field. Ambiguous matches return status needs_review with candidate AnchorIDs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "description": "Array of person resolution requests",
    "items": {
     "additionalProperties": false,
     "properties": {
      "client_ref": {
       "description": "Your reference ID for correlation",
       "type": "string"
      },
      "company_domain": {
       "type": "string"
      },
      "company_entity_id": {
       "type": "string"
      },
      "email": {
       "type": "string"
      },
      "identifiers": {
       "additionalProperties": false,
       "properties": {
        "google_user_id": {
         "type": "string"
        },
        "hubspot_contact_id": {
         "type": "string"
        },
        "phone": {
         "type": "string"
        },
        "salesforce_contact_id": {
         "type": "string"
        },
        "slack_user_id": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "min_confidence": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "client_ref"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "resolve_person_batch"
}

{
 "description": "Create a mock HTTP expectation on MockServer. Define request matching criteria and the response to return.",
 "inputSchema": {
  "properties": {
   "httpRequest": {
    "description": "Request matching criteria (method, path, headers, body, etc.)",
    "properties": {
     "body": {
      "description": "Body matcher configuration",
      "properties": {
       "matchType": {
        "enum": [
         "STRICT",
         "ONLY_MATCHING_FIELDS"
        ],
        "type": "string"
       },
       "type": {
        "enum": [
         "STRING",
         "JSON",
         "REGEX",
         "XPATH",
         "JSON_PATH"
        ],
        "type": "string"
       },
       "value": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "headers": {
      "description": "Headers to match",
      "type": "object"
     },
     "method": {
      "description": "HTTP method to match (GET, POST, PUT, DELETE, etc.)",
      "type": "string"
     },
     "path": {
      "description": "URL path to match",
      "type": "string"
     },
     "pathParameters": {
      "description": "Path parameters to match",
      "type": "object"
     },
     "queryStringParameters": {
      "description": "Query string parameters to match",
      "type": "object"
     }
    },
    "type": "object"
   },
   "httpResponse": {
    "description": "Response configuration",
    "properties": {
     "body": {
      "description": "Response body (string or object)"
     },
     "delay": {
      "description": "Response delay configuration",
      "properties": {
       "timeUnit": {
        "enum": [
         "MILLISECONDS",
         "SECONDS"
        ],
        "type": "string"
       },
       "value": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "headers": {
      "description": "Response headers",
      "type": "object"
     },
     "statusCode": {
      "description": "HTTP status code to return",
      "type": "number"
     }
    },
    "type": "object"
   },
   "id": {
    "description": "Optional expectation identifier",
    "type": "string"
   },
   "timeToLive": {
    "description": "How long this expectation should remain active",
    "properties": {
     "timeToLive": {
      "type": "number"
     },
     "timeUnit": {
      "enum": [
       "MILLISECONDS",
       "SECONDS",
       "MINUTES"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "times": {
    "description": "How many times this expectation should be matched",
    "properties": {
     "remainingTimes": {
      "type": "number"
     },
     "unlimited": {
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "httpRequest"
  ],
  "type": "object"
 },
 "name": "mockserver_create_expectation"
}

{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the current crypto Topic landscape.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "projectId": {
    "description": "Only Topics currently associated with this Project ID",
    "type": "string"
   },
   "ranking": {
    "default": "trend",
    "description": "trend for sustained attention",
    "enum": [
     "trend"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_topics",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authorCount": {
       "type": "number"
      },
      "clusters": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "cluster": {
          "additionalProperties": false,
          "properties": {
           "id": {
            "type": "string"
           },
           "name": {
            "type": "string"
           }
          },
          "required": [
           "id",
           "name"
          ],
          "type": "object"
         },
         "share": {
          "type": "number"
         }
        },
        "required": [
         "cluster",
         "share"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "lastSeenAt": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "postCount": {
       "type": "number"
      },
      "rank": {
       "type": "number"
      },
      "report": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "id": {
           "type": "string"
          },
          "publishedAt": {
           "type": "string"
          },
          "revisedAt": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "title": {
           "type": "string"
          }
         },
         "required": [
          "id",
          "title",
          "publishedAt",
          "revisedAt"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "summary": {
       "type": "string"
      },
      "trend": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "rank",
      "name",
      "summary",
      "postCount",
      "authorCount",
      "lastSeenAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "snapshot": {
      "additionalProperties": false,
      "properties": {
       "completedAt": {
        "type": "string"
       },
       "latestEvidenceAt": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "windowStartedAt": {
        "type": "string"
       }
      },
      "required": [
       "completedAt",
       "latestEvidenceAt",
       "windowStartedAt"
      ],
      "type": "object"
     }
    },
    "required": [
     "snapshot"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "List trending topics"
}

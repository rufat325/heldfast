{
 "description": "Get item count, eviction count, and live config for a memory store.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "instanceId": {
    "description": "Optional instance ID override",
    "type": "string"
   },
   "memory_name": {
    "description": "The memory store name (from memory_stores)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "memory_name"
  ],
  "type": "object"
 },
 "name": "memory_stats"
}

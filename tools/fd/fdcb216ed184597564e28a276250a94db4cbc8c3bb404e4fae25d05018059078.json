    "_apiKey": "your-data-nola-api-key",
    "limit": 100,
    "resource_id": "4xwx-sfte",
    "where": "district = '6'"
   },
   {
    "_apiKey": "your-data-nola-api-key",
    "group": "zip_code",
    "limit": 20,
    "order": "count DESC",
    "resource_id": "8g4p-7q6v",
    "select": "zip_code, count(*) as count"
   }
  ],

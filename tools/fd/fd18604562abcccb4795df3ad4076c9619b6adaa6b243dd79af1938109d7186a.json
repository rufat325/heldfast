{
 "description": "Create demos/<name>/ with a starter brief + storyboard. dir is the repo to scaffold into (absolute path recommended; default: server cwd). With fromUrl the page is inspected first (no LLM): its headings become scenes and its unique selectors become the beats + a `_candidates` list \u2014 you then write the narration and turn the candidate hover into the real click.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dir": {
    "type": "string"
   },
   "force": {
    "type": "boolean"
   },
   "fromUrl": {
    "description": "draft the storyboard from this live page",
    "type": "string"
   },
   "headless": {
    "description": "fromUrl: run Chrome headless (default true)",
    "type": "boolean"
   },
   "name": {
    "description": "demo name (creates demos/<name>/)",
    "type": "string"
   },
   "profile": {
    "description": "fromUrl: Chrome user-data dir (logged-in pages)",
    "type": "string"
   },
   "viewport": {
    "additionalProperties": false,
    "description": "fromUrl: viewport (default 1280x720)",
    "properties": {
     "height": {
      "type": "number"
     },
     "width": {
      "type": "number"
     }
    },
    "required": [
     "width",
     "height"
    ],
    "type": "object"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "init_demo",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "briefPath": {
    "type": "string"
   },
   "demoDir": {
    "type": "string"
   },
   "storyboardPath": {
    "type": "string"
   }
  },
  "required": [
   "demoDir",
   "storyboardPath",
   "briefPath"
  ],
  "type": "object"
 },
 "title": "Scaffold a new demo"
}

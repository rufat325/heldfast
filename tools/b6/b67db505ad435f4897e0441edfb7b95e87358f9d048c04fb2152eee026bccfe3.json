{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Send a previously created draft. Enforces send allowlist before sending. Rate-limited. If a send fails with SEND_STATUS_UNKNOWN, the message may already have been delivered; do not resend without checking Sent Items.",
 "inputSchema": {
  "properties": {
   "draft_id": {
    "type": "string"
   },
   "mailbox": {
    "type": "string"
   },
   "scheduled_send_at": {
    "description": "Future ISO 8601 delivery time with an explicit timezone. Accepted values are normalized to UTC.",
    "format": "date-time",
    "type": "string"
   }
  },
  "required": [
   "draft_id"
  ],
  "type": "object"
 },
 "name": "send_draft",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "availableMailboxes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "code": {
      "type": "string"
     },
     "defaultMailbox": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "recoverable": {
      "type": "boolean"
     },
     "retryAfter": {
      "type": "number"
     }
    },
    "required": [
     "code",
     "message",
     "recoverable"
    ],
    "type": "object"
   },
   "messageId": {
    "type": "string"
   },
   "scheduledSendAt": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 }
}

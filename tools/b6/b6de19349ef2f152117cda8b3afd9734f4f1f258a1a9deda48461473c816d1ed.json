{
 "description": "List AnalyticsBundle generation records for a project, or across accessible projects when projectId is omitted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "cursor": {
    "type": "string"
   },
   "environment": {
    "type": "string"
   },
   "from": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "usage_summary",
     "route_health",
     "funnel_dropoff",
     "journey_friction",
     "feature_usage",
     "incident_impact",
     "deploy_comparison",
     "conversion_path"
    ],
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "projectId": {
    "type": "string"
   },
   "service": {
    "type": "string"
   },
   "status": {
    "enum": [
     "all",
     "pending",
     "running",
     "completed",
     "failed"
    ],
    "type": "string"
   },
   "to": {
    "type": "string"
   }
  },
  "required": [
   "bearerToken"
  ],
  "type": "object"
 },
 "name": "list_analytics_bundles"
}

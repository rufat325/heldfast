{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Set the health of a project"
 },
 "description": "Record whether a project is On track, At risk or Off track, with a one-line reason. This is a judgement humans read in the portfolio view \u2014 only set it when you have evidence (missed milestone, blocked work, scope change), and always include the note.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "client": {
    "type": "string"
   },
   "client_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "health": {
    "enum": [
     "on_track",
     "at_risk",
     "off_track"
    ],
    "type": "string"
   },
   "note": {
    "description": "Why \u2014 one line, specific.",
    "minLength": 1,
    "type": "string"
   },
   "project": {
    "description": "Name or @handle of the project. Fuzzy-resolved.",
    "type": "string"
   },
   "project_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "health",
   "note"
  ],
  "type": "object"
 },
 "name": "set_project_health",
 "title": "Set the health of a project"
}

{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Send Invitations"
 },
 "description": "Send invitations to a live event \u2014 app, email, or both \u2014 to people (recipient_uids), saved lists (distribution_list_ids), and/or manual contacts (external_contacts). Optionally attach a promo code, add a custom message, send as a linked community, or schedule. Counts against the weekly invite limit; sends real emails/push. Requires event_id; host only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "attach_promo_code": {
    "maxLength": 80,
    "type": "string"
   },
   "custom_message": {
    "maxLength": 2000,
    "type": "string"
   },
   "delivery_method": {
    "enum": [
     "app",
     "email",
     "both"
    ],
    "type": "string"
   },
   "distribution_list_ids": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "dry_run": {
    "type": "boolean"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "external_contacts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "format": "email",
       "maxLength": 320,
       "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
       "type": "string"
      },
      "name": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      },
      "phone": {
       "maxLength": 40,
       "type": "string"
      }
     },
     "required": [
      "name",
      "email"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   },
   "recipient_uids": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 5000,
    "type": "array"
   },
   "scheduled_start_at": {
    "maxLength": 40,
    "type": "string"
   },
   "send_as_community_id": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "event_id"
  ],
  "type": "object"
 },
 "name": "send_invitations",
 "title": "Send Invitations"
}

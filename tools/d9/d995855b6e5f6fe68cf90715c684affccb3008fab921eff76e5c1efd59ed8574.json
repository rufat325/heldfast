{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Set a key-value context entry. Stores structured data (JSON or string).",
 "inputSchema": {
  "properties": {
   "key": {
    "description": "Context key name",
    "type": "string"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   },
   "ttl": {
    "description": "Optional TTL in seconds",
    "type": "number"
   },
   "value": {
    "description": "Value to store (string, number, object, array)"
   }
  },
  "required": [
   "spaceId",
   "key",
   "value"
  ],
  "type": "object"
 },
 "name": "context_set",
 "outputSchema": {
  "properties": {
   "key": {
    "description": "The key that was set",
    "type": "string"
   },
   "value": {
    "description": "The stored value (string, number, object, or array)"
   }
  },
  "required": [
   "key"
  ],
  "type": "object"
 }
}

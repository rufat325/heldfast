 "inputSchema": {
  "examples": [
   {
    "resource_id": "12345678-abcd-ef01-2345-6789abcdef01"
   },
   {
    "limit": 50,
    "q": "Helsinki",
    "resource_id": "87654321-dcba-fe10-5432-1098fedcba87"
   }
  ],
  "properties": {
   "limit": {
    "description": "Max rows (default 100).",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset.",
    "type": "number"
   },
   "q": {
    "description": "Optional full-text filter over the rows.",
    "type": "string"
   },
   "resource_id": {
    "description": "A resource_id from dataset/search_datasets.",
    "type": "string"
   }
  },
  "required": [
   "resource_id"
  ],
  "type": "object"
 },

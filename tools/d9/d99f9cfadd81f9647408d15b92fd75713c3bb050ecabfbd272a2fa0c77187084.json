{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Download a sales/units report. Returns parsed TSV rows. Use a vendor number from App Store Connect > Payments and Financial Reports.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "frequency": {
    "description": "Report frequency (default DAILY)",
    "enum": [
     "DAILY",
     "WEEKLY",
     "MONTHLY",
     "YEARLY"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max rows to return inline (default 500). Total row count is always reported.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "reportDate": {
    "description": "Report date \u2014 DAILY: YYYY-MM-DD, WEEKLY: YYYY-MM-DD (Sunday), MONTHLY: YYYY-MM, YEARLY: YYYY",
    "type": "string"
   },
   "reportSubType": {
    "description": "Report sub-type (default SUMMARY)",
    "enum": [
     "SUMMARY",
     "DETAILED"
    ],
    "type": "string"
   },
   "reportType": {
    "description": "Report type (default SALES)",
    "enum": [
     "SALES",
     "PRE_ORDER",
     "NEWSSTAND",
     "SUBSCRIPTION",
     "SUBSCRIPTION_EVENT",
     "SUBSCRIPTION_OFFER_CODE_REDEMPTION",
     "SUBSCRIBER"
    ],
    "type": "string"
   },
   "vendorNumber": {
    "description": "Apple-issued vendor number (e.g. \"80012345\")",
    "type": "string"
   },
   "version": {
    "description": "Report version (default 1_0). Newer SALES reports use 1_1 with extra columns.",
    "type": "string"
   }
  },
  "required": [
   "vendorNumber",
   "reportDate"
  ],
  "type": "object"
 },
 "name": "download_sales_report"
}

{
 "description": "Create a Seedance task on RunAPI (text to video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspect_ratio": {
    "anyOf": [
     {
      "const": "1:1",
      "type": "string"
     },
     {
      "const": "4:3",
      "type": "string"
     },
     {
      "const": "3:4",
      "type": "string"
     },
     {
      "const": "16:9",
      "type": "string"
     },
     {
      "const": "9:16",
      "type": "string"
     },
     {
      "const": "21:9",
      "type": "string"
     },
     {
      "const": "auto",
      "type": "string"
     }
    ]
   },
   "callback_url": {
    "type": "string"
   },
   "duration_seconds": {
    "maximum": 12,
    "minimum": 4,
    "type": "number"
   },
   "enable_safety_checker": {
    "type": "boolean"
   },
   "first_frame_image_url": {
    "type": "string"
   },
   "generate_audio": {
    "type": "boolean"
   },
   "last_frame_image_url": {
    "type": "string"
   },
   "lock_camera": {
    "type": "boolean"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "seedance-1.5-pro",
     "seedance-2-mini",
     "seedance-2.0",
     "seedance-2.0-fast",
     "seedance-2.5",
     "seedance-v1-pro",
     "seedance-v1-pro-fast"
    ],
    "type": "string"
   },
   "output_format": {
    "anyOf": [
     {
      "const": "mp4",
      "type": "string"
     },
     {
      "const": "mov",
      "type": "string"
     }
    ],
    "description": "Output video container format."
   },
   "output_resolution": {
    "anyOf": [
     {
      "const": "480p",
      "type": "string"
     },
     {
      "const": "720p",
      "type": "string"
     },
     {
      "const": "1080p",
      "type": "string"
     },
     {
      "const": "4k",
      "type": "string"
     }
    ]
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "reference_audio_urls": {
    "items": {},
    "type": "array"
   },
   "reference_image_urls": {
    "items": {},
    "type": "array"
   },
   "reference_video_urls": {
    "items": {},
    "type": "array"
   },
   "return_last_frame": {
    "description": "Whether to return the generated video's last frame.",
    "type": "boolean"
   },
   "seed": {
    "maximum": 2147483647,
    "minimum": -1,
    "type": "number"
   },
   "source_image_urls": {
    "items": {},
    "type": "array"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   },
   "web_search": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "text_to_video"
}

{
 "description": "Like prove, plus issue a time-bound share token for a recipient agent id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fact_key": {
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "maxLength": 8000,
    "minLength": 1,
    "type": "string"
   },
   "recipient_agent_id": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "user_id": {
    "description": "Logical scope (same string you use when calling HTTPS). Omit for \"\".",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "fact_key",
   "query",
   "recipient_agent_id"
  ],
  "type": "object"
 },
 "name": "zkshare_share"
}

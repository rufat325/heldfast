{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Preliminary delivery cost estimate WITHOUT creating a claim \u2014 the pricing method for countries outside Russia. Returns price (a decimal STRING, not a number!), currency_rules {code, sign, template}, distance_meters, eta (minutes) and zone_id. Route points take [longitude, latitude] coordinates and/or a full address string. Typical errors: 400 address_not_found (address not recognized), 409 estimating.cant_construct_route (no route between the points), 409 estimating.requirement_unavailable.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "description": "Items / cargo places.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "dropoff_point": {
       "description": "Drop-off point id from route_points.",
       "type": "integer"
      },
      "pickup_point": {
       "description": "Pickup point id from route_points.",
       "type": "integer"
      },
      "quantity": {
       "description": "Number of item units.",
       "minimum": 1,
       "type": "integer"
      },
      "size": {
       "additionalProperties": false,
       "description": "Dimensions of one unit, in METERS.",
       "properties": {
        "height": {
         "description": "Height, meters.",
         "type": "number"
        },
        "length": {
         "description": "Length, meters.",
         "type": "number"
        },
        "width": {
         "description": "Width, meters.",
         "type": "number"
        }
       },
       "required": [
        "length",
        "width",
        "height"
       ],
       "type": "object"
      },
      "weight": {
       "description": "Weight of one unit, kg.",
       "type": "number"
      }
     },
     "required": [
      "quantity"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "requirements": {
    "additionalProperties": true,
    "description": "Delivery requirements (class, body type, extra options).",
    "properties": {
     "cargo_type": {
      "description": "Vehicle body type for cargo: van, lcv_m, lcv_l.",
      "enum": [
       "van",
       "lcv_m",
       "lcv_l"
      ],
      "type": "string"
     },
     "taxi_class": {
      "description": "Delivery class: courier, express or cargo.",
      "enum": [
       "courier",
       "express",
       "cargo"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "route_points": {
    "description": "Route points: coordinates and/or an address (at least one of the two per point).",
    "items": {
     "additionalProperties": true,
     "properties": {
      "coordinates": {
       "description": "Point coordinates as [longitude, latitude], e.g. [69.279737, 41.311151].",
       "items": {
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "fullname": {
       "description": "Full address as a string, e.g. \"Tashkent, Amir Timur Avenue, 107\".",
       "type": "string"
      },
      "id": {
       "description": "Point id (referenced by the items' pickup_point/dropoff_point).",
       "type": "integer"
      }
     },
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "skip_door_to_door": {
    "description": "true \u2014 disable door-to-door delivery (default false).",
    "type": "boolean"
   }
  },
  "required": [
   "route_points",
   "items"
  ],
  "type": "object"
 },
 "name": "check_price",
 "title": "Estimate delivery price"
}

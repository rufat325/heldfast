{
 "description": "Submit a review for a pending agent submission (requires API key)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accuracy_score": {
    "description": "Accuracy rating 1-5",
    "type": "number"
   },
   "approved": {
    "description": "Whether you approve this submission",
    "type": "boolean"
   },
   "comment": {
    "description": "Optional feedback or explanation",
    "type": "string"
   },
   "submission_id": {
    "description": "The unique identifier of the submission to review",
    "type": "string"
   },
   "usefulness_score": {
    "description": "Usefulness rating 1-5",
    "type": "number"
   }
  },
  "required": [
   "submission_id",
   "approved"
  ],
  "type": "object"
 },
 "name": "submit_review"
}

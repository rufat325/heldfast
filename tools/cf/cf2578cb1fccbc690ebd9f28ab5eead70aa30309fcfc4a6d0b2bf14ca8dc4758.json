{
 "description": "Query SensorMesh readings. Free preview window: up to 10 rows per call, filtered by device/site/sensor/anomaly/time range. Use sensor_list first to see what exists.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "anomaly": {
    "description": "Anomaly flag filter, e.g. spike, stuck, flatline, passby; empty string = normal rows",
    "type": "string"
   },
   "device": {
    "description": "Device ID, e.g. sm-004",
    "type": "string"
   },
   "format": {
    "description": "Response format (default json)",
    "enum": [
     "json",
     "csv"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Rows to return, 1-10 (default 10)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "sensor": {
    "description": "Sensor type",
    "enum": [
     "air_quality",
     "temperature",
     "noise"
    ],
    "type": "string"
   },
   "since": {
    "description": "ISO timestamp lower bound",
    "type": "string"
   },
   "site": {
    "description": "Site slug",
    "enum": [
     "metro-core",
     "riverside-park",
     "north-industrial"
    ],
    "type": "string"
   },
   "until": {
    "description": "ISO timestamp upper bound",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "sensor_query"
}

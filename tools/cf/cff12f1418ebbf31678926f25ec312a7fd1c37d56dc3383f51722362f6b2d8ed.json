{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record a review; caller submissions are agent_claim, never provider observations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "findings": {
    "items": {
     "properties": {
      "detail": {
       "type": "string"
      },
      "file": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "line": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "severity": {
       "enum": [
        "blocking",
        "major",
        "minor",
        "note"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "severity",
      "title",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "independence": {
    "properties": {
     "differentProvider": {
      "type": "boolean"
     },
     "differentSession": {
      "type": "boolean"
     },
     "freshContext": {
      "type": "boolean"
     },
     "writeAccess": {
      "type": "boolean"
     }
    },
    "required": [
     "differentSession",
     "differentProvider",
     "freshContext",
     "writeAccess"
    ],
    "type": "object"
   },
   "reviewerSessionId": {
    "type": "string"
   },
   "subjectEvidenceIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "verdict": {
    "enum": [
     "approve",
     "changes_requested",
     "blocked"
    ],
    "type": "string"
   },
   "workId": {
    "type": "string"
   }
  },
  "required": [
   "workId",
   "subjectEvidenceIds",
   "reviewerSessionId",
   "independence",
   "findings",
   "verdict"
  ],
  "type": "object"
 },
 "name": "review_create"
}

    "dataset": "EXR",
    "provider": "ECB",
    "series_code": "EUR.USD.SP00.A"
   },
   {
    "dataset": "PAYEMS",
    "observations": true,
    "provider": "BLS",
    "series_code": "PAYEMS"
   }
  ],
  "properties": {
   "dataset": {
    "description": "Dataset code",
    "type": "string"
   },
   "observations": {
    "description": "Include data points (default true)",
    "type": "boolean"
   },
   "provider": {
    "description": "Provider code",
    "type": "string"
   },
   "series_code": {
    "description": "Series code (dot-separated dimensions or named code)",
    "type": "string"
   }
  },
  "required": [

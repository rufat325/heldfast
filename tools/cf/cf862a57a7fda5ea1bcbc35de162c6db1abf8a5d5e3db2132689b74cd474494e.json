{
 "description": "Ranked full-text search. Supports `fuzzy`, `prefix`, and a `field` filter (title/tag/body, or 'path' to match the note name). Returns ranked snippets.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "field": {
    "description": "Restrict search to one field",
    "enum": [
     "title",
     "tag",
     "body",
     "path"
    ],
    "type": "string"
   },
   "fuzzy": {
    "description": "Enable fuzzy matching (typo-tolerant)",
    "type": "boolean"
   },
   "limit": {
    "description": "Max results (default 10)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "offset": {
    "description": "Start index (default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "prefix": {
    "description": "Match term prefixes (default true)",
    "type": "boolean"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_notes",
 "title": "Search notes"
}

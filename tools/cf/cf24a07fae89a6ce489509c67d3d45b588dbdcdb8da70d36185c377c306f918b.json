{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan Word Mute Ranges"
 },
 "description": "Plan mute or bleep ranges for listed words/phrases in a word timeline. Returns redacted, frame-snapped mute ranges, ready-to-apply audio keyframes and (for bleep) tone placements. Local-only; never changes Premiere.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "frame_rate": {
    "description": "Timebase used to snap ranges to whole frames; defaults to 30.",
    "maximum": 240,
    "minimum": 1,
    "type": "number"
   },
   "mode": {
    "description": "mute ducks the dialogue only; bleep also emits tone placements. Defaults to mute.",
    "enum": [
     "mute",
     "bleep"
    ],
    "type": "string"
   },
   "mute_level_db": {
    "description": "Level inside each range for add_audio_keyframes; defaults to -60.",
    "maximum": 0,
    "minimum": -96,
    "type": "number"
   },
   "padding_seconds": {
    "description": "Seconds added before and after each flagged word; defaults to 0.04.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "word_timeline": {
    "additionalProperties": false,
    "description": "Caller-supplied word-timed transcript for one Premiere source item. Words must be ordered by start time and bound to the transcript revision returned by get_clip_transcript_uxp. Different labeled speakers may overlap; same-speaker words may not, even when another speaker is between them.",
    "properties": {
     "source_project_item_id": {
      "description": "Exact Premiere source project-item ID.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "transcript_revision": {
      "description": "Revision returned by get_clip_transcript_uxp.",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "words": {
      "description": "Ordered word tokens with source-time boundaries.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "confidence": {
         "description": "Optional recognizer confidence.",
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "end_seconds": {
         "description": "Word end in source seconds.",
         "exclusiveMinimum": 0,
         "maximum": 86400,
         "type": "number"
        },
        "speaker_label": {
         "description": "Optional caller-normalized speaker label.",
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "start_seconds": {
         "description": "Word start in source seconds.",
         "maximum": 86400,
         "minimum": 0,
         "type": "number"
        },
        "text": {
         "description": "Word token, punctuation allowed.",
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "text",
        "start_seconds",
        "end_seconds"
       ],
       "type": "object"
      },
      "maxItems": 20000,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "source_project_item_id",
     "transcript_revision",
     "words"
    ],
    "type": "object"
   },
   "words": {
    "description": "Exact words or phrases to mute, matched as consecutive normalized tokens.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 256,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "word_timeline",
   "words"
  ],
  "type": "object"
 },
 "name": "plan_word_mute_ranges",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Plan Word Mute Ranges"
}

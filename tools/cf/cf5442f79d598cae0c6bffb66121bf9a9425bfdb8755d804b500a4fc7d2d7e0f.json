{
 "description": "\u63a2\u7d22\u7684\u30c6\u30b9\u30c8\uff08\u30a8\u30e9\u30fc\u63a8\u6e2c\u30fb\u30c1\u30a7\u30c3\u30af\u30ea\u30b9\u30c8\u30d9\u30fc\u30b9\u30c9\u30c6\u30b9\u30c8\u3092\u542b\u3080\u7d4c\u9a13\u30d9\u30fc\u30b9\u6280\u6cd5\uff09\u306e\u30c1\u30e3\u30fc\u30bf\u30fc\u8868\u3092\u3001\u6c7a\u5b9a\u7684\u5c64(\u30c1\u30e3\u30fc\u30bf\u30fcID\u306e\u91cd\u8907/\u6b20\u756a/\u30d7\u30ec\u30d5\u30a3\u30c3\u30af\u30b9\u4e0d\u4e00\u81f4\u30fb\u672a\u77e5\u306e\u89b3\u70b9\u533a\u5206ID\u30fb\u7531\u6765\u30e1\u30bf\u30c7\u30fc\u30bf\u306e\u672a\u89e3\u6c7a\u53c2\u7167\u30fb\u89b3\u70b9\u533a\u5206\u306e\u672a\u4f7f\u7528\u30fb\u9ad8\u512a\u5148\u5ea6\u30c6\u30b9\u30c8\u6761\u4ef6/\u30ea\u30b9\u30af\u306e\u672a\u30ab\u30d0\u30fc\u30fb\u6c7a\u5b9a\u7684\u6280\u6cd5\u3067\u5145\u8db3\u6e08\u307f\u306e\u6761\u4ef6ID\u306e\u9664\u5916\u30fb\u30bf\u30a4\u30e0\u30dc\u30c3\u30af\u30b9\u3068\u6642\u9593\u4e88\u7b97\u30fb\u30df\u30c3\u30b7\u30e7\u30f3\u6587\u306e\u4e3b\u89b3\u8a9e\u691c\u67fb)\u3068\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u6587\u306e\u8a00\u8a9e\u5316\u306e\u307f\u3092\u547c\u3073\u51fa\u3057\u5074LLM\u3078\u59d4\u306d\u308b\u610f\u5473\u7684\u5c64\u306e\u4e8c\u5c64\u69cb\u6210\u3067\u6271\u3046\u3002charters \u304c\u672a\u6307\u5b9a\u30fb\u7a7a\u306e\u5834\u5408\u306f\u89b3\u70b9\u533a\u5206\u30ab\u30bf\u30ed\u30b0\u3068\u5bfe\u8c61\u30c6\u30b9\u30c8\u6761\u4ef6\u30fb\u30ea\u30b9\u30af\u304b\u3089\u751f\u6210\u6307\u793a\u306e\u307f\u3092\u8fd4\u3059\u3002\u65e2\u5b58\u306e\u30c1\u30e3\u30fc\u30bf\u30fc\u8868\u3092 charters \u306b\u6e21\u305b\u3070\u3001\u65e2\u5b58\u6210\u679c\u7269\u306e\u30ec\u30d3\u30e5\u30fc\uff08\u89b3\u70b9\u533a\u5206\u88ab\u8986\u30fb\u7531\u6765\u53c2\u7167\u30fb\u30bf\u30a4\u30e0\u30dc\u30c3\u30af\u30b9\u30fb\u4e3b\u89b3\u8a9e\u306e\u691c\u67fb\uff09\u3068\u3057\u3066\u3082\u6a5f\u80fd\u3059\u308b\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "additionalSubjectiveTerms": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "areaIds": {
    "description": "Charter area ids (ECA-xx) to scope the catalog and unused-area check to",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "charters": {
    "description": "Charter table entries; omitted or empty triggers generation-instruction-only mode",
    "items": {
     "properties": {
      "areaId": {
       "description": "Charter area id from the catalog, e.g. ECA-01",
       "type": "string"
      },
      "assignee": {
       "type": "string"
      },
      "charterId": {
       "description": "Charter id, e.g. EXC-001",
       "type": "string"
      },
      "checkFocus": {
       "description": "Check focus points (what should hold true)",
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "defectRecords": {
       "items": {
        "properties": {
         "no": {
          "type": "string"
         },
         "severity": {
          "type": "string"
         },
         "summary": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "derivedFrom": {
       "description": "Test condition ids / risk ids this charter was derived from (required). Plain id string, or {kind, id} to disambiguate across requirement/risk/stakeholder/guideword namespaces",
       "items": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "properties": {
           "id": {
            "minLength": 1,
            "type": "string"
           },
           "kind": {
            "enum": [
             "requirement",
             "risk",
             "stakeholder",
             "guideword"
            ],
            "type": "string"
           }
          },
          "required": [
           "kind",
           "id"
          ],
          "type": "object"
         }
        ]
       },
       "minItems": 1,
       "type": "array"
      },
      "mission": {
       "description": "Mission statement for the exploratory session",
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "operationFocus": {
       "description": "Operation focus points (how to probe it)",
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "skillLevel": {
       "enum": [
        "\u719f\u7df4",
        "\u4e2d\u7d1a",
        "\u521d\u7d1a"
       ],
       "type": "string"
      },
      "timeboxMinutes": {
       "type": "number"
      }
     },
     "required": [
      "charterId",
      "areaId",
      "mission",
      "checkFocus",
      "operationFocus",
      "derivedFrom"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "completedTools": {
    "description": "Already executed tools; entries without evidence are treated as not executed",
    "items": {
     "properties": {
      "evidence": {
       "description": "Evidence of execution: an output file path (e.g. docs/test-cases.md) or an output heading line starting with '#'",
       "type": "string"
      },
      "outputExcerpt": {
       "description": "Excerpt of the declared tool's actual output text. Must contain that tool's own H1 heading line; otherwise the declaration is reported as evidence-unverified and still counted as not executed",
       "type": "string"
      },
      "toolName": {
       "description": "Name of an already executed tool in this workflow",
       "type": "string"
      }
     },
     "required": [
      "toolName",
      "evidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "deterministicallyCoveredConditionIds": {
    "description": "Test condition ids already covered by deterministic techniques (boundary value analysis, equivalence partitioning, etc.); excluded from the uncovered-high-priority-condition check",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "idPrefix": {
    "description": "Charter id prefix used for gap detection (default EXC-)",
    "type": "string"
   },
   "recordingMethod": {
    "description": "Where and how granularly findings are recorded",
    "type": "string"
   },
   "risks": {
    "description": "Risks to consider when designing exploratory charters",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "impact": {
       "type": "number"
      },
      "likelihood": {
       "type": "number"
      },
      "riskCategoryId": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sessionBudgetMinutes": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "stopConditionDeclaration": {
    "description": "Declared stop conditions; omitted uses the catalog's stopHeuristics as defaults",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "testConditions": {
    "description": "Test conditions to consider when designing exploratory charters",
    "items": {
     "properties": {
      "derivedFrom": {
       "description": "Requirement/risk/persona ids (required). Plain id string, or {kind, id} to disambiguate across requirement/risk/stakeholder/guideword namespaces",
       "items": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "properties": {
           "id": {
            "minLength": 1,
            "type": "string"
           },
           "kind": {
            "enum": [
             "requirement",
             "risk",
             "stakeholder",
             "guideword"
            ],
            "type": "string"
           }
          },
          "required": [
           "kind",
           "id"
          ],
          "type": "object"
         }
        ]
       },
       "minItems": 1,
       "type": "array"
      },
      "id": {
       "description": "Test condition id, e.g. TC-001",
       "type": "string"
      },
      "perspectiveCategoryId": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "\u9ad8",
        "\u4e2d",
        "\u4f4e"
       ],
       "type": "string"
      },
      "statement": {
       "description": "The test condition statement",
       "type": "string"
      },
      "target": {
       "description": "Target of the condition",
       "type": "string"
      }
     },
     "required": [
      "id",
      "target",
      "statement",
      "derivedFrom"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "testConditions"
  ],
  "type": "object"
 },
 "name": "generate_exploratory_charters",
 "title": "Generate Exploratory Charters"
}

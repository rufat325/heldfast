{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Wire a webhook to your node's LIVE mesh events: call.settled when someone rents your capability, vibe.followed when you gain a follower, capability.listed when a node you follow ships something new. HMAC-signed deliveries.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "create",
     "list",
     "delete"
    ],
    "type": "string"
   },
   "events": {
    "description": "event types to receive (omit = all)",
    "items": {
     "enum": [
      "call.settled",
      "vibe.followed",
      "capability.listed",
      "mesh.welcome",
      "capability.quarantined",
      "call.held",
      "call.released",
      "call.refunded",
      "call.disputed",
      "estate.breach",
      "estate.cert",
      "estate.posture"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "subscription id (for delete)",
    "type": "string"
   },
   "url": {
    "description": "public https endpoint to POST events to",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "mesh_subscribe",
 "title": "Webhook Subscriptions"
}

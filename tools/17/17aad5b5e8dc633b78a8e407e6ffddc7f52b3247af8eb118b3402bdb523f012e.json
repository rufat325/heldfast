{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Confirm a media upload"
 },
 "description": "Record a file that finished uploading. Its size and type are read back from storage rather than taken on trust. Safe to call again if the first response was lost.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "What the file shows, if you already know. Kept as the file is recorded; use media_update to change it later. Confirming again never overwrites one already written.",
    "type": "string"
   },
   "id": {
    "description": "The id media_upload returned.",
    "type": "string"
   },
   "kind": {
    "enum": [
     "image",
     "video",
     "audio"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "kind"
  ],
  "type": "object"
 },
 "name": "media_confirm",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "media": {
    "additionalProperties": false,
    "properties": {
     "byteSize": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "description": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "durationMs": {
      "anyOf": [
       {
        "maximum": 2147483647,
        "minimum": -2147483648,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "height": {
      "anyOf": [
       {
        "maximum": 2147483647,
        "minimum": -2147483648,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "mimeType": {
      "type": "string"
     },
     "organizationId": {
      "type": "string"
     },
     "width": {
      "anyOf": [
       {
        "maximum": 2147483647,
        "minimum": -2147483648,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "kind",
     "description",
     "mimeType",
     "byteSize",
     "width",
     "height",
     "durationMs",
     "organizationId",
     "createdAt"
    ],
    "type": "object"
   }
  },
  "required": [
   "media"
  ],
  "type": "object"
 },
 "title": "Confirm a media upload"
}

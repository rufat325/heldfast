{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search a domain for emails"
 },
 "description": "Search Hunter v2 emails for one domain/company with current people, verification, location, job-title, decision-maker, aggregation, and offset filters.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aggregations": {
    "type": "boolean"
   },
   "company": {
    "type": "string"
   },
   "decision_maker": {
    "type": "boolean"
   },
   "department": {
    "items": {
     "enum": [
      "executive",
      "it",
      "finance",
      "management",
      "sales",
      "legal",
      "support",
      "hr",
      "marketing",
      "communication",
      "education",
      "design",
      "health",
      "operations",
      "product",
      "research",
      "consulting",
      "administrative",
      "procurement"
     ],
     "type": "string"
    },
    "maxItems": 19,
    "type": "array"
   },
   "domain": {
    "type": "string"
   },
   "job_titles": {
    "items": {
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "additionalProperties": false,
    "properties": {
     "exclude": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "business_region": {
         "enum": [
          "AMER",
          "EMEA",
          "APAC",
          "LATAM"
         ],
         "type": "string"
        },
        "city": {
         "type": "string"
        },
        "continent": {
         "enum": [
          "Africa",
          "Antarctica",
          "Asia",
          "Europe",
          "North America",
          "Oceania",
          "South America"
         ],
         "type": "string"
        },
        "country": {
         "maxLength": 2,
         "minLength": 2,
         "type": "string"
        },
        "state": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "include": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "business_region": {
         "enum": [
          "AMER",
          "EMEA",
          "APAC",
          "LATAM"
         ],
         "type": "string"
        },
        "city": {
         "type": "string"
        },
        "continent": {
         "enum": [
          "Africa",
          "Antarctica",
          "Asia",
          "Europe",
          "North America",
          "Oceania",
          "South America"
         ],
         "type": "string"
        },
        "country": {
         "maxLength": 2,
         "minLength": 2,
         "type": "string"
        },
        "state": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     }
    },
    "type": "object"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "required_field": {
    "items": {
     "enum": [
      "full_name",
      "position",
      "phone_number"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "seniority": {
    "items": {
     "enum": [
      "junior",
      "senior",
      "executive"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "type": {
    "enum": [
     "personal",
     "generic"
    ],
    "type": "string"
   },
   "verification_status": {
    "items": {
     "enum": [
      "valid",
      "accept_all",
      "unknown"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "domain_search"
}

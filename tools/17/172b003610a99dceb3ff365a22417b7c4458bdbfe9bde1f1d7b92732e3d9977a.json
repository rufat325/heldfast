{
 "description": "Search products in Mercado Libre marketplace",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category ID filter",
    "type": "string"
   },
   "limit": {
    "description": "Results limit (max 50)",
    "type": "number"
   },
   "maxPrice": {
    "description": "Maximum price",
    "type": "number"
   },
   "minPrice": {
    "description": "Minimum price",
    "type": "number"
   },
   "offset": {
    "description": "Results offset",
    "type": "number"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "relevance",
     "price_asc",
     "price_desc"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_products"
}

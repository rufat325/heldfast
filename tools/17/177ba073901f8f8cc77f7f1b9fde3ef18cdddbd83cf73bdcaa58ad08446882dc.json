 },
 "description": "Search the NuGet .NET package registry by free text. Returns package id, description, authors, total downloads, and latest version for up to 1000 matches; optionally includes prerelease packages.",
 "inputSchema": {
  "examples": [
   {
    "query": "json serialization"
   },
   {
    "prerelease": true,
    "query": "logging framework",
    "take": 50
   }
  ],
  "properties": {
   "prerelease": {
    "description": "Include prerelease packages (default false)",
    "type": "boolean"
   },
   "query": {
    "description": "Free-text query",
    "type": "string"
   },
   "skip": {
    "description": "0-based offset",
    "type": "number"
   },
   "take": {
    "description": "Max results, 1-1000 (default 20)",
    "type": "number"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",

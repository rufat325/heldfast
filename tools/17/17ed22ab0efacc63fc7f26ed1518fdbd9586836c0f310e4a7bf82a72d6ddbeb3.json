{
 "description": "Update a single locale's version metadata (What's New, description, keywords, promotional text, URLs)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "App description",
    "type": "string"
   },
   "keywords": {
    "description": "Keywords (comma-separated, max 100 chars)",
    "type": "string"
   },
   "locale": {
    "description": "Locale code (en-US, tr, de-DE, es-MX, fr-FR, ru, ar-SA)",
    "enum": [
     "en-US",
     "tr",
     "de-DE",
     "es-MX",
     "fr-FR",
     "ru",
     "ar-SA"
    ],
    "type": "string"
   },
   "marketingUrl": {
    "description": "Marketing URL",
    "type": "string"
   },
   "promotionalText": {
    "description": "Promotional text",
    "type": "string"
   },
   "supportUrl": {
    "description": "Support URL",
    "type": "string"
   },
   "versionId": {
    "description": "Version ID",
    "type": "string"
   },
   "whatsNew": {
    "description": "What's New text",
    "type": "string"
   }
  },
  "required": [
   "versionId",
   "locale"
  ],
  "type": "object"
 },
 "name": "asc_update_version_localization"
}

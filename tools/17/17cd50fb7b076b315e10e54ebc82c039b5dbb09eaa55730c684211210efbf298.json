{
 "description": "Delete a BrewPage resource (HTML page, KV store, JSON collection, or file) using the owner token.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Resource ID",
    "type": "string"
   },
   "namespace": {
    "description": "Resource namespace",
    "type": "string"
   },
   "ownerToken": {
    "description": "Owner token received when the resource was created",
    "type": "string"
   },
   "type": {
    "description": "Resource type to delete",
    "enum": [
     "html",
     "kv",
     "json",
     "file"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "namespace",
   "id",
   "ownerToken"
  ],
  "type": "object"
 },
 "name": "delete_resource"
}

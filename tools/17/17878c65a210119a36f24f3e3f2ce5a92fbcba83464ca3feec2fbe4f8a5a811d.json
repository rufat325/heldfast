{
 "description": "\u30c6\u30b9\u30c8\u76ee\u7684\u3092\u300c\u4f9d\u983c\u8005\u306e\u671f\u5f85 \u2192 \u30c6\u30b9\u30c8\u8981\u6c42\uff08\u30de\u30cd\u30b8\u30e1\u30f3\u30c8\u7684\uff0f\u30a8\u30f3\u30b8\u30cb\u30a2\u30ea\u30f3\u30b0\u7684\u306e2\u7cfb\u7d71\uff09 \u2192 \u30c6\u30b9\u30c8\u6226\u7565 \u2192 \u30c6\u30b9\u30c8\u76ee\u7684 \u2192 \u512a\u5148\u9806\u4f4d\u300d\u3068\u3044\u3046\u5c0e\u51fa\u30c1\u30a7\u30fc\u30f3\u3067\u6574\u7406\u3055\u305b\u3001\u76ee\u7684ID\uff08\u65e2\u5b9a TP-\uff09\u304c\u4e0b\u6d41\u306e \u30c6\u30b9\u30c8\u6761\u4ef6\uff08extract_test_conditions\uff09\u30fb\u30c6\u30b9\u30c8\u30bf\u30a4\u30d7\u9078\u629e\uff08create_test_plan \u306e5.2\uff09\u3078\u8cab\u901a\u3057\u3066\u3044\u308b\u304b\u3092 \u53cc\u65b9\u5411\u306b\u691c\u67fb\u3059\u308b\u3002\u3069\u306e\u30c6\u30b9\u30c8\u76ee\u7684\u306b\u3082\u7d10\u3065\u304b\u306a\u3044\u30c6\u30b9\u30c8\u6761\u4ef6\u3068\u3001\u3069\u306e\u30c6\u30b9\u30c8\u6761\u4ef6\u304b\u3089\u3082\u53c2\u7167\u3055\u308c\u306a\u3044\u30c6\u30b9\u30c8 \u76ee\u7684\u306e\u4e21\u65b9\u3092\u691c\u51fa\u3057\u3001\u4f9d\u983c\u66f8\u672c\u6587\u3068\u306e\u88cf\u4ed8\u3051\u7167\u5408\uff08PDC-15\uff09\u30fb\u5ba3\u8a00\u88ab\u8986\u7387\u30fb\u8a18\u5165\u7387\u3068\u5b9f\u6e2c\u5024\u306e\u7a81\u304d\u5408\u308f\u305b\uff08PDC-16\u3001\u76ee\u7684\u306e\u88ab\u8986\u7387\u306f\u69cb\u9020\u4e0a\u306e\u7d10\u3065\u3051\u7387\u3001\u30bf\u30a4\u30d7\u5074\u306f\u9078\u5b9a\u7406\u7531\u306e\u8a18\u5165\u7387\u3067\u3042\u308a\u5b9a\u578b\u8a9e\u3084\u6975\u7aef\u306a\u77ed\u6587\u306f\u5206\u5b50\u306b\u6570\u3048\u306a\u3044\uff09\u3082 \u884c\u3046\u3002\u54c1\u8cea\u7279\u6027ID\uff08PDC-14\uff09\u306f\u88fd\u54c1\u54c1\u8cea\u30e2\u30c7\u30eb\uff08QC-*\uff09\u30fb\u5229\u7528\u6642\u54c1\u8cea\u30e2\u30c7\u30eb\uff08QU-*\uff09\u306e\u4e21\u65b9\u3092\u65e2\u77e5ID\u3068\u3057\u3066\u691c\u67fb\u3059\u308b\u3002 \u65e2\u5b58\u306e\u30c6\u30b9\u30c8\u76ee\u7684\u4e00\u89a7\u3092 purposes \u306b\u6e21\u305b\u3070\u3001\u65e2\u5b58\u6210\u679c\u7269\u306e\u30ec\u30d3\u30e5\u30fc\u3068\u3057\u3066\u3082\u540c\u3058\u6c7a\u5b9a\u7684\u691c\u67fb\u3092\u5b9f\u884c\u3067\u304d\u308b\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "claimedPurposeCoveragePercent": {
    "description": "Claimed percentage of test conditions linked to at least one purpose id (structural link rate)",
    "type": "number"
   },
   "claimedTestTypeJustificationPercent": {
    "description": "Claimed percentage of selected test types that have a purpose id and a substantively filled reason (fill rate, not a validity rate)",
    "type": "number"
   },
   "completedTools": {
    "description": "Already executed tools; entries without evidence are treated as not executed",
    "items": {
     "properties": {
      "evidence": {
       "description": "Evidence of execution: an output file path (e.g. docs/test-cases.md) or an output heading line starting with '#'",
       "type": "string"
      },
      "outputExcerpt": {
       "description": "Excerpt of the declared tool's actual output text. Must contain that tool's own H1 heading line; otherwise the declaration is reported as evidence-unverified and still counted as not executed",
       "type": "string"
      },
      "toolName": {
       "description": "Name of an already executed tool in this workflow",
       "type": "string"
      }
     },
     "required": [
      "toolName",
      "evidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "expectations": {
    "description": "Requester expectations (stage 1 of the derivation chain)",
    "items": {
     "properties": {
      "id": {
       "description": "Expectation id, default prefix EXP-",
       "type": "string"
      },
      "requesterRole": {
       "description": "Role of the requester who holds this expectation",
       "type": "string"
      },
      "sourceRef": {
       "description": "Source location in requestDocuments backing this expectation",
       "properties": {
        "document": {
         "type": "string"
        },
        "endLine": {
         "maximum": 9007199254740991,
         "minimum": 1,
         "type": "integer"
        },
        "heading": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "startLine": {
         "maximum": 9007199254740991,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "document",
        "startLine"
       ],
       "type": "object"
      },
      "statement": {
       "description": "The requester's expectation statement",
       "type": "string"
      }
     },
     "required": [
      "id",
      "statement"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "idPrefixes": {
    "properties": {
     "expectation": {
      "type": "string"
     },
     "purpose": {
      "type": "string"
     },
     "strategy": {
      "type": "string"
     },
     "testRequirement": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "projectName": {
    "description": "Name of the project or system under test",
    "type": "string"
   },
   "purposes": {
    "description": "Test purposes (stage 4)",
    "items": {
     "properties": {
      "id": {
       "description": "Test purpose id, default prefix TP-",
       "type": "string"
      },
      "priorityRank": {
       "description": "1 is highest priority",
       "maximum": 9007199254740991,
       "minimum": 1,
       "type": "integer"
      },
      "priorityRationale": {
       "type": "string"
      },
      "relatedQualityCharacteristicIds": {
       "description": "QC-xx / QC-xx-xx ids from quality://characteristics/product, or QU-xx / QU-xx-xx ids from quality://characteristics/in-use",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "statement": {
       "description": "The test purpose statement",
       "type": "string"
      },
      "strategyIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "successCriterion": {
       "description": "Objective criterion to judge achievement",
       "type": "string"
      },
      "testRequirementIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "statement"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "requestDocuments": {
    "description": "Request documents (e.g. system test request letter) used to ground expectations (PDC-15)",
    "items": {
     "properties": {
      "content": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "strategyStatements": {
    "description": "Test strategy statements (stage 3); not required to be referenced downstream",
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "statement": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "statement"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testConditions": {
    "description": "Test conditions to cross-check against purposes (typically from extract_test_conditions)",
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "perspectiveCategoryId": {
       "type": "string"
      },
      "purposeIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "qualityCharacteristicIds": {
       "description": "QC-xx / QC-xx-xx ids from quality://characteristics/product, or QU-xx / QU-xx-xx ids from quality://characteristics/in-use",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "statement": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testRequirements": {
    "description": "Test requirements split into management / engineering lines (stage 2)",
    "items": {
     "properties": {
      "expectationIds": {
       "description": "Expectation ids this requirement was derived from",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "description": "Test requirement id, default prefix TR-",
       "type": "string"
      },
      "line": {
       "description": "Requirement line",
       "enum": [
        "management",
        "engineering"
       ],
       "type": "string"
      },
      "rationale": {
       "type": "string"
      },
      "statement": {
       "description": "The test requirement statement",
       "type": "string"
      }
     },
     "required": [
      "id",
      "line",
      "statement"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testTypeSelections": {
    "description": "Test type selection/exclusion decisions with the backing purpose ids and reason",
    "items": {
     "properties": {
      "name": {
       "description": "Test type name matching testTypeCatalog",
       "type": "string"
      },
      "purposeIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "reason": {
       "type": "string"
      },
      "selected": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "selected"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "expectations",
   "testRequirements",
   "purposes"
  ],
  "type": "object"
 },
 "name": "derive_test_purposes",
 "title": "Derive Test Purposes"
}

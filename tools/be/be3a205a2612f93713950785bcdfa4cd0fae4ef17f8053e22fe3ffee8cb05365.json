{
 "description": "Preview or write non-secret MCP-local Agent defaults. Per-project overrides remain in project_rules.yaml. Defaults to dry-run and returns a redacted readback.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "preferences": {
    "additionalProperties": false,
    "properties": {
     "audience": {
      "enum": [
       "beginner",
       "professional"
      ],
      "type": "string"
     },
     "executionMode": {
      "enum": [
       "interactive",
       "unattended"
      ],
      "type": "string"
     },
     "explanation": {
      "enum": [
       "detailed",
       "concise"
      ],
      "type": "string"
     },
     "git": {
      "additionalProperties": false,
      "properties": {
       "checkpoint": {
        "additionalProperties": false,
        "properties": {
         "enabled": {
          "type": "boolean"
         }
        },
        "type": "object"
       },
       "missingNotice": {
        "enum": [
         "once",
         "always",
         "never"
        ],
        "type": "string"
       },
       "workflow": {
        "enum": [
         "ask",
         "current_branch",
         "develop",
         "git_flow"
        ],
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "preferences"
  ],
  "type": "object"
 },
 "name": "granoflow_agent_preferences_write_defaults"
}

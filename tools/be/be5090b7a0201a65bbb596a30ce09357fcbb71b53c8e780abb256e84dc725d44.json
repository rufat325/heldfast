    "items": {
     "properties": {
      "content": {
       "description": "Note content fields",
       "type": "object"
      },
      "forum": {
       "description": "Forum (paper) id",
       "type": "string"
      },
      "id": {
       "description": "Note identifier",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },

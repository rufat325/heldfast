 "description": "Full-text search across OpenReview notes (papers, reviews, decisions) by query string; optionally restrict to a content field (e.g. title, abstract) or filter by author signature; returns matching note ids, titles, and venues.",
 "inputSchema": {
  "examples": [
   {
    "query": "transformer attention mechanism"
   },
   {
    "limit": 10,
    "query": "diffusion",
    "venue_id": "ICLR.cc/2024/Conference"
   },
   {
    "content_field": "abstract",
    "limit": 50,
    "query": "neural scaling laws"
   }
  ],
  "properties": {
   "content_field": {
    "description": "Restrict to a content field (e.g. \"title\", \"abstract\")",
    "type": "string"
   },
   "limit": {
    "description": "1-1000 (default 25)",
    "type": "number"
   },
   "offset": {
    "description": "0-based offset",
    "type": "number"
   },
   "query": {
    "description": "Free-text query",
    "type": "string"
   },
   "signature": {
    "description": "Filter by signature group (e.g. author profile id)",
    "type": "string"
   },
   "venue_id": {
    "description": "Restrict to one venue group id, e.g. \"ICLR.cc/2024/Conference\" (use list_venues to find it).",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_notes",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Total number of matching notes",
    "type": "number"
   },
   "notes": {

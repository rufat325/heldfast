   },
   "resource_id": {
    "description": "CKAN datastore resource id (UUID), e.g. \"6d0229af-bc54-46de-9c2b-26759b01dd05\".",
    "type": "string"
   },
   "sort": {
    "description": "Sort clause, e.g. \"APPLICATION_DATE desc\".",

    "limit": 100,
    "resource_id": "6d0229af-bc54-46de-9c2b-26759b01dd05"
   },
   {
    "filters": {
     "PERMIT_TYPE": "New Building"
    },
    "limit": 50,
    "resource_id": "6d0229af-bc54-46de-9c2b-26759b01dd05",
    "sort": "APPLICATION_DATE desc"
   }
  ],
  "properties": {

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List flow sessions"
 },
 "description": "List flow sessions. One session per person per run of a flow. Attribution carries post_id, comment_id and matched_keyword only, never what anyone typed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel": {
    "description": "Session channel.",
    "enum": [
     "facebook",
     "instagram",
     "whatsapp"
    ],
    "type": "string"
   },
   "contact_id": {
    "description": "Sessions for one contact. Unknown contact is a 404.",
    "type": "integer"
   },
   "flow_id": {
    "description": "One flow.",
    "type": "integer"
   },
   "limit": {
    "default": 25,
    "description": "Page size, 1 to 100. Default 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "starting_after": {
    "description": "The next_cursor from the previous page.",
    "type": "string"
   },
   "status": {
    "description": "Session status.",
    "enum": [
     "waiting_input",
     "delayed",
     "completed",
     "expired",
     "cancelled"
    ],
    "type": "string"
   },
   "updated_since": {
    "description": "ISO-8601 UTC.",
    "format": "date-time",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_flow_sessions"
}

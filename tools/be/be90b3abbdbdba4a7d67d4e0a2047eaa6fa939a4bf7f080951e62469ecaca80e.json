{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Returns Go environment variables as structured JSON. Optionally request specific variables.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "changed": {
    "default": false,
    "description": "Show only variables whose effective value differs from the default (-changed)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "vars": {
    "description": "Specific environment variables to query (e.g., ['GOROOT', 'GOPATH'])",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "env",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "cgoEnabled": {
    "type": "boolean"
   },
   "goarch": {
    "type": "string"
   },
   "goos": {
    "type": "string"
   },
   "gopath": {
    "type": "string"
   },
   "goroot": {
    "type": "string"
   },
   "goversion": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   },
   "vars": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "success",
   "goroot",
   "gopath",
   "goversion",
   "goos",
   "goarch"
  ],
  "type": "object"
 },
 "title": "Go Env"
}

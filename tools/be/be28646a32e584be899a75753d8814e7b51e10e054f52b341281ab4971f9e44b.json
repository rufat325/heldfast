{
 "description": "List files in an app's data container. Shows Documents, Library, Preferences, Caches, tmp, etc. Use to find databases, plists, caches.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundleId": {
    "description": "App bundle identifier",
    "type": "string"
   },
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "subPath": {
    "description": "Subdirectory to list (e.g., \"Documents\", \"Library/Preferences\")",
    "type": "string"
   }
  },
  "required": [
   "bundleId"
  ],
  "type": "object"
 },
 "name": "simulator_list_app_files"
}

 "description": "Search Austrian municipal law (Gemeinderecht).\n\nUse this tool to find municipal regulations and local ordinances.\n\nApplications:\n  - Gr: Municipal law (Gemeinderecht) - default\n  - GrA: Cross-border municipal law (Gemeinderecht Authentisch/Amtsbl\u00e4tter)\n\nExample queries:\n  - gemeinde=\"Graz\", suchworte=\"Parkgebuehren\"\n  - bundesland=\"Tirol\", titel=\"Gebuehrenordnung\"\n  - applikation=\"Gr\", index=\"Baurecht\"\n  - applikation=\"GrA\", bezirk=\"Bregenz\"",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "applikation": {
    "default": "Gr",
    "description": "\"Gr\" (municipal law, default) or \"GrA\" (cross-border/Amtsbl\u00e4tter)",
    "enum": [
     "Gr",
     "GrA"
    ],
    "type": "string"
   },
   "bezirk": {
    "description": "District name (GrA only, e.g., \"Bregenz\")",
    "maxLength": 200,
    "type": "string"
   },
   "bundesland": {
    "description": "Filter by state - Burgenland, K\u00e4rnten, Nieder\u00f6sterreich, Ober\u00f6sterreich, Salzburg, Steiermark, Tirol, Vorarlberg, Wien",
    "maxLength": 200,
    "type": "string"
   },
   "fassung_vom": {
    "description": "Historical version date (YYYY-MM-DD, Gr only)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "gemeinde": {
    "description": "Municipality name (e.g., \"Graz\")",
    "maxLength": 200,
    "type": "string"
   },
   "gemeindeverband": {
    "description": "Municipal association name (GrA only)",
    "maxLength": 200,
    "type": "string"
   },
   "geschaeftszahl": {
    "description": "File number/Aktenzeichen (Gr only)",
    "maxLength": 200,
    "type": "string"
   },
   "im_ris_seit": {
    "description": "Filter by time in RIS - EinerWoche, ZweiWochen, EinemMonat, DreiMonaten, SechsMonaten, EinemJahr",
    "enum": [
     "EinerWoche",
     "ZweiWochen",
     "EinemMonat",
     "DreiMonaten",
     "SechsMonaten",
     "EinemJahr"
    ],
    "type": "string"
   },
   "index": {
    "description": "Subject area index (Gr only) - VertretungskoerperUndAllgemeineVerwaltung, OeffentlicheOrdnungUndSicherheit, UnterrichtErziehungSportUndWissenschaft, KunstKulturUndKultus, SozialeWohlfahrtUndWohnbaufoerderung, Gesundheit, Stra\u00dfenUndWasserbauVerkehr, Wirtschaftsfoerderung, Dienstleistungen, Finanzwirtschaft",
    "enum": [
     "Undefined",
     "VertretungskoerperUndAllgemeineVerwaltung",
     "OeffentlicheOrdnungUndSicherheit",
     "UnterrichtErziehungSportUndWissenschaft",
     "KunstKulturUndKultus",
     "SozialeWohlfahrtUndWohnbaufoerderung",
     "Gesundheit",
     "Stra\u00dfenUndWasserbauVerkehr",
     "Wirtschaftsfoerderung",
     "Dienstleistungen",
     "Finanzwirtschaft"
    ],
    "type": "string"
   },
   "kundmachungsdatum_bis": {
    "description": "Announcement date to (YYYY-MM-DD, GrA only)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "kundmachungsdatum_von": {
    "description": "Announcement date from (YYYY-MM-DD, GrA only)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "kundmachungsnummer": {
    "description": "Announcement number (GrA only)",
    "maxLength": 100,
    "type": "string"
   },
   "limit": {
    "anyOf": [
     {
      "const": 10,
      "type": "number"
     },
     {
      "const": 20,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     },
     {
      "const": 100,
      "type": "number"
     }
    ],
    "default": 20,
    "description": "Results per page: 10, 20, 50 or 100 (default: 20). Every hit costs about 1k characters of structured payload, so prefer 20 for browsing and 50 for a broad survey; a page that would exceed the payload budget is delivered at the next smaller page size and says so (page_size, query.limit and notice)."
   },
   "response_format": {
    "default": "markdown",
    "description": "\"markdown\" (default) or \"json\"",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "seite": {
    "default": 1,
    "description": "Page number (default: 1)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "sortierung_richtung": {
    "description": "Sort direction",
    "enum": [
     "Ascending",
     "Descending"
    ],
    "type": "string"
   },
   "sortierung_spalte_gr": {
    "description": "Sort column (Gr only)",
    "enum": [
     "Geschaeftszahl",
     "Bundesland",
     "Gemeinde"
    ],
    "type": "string"
   },
   "suchworte": {
    "description": "Full-text search terms",
    "maxLength": 1000,
    "type": "string"
   },
   "titel": {
    "description": "Search in titles",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },

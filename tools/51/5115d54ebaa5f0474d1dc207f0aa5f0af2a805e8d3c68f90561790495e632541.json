{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List image- and video-capable model slugs available on the configured endpoint, with pricing where known. Use this to pick a `model` value for generate_image, edit_image, or generate_video.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "refresh": {
    "default": false,
    "description": "Bypass the 1h cache and re-query the endpoint.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_models",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "models": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "pricing": {
       "type": "string"
      },
      "recommended": {
       "type": "boolean"
      },
      "type": {
       "enum": [
        "image",
        "video"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "source": {
    "description": "'live' = queried from the endpoint, 'curated' = built-in fallback",
    "enum": [
     "live",
     "curated"
    ],
    "type": "string"
   }
  },
  "required": [
   "source",
   "models"
  ],
  "type": "object"
 },
 "title": "List Media Models"
}

{
 "description": "Create a new contact (person) without a matter. To create a lead with a case, use create-matter.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "email": {
    "type": "string"
   },
   "first_name": {
    "type": "string"
   },
   "last_name": {
    "type": "string"
   },
   "notes": {
    "description": "Notes to create with the contact.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "description": "Note body text.",
       "type": "string"
      },
      "name": {
       "description": "Note title.",
       "type": "string"
      }
     },
     "required": [
      "name",
      "body"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "phone": {
    "type": "string"
   }
  },
  "required": [
   "first_name",
   "last_name"
  ],
  "type": "object"
 },
 "name": "create-contact"
}

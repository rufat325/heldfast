{
 "description": "Stamp a text watermark across every page of a local PDF.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fontSize": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "input": {
    "type": "string"
   },
   "opacity": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "output": {
    "type": "string"
   },
   "position": {
    "enum": [
     "center",
     "top-left",
     "top-right",
     "bottom-left",
     "bottom-right",
     "diagonal"
    ],
    "type": "string"
   },
   "text": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "input",
   "output",
   "text"
  ],
  "type": "object"
 },
 "name": "pdf_watermark",
 "title": "Watermark a PDF (local, private)"
}

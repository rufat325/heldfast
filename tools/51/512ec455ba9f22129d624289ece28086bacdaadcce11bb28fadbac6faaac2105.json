  "additionalProperties": false,
  "properties": {
   "comments": {
    "maxLength": 2000,
    "type": "string"
   },
   "cost": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "item": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "paid": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "project_id": {
    "maxLength": 128,
    "type": "string"
   },
   "status": {
    "enum": [
     "owed",
     "partially_paid",
     "complete"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "software",
     "purchase",
     "rental",
     "labor",
     "service",
     "debt"
    ],
    "type": "string"
   },
   "vendor_id": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "item",
   "cost"
  ],
  "type": "object"
 },
 "name": "record_expense",
 "title": "Record Expense"
}

  "title": "Record Expense"
 },
 "description": "Record an expense (receipt) against a live event's budget \u2014 item, cost ($), amount paid, status, type, optional linked vendor/project. Editable via update_production_item (entity 'receipts'). Requires event_id + item + cost; you must be a host.",
 "inputSchema": {

{
 "description": "Report a redacted ATS mechanics or scenario-coverage observation. Never include answer values, addresses, contact data, OTPs, or free-form page content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batchId": {
    "minimum": 1,
    "type": "integer"
   },
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "fieldLabel": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "inspectionEpoch": {
    "minimum": 0,
    "type": "integer"
   },
   "leaseToken": {
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "memberId": {
    "minimum": 1,
    "type": "integer"
   },
   "metadata": {
    "additionalProperties": false,
    "properties": {
     "browserBindingHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "browserSurface": {
      "enum": [
       "codex_in_app",
       "chrome_extension",
       "claude_in_chrome"
      ],
      "type": "string"
     },
     "committed": {
      "type": "boolean"
     },
     "controlType": {
      "pattern": "^[a-z0-9][a-z0-9_:-]{0,99}$",
      "type": "string"
     },
     "errorCode": {
      "pattern": "^[a-z0-9][a-z0-9_:-]{0,99}$",
      "type": "string"
     },
     "required": {
      "type": "boolean"
     },
     "resumedAfterHandoff": {
      "type": "boolean"
     },
     "scenarioCode": {
      "enum": [
       "browser_reclaim",
       "resume_upload",
       "resume_parser_recheck",
       "semantic_boolean_commit",
       "custom_select_commit",
       "multi_step_navigation",
       "free_text_voice",
       "required_error_sweep",
       "final_consent",
       "handoff_reclaim",
       "critical_contact_integrity",
       "manual_submit_boundary",
       "job_identity_match"
      ],
      "type": "string"
     }
    },
    "required": [
     "committed",
     "scenarioCode",
     "browserSurface"
    ],
    "type": "object"
   },
   "observationType": {
    "pattern": "^[a-z0-9][a-z0-9_:-]{0,99}$",
    "type": "string"
   },
   "provider": {
    "pattern": "^[a-z0-9][a-z0-9_:-]{0,99}$",
    "type": "string"
   },
   "resolutionCode": {
    "pattern": "^[a-z0-9][a-z0-9_:-]{0,99}$",
    "type": "string"
   },
   "runId": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "runId",
   "provider",
   "fieldLabel",
   "observationType",
   "metadata"
  ],
  "type": "object"
 },
 "name": "trackly_report_apply_observation"
}

{
 "description": "Add MIDI notes to an existing session clip using ADR-0003 note fields. Use after creating or locating the target clip. NOT idempotent: repeated calls append notes; returns added count and verification diff if the count does not match.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clip_slot_index": {
    "minimum": 0,
    "type": "integer"
   },
   "notes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "duration": {
       "description": "Beats.",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "mute": {
       "type": "boolean"
      },
      "pitch": {
       "maximum": 127,
       "minimum": 0,
       "type": "integer"
      },
      "start": {
       "description": "Beats from clip start.",
       "minimum": 0,
       "type": "number"
      },
      "velocity": {
       "maximum": 127,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "pitch",
      "start",
      "duration"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "track_index": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "track_index",
   "clip_slot_index",
   "notes"
  ],
  "type": "object"
 },
 "name": "clip_add_notes"
}

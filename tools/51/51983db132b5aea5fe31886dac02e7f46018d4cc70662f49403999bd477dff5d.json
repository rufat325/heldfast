{
 "_meta": {
  "_fastmcp": {
   "tags": []
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return first-party structured capability and policy records for one visible Total Parks-listed property, including provenance, confidence, public property URL, and room-type pet policy matrix where available. Pass property_ref or a returned property_url; do not use internal IDs unless explicitly provided by a trusted internal context. Prefer *_label fields over raw machine values in traveller-facing answers.",
 "inputSchema": {
  "properties": {
   "include": {
    "default": "both",
    "description": "Which capability records to return: 'raw' source signals, 'summary' winning values, or 'both' (default).",
    "enum": [
     "raw",
     "summary",
     "both"
    ],
    "examples": [
     "both"
    ],
    "type": "string"
   },
   "property_id": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Internal property ID. Compatibility only; prefer property_ref or property_url from a previous Total Parks tool result."
   },
   "property_ref": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Public property ref from tp_resolve_property or search, formatted as '{state}/{slug}'. Prefer this or property_url over internal IDs. Example: 'victoria/big4-aireys-inlet'.",
    "examples": [
     "victoria/big4-aireys-inlet"
    ]
   },
   "property_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Traveller-facing Total Parks property URL returned by a previous tool. Accepted as an alias of property_ref. Example: 'https://totalparks.com.au/victoria/big4-aireys-inlet'.",
    "examples": [
     "https://totalparks.com.au/victoria/big4-aireys-inlet"
    ]
   }
  },
  "type": "object"
 },
 "name": "tp_get_park_capabilities",
 "outputSchema": {
  "properties": {
   "address": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "include": {
    "description": "Which projection layer(s) the caller wants in the response.",
    "enum": [
     "raw",
     "summary",
     "both"
    ],
    "type": "string"
   },
   "property_ref": {
    "type": "string"
   },
   "property_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "public_trust": {
    "items": {
     "description": "One selectively projected source record for a public claim.",
     "properties": {
      "conflict_or_stale": {
       "default": false,
       "type": "boolean"
      },
      "detail": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "fact_group": {
       "description": "Decision-critical claim groups eligible for public provenance.",
       "enum": [
        "availability_price",
        "room_identity",
        "rig_fit",
        "pet_policy",
        "site_power",
        "cancellation_policy",
        "listing_management",
        "google_rating"
       ],
       "type": "string"
      },
      "observed_or_confirmed_at": {
       "anyOf": [
        {
         "format": "date-time",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "public_source_label": {
       "description": "Traveller-facing labels approved by the public trust contract.",
       "enum": [
        "Managed by park",
        "From the park's booking system",
        "Confirmed by the park",
        "Source checked by Total Parks",
        "Google Maps"
       ],
       "type": "string"
      },
      "scope": {
       "description": "Public, non-internal scope descriptor.",
       "properties": {
        "label": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null,
         "description": "Optional traveller-facing scope label."
        },
        "type": {
         "description": "Entity or stay window to which the evidence applies.",
         "enum": [
          "property",
          "room_type",
          "stay",
          "rating"
         ],
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      }
     },
     "required": [
      "fact_group",
      "public_source_label",
      "scope"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "room_type_pet_policies": {
    "items": {
     "properties": {
      "accommodation_kind": {
       "description": "Whether the room type is a camping/caravan site or roofed accommodation.",
       "enum": [
        "site",
        "accommodation"
       ],
       "type": "string"
      },
      "pet_booking_mode": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "How pet bookings are handled online, e.g. instant or blocked."
      },
      "pet_max_count": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Maximum pets allowed for this room type, when known."
      },
      "pet_policy_confidence": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Machine-readable confidence bucket for the room-type pet policy. Prefer pet_policy_confidence_label in traveller-facing answers."
      },
      "pet_policy_confidence_label": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Traveller-facing confidence wording for the room-type pet policy."
      },
      "pet_policy_source": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Machine-readable provenance/source for the room-type pet policy. Prefer pet_policy_source_label in traveller-facing answers."
      },
      "pet_policy_source_label": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Traveller-facing source wording for the room-type pet policy, for example 'Confirmed by the park'. Inferred and unverified sources intentionally have no public label."
      },
      "pets_allowed": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Raw room-type pet allowance; null means the policy is unknown."
      },
      "policy_status": {
       "description": "Compact room-type pet policy status derived from pets_allowed.",
       "enum": [
        "allowed",
        "not_allowed",
        "unknown"
       ],
       "type": "string"
      },
      "room_type_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Guest-facing room/site type name, falling back to PMS name."
      },
      "room_type_ref": {
       "description": "Public room/site reference accepted by MCP tools.",
       "type": "string"
      },
      "room_type_url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Traveller-facing Total Parks URL for this room/site type."
      }
     },
     "required": [
      "room_type_ref",
      "accommodation_kind",
      "policy_status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "signals": {
    "anyOf": [
     {
      "items": {
       "description": "Public MCP projection of a raw capability signal.",
       "properties": {
        "confidence": {
         "type": "string"
        },
        "feature_category": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null
        },
        "feature_name": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null
        },
        "observed_at": {
         "anyOf": [
          {
           "format": "date-time",
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null
        },
        "scope_type": {
         "type": "string"
        },
        "source": {
         "type": "string"
        },
        "source_record_type": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null
        },
        "status": {
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "scope_type",
        "value",
        "source",
        "confidence",
        "status"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "summaries": {
    "anyOf": [
     {
      "items": {
       "description": "Public MCP projection of a derived capability claim.",
       "properties": {
        "computed_at": {
         "anyOf": [
          {
           "format": "date-time",
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null
        },
        "feature_category": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null

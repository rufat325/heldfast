        "feature_name": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null
        },
        "scope_type": {
         "type": "string"
        },
        "value": {
         "type": "string"
        },
        "winning_confidence": {
         "type": "string"

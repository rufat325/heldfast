{
 "description": "Generate a complete, production-ready HTML landing page with responsive design, hero section, features grid, CTA, and footer. Returns a self-contained HTML document with inline CSS and no external dependencies.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cta_text": {
    "default": "Get Started",
    "description": "Text for the CTA button",
    "type": "string"
   },
   "cta_url": {
    "description": "URL for the call-to-action button",
    "type": "string"
   },
   "features": {
    "description": "List of feature descriptions (3-12 recommended)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "product_name": {
    "description": "Name of the product or tool",
    "type": "string"
   },
   "tagline": {
    "description": "Short, compelling tagline or headline",
    "type": "string"
   },
   "theme": {
    "default": "dark",
    "description": "Color theme: dark (default) or light",
    "enum": [
     "dark",
     "light"
    ],
    "type": "string"
   }
  },
  "required": [
   "product_name",
   "tagline",
   "features",
   "cta_url"
  ],
  "type": "object"
 },
 "name": "generate_landing_page"
}

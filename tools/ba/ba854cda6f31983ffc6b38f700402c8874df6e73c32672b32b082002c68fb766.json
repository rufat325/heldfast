{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Manage persistent volumes and file mounts for an application, database, or service. Actions: list, create, update, delete. create needs storage type ('persistent' or 'file') and mount_path; update targets storage_uuid; delete needs storage_uuid.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "create",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "content": {
    "description": "File content for type 'file'",
    "type": "string"
   },
   "host_path": {
    "type": "string"
   },
   "is_directory": {
    "type": "boolean"
   },
   "mount_path": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "resource": {
    "enum": [
     "application",
     "database",
     "service"
    ],
    "type": "string"
   },
   "resource_uuid": {
    "description": "For service storages: UUID of the sub-resource (container) inside the service to mount on. Required by the API when resource is 'service'.",
    "type": "string"
   },
   "storage_uuid": {
    "description": "Required for update and delete",
    "type": "string"
   },
   "type": {
    "enum": [
     "persistent",
     "file"
    ],
    "type": "string"
   },
   "uuid": {
    "description": "Resource UUID",
    "type": "string"
   }
  },
  "required": [
   "resource",
   "uuid",
   "action"
  ],
  "type": "object"
 },
 "name": "storages",
 "title": "Manage persistent/file storages"
}

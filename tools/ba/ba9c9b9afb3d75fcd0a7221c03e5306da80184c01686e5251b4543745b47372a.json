{
 "description": "List payments with optional filters",
 "inputSchema": {
  "properties": {
   "customer": {
    "description": "Filter by customer ID",
    "type": "string"
   },
   "limit": {
    "description": "Number of results (default 10)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset",
    "type": "number"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "PENDING",
     "RECEIVED",
     "CONFIRMED",
     "OVERDUE",
     "REFUNDED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_payments"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get public crypto-asset rates in one fiat base currency.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assets": {
    "items": {
     "description": "Exact xRocket asset identifier; TON is currently TONCOIN",
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "base": {
    "description": "Fiat base currency, for example USD",
    "maxLength": 8,
    "minLength": 3,
    "pattern": "^[A-Z0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "base"
  ],
  "type": "object"
 },
 "name": "xrocket_rates",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {}
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "xRocket rates"
}

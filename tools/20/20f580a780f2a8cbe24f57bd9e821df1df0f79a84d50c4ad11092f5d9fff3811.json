{
 "description": "Replace a legal document. Sections are ordered; omit slug to derive it from the heading. The plugin ships no legal prose - it stores and renders what it is given.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "doc": {
    "description": "Document type",
    "enum": [
     "impressum",
     "datenschutz",
     "agb",
     "widerruf"
    ],
    "type": "string"
   },
   "sections": {
    "description": "Ordered sections",
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "description": "HTML body",
       "type": "string"
      },
      "heading": {
       "type": "string"
      },
      "level": {
       "description": "2 or 3, default 2",
       "type": "number"
      },
      "slug": {
       "description": "Stable slug; derived from the heading when omitted",
       "type": "string"
      }
     },
     "required": [
      "heading",
      "body"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "title": {
    "description": "Document title, rendered as the H1",
    "type": "string"
   }
  },
  "required": [
   "site",
   "doc",
   "title",
   "sections"
  ],
  "type": "object"
 },
 "name": "legal_put_document"
}

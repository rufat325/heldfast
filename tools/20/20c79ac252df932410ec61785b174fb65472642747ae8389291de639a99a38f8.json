{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Download a financial report (proceeds and adjustments) for a region. Returns parsed TSV rows.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "description": "Max rows to return inline (default 500)",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "regionCode": {
    "description": "Region code, e.g. \"Z1\" (worldwide), \"US\", \"EU\", \"JP\"",
    "type": "string"
   },
   "reportDate": {
    "description": "Fiscal report month, format YYYY-MM (e.g. \"2025-09\")",
    "type": "string"
   },
   "reportType": {
    "description": "Report type (default FINANCIAL)",
    "enum": [
     "FINANCIAL",
     "FINANCE_DETAIL"
    ],
    "type": "string"
   },
   "vendorNumber": {
    "description": "Apple-issued vendor number",
    "type": "string"
   }
  },
  "required": [
   "vendorNumber",
   "reportDate",
   "regionCode"
  ],
  "type": "object"
 },
 "name": "download_finance_report"
}

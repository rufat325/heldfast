{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Returns a plain-text summary of a priced offer (service, amount, currency, cancellation policy, and how long the price is valid) plus a URL on our domain that shows the same summary. The URL is for the CUSTOMER to open themselves in their own browser \u2014 do not open, fetch, or follow it yourself. Use this once get_quote or a booking flow has produced an offer_id and the user is ready to review or continue with a priced offer. If the booking's deposit was already paid through create_booking_payment_link, this answers deposit_taken: do not send the person to pay again; the balance is due at the visit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "offer_id": {
    "description": "The offer id returned by get_quote",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "slug": {
    "description": "Business slug identifier",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug",
   "offer_id"
  ],
  "type": "object"
 },
 "name": "get_payment_handoff_url",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "state": {
    "enum": [
     "pending",
     "resolved"
    ],
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "amount": {
      "description": "Major units (e.g. 29.00 for $29.00), never minor-unit cents",
      "type": "number"
     },
     "business": {
      "type": "string"
     },
     "cancellation_policy": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "currency": {
      "type": "string"
     },
     "offer_expires_at": {
      "description": "Offer price validity expiry (Unix seconds)",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "params": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "service": {
      "type": "string"
     }
    },
    "required": [
     "business",
     "service",
     "amount",
     "currency",
     "params",
     "cancellation_policy",
     "offer_expires_at"
    ],
    "type": "object"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "summary",
   "state"
  ],
  "type": "object"
 },
 "title": "Get Payment Handoff URL"
}

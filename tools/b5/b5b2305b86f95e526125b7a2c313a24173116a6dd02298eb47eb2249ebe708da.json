{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Structure of one ILOSTAT dataflow: dimensions (in SDMX key order), their codelists, the time dimension, the source's default selection and the data vintage (last update at the ILO). Use before ilo_get_data to know which filters exist. Does not return statistical values and does not list the codes themselves (use ilo_list_dimension_values).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "dataflow": {
    "description": "Dataflow id from ilo_search_indicators (e.g. \"DF_UNE_DEAP_SEX_AGE_RT\")",
    "minLength": 1,
    "type": "string"
   },
   "provenance_mode": {
    "description": "Provenance verbosity: 'concise' (default \u2014 source, url, vintage, retrieval date, citation, license) or 'detailed' (full canonical block with dataset, dimension key and notices)",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   }
  },
  "required": [
   "dataflow"
  ],
  "type": "object"
 },
 "name": "ilo_get_indicator_metadata",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "attribution": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "data_vintage": {
    "type": [
     "string",
     "null"
    ]
   },
   "dimensions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "codelist": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "codelist"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "type": "string"
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "provenance": {},
   "time_dimension": {
    "type": [
     "string",
     "null"
    ]
   },
   "version": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "version",
   "name",
   "data_vintage",
   "dimensions",
   "time_dimension",
   "provenance",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Get ILOSTAT indicator metadata"
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:scan"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a scan by id"
 },
 "description": "Polls a scan started by scan_url \u2014 either kind, recorded against a registered site or one-off; this tool finds it either way. Returns severity counts, a finding sample, the coverage disclaimer, and (once terminal) a failure reason if the scan did not complete. For a full-site run from scan_site, use get_run instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "scanId": {
    "description": "The id returned by scan_url.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "scanId"
  ],
  "type": "object"
 },
 "name": "get_scan",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "coverageDisclaimer": {
    "description": "Why this result is not a compliance verdict. Always relay it; never present a scan as proof of conformance.",
    "type": "string"
   },
   "pollWith": {
    "const": "get_scan",
    "description": "The tool that reads this scan's progress and result.",
    "type": "string"
   },
   "recordedAgainstSite": {
    "description": "True when the URL belongs to a registered site and the scan was kept against it (so it feeds history and trends); false for a one-off scan.",
    "type": "boolean"
   },
   "scan": {
    "additionalProperties": false,
    "properties": {
     "counts": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "critical": {
          "type": "number"
         },
         "minor": {
          "type": "number"
         },
         "moderate": {
          "type": "number"
         },
         "serious": {
          "type": "number"
         }
        },
        "required": [
         "critical",
         "serious",
         "moderate",
         "minor"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "failureReason": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "string"
         },
         "reason": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "code"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "host": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "incompleteCount": {
      "type": [
       "number",
       "null"
      ]
     },
     "passesCount": {
      "type": [
       "number",
       "null"
      ]
     },
     "requestedUrl": {
      "type": [
       "string",
       "null"
      ]
     },
     "siteId": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "description": "QUEUED, RUNNING, DONE, PARTIAL or FAILED.",
      "type": "string"
     },
     "topViolations": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": false,
         "properties": {
          "failureSummary": {
           "type": [
            "string",
            "null"
           ]
          },
          "helpUrl": {
           "type": "string"
          },
          "htmlSnippet": {
           "type": [
            "string",
            "null"
           ]
          },
          "impact": {
           "type": "string"
          },
          "ruleId": {
           "type": "string"
          },
          "targetSelector": {
           "type": "string"
          },
          "url": {
           "type": [
            "string",
            "null"
           ]
          },
          "wcagSc": {
           "anyOf": [
            {
             "items": {
              "type": "string"
             },
             "type": "array"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "ruleId",
          "impact",
          "helpUrl",
          "targetSelector"
         ],
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "totalViolations": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "status"
    ],
    "type": "object"
   },
   "scoringGuidance": {
    "description": "Binding instruction for the assistant reading this result. Follow it literally.",
    "type": "string"
   },
   "standard": {
    "description": "The standard the checks were run against, e.g. \"WCAG 2.1 AA\".",
    "type": "string"
   }
  },
  "required": [
   "scan",
   "recordedAgainstSite",
   "pollWith",
   "coverageDisclaimer",
   "scoringGuidance",
   "standard"
  ],
  "type": "object"
 },
 "title": "Get a scan by id"
}

{
 "description": "List registered agents with optional filters",
 "inputSchema": {
  "properties": {
   "capability": {
    "description": "Filter by capability",
    "enum": [
     "pay",
     "receive",
     "authorize",
     "audit"
    ],
    "type": "string"
   },
   "pageSize": {
    "description": "Results per page",
    "type": "number"
   },
   "pageToken": {
    "description": "Pagination token",
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "active",
     "suspended",
     "revoked"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_agents"
}

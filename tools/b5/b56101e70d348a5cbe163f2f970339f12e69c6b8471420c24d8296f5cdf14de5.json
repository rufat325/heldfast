{
 "description": "Bulk import memories from structured data (JSON or Markdown). Max 50 items per call. Supports conflict detection: skip duplicates, overwrite, or merge.",
 "inputSchema": {
  "properties": {
   "conflict_strategy": {
    "description": "How to handle duplicates (default: skip)",
    "enum": [
     "skip",
     "overwrite",
     "merge"
    ],
    "type": "string"
   },
   "data": {
    "description": "For JSON: array of {content, tags?, tier?}. For Markdown: string with --- separators between entries.",
    "oneOf": [
     {
      "items": {
       "properties": {
        "content": {
         "type": "string"
        },
        "tags": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "tier": {
         "type": "number"
        }
       },
       "required": [
        "content"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "string"
     }
    ]
   },
   "default_tags": {
    "description": "Tags to apply to all imported items",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "format": {
    "description": "Input format (default: json)",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   },
   "quarantine_zone": {
    "description": "Optional quarantine zone ID for all imported memories",
    "type": "string"
   },
   "source": {
    "description": "Provenance label (e.g. \"notion-export\", \"obsidian-vault\")",
    "type": "string"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "name": "velixar_import"
}

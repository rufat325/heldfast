{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Select supplied Oman-relevant channels for an ICP and create a 14-day action plan; live popularity is not checked. Use when an agent needs the Creative Techno book framework for oman go to market plan.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "availableBudgetOMR": {
    "description": "OMR; calculations use integer baisa internally",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "business": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "channels": {
    "items": {
     "enum": [
      "instagram",
      "tiktok",
      "whatsapp_business",
      "google_maps",
      "content",
      "short_video",
      "influencers",
      "partnerships",
      "referrals",
      "events",
      "paid_ads"
     ],
     "type": "string"
    },
    "maxItems": 11,
    "minItems": 1,
    "type": "array"
   },
   "customer": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "ar",
     "en"
    ],
    "type": "string"
   },
   "offer": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "problem": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "business",
   "customer",
   "problem",
   "offer",
   "channels"
  ],
  "type": "object"
 },
 "name": "oman_go_to_market_plan",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "frameworkSource": {
    "additionalProperties": false,
    "properties": {
     "edition": {
      "const": "2026",
      "type": "string"
     },
     "publisher": {
      "const": "Creative Techno",
      "type": "string"
     },
     "title": {
      "const": "\u0643\u064a\u0641 \u062a\u0628\u062f\u0623 \u0645\u0634\u0631\u0648\u0639\u0643 \u0627\u0644\u0635\u063a\u064a\u0631 \u0641\u064a \u0639\u064f\u0645\u0627\u0646\u061f",
      "type": "string"
     }
    },
    "required": [
     "publisher",
     "title",
     "edition"
    ],
    "type": "object"
   },
   "language": {
    "enum": [
     "ar",
     "en"
    ],
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "frameworkSource",
   "language",
   "result"
  ],
  "type": "object"
 }
}

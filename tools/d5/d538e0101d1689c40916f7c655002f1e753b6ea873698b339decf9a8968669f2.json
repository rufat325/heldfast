{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find when a body crosses sign boundaries in a date range. Retrograde\ncrossings (backing into the previous sign) are flagged. The Sun's Aries\ningress is the March equinox; Sun ingresses mark the astrological \"seasons\".\n\nExamples:\n  - \"When does Saturn change signs in the next 3 years?\" ->\n    { body: \"Saturn\", from_datetime: \"2026-01-01\", to_datetime: \"2029-01-01\" }\n  - \"When does the Sun enter Aries in 2027?\" -> body: \"Sun\", window covering March 2027",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "body": {
    "description": "Which body's ingresses to find.",
    "enum": [
     "Sun",
     "Moon",
     "Mercury",
     "Venus",
     "Mars",
     "Jupiter",
     "Saturn",
     "Uranus",
     "Neptune",
     "Pluto"
    ],
    "type": "string"
   },
   "from_datetime": {
    "description": "Start of the search window.",
    "minLength": 4,
    "type": "string"
   },
   "to_datetime": {
    "description": "End of the search window (max 120 years after start).",
    "minLength": 4,
    "type": "string"
   }
  },
  "required": [
   "body",
   "from_datetime",
   "to_datetime"
  ],
  "type": "object"
 },
 "name": "find_sign_ingresses",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ingresses": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "datetime": {
       "type": "string"
      },
      "direction": {
       "enum": [
        "direct",
        "retrograde"
       ],
       "type": "string"
      },
      "enters": {
       "type": "string"
      }
     },
     "required": [
      "body",
      "datetime",
      "enters",
      "direction"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ingresses"
  ],
  "type": "object"
 },
 "title": "Find Sign Ingresses"
}

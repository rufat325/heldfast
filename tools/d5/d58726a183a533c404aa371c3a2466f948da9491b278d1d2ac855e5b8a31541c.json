{
 "annotations": {
  "cost": {
   "all": 10
  },
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Query a Notion database with filters and sorting (e.g., status='Done', sort by date). Returns matching rows with property values.",
 "inputSchema": {
  "examples": [
   {
    "database_id": "a1b2c3d4e5f641d4a716446655440000"
   },
   {
    "database_id": "a1b2c3d4e5f641d4a716446655440000",
    "filter": {
     "property": "Status",
     "select": {
      "equals": "Done"
     }
    },
    "page_size": 25,
    "sorts": [
     {
      "direction": "descending",
      "property": "Created"
     }
    ]
   }
  ],
  "properties": {
   "database_id": {
    "description": "Notion database ID to query",
    "type": "string"
   },
   "filter": {
    "description": "Notion filter object (e.g., { \"property\": \"Status\", \"select\": { \"equals\": \"Done\" } })",
    "type": "object"
   },
   "page_size": {
    "description": "Number of results to return (default 10, max 100)",
    "type": "number"
   },
   "sorts": {
    "description": "Array of sort objects (e.g., [{ \"property\": \"Created\", \"direction\": \"descending\" }])",
    "type": "array"
   },
   "start_cursor": {
    "description": "Pagination cursor for next page of results",
    "type": "string"
   }
  },
  "required": [
   "database_id"
  ],
  "type": "object"
 },
 "name": "notion_query_database",
 "outputSchema": {
  "properties": {
   "has_more": {
    "description": "Whether more results exist",
    "type": "boolean"
   },
   "next_cursor": {
    "description": "Pagination cursor for next page",
    "type": [
     "string",
     "null"
    ]
   },
   "object": {
    "description": "Always 'list'",
    "type": "string"
   },
   "results": {
    "description": "Array of matching database rows (pages)",
    "items": {
     "properties": {
      "created_time": {
       "description": "ISO 8601 creation timestamp",
       "type": "string"
      },
      "id": {
       "description": "Page ID",
       "type": "string"
      },
      "last_edited_time": {
       "description": "ISO 8601 last edit timestamp",
       "type": "string"
      },
      "object": {
       "description": "Object type ('page')",
       "type": "string"
      },
      "properties": {
       "description": "Row property values",
       "type": "object"
      },
      "url": {
       "description": "Notion web URL",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Notion Query Database",
 "version": "v1.d064f50b"
}

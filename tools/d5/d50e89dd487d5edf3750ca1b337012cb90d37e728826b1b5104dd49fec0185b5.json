{
 "description": "Delete an email (moves to Trash). Provider-aware: uses correct Trash folder for Gmail/Outlook/IMAP. Get UIDs from email_list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "folder": {
    "description": "Source folder (default: INBOX)",
    "type": "string"
   },
   "uid": {
    "description": "Email UID to delete",
    "type": "number"
   }
  },
  "required": [
   "uid"
  ],
  "type": "object"
 },
 "name": "email_delete"
}

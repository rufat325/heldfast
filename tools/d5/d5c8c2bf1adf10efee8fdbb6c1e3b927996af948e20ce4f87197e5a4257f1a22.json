{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Normalize an English, Arabic or mixed-language CV into a machine-readable candidate profile using only stated professional evidence; protected personal attributes are ignored. Use before scoring or matching a CV when an agent needs reusable structured candidate evidence.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cv_text": {
    "maxLength": 200000,
    "minLength": 1,
    "type": "string"
   },
   "document_url": {
    "format": "uri",
    "maxLength": 2000,
    "type": "string"
   },
   "language": {
    "default": "auto",
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   },
   "target_schema_version": {
    "default": "1.0",
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "extract_candidate_profile",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "candidate": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "candidate_keywords": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "career_progression": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "certifications": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "education": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "evidence_quality": {
    "additionalProperties": false,
    "properties": {
     "ambiguities": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "missing_information": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "score": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "score",
     "missing_information",
     "ambiguities"
    ],
    "type": "object"
   },
   "experience": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "industries": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "languages": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "management_experience": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "projects": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "recent_role": {
    "type": [
     "string",
     "null"
    ]
   },
   "seniority_estimate": {
    "type": [
     "string",
     "null"
    ]
   },
   "skills": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "total_experience_years": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "candidate",
   "experience",
   "education",
   "skills",
   "certifications",
   "languages",
   "projects",
   "industries",
   "management_experience",
   "total_experience_years",
   "recent_role",
   "seniority_estimate",
   "career_progression",
   "candidate_keywords",
   "evidence_quality"
  ],
  "type": "object"
 }
}

{
 "description": "Break content into atomic pieces \u2014 social posts, email snippets, ad copy, thread starters. Repurpose one article into 20+ content pieces.",
 "inputSchema": {
  "properties": {
   "content_id": {
    "description": "Content ID to atomize (required)",
    "type": "string"
   },
   "formats": {
    "description": "Output formats to generate (default: all)",
    "items": {
     "enum": [
      "social",
      "email",
      "ad",
      "thread",
      "summary"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "tone": {
    "description": "Tone for generated atoms",
    "enum": [
     "professional",
     "casual",
     "technical"
    ],
    "type": "string"
   }
  },
  "required": [
   "content_id"
  ],
  "type": "object"
 },
 "name": "create_atomization"
}

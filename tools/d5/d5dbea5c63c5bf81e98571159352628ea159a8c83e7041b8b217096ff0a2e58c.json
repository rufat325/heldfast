 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "The policy ID (UUID).",
    "minLength": 1,
    "type": "string"
   },
   "version": {
    "description": "The version_number to restore (from list_policy_versions).",
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "version"
  ],
  "type": "object"
 },
 "name": "restore_policy_version",
 "title": "Restore policy version"
}

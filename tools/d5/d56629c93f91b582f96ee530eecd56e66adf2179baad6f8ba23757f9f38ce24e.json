  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free-text search across MedlinePlus topics (or related NLM databases).",
 "inputSchema": {
  "examples": [
   {
    "query": "diabetes"
   },
   {
    "db": "drug",
    "limit": 20,
    "query": "aspirin"
   }
  ],
  "properties": {
   "db": {
    "description": "healthTopics (default) | healthTopicsSpanish | drug | herb | meshhd | genetic",
    "type": "string"
   },
   "limit": {
    "description": "1-100 (default 10)",
    "type": "number"
   },
   "query": {
    "type": "string"
   },
   "retstart": {
    "description": "0-based offset",
    "type": "number"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "properties": {
   "results": {
    "items": {

{
 "description": "Manage phased (gradual) release for a version. Actions: create (enable 7-day rollout), pause, resume, complete (release to everyone).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Phased release action",
    "enum": [
     "create",
     "pause",
     "resume",
     "complete"
    ],
    "type": "string"
   },
   "versionId": {
    "description": "Version ID",
    "type": "string"
   }
  },
  "required": [
   "versionId",
   "action"
  ],
  "type": "object"
 },
 "name": "asc_phased_release"
}

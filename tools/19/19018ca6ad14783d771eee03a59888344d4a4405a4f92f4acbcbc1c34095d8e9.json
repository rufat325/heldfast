{
 "description": "Write situation-entity canon by op. create adds an entity; owed supports create, give, and reopen; load_link supports create and remove. Provenance is writer-stamped.",
 "inputSchema": {
  "properties": {
   "at": {
    "description": "ISO date (YYYY-MM-DD).",
    "type": "string"
   },
   "carries": {
    "type": "string"
   },
   "channel": {
    "description": "said|observed|secondhand|inferred",
    "type": "string"
   },
   "display_name": {
    "type": "string"
   },
   "fact": {
    "description": "load_link create branch fact ID.",
    "type": "string"
   },
   "fact_id": {
    "type": "string"
   },
   "filled_by": {
    "type": "string"
   },
   "idempotency_key": {
    "type": "string"
   },
   "load_link_id": {
    "type": "string"
   },
   "name": {
    "description": "owed create branch.",
    "type": "string"
   },
   "op": {
    "enum": [
     "create",
     "add_fact",
     "correct",
     "owed",
     "load_link"
    ],
    "type": "string"
   },
   "owed_id": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "remove": {
    "type": "boolean"
   },
   "reopen": {
    "type": "boolean"
   },
   "slug": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "via": {
    "description": "Source attribution for a secondhand fact; not provenance.",
    "type": "string"
   },
   "why_load_bearing": {
    "type": "string"
   }
  },
  "required": [
   "op"
  ],
  "type": "object"
 },
 "name": "judgment_situation_write"
}

{
 "description": "Follow a TCP/UDP/HTTP stream in a PCAP. Returns stream_content, stream_num, and protocol. Read-only file analysis.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pcap_path": {
    "description": "Path to the PCAP file",
    "type": "string"
   },
   "protocol": {
    "default": "tcp",
    "description": "Stream protocol",
    "enum": [
     "tcp",
     "udp",
     "http"
    ],
    "type": "string"
   },
   "stream_num": {
    "description": "TCP stream number to follow",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "pcap_path",
   "stream_num"
  ],
  "type": "object"
 },
 "name": "pcap_follow_stream"
}

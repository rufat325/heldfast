 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "type": "boolean"
   },
   "currencyCode": {
    "type": "string"
   },
   "displayName": {
    "type": "string"
   },
   "industryCategory": {
    "type": "string"
   },
   "property": {
    "description": "GA4 property ID, e.g. \"123456789\" or \"properties/123456789\".",
    "minLength": 1,
    "type": "string"
   },
   "timeZone": {
    "type": "string"
   },
   "updateMask": {
    "type": "string"
   }
  },
  "required": [
   "property",
   "confirm"
  ],
  "type": "object"
 },
 "name": "ga4_update_property"
}

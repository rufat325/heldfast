{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a contact in Xero. When a contact is updated, a deep link to the contact in Xero is returned.  This deep link can be used to view the contact in Xero directly.  This link should be displayed to the user.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "additionalProperties": false,
    "properties": {
     "addressLine1": {
      "type": "string"
     },
     "addressLine2": {
      "type": "string"
     },
     "city": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "postalCode": {
      "type": "string"
     },
     "region": {
      "type": "string"
     }
    },
    "required": [
     "addressLine1"
    ],
    "type": "object"
   },
   "contactId": {
    "type": "string"
   },
   "email": {
    "format": "email",
    "type": "string"
   },
   "firstName": {
    "type": "string"
   },
   "lastName": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "phone": {
    "type": "string"
   }
  },
  "required": [
   "contactId",
   "name"
  ],
  "type": "object"
 },
 "name": "update-contact"
}

    "type": "string"
   },
   "replicas": {
    "default": 1,
    "description": "Number of replicas",
    "type": "number"
   },
   "resourceType": {
    "description": "Type of resource to create (project, deploymentconfig, route, service, etc.)",
    "type": "string"
   },
   "service": {
    "description": "Service name for route",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "oc_create"
}

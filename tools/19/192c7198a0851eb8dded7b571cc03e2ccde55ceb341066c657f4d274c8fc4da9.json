    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "companyName": {
    "description": "Company name as known to the caller (trading or legal name).",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "country": {
    "description": "Country of registration/operation \u2014 ISO alpha-2 (e.g. GB), alpha-3 or English name. Strongly recommended to avoid same-name confusion.",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "domain": {
    "description": "Company domain if no website URL is known, e.g. example.com.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "industry": {
    "description": "Industry/sector (context only; not used to score).",
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "legalName": {
    "description": "Full registered legal name, if different from companyName.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "lei": {
    "description": "Legal Entity Identifier (ISO 17442), if known.",
    "maxLength": 24,
    "minLength": 20,
    "type": "string"
   },
   "registrationNumber": {
    "description": "Company registration number in its home registry (e.g. UK Companies House number).",
    "maxLength": 64,
    "minLength": 2,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9 ./-]*$",
    "type": "string"
   },
   "website": {
    "description": "Company website, e.g. https://example.com.",
    "maxLength": 300,
    "minLength": 4,
    "type": "string"
   }
  },
  "required": [
   "companyName"
  ],
  "type": "object"
 },

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage stories/tasks under features. Methods: list, create, update, batch_update",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acceptance_criteria": {
    "description": "Testable criteria (for: create, update)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ai_guidance": {
    "additionalProperties": {},
    "description": "AI guidance (for: create, update)",
    "type": "object"
   },
   "assignee": {
    "description": "Assignee (for: create, update)",
    "type": "string"
   },
   "description": {
    "description": "Story description (for: create, update)",
    "type": "string"
   },
   "due_date": {
    "description": "Due date (for: create)",
    "type": "string"
   },
   "feature_id": {
    "description": "Feature ID (required for: create; filter for: list)",
    "type": "string"
   },
   "guidance_template_id": {
    "description": "Template ID (for: create)",
    "type": "string"
   },
   "inferred_fields": {
    "description": "Inferred fields (for: create)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max results per page (for: list)",
    "type": "number"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "list",
     "create",
     "update",
     "batch_update"
    ],
    "type": "string"
   },
   "offset": {
    "description": "Skip N results (for: list)",
    "type": "number"
   },
   "project_id": {
    "description": "Project ID (for: list, create \u2014 auto-detected if omitted)",
    "type": "string"
   },
   "status": {
    "description": "Status (for: update; filter for: list)",
    "enum": [
     "todo",
     "in_progress",
     "done"
    ],
    "type": "string"
   },
   "story_id": {
    "description": "Story ID or ticket ID like VP-42 (required for: update)",
    "type": "string"
   },
   "story_points": {
    "description": "Story points (for: create, update)",
    "type": "number"
   },
   "title": {
    "description": "Story title (required for: create)",
    "type": "string"
   },
   "type": {
    "description": "Story type (for: create)",
    "enum": [
     "story",
     "task",
     "bug",
     "chore"
    ],
    "type": "string"
   },
   "updates": {
    "description": "Batch updates array (required for: batch_update)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "status": {
       "type": "string"
      },
      "story_id": {
       "type": "string"
      }
     },
     "required": [
      "story_id",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "stories"
}

{
 "description": "List active vacancies for a specific employer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "employer_id": {
    "description": "Employer ID",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "page": {
    "default": 0,
    "description": "Page number (0-based)",
    "minimum": 0,
    "type": "integer"
   },
   "per_page": {
    "default": 20,
    "description": "Results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "raw": {
    "description": "Return the full raw hh.ru JSON instead of the compact summary.",
    "type": "boolean"
   }
  },
  "required": [
   "employer_id"
  ],
  "type": "object"
 },
 "name": "get_employer_vacancies"
}

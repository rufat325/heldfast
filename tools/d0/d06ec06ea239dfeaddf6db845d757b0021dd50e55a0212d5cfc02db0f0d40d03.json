{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Single-entry operations on the tagged/versioned journal: add, get, update, versions, restore.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Operation",
    "enum": [
     "add",
     "get",
     "update",
     "versions",
     "restore"
    ],
    "type": "string"
   },
   "content": {
    "description": "Entry body (add/update)",
    "type": "string"
   },
   "entryId": {
    "description": "Entry ID (required for get/update/versions/restore)",
    "type": "string"
   },
   "reason": {
    "description": "Reason for the update (update)",
    "type": "string"
   },
   "source": {
    "description": "Source attribution (add/update)",
    "type": "string"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   },
   "tags": {
    "description": "Tags (add/update)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Entry title (add)",
    "type": "string"
   },
   "type": {
    "description": "Entry type: extraction | summary | decision | artifact (add)",
    "type": "string"
   },
   "version": {
    "description": "Version number to restore (restore)",
    "type": "number"
   }
  },
  "required": [
   "spaceId",
   "action"
  ],
  "type": "object"
 },
 "name": "entry",
 "outputSchema": {
  "properties": {},
  "type": "object"
 }
}

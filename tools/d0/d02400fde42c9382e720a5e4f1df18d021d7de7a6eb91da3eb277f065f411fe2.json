     "next_actions"
    ],
    "type": "object"
   },
   "logs": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "level": {
       "enum": [
        "log",
        "info",
        "warn",
        "error"
       ],
       "type": "string"
      },

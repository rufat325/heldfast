 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Fetch Analysis Result"
 },
 "description": "Return the progress or result of an analysis started with initiate_analysis, by its analysis_id. Each call returns the current state once and does not wait. While status is in_progress, check again only when the person asks, and no sooner than retry_after_seconds. A failed status is an answer; relay error_message. A complete result carries the composite score and rating word, the evidence word (Full, Core or Low), each domain's score, grade word and contribution (cornerstone, major, supporting or contextual), key strengths and challenges, and for a Plus Analysis a written narrative. Say how much a domain counts only with its contribution word, never as a number or share. It does not accept a ticker and does not rank companies.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "analysis_id": {
    "description": "The analysis_id returned by initiate_analysis",
    "type": "string"
   }
  },
  "required": [
   "analysis_id"
  ],
  "type": "object"
 },

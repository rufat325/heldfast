{
 "description": "Sign and submit a Solana transaction payload returned by printr_create_token. If no private_key is provided, the user will be prompted to select or provision a wallet. Returns the transaction signature once confirmed. After successful confirmation, present the trade page URL to the user: https://app.printr.money/trade/{token_id} using the token_id from the prior printr_create_token call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "payload": {
    "properties": {
     "ixs": {
      "description": "Solana instructions from printr_create_token",
      "items": {
       "properties": {
        "accounts": {
         "items": {
          "properties": {
           "is_signer": {
            "type": "boolean"
           },
           "is_writable": {
            "type": "boolean"
           },
           "pubkey": {
            "type": "string"
           }
          },
          "required": [
           "pubkey",
           "is_signer",
           "is_writable"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "data": {
         "description": "Instruction data (base64)",
         "type": "string"
        },
        "program_id": {
         "description": "Program ID (base58)",
         "type": "string"
        }
       },
       "required": [
        "program_id",
        "accounts",
        "data"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "lookup_table": {
      "description": "Address lookup table (base58)",
      "type": "string"
     },
     "mint_address": {
      "description": "Expected mint address (CAIP-10)",
      "type": "string"
     }
    },
    "required": [
     "ixs",
     "mint_address"
    ],
    "type": "object"
   },
   "private_key": {
    "description": "base58-encoded 64-byte Solana keypair secret. WARNING: handle with care \u2014 never share or commit this value. If omitted, the user will be prompted to select or provision a wallet.",
    "type": "string"
   },
   "rpc_url": {
    "description": "Solana RPC endpoint override",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "printr_sign_and_submit_svm",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmation_status": {
    "description": "Confirmation level",
    "enum": [
     "finalized",
     "confirmed",
     "processed"
    ],
    "type": "string"
   },
   "signature": {
    "description": "Transaction signature (base58)",
    "type": "string"
   },
   "slot": {
    "description": "Slot the transaction was confirmed in",
    "type": "number"
   }
  },
  "required": [
   "signature",
   "slot",
   "confirmation_status"
  ],
  "type": "object"
 }
}

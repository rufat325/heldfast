{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find interactive UI elements"
 },
 "description": "List interactive UI elements in a window (buttons, fields, menus first; grid cells last). Each item has a stable global element_index plus can_invoke/can_set_value flags. Paginated (total/offset/limit/has_more). Read-only \u2014 no action tier required. Pass element_index to ui_invoke/ui_set_value.",
 "inputSchema": {
  "properties": {
   "hwnd": {
    "description": "Exact window handle",
    "type": "number"
   },
   "limit": {
    "description": "Page size (default 30, max 200)",
    "type": "number"
   },
   "name_contains": {
    "description": "Filter elements by name",
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset (default 0)",
    "type": "number"
   },
   "role": {
    "description": "Filter by role (Button, Edit, MenuItem, ...)",
    "type": "string"
   },
   "title_contains": {
    "description": "Window title fragment",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ui_find"
}

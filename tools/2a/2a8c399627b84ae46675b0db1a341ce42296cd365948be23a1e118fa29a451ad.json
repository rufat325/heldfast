{
 "description": "Rank evidence-backed distribution tests by audience fit, buyer intent, format, attribution, access, saturation, rules, budget, owner availability, and qualified outcome gates. Costs $0.25 USDC on Base mainnet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channels": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attribution": {
       "enum": [
        "verified",
        "direct",
        "inferred",
        "none"
       ]
      },
      "attribution_mechanism": {
       "maxLength": 300,
       "type": "string"
      },
      "audience_match": {
       "maximum": 5,
       "minimum": 0,
       "type": "integer"
      },
      "buyer_intent": {
       "maximum": 5,
       "minimum": 0,
       "type": "integer"
      },
      "estimated_cost_usd": {
       "maximum": 1000000,
       "minimum": 0,
       "type": "number"
      },
      "estimated_effort_hours": {
       "maximum": 100000,
       "minimum": 0,
       "type": "number"
      },
      "existing_access": {
       "enum": [
        "relationship",
        "audience",
        "account",
        "none"
       ]
      },
      "format_match": {
       "maximum": 5,
       "minimum": 0,
       "type": "integer"
      },
      "id": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "kind": {
       "enum": [
        "owned-search",
        "package-registry",
        "agent-directory",
        "marketplace",
        "community",
        "social",
        "direct-outreach",
        "partner",
        "paid"
       ]
      },
      "offer_path_ready": {
       "type": "boolean"
      },
      "outcome_gate": {
       "additionalProperties": false,
       "properties": {
        "max_cost_usd": {
         "maximum": 1000000,
         "minimum": 0,
         "type": "number"
        },
        "max_effort_hours": {
         "maximum": 100000,
         "minimum": 0,
         "type": "number"
        },
        "metric": {
         "enum": [
          "attributable-click",
          "buyer-reply",
          "buyer-question",
          "checkout-open",
          "install",
          "payment-initiation",
          "external-settlement",
          "commission",
          "recurring-use",
          "measured-review-time-reduction",
          "page-view",
          "impression",
          "reaction",
          "indexing-event",
          "deployment",
          "directory-listing",
          "scan",
          "sent-message"
         ]
        },
        "threshold": {
         "maximum": 1000000,
         "minimum": 1,
         "type": "integer"
        },
        "window_days": {
         "maximum": 365,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "metric",
        "threshold",
        "window_days",
        "max_cost_usd",
        "max_effort_hours"
       ],
       "type": "object"
      },
      "owner_available": {
       "type": "boolean"
      },
      "owner_presence_required": {
       "type": "boolean"
      },
      "product_evidence_ids": {
       "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "rule_evidence_id": {
       "maxLength": 120,
       "type": "string"
      },
      "rule_status": {
       "enum": [
        "verified",
        "review-required",
        "unknown",
        "blocked"
       ]
      },
      "saturation": {
       "maximum": 5,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "id",
      "kind",
      "audience_match",
      "buyer_intent",
      "format_match",
      "saturation",
      "rule_status",
      "rule_evidence_id",
      "product_evidence_ids",
      "attribution",
      "attribution_mechanism",
      "existing_access",
      "offer_path_ready",
      "estimated_cost_usd",
      "estimated_effort_hours",
      "owner_presence_required",
      "owner_available",
      "outcome_gate"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "constraints": {
    "additionalProperties": false,
    "properties": {
     "budget_usd": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "number"
     },
     "effort_hours": {
      "maximum": 100000,
      "minimum": 0,
      "type": "number"
     },
     "max_parallel_tests": {
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
     },
     "rules_max_age_days": {
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "budget_usd",
     "effort_hours",
     "max_parallel_tests",
     "rules_max_age_days"
    ],
    "type": "object"
   },
   "evidence": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "captured_at": {
       "format": "date-time",
       "type": "string"
      },
      "id": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "observed": {
       "type": "boolean"
      },
      "source_url": {
       "format": "uri",
       "type": "string"
      },
      "type": {
       "enum": [
        "platform-rule",
        "product-proof",
        "buyer-signal",
        "historical-result",
        "distribution-readiness"
       ]
      }
     },
     "required": [
      "id",
      "type",
      "captured_at",
      "source_url",
      "observed"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "objective": {
    "enum": [
     "qualified-demand",
     "revenue",
     "retention",
     "validated-learning"
    ]
   },
   "observed_at": {
    "format": "date-time",
    "type": "string"
   }
  },
  "required": [
   "observed_at",
   "objective",
   "constraints",
   "evidence",
   "channels"
  ],
  "type": "object"
 },
 "name": "justhandled_channel_fit_evidence_matrix"
}

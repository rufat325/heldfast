{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Place an image or video asset onto a BlitzReels project timeline at a timestamp, including B-roll and static images.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "allowDuplicate": {
    "default": true,
    "description": "Allow inserting the same asset more than once",
    "type": "boolean"
   },
   "animationPreset": {
    "default": "none",
    "description": "Optional visual animation preset",
    "enum": [
     "none",
     "fadeIn",
     "fadeOut",
     "zoomIn",
     "zoomOut",
     "slideLeft",
     "slideRight",
     "slideUp",
     "slideDown",
     "popIn",
     "bounce",
     "spin"
    ],
    "type": "string"
   },
   "assetId": {
    "description": "Image or video media asset ID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "durationSeconds": {
    "description": "Duration in seconds. Required for still images when a specific length is needed.",
    "minimum": 0,
    "type": "number"
   },
   "layerIndex": {
    "description": "Exact timeline layer to use. Lower layer numbers render on top. Omit for intent-based placement.",
    "minimum": 0,
    "type": "number"
   },
   "placementIntent": {
    "default": "overlay",
    "description": "Layer intent used when layerIndex is omitted. Use overlay for visible B-roll/logo/sticker over video, background for behind video, exact when layerIndex is supplied.",
    "enum": [
     "overlay",
     "background",
     "exact"
    ],
    "type": "string"
   },
   "positionPreset": {
    "default": "fullscreen",
    "description": "Visual placement preset",
    "enum": [
     "center",
     "fullscreen",
     "pip-top-left",
     "pip-top-right",
     "pip-bottom-left",
     "pip-bottom-right"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "BlitzReels project ID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "startSeconds": {
    "default": 0,
    "description": "Timeline start time in seconds",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "projectId",
   "assetId"
  ],
  "type": "object"
 },
 "name": "timeline_media_add",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Add Media To Timeline"
}

{
 "_meta": {},
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List builds"
 },
 "description": "List builds for an app (optionally filter by version)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filter.app": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Filter by app ID(s) (required)"
   },
   "filter.id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Filter by build ID(s)"
   },
   "filter.preReleaseVersion": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Filter by pre-release version ID(s)"
   },
   "filter.preReleaseVersion.platform": {
    "anyOf": [
     {
      "enum": [
       "IOS",
       "MAC_OS",
       "TV_OS",
       "VISION_OS"
      ],
      "type": "string"
     },
     {
      "items": {
       "enum": [
        "IOS",
        "MAC_OS",
        "TV_OS",
        "VISION_OS"
       ],
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Filter by pre-release platform(s)"
   },
   "filter.processingState": {
    "anyOf": [
     {
      "enum": [
       "PROCESSING",
       "FAILED",
       "INVALID",
       "VALID"
      ],
      "type": "string"
     },
     {
      "items": {
       "enum": [
        "PROCESSING",
        "FAILED",
        "INVALID",
        "VALID"
       ],
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Filter by processing state(s)"
   },
   "filter.version": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Filter by build version string(s)"
   },
   "limit": {
    "default": 50,
    "description": "Maximum number of builds to return (default 50, max 200)",
    "type": "number"
   }
  },
  "required": [
   "filter.app"
  ],
  "type": "object"
 },
 "name": "list-builds",
 "title": "List builds"
}

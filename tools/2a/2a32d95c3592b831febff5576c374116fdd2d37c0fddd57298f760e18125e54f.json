{
 "description": "Tag a local container image with a new name/tag \u2014 useful to retag before pushing to ICR",
 "inputSchema": {
  "properties": {
   "runtime": {
    "description": "Container runtime (default: auto-detected)",
    "enum": [
     "docker",
     "podman"
    ],
    "type": "string"
   },
   "source_image": {
    "description": "Existing image name/tag (e.g. myapp:latest)",
    "type": "string"
   },
   "target_image": {
    "description": "New image name/tag (e.g. us.icr.io/mynamespace/myapp:v1.0.0)",
    "type": "string"
   }
  },
  "required": [
   "source_image",
   "target_image"
  ],
  "type": "object"
 },
 "name": "tag_container_image"
}

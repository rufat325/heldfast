{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add a visual debug helper to a scene object. Types: box, axes, skeleton, arrow, grid, polar_grid, camera, directional_light, spot_light, point_light, hemisphere_light, plane\n\nDebug only \u2014 page reload will reset. No code changes needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "Color as hex number (default: 0x00ff00)",
    "type": "number"
   },
   "direction": {
    "description": "[x, y, z] direction for ArrowHelper/PlaneHelper",
    "items": {
     "type": "number"
    },
    "maxItems": 3,
    "minItems": 3,
    "type": "array"
   },
   "divisions": {
    "description": "Grid divisions (GridHelper, default: 10)",
    "type": "number"
   },
   "length": {
    "description": "Arrow length (ArrowHelper, default: 1)",
    "type": "number"
   },
   "origin": {
    "description": "[x, y, z] origin for ArrowHelper",
    "items": {
     "type": "number"
    },
    "maxItems": 3,
    "minItems": 3,
    "type": "array"
   },
   "size": {
    "description": "Size for AxesHelper/GridHelper/LightHelpers (default: 1)",
    "type": "number"
   },
   "target": {
    "description": "Target object name",
    "type": "string"
   },
   "targetUuid": {
    "description": "Target object UUID",
    "type": "string"
   },
   "type": {
    "description": "Helper type (default: box)",
    "enum": [
     "box",
     "axes",
     "skeleton",
     "arrow",
     "grid",
     "polar_grid",
     "camera",
     "directional_light",
     "spot_light",
     "point_light",
     "hemisphere_light",
     "plane"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "add_helper"
}

{
 "description": "List TikTok Shop products by category with exact prices. Paginate with next_cursor/has_more. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category_id": {
    "description": "Category ID from get_tiktok_shop_categories.",
    "pattern": "^\\d{4,20}$",
    "type": "string"
   },
   "cursor": {
    "description": "Pagination cursor from previous response.",
    "type": "string"
   },
   "region": {
    "description": "US (default) or GB only.",
    "enum": [
     "US",
     "GB"
    ],
    "type": "string"
   }
  },
  "required": [
   "category_id"
  ],
  "type": "object"
 },
 "name": "get_tiktok_shop_category_products"
}

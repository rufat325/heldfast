{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Rank African countries by a specific indicator for a given year \u2014 great for comparisons",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 10,
    "description": "Number of results",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "metric_key": {
    "description": "Indicator key (e.g. \"gdp_current_usd\", \"population_total\")",
    "type": "string"
   },
   "order": {
    "default": "desc",
    "description": "Sort order",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "source": {
    "description": "Source code filter",
    "type": "string"
   },
   "year": {
    "description": "Year to rank by",
    "maximum": 2200,
    "minimum": 1900,
    "type": "integer"
   }
  },
  "required": [
   "metric_key",
   "year"
  ],
  "type": "object"
 },
 "name": "get_indicator_rankings"
}

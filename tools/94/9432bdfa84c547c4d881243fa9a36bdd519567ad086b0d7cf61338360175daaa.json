{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Replace explicit producer-approved birth-history settings. Never invent biological interval defaults; an empty birth_windows array means no planned windows.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "farm_id": {
    "description": "Farm UUID; defaults to the active farm.",
    "format": "uuid",
    "type": "string"
   },
   "settings": {
    "additionalProperties": false,
    "properties": {
     "birth_windows": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "end_date": {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        "label": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        "start_date": {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        }
       },
       "required": [
        "label",
        "start_date",
        "end_date"
       ],
       "type": "object"
      },
      "maxItems": 40,
      "type": "array"
     },
     "gestation_days": {
      "additionalProperties": false,
      "properties": {
       "max": {
        "maximum": 2000,
        "minimum": 1,
        "type": "integer"
       },
       "min": {
        "maximum": 2000,
        "minimum": 1,
        "type": "integer"
       }
      },
      "required": [
       "min",
       "max"
      ],
      "type": "object"
     },
     "minimum_sire_age_days": {
      "maximum": 10000,
      "minimum": 1,
      "type": "integer"
     },
     "species": {
      "enum": [
       "BISON",
       "CATTLE",
       "ELK",
       "GOAT",
       "HORSE",
       "OTHER",
       "SHEEP"
      ],
      "type": "string"
     },
     "version": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "version",
     "species"
    ],
    "type": "object"
   }
  },
  "required": [
   "settings"
  ],
  "type": "object"
 },
 "name": "set_birth_history_settings"
}

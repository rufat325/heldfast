{
 "description": "Non-interactive wallet bootstrap for MCP hosts. fresh = new wallet + LLM vault. llm_only = wallet exists, add LLM only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_name": {
    "description": "Agent display name (default Tychi)",
    "type": "string"
   },
   "llm_api_key": {
    "description": "Provider API key \u2014 stored encrypted on brain",
    "type": "string"
   },
   "llm_provider": {
    "description": "LLM provider for brain chat",
    "enum": [
     "anthropic",
     "gemini",
     "openai",
     "groq"
    ],
    "type": "string"
   },
   "mnemonic": {
    "description": "Optional BIP39 import instead of new wallet (fresh mode only)",
    "type": "string"
   },
   "password": {
    "description": "Keystore password (operator-provided)",
    "type": "string"
   }
  },
  "required": [
   "password",
   "llm_provider",
   "llm_api_key"
  ],
  "type": "object"
 },
 "name": "tyi_onboard"
}

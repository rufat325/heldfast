{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch any economic time series by ID (e.g., \"CPUR0000SA0\" for CPI, \"LNS14000000\" for unemployment). Returns historical data points with dates and values.",
 "inputSchema": {
  "examples": [
   {
    "series_id": "CUUR0000SA0"
   },
   {
    "end_year": "2024",
    "series_id": "LNS14000000",
    "start_year": "2020"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "Optional BLS registration key (free, raises the daily cap from ~25 to 500). The gateway supplies a platform key; pass your own only to override.",
    "type": "string"
   },
   "end_year": {
    "description": "End year as 4-digit string (e.g. \"2024\"). Optional.",
    "type": "string"
   },
   "series_id": {
    "description": "BLS series ID (e.g. \"CUUR0000SA0\" for CPI)",
    "type": "string"
   },
   "start_year": {
    "description": "Start year as 4-digit string (e.g. \"2020\"). Optional.",
    "type": "string"
   }
  },
  "required": [
   "series_id"
  ],
  "type": "object"
 },
 "name": "get_series",
 "outputSchema": {
  "properties": {
   "data": {
    "description": "Time series data points",
    "items": {
     "properties": {
      "period": {
       "description": "Period code (e.g., M01 for January)",
       "type": "string"
      },
      "period_name": {
       "description": "Human-readable period name (e.g., January)",
       "type": "string"
      },
      "value": {
       "description": "Numeric value for the period",
       "type": [
        "number",
        "null"
       ]
      },
      "year": {
       "description": "Year of the data point",
       "type": "string"
      }
     },
     "required": [
      "year",
      "period",
      "period_name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "end_year": {
    "description": "End year filter if provided, null otherwise",
    "type": [
     "string",
     "null"
    ]
   },
   "observation_order": {
    "description": "Order of the `data` array. BLS returns each series newest-first.",
    "enum": [
     "newest_first"
    ],
    "type": "string"
   },
   "returned": {
    "description": "How many data points are in `data`. Always equal to `total` here; stated so a caller need not assume it.",
    "type": "integer"
   },
   "series_id": {
    "description": "BLS series ID requested",
    "type": "string"
   },
   "start_year": {
    "description": "Start year filter if provided, null otherwise",
    "type": [
     "string",
     "null"
    ]
   },
   "total": {
    "description": "Number of data points returned. Equal to `returned` \u2014 BLS returns every point in the requested year range.",
    "type": "integer"
   }
  },
  "required": [
   "series_id",
   "start_year",
   "end_year",
   "total",
   "data"
  ],
  "type": "object"
 },
 "title": "Get Series",
 "version": "v1.8560f916"
}

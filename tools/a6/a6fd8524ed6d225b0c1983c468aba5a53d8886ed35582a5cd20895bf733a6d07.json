{
 "description": "Register a new test device for development/ad-hoc provisioning.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Device name (e.g., \"Mali iPhone 15\")",
    "type": "string"
   },
   "platform": {
    "default": "IOS",
    "description": "Platform",
    "enum": [
     "IOS",
     "MAC_OS"
    ],
    "type": "string"
   },
   "udid": {
    "description": "Device UDID",
    "type": "string"
   }
  },
  "required": [
   "name",
   "udid"
  ],
  "type": "object"
 },
 "name": "asc_register_device"
}

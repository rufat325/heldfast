         "examples": [
          1834520.5
         ],
         "type": [
          "number",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "question",
        "implied_probabilities"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "note": {

  "title": "Prediction market probabilities"
 },
 "description": "Prediction market odds from Polymarket: live markets and the probability each outcome currently implies, as percentages rather than raw prices. Search by topic or take the highest-volume markets. Input: optional query and limit. Use prediction.market for one market by slug, prediction.events for event groupings. $0.05 per call. Returns: markets[] with question, implied_probabilities[], volume, end_date.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "1-50, default 10.",
    "type": "integer"
   },
   "query": {
    "description": "Topic to match (optional).",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "hubvibe_market_prediction",
 "outputSchema": {

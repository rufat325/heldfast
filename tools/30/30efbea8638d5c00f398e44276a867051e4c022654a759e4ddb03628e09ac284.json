{
 "description": "List recent security scans for the active organization. Optionally filter by repository. Paginated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Filter by repository name or fullName.",
    "type": "string"
   },
   "page": {
    "description": "Page number (default 1).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "pageSize": {
    "description": "Results per page (default 5, max 50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "repositoryId": {
    "description": "Filter by repository id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_security_scans"
}

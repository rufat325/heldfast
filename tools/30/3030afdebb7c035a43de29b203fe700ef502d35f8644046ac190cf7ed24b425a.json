 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "owner": {
    "description": "Repository owner (user or org)",
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "ref": {
    "description": "Branch, tag, or commit SHA",
    "type": "string"
   },
   "repo": {
    "description": "Repository name",
    "type": "string"
   }
  },
  "required": [

{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Session Status"
 },
 "description": "Look up the on-chain status of one payment channel by channel_id. Use for 'is my session settled yet?' checks; use create_session to open one. Returns {sessionId, buyer, seller, status, channelBalance, settledAmountUsdc, settled, openedAt, closedAt}. v1 paginates /api/channels client-side because there is no per-channel endpoint yet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "sessionId": {
    "description": "Channel ID (bytes32 hex, e.g. 0xabc...)",
    "type": "string"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "get_session_status",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "buyer": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": [
     "string",
     "null"
    ]
   },
   "channelBalance": {
    "description": "Max deposit, USDC",
    "type": [
     "number",
     "null"
    ]
   },
   "closedAt": {
    "description": "ISO timestamp; only when settled",
    "type": [
     "string",
     "null"
    ]
   },
   "eventCount": {
    "type": "integer"
   },
   "openedAt": {
    "description": "ISO timestamp",
    "type": [
     "string",
     "null"
    ]
   },
   "seller": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": [
     "string",
     "null"
    ]
   },
   "sessionId": {
    "pattern": "^0x[0-9a-fA-F]{1,128}$",
    "type": "string"
   },
   "settled": {
    "type": "boolean"
   },
   "settledAmountUsdc": {
    "type": [
     "number",
     "null"
    ]
   },
   "status": {
    "description": "Channel state (e.g. 'Open', 'Settled')",
    "type": "string"
   },
   "totalDeltaUsdc": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "sessionId",
   "buyer",
   "seller",
   "status",
   "channelBalance",
   "settledAmountUsdc",
   "totalDeltaUsdc",
   "eventCount",
   "settled",
   "openedAt",
   "closedAt"
  ],
  "type": "object"
 }
}

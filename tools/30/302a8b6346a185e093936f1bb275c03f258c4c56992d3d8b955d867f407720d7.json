{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Consultar el resultado de un veredicto pedido"
 },
 "description": "Gratis. Pollea el estado de un ticket creado con ask_human_verdict \u2014 \"pending\" mientras la persona todav\u00eda no contest\u00f3, \"completed\" con el veredicto, o \"expired\" si pasaron 7 d\u00edas sin respuesta.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "resultToken": {
    "description": "El resultToken devuelto por ask_human_verdict",
    "minLength": 1,
    "type": "string"
   },
   "ticket": {
    "description": "El ticket devuelto por ask_human_verdict",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "ticket",
   "resultToken"
  ],
  "type": "object"
 },
 "name": "get_human_verdict",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "answeredAt": {
    "description": "Solo en \"completed\"",
    "type": "string"
   },
   "expiredAt": {
    "description": "Solo en \"expired\"",
    "type": "string"
   },
   "expiresAt": {
    "description": "Solo en \"pending\"",
    "type": "string"
   },
   "freeText": {
    "description": "Solo en \"completed\": el comentario libre, si hubo",
    "type": [
     "string",
     "null"
    ]
   },
   "panel": {
    "additionalProperties": false,
    "description": "Solo en \"completed\": una \u00fanica persona de confianza, no un promedio an\u00f3nimo",
    "properties": {
     "responses": {
      "const": 1,
      "type": "number"
     },
     "type": {
      "const": "single-trusted-human",
      "type": "string"
     }
    },
    "required": [
     "type",
     "responses"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "pending",
     "completed",
     "expired"
    ],
    "type": "string"
   },
   "ticket": {
    "format": "uuid",
    "type": "string"
   },
   "verdict": {
    "description": "Solo en \"completed\": la etiqueta elegida, si hubo",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "status",
   "ticket"
  ],
  "type": "object"
 },
 "title": "Consultar el resultado de un veredicto pedido"
}

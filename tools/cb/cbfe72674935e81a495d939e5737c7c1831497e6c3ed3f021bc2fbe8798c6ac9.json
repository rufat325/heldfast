{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Return the normalized delx-wellness-context/v1 shape merged across all detected sources. Spawns child MCP processes \u2014 requires explicit_user_intent: true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "child_tool": {
    "description": "Child compose mode. series prefers agent-safe-series tools when the connector declares one.",
    "enum": [
     "context",
     "daily_summary",
     "series"
    ],
    "type": "string"
   },
   "explicit_user_intent": {
    "const": true,
    "description": "Required confirmation that the caller is acting on explicit user intent. living_body_ask spawns multiple wellness MCP subprocesses; agents must not call it speculatively.",
    "type": "boolean"
   },
   "privacy_mode": {
    "enum": [
     "summary",
     "structured",
     "raw"
    ],
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "sources": {
    "items": {
     "enum": [
      "whoop",
      "oura",
      "garmin",
      "strava",
      "fitbit",
      "google_health",
      "withings",
      "apple_health",
      "samsung_health",
      "polar",
      "eight_sleep",
      "nourish",
      "air",
      "cycle_coach",
      "cgm"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "explicit_user_intent"
  ],
  "type": "object"
 },
 "name": "living_body_compose_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body_battery": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "context_contract_version": {
    "const": "delx-wellness-context/v1",
    "type": "string"
   },
   "context_type": {
    "const": "composed_wellness_context",
    "type": "string"
   },
   "cycle_phase": {
    "type": "string"
   },
   "generated_at": {
    "type": "string"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "per_source": {
    "additionalProperties": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "recent_training_load": {
    "enum": [
     "low",
     "normal",
     "high",
     "unknown"
    ],
    "type": "string"
   },
   "recommended_handoff": {
    "additionalProperties": false,
    "properties": {
     "reason": {
      "type": "string"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool",
     "reason"
    ],
    "type": "object"
   },
   "recovery_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "sleep_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "source": {
    "const": "delx-living-body",
    "type": "string"
   },
   "sources_failed": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sources_used": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "strain_score": {
    "maximum": 30,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "source",
   "context_contract_version",
   "context_type",
   "generated_at",
   "recent_training_load",
   "per_source",
   "sources_used",
   "sources_failed",
   "notes"
  ],
  "type": "object"
 },
 "title": "Living Body \u2014 Compose Context"
}

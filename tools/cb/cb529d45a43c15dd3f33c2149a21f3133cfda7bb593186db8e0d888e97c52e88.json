{
 "description": "Execute a multi-step action sequence. Supports taps, waits, text input, key presses, and swipes in any order.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_id": {
    "description": "Device ID (optional if only one device)",
    "type": "string"
   },
   "steps": {
    "description": "Steps to execute in order",
    "items": {
     "oneOf": [
      {
       "properties": {
        "action": {
         "const": "tap",
         "type": "string"
        },
        "x": {
         "description": "X coordinate",
         "type": "number"
        },
        "y": {
         "description": "Y coordinate",
         "type": "number"
        }
       },
       "required": [
        "action",
        "x",
        "y"
       ],
       "type": "object"
      },
      {
       "properties": {
        "action": {
         "const": "tap_and_wait",
         "type": "string"
        },
        "wait_ms": {
         "default": 1000,
         "description": "Time to wait after tap in ms (default 1000)",
         "type": "number"
        },
        "x": {
         "description": "X coordinate",
         "type": "number"
        },
        "y": {
         "description": "Y coordinate",
         "type": "number"
        }
       },
       "required": [
        "action",
        "x",
        "y"
       ],
       "type": "object"
      },
      {
       "properties": {
        "action": {
         "const": "type_text",
         "type": "string"
        },
        "text": {
         "description": "Text to type into the focused input",
         "type": "string"
        }
       },
       "required": [
        "action",
        "text"
       ],
       "type": "object"
      },
      {
       "properties": {
        "action": {
         "const": "press_key",
         "type": "string"
        },
        "key": {
         "description": "Key to press",
         "enum": [
          "back",
          "home",
          "enter",
          "tab",
          "delete",
          "menu",
          "recent_apps",
          "volume_up",
          "volume_down",
          "power",
          "search",
          "dpad_up",
          "dpad_down",
          "dpad_left",
          "dpad_right",
          "dpad_center"
         ],
         "type": "string"
        }
       },
       "required": [
        "action",
        "key"
       ],
       "type": "object"
      },
      {
       "properties": {
        "action": {
         "const": "swipe",
         "type": "string"
        },
        "duration_ms": {
         "default": 300,
         "description": "Swipe duration in ms (default 300)",
         "type": "number"
        },
        "x1": {
         "description": "Start X",
         "type": "number"
        },
        "x2": {
         "description": "End X",
         "type": "number"
        },
        "y1": {
         "description": "Start Y",
         "type": "number"
        },
        "y2": {
         "description": "End Y",
         "type": "number"
        }
       },
       "required": [
        "action",
        "x1",
        "y1",
        "x2",
        "y2"
       ],
       "type": "object"
      },
      {
       "properties": {
        "action": {
         "const": "pause",
         "type": "string"
        },
        "ms": {
         "description": "Pause duration in milliseconds",
         "type": "number"
        }
       },
       "required": [
        "action",
        "ms"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   }
  },
  "required": [
   "steps"
  ],
  "type": "object"
 },
 "name": "tap_sequence"
}

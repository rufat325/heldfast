{
 "_meta": {
  "ufcalendar/authless": false,
  "ufcalendar/endpoint": "GET /v1/scorecards/splits",
  "ufcalendar/tier": "plan"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List split and majority decisions"
 },
 "description": "Completed bouts decided on split or majority cards, newest first, with every judge's official card and the dissenting judge named \u2014 commission records only, across covered promotions or one of them, in a date range. Facts as filed; UFCalendar adds no verdict of its own.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "meta.pagination.next_cursor from a previous call.",
    "type": "string"
   },
   "from": {
    "description": "Earliest event date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Rows per page, default 25.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "org": {
    "description": "Promotion slug, e.g. \"ufc\". Omit for every covered promotion.",
    "enum": [
     "ufc",
     "pfl",
     "oktagon",
     "bkfc",
     "rizin"
    ],
    "type": "string"
   },
   "to": {
    "description": "Latest event date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_split_decisions",
 "title": "List split and majority decisions"
}

{
 "description": "Create a persistent cron schedule for recurring Jules sessions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "autoApprove": {
    "default": true,
    "type": "boolean"
   },
   "autoCreatePR": {
    "default": false,
    "type": "boolean"
   },
   "branch": {
    "default": "main",
    "type": "string"
   },
   "cron": {
    "description": "Cron expression",
    "type": "string"
   },
   "prompt": {
    "type": "string"
   },
   "repoName": {
    "type": "string"
   },
   "repoOwner": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "cron",
   "repoOwner",
   "repoName",
   "prompt"
  ],
  "type": "object"
 },
 "name": "jules_schedule_recurring_session",
 "title": "Schedule Recurring Jules Session"
}

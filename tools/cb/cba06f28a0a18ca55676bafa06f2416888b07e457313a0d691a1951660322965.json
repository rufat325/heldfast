 "description": "Search Foursquare places (keyless \u2014 Pipeworx supplies the key). Combine `query` (e.g., \"coffee\", \"hardware store\") with a location anchor \u2014 either `near` (\"Brooklyn, NY\", \"San Francisco, CA\") or `latitude`+`longitude`. sort:\"RATING\" orders results by Foursquare rating (best first); the rating NUMBER itself is a Foursquare Premium field and is returned only where enabled \u2014 check `rating_included` / `rating_reason` in the response, and read `rating_note` before telling a caller a place is unrated. Returns name, fsq_place_id, categories, address, distance, lat/lon, tel, website.",
 "inputSchema": {
  "examples": [
   {
    "limit": 10,
    "near": "San Francisco, CA",
    "query": "coffee",
    "sort": "RATING"
   },
   {
    "limit": 10,
    "near": "Brooklyn, NY",
    "query": "coffee",
    "sort": "RELEVANCE"
   },
   {
    "latitude": 40.7128,
    "limit": 20,
    "longitude": -74.006,
    "query": "hardware store",
    "radius_m": 1000,
    "sort": "DISTANCE"
   }
  ],
  "properties": {
   "categories": {
    "description": "OPTIONAL. Comma-separated numeric fsq_category_id values ONLY (e.g. from a prior search_places result). Do NOT invent IDs or pass category names \u2014 use the `query` text for that (e.g. query:\"coffee\"). Unknown IDs are ignored.",
    "type": "string"
   },
   "latitude": {
    "description": "Center latitude (pair with longitude)",
    "type": "number"
   },
   "limit": {
    "description": "Results (1-50, default 10)",
    "type": "number"
   },
   "longitude": {
    "description": "Center longitude",
    "type": "number"
   },
   "near": {
    "description": "Place name anchor (\"Brooklyn, NY\", \"Tokyo\")",
    "type": "string"
   },
   "query": {
    "description": "Free-text query",
    "type": "string"
   },
   "radius_m": {
    "description": "1-100000 metres (only with lat/lon)",
    "type": "number"
   },
   "sort": {
    "description": "RELEVANCE (default) | DISTANCE | RATING | POPULARITY",
    "enum": [
     "RELEVANCE",
     "DISTANCE",
     "RATING",
     "POPULARITY"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },

{
 "description": "Search all Elementor pages for specific widgets, settings, or text content",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contains": {
    "default": "",
    "description": "Text to search for in setting values",
    "type": "string"
   },
   "per_page": {
    "default": 50,
    "description": "Max results",
    "type": "number"
   },
   "post_type": {
    "default": "any",
    "description": "Limit to specific post type",
    "type": "string"
   },
   "setting": {
    "default": "",
    "description": "Setting key to search in",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "widget_type": {
    "default": "",
    "description": "Filter by widget type (heading, button, image, etc.)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "mcp_search_elementor"
}

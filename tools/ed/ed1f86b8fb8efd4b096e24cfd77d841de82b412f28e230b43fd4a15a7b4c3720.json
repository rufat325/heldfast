{
 "description": "Get flat list of all Elementor elements on a page (easier to search/filter than tree)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "el_type": {
    "default": "",
    "description": "Filter by element type (container, widget)",
    "type": "string"
   },
   "fields": {
    "default": "",
    "description": "Comma-separated setting keys to include",
    "type": "string"
   },
   "id": {
    "description": "Post/page ID",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "widget_type": {
    "default": "",
    "description": "Filter by widget type (heading, button, image, etc.)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "mcp_get_elementor_flat"
}

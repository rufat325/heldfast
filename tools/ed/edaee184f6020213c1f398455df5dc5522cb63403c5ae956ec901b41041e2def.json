  "readOnlyHint": false
 },
 "description": "Create a page/screen in a VibeMap project's page inventory. Author pages after features, stories, and criteria to capture the app's screens and routes. Existing pages are visible via vibemap_get_project_context \u2014 enrich, don't duplicate.",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "What this page is for",
    "type": "string"
   },
   "name": {
    "description": "Page name (e.g. 'Dashboard')",
    "type": "string"
   },
   "path": {
    "description": "Route path (e.g. '/dashboard')",
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "status": {
    "default": "draft",
    "enum": [
     "draft",
     "confirmed"
    ],
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "name"
  ],
  "type": "object"
 },
 "name": "vibemap_create_page"
}

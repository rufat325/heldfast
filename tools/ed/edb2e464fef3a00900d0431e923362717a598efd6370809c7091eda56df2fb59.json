{
 "description": "Send an email using an email template Id. You can optionally provide <code>requestData</code> to access key value pairs in the email template.",
 "inputSchema": {
  "properties": {
   "emailTemplateId": {
    "description": "The Id for the template.",
    "type": "string"
   },
   "requestBody": {
    "description": "The JSON request body.",
    "properties": {
     "applicationId": {
      "format": "uuid",
      "type": "string"
     },
     "bccAddresses": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "ccAddresses": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "preferredLanguages": {
      "items": {
       "description": "A Locale object represents a specific geographical, political, or cultural region.",
       "type": "string"
      },
      "type": "array"
     },
     "requestData": {
      "additionalProperties": {
       "type": "object"
      },
      "type": "object"
     },
     "toAddresses": {
      "items": {
       "description": "An email address.",
       "properties": {
        "address": {
         "type": "string"
        },
        "display": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "userIds": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "emailTemplateId"
  ],
  "type": "object"
 },
 "name": "sendEmailWithId"
}

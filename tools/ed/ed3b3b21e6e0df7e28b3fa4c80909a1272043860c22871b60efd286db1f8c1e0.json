{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Analyze schedule timing"
 },
 "description": "Put a program on the clock: each step's start and end, total length, the critical path and what gates it, resource conflicts, slack per track. Pass finishAt to answer 'when do I start X so everything is ready at 6pm?'. Pure computation. With `history` (or `program_id`) it also predicts durations from recorded runs; see rhylthyme://guide/tools.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "finishAt": {
    "description": "ISO 8601 datetime everything must END at, e.g. '2026-11-26T18:00:00-05:00'. Start times are worked backwards from it.",
    "type": "string"
   },
   "history": {
    "description": "Recorded runs of this program (from load_run); adds predicted durations.",
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "predictionContext": {
    "additionalProperties": {},
    "description": "Optional: environmentId, userTags (variance factors), userId, programVersion, minIdentical, minModel, corrThreshold, verdicts. See rhylthyme://guide/tools.",
    "properties": {},
    "type": "object"
   },
   "program": {
    "additionalProperties": {},
    "description": "Program JSON; shape under validate_program.",
    "properties": {},
    "type": "object"
   },
   "program_id": {
    "description": "Saved program UUID: loads the user's own recorded runs as the history.",
    "type": "string"
   },
   "startAt": {
    "description": "ISO 8601 start datetime. Ignored with finishAt.",
    "type": "string"
   },
   "token": {
    "description": "Access token from the login tool. Omit when the account is connected.",
    "type": "string"
   },
   "useDurations": {
    "default": "planned",
    "description": "planned (default): analyse the program as authored. predicted: as the history says it will run.",
    "enum": [
     "planned",
     "predicted"
    ],
    "type": "string"
   }
  },
  "required": [
   "program"
  ],
  "type": "object"
 },
 "name": "analyze_schedule",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "actorPeak": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "bindingConstraints": {
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "criticalPath": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "durationsUsed": {
    "type": "string"
   },
   "inFlight": {
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "makespan": {
    "type": "string"
   },
   "makespanSeconds": {
    "type": "number"
   },
   "name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "plannedMakespan": {
    "type": "string"
   },
   "plannedMakespanSeconds": {
    "type": "number"
   },
   "predictedCriticalPath": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "predictedMakespan": {
    "type": "string"
   },
   "predictedMakespanSeconds": {
    "type": "number"
   },
   "programId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "resourceConflicts": {
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "steps": {

   },
   "tracks": {
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "validation": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "wallClock": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "programId",
   "name",
   "makespanSeconds",
   "makespan",
   "tracks",
   "steps",
   "criticalPath",
   "resourceConflicts",
   "actorPeak",
   "wallClock"
  ],
  "type": "object"
 },
 "title": "Analyze schedule timing"
}

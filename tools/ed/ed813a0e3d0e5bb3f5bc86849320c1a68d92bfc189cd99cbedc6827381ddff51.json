{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get institutional buying/selling activity trend for a stock over multiple quarters. Shows how many institutions are buying vs selling, net share changes, and value flows \u2014 useful for detecting accumulation or distribution patterns. Plan limits: Free/keyless access covers the latest 13F quarter only; the multi-quarter trend requires Pro. Omit `quarters` to get the most your plan allows. structuredContent carries the exact net shares/values.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "quarters": {
    "description": "Number of quarters to return. Omit for the plan default (Pro: 8 = 2 years; Free/keyless: the latest quarter only). An explicit value above what your plan allows returns a plan-limit error.",
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   },
   "ticker": {
    "description": "Stock ticker symbol",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "get_stock_activity",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "latest": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "institutions_decreased": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "institutions_exited": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "institutions_increased": {
        "anyOf": [
         {
          "$ref": "#/properties/quarters_requested/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "institutions_new": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "institutions_total": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "net_shares": {
        "anyOf": [
         {
          "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
       },
       "net_value": {
        "$ref": "#/properties/latest/anyOf/0/properties/net_shares"
       },
       "quarter": {
        "type": [
         "string",
         "null"
        ]
       },
       "shares_added": {
        "$ref": "#/properties/latest/anyOf/0/properties/net_shares"
       },
       "shares_removed": {
        "$ref": "#/properties/latest/anyOf/0/properties/net_shares"
       },
       "value_added": {
        "$ref": "#/properties/latest/anyOf/0/properties/net_shares"
       },
       "value_removed": {
        "$ref": "#/properties/latest/anyOf/0/properties/net_shares"
       }
      },
      "required": [
       "quarter",
       "institutions_increased",
       "institutions_decreased",
       "institutions_new",
       "institutions_exited",
       "net_shares",
       "net_value",
       "institutions_total",
       "shares_added",
       "shares_removed",
       "value_added",
       "value_removed"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "plan_limit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "continuation": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "date_basis": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "effective_period": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "policy_version": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "row_cap": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "truncated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "window_end": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "window_start": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       }
      },
      "required": [
       "policy_version",
       "window_start",
       "window_end",
       "effective_period",
       "date_basis",
       "row_cap",
       "truncated",
       "continuation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The Free/keyless plan limits ko.io applied to this answer (null for paid callers)"
   },
   "plan_note": {
    "description": "Set when the plan limited how many quarters were returned",
    "type": [
     "string",
     "null"
    ]
   },
   "quarters_requested": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "null = the plan default was used"
   },
   "quarters_returned": {
    "type": "integer"
   },
   "ticker": {
    "type": "string"
   },
   "trend": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "institutions_decreased": {
       "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
      },
      "institutions_exited": {
       "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
      },
      "institutions_increased": {
       "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
      },
      "institutions_new": {
       "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
      },
      "net_shares": {
       "$ref": "#/properties/latest/anyOf/0/properties/net_shares"
      },
      "net_value": {
       "$ref": "#/properties/latest/anyOf/0/properties/net_shares"
      },
      "quarter": {
       "$ref": "#/properties/latest/anyOf/0/properties/quarter"
      }
     },
     "required": [
      "quarter",
      "institutions_increased",
      "institutions_decreased",
      "institutions_new",
      "institutions_exited",
      "net_shares",
      "net_value"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ticker",
   "quarters_requested",
   "quarters_returned",
   "latest",
   "trend",
   "plan_note",
   "plan_limit"
  ],
  "type": "object"
 }
}

{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Extract structured fields from a web page using a CSS selector schema. Accepts a URL and CSS schema.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "context": {
    "description": "Describe the user's underlying goal in one sentence \u2014 not the tool you are calling.",
    "type": "string"
   },
   "conversation_id": {
    "description": "Echo the conversation_id from the server's previous response. The server provides it on the first call \u2014 never invent one, and do not issue parallel tool calls until you have it.",
    "type": "string"
   },
   "limit": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "link": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "llm_model": {
    "description": "The exact model identifier you (the assistant) are running as, taken from your system prompt or environment (e.g. \"claude-opus-4-8\", \"gpt-5.2\"). Used for analytics only. If you do not know your model identifier with certainty, pass \"unknown\" \u2014 never guess.",
    "type": "string"
   },
   "maxResults": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "max_results": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "offset": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "pageSize": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "path": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "permalink": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "scanFullPage": {
    "description": "When true, scroll the page to load dynamically appended content.",
    "type": "boolean"
   },
   "schema": {
    "description": "Crawl4AI JsonCssExtractionStrategy schema: baseSelector plus fields.",
    "properties": {
     "baseSelector": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
     },
     "fields": {
      "items": {
       "description": "One CSS extraction field.",
       "properties": {
        "attribute": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "name": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "selector": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "default": "text",
         "enum": [
          "text",
          "attribute",
          "html",
          "regex"
         ],
         "type": "string"
        }
       },
       "required": [
        "name",
        "selector"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "name",
     "baseSelector",
     "fields"
    ],
    "type": "object"
   },
   "trim": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "tweetId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "tweetUrl": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "tweet_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "tweet_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "url": {
    "description": "Web page URL to fetch.",
    "maxLength": 2083,
    "minLength": 1,
    "type": "string"
   },
   "waitFor": {
    "description": "Wait for a CSS selector before extraction. Must be prefixed with \"css:\" (e.g. css:main). JavaScript wait conditions are not supported.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "schema",
   "context",
   "llm_model"
  ],
  "type": "object"
 },
 "name": "web_extract_run",
 "title": "Extract structured data from a web page"
}

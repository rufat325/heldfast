{
 "description": "Verify a natural language factual claim. Returns structured verdict with confidence score.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Claim category hint",
    "enum": [
     "financial",
     "entity",
     "geo",
     "product"
    ],
    "type": "string"
   },
   "claim": {
    "description": "Natural language claim to verify",
    "maxLength": 500,
    "type": "string"
   },
   "urgency": {
    "description": "Verification urgency level",
    "enum": [
     "standard",
     "fast",
     "deep"
    ],
    "type": "string"
   }
  },
  "required": [
   "claim"
  ],
  "type": "object"
 },
 "name": "verify_claim"
}

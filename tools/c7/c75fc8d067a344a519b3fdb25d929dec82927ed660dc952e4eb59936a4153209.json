    "instrument": "MODIS",
    "keyword": "sea surface temperature",
    "limit": 10,
    "platform": "Terra"
   },
   {
    "bounding_box": "-125,32,-114,42",
    "keyword": "land cover",
    "limit": 5,
    "temporal_end": "2023-12-31",
    "temporal_start": "2020-01-01"
   }
  ],
  "properties": {
   "bounding_box": {
    "description": "Spatial filter \"minLon,minLat,maxLon,maxLat\", e.g. \"-125,32,-114,42\" for California.",

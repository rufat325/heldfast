{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delete a DNS zone and all of its RRSets permanently. The zone must not be delete-protected.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id_or_name": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^[^/\\s]+$",
      "type": "string"
     }
    ],
    "description": "Zone ID or name"
   }
  },
  "required": [
   "id_or_name"
  ],
  "type": "object"
 },
 "name": "hetzner_delete_zone",
 "title": "Delete DNS Zone"
}

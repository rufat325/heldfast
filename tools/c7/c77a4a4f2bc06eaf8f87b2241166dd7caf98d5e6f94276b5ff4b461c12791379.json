  "title": "Get Market History"
 },
 "description": "Time-series of market-wide hiring stats: total jobs, remote share, compensation, seniority + family distribution, top skills. Analyst tier. Daily resolution back to early March 2026; monthly resolution from March 2026. Use for 'how has the market shifted in 2026?' or 'is remote hiring trending up?'. Not for the current snapshot \u2014 use `get_market_pulse` for that.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "Days of daily history (1-90, default 30). Only used when range='daily'; ignored for range='monthly'.",
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "detail": {
    "description": "'compact' (default) returns a slim per-snapshot series (date, jobs, companies, remote share, median comp) plus full distributions for only the first and latest snapshots \u2014 enough for trend analysis at ~10x less output. 'full' returns every snapshot's complete distributions (seniority, family, top skills); only use when you need per-date distribution detail.",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   },
   "months": {
    "description": "Months of monthly history (1-24, default 12). Only used when range='monthly'; ignored for range='daily'.",
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   },
   "range": {
    "description": "Granularity. 'daily' returns up to 90 days back (rich, recent). 'monthly' returns up to 24 months back (coarser, longer view). Defaults to daily.",
    "enum": [
     "daily",
     "monthly"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },

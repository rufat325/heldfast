 "description": "List French Assembl\u00e9e nationale deputies with party, d\u00e9partement, profession and contact details. Defaults to the 16th legislature (2022\u20132024, 618 deputies) \u2014 NosD\u00e9put\u00e9s never ingested the 17th, so this is a historical record, not the currently sitting chamber.",
 "inputSchema": {
  "examples": [
   {
    "group": "LFI"
   },
   {
    "departement": "Paris",
    "group": "LFI"
   }
  ],
  "properties": {
   "departement": {
    "description": "D\u00e9partement name (matched against `nom_circo`) or 2-3 char code (`num_deptmt`), e.g. \"Paris\" or \"75\".",
    "type": "string"
   },
   "group": {
    "description": "Group acronym, matched against `groupe_sigle`. The 16th legislature uses REN (193), RN (90), LFI (76), LR (62), MODEM (58), HOR (34), SOC (31), GDR (24), LIOT, ECOLO, NI. Call list_groups for the full set.",
    "type": "string"
   },
   "legislature": {
    "description": "16 (2022\u20132024, default) \u00b7 15 (2017\u20132022) \u00b7 14 (2012\u20132017). No 17th exists.",
    "type": "string"
   }
  },
  "type": "object"
 },

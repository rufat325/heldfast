{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search complete repository guides, Swift source, templates and assets offline. Returns compact file matches without loading bodies. Source files and guide code blocks have different verification status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "default": "all",
    "enum": [
     "all",
     "source",
     "guide"
    ],
    "type": "string"
   },
   "limit": {
    "default": 8,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_local_references",
 "title": "Search bundled source and guides"
}

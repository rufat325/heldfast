{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Generate Playwright MCP automation inputs (WASD, mouse-look, clicks) or project/unproject 3D entity coordinates and screen pixels.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform (default: generate_inputs)",
    "type": "string"
   },
   "camera": {
    "description": "Camera state for projection / click-to-move",
    "properties": {
     "far": {
      "description": "Far clipping plane (default: 1000)",
      "type": "number"
     },
     "fov_degrees": {
      "description": "Vertical FOV in degrees (default: 60)",
      "type": "number"
     },
     "near": {
      "description": "Near clipping plane (default: 0.1)",
      "type": "number"
     },
     "orientation": {
      "properties": {
       "pitch": {
        "type": "number"
       },
       "roll": {
        "type": "number"
       },
       "yaw": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "position": {
      "properties": {
       "x": {
        "type": "number"
       },
       "y": {
        "type": "number"
       },
       "z": {
        "type": "number"
       }
      },
      "required": [
       "x",
       "y",
       "z"
      ],
      "type": "object"
     },
     "projection_type": {
      "enum": [
       "perspective",
       "orthographic"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "control_profile": {
    "description": "Game control key bindings and physical parameters",
    "properties": {
     "backward_key": {
      "description": "Key code for backward (default: KeyS)",
      "type": "string"
     },
     "forward_key": {
      "description": "Key code for forward (default: KeyW)",
      "type": "string"
     },
     "jump_key": {
      "description": "Key code for jump (default: Space)",
      "type": "string"
     },
     "mouse_sensitivity": {
      "description": "Mouse sensitivity multiplier (default: 1.0)",
      "type": "number"
     },
     "move_speed": {
      "description": "Movement speed in units/sec (default: 5.0)",
      "type": "number"
     },
     "scheme": {
      "description": "Control scheme (default: wasd)",
      "enum": [
       "wasd",
       "arrows",
       "click_to_move",
       "custom"
      ],
      "type": "string"
     },
     "strafe_left_key": {
      "description": "Key code for strafe left (default: KeyA)",
      "type": "string"
     },
     "strafe_right_key": {
      "description": "Key code for strafe right (default: KeyD)",
      "type": "string"
     },
     "turn_left_key": {
      "description": "Key code for turn left (default: ArrowLeft)",
      "type": "string"
     },
     "turn_right_key": {
      "description": "Key code for turn right (default: ArrowRight)",
      "type": "string"
     },
     "turn_speed": {
      "description": "Turn speed in deg/sec (default: 90.0)",
      "type": "number"
     },
     "use_mouse_look": {
      "description": "Whether to use pointer-lock mouse movements for camera turning",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "current_orientation": {
    "description": "Starting orientation angles",
    "properties": {
     "pitch": {
      "type": "number"
     },
     "roll": {
      "type": "number"
     },
     "yaw": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "current_position": {
    "description": "Starting 3D coordinates (auto-resolved from entity_id if omitted)",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "direction": {
    "description": "Projection direction for projection mode",
    "enum": [
     "world_to_screen",
     "screen_to_world"
    ],
    "type": "string"
   },
   "entity_id": {
    "description": "Player or target entity ID",
    "type": "string"
   },
   "ground_elevation": {
    "description": "Ground plane elevation Y for raycast intercept (default: 0)",
    "type": "number"
   },
   "output_format": {
    "description": "Output format (default: playwright_mcp)",
    "enum": [
     "playwright_mcp",
     "playwright_script",
     "raw_actions"
    ],
    "type": "string"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   },
   "screen_x": {
    "description": "Screen pixel X coordinate for screen_to_world unprojection",
    "type": "number"
   },
   "screen_y": {
    "description": "Screen pixel Y coordinate for screen_to_world unprojection",
    "type": "number"
   },
   "target_entity_id": {
    "description": "Target destination entity ID",
    "type": "string"
   },
   "target_position": {
    "description": "Destination 3D coordinates",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "viewport": {
    "description": "Browser viewport dimensions",
    "properties": {
     "height": {
      "description": "Viewport pixel height (default: 1080)",
      "type": "number"
     },
     "width": {
      "description": "Viewport pixel width (default: 1920)",
      "type": "number"
     }
    },
    "type": "object"
   },
   "waypoints": {
    "description": "Optional intermediate navigation waypoints",
    "items": {
     "properties": {
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      },
      "z": {
       "type": "number"
      }
     },
     "required": [
      "x",
      "y",
      "z"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "world_position": {
    "description": "3D world position for projection or starting point",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "generate_game_inputs"
}

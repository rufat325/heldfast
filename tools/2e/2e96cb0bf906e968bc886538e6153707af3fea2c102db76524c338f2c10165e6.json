{
 "description": "Bulk-record up to 20 leased, batch-bound review or user-confirmed outcomes. Before handoff every item uses literal outcome=review_ready and every recorded run must return awaiting_manual_submit. After manual confirmation use literal outcome=submitted. Each member returns recorded or a stable conflict without hiding sibling results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "Briefly explain why this tool helps the current job-search goal. Never include resume text, profile answers, demographic or work-authorization answers, application notes, credentials, or secrets.",
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 16,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "outcomes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "batchId": {
       "minimum": 1,
       "type": "integer"
      },
      "confirmation": {
       "enum": [
        "user_confirmation",
        "success_page"
       ],
       "type": "string"
      },
      "inspectionEpoch": {
       "minimum": 0,
       "type": "integer"
      },
      "leaseToken": {
       "maxLength": 1024,
       "minLength": 1,
       "type": "string"
      },
      "memberId": {
       "minimum": 1,
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "review_ready",
        "submitted",
        "failed",
        "blocked"
       ],
       "type": "string"
      },
      "runId": {
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "runId",
      "batchId",
      "memberId",
      "inspectionEpoch",
      "leaseToken",
      "outcome"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "idempotencyKey",
   "outcomes"
  ],
  "type": "object"
 },
 "name": "trackly_record_application_outcomes"
}

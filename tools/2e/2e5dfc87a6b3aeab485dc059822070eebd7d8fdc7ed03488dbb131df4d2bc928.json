{
 "description": "Resolve a person to an AnchorID using email, name, company domain, or external identifiers (Slack/Google user IDs). Returns status (resolved | needs_review | not_found), confidence score, the canonical AnchorID, match reasons, and any ambiguous candidates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "company_domain": {
    "description": "Company domain for name+company matching",
    "type": "string"
   },
   "company_entity_id": {
    "description": "Resolved company AnchorID (UUID) for name+company matching",
    "type": "string"
   },
   "email": {
    "description": "Person's email address",
    "type": "string"
   },
   "identifiers": {
    "additionalProperties": false,
    "description": "External system identifiers",
    "properties": {
     "google_user_id": {
      "type": "string"
     },
     "hubspot_contact_id": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "salesforce_contact_id": {
      "type": "string"
     },
     "slack_user_id": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "min_confidence": {
    "description": "Minimum confidence threshold (0-1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "name": {
    "description": "Person's full name",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "resolve_person"
}

 "description": "MUTATES where the user is now: profiles.location + polaris current_city/country (same as in-app Dayze chat). Pass location (\"The Madeira, Singapore\") and/or city+country; optional place/venue + lat/lon records a fresh location_visits check-in so get_location_context returns is_current. set_home defaults true; check_in defaults true when place or coordinates are set. Does not invent GPS when omitted. ($0.10; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "check_in": {
    "description": "Write a location_visits row when place or coordinates are set (default true in that case)",
    "type": "boolean"
   },
   "city": {
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "idempotency_key": {
    "type": "string"
   },
   "latitude": {
    "type": "number"
   },
   "location": {
    "description": "Freeform \u201cCity, Country\u201d or \u201cVenue, City, Country\u201d",
    "type": "string"
   },
   "longitude": {
    "type": "number"
   },
   "place": {
    "description": "Venue / residence name (e.g. The Madeira)",
    "type": "string"
   },
   "request_id": {
    "type": "string"
   },
   "set_home": {
    "description": "Also write profiles.location / home_location (default true)",
    "type": "boolean"
   },
   "venue": {
    "description": "Alias for place",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_current_location",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "check_in": {
    "type": "boolean"
   },
   "context": {
    "additionalProperties": true,
    "description": "Fresh get_location_context after write.",
    "type": "object"
   },
   "current_city": {
    "type": [
     "string",
     "null"
    ]
   },
   "current_country": {
    "type": [
     "string",
     "null"
    ]
   },
   "location": {
    "type": [
     "string",
     "null"
    ]
   },
   "message": {
    "type": "string"
   },
   "place": {
    "type": [
     "string",
     "null"
    ]
   },
   "set_home": {
    "type": "boolean"
   },
   "updated": {
    "type": "boolean"
   },
   "visit_id": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "readOnlyHint": false,

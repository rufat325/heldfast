{
 "description": "Create a new token on Printr. Returns an UNSIGNED transaction payload that must be signed by the creator's wallet and submitted on-chain. The payload will be EVM calldata or Solana instructions depending on the home chain. You need separate wallet infrastructure to sign and submit the transaction. Use printr_quote first to estimate costs. Supply image (base64) or image_path (local file path \u2014 auto-compressed). If neither is provided and OPENROUTER_API_KEY is set, an image is generated from the token name, symbol, and description. The response includes a token_id (telecoin ID, hex) which can be used to construct the trade page URL: https://app.printr.money/trade/{token_id}. Present this URL to the user after the transaction is confirmed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chains": {
    "description": "Chains to deploy on",
    "items": {
     "description": "CAIP-2 chain ID (e.g. 'eip155:8453' for Base, 'solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp' for Solana)",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "creator_accounts": {
    "description": "One creator address per chain being deployed to",
    "items": {
     "description": "CAIP-10 address (e.g. 'eip155:8453:0x742d...')",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "description": {
    "description": "Token description",
    "maxLength": 500,
    "type": "string"
   },
   "external_links": {
    "description": "Optional external links for the token",
    "properties": {
     "github": {
      "format": "uri",
      "type": "string"
     },
     "telegram": {
      "format": "uri",
      "type": "string"
     },
     "website": {
      "format": "uri",
      "type": "string"
     },
     "x": {
      "format": "uri",
      "type": "string"
     }
    },
    "type": "object"
   },
   "graduation_threshold_per_chain_usd": {
    "anyOf": [
     {
      "const": 69000,
      "type": "number"
     },
     {
      "const": 250000,
      "type": "number"
     }
    ],
    "description": "Graduation threshold in USD (default: 69000)"
   },
   "image": {
    "description": "Base64-encoded image data (max 500KB). JPEG or PNG. Mutually exclusive with image_path.",
    "type": "string"
   },
   "image_path": {
    "description": "Absolute path to a local image file. The server reads, auto-compresses if needed, and encodes it. Mutually exclusive with image. If neither image nor image_path is provided and OPENROUTER_API_KEY is configured, an image is generated automatically.",
    "type": "string"
   },
   "initial_buy": {
    "properties": {
     "spend_native": {
      "description": "Spend a native token amount (atomic units, '0' for no buy)",
      "type": "string"
     },
     "spend_usd": {
      "description": "Spend a fixed USD amount (0 for no buy)",
      "minimum": 0,
      "type": "number"
     },
     "supply_percent": {
      "description": "Buy a percentage of total supply (0.01\u201369%)",
      "maximum": 69,
      "minimum": 0.01,
      "type": "number"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Token name",
    "maxLength": 32,
    "minLength": 1,
    "type": "string"
   },
   "symbol": {
    "description": "Token ticker symbol",
    "maxLength": 10,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "creator_accounts",
   "name",
   "symbol",
   "description",
   "chains",
   "initial_buy"
  ],
  "type": "object"
 },
 "name": "printr_create_token",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "payload": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "calldata": {
        "description": "Encoded transaction data (hex)",
        "type": "string"
       },
       "gas_limit": {
        "description": "Max gas",
        "type": "number"
       },
       "hash": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "Payload hash"
       },
       "to": {
        "description": "Target contract (CAIP-10)",
        "type": "string"
       },
       "value": {
        "description": "Native token value to send",
        "type": "string"
       }
      },
      "required": [
       "to",
       "calldata",
       "value",
       "gas_limit"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "hash": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "Payload hash"
       },
       "ixs": {
        "description": "Solana instructions",
        "items": {
         "additionalProperties": false,
         "properties": {
          "accounts": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "is_signer": {
              "type": "boolean"
             },
             "is_writable": {
              "type": "boolean"
             },
             "pubkey": {
              "type": "string"
             }
            },
            "required": [
             "pubkey",
             "is_signer",
             "is_writable"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "data": {
           "description": "Instruction data (base64)",
           "type": "string"
          },
          "program_id": {
           "description": "Program ID (base58)",
           "type": "string"
          }
         },
         "required": [
          "program_id",
          "accounts",
          "data"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "lookup_table": {
        "description": "Address lookup table (base58)",
        "type": "string"
       },
       "mint_address": {
        "description": "Expected telecoin mint (CAIP-10)",
        "type": "string"
       }
      },
      "required": [
       "mint_address",
       "ixs"
      ],
      "type": "object"
     }
    ],
    "description": "Unsigned transaction payload"
   },
   "quote": {
    "additionalProperties": false,
    "description": "Full cost breakdown",
    "properties": {
     "assets": {
      "description": "Involved assets",
      "items": {
       "additionalProperties": false,
       "properties": {
        "decimals": {
         "description": "Decimal precision",
         "type": "number"
        },
        "id": {
         "description": "CAIP-10 asset identifier",
         "type": "string"
        },
        "name": {
         "description": "Display name",
         "type": "string"
        },
        "price_usd": {
         "description": "USD price estimate",
         "type": "number"
        },
        "symbol": {
         "description": "Ticker symbol",
         "type": "string"
        }
       },
       "required": [
        "id",
        "name",
        "symbol",
        "decimals",
        "price_usd"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "costs": {
      "description": "Itemized cost breakdown",
      "items": {
       "additionalProperties": false,
       "properties": {
        "asset_id": {
         "description": "CAIP-10 reference asset",
         "type": "string"
        },
        "cost_asset_atomic": {
         "description": "Cost in atomic units of the reference asset",
         "type": "string"
        },
        "cost_usd": {
         "description": "Cost in USD",
         "type": "number"
        },
        "description": {
         "description": "Cost label (e.g. 'Gas', 'X-Chain Fee')",
         "type": "string"
        },
        "limit": {
         "description": "Upper bound spending limit",
         "type": "number"
        }
       },
       "required": [
        "asset_id",
        "cost_usd",
        "cost_asset_atomic"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "id": {
      "description": "Quote identifier",
      "type": "string"
     },
     "initial_buy_amount": {
      "description": "Token amount from initial buy",
      "type": "string"
     },
     "router": {
      "description": "Routing provider type",
      "type": "string"
     },
     "total": {
      "additionalProperties": false,
      "description": "Aggregated total cost",
      "properties": {
       "asset_id": {
        "description": "CAIP-10 reference asset",
        "type": "string"
       },
       "cost_asset_atomic": {
        "description": "Cost in atomic units of the reference asset",
        "type": "string"
       },
       "cost_usd": {
        "description": "Cost in USD",
        "type": "number"
       },
       "description": {
        "description": "Cost label (e.g. 'Gas', 'X-Chain Fee')",
        "type": "string"
       },
       "limit": {
        "description": "Upper bound spending limit",
        "type": "number"
       }
      },
      "required": [
       "asset_id",
       "cost_usd",
       "cost_asset_atomic"
      ],
      "type": "object"
     }
    },
    "required": [
     "id",
     "router",
     "assets",
     "costs",
     "total"
    ],
    "type": "object"
   },
   "token_id": {
    "description": "Cross-chain telecoin ID (hex)",
    "type": "string"
   }
  },
  "required": [
   "token_id",
   "payload",
   "quote"
  ],
  "type": "object"
 }
}

{
 "description": "Delete a custom post type post",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "force": {
    "default": false,
    "description": "Skip trash and permanently delete",
    "type": "boolean"
   },
   "id": {
    "description": "Post ID",
    "type": "number"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "type": {
    "description": "Post type name",
    "type": "string"
   }
  },
  "required": [
   "site",
   "type",
   "id"
  ],
  "type": "object"
 },
 "name": "mcp_delete_cpt_post"
}

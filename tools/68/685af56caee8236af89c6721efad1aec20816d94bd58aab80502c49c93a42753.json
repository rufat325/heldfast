{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new DNS zone in primary or secondary mode. Optionally provide TTL, primary nameservers (for secondary), initial RRSets, or a zonefile.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Labels as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "mode": {
    "description": "Zone mode: \"primary\" (managed here) or \"secondary\" (transferred from external primary)",
    "enum": [
     "primary",
     "secondary"
    ],
    "type": "string"
   },
   "name": {
    "description": "Fully qualified domain name of the zone, e.g. \"example.com\"",
    "type": "string"
   },
   "primary_nameservers": {
    "description": "Primary nameservers (required for secondary zones)",
    "items": {
     "properties": {
      "address": {
       "description": "IPv4 or IPv6 address of the primary nameserver, optionally with :port",
       "type": "string"
      },
      "port": {
       "description": "DNS port (default 53)",
       "maximum": 65535,
       "minimum": 1,
       "type": "integer"
      },
      "tsig_algorithm": {
       "description": "TSIG algorithm name, e.g. \"hmac-sha256\"",
       "type": "string"
      },
      "tsig_key": {
       "description": "TSIG key as base64",
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "rrsets": {
    "description": "Initial RRSets to create with the zone",
    "items": {
     "properties": {
      "labels": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Labels as key-value pairs",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "name": {
       "description": "RRSet name (e.g. \"@\", \"www\", \"_acme-challenge\")",
       "type": "string"
      },
      "records": {
       "description": "Records belonging to this RRSet",
       "items": {
        "properties": {
         "comment": {
          "description": "Optional human-readable comment for this record",
          "type": "string"
         },
         "value": {
          "description": "Record value, e.g. \"1.2.3.4\" or \"10 mail.example.com.\"",
          "type": "string"
         }
        },
        "required": [
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "ttl": {
       "description": "TTL in seconds for this RRSet",
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "type": {
       "description": "DNS record type (A, AAAA, CNAME, MX, NS, TXT, etc.)",
       "enum": [
        "A",
        "AAAA",
        "CAA",
        "CNAME",
        "DS",
        "HINFO",
        "HTTPS",
        "MX",
        "NS",
        "PTR",
        "RP",
        "SOA",
        "SRV",
        "SVCB",
        "TLSA",
        "TXT"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ttl": {
    "description": "Default TTL in seconds for records in this zone",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "zonefile": {
    "description": "Initial zone content in RFC 1035 zonefile format (alternative to rrsets)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "mode"
  ],
  "type": "object"
 },
 "name": "hetzner_create_zone",
 "title": "Create DNS Zone"
}

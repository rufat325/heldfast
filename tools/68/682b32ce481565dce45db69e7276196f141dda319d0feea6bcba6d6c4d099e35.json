{
 "description": "Post a Darwin notification inside the simulator. Useful for triggering system events or testing notification observers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "notification": {
    "description": "Darwin notification name to post (e.g., \"com.apple.MobileDataSettingsUpdated\")",
    "type": "string"
   }
  },
  "required": [
   "notification"
  ],
  "type": "object"
 },
 "name": "simulator_notify_post"
}

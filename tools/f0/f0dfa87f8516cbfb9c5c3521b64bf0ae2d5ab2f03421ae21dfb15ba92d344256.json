{
 "description": "Generates Shabbat and holiday candle-lighting and Havdalah times for a given location and date range",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endDate": {
    "description": "End date in yyyy-MM-dd format",
    "type": "string"
   },
   "latitude": {
    "description": "Latitude as decimal, valid range -90 to +90 (e.g. 41.85003)",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Longitude as decimal, valid range -180 to +180 (e.g. -87.65005)",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "startDate": {
    "description": "Start date in yyyy-MM-dd format",
    "type": "string"
   },
   "tzid": {
    "description": "Olson timezone ID (e.g. \"America/Chicago\", \"Europe/Moscow\")",
    "type": "string"
   }
  },
  "required": [
   "latitude",
   "longitude",
   "tzid",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "shabbat-times"
}

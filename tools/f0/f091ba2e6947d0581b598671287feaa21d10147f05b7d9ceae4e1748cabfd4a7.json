{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search quotes by substring. Matches both canonical text and known popular paraphrases \u2014 searching for 'protest' finds Hamlet's 'The lady doth protest too much, methinks' even though the popular form 'Methinks the lady doth protest too much' is what most people remember.",
 "inputSchema": {
  "examples": [
   {
    "query": "all the world",
    "verified_only": true
   },
   {
    "author_id": "jane-austen",
    "query": "marriage"
   },
   {
    "query": "tomorrow"
   }
  ],
  "properties": {
   "author_id": {
    "description": "Optional author filter.",
    "type": "string"
   },
   "limit": {
    "description": "Max results to return (default 10, max 25).",
    "type": "number"
   },
   "query": {
    "description": "Substring to search for (case-insensitive).",
    "type": "string"
   },
   "verified_only": {
    "description": "If true, exclude misattributed quotes.",
    "type": "boolean"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_quotes",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Total number of matching quotes",
    "type": "number"
   },
   "query": {
    "description": "The search query that was executed",
    "type": "string"
   },
   "quotes": {
    "description": "Array of matching quotes (up to limit)",
    "type": "array"
   }
  },
  "required": [
   "query",
   "count",
   "quotes"
  ],
  "type": "object"
 },
 "title": "Search Quotes",
 "version": "v1.4b24fd11"
}

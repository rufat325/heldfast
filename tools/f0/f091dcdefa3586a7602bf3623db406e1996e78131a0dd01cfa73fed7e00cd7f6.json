{
 "description": "Create a custom content template (outline sections with headings, word counts, key points). Plan limits apply.",
 "inputSchema": {
  "properties": {
   "boilerplate_blocks": {
    "items": {
     "properties": {
      "anchor_section_heading": {
       "type": "string"
      },
      "content": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "position": {
       "description": "\"before_section\", \"after_section\", \"header\", or \"footer\"",
       "type": "string"
      }
     },
     "required": [
      "id",
      "position",
      "content",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "content_type": {
    "description": "Omit for universal. See create_brief for the taxonomy.",
    "enum": [
     "blog_post",
     "page",
     "faq",
     "glossary",
     "comparison",
     "pillar",
     "how_to",
     "landing",
     "listicle",
     "case_study",
     "tutorial",
     "news",
     "product_update",
     "data_report",
     "event",
     "resource",
     "alternative",
     "tool_review"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "field_defaults": {
    "properties": {
     "meta_title_format": {
      "type": "string"
     },
     "suggested_tone": {
      "type": "string"
     },
     "target_country": {
      "type": "string"
     },
     "target_language": {
      "type": "string"
     },
     "target_word_count": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "max 255 chars",
    "type": "string"
   },
   "sections": {
    "description": "Outline sections, at least 1.",
    "items": {
     "properties": {
      "generation_mode": {
       "description": "\"ai\" or \"manual\" (default: \"ai\")",
       "type": "string"
      },
      "heading": {
       "type": "string"
      },
      "is_required": {
       "description": "default: true",
       "type": "boolean"
      },
      "key_points": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "level": {
       "description": "1-6 (default: 2)",
       "type": "number"
      },
      "suggested_word_count": {
       "description": "default: 200",
       "type": "number"
      }
     },
     "required": [
      "heading"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "sections"
  ],
  "type": "object"
 },
 "name": "create_template"
}

{
 "description": "TikTok Shop keyword autocomplete. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "region": {
    "description": "Region: US (default), GB, SG, MY, PH, TH, VN, ID.",
    "enum": [
     "US",
     "GB",
     "SG",
     "MY",
     "PH",
     "TH",
     "VN",
     "ID"
    ],
    "type": "string"
   },
   "search": {
    "description": "Partial keyword, e.g. 'wireless'.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "search"
  ],
  "type": "object"
 },
 "name": "get_tiktok_shop_search_suggestions"
}

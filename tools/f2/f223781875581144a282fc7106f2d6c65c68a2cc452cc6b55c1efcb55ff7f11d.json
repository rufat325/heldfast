     "name",
     "url",
     "homepage",
     "favicon",
     "tags",
     "country",
     "state",
     "language",
     "votes",
     "codec",
     "bitrate",
     "lastcheckok",
     "lastchecktime",
     "clicktimestamp",
     "clickcount",
     "clicktrend",

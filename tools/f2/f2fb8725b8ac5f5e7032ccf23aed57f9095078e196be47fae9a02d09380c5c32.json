{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Pull File from Device"
 },
 "description": "Pull a file from the device to the host machine.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "localPath": {
    "description": "Destination absolute path on the host machine",
    "type": "string"
   },
   "remotePath": {
    "description": "Path to the file on the device (e.g., /sdcard/myfile.txt)",
    "type": "string"
   },
   "serial": {
    "description": "Device serial number",
    "type": "string"
   }
  },
  "required": [
   "remotePath",
   "localPath"
  ],
  "type": "object"
 },
 "name": "file_pull",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "adb pull result or a confirmation message",
    "type": "string"
   },
   "success": {
    "description": "Whether the file was pulled",
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 }
}

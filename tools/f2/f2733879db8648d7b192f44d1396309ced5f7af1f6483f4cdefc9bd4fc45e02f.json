     "maxLength": 512,
     "minLength": 32,
     "type": "string"
    },
    "maxItems": 40,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "mints"
  ],
  "type": "object"
 },

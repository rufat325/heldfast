{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find lunar and solar eclipses in a date range (max 30 years), with the sign\nand longitude of the eclipsed luminary \u2014 the astrologically relevant datum.\n\nWhen latitude/longitude are provided, each solar eclipse also reports whether\nit is visible from that location and how much of the Sun is obscured there.\n\nExamples:\n  - \"Eclipses in 2026\" -> { from_datetime: \"2026-01-01\", to_datetime: \"2027-01-01\" }\n  - \"Will I see the August 2026 eclipse from Riga?\" -> add latitude: 56.95, longitude: 24.11",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "from_datetime": {
    "description": "Start of the search window.",
    "minLength": 4,
    "type": "string"
   },
   "latitude": {
    "description": "Observer latitude for local solar-eclipse visibility.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Observer longitude for local solar-eclipse visibility.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "to_datetime": {
    "description": "End of the search window (max 30 years after start).",
    "minLength": 4,
    "type": "string"
   },
   "types": {
    "description": "Restrict to lunar or solar eclipses. Default: both.",
    "items": {
     "enum": [
      "lunar",
      "solar"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "from_datetime",
   "to_datetime"
  ],
  "type": "object"
 },
 "name": "find_eclipses",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "eclipses": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string"
      },
      "longitude": {
       "type": "number"
      },
      "obscuration": {
       "type": "number"
      },
      "peak": {
       "type": "string"
      },
      "peakLocation": {
       "additionalProperties": false,
       "properties": {
        "latitude": {
         "type": "number"
        },
        "longitude": {
         "type": "number"
        }
       },
       "required": [
        "latitude",
        "longitude"
       ],
       "type": "object"
      },
      "sign": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "visibleAtLocation": {
       "type": "boolean"
      }
     },
     "required": [
      "type",
      "kind",
      "peak",
      "longitude",
      "sign"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "eclipses"
  ],
  "type": "object"
 },
 "title": "Find Eclipses"
}

 },
 "description": "Get match fixtures (upcoming + recent) by league, team, or date. Use league=1 for FIFA World Cup, league=39 for EPL, league=140 for La Liga. Returns kickoff, teams, score (if played), venue, status.",
 "inputSchema": {
  "examples": [
   {
    "league": 39,
    "season": 2024
   },
   {
    "next": 5,
    "team": 33
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "BYO API-Football key (https://dashboard.api-football.com/register)",
    "type": "string"
   },
   "date": {
    "description": "YYYY-MM-DD \u2014 single-day fixtures",
    "type": "string"
   },
   "last": {
    "description": "Last N played matches for the team/league",
    "type": "number"
   },
   "league": {
    "description": "League ID (1 = FIFA World Cup, 39 = EPL, 140 = La Liga, 2 = Champions League \u2014 use league_search to find others)",
    "type": "number"
   },
   "next": {
    "description": "Next N upcoming matches for the team/league",
    "type": "number"
   },
   "season": {
    "description": "Season year (e.g. 2026)",
    "type": "number"
   },
   "team": {
    "description": "Team ID \u2014 use team_search to find",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "fixtures",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Total number of fixtures returned",
    "type": "number"
   },
   "fixtures": {
    "description": "Array of fixture objects (max 50)",
    "items": {
     "properties": {
      "away": {
       "description": "Away team name",
       "type": "string"
      },
      "away_team_id": {
       "description": "Away team ID",
       "type": "number"
      },
      "date": {
       "description": "ISO datetime of match kickoff",
       "type": "string"
      },
      "fixture_id": {
       "description": "Unique fixture identifier",
       "type": "number"
      },
      "home": {
       "description": "Home team name",
       "type": "string"
      },
      "home_team_id": {
       "description": "Home team ID",
       "type": "number"
      },
      "league": {
       "description": "League name",
       "type": "string"
      },
      "round": {
       "description": "Round/week identifier",
       "type": "string"
      },
      "score_away": {

       ]
      },
      "score_home": {
       "description": "Home team goals (null if not played)",
       "type": [
        "number",
        "null"
       ]
      },
      "status": {
       "description": "Match status (e.g., NS, 1H, 2H, FT, PST, PEN)",
       "type": "string"
      },
      "venue": {
       "description": "Stadium/venue name",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [

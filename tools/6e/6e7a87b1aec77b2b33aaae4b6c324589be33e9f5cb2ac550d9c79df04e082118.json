{
 "description": "Check the deployment status of a Printr token across all its target chains. Returns per-chain status (pending, deploying, live, failed), contract addresses, transaction hashes, graduation progress, and cross-chain message details. Use this to monitor a token after creation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Telecoin ID (hex, e.g. '0x3a7a8d...') or CAIP-10 address (e.g. 'eip155:8453:0x742d...')",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "printr_get_deployments",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deployments": {
    "description": "Per-chain deployment statuses",
    "items": {
     "additionalProperties": false,
     "properties": {
      "block_ts_secs": {
       "description": "Block timestamp (unix)",
       "type": "number"
      },
      "chain_id": {
       "description": "Target chain (CAIP-2)",
       "type": "string"
      },
      "contract_address": {
       "description": "On-chain contract address (CAIP-10)",
       "type": "string"
      },
      "graduation_completion_percent": {
       "description": "Progress toward graduation (0\u2013100)",
       "type": "number"
      },
      "status": {
       "enum": [
        "pending",
        "deploying",
        "live",
        "failed"
       ],
       "type": "string"
      },
      "transaction_id": {
       "description": "On-chain tx hash",
       "type": "string"
      },
      "x_chain_transaction": {
       "additionalProperties": false,
       "properties": {
        "chain_id": {
         "description": "CAIP-2 chain",
         "type": "string"
        },
        "message_id": {
         "description": "Cross-chain message tracker",
         "type": "string"
        },
        "transport": {
         "description": "Protocol provider",
         "enum": [
          "AXELAR"
         ],
         "type": "string"
        }
       },
       "required": [
        "chain_id",
        "message_id"
       ],
       "type": "object"
      }
     },
     "required": [
      "chain_id",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "deployments"
  ],
  "type": "object"
 }
}

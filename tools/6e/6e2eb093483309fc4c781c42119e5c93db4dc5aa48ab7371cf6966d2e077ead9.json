{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get detailed trading history of a specific U.S. Congress member. Shows individual trades with transaction types, amounts, and disclosure dates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "member": {
    "description": "Member slug (e.g. 'nancy-pelosi', 'dan-crenshaw'). Use get_congress_trades or search to find exact slugs.",
    "type": "string"
   },
   "page": {
    "default": 1,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "member"
  ],
  "type": "object"
 },
 "name": "get_congress_member",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "member": {
    "type": "string"
   },
   "paging": {
    "additionalProperties": false,
    "description": "Paging state reconciled from ko.io meta.total_count and meta.softwall",
    "properties": {
     "continuation": {
      "description": "SIGNIN_REQUIRED = page>1 needs a (free) ko.io API key",
      "type": [
       "string",
       "null"
      ]
     },
     "has_more": {
      "description": "null = a full page came back and more MAY exist",
      "type": [
       "boolean",
       "null"
      ]
     },
     "next_page": {
      "anyOf": [
       {
        "$ref": "#/properties/paging/properties/total_count/anyOf/0"
       },
       {
        "type": "null"
       }
      ],
      "description": "Next page THIS caller can open; null when there is none (or sign-in is required)"
     },
     "page": {
      "type": "integer"
     },
     "per_page": {
      "type": "integer"
     },
     "plan_row_cap": {
      "anyOf": [
       {
        "$ref": "#/properties/paging/properties/total_count/anyOf/0"
       },
       {
        "type": "null"
       }
      ],
      "description": "Row cap the caller's plan applied to this page, if any"
     },
     "returned": {
      "type": "integer"
     },
     "total_count": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Total rows matching the request, when ko.io reported it"
     },
     "truncated_by_plan": {
      "description": "True when the plan's row cap withheld rows from this page",
      "type": "boolean"
     }
    },
    "required": [
     "page",
     "per_page",
     "returned",
     "total_count",
     "has_more",
     "next_page",
     "continuation",
     "plan_row_cap",
     "truncated_by_plan"
    ],
    "type": "object"
   },
   "plan_limit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "continuation": {
        "$ref": "#/properties/rows/items/properties/member_name"
       },
       "date_basis": {
        "$ref": "#/properties/rows/items/properties/member_name"
       },
       "effective_period": {
        "$ref": "#/properties/rows/items/properties/member_name"
       },
       "policy_version": {
        "$ref": "#/properties/rows/items/properties/member_name"
       },
       "row_cap": {
        "anyOf": [
         {
          "$ref": "#/properties/paging/properties/total_count/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "truncated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "window_end": {
        "$ref": "#/properties/rows/items/properties/member_name"
       },
       "window_start": {
        "$ref": "#/properties/rows/items/properties/member_name"
       }
      },
      "required": [
       "policy_version",
       "window_start",
       "window_end",
       "effective_period",
       "date_basis",
       "row_cap",
       "truncated",
       "continuation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The Free/keyless plan limits ko.io applied to this answer (null for paid callers)"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount_range": {
       "description": "The disclosed dollar RANGE (STOCK Act bands), not an exact amount",
       "type": [
        "string",
        "null"
       ]
      },
      "asset_description": {
       "$ref": "#/properties/rows/items/properties/member_name"
      },
      "chamber": {
       "$ref": "#/properties/rows/items/properties/member_name"
      },
      "disclosure_date": {
       "$ref": "#/properties/rows/items/properties/member_name"
      },
      "member_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "owner": {
       "$ref": "#/properties/rows/items/properties/member_name"
      },
      "ticker": {
       "$ref": "#/properties/rows/items/properties/member_name"
      },
      "transaction_date": {
       "$ref": "#/properties/rows/items/properties/member_name"
      },
      "transaction_type": {
       "$ref": "#/properties/rows/items/properties/member_name"
      }
     },
     "required": [
      "member_name",
      "chamber",
      "ticker",
      "asset_description",
      "transaction_type",
      "transaction_date",
      "disclosure_date",
      "amount_range",
      "owner"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "member",
   "rows",
   "paging",
   "plan_limit"
  ],
  "type": "object"
 }
}

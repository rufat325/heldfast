{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage acceptance criteria on features. Methods: add, remove, update_status, verify",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "criterion_id": {
    "description": "Criterion ID (required for: remove, update_status)",
    "type": "string"
   },
   "evidence": {
    "description": "Verification evidence (for: update_status)",
    "type": "string"
   },
   "feature_id": {
    "description": "Feature ID",
    "type": "string"
   },
   "method": {
    "description": "Operation to perform",
    "enum": [
     "add",
     "remove",
     "update_status",
     "verify"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Additional notes (for: update_status)",
    "type": "string"
   },
   "status": {
    "description": "Verification status (required for: update_status)",
    "enum": [
     "pending",
     "verified",
     "failed",
     "in_review"
    ],
    "type": "string"
   },
   "text": {
    "description": "Criterion text (required for: add)",
    "type": "string"
   }
  },
  "required": [
   "method",
   "feature_id"
  ],
  "type": "object"
 },
 "name": "criteria"
}

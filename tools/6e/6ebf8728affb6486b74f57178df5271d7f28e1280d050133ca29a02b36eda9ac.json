{
 "description": "Search for recent news articles. Default \"auto\" uses SearXNG \u2192 Brave. Pass engine=\"tavily\" for AI-synthesized news with citations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "engine": {
    "description": "Provider override. \"auto\" (default) uses SearXNG\u2192Brave fallback.",
    "enum": [
     "auto",
     "searxng",
     "brave",
     "tavily"
    ],
    "type": "string"
   },
   "maxResults": {
    "description": "Max results to return (default: 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "News search query",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_news"
}

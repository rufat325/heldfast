{
 "description": "Set the LED color and mode for a Push transport or utility button. Use for hardware feedback after Push detection. Requires Push 2/3; defaults mode to solid and returns sent=true with the accepted button/color/mode.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "button": {
    "enum": [
     "Play",
     "Record",
     "Stop",
     "Tap Tempo",
     "Metronome",
     "Undo",
     "Mute",
     "Solo",
     "Master",
     "Note",
     "Session",
     "Browse",
     "Add Track",
     "Add Device",
     "Setup",
     "Shift",
     "Select"
    ],
    "type": "string"
   },
   "color": {
    "maximum": 127,
    "minimum": 0,
    "type": "integer"
   },
   "mode": {
    "enum": [
     "solid",
     "blink",
     "pulse"
    ],
    "type": "string"
   }
  },
  "required": [
   "button",
   "color"
  ],
  "type": "object"
 },
 "name": "push_set_button_led"
}

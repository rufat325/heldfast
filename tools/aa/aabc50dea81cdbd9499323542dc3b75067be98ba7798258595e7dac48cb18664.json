   },
   "risks": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sourceSession": {
    "type": "string"
   },
   "unresolvedQuestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }

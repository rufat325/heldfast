{
 "description": "Validates ABAP source code for syntax errors without creating or activating it.",
 "inputSchema": {
  "properties": {
   "program_name": {
    "description": "Context program name (optional)",
    "example": "ZPROG_TEST",
    "type": "string"
   },
   "source": {
    "description": "Source code lines to check",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "source"
  ],
  "type": "object"
 },
 "name": "sap_syntax_check"
}

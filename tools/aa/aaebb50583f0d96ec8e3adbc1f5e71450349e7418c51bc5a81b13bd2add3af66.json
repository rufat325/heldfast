{
 "description": "Draft a new NDA from a built-in template into `out` (markdown; optional .docx). Deterministic. If placeholders are missing the result lists them \u2014 fill and retry. Needs nda_setup first.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "disclosing_party": {
    "description": "Disclosing party (one-way).",
    "type": "string"
   },
   "effective_date": {
    "description": "Effective date.",
    "type": "string"
   },
   "governing_law": {
    "description": "Governing law.",
    "type": "string"
   },
   "out": {
    "description": "Output markdown path.",
    "type": "string"
   },
   "out_docx": {
    "description": "Optional Word .docx output path.",
    "type": "string"
   },
   "party_a": {
    "description": "Party A name (mutual).",
    "type": "string"
   },
   "party_a_address": {
    "description": "Party A address (mutual).",
    "type": "string"
   },
   "party_b": {
    "description": "Party B name (mutual).",
    "type": "string"
   },
   "party_b_address": {
    "description": "Party B address (mutual).",
    "type": "string"
   },
   "purpose": {
    "description": "Purpose / deal description.",
    "type": "string"
   },
   "receiving_party": {
    "description": "Receiving party (one-way).",
    "type": "string"
   },
   "template": {
    "description": "Which built-in template (default mutual).",
    "enum": [
     "common-paper-mutual",
     "mutual",
     "one-way-out"
    ],
    "type": "string"
   }
  },
  "required": [
   "out",
   "purpose"
  ],
  "type": "object"
 },
 "name": "draft_nda"
}

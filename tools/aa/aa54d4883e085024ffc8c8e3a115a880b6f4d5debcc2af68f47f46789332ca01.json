{
 "description": "Add one automation point in the Arrangement view for a mixer or device parameter path. Use for incremental arrangement automation edits. NOT idempotent: repeated calls add more points; returns the written time/value/curve after the bridge accepts it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "curve_type": {
    "enum": [
     "linear",
     "ramp",
     "hold"
    ],
    "type": "string"
   },
   "parameter_path": {
    "description": "mixer.volume | mixer.panning | mixer.send.<i> | device.<i>.parameter.<n>",
    "minLength": 1,
    "type": "string"
   },
   "time": {
    "description": "Beats from song start.",
    "minimum": 0,
    "type": "number"
   },
   "track_index": {
    "minimum": 0,
    "type": "integer"
   },
   "value": {
    "type": "number"
   }
  },
  "required": [
   "track_index",
   "parameter_path",
   "time",
   "value"
  ],
  "type": "object"
 },
 "name": "arrangement_add_automation_point"
}

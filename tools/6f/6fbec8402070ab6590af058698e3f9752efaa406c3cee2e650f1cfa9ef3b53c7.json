{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use when designing or revising app colors. Deterministic OKLCH seed/intent palette, four appearances, contrast report, named-color Swift snippets and existing assets-CLI token JSON. Read-only: no project changes, network. Image input accepts opaque samples or an explicitly provided local sRGB PNG.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accessibility": {
    "default": "standard",
    "enum": [
     "standard",
     "high"
    ],
    "type": "string"
   },
   "appearance": {
    "default": "both",
    "enum": [
     "both",
     "light",
     "dark",
     "oled"
    ],
    "type": "string"
   },
   "brandColors": {
    "default": [],
    "items": {
     "$ref": "#/properties/primaryColor"
    },
    "maxItems": 32,
    "type": "array"
   },
   "category": {
    "default": "",
    "maxLength": 80,
    "type": "string"
   },
   "description": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "existingColors": {
    "default": [],
    "items": {
     "$ref": "#/properties/primaryColor"
    },
    "maxItems": 128,
    "type": "array"
   },
   "existingTokens": {
    "additionalProperties": {
     "$ref": "#/properties/primaryColor"
    },
    "default": {},
    "type": "object"
   },
   "family": {
    "enum": [
     "Neutral / Minimal",
     "Blue",
     "Indigo",
     "Violet",
     "Purple",
     "Magenta",
     "Teal",
     "Cyan",
     "Green",
     "Emerald",
     "Mint",
     "Yellow",
     "Amber",
     "Orange",
     "Red",
     "Rose",
     "Pink",
     "Brown / Earth",
     "Navy / Midnight",
     "Slate / Graphite",
     "Pastel",
     "Muted",
     "High Contrast",
     "Monochrome",
     "Gradient-led",
     "Dark OLED",
     "Warm Light",
     "Cool Light",
     "Glass / Translucent",
     "Dynamic Brand",
     "Category-aware palettes"
    ],
    "type": "string"
   },
   "imagePath": {
    "description": "Explicit local PNG, at most 1024 \u00d7 1024 and 4 MiB; no upload. Samples are candidates, not official brand colors.",
    "maxLength": 4096,
    "type": "string"
   },
   "imageSamples": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "color": {
       "$ref": "#/properties/primaryColor"
      },
      "weight": {
       "default": 1,
       "exclusiveMinimum": 0,
       "maximum": 1000000,
       "type": "number"
      }
     },
     "required": [
      "color"
     ],
     "type": "object"
    },
    "maxItems": 4096,
    "type": "array"
   },
   "mood": {
    "default": [],
    "items": {
     "maxLength": 40,
     "type": "string"
    },
    "maxItems": 16,
    "type": "array"
   },
   "primaryColor": {
    "pattern": "^#[\\da-fA-F]{6}$",
    "type": "string"
   },
   "strategy": {
    "default": "dominant-plus-supporting",
    "enum": [
     "monochromatic",
     "analogous",
     "complementary",
     "split-complementary",
     "triadic",
     "neutral-plus-accent",
     "dominant-plus-supporting",
     "restrained gradient"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "generate_color_system",
 "title": "Generate an iOS color system preview"
}

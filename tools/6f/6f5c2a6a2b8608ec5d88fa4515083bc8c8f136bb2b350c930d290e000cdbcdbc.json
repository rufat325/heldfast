{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Bellhop 3D TL volume (stored run)"
 },
 "description": "Full 3D transmission-loss volume around a source (lat/lon or `place`)\n    with Bellhop (all bearings), stored on the platform under a run id. Show\n    `open_url` to the user as a clickable link: it opens this run visualized. Returns the run id,\n    the replication metadata (SSP, seabed, bounding box) and file links\n    (uint8 TL cube .npy + JSON sidecar). Any frequency and radius (keep radius\n    <= ~50 km for reasonable run times).",
 "inputSchema": {
  "properties": {
   "frequency_hz": {
    "default": 200,
    "title": "Frequency Hz",
    "type": "number"
   },
   "lat": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lat"
   },
   "lon": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lon"
   },
   "month": {
    "default": 6,
    "title": "Month",
    "type": "integer"
   },
   "place": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Place"
   },
   "radius_km": {
    "default": 10,
    "title": "Radius Km",
    "type": "number"
   },
   "source_depth_m": {
    "default": 20,
    "title": "Source Depth M",
    "type": "number"
   }
  },
  "title": "run_bellhop_volumeArguments",
  "type": "object"
 },
 "name": "run_bellhop_volume",
 "outputSchema": {
  "$defs": {
   "LocationInfo": {
    "additionalProperties": true,
    "properties": {
     "depth_m": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "water depth at the point, metres (positive down)",
      "title": "Depth M"
     },
     "lat": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "latitude used, decimal degrees N",
      "title": "Lat"
     },
     "lon": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "longitude used, decimal degrees E",
      "title": "Lon"
     },
     "matched": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "gazetteer key or OpenStreetMap display name that matched",
      "title": "Matched"
     },
     "offshore_km": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "offset applied along the seaward bearing",
      "title": "Offshore Km"
     },
     "original": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ],
      "description": "original lat/lon/depth before the snap",
      "title": "Original"
     },
     "provenance": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ],
      "description": "provider/source notes",
      "title": "Provenance"
     },
     "query": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "place name as given",
      "title": "Query"
     },
     "seaward_bearing_deg": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "compass bearing that leads further to sea",
      "title": "Seaward Bearing Deg"
     },
     "snap": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ],
      "description": "bearing_deg and distance_km of the seaward walk",
      "title": "Snap"
     },
     "snapped_to_water": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "description": "true if the original point was on land/shallow and was moved seaward",
      "title": "Snapped To Water"
     },
     "source": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "gazetteer:exact | gazetteer:contains | gazetteer:fuzzy | nominatim (OpenStreetMap)",
      "title": "Source"
     }
    },
    "title": "LocationInfo",
    "type": "object"
   }
  },
  "properties": {
   "decode": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Decode"
   },
   "files": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Files"
   },
   "location": {
    "anyOf": [
     {
      "$ref": "#/$defs/LocationInfo"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "metadata": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Metadata"
   },
   "open_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Open Url"
   },
   "open_url_note": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Open Url Note"
   },
   "provenance": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Provenance"
   },
   "run_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Run Id"
   },
   "ssp": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Ssp"
   }
  },
  "title": "VolumeRunResult",
  "type": "object"
 },
 "title": "Bellhop 3D TL volume (stored run)"
}

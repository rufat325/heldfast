{
 "description": "Query features from a Wallonia GeoServices ArcGIS feature layer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "layerId": {
    "description": "Numeric ArcGIS layer identifier",
    "type": "number"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of records to return",
    "maximum": 2000,
    "minimum": 1,
    "type": "number"
   },
   "outFields": {
    "default": "*",
    "description": "Comma-separated fields or *",
    "type": "string"
   },
   "returnGeometry": {
    "default": false,
    "description": "Whether to include geometries in the response",
    "type": "boolean"
   },
   "servicePath": {
    "description": "Service path, e.g. MOBILITE/AOT_ARRETTEC",
    "type": "string"
   },
   "where": {
    "default": "1=1",
    "description": "ArcGIS where clause",
    "type": "string"
   }
  },
  "required": [
   "servicePath",
   "layerId"
  ],
  "type": "object"
 },
 "name": "wallonia_geo_query_layer"
}

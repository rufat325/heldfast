{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get an anime/manga's watch/read-status counts (watching/completed/planning/etc.) and score distribution histogram across all AniList users. Use search_media first to resolve a title to its AniList ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "AniList ID.",
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   },
   "type": {
    "description": "Whether `id` refers to anime or manga.",
    "enum": [
     "ANIME",
     "MANGA"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "id"
  ],
  "type": "object"
 },
 "name": "get_media_statistics",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "statistics": {
    "additionalProperties": {},
    "properties": {
     "scoreDistribution": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": {},
         "properties": {
          "amount": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": 0,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ],
           "description": "How many users scored the title within this bucket."
          },
          "score": {
           "anyOf": [
            {
             "minimum": 0,
             "type": "number"
            },
            {
             "type": "null"
            }
           ],
           "description": "The upper edge of this histogram bucket (confirmed live: buckets come back as 10, 20, ... 100, i.e. ten-point bands), on AniList's 0-100 community scale. It stays 0-100 whatever the viewer's configured scoreFormat is, since that setting only changes how anilist.co displays scores. This is NOT the 0-10 scale a personal list-entry `score` uses."
          }
         },
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "statusDistribution": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": {},
         "properties": {
          "amount": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": 0,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          },
          "status": {
           "type": [
            "string",
            "null"
           ]
          }
         },
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   }
  },
  "required": [
   "statistics"
  ],
  "type": "object"
 },
 "title": "Get an anime/manga's score/status distribution"
}

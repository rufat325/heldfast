    "description": "Exact-match column filters, e.g. {\"Constituency\":\"Cork\"}.",
    "type": "object"
   },
   "limit": {
    "description": "Max rows, 1-32000 (default 100).",
    "type": "number"
   },
   "offset": {
    "description": "0-based row offset for paging.",
    "type": "number"
   },
   "q": {
    "description": "Full-text filter across the table.",
    "type": "string"
   },
   "resource_id": {

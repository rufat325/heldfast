{
 "description": "[WRITE] Update an existing GTM environment (read-modify-write: omitted fields are preserved). Requires GTM_MCP_ENABLE_WRITES=true and confirm=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "description": "The GTM account ID.",
    "type": "string"
   },
   "confirm": {
    "description": "Must be true to confirm this write operation.",
    "type": "boolean"
   },
   "containerId": {
    "description": "The GTM container ID.",
    "type": "string"
   },
   "description": {
    "description": "New description.",
    "type": "string"
   },
   "enableDebug": {
    "description": "Whether to enable debug by default.",
    "type": "boolean"
   },
   "environmentId": {
    "description": "The GTM environment ID to update.",
    "type": "string"
   },
   "fingerprint": {
    "description": "Current fingerprint (for optimistic locking).",
    "type": "string"
   },
   "name": {
    "description": "New environment name.",
    "type": "string"
   },
   "url": {
    "description": "New default preview page URL.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "containerId",
   "environmentId",
   "confirm"
  ],
  "type": "object"
 },
 "name": "environments_update"
}

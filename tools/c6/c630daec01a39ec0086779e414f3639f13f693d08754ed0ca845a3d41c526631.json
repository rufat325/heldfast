{
 "description": "Extract named stills (screenshot mode) from the recorded take into output/stills/ \u2014 one PNG per `still` marker, pulled from the CLEAN take (no captions/zoom). Needs only a recorded timeline (no key). Returns a jobId immediately \u2014 poll job_status. Rejects if another job is running.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dir": {
    "description": "demo project directory \u2014 pass an absolute path",
    "type": "string"
   },
   "out": {
    "description": "output directory (default <dir>/output/stills)",
    "type": "string"
   }
  },
  "required": [
   "dir"
  ],
  "type": "object"
 },
 "name": "stills",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "demoDir": {
    "description": "resolved absolute demo directory",
    "type": "string"
   },
   "jobId": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "logFile": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "kind",
   "demoDir",
   "status",
   "logFile"
  ],
  "type": "object"
 }
}

{
 "description": "Analyze the transitive impact of changing a file. Uses BFS to find all direct and indirect dependents up to a configurable depth. Essential before refactoring.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "depth": {
    "default": 3,
    "description": "Max traversal depth (default 3, max 5)",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "file_path": {
    "description": "File to analyze impact of",
    "type": "string"
   },
   "project_name": {
    "description": "Project name",
    "type": "string"
   }
  },
  "required": [
   "project_name",
   "file_path"
  ],
  "type": "object"
 },
 "name": "impact_analysis"
}

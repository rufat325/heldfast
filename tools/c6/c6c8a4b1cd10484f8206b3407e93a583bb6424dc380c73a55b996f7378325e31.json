{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a new message immediately, starting a new thread. fmsg messages are immutable: once sent they cannot be edited or recalled. Send within the user's requested task or authorized automation. Recipients may be full @user@domain addresses or resolvable short names. The body is Markdown by default. Secrets (API keys, tokens) are redacted and the count reported. If the host rejects the message the host's own reason is returned verbatim. To continue an existing conversation use reply instead.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attachments": {
    "items": {
     "properties": {
      "content_type": {
       "type": "string"
      },
      "data_base64": {
       "minLength": 1,
       "type": "string"
      },
      "filename": {
       "pattern": "^[A-Za-z0-9._-]+$",
       "type": "string"
      }
     },
     "required": [
      "filename",
      "data_base64"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "body": {
    "description": "message body; Markdown unless type says otherwise",
    "type": "string"
   },
   "important": {
    "default": false,
    "type": "boolean"
   },
   "no_reply": {
    "default": false,
    "description": "ask recipients (and their agents) not to reply",
    "type": "boolean"
   },
   "to": {
    "description": "recipient addresses (@user@domain) or short names",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "topic": {
    "description": "thread topic (subject) \u2014 immutable once sent",
    "maxLength": 256,
    "type": "string"
   },
   "type": {
    "default": "text/markdown; charset=utf-8",
    "description": "body media type",
    "type": "string"
   }
  },
  "required": [
   "to",
   "topic",
   "body"
  ],
  "type": "object"
 },
 "name": "send_message",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "attachments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "filename": {
       "type": "string"
      },
      "size": {
       "type": "number"
      }
     },
     "required": [
      "filename",
      "size"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "parent_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "redactions": {
    "description": "secrets replaced with placeholders before sending",
    "type": "number"
   },
   "time": {
    "type": [
     "string",
     "null"
    ]
   },
   "to": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "topic": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "time",
   "from",
   "to",
   "topic",
   "parent_id",
   "attachments",
   "redactions",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Send new fmsg message"
}

{
 "description": "Compare a previous session_snapshot with the current Live state. Use after a mutation batch to verify what actually changed; returns added/removed/changed paths with before/after values and a change count.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "previous": {
    "additionalProperties": false,
    "properties": {
     "is_playing": {
      "type": "boolean"
     },
     "signature_denominator": {
      "type": "integer"
     },
     "signature_numerator": {
      "type": "integer"
     },
     "song_time": {
      "type": "number"
     },
     "tempo": {
      "type": "number"
     },
     "total_tracks": {
      "minimum": 0,
      "type": "integer"
     },
     "tracks": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "arm": {
         "type": "boolean"
        },
        "clips": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "is_playing": {
            "type": "boolean"
           },
           "length": {
            "type": "number"
           },
           "name": {
            "type": "string"
           },
           "slot": {
            "minimum": 0,
            "type": "integer"
           }
          },
          "required": [
           "slot",
           "name",
           "length",
           "is_playing"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "color_index": {
         "type": "integer"
        },
        "devices": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "class_name": {
            "type": "string"
           },
           "index": {
            "minimum": 0,
            "type": "integer"
           },
           "name": {
            "type": "string"
           }
          },
          "required": [
           "index",
           "name",
           "class_name"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "index": {
         "minimum": 0,
         "type": "integer"
        },
        "is_audio": {
         "type": "boolean"
        },
        "is_midi": {
         "type": "boolean"
        },
        "mute": {
         "type": "boolean"
        },
        "name": {
         "type": "string"
        },
        "panning": {
         "type": "number"
        },
        "solo": {
         "type": "boolean"
        },
        "volume": {
         "type": "number"
        }
       },
       "required": [
        "index",
        "name",
        "color_index",
        "is_midi",
        "is_audio",
        "mute",
        "solo",
        "arm",
        "volume",
        "panning"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "ts": {
      "type": "integer"
     }
    },
    "required": [
     "ts",
     "tempo",
     "is_playing",
     "song_time",
     "signature_numerator",
     "signature_denominator",
     "tracks",
     "total_tracks"
    ],
    "type": "object"
   }
  },
  "required": [
   "previous"
  ],
  "type": "object"
 },
 "name": "session_diff"
}

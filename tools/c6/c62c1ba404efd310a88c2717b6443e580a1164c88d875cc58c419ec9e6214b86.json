{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Rename one media asset, edit its description, move it to a folder, or change B-roll eligibility. Provide at least one of name, description, folderId, or allowUsingAsBroll.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "allowUsingAsBroll": {
    "description": "Whether the asset may be selected as B-roll.",
    "type": "boolean"
   },
   "assetId": {
    "description": "Media asset UUID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "description": {
    "description": "New description, or null to clear it.",
    "maxLength": 5000,
    "type": "string"
   },
   "folderId": {
    "description": "Target folder UUID, or null to move the asset to root.",
    "format": "uuid",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Retry key. Reuse only with identical inputs.",
    "type": "string"
   },
   "name": {
    "description": "New media asset name.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assetId"
  ],
  "type": "object"
 },
 "name": "media_assets_update",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "asset": {
    "type": "object"
   },
   "mutationReceipt": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ]
     },
     "operation": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "key",
     "operation",
     "status",
     "replayed"
    ],
    "type": "object"
   },
   "txid": {
    "type": [
     "number",
     "null"
    ]
   },
   "updatedFields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "asset",
   "updatedFields",
   "txid",
   "mutationReceipt"
  ],
  "type": "object"
 },
 "title": "Update Media Asset"
}

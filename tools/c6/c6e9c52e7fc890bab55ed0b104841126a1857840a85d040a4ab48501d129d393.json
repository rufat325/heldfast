{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Reply to support request"
 },
 "description": "Add a message to one of your existing Tango support tickets \u2014 answer a staff question, add the error output they asked for, or confirm the fix worked.",

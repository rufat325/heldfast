{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Send a message to a provider native session. Model, agent, and reasoning are separate controls. For OpenCode, accepted means transport queued the prompt and does not mean completion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent": {
    "minLength": 1,
    "type": "string"
   },
   "mode": {
    "enum": [
     "send",
     "steer"
    ],
    "type": "string"
   },
   "model": {
    "properties": {
     "modelID": {
      "minLength": 1,
      "type": "string"
     },
     "providerID": {
      "minLength": 1,
      "type": "string"
     },
     "variant": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "providerID",
     "modelID"
    ],
    "type": "object"
   },
   "nativeId": {
    "type": "string"
   },
   "provider": {
    "enum": [
     "freebuff",
     "opencode",
     "codex",
     "claude-code",
     "cursor"
    ],
    "type": "string"
   },
   "reasoning": {
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "maxLength": 100000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "provider",
   "nativeId",
   "text"
  ],
  "type": "object"
 },
 "name": "agent_send"
}

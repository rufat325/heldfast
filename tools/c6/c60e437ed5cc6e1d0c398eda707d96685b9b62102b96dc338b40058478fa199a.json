{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Update the world model after an action executes (moving an entity, modifying properties, destroying or creating objects).",
 "inputSchema": {
  "properties": {
   "action_name": {
    "description": "Name of the executed action (e.g. move_to, pickup, place, destroy)",
    "type": "string"
   },
   "destroyed": {
    "description": "If true, marks entity as destroyed",
    "type": "boolean"
   },
   "entity_id": {
    "description": "Primary entity affected",
    "type": "string"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   },
   "property_changes": {
    "description": "Updated properties to merge",
    "type": "object"
   },
   "resulting_position": {
    "description": "New position of entity after action",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "success": {
    "description": "Whether the action succeeded",
    "type": "boolean"
   },
   "task_id": {
    "description": "Linked task ID",
    "type": "string"
   }
  },
  "required": [
   "action_name",
   "success"
  ],
  "type": "object"
 },
 "name": "record_outcome"
}

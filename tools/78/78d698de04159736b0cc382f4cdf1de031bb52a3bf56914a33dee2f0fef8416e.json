{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List all email identities (addresses) on this server.",
 "inputSchema": {
  "properties": {},
  "type": "object"
 },
 "name": "mail_list_identities",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "identities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "maxLength": 320,
       "pattern": "^[a-z0-9][a-z0-9._-]{0,62}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.?$",
       "type": "string"
      },
      "canNotifyUser": {
       "type": "boolean"
      },
      "createdAt": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "parentIdentity": {
       "type": "string"
      },
      "pushContentTier": {
       "anyOf": [
        {
         "const": 1,
         "type": "number"
        },
        {
         "const": 2,
         "type": "number"
        },
        {
         "const": 3,
         "type": "number"
        }
       ]
      },
      "pushContentTierWarning": {
       "type": "string"
      },
      "scopes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "token": {
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "identities"
  ],
  "type": "object"
 },
 "title": "List Email Identities"
}

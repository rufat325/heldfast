{
 "description": "Get TikTok Shop product reviews. Works for most IDs even when get_tiktok_shop_product returns 404. Paginate with has_more. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "has_media": {
    "description": "Only reviews with media.",
    "type": "boolean"
   },
   "page": {
    "description": "1-based page number.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Reviews per page (default 20).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "product_id": {
    "description": "Product ID.",
    "pattern": "^\\d{6,25}$",
    "type": "string"
   },
   "rating": {
    "description": "Filter by star rating.",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "region": {
    "description": "Region: US (default), GB, SG, MY, PH, TH, VN, ID.",
    "enum": [
     "US",
     "GB",
     "SG",
     "MY",
     "PH",
     "TH",
     "VN",
     "ID"
    ],
    "type": "string"
   },
   "sort": {
    "description": "'relevant' (default) or 'recent'.",
    "enum": [
     "relevant",
     "recent"
    ],
    "type": "string"
   },
   "verified_only": {
    "description": "Only verified purchases.",
    "type": "boolean"
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "get_tiktok_shop_product_reviews"
}

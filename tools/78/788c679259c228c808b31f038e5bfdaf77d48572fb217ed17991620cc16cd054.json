 "description": "Natural hazard events tracked by NASA EONET (the Earth Observatory Natural Event Tracker): wildfires, severe storms, volcanoes, floods, icebergs, landslides, dust and haze. Filter by open or closed status, lookback days, category id, bounding box, reporting source, and magnitude range. Returns each event id, title, category, date-stamped geometry (point or polygon), and links to the reporting agency, answering where wildfires, storms, or eruptions are active now and where they occurred recently.",
 "inputSchema": {
  "examples": [
   {
    "days": 30,
    "limit": 50,
    "status": "open"
   },
   {
    "bbox": "-120,40,-110,35",
    "category": "wildfires,severeStorms",
    "days": 60,
    "status": "all"
   }
  ],
  "properties": {
   "bbox": {
    "description": "Bounding box: \"min_lon,max_lat,max_lon,min_lat\" (note non-standard order)",
    "type": "string"
   },
   "category": {
    "description": "Comma-sep category ids (e.g. \"wildfires,severeStorms\")",
    "type": "string"
   },
   "days": {
    "description": "Lookback window in days (default 30, default 30 for closed)",
    "type": "number"
   },
   "limit": {
    "description": "Max results",
    "type": "number"
   },
   "magnitude_id": {
    "description": "Filter by magnitude id (e.g. \"ac\" for acres)",
    "type": "string"
   },
   "magnitude_max": {
    "description": "Maximum magnitude",
    "type": "number"
   },
   "magnitude_min": {
    "description": "Minimum magnitude",
    "type": "number"
   },
   "source": {
    "description": "Comma-sep source ids (see list_sources)",
    "type": "string"
   },
   "status": {
    "description": "open (default) | closed | all",
    "type": "string"
   }
  },
  "type": "object"
 },

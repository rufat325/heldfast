{
 "_meta": {
  "ui": {
   "resourceUri": "ui://socialfetch/v1/search-list.html"
  },
  "ui/resourceUri": "ui://socialfetch/v1/search-list.html"
 },
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search Hacker News by keyword. Returns a list (use page/pageSize when paginated).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "author": {
    "description": "Restrict results to items by this Hacker News username.",
    "maxLength": 255,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "context": {
    "description": "Describe the user's underlying goal in one sentence \u2014 not the tool you are calling.",
    "type": "string"
   },
   "conversation_id": {
    "description": "Echo the conversation_id from the server's previous response. The server provides it on the first call \u2014 never invent one, and do not issue parallel tool calls until you have it.",
    "type": "string"
   },
   "dateRange": {
    "description": "Creation-time window. Default: `all`.",
    "enum": [
     "24h",
     "week",
     "month",
     "year",
     "all"
    ],
    "type": "string"
   },
   "domain": {
    "description": "Restrict search to story URLs matching this domain (e.g. example.com). Can omit `query`.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "frontPageOnly": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "0",
       "1",
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "When true, restrict results to current front-page items. Allows omitting `query`."
   },
   "keywords": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `query`. Prefer `query`."
   },
   "limit": {
    "anyOf": [
     {
      "const": 10,
      "type": "number"
     },
     {
      "const": 20,
      "type": "number"
     },
     {
      "const": 30,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     }
    ],
    "description": "Hits per page. Must be one of 10, 20, 30, 50. Default: 20. Prefer this over `pageSize`."
   },
   "link": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "llm_model": {
    "description": "The exact model identifier you (the assistant) are running as, taken from your system prompt or environment (e.g. \"claude-opus-4-8\", \"gpt-5.2\"). Used for analytics only. If you do not know your model identifier with certainty, pass \"unknown\" \u2014 never guess.",
    "type": "string"
   },
   "maxResults": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "max_results": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "minPoints": {
    "description": "Minimum points/score filter.",
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "page": {
    "description": "Zero-based page index (maximum 50 pages, up to 1,000 hits).",
    "maximum": 49,
    "minimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "anyOf": [
     {
      "const": 10,
      "type": "number"
     },
     {
      "const": 20,
      "type": "number"
     },
     {
      "const": 30,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     }
    ],
    "description": "Deprecated alias for `limit`. When both are set, `limit` wins."
   },
   "path": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "permalink": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "prefix": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "0",
       "1",
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "When true, enable prefix matching for query tokens."
   },
   "q": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `query`. Prefer `query`."
   },
   "query": {
    "description": "Full-text search query. Required unless `frontPageOnly`, `author`, `domain`, or `url` is set.",
    "maxLength": 512,
    "type": "string"
   },
   "searchAuthor": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "0",
       "1",
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "When true, include author username in the searchable fields."
   },
   "searchStoryText": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "0",
       "1",
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Include story/comment text in searchable fields. Default: true. Set false to search title/URL only."
   },
   "sort": {
    "description": "Ranking mode. Default: `popularity`.",
    "enum": [
     "popularity",
     "date"
    ],
    "type": "string"
   },
   "trim": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Ignored if this tool does not support it."
   },
   "tweetId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "tweetUrl": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "tweet_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "tweet_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     }
    ],
    "description": "Alias for `url`. Prefer `url`."
   },
   "type": {
    "description": "Restrict search results to a Hacker News content type. `ask_hn`: Ask HN posts (questions to the community). `show_hn`: Show HN posts (projects/work being shared). `launch_hn`: Launch HN posts (YC-affiliated company launches). Default: `all`.",
    "enum": [
     "all",
     "story",
     "comment",
     "ask_hn",
     "show_hn",
     "launch_hn",
     "job",
     "poll"
    ],
    "type": "string"
   },
   "typoTolerance": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "0",
       "1",
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Enable typo tolerance. Default: true."
   },
   "url": {
    "description": "Restrict search to story URLs matching this URL substring. Can omit `query`.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "context",
   "llm_model"
  ],
  "type": "object"
 },
 "name": "hackernews_search_list",
 "title": "Search Hacker News"
}

{
 "description": "Create a Wan task on RunAPI (speech to video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "callback_url": {
    "type": "string"
   },
   "enable_safety_checker": {
    "type": "boolean"
   },
   "frames_per_second": {
    "type": "number"
   },
   "guidance_scale": {
    "type": "number"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "wan-2.2-a14b-speech-to-video-turbo"
    ],
    "type": "string"
   },
   "negative_prompt": {
    "type": "string"
   },
   "num_frames": {
    "type": "number"
   },
   "num_inference_steps": {
    "type": "number"
   },
   "output_resolution": {
    "enum": [
     "480p",
     "580p",
     "720p"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "seed": {
    "type": "number"
   },
   "shift": {
    "type": "number"
   },
   "source_audio_url": {
    "type": "string"
   },
   "source_image_url": {
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "source_image_url",
   "source_audio_url",
   "prompt"
  ],
  "type": "object"
 },
 "name": "speech_to_video"
}

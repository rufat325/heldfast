{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Providers"
 },
 "description": "Browse the AntFeed provider directory page by page. Use to discover sellers; use lookup for substring search, get_pricing for a single (peerId, service) lookup. sort: score (USDC earned, default) | recent (last refresh). Returns up to limit providers per page, plus an opaque nextCursor for the next page.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque pagination token returned by a previous call. Omit for the first page.",
    "maxLength": 256,
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max providers per page (default 50, max 200).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "default": "score",
    "description": "score = total USDC earned; recent = newest in directory (by last-refresh timestamp).",
    "enum": [
     "score",
     "recent"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_providers",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "nextCursor": {
    "description": "Pass back as `cursor` to fetch the next page. Absent when no more results.",
    "type": "string"
   },
   "providers": {
    "items": {
     "properties": {
      "displayName": {
       "type": "string"
      },
      "ghostRate": {
       "description": "ghostCount / closedCount, null when closedCount=0",
       "type": [
        "number",
        "null"
       ]
      },
      "lastUpdated": {
       "description": "ISO timestamp",
       "type": [
        "string",
        "null"
       ]
      },
      "peerId": {
       "pattern": "^0x[0-9a-fA-F]{40}$",
       "type": "string"
      },
      "pricingSummary": {
       "properties": {
        "maxInputUsdPerMillion": {
         "type": [
          "number",
          "null"
         ]
        },
        "minInputUsdPerMillion": {
         "type": [
          "number",
          "null"
         ]
        },
        "servicesPriced": {
         "type": "integer"
        }
       },
       "required": [
        "minInputUsdPerMillion",
        "maxInputUsdPerMillion",
        "servicesPriced"
       ],
       "type": "object"
      },
      "region": {
       "type": [
        "string",
        "null"
       ]
      },
      "services": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "sessionCount": {
       "type": "integer"
      },
      "totalVolumeUsdc": {
       "type": "number"
      }
     },
     "required": [
      "peerId",
      "displayName",
      "region",
      "services",
      "pricingSummary",
      "sessionCount",
      "totalVolumeUsdc",
      "ghostRate",
      "lastUpdated"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sort": {
    "enum": [
     "score",
     "recent"
    ],
    "type": "string"
   },
   "total": {
    "description": "Total providers across all pages",
    "type": "integer"
   }
  },
  "required": [
   "providers",
   "total",
   "sort"
  ],
  "type": "object"
 }
}

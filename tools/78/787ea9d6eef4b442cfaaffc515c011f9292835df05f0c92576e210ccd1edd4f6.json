{
 "description": "List all types (classes, structs, enums, interfaces) in a loaded assembly.",
 "inputSchema": {
  "properties": {
   "assembly": {
    "description": "Assembly key (from load_assembly)",
    "type": "string"
   },
   "base_type": {
    "description": "Filter by base type name",
    "type": "string"
   },
   "filter": {
    "description": "Filter by name (substring match)",
    "type": "string"
   },
   "kind": {
    "description": "Filter by kind: class, struct, enum, interface",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 200)",
    "type": "number"
   }
  },
  "required": [
   "assembly"
  ],
  "type": "object"
 },
 "name": "list_types"
}

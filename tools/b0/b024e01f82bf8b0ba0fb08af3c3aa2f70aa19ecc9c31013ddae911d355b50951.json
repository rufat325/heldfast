{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Highest-risk destructive write: send money outward through ZEN. Verify recipient, channel, currency, and amount before use.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ]
   },
   "currency": {
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "customerEmail": {
    "format": "email",
    "type": "string"
   },
   "customerFirstName": {
    "minLength": 1,
    "type": "string"
   },
   "customerLastName": {
    "minLength": 1,
    "type": "string"
   },
   "customerPhone": {
    "minLength": 3,
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "merchantTransactionId": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "paymentChannel": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "amount",
   "currency",
   "paymentChannel",
   "merchantTransactionId"
  ],
  "type": "object"
 },
 "name": "create_payout",
 "title": "Create payout"
}

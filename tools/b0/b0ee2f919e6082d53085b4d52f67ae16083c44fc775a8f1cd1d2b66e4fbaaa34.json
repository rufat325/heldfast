{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false,
  "title": "Disable a worker's webhook"
 },
 "description": "Stop pushing events to this worker's webhook URL. Future events fall back to polling.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "worker_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "worker_id"
  ],
  "type": "object"
 },
 "name": "clear_webhook",
 "title": "Disable a worker's webhook"
}

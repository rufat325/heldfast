{
 "description": "Given raw data and a natural-language description of intent (e.g., 'show quarterly sales trends'), ChartOne's AI picks the best chart type and theme, renders the chart, and returns it with a rationale.",
 "inputSchema": {
  "properties": {
   "data": {
    "properties": {
     "datasets": {
      "items": {
       "properties": {
        "data": {
         "type": "array"
        },
        "label": {
         "type": "string"
        },
        "size": {
         "type": "array"
        },
        "x": {
         "type": "array"
        },
        "y": {
         "type": "array"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "labels": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "datasets"
    ],
    "type": "object"
   },
   "format": {
    "default": "png",
    "enum": [
     "png",
     "jpeg",
     "svg"
    ],
    "type": "string"
   },
   "height": {
    "default": 400,
    "maximum": 4000,
    "minimum": 100,
    "type": "number"
   },
   "user_intent": {
    "maxLength": 500,
    "minLength": 3,
    "type": "string"
   },
   "width": {
    "default": 800,
    "maximum": 4000,
    "minimum": 100,
    "type": "number"
   }
  },
  "required": [
   "data",
   "user_intent"
  ],
  "type": "object"
 },
 "name": "suggest_chart"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a market-wide summary of institutional exposure to US spot crypto ETFs (Bitcoin ETF complex: IBIT, FBTC, GBTC, etc.) from the latest quarter of SEC 13F filings. Returns total institutional USD held, quarter-over-quarter change, and a per-ETF breakdown (holders, USD, QoQ).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_crypto_exposure",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "complex": {
    "additionalProperties": false,
    "properties": {
     "products": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "qoq_change": {
      "$ref": "#/properties/complex/properties/total_usd"
     },
     "total_usd": {
      "anyOf": [
       {
        "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
     }
    },
    "required": [
     "total_usd",
     "qoq_change",
     "products"
    ],
    "type": "object"
   },
   "products": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "holders": {
       "$ref": "#/properties/complex/properties/products"
      },
      "prev_usd": {
       "$ref": "#/properties/complex/properties/total_usd"
      },
      "product_name": {
       "$ref": "#/properties/products/items/properties/product_ticker"
      },
      "product_ticker": {
       "type": [
        "string",
        "null"
       ]
      },
      "qoq_change": {
       "$ref": "#/properties/complex/properties/total_usd"
      },
      "sponsor": {
       "$ref": "#/properties/products/items/properties/product_ticker"
      },
      "total_usd": {
       "$ref": "#/properties/complex/properties/total_usd"
      }
     },
     "required": [
      "product_ticker",
      "product_name",
      "sponsor",
      "holders",
      "total_usd",
      "prev_usd",
      "qoq_change"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "complex",
   "products"
  ],
  "type": "object"
 }
}

 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get bounded, source-backed property context for a commune, with source dates and unknown states.",
 "execution": {
  "taskSupport": "forbidden"
 },

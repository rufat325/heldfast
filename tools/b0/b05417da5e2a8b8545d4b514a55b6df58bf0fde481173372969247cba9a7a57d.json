  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "commune": {
    "description": "Luxembourg commune slug or name (e.g. 'luxembourg', 'esch-sur-alzette', 'kirchberg')",
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "description": "Response locale: en, fr, de, lu (Luxembourgish), pt (default: en; 'lb' is a deprecated alias for 'lu')",
    "enum": [
     "en",
     "fr",
     "de",
     "lu",
     "pt",
     "lb"
    ],
    "type": "string"
   }
  },
  "required": [
   "commune"
  ],
  "type": "object"
 },
 "name": "get_market_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "commune": {
    "type": "string"
   },
   "trust": {
    "additionalProperties": {},
    "properties": {
     "confidence": {
      "enum": [
       "low",
       "medium",
       "high",
       "unknown"
      ],
      "type": "string"
     },
     "fallback": {
      "type": "boolean"
     },
     "freshness": {
      "enum": [
       "fresh",
       "recent",
       "stale",
       "unknown"
      ],
      "type": "string"
     },
     "generatedAt": {
      "type": "string"
     },
     "missingFields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sources",
     "confidence",
     "freshness"
    ],
    "type": "object"
   }
  },
  "required": [
   "commune",
   "trust"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {

{
 "description": "Create a refund for an order",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lineItems": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "lineItemId": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "restockType": {
       "enum": [
        "NO_RESTOCK",
        "RETURN",
        "CANCEL"
       ],
       "type": "string"
      }
     },
     "required": [
      "lineItemId",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "notify": {
    "default": true,
    "type": "boolean"
   },
   "orderId": {
    "description": "The order ID to refund",
    "type": "string"
   },
   "refundDuties": {
    "type": "boolean"
   },
   "shipping": {
    "additionalProperties": false,
    "properties": {
     "amount": {
      "type": "string"
     },
     "fullRefund": {
      "type": "boolean"
     }
    },
    "required": [
     "amount"
    ],
    "type": "object"
   }
  },
  "required": [
   "orderId"
  ],
  "type": "object"
 },
 "name": "createRefund"
}

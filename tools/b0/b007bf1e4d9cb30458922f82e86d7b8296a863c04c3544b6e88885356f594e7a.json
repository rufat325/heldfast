{
 "description": "Animate one still project image into a video clip (Runway Gen-4). Async \u2014 returns a jobId; poll get_clip_status. imageUrl is auto-resolved from the project if omitted. Costs credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspectRatio": {
    "type": "string"
   },
   "customMotionPrompt": {
    "description": "Required when motion='custom'.",
    "maxLength": 500,
    "type": "string"
   },
   "duration": {
    "description": "Seconds, 3-10 (default 5).",
    "maximum": 10,
    "minimum": 3,
    "type": "number"
   },
   "imageId": {
    "type": "string"
   },
   "imageUrl": {
    "description": "Auto-resolved from the project if omitted.",
    "format": "uri",
    "type": "string"
   },
   "motion": {
    "enum": [
     "auto",
     "zoom_in",
     "zoom_out",
     "no_motion",
     "orbit",
     "orbit_left",
     "orbit_right",
     "drone",
     "custom"
    ],
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "resolution": {
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "imageId",
   "motion"
  ],
  "type": "object"
 },
 "name": "generate_clip",
 "title": "Generate a video clip from a project image"
}

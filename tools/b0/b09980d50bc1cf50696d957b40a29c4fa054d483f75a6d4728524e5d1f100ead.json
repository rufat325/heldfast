{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Share 1-20 concise, user-authorized context observations so SomaCheck can prepare richer propositions. Send derived summaries only\u2014never raw conversation text, photos, credentials, identifiers, or diagnostic claims.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "observations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "confidence": {
       "default": 0.8,
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "evidence_count": {
       "default": 1,
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      },
      "summary": {
       "description": "A concise derived theme or fact the person authorized you to share. Never paste raw conversations.",
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "type": {
       "enum": [
        "goal",
        "project",
        "decision",
        "commitment",
        "tension",
        "question",
        "blindSpot",
        "relationship",
        "situation",
        "change",
        "deadline",
        "development",
        "moodTheme",
        "preference"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "summary"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "observations"
  ],
  "type": "object"
 },
 "name": "share_somacheck_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accepted": {
    "type": "boolean"
   },
   "observation_count": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "const": "ready",
    "type": "string"
   }
  },
  "required": [
   "accepted",
   "state",
   "observation_count"
  ],
  "type": "object"
 },
 "title": "Give SomaCheck context"
}

{
 "description": "Get one Smart Money account profile plus recent extracted prediction calls (default last 14 days).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "Claim window in days (default 14)",
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "description": "Max claims (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "username": {
    "description": "Handle without @",
    "type": "string"
   }
  },
  "required": [
   "username"
  ],
  "type": "object"
 },
 "name": "xflux_smart_money_profile"
}

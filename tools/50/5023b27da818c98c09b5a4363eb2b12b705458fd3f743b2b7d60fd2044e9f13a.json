 "description": "Search news articles by keywords. Optionally filter by category (business, technology, science, health, sports, entertainment, general), country (ISO2 codes), or language. Returns headlines, descriptions, sources, and published dates.",
 "inputSchema": {
  "examples": [
   {
    "_apiKey": "your-mediastack-api-key",
    "keywords": "artificial intelligence"
   },
   {
    "_apiKey": "your-mediastack-api-key",
    "categories": "science,general",
    "countries": "us,gb,de",
    "keywords": "climate summit",
    "limit": 50
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "Mediastack API key",
    "type": "string"
   },
   "categories": {
    "description": "Comma-separated categories: business, technology, science, health, sports, entertainment, general",
    "type": "string"
   },
   "countries": {
    "description": "Comma-separated ISO2 country codes (e.g., \"us,gb,de\")",
    "type": "string"
   },
   "keywords": {
    "description": "Search keywords (e.g., \"artificial intelligence\", \"climate summit\")",
    "type": "string"
   },
   "languages": {
    "description": "Comma-separated language codes (e.g., \"en,es,fr\")",
    "type": "string"
   },
   "limit": {
    "description": "Max results to return (1-100, default 25)",
    "type": "number"
   }
  },
  "required": [
   "_apiKey",
   "keywords"
  ],
  "type": "object"
 },
 "name": "search_news",

{
 "description": "Create a Web2-style INVOICE (number, line items, due date, bill-to) on the SAME non-custodial registry: paid by the same EIP-681 intent, verified by the same chain discipline, recorded in the same provable till roll. Returns the invoice + a human-readable bill (EN/FR) + the payment URI.",
 "inputSchema": {
  "properties": {
   "billTo": {
    "type": "string"
   },
   "dueDateMs": {
    "type": "number"
   },
   "lang": {
    "description": "\"en\" (default) or \"fr\"",
    "type": "string"
   },
   "lineItems": {
    "description": "[{description, amountUsd} or {description, qty, unitUsd}]",
    "items": {
     "properties": {
      "amountUsd": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "qty": {
       "type": "number"
      },
      "unitUsd": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "merchantName": {
    "type": "string"
   },
   "number": {
    "type": "string"
   },
   "to": {
    "description": "merchant 0x address (their own wallet \u2014 non-custodial)",
    "type": "string"
   }
  },
  "required": [
   "to",
   "lineItems"
  ],
  "type": "object"
 },
 "name": "till_create_invoice"
}

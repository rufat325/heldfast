{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search listed securities (equities) across African exchanges",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country_code": {
    "description": "Filter by country",
    "type": "string"
   },
   "exchange_code": {
    "description": "Filter by exchange (e.g. \"NGX\")",
    "type": "string"
   },
   "instrument_type": {
    "description": "Filter by instrument type",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Max results",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Search by name or symbol",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_tickers"
}

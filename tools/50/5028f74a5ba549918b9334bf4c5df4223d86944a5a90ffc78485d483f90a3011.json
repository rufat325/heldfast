{
 "description": "Submit feedback about gitmem \u2014 feature requests, bug reports, friction points, or suggestions. Always saved locally to .gitmem/feedback/. If opted in, sent anonymously to improve gitmem. 10/session limit.",
 "inputSchema": {
  "properties": {
   "context": {
    "description": "When/how this came up",
    "type": "string"
   },
   "description": {
    "description": "Detailed, actionable feedback. Min 20 chars.",
    "type": "string"
   },
   "severity": {
    "description": "Impact: low=nice-to-have, medium=notable friction, high=blocking/broken",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "suggested_fix": {
    "description": "How this could be improved",
    "type": "string"
   },
   "tool": {
    "description": "Which gitmem tool this relates to (e.g., 'recall', 'session_close')",
    "type": "string"
   },
   "type": {
    "description": "Feedback type",
    "enum": [
     "feature_request",
     "bug_report",
     "friction",
     "suggestion"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "tool",
   "description",
   "severity"
  ],
  "type": "object"
 },
 "name": "contribute_feedback"
}

{
 "annotations": {
  "title": "Session Scroll"
 },
 "description": "Scroll the page up or down by a number of viewport-heights.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "default": 3,
    "description": "Scroll amount in viewport-heights (default: 3)",
    "format": "uint32",
    "minimum": 0,
    "type": "integer"
   },
   "direction": {
    "default": "down",
    "description": "Scroll direction: \"up\" or \"down\" (default: down)",
    "type": "string"
   },
   "session_id": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "session_scroll"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get U.S. Treasury yield curve data \u2014 daily yields for maturities from 1-month to 30-year. Essential for understanding interest rate environment and yield curve shape.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "default": 30,
    "description": "Days of daily history to return, 1-3650 (default 30 = last month)",
    "maximum": 3650,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_treasury_yields",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": [
        "string",
        "null"
       ]
      },
      "m1": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
      },
      "m3": {
       "$ref": "#/properties/rows/items/properties/m1"
      },
      "m6": {
       "$ref": "#/properties/rows/items/properties/m1"
      },
      "y1": {
       "$ref": "#/properties/rows/items/properties/m1"
      },
      "y10": {
       "$ref": "#/properties/rows/items/properties/m1"
      },
      "y2": {
       "$ref": "#/properties/rows/items/properties/m1"
      },
      "y30": {
       "$ref": "#/properties/rows/items/properties/m1"
      },
      "y5": {
       "$ref": "#/properties/rows/items/properties/m1"
      }
     },
     "required": [
      "date",
      "m1",
      "m3",
      "m6",
      "y1",
      "y2",
      "y5",
      "y10",
      "y30"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "unit": {
    "const": "percent",
    "type": "string"
   }
  },
  "required": [
   "unit",
   "rows"
  ],
  "type": "object"
 }
}

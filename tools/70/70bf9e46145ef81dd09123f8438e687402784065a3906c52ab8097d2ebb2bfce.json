{
 "description": "Boot an AVD in the background and wait until Android finishes booting. Returns the adb serial. Set wipeData to factory-reset the AVD on boot.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "avdName": {
    "description": "AVD name from list_avds",
    "type": "string"
   },
   "timeoutSeconds": {
    "description": "Boot timeout (default 180)",
    "type": "integer"
   },
   "wipeData": {
    "description": "Factory-reset the AVD (erases all data)",
    "type": "boolean"
   }
  },
  "required": [
   "avdName"
  ],
  "type": "object"
 },
 "name": "boot_emulator",
 "title": "Boot emulator"
}

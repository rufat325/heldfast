{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Write content to a file through Gatekeeper. Subject to policy (allow / approve / deny). Returns the path and bytes written on allow.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "File content to write.",
    "type": "string"
   },
   "encoding": {
    "const": "utf8",
    "type": "string"
   },
   "path": {
    "description": "Destination file path.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "path",
   "content"
  ],
  "type": "object"
 },
 "name": "files_write",
 "title": "Write a file (policy-gated)"
}

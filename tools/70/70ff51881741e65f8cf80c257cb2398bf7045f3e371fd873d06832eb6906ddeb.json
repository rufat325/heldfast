{
 "description": "Search candidate resumes by keywords, region, professional role, salary, experience. Requires an EMPLOYER OAuth token (HH_ACCESS_TOKEN) AND a paid hh.ru resume-database subscription \u2014 applicant/anonymous tokens get 403.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "area": {
    "description": "Region code (1=Moscow, 2=Saint Petersburg)",
    "type": "number"
   },
   "experience": {
    "description": "Experience level",
    "enum": [
     "noExperience",
     "between1And3",
     "between3And6",
     "moreThan6"
    ],
    "type": "string"
   },
   "page": {
    "default": 0,
    "description": "Page number (0-based)",
    "minimum": 0,
    "type": "integer"
   },
   "per_page": {
    "default": 20,
    "description": "Results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "professional_role": {
    "description": "Professional role ID. Use get_professional_roles to find IDs.",
    "type": "number"
   },
   "raw": {
    "description": "Return the full raw hh.ru JSON instead of the compact summary.",
    "type": "boolean"
   },
   "salary": {
    "description": "Expected salary amount",
    "type": "number"
   },
   "text": {
    "description": "Search keywords (skills, job title, etc.)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_resumes"
}

{
 "_legacy": {
  "bucket": "discovery",
  "successor": "https://api.trusteed.xyz/demo-store/mcp/discovery"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare 2 to 5 products side-by-side with normalized attribute table and best-value recommendation.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "product_ids": {
    "description": "Array of product IDs to compare (2-5)",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "product_ids"
  ],
  "type": "object"
 },
 "name": "compare_products",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "bestValue": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {
       "productId": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "productId",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "commonFields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "comparisonTable": {
    "additionalProperties": {
     "additionalProperties": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "object"
   },
   "products": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "attributes": {
       "items": {
        "additionalProperties": true,
        "properties": {
         "key": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "key",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "availability": {
       "type": "string"
      },
      "averageRating": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "number"
          }
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "currency": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "rating_provenance": {
       "anyOf": [
        {
         "additionalProperties": true,
         "properties": {
          "note": {
           "type": "string"
          },
          "origin": {
           "const": "merchant",
           "type": "string"
          },
          "strength": {
           "const": "claimed",
           "type": "string"
          },
          "verified": {
           "const": false,
           "type": "boolean"
          }
         },
         "required": [
          "origin",
          "strength",
          "verified",
          "note"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "reviewCount": {
       "type": "number"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "price",
      "currency",
      "availability",
      "reviewCount",
      "attributes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "recommendation_provenance_warning": {
    "type": "string"
   }
  },
  "required": [
   "products",
   "commonFields",
   "comparisonTable",
   "bestValue"
  ],
  "type": "object"
 }
}

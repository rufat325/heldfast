{
 "description": "List unified financial movements (AP + AR + CC) in Omie ERP",
 "inputSchema": {
  "properties": {
   "cNatureza": {
    "description": "Nature (R=receivable, P=payable, T=all)",
    "enum": [
     "R",
     "P",
     "T"
    ],
    "type": "string"
   },
   "cStatus": {
    "description": "Status (ABERTO, LIQUIDADO, VENCIDO, etc.)",
    "type": "string"
   },
   "dDtPagtoAte": {
    "description": "Payment date to (DD/MM/YYYY)",
    "type": "string"
   },
   "dDtPagtoDe": {
    "description": "Payment date from (DD/MM/YYYY)",
    "type": "string"
   },
   "nPagina": {
    "description": "Page number (default 1)",
    "type": "number"
   },
   "nRegPorPagina": {
    "description": "Records per page (default 50)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "list_financial_movements"
}

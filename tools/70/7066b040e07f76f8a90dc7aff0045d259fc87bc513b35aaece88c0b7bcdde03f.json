{
 "description": "Merge multiple local PDFs into one, in the given order. Files stay on disk.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "inputs": {
    "description": "Input PDF paths, in order",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "output": {
    "description": "Path to write the merged PDF",
    "type": "string"
   }
  },
  "required": [
   "inputs",
   "output"
  ],
  "type": "object"
 },
 "name": "pdf_merge",
 "title": "Merge PDFs (local, private)"
}

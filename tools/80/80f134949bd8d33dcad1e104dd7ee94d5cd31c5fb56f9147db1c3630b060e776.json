{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Resolve a team name or partial name to canonical records and source IDs across providers, optionally scoped to a league. Returns full name, league, logo URL, venue, and ESPN, MLB, and TheSportsDB IDs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "league": {
    "description": "Narrow search to a specific league. Optional but recommended for faster results.",
    "enum": [
     "nfl",
     "nba",
     "mlb",
     "nhl",
     "epl",
     "mls",
     "laliga",
     "bundesliga",
     "seriea",
     "ligue1",
     "ucl",
     "ncaaf",
     "ncaab"
    ],
    "type": "string"
   },
   "query": {
    "description": "Team name or partial name to search for, e.g. \"Mariners\", \"Man United\", \"Seattle Seahawks\".",
    "maxLength": 200,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "sports_find_team",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "teams",
     "query",
     "totalFound"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `no_match`: No team matched the query across any source. Other values are possible when a failure originates below the handler.",
        "examples": [
         "no_match"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "query": {
    "description": "The search query used.",
    "type": "string"
   },
   "teams": {
    "description": "Matching teams found across sources.",
    "items": {
     "additionalProperties": false,
     "description": "A matched team record.",
     "properties": {
      "abbreviation": {
       "description": "Team abbreviation.",
       "type": "string"
      },
      "displayName": {
       "description": "Full display name (e.g. \"Seattle Seahawks\").",
       "type": "string"
      },
      "espnId": {
       "description": "ESPN numeric team ID, or null if not found in ESPN.",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Primary source-prefixed ID for this record.",
       "type": "string"
      },
      "league": {
       "description": "League this team plays in.",
       "type": "string"
      },
      "location": {
       "description": "Team city or location.",
       "type": "string"
      },
      "logoUrl": {
       "description": "Team logo or badge URL, or null if unavailable.",
       "type": [
        "string",
        "null"
       ]
      },
      "mlbId": {
       "description": "MLB StatsAPI team ID, or null if not an MLB team.",
       "type": [
        "number",
        "null"
       ]
      },
      "name": {
       "description": "Team name (e.g. \"Seahawks\").",
       "type": "string"
      },
      "source": {
       "description": "Data source that provided this team record.",
       "enum": [
        "espn",
        "mlbstats",
        "thesportsdb"
       ],
       "type": "string"
      },
      "tsdbId": {
       "description": "TheSportsDB team ID, or null if not found.",
       "type": [
        "string",
        "null"
       ]
      },
      "venueName": {
       "description": "Home venue name, or null if unavailable.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "espnId",
      "mlbId",
      "tsdbId",
      "name",
      "abbreviation",
      "location",
      "displayName",
      "league",
      "logoUrl",
      "venueName",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalFound": {
    "description": "Total number of matching records.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Sports Find Team"
}

 "description": "Draw cards from a deck. Returns card details (suit, value) and remaining count. Specify count to draw multiple cards at once.",
 "inputSchema": {
  "examples": [
   {
    "deck_id": "3p40paa87x90"
   },
   {
    "count": 5,
    "deck_id": "3p40paa87x90"
   }
  ],
  "properties": {
   "count": {
    "description": "Number of cards to draw. Defaults to 1.",
    "type": "number"
   },
   "deck_id": {
    "description": "The deck ID returned by new_deck (e.g. \"3p40paa87x90\").",
    "type": "string"
   }
  },
  "required": [
   "deck_id"
  ],
  "type": "object"
 },
 "name": "draw_cards",
 "outputSchema": {
  "properties": {
   "cards": {
    "description": "Array of cards drawn",
    "items": {
     "properties": {
      "code": {
       "description": "Card code (e.g., '2H', 'AS')",
       "type": "string"
      },
      "image": {
       "description": "URL to card image",
       "type": "string"
      },
      "suit": {
       "description": "Card suit (e.g., 'HEARTS', 'DIAMONDS')",
       "type": "string"
      },
      "value": {
       "description": "Card value (e.g., '2', 'ACE', 'KING')",
       "type": "string"
      }
     },
     "required": [
      "code",
      "value",
      "suit",
      "image"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "deck_id": {
    "description": "Unique identifier for the deck",
    "type": "string"
   },
   "remaining": {
    "description": "Number of cards remaining in the deck",
    "type": "number"
   }
  },
  "required": [
   "deck_id",
   "cards",
   "remaining"
  ],
  "type": "object"
 },
 "title": "Draw Cards",
 "version": "v1.0c854755"

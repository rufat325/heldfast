{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Render model space, a paper-space layout, or one layout viewport as PNG or SVG.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "background": {
    "default": "paper",
    "enum": [
     "model",
     "paper",
     "transparent",
     "white",
     "black"
    ],
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "format": {
    "default": "png",
    "enum": [
     "png",
     "svg"
    ],
    "type": "string"
   },
   "height": {
    "default": 1200,
    "maximum": 4096,
    "minimum": 1,
    "type": "integer"
   },
   "padding": {
    "default": 0.02,
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "region": {
    "additionalProperties": false,
    "properties": {
     "max": {
      "items": {
       "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
     },
     "min": {
      "items": {
       "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
     }
    },
    "required": [
     "min",
     "max"
    ],
    "type": "object"
   },
   "target": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "model"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "layout"
       },
       "layoutHandle": {
        "type": "string"
       }
      },
      "required": [
       "kind",
       "layoutHandle"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "viewport"
       },
       "viewportHandle": {
        "type": "string"
       }
      },
      "required": [
       "kind",
       "viewportHandle"
      ],
      "type": "object"
     }
    ]
   },
   "width": {
    "default": 1600,
    "maximum": 4096,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "documentId",
   "target"
  ],
  "type": "object"
 },
 "name": "dwg.render_view"
}

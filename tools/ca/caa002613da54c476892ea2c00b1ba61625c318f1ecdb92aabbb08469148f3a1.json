{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Inspect a file or directory path. Files return compact metadata; directories return a gitignore-aware tree or pattern matches.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "format": {
    "description": "\"compact\" = shorter path view, \"full\" = include sizes/metadata where available",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   },
   "gitignore": {
    "description": "Respect root .gitignore patterns (default: true). Nested .gitignore not supported",
    "type": "boolean"
   },
   "max_depth": {
    "description": "Max recursion depth (default: 2 for discovery, or 20 in pattern mode)",
    "type": "number"
   },
   "max_entries": {
    "description": "Max entries to show in pattern mode before truncation metadata is returned (default: 60, 0 = unlimited)",
    "type": "number"
   },
   "path": {
    "description": "File or directory path",
    "type": "string"
   },
   "pattern": {
    "description": "Glob filter on names (e.g. \"*-mcp\", \"*.mjs\"). Returns flat match list instead of tree",
    "type": "string"
   },
   "type": {
    "description": "\"file\", \"dir\", or \"all\" (default). Like find -type f/d",
    "enum": [
     "file",
     "dir",
     "all"
    ],
    "type": "string"
   },
   "verbosity": {
    "description": "Response budget. `minimal` returns the shortest tree summary.",
    "enum": [
     "minimal",
     "compact",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "inspect_path",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "content": {
    "type": "string"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "recovery": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "recovery"
    ],
    "type": "object"
   },
   "failure_class": {
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "recovery": {
    "type": "string"
   },
   "status": {
    "enum": [
     "OK",
     "ERROR",
     "AUTO_REBASED",
     "CONFLICT",
     "STALE",
     "INVALID",
     "NO_CHANGES",
     "CHANGED",
     "UNSUPPORTED"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Inspect Path"
}

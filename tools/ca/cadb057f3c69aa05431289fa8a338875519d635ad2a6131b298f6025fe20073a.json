{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Full text (markdown) of a store policy: delivery, returns, payment-options, faqs or contact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "description": "Storefront locale such as en-GB (default), en-US, de, fr-FR, es-ES, it-IT, nl-NL, pl. Controls product names, slugs and prices.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   },
   "policy": {
    "enum": [
     "delivery",
     "returns",
     "payment-options",
     "faqs",
     "contact"
    ],
    "type": "string"
   }
  },
  "required": [
   "policy"
  ],
  "type": "object"
 },
 "name": "get_policy",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "enum": [
     "delivery",
     "returns",
     "payment-options",
     "faqs",
     "contact"
    ],
    "type": "string"
   },
   "markdown": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "title",
   "url",
   "markdown"
  ],
  "type": "object"
 },
 "title": "Get policy text"
}

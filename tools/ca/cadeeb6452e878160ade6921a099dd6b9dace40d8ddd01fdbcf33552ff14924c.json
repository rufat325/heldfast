 "description": "Look up malware samples in MalwareBazaar (the abuse.ch sample corpus) carrying a given tag, such as \"emotet\", \"macro\", \"exe\", or \"ransomware\". Returns the matching samples with sha256/md5 hashes, file type, file name, signature, family, first-seen date, and reporter, plus a match count. Answers which recently submitted malware samples carry a given tag.",
 "inputSchema": {
  "examples": [
   {
    "tag": "emotet"
   },
   {
    "limit": 50,
    "tag": "macro"
   }
  ],
  "properties": {
   "limit": {
    "description": "Max results (default 100)",
    "type": "number"
   },
   "tag": {
    "description": "Tag string",
    "type": "string"
   }
  },
  "required": [
   "tag"
  ],
  "type": "object"
 },
 "name": "search_tag",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Number of samples returned",
    "type": "number"
   },
   "query": {
    "description": "Query type used (get_taginfo)",
    "type": "string"
   },
   "samples": {
    "description": "Array of samples with matching tag",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "Query status (ok, no_results, or null)",
    "enum": [
     "ok",
     "no_results",
     null
    ],
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "query",
   "status",

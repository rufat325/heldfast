{
 "description": "Check accumulated creator fees for a token across all deployed chains. Returns fee amounts and whether they can be claimed. Use printr_claim_fees to claim the fees to the treasury.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chains": {
    "description": "Optional: subset of CAIP-2 chain IDs to query. If empty, queries all chains.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "token_id": {
    "description": "Telecoin ID (hex) or CAIP-10 token address",
    "type": "string"
   }
  },
  "required": [
   "token_id"
  ],
  "type": "object"
 },
 "name": "printr_get_creator_fees",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chains": {
    "description": "Per-chain fee breakdown",
    "items": {
     "additionalProperties": false,
     "properties": {
      "can_claim": {
       "description": "Whether fees can be claimed on this chain",
       "type": "boolean"
      },
      "chain_id": {
       "description": "CAIP-2 chain ID",
       "type": "string"
      },
      "creator_address": {
       "description": "Creator wallet address",
       "type": "string"
      },
      "creator_fees_native": {
       "description": "Claimable creator fees in native token (atomic)",
       "type": "string"
      },
      "creator_fees_usd": {
       "description": "Claimable creator fees in USD",
       "type": "number"
      },
      "native_symbol": {
       "description": "Native token symbol",
       "type": "string"
      }
     },
     "required": [
      "chain_id",
      "creator_fees_usd",
      "creator_fees_native",
      "can_claim",
      "native_symbol"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "claim_url": {
    "description": "URL to claim fees in the web UI",
    "type": "string"
   },
   "message": {
    "description": "Status message",
    "type": "string"
   },
   "token_id": {
    "description": "Telecoin ID",
    "type": "string"
   },
   "total_fees_usd": {
    "description": "Total claimable creator fees in USD",
    "type": "number"
   }
  },
  "required": [
   "token_id",
   "total_fees_usd",
   "chains",
   "claim_url",
   "message"
  ],
  "type": "object"
 }
}

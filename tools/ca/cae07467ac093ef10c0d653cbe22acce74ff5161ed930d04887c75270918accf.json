 "description": "List transactions for an address. type controls which list: \"normal\" (regular EOA txs), \"internal\" (contract-internal value transfers), \"erc20\" (ERC-20 transfers), \"erc721\" (NFT transfers), \"erc1155\" (multi-token transfers).",
 "inputSchema": {
  "examples": [
   {
    "address": "0x1234567890123456789012345678901234567890"
   },
   {
    "address": "0xabcdefabcdefabcdefabcdefabcdefabcdefabcd",
    "chain": "base",
    "page": 1,
    "sort": "asc",
    "type": "erc20"
   }
  ],
  "properties": {
   "address": {
    "description": "Address to inspect",
    "type": "string"
   },
   "chain": {
    "description": "Chain slug or chain ID (default ethereum)",
    "type": "string"
   },
   "endblock": {
    "description": "End block (default latest = 99999999)",
    "type": "number"
   },
   "offset": {
    "description": "Results per page (default 25, max 10000)",
    "type": "number"
   },
   "page": {
    "description": "Page number (default 1)",
    "type": "number"
   },
   "sort": {
    "description": "asc | desc (default desc)",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "startblock": {
    "description": "Start block (default 0)",
    "type": "number"
   },
   "type": {
    "description": "normal | internal | erc20 | erc721 | erc1155 (default normal)",
    "enum": [
     "normal",
     "internal",
     "erc20",
     "erc721",
     "erc1155"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "list_transactions",
 "outputSchema": {
  "properties": {
   "address": {
    "description": "The queried address",
    "type": "string"
   },
   "chain_id": {
    "description": "Numeric chain ID",
    "type": "number"
   },
   "chain_name": {
    "description": "Human-readable chain name or null",
    "type": [
     "string",
     "null"
    ]
   },
   "count": {
    "description": "Number of transactions returned",
    "type": "number"
   },
   "transactions": {
    "description": "Array of transaction objects from Etherscan API",

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Replace the list of primary nameservers used by a secondary DNS zone for AXFR/IXFR transfers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id_or_name": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^[^/\\s]+$",
      "type": "string"
     }
    ],
    "description": "Zone ID or name"
   },
   "primary_nameservers": {
    "description": "New full list of primary nameservers",
    "items": {
     "properties": {
      "address": {
       "description": "IPv4 or IPv6 address of the primary nameserver, optionally with :port",
       "type": "string"
      },
      "port": {
       "description": "DNS port (default 53)",
       "maximum": 65535,
       "minimum": 1,
       "type": "integer"
      },
      "tsig_algorithm": {
       "description": "TSIG algorithm name, e.g. \"hmac-sha256\"",
       "type": "string"
      },
      "tsig_key": {
       "description": "TSIG key as base64",
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id_or_name",
   "primary_nameservers"
  ],
  "type": "object"
 },
 "name": "hetzner_change_zone_primary_nameservers",
 "title": "Change DNS Zone Primary Nameservers"
}

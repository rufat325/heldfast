{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Demonstrates MCP sampling by requesting an LLM to review code snippets. The tool uses the client's LLM to generate a code review summary.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Request an LLM-powered code review via sampling.",
  "properties": {
   "code": {
    "description": "The code snippet to review.",
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "focus": {
    "default": "general",
    "description": "The focus area for the code review.",
    "enum": [
     "security",
     "performance",
     "style",
     "general"
    ],
    "type": "string"
   },
   "language": {
    "description": "Programming language of the code (e.g., \"typescript\", \"python\").",
    "type": "string"
   },
   "maxTokens": {
    "default": 500,
    "description": "Maximum tokens for the LLM response.",
    "maximum": 2000,
    "minimum": 100,
    "type": "integer"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "template_code_review_sampling",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Code review tool response payload.",
  "properties": {
   "code": {
    "description": "The original code snippet.",
    "type": "string"
   },
   "focus": {
    "description": "The review focus area.",
    "type": "string"
   },
   "language": {
    "description": "The programming language.",
    "type": "string"
   },
   "review": {
    "description": "The LLM-generated code review summary.",
    "type": "string"
   },
   "tokenUsage": {
    "additionalProperties": false,
    "description": "Token usage information.",
    "properties": {
     "actual": {
      "description": "Actual tokens used (if available).",
      "type": "number"
     },
     "requested": {
      "description": "Requested max tokens.",
      "type": "number"
     }
    },
    "required": [
     "requested"
    ],
    "type": "object"
   }
  },
  "required": [
   "code",
   "focus",
   "review"
  ],
  "type": "object"
 },
 "title": "Code Review with Sampling"
}

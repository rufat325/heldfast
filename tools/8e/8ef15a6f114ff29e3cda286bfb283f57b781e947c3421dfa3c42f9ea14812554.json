 "description": "Search the Apple iTunes catalog by keyword across music, movies, podcasts, TV shows, apps, ebooks, and more; filterable by media type, entity, country, and explicit flag; returns up to 200 matching items with metadata.",
 "inputSchema": {
  "examples": [
   {
    "term": "Taylor Swift"
   },
   {
    "entity": "album",
    "limit": 10,
    "media": "music",
    "term": "Midnights"
   }
  ],
  "properties": {
   "attribute": {
    "description": "Restrict matching field \u2014 e.g. \"artistTerm\", \"albumTerm\", \"movieTerm\"",
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 (default us)",
    "type": "string"
   },
   "entity": {
    "description": "Refines media \u2014 e.g. \"song\", \"album\", \"movieArtist\", \"tvSeason\"",
    "type": "string"
   },
   "explicit": {
    "description": "Yes (default) | No \u2014 exclude explicit content",
    "type": "string"
   },
   "lang": {
    "description": "en_us | ja_jp (default en_us)",
    "type": "string"
   },
   "limit": {
    "description": "1-200 (default 50)",
    "type": "number"
   },
   "media": {
    "description": "music | movie | podcast | musicVideo | audiobook | shortFilm | tvShow | software | ebook | all (default all)",
    "type": "string"
   },
   "term": {
    "description": "Search query",
    "type": "string"
   }
  },
  "required": [
   "term"
  ],
  "type": "object"
 },

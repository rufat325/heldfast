{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "A category's name, description and its products (paged) by category slug.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "description": "Storefront locale such as en-GB (default), en-US, de, fr-FR, es-ES, it-IT, nl-NL, pl. Controls product names, slugs and prices.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   },
   "page": {
    "description": "Page number, starting at 1.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Results per page: 15, 30, 50 or 100 (default 15).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "slug": {
    "description": "Category slug from list_categories.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "description": "Sort order: price_low, price_high, name_asc, name_desc or newest. Omit for the default (most popular) order.",
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_category",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "description": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "type": "number"
       },
       "name": {
        "type": "string"
       },
       "slug": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "slug",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "pagination": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "last_page": {
        "type": "number"
       },
       "page": {
        "type": "number"
       },
       "per_page": {
        "type": "number"
       },
       "total": {
        "type": "number"
       }
      },
      "required": [
       "page",
       "per_page",
       "total",
       "last_page"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "products": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "brand": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "brand_slug": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "express_eligible": {
       "description": "Website Express (same-working-day UK dispatch); only when the listing reports it.",
       "type": "boolean"
      },
      "gtin": {
       "type": "string"
      },
      "id": {
       "type": "number"
      },
      "image": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "in_stock": {
       "type": "boolean"
      },
      "mpn": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "price": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "bulk_prices": {
           "description": "Lower unit prices from min_quantity up.",
           "items": {
            "additionalProperties": false,
            "properties": {
             "ex_vat": {
              "type": "number"
             },
             "inc_vat": {
              "type": "number"
             },
             "min_quantity": {
              "type": "number"
             }
            },
            "required": [
             "min_quantity",
             "ex_vat",
             "inc_vat"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "currency": {
           "type": "string"
          },
          "ex_vat": {
           "type": "number"
          },
          "inc_vat": {
           "type": "number"
          },
          "on_sale": {
           "type": "boolean"
          },
          "vat_rate": {
           "anyOf": [
            {
             "type": "number"
            },
            {
             "type": "null"
            }
           ],
           "description": "VAT rate in percent (20 = 20%). null when unknown: ex_vat then equals inc_vat."
          },
          "was_ex_vat": {
           "type": "number"
          },
          "was_inc_vat": {
           "description": "Price before the sale; only when on_sale.",
           "type": "number"
          }
         },
         "required": [
          "currency",
          "ex_vat",
          "inc_vat",
          "on_sale",
          "vat_rate"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "null when the product has no online price."
      },
      "sku": {
       "type": "string"
      },
      "slug": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "stock_level": {
       "type": "number"
      },
      "summary": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "sku",
      "name",
      "slug",
      "url",
      "brand",
      "brand_slug",
      "categories",
      "price",
      "in_stock",
      "stock_level",
      "image",
      "summary"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "category",
   "products",
   "pagination"
  ],
  "type": "object"
 },
 "title": "Get category"
}

{
 "_meta": {},
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List app categories"
 },
 "description": "List App Store categories (reference for app metadata)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "exists.parent": {
    "description": "Filter by existence of parent category (true = subcategories only)",
    "type": "boolean"
   },
   "filter.platforms": {
    "anyOf": [
     {
      "enum": [
       "IOS",
       "MAC_OS",
       "TV_OS",
       "VISION_OS"
      ],
      "type": "string"
     },
     {
      "items": {
       "enum": [
        "IOS",
        "MAC_OS",
        "TV_OS",
        "VISION_OS"
       ],
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Filter by platform(s)"
   },
   "limit": {
    "default": 100,
    "description": "Maximum number of app categories to return (default 100, max 200)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "list-app-categories",
 "title": "List app categories"
}

  "properties": {
   "track_index": {
    "description": "Track index (default: 0)",
    "type": "number"
   },
   "track_type": {
    "description": "Track type (default: video)",
    "enum": [
     "video",
     "audio"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "match_frame",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",

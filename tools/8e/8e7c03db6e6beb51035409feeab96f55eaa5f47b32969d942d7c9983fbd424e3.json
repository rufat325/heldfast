 "description": "Fetch bank transactions for a date range. Returns transaction names, amounts, categories, and dates. Example: get_transactions({ access_token: \"access-sandbox-xxx\", start_date: \"2024-01-01\", end_date: \"2024-01-31\", _apiKey: \"client_id:secret\" })",
 "inputSchema": {
  "examples": [
   {
    "_apiKey": "your-plaid-api-key",
    "access_token": "access-sandbox-abc123def456",
    "end_date": "2024-01-31",
    "start_date": "2024-01-01"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "Plaid credentials as \"client_id:secret\"",
    "type": "string"
   },
   "access_token": {
    "description": "Plaid access token for the linked institution",
    "type": "string"
   },
   "end_date": {
    "description": "End date in YYYY-MM-DD format, e.g. \"2024-01-31\"",
    "type": "string"
   },
   "start_date": {
    "description": "Start date in YYYY-MM-DD format, e.g. \"2024-01-01\"",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "start_date",
   "end_date",
   "_apiKey"
  ],
  "type": "object"
 },
 "name": "get_transactions",
 "outputSchema": {
  "description": "Response from Plaid transactions endpoint containing transaction history",
  "properties": {
   "item": {
    "description": "Item metadata",
    "type": "object"
   },
   "request_id": {

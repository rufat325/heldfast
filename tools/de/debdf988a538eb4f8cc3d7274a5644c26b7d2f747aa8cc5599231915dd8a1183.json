{
 "description": "Validate design decisions and compile a machine-readable design-genome.yaml specification.",
 "inputSchema": {
  "properties": {
   "colorTokens": {
    "properties": {
     "accent": {
      "description": "Highlight accent color.",
      "type": "string"
     },
     "border": {
      "description": "Border divider color.",
      "type": "string"
     },
     "primary": {
      "description": "Primary ink color.",
      "type": "string"
     }
    },
    "required": [
     "primary",
     "accent",
     "border"
    ],
    "type": "object"
   },
   "dimensionality": {
    "description": "Visual dimensionality.",
    "enum": [
     "2d_planar",
     "2.5d_parallax",
     "3d_webgl"
    ],
    "type": "string"
   },
   "groundTone": {
    "description": "Hex ground tone (e.g. #fbfaf7, #0a0f0d, #000000).",
    "type": "string"
   },
   "motionFeel": {
    "description": "Motion pacing and easing description.",
    "type": "string"
   },
   "projectName": {
    "description": "Name of the project or app.",
    "type": "string"
   },
   "references": {
    "description": "Audited reference sites analyzed via pixasso_fetch_reference.",
    "items": {
     "properties": {
      "epistemicStatus": {
       "enum": [
        "known",
        "inferred",
        "uncertain",
        "unavailable"
       ],
       "type": "string"
      },
      "extractedPrinciples": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "fetchedAt": {
       "type": "string"
      },
      "renderedContentDetected": {
       "type": "boolean"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "fetchedAt",
      "renderedContentDetected",
      "extractedPrinciples",
      "epistemicStatus"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "themeMode": {
    "description": "Visual theme mode.",
    "enum": [
     "paper",
     "crt_mono",
     "amoled_black",
     "custom"
    ],
    "type": "string"
   },
   "typography": {
    "properties": {
     "bodyFont": {
      "description": "Body reading font.",
      "type": "string"
     },
     "displayFont": {
      "description": "Display headline font.",
      "type": "string"
     },
     "monoFont": {
      "description": "Monospace font for data/code.",
      "type": "string"
     },
     "scaleRatio": {
      "description": "Modular scale ratio.",
      "type": "string"
     }
    },
    "required": [
     "displayFont",
     "bodyFont",
     "monoFont"
    ],
    "type": "object"
   }
  },
  "required": [
   "projectName",
   "themeMode",
   "groundTone",
   "typography",
   "colorTokens"
  ],
  "type": "object"
 },
 "name": "pixasso_generate_genome"
}

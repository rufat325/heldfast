{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List KIP's widget catalog, optionally filtered by category or to widgets that need no plugins.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Only list widgets in this category.",
    "enum": [
     "Core",
     "Gauge",
     "Component",
     "Racing"
    ],
    "type": "string"
   },
   "requiresNoPlugins": {
    "description": "Only list widgets that work with no Signal K plugins.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_kip_widgets",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "widgets": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "widgets"
  ],
  "type": "object"
 },
 "title": "List KIP widgets"
}

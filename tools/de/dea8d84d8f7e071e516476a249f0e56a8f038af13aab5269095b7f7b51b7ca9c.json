{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Optimize a prompt against EXPLICIT caller-provided grounding sources (a spec, a transcript excerpt, an RFC, an internal doc, etc.). Each source is pinned at the highest priority \u2014 above project rules, above pinned instructions \u2014 and tracked individually in the trace. Use this when you want the rewrite to cite specific material rather than letting the curator decide what's relevant. Requires at least one non-empty source; will error rather than silently fall through to optimize_prompt. Sources are capped at 4000 chars each so a single large paste can't dominate the budget.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "chat",
     "image",
     "voice",
     "video",
     "music",
     "code",
     "document"
    ],
    "type": "string"
   },
   "cwd": {
    "type": "string"
   },
   "enrich_context": {
    "default": false,
    "type": "boolean"
   },
   "file_excerpt": {
    "type": "string"
   },
   "file_language": {
    "type": "string"
   },
   "file_path": {
    "type": "string"
   },
   "include_bundle": {
    "default": false,
    "type": "boolean"
   },
   "mode": {
    "enum": [
     "concise",
     "detailed",
     "structured",
     "step-by-step",
     "bullet-points",
     "technical",
     "simple"
    ],
    "type": "string"
   },
   "platform": {
    "type": "string"
   },
   "prompt": {
    "description": "The prompt to optimize.",
    "type": "string"
   },
   "session_id": {
    "type": "string"
   },
   "skip_intent_resolution": {
    "default": false,
    "type": "boolean"
   },
   "sources": {
    "description": "Caller-provided grounding sources. Must be non-empty.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "description": "Source content. Used verbatim. Capped at 4000 chars per source.",
       "type": "string"
      },
      "kind": {
       "description": "Optional categorization (e.g. 'spec', 'transcript', 'doc'). Free-form.",
       "type": "string"
      },
      "label": {
       "description": "Human-facing heading for this source (e.g. 'RFC 5322 \u00a73.4').",
       "type": "string"
      }
     },
     "required": [
      "label",
      "body"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "user_locale": {
    "type": "string"
   },
   "user_pinned_instructions": {
    "type": "string"
   }
  },
  "required": [
   "prompt",
   "sources"
  ],
  "type": "object"
 },
 "name": "ground_prompt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "analysis": {
    "additionalProperties": true,
    "properties": {
     "category": {
      "type": "string"
     },
     "confidence": {
      "type": "string"
     },
     "intent": {
      "type": "string"
     },
     "recommendedMode": {
      "type": "string"
     },
     "source": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "bundle": {},
   "category": {
    "type": "string"
   },
   "context": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "id": {
    "type": "string"
   },
   "mode": {
    "type": "string"
   },
   "modeSource": {
    "type": "string"
   },
   "optimizedPrompt": {
    "type": "string"
   },
   "originalPrompt": {
    "type": "string"
   },
   "platform": {
    "type": "string"
   },
   "sessionId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Optimize against explicit sources"
}

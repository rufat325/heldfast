{
 "description": "Create a webhook notification configuration",
 "inputSchema": {
  "properties": {
   "apiVersion": {
    "description": "API version (3)",
    "type": "number"
   },
   "authToken": {
    "description": "Authentication token for webhook validation",
    "type": "string"
   },
   "email": {
    "description": "Email for notifications",
    "type": "string"
   },
   "enabled": {
    "description": "Whether the notification is enabled",
    "type": "boolean"
   },
   "interrupted": {
    "description": "Whether the notification is interrupted",
    "type": "boolean"
   },
   "url": {
    "description": "Webhook URL to receive notifications",
    "type": "string"
   }
  },
  "required": [
   "url",
   "enabled"
  ],
  "type": "object"
 },
 "name": "create_notification"
}

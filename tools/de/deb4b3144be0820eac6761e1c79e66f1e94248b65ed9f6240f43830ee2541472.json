{
 "description": "Search companies/employers on hh.ru by name. Returns company info and open vacancy count.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "area": {
    "description": "Region code",
    "type": "number"
   },
   "page": {
    "default": 0,
    "description": "Page number (0-based)",
    "minimum": 0,
    "type": "integer"
   },
   "per_page": {
    "default": 20,
    "description": "Results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "raw": {
    "description": "Return the full raw hh.ru JSON instead of the compact summary.",
    "type": "boolean"
   },
   "text": {
    "description": "Company name to search for",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "search_employers"
}

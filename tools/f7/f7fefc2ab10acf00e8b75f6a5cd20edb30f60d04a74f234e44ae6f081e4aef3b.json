 "description": "POST a PxWeb selection query to an \u00c5SUB table and return the data as json-stat2. Path must end in \".px\"; body is a PxWeb query object with a \"query\" array of {code, selection: {filter, values}} entries plus {response: {format: \"json-stat2\"}}. Narrow each dimension's values to stay under PxWeb's per-response cell limit.",
 "inputSchema": {
  "examples": [
   {
    "body": {
     "query": [
      {
       "code": "\u00c5r",
       "selection": {
        "filter": "item",
        "values": [
         "2023",
         "2024"
        ]
       }
      },
      {
       "code": "Region",
       "selection": {
        "filter": "item",
        "values": [
         "AX"
        ]
       }
      }
     ],
     "response": {
      "format": "json-stat2"
     }
    },
    "path": "Statistik/BE/Befolkningsr\u00f6relsen/BE006.px"
   }
  ],
  "properties": {
   "body": {
    "description": "{query: [{code, selection: {filter, values}}], response: {format: \"json-stat2\"}}",
    "type": "object"
   },
   "path": {
    "description": "e.g. \"Statistik/BE/Befolkningsr\u00f6relsen/BE006.px\"",
    "type": "string"
   }
  },
  "required": [

{
 "description": "Update a memory's content, metadata (importance, tags, layer, kind). Use supersedes on store to replace with history.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "New content text",
    "type": "string"
   },
   "id": {
    "description": "Memory ID to update",
    "type": "string"
   },
   "importance": {
    "description": "New importance value",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "kind": {
    "description": "Memory type",
    "enum": [
     "semantic",
     "episodic",
     "procedural"
    ],
    "type": "string"
   },
   "layer": {
    "description": "Move to layer: 1=buffer, 2=working, 3=core",
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "tags": {
    "description": "Replace tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "engram_update"
}

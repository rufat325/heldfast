{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:scan"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a scan's findings"
 },
 "description": "The findings for a scan started by scan_url \u2014 rule id, severity, help URL and the element selector. Works for both kinds of scan_url scan. A one-off scan returns the top-5 sample; a scan recorded against a registered site returns its full findings. For a full-site run from scan_site, use get_run_findings instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "scanId": {
    "description": "The id returned by scan_url.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "scanId"
  ],
  "type": "object"
 },
 "name": "get_findings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "recordedAgainstSite": {
    "type": "boolean"
   },
   "violations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "failureSummary": {
       "type": [
        "string",
        "null"
       ]
      },
      "helpUrl": {
       "type": "string"
      },
      "htmlSnippet": {
       "type": [
        "string",
        "null"
       ]
      },
      "impact": {
       "type": "string"
      },
      "ruleId": {
       "type": "string"
      },
      "targetSelector": {
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      },
      "wcagSc": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "ruleId",
      "impact",
      "helpUrl",
      "targetSelector"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "violations",
   "recordedAgainstSite"
  ],
  "type": "object"
 },
 "title": "Get a scan's findings"
}

{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List brands"
 },
 "description": "Paginated UK bike-brand catalogue from Cyclesite, ordered by stock level. Use to validate a brand name, surface options to a user, or paginate the catalogue. Stock counts are returned as bands (none / 1-5 / 6-25 / 26-100 / 100+) \u2014 Cyclesite doesn't expose precise per-brand inventory. Example: 'what brands of e-bike are available?'.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "1-50, default 25.",
    "type": "number"
   },
   "offset": {
    "description": "0-500.",
    "type": "number"
   },
   "q": {
    "description": "Optional search filter (case-insensitive contains).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_brands",
 "outputSchema": {
  "properties": {
   "attribution": {
    "description": "Citation string \u2014 include verbatim when surfacing data.",
    "type": "string"
   },
   "brands": {
    "items": {
     "properties": {
      "country": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "stockBand": {
       "enum": [
        "none",
        "1-5",
        "6-25",
        "26-100",
        "100+"
       ],
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      },
      "verified": {
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "hasMore": {
    "type": "boolean"
   },
   "limit": {
    "type": "number"
   },
   "offset": {
    "type": "number"
   },
   "total": {
    "type": "number"
   }
  },
  "type": "object"
 }
}

  "title": "Habitat received level (vessel noise)"
 },
 "description": "Broadband received level (dB re 1 uPa) at a fixed site \u2014 a fish farm,\n    reef, hydrophone or marine protected area \u2014 from the ships around it,\n    power-summed. Each vessel's source level comes from its AIS class, speed\n    and size; transmission loss is a fast broadband model, so this is a\n    screening estimate (use run_transmission_loss for exact site physics).\n    hours_back = 0 uses the live snapshot; > 0 reconstructs a time series from\n    the AIS archive in 10-minute bins (max/median/quiet levels). Location:\n    lat/lon or `place`. Show `open_url` to the user as a clickable link.",
 "inputSchema": {
  "properties": {
   "hours_back": {
    "default": 0,
    "title": "Hours Back",
    "type": "number"
   },
   "lat": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lat"
   },
   "lon": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lon"
   },
   "max_range_km": {
    "default": 30.0,
    "title": "Max Range Km",
    "type": "number"
   },
   "place": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Place"
   },
   "top": {
    "default": 10,
    "title": "Top",
    "type": "integer"
   }
  },
  "title": "habitat_received_levelArguments",
  "type": "object"
 },

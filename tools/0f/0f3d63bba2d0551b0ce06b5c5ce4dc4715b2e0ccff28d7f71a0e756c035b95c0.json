{
 "description": "Generate correct Harmony patch class for a specific method.",
 "inputSchema": {
  "properties": {
   "assembly": {
    "description": "Assembly key",
    "type": "string"
   },
   "method_name": {
    "description": "Target method name",
    "type": "string"
   },
   "parameter_count": {
    "description": "Parameter count for overload disambiguation",
    "type": "number"
   },
   "patch_class_name": {
    "description": "Custom name for the patch class",
    "type": "string"
   },
   "patch_type": {
    "description": "Patch type: prefix, postfix, both (default: both)",
    "type": "string"
   },
   "type_name": {
    "description": "Target type name",
    "type": "string"
   }
  },
  "required": [
   "assembly",
   "type_name",
   "method_name"
  ],
  "type": "object"
 },
 "name": "generate_harmony_patch"
}

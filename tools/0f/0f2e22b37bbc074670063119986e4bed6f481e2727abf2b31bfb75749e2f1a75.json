{
 "description": "Compare two assembly versions to show changes.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max results (default 200)",
    "type": "number"
   },
   "new_assembly_path": {
    "description": "Path to new version DLL",
    "type": "string"
   },
   "old_assembly_path": {
    "description": "Path to old version DLL",
    "type": "string"
   },
   "show_methods": {
    "description": "Show method-level changes (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "old_assembly_path",
   "new_assembly_path"
  ],
  "type": "object"
 },
 "name": "diff_assemblies"
}

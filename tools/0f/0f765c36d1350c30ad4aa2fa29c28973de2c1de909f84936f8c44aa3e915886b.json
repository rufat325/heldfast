     },
     "requestId": {
      "type": "string"
     },
     "source": {
      "enum": [
       "testlink",
       "demo",
       "local"
      ]
     }
    },
    "required": [
     "source",
     "requestId"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [

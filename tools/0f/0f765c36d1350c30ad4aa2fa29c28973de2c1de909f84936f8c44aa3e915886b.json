  "properties": {
   "buildId": {
    "type": "string"
   },
   "notes": {
    "type": "string"
   },
   "platformName": {
    "type": "string"
   },
   "status": {
    "enum": [
     "passed",
     "failed",
     "blocked"
    ]
   },
   "testCaseId": {
    "type": "string"
   },
   "testPlanId": {
    "type": "string"
   }
  },
  "required": [
   "testCaseId",
   "testPlanId",
   "buildId",
   "status"
  ],
  "type": "object"
 },
 "name": "testlink_preview_execution_result",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {},
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {},
     "message": {
      "type": "string"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message",
     "retryable"
    ],
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "nextCursor": {
      "type": "string"
     },
     "previewExpiresAt": {

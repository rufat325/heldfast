{
 "_meta": {
  "ufcalendar/authless": false,
  "ufcalendar/endpoint": "GET /v1/fights/{id}/odds/history",
  "ufcalendar/tier": "pro"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get the odds line movement"
 },
 "description": "Every UFCalendar consensus odds point recorded for one bout, oldest first: the line-movement series, with how many sportsbooks backed each point. A point is stored only when the line moves. Narrow with from/to dates; cursor paginated. Pro plans and up. Information only, not betting advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "meta.pagination.next_cursor from a previous call.",
    "type": "string"
   },
   "fight_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^\\d+$",
      "type": "string"
     }
    ],
    "description": "Bout id, as returned on an event card. Integer or numeric string."
   },
   "from": {
    "description": "Earliest recorded day, YYYY-MM-DD (inclusive).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Points per page, default 100.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "to": {
    "description": "Latest recorded day, YYYY-MM-DD (inclusive).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "fight_id"
  ],
  "type": "object"
 },
 "name": "get_odds_history",
 "title": "Get the odds line movement"
}

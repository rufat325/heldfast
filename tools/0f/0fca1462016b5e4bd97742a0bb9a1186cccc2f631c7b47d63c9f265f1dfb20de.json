{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Run a NAMED metric from the semantic layer against RDF data: fills its {{param}} placeholders from `args` and executes the resulting SPARQL. Use it so \"revenue\" or \"active users\" is computed from the AGREED definition instead of a query you invented \u2014 the fix for \"one number, three answers\". Returns the effective SPARQL and the result, or which parameters are missing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "args": {
    "additionalProperties": {
     "type": "string"
    },
    "default": {},
    "description": "Values for the metric's {{...}} parameters",
    "type": "object"
   },
   "data": {
    "description": "The RDF graph as text",
    "type": "string"
   },
   "format": {
    "default": "turtle",
    "enum": [
     "turtle",
     "ntriples",
     "nquads",
     "trig",
     "jsonld",
     "rdfxml"
    ],
    "type": "string"
   },
   "metric": {
    "description": "Name of the metric to run",
    "type": "string"
   },
   "semantic": {
    "additionalProperties": false,
    "description": "Semantic layer: { glossary: [{term,target,synonyms?}], metrics: [{name,label?,sparql}] }",
    "properties": {
     "glossary": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "note": {
         "type": "string"
        },
        "synonyms": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "target": {
         "type": "string"
        },
        "term": {
         "type": "string"
        }
       },
       "required": [
        "term",
        "target"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "metrics": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "label": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "note": {
         "type": "string"
        },
        "sparql": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "sparql"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "data",
   "semantic",
   "metric"
  ],
  "type": "object"
 },
 "name": "kg_metric"
}

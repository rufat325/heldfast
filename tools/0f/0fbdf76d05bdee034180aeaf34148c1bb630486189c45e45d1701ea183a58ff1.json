{
 "description": "Search NYC Department of Buildings violation records by address, BIN, or block+lot. Covers DOB Violations, Safety Violations, and ECB Violations (with penalty amounts). Use summary=true for aggregate stats.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bin": {
    "description": "NYC BIN (Building Identification Number)",
    "type": "string"
   },
   "block": {
    "description": "Tax block number (use with lot)",
    "type": "string"
   },
   "borough": {
    "description": "Borough: manhattan, bronx, brooklyn, queens, or \"staten island\"",
    "type": "string"
   },
   "house_number": {
    "description": "House number (e.g. \"350\"). Use with street.",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results (ignored when summary=true)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "lot": {
    "description": "Tax lot number (use with block)",
    "type": "string"
   },
   "street": {
    "description": "Street name (e.g. \"BROADWAY\"). Use with house_number.",
    "type": "string"
   },
   "summary": {
    "default": false,
    "description": "Set true for aggregate stats instead of individual violations",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "search_nyc_violations"
}

    "type": "string"
   },
   "context": {
    "description": "Why are you calling this tool? Describe the user's underlying goal in one short sentence \u2014 not the tool name. Never include names, emails, phones, or prices. Always pass this. Used for analytics only; never shown to the user.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "cart_id"
  ],
  "type": "object"
 },
 "name": "get_order_details",

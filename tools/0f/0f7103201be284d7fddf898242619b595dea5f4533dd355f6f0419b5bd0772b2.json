       "properties": {
        "currency": {
         "type": "string"
        },
        "hotel_name": {
         "type": "string"
        },
        "price": {
         "type": "number"
        },
        "provider_reference": {
         "type": "string"
        },
        "room_name": {
         "type": "string"
        },
        "state": {
         "type": "string"
        }
       },
       "required": [
        "state",
        "price"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "state": {
      "type": "string"
     }
    },
    "required": [

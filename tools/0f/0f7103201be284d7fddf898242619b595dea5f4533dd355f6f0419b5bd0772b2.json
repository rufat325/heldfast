  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "booking": {
    "properties": {
     "booking_reference": {
      "type": [
       "string",
       "null"
      ]
     },
     "contact": {
      "properties": {
       "email": {
        "type": "string"
       },
       "first_name": {
        "type": "string"
       },
       "last_name": {
        "type": "string"
       }
      },

{
 "description": "List independent Experience records, optionally for a daily, weekly, or monthly review scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "periodKind": {
    "enum": [
     "daily",
     "weekly",
     "monthly"
    ],
    "type": "string"
   },
   "scopeId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "granoflow_experience_list"
}

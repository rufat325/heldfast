 "description": "Search NIH-funded research projects. Filter by free-text query (topic/subject matter \u2014 matches title/abstract/terms, NOT the awardee), PI name, organization (the funded company/university/institution \u2014 use THIS, not query, for \"what grants has <company/university> received\"), fiscal year, US state, or NIH institute code (NCI, NHLBI, NIAID, etc.). Returns project number, PI, institution, fiscal year, award amount, and abstract preview.",
 "inputSchema": {
  "examples": [
   {
    "fiscal_year": 2024,
    "ic": "NCI",
    "limit": 25,
    "query": "cancer immunotherapy"
   },
   {
    "limit": 50,
    "organization": "Stanford University",
    "pi_name": "Smith",
    "state": "CA"
   }
  ],
  "properties": {
   "fiscal_year": {
    "description": "Fiscal year (e.g., 2024)",
    "type": "number"
   },
   "ic": {
    "description": "NIH Institute/Center code (e.g., \"NCI\", \"NHLBI\", \"NIMH\")",
    "type": "string"
   },
   "limit": {
    "description": "Results per page (1-500, default 25)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset (default 0)",
    "type": "number"
   },
   "organization": {
    "description": "The funded organization \u2014 the company, university, hospital, or institution that RECEIVED the award (e.g., \"Stanford University\"). This is the correct filter whenever the question names a specific organization/company/institution as the funding recipient \u2014 use it INSTEAD of `query`, which searches grant CONTENT, not the awardee.",
    "type": "string"
   },
   "pi_name": {
    "description": "PI last name (or any name part)",
    "type": "string"
   },
   "query": {
    "description": "Free-text search over project title/abstract/terms \u2014 an AND match on the SUBJECT MATTER words you pass (e.g. \"cancer immunotherapy\"), not a lookup by funding recipient. Do NOT put a company, institution, or organization name here: the name rarely appears verbatim in grant text, so it instead AND-matches on the name's individual common words and can return thousands of unrelated grants. For \"what NIH grants has <company/university/institution> received\", use `organization` instead.",
    "type": "string"
   },
   "state": {
    "description": "US state code (e.g., \"CA\")",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },

{
 "description": "List notes (newest first) with pagination and an optional tag filter. Returns name, title, size, tags, and whether more results remain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results (default 50)",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "offset": {
    "description": "Start index (default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "tag": {
    "description": "Only notes carrying this tag",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_notes",
 "title": "List notes"
}

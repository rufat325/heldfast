 "description": "Search recent SEC filings for a company by CIK. Optionally filter by filing type (10-K, 10-Q, 8-K, etc.). Returns filing dates, types, and accession numbers.",
 "inputSchema": {
  "examples": [
   {
    "cik": "320193"
   },
   {
    "cik": "789019",
    "type": "10-K"
   }
  ],
  "properties": {
   "cik": {
    "description": "SEC Central Index Key (e.g., \"320193\" for Apple)",
    "type": "string"
   },
   "type": {
    "description": "Filing type filter (e.g., \"10-K\", \"10-Q\", \"8-K\", \"DEF 14A\")",
    "type": "string"
   }
  },
  "required": [
   "cik"
  ],
  "type": "object"
 },
 "name": "search_filings",
 "outputSchema": {
  "properties": {
   "cik": {
    "description": "SEC Central Index Key",
    "type": "string"
   },
   "exchanges": {
    "description": "Stock exchange listings",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filing_count": {
    "description": "Total number of filings matching criteria",
    "type": "number"
   },
   "filings": {
    "description": "Up to 25 recent filings",
    "items": {
     "properties": {
      "accession_number": {
       "description": "SEC accession number for the filing",
       "type": "string"
      },
      "description": {
       "description": "Document description",
       "type": "string"
      },
      "document": {
       "description": "Primary document filename",
       "type": "string"
      },
      "filing_date": {
       "description": "Date filing was submitted (ISO format)",
       "type": "string"
      },
      "form": {
       "description": "Form type (10-K, 10-Q, 8-K, etc)",
       "type": "string"
      },
      "report_date": {
       "description": "Report period end date (ISO format)",
       "type": "string"
      }
     },
     "required": [
      "accession_number",
      "filing_date",
      "report_date",
      "form",
      "document",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {

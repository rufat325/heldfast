   {
    "assembly": "GRCh38",
    "chrom": "1",
    "start": 55000000,
    "stop": 55025000
   },
   {
    "assembly": "GRCh37",
    "chrom": "1",
    "dataset": "gnomad_r2_1",
    "start": 11856300,
    "stop": 11856500
   }
  ],
  "properties": {
   "assembly": {
    "description": "REQUIRED. The genome build your start/stop are in: \"GRCh38\" (= hg38) or \"GRCh37\" (= hg19). There is no default, because every position is valid in both builds \u2014 an unstated build cannot be detected, only guessed wrong. Must agree with dataset: gnomad_r2_1* and exac are GRCh37, gnomad_r3*/r4* are GRCh38.",
    "type": "string"
   },
   "chrom": {
    "description": "e.g. \"1\", \"X\", \"MT\"",
    "type": "string"
   },
   "dataset": {
    "description": "Default gnomad_r4 (GRCh38). gnomad_r2_1* and exac are GRCh37.",
    "type": "string"
   },
   "start": {
    "type": "number"
   },
   "stop": {
    "type": "number"
   }
  },
  "required": [

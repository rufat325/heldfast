{
 "description": "Check SwiftUI code for view and state defects: fixed font sizes and heights that break Dynamic Type, AnyView, deprecated .cornerRadius, literal spacing values instead of design tokens, materials applied over solid backgrounds, transient presentation state stored on models, legacy ObservableObject and @EnvironmentObject, and try!. Use when reviewing or building SwiftUI screens.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "path": {
    "description": "Absolute path to the Swift project root (the folder containing Package.swift or the .xcodeproj).",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "review_swiftui",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "counts": {
    "additionalProperties": false,
    "properties": {
     "blocker": {
      "type": "integer"
     },
     "minor": {
      "type": "integer"
     },
     "serious": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "blocker",
     "serious",
     "minor",
     "total"
    ],
    "type": "object"
   },
   "files_checked": {
    "description": "Swift files actually scanned.",
    "type": "integer"
   },
   "issues": {
    "description": "Every finding, most severe first.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "consequence": {
       "type": "string"
      },
      "doc": {
       "type": "string"
      },
      "excerpt": {
       "type": "string"
      },
      "file": {
       "type": "string"
      },
      "fix": {
       "type": "string"
      },
      "line": {
       "type": "integer"
      },
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "blocker",
        "serious",
        "minor"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "severity",
      "rule",
      "message",
      "consequence",
      "fix",
      "doc",
      "excerpt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "score": {
    "description": "0-100 defect density. 100 = no findings. penalty = 10*blockers + 3*serious + 1*minor; capacity = files*10. Comparable across runs on ONE project, not between projects.",
    "type": "integer"
   },
   "suggestions": {
    "description": "Prioritized next actions, deduplicated by rule \u2014 not a restatement of every issue's fix.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary": {
    "description": "One-line plain-language result.",
    "type": "string"
   }
  },
  "required": [
   "summary",
   "score",
   "counts",
   "files_checked",
   "issues",
   "suggestions"
  ],
  "type": "object"
 },
 "title": "Review SwiftUI views and state"
}

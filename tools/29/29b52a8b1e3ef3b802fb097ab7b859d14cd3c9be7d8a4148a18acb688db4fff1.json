{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Semantic search across past conversations. Finds by meaning, not keywords.",
 "inputSchema": {
  "properties": {
   "includeEntities": {
    "description": "Include entity matches in results",
    "type": "boolean"
   },
   "limit": {
    "description": "Max results (default: 10)",
    "type": "number"
   },
   "query": {
    "description": "Natural language search query",
    "type": "string"
   },
   "scope": {
    "description": "Search scope: all | messages | entries | entities",
    "type": "string"
   },
   "spaceId": {
    "description": "Memory space ID",
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "spaceId",
   "query"
  ],
  "type": "object"
 },
 "name": "memory_search",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Number of results returned",
    "type": "number"
   },
   "results": {
    "description": "Matching entries ranked by semantic relevance",
    "items": {
     "properties": {
      "_id": {
       "description": "Matched entry ID",
       "type": "string"
      },
      "content": {
       "description": "Entry body",
       "type": "string"
      },
      "score": {
       "description": "Relevance score (higher is closer)",
       "type": "number"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Entry title",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "count"
  ],
  "type": "object"
 }
}

{
 "description": "Check whether a cheaper capable model exists for a call you plan to make, and report the savings. Offline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "crossProvider": {
    "description": "Consider other providers too (may need a different API key). Default false.",
    "type": "boolean"
   },
   "currentModel": {
    "description": "The model you plan to call (alias or id).",
    "type": "string"
   },
   "includeLocal": {
    "type": "boolean"
   },
   "inputTokens": {
    "description": "Input tokens for the call.",
    "minimum": 0,
    "type": "integer"
   },
   "outputTokens": {
    "description": "Output tokens for the call.",
    "minimum": 0,
    "type": "integer"
   },
   "providers": {
    "description": "Axis 1: provider availability allowlist (spec 5.4).",
    "items": {
     "enum": [
      "anthropic",
      "gemini",
      "openai",
      "local"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "target": {
    "description": "Axis 2: \"self\" (default) applies the client scope; \"code\" considers all providers.",
    "enum": [
     "self",
     "code"
    ],
    "type": "string"
   },
   "taskClass": {
    "description": "Task class; sets the tier the recommendation must still meet.",
    "enum": [
     "slot_fill",
     "classify_route",
     "draft_short",
     "summarise",
     "plan_decompose",
     "synthesise",
     "reason_hard",
     "gate_safety"
    ],
    "type": "string"
   }
  },
  "required": [
   "currentModel",
   "inputTokens",
   "outputTokens"
  ],
  "type": "object"
 },
 "name": "optimize_request",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alreadyOptimal": {
    "type": "boolean"
   },
   "asOf": {
    "type": "string"
   },
   "catalogVersion": {
    "type": "string"
   },
   "current": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "model": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "tier": {
        "type": "string"
       },
       "usd": {
        "type": "number"
       },
       "usdMicros": {
        "type": "number"
       }
      },
      "required": [
       "model",
       "provider",
       "tier",
       "usd",
       "usdMicros"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "providerScope": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reasoning": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recommended": {
    "anyOf": [
     {
      "$ref": "#/properties/current/anyOf/0"
     },
     {
      "type": "null"
     }
    ]
   },
   "savingsPct": {
    "type": "number"
   },
   "savingsUsd": {
    "type": "number"
   },
   "scopeSource": {
    "type": "string"
   }
  },
  "required": [
   "current",
   "recommended",
   "savingsUsd",
   "savingsPct",
   "alreadyOptimal",
   "reasoning",
   "providerScope",
   "scopeSource",
   "catalogVersion",
   "asOf"
  ],
  "type": "object"
 },
 "title": "Optimize request"
}

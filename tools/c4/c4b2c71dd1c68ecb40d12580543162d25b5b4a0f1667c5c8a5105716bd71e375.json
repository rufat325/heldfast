{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search by location"
 },
 "description": "Find Cyclesite listings within a radius of a UK location (lat/lng). Radius capped at 50 miles. Returns up to 10 listings ordered by distance. Live UK marketplace data. Example: 'used bikes within 25 miles of LE10 0AA' (geocode the postcode first, then call this).",
 "inputSchema": {
  "properties": {
   "category": {
    "enum": [
     "road",
     "mtb",
     "gravel",
     "hybrid",
     "ebike",
     "kids",
     "bmx",
     "folding",
     "city",
     "touring",
     "triathlon",
     "track",
     "cyclocross",
     "cargo",
     "adaptive",
     "other"
    ],
    "type": "string"
   },
   "lat": {
    "description": "Latitude (UK only, 49.5\u201361.0).",
    "type": "number"
   },
   "limit": {
    "description": "1-10, default 5.",
    "type": "number"
   },
   "lng": {
    "description": "Longitude (UK only, -8.5\u20132.0).",
    "type": "number"
   },
   "maxPrice": {
    "type": "number"
   },
   "radiusMiles": {
    "description": "Search radius in miles (1-50, default 25).",
    "type": "number"
   }
  },
  "required": [
   "lat",
   "lng"
  ],
  "type": "object"
 },
 "name": "search_by_location",
 "outputSchema": {
  "properties": {
   "attribution": {
    "description": "Citation string \u2014 include verbatim when surfacing data.",
    "type": "string"
   },
   "listings": {
    "items": {
     "properties": {
      "brand": {
       "type": [
        "string",
        "null"
       ]
      },
      "city": {
       "type": [
        "string",
        "null"
       ]
      },
      "condition": {
       "type": "string"
      },
      "delivery": {
       "type": [
        "string",
        "null"
       ]
      },
      "distanceMiles": {
       "type": [
        "number",
        "null"
       ]
      },
      "ebikeBatteryWh": {
       "type": [
        "number",
        "null"
       ]
      },
      "ebikeMotor": {
       "type": [
        "string",
        "null"
       ]
      },
      "frameMaterial": {
       "type": [
        "string",
        "null"
       ]
      },
      "frameSize": {
       "type": [
        "string",
        "null"
       ]
      },
      "groupset": {
       "type": [
        "string",
        "null"
       ]
      },
      "imageUrl": {
       "format": "uri",
       "type": [
        "string",
        "null"
       ]
      },
      "isEbike": {
       "type": "boolean"
      },
      "listingId": {
       "type": [
        "string",
        "null"
       ]
      },
      "model": {
       "type": [
        "string",
        "null"
       ]
      },
      "negotiable": {
       "type": "boolean"
      },
      "offer": {
       "description": "UCP/ACP-shaped commerce signal for this listing.",
       "properties": {
        "availability": {
         "type": "string"
        },
        "itemCondition": {
         "type": "string"
        },
        "price": {
         "type": "number"
        },
        "priceCurrency": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "priceGbp": {
       "description": "Price in GBP.",
       "type": "number"
      },
      "slug": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": [
        "string",
        "null"
       ]
      },
      "wheelSize": {
       "type": [
        "string",
        "null"
       ]
      },
      "year": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "resultsCount": {
    "type": "number"
   }
  },
  "required": [
   "attribution",
   "resultsCount",
   "listings"
  ],
  "type": "object"
 }
}

{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:scan"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Check a PDF for PDF/UA-1 conformance"
 },
 "description": "Downloads a public PDF URL and runs a machine-verifiable veraPDF PDF/UA-1 check (document structure, tags, reading order \u2014 not a full WCAG audit). Free tier, counted against the caller's daily quota. Queues the check and returns immediately with an id; call get_pdf_check to poll.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "A public URL serving a PDF file.",
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "check_pdf",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "coverageDisclaimer": {
    "description": "Why this result is not a compliance verdict. Always relay it; never present a scan as proof of conformance.",
    "type": "string"
   },
   "pdfCheck": {
    "additionalProperties": false,
    "properties": {
     "failureReason": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "string"
         },
         "reason": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "code"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "profile": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "summary": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "failedCheckCount": {
          "type": [
           "number",
           "null"
          ]
         },
         "failedRuleCount": {
          "type": [
           "number",
           "null"
          ]
         },
         "reportTruncated": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "totalAssertions": {
          "type": [
           "number",
           "null"
          ]
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "status",
     "profile"
    ],
    "type": "object"
   },
   "scoringGuidance": {
    "description": "Binding instruction for the assistant reading this result. Follow it literally.",
    "type": "string"
   },
   "standard": {
    "description": "The standard the checks were run against, e.g. \"WCAG 2.1 AA\".",
    "type": "string"
   }
  },
  "required": [
   "pdfCheck",
   "coverageDisclaimer",
   "scoringGuidance",
   "standard"
  ],
  "type": "object"
 },
 "title": "Check a PDF for PDF/UA-1 conformance"
}

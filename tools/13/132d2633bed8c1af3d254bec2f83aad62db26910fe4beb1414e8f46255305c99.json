{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Build a daily digest"
 },
 "description": "Aggregate the top-N articles across selected verticals for the requested window. Heaviest action \u2014 counts more against the per-agent rate limit. Use this for 'read me today's tech news' style prompts.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "verticals": {
    "items": {
     "enum": [
      "tech",
      "finance",
      "science",
      "media",
      "sports",
      "culture"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "window": {
    "default": "24h",
    "enum": [
     "24h",
     "7d",
     "30d"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "digest",
 "title": "Build a daily digest"
}

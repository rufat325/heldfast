{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "DAU Trend"
 },
 "description": "Get the daily active users series between two dates (UTC days). Use for growth/trend questions; use network_stats for today's single value. Returns per-day total DAU plus buyer/seller breakdown and new-user count. Default window: last 30 days. granularity: day (only value supported today).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "ISO date YYYY-MM-DD (UTC). Default: today \u2212 30 days.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "granularity": {
    "default": "day",
    "description": "Bucket size. Only 'day' is supported today; param is reserved for future expansion.",
    "enum": [
     "day"
    ],
    "type": "string"
   },
   "to": {
    "description": "ISO date YYYY-MM-DD (UTC). Default: today.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "dau_trend",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "from": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "granularity": {
    "enum": [
     "day"
    ],
    "type": "string"
   },
   "series": {
    "items": {
     "properties": {
      "date": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "dau": {
       "description": "Distinct active addresses on this day",
       "type": "integer"
      },
      "dauBuyers": {
       "type": "integer"
      },
      "dauSellers": {
       "type": "integer"
      },
      "newUsers": {
       "description": "Buyers whose first lifetime deposit was on this day",
       "type": "integer"
      }
     },
     "required": [
      "date",
      "dau",
      "dauBuyers",
      "dauSellers",
      "newUsers"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "to": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to",
   "granularity",
   "series"
  ],
  "type": "object"
 }
}

{
 "description": "Create a Wan task on RunAPI (text to image). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "enum": [
     "1:1",
     "16:9",
     "4:3",
     "21:9",
     "3:4",
     "9:16",
     "8:1",
     "1:8"
    ],
    "type": "string"
   },
   "bbox_list": {
    "items": {},
    "type": "array"
   },
   "callback_url": {
    "type": "string"
   },
   "color_palette": {
    "items": {},
    "type": "array"
   },
   "enable_safety_checker": {
    "type": "boolean"
   },
   "enable_sequential": {
    "type": "boolean"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "wan-2.7-image",
     "wan-2.7-image-pro"
    ],
    "type": "string"
   },
   "output_count": {
    "type": "number"
   },
   "output_resolution": {
    "enum": [
     "1k",
     "2k",
     "4k"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "seed": {
    "type": "number"
   },
   "source_image_urls": {
    "items": {},
    "type": "array"
   },
   "thinking_mode": {
    "type": "boolean"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   },
   "watermark": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "text_to_image"
}

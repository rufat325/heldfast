{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan Platform Delivery Matrix"
 },
 "description": "Plan multi-ratio delivery of one source sequence to TikTok, Reels, Shorts, YouTube, LinkedIn, X, and Facebook from a local spec table: sequence settings, reframe scale math, duration and file-size fit, caption safe zones, and ordered apply routes. Local-only; never changes Premiere.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "export_preset_hint": {
    "description": "Optional export preset name to echo into the export step.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "additionalProperties": false,
    "description": "Source sequence characteristics.",
    "properties": {
     "duration_seconds": {
      "description": "Source duration in seconds.",
      "maximum": 172800,
      "minimum": 0.001,
      "type": "number"
     },
     "frame_rate": {
      "description": "Source frame rate in frames per second.",
      "maximum": 240,
      "minimum": 1,
      "type": "number"
     },
     "has_captions": {
      "description": "Whether the source already carries a caption track.",
      "type": "boolean"
     },
     "height": {
      "description": "Source frame height in pixels.",
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
     },
     "sequence_id": {
      "description": "Optional Premiere sequence ID recorded in the plan evidence.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "width": {
      "description": "Source frame width in pixels.",
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height",
     "frame_rate",
     "duration_seconds"
    ],
    "type": "object"
   },
   "strategy": {
    "description": "Reframe strategy when the aspect ratio changes; defaults to auto_reframe.",
    "enum": [
     "auto_reframe",
     "pad_blur",
     "center_crop",
     "letterbox"
    ],
    "type": "string"
   },
   "targets": {
    "description": "Unique platform ids to plan for.",
    "items": {
     "description": "Platform id.",
     "enum": [
      "tiktok",
      "instagram_reels",
      "instagram_feed",
      "instagram_story",
      "youtube_shorts",
      "youtube",
      "linkedin",
      "x",
      "facebook_reels"
     ],
     "type": "string"
    },
    "maxItems": 9,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "source",
   "targets"
  ],
  "type": "object"
 },
 "name": "plan_platform_delivery_matrix",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Plan Platform Delivery Matrix"
}

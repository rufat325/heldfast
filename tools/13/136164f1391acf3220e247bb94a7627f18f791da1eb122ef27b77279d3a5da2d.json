{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Import Guest List"
 },
 "description": "Bulk-add up to 200 guests to a live event's guest list in one call (parse the CSV / contact list into rows; each needs at least a first name). Counts the whole batch against the weekly invite limit. Requires event_id; you must be a host.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "event_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "guests": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "maxLength": 80,
       "type": "string"
      },
      "email": {
       "format": "email",
       "maxLength": 320,
       "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
       "type": "string"
      },
      "first_name": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "last_name": {
       "maxLength": 120,
       "type": "string"
      },
      "note": {
       "maxLength": 1000,
       "type": "string"
      },
      "phone": {
       "maxLength": 40,
       "type": "string"
      },
      "plus_ones_allowed": {
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      },
      "tags": {
       "items": {
        "maxLength": 80,
        "type": "string"
       },
       "maxItems": 50,
       "type": "array"
      },
      "ticket_class_id": {
       "maxLength": 128,
       "type": "string"
      }
     },
     "required": [
      "first_name"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "event_id",
   "guests"
  ],
  "type": "object"
 },
 "name": "import_guest_list",
 "title": "Import Guest List"
}

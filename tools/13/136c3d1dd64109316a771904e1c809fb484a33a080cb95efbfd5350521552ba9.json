{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Process multiple 1099 forms and calculate the tax impact of each income type. Handles 1099-NEC (freelance), 1099-INT (interest), 1099-DIV (dividends), 1099-B (investments), 1099-MISC.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filingStatus": {
    "enum": [
     "single",
     "married_filing_jointly",
     "married_filing_separately",
     "head_of_household"
    ],
    "type": "string"
   },
   "forms": {
    "description": "Array of 1099 forms",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "Total amount",
       "type": "number"
      },
      "earlyDistributionSubjectToPenalty": {
       "description": "For 1099-R: taxable early-distribution amount after exceptions",
       "minimum": 0,
       "type": "number"
      },
      "longTerm": {
       "description": "For 1099-B: long-term gains",
       "type": "boolean"
      },
      "payer": {
       "description": "Payer name",
       "type": "string"
      },
      "qualifiedDividends": {
       "description": "For 1099-DIV: qualified dividends",
       "type": "number"
      },
      "taxableAmount": {
       "description": "For 1099-R: taxable amount in box 2a",
       "minimum": 0,
       "type": "number"
      },
      "type": {
       "enum": [
        "1099-NEC",
        "1099-INT",
        "1099-DIV",
        "1099-B",
        "1099-MISC",
        "1099-R"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "longTermCapitalLossCarryover": {
    "minimum": 0,
    "type": "number"
   },
   "qualifiedBusinessIsSstb": {
    "type": "boolean"
   },
   "qualifiedBusinessPropertyBasis": {
    "minimum": 0,
    "type": "number"
   },
   "qualifiedBusinessW2Wages": {
    "minimum": 0,
    "type": "number"
   },
   "shortTermCapitalLossCarryover": {
    "minimum": 0,
    "type": "number"
   },
   "taxYear": {
    "description": "Tax year",
    "type": "number"
   },
   "w2Income": {
    "description": "W-2 income (for context)",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "taxYear",
   "filingStatus",
   "forms"
  ],
  "type": "object"
 },
 "name": "process_1099_income",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "suggestion"
    ],
    "type": "object"
   },
   "isError": {
    "type": "boolean"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "isError"
  ],
  "type": "object"
 }
}

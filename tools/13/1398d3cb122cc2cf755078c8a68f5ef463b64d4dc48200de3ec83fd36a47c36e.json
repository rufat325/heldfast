  "title": "YNAB: Create Account"
 },
 "description": "Create a new account in a YNAB budget.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - name (string, required): Account name.\n  - type (string, required): One of: checking, savings, creditCard, cash, lineOfCredit, otherAsset, otherLiability.\n  - balance (number, optional): Opening balance in dollars. Default: 0.\n  - dry_run (boolean, optional): Preview the request without creating. Default: false.\n\nReturns: account object with id, name, type, balance fields.\n\nExamples:\n  - Create checking account: set name=\"My Checking\", type=\"checking\"\n  - Dry run: set dry_run=true to preview without saving\n\nWrite safety: call without confirmation_token to preview. Execute the identical validated request with the short-lived confirmation_token returned by that preview.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "balance": {
    "type": "number"
   },
   "budget_id": {
    "minLength": 1,
    "type": "string"
   },
   "confirmation_token": {
    "description": "Short-lived, single-use token returned by the immediately preceding preview of this exact validated request.",
    "minLength": 16,
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "enum": [
     "checking",
     "savings",
     "creditCard",
     "cash",
     "lineOfCredit",
     "otherAsset",
     "otherLiability"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "type"
  ],
  "type": "object"
 },

{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List this account's transcripts, newest first. Use sort=\"completedAt\" for finished transcripts ordered by completion.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max results (default 10).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "enum": [
     "createdAt",
     "completedAt"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "queued",
     "pending",
     "fetching",
     "transcribing",
     "analyzing",
     "complete",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_transcripts",
 "title": "List transcripts"
}

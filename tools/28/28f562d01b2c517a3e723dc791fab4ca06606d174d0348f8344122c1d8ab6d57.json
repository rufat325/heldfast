{
 "description": "Set the preferred content size for Dynamic Type testing. Test your app with accessibility text sizes without changing device settings manually.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "description": "Device (default: booted)",
    "type": "string"
   },
   "size": {
    "description": "Preferred content size category for Dynamic Type testing",
    "enum": [
     "extra-small",
     "small",
     "medium",
     "large",
     "extra-large",
     "extra-extra-large",
     "extra-extra-extra-large",
     "accessibility-medium",
     "accessibility-large",
     "accessibility-extra-large",
     "accessibility-extra-extra-large",
     "accessibility-extra-extra-extra-large"
    ],
    "type": "string"
   }
  },
  "required": [
   "size"
  ],
  "type": "object"
 },
 "name": "simulator_set_content_size"
}

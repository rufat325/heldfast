{
 "description": "Estimate US tax refund or balance due before filing: tax owed minus withholding minus credits, federal and state. NOT the IRS refund tracker.",
 "inputSchema": {
  "properties": {
   "credits": {
    "description": "Tax credits (e.g. Child Tax Credit)",
    "type": "number"
   },
   "federalWithheld": {
    "description": "Federal tax already withheld",
    "type": "number"
   },
   "filingStatus": {
    "default": "single",
    "description": "Tax filing status",
    "enum": [
     "single",
     "married",
     "head"
    ],
    "type": "string"
   },
   "grossIncome": {
    "description": "Gross annual income",
    "type": "number"
   },
   "itemizedDeductions": {
    "description": "Itemized deductions",
    "type": "number"
   },
   "preTaxDeductions": {
    "description": "Pre-tax deductions (401k, HSA)",
    "type": "number"
   },
   "state": {
    "default": "",
    "description": "US state abbreviation (e.g. CA, NY, TX)",
    "type": "string"
   },
   "stateWithheld": {
    "description": "State tax withheld",
    "type": "number"
   }
  },
  "required": [
   "grossIncome",
   "federalWithheld"
  ],
  "type": "object"
 },
 "name": "calculate_tax_refund"
}

      "error"
     ]
    },
    "required": [
     "sources",
     "totalCount",
     "currentPage",
     "totalPages"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "currentPage": {
    "description": "Page number requested \u2014 past totalPages when the request ran off the end.",
    "type": "number"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode.",
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "notice": {
    "description": "Context for an empty page: the page range that exists when the requested page is past the end.",
    "type": "string"
   },
   "sources": {
    "description": "World Bank data sources for this page.",
    "items": {
     "additionalProperties": false,
     "description": "A World Bank data source entry.",
     "properties": {
      "code": {
       "description": "Short dataset code.",
       "type": "string"
      },
      "concepts": {
       "description": "Number of concepts (variables) in this source.",
       "type": "string"
      },
      "dataAvailability": {
       "description": "Data availability status.",
       "type": "string"
      },
      "id": {
       "description": "Source ID for use in worldbank_search_indicators.",
       "type": "string"
      },
      "lastUpdated": {
       "description": "Date of last data update (YYYY-MM-DD or empty).",
       "type": "string"
      },
      "metadataAvailability": {
       "description": "Metadata availability status.",
       "type": "string"
      },
      "name": {
       "description": "Dataset name.",
       "type": "string"

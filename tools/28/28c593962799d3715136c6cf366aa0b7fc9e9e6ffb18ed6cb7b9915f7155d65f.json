  "readOnlyHint": true
 },
 "description": "List the 70+ World Bank data sources (datasets), such as World Development Indicators, International Debt Statistics, and Doing Business. Returns source IDs and names for use as source_id in worldbank_search_indicators, one page at a time.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "page": {
    "default": 1,
    "description": "Pagination page number (1-based).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Results per page (default: server default, max: 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "worldbank_list_sources",
 "outputSchema": {

{
 "description": "Add a user to a project with a project role (admin/editor/viewer). Find user IDs with list_users and project IDs with list_projects.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "description": "Project ID",
    "type": "string"
   },
   "role": {
    "default": "project:editor",
    "description": "Role of the user inside the project",
    "enum": [
     "project:admin",
     "project:editor",
     "project:viewer"
    ],
    "type": "string"
   },
   "userId": {
    "description": "User ID (see list_users)",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "userId"
  ],
  "type": "object"
 },
 "name": "add_user_to_project"
}

{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Member Setup"
 },
 "description": "Edit a member setup's split terms (terms: null = permission-only). Prospective \u2014 future attaches use the new terms, attached events keep theirs. Requires deal_id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "deal_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "terms": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "notes": {
        "maxLength": 2000,
        "type": "string"
       },
       "splits": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "recipient_id": {
           "maxLength": 128,
           "minLength": 1,
           "type": "string"
          },
          "recipient_type": {
           "enum": [
            "producer",
            "community"
           ],
           "type": "string"
          },
          "share_value": {
           "maximum": 100,
           "minimum": 0,
           "type": "number"
          }
         },
         "required": [
          "recipient_id",
          "recipient_type",
          "share_value"
         ],
         "type": "object"
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "splits"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "deal_id",
   "terms"
  ],
  "type": "object"
 },
 "name": "update_member_setup",
 "title": "Update Member Setup"
}

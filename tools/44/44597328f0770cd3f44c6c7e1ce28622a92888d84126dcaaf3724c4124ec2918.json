{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List short links"
 },
 "description": "List short links in a workspace, newest first. Optional `query` searches URL, name, and slug.",
 "inputSchema": {
  "properties": {
   "page": {
    "description": "1-based page number.",
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page (max 200, default 25).",
    "type": "integer"
   },
   "query": {
    "description": "Search term (destination, name, or slug).",
    "type": "string"
   },
   "workspace": {
    "description": "Workspace id. Optional when the account has one workspace; use list_workspaces to resolve otherwise.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_short_links",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "description": "Total matching rows across all pages.",
    "type": "integer"
   },
   "error": {
    "additionalProperties": true,
    "description": "Present only when the tool failed (the result is also flagged isError).",
    "properties": {
     "cause": {
      "description": "Machine-readable failure category: invalid_argument, not_found, forbidden, plan_limit, rate_limited, or server_error.",
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retryable": {
      "description": "Whether repeating the same call could succeed.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "next": {
    "description": "URL of the next page, or null on the last page.",
    "type": [
     "string",
     "null"
    ]
   },
   "previous": {
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "created": {
       "type": "string"
      },
      "display_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "domain": {
       "type": "string"
      },
      "gps": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "link": {
       "description": "Destination URL.",
       "type": "string"
      },
      "link_type": {
       "type": "string"
      },
      "png": {
       "type": [
        "string",
        "null"
       ]
      },
      "short_url": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "svg": {
       "description": "QR code for the short URL, as SVG markup.",
       "type": [
        "string",
        "null"
       ]
      },
      "total_clicks": {
       "type": "integer"
      },
      "unique_clicks": {
       "type": "integer"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}

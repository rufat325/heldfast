{
 "description": "[WRITE] Update an existing GTM zone. Requires GTM_MCP_ENABLE_WRITES=true and confirm=true. Pass the full resource as a JSON string in bodyJson.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "description": "The GTM account ID.",
    "type": "string"
   },
   "bodyJson": {
    "description": "Full zones resource as a JSON string.",
    "type": "string"
   },
   "confirm": {
    "description": "Must be true to confirm this write operation.",
    "type": "boolean"
   },
   "containerId": {
    "description": "The GTM container ID.",
    "type": "string"
   },
   "fingerprint": {
    "description": "Current fingerprint (for optimistic locking).",
    "type": "string"
   },
   "workspaceId": {
    "description": "The GTM workspace ID.",
    "type": "string"
   },
   "zoneId": {
    "description": "The zones ID to update.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "containerId",
   "workspaceId",
   "zoneId",
   "bodyJson",
   "confirm"
  ],
  "type": "object"
 },
 "name": "zones_update"
}

{
 "description": "Fill masked background areas within an image's existing canvas (same size in, same size out). White mask = fill area, black = preserve. For expanding the canvas beyond the original image bounds, use recraft_outpaint instead. V3/V3 Vector only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "controls": {
    "description": "Generation controls",
    "properties": {
     "artistic_level": {
      "description": "Artistic level 0-5 (V3 only)",
      "maximum": 5,
      "minimum": 0,
      "type": "integer"
     },
     "background_color": {
      "description": "Background color RGB (0-255)",
      "properties": {
       "b": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "g": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "r": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "r",
       "g",
       "b"
      ],
      "type": "object"
     },
     "colors": {
      "description": "Preferred color palette, e.g. [[255,0,0],[0,255,0]]",
      "items": {
       "items": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "type": "array"
      },
      "type": "array"
     },
     "no_text": {
      "description": "Exclude text layouts (V3 only)",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "file_path": {
    "description": "Local path to source image",
    "type": "string"
   },
   "mask_path": {
    "description": "Local path to mask (white=fill, black=preserve)",
    "type": "string"
   },
   "model": {
    "default": "recraftv3",
    "description": "Model (V3 only)",
    "type": "string"
   },
   "n": {
    "default": 1,
    "description": "Number of images to generate (1-6)",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "negative_prompt": {
    "description": "What to exclude",
    "type": "string"
   },
   "prompt": {
    "description": "Description of background to generate",
    "type": "string"
   },
   "response_format": {
    "default": "url",
    "description": "Response format",
    "enum": [
     "url",
     "b64_json"
    ],
    "type": "string"
   },
   "style": {
    "description": "Broad style family. One of: any, digital_illustration, icon, realistic_image, vector_illustration, logo_raster. A specific look (e.g. pixel_art, kawaii, b_and_w) belongs in `substyle`, but passing one here is accepted and routed to the right field.",
    "type": "string"
   },
   "style_id": {
    "description": "Custom style UUID",
    "type": "string"
   },
   "substyle": {
    "description": "Specific look within the family \u2014 104 values, validated strictly. Common ones: 2d_art_poster, 3d, 80s, glow, grain, hand_drawn, infantile_sketch, kawaii, pixel_art, psychedelic, seamless, voxel. An invalid value returns the full list.",
    "type": "string"
   },
   "text_layout": {
    "description": "Text placement on image",
    "items": {
     "properties": {
      "bbox": {
       "description": "4-point polygon with relative coordinates [0-1]",
       "items": {
        "items": {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "type": "array"
       },
       "maxItems": 4,
       "minItems": 4,
       "type": "array"
      },
      "text": {
       "description": "Text to render (single word)",
       "type": "string"
      }
     },
     "required": [
      "text",
      "bbox"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "file_path",
   "mask_path",
   "prompt"
  ],
  "type": "object"
 },
 "name": "recraft_generate_background"
}

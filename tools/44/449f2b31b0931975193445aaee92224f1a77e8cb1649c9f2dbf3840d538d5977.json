{
 "description": "Replace all automation points for one clip envelope. Use when the user wants a complete envelope rewrite for mixer or device parameters. NOT idempotent for partial edits; returns written point count and verification diff after hold-curve expansion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clip_slot_index": {
    "minimum": 0,
    "type": "integer"
   },
   "parameter_path": {
    "description": "mixer.volume | mixer.panning | mixer.send.<i> | device.<i>.parameter.<n>",
    "minLength": 1,
    "type": "string"
   },
   "points": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "curve_type": {
       "enum": [
        "linear",
        "ramp",
        "hold"
       ],
       "type": "string"
      },
      "time": {
       "description": "Beats from clip start.",
       "minimum": 0,
       "type": "number"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "time",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "track_index": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "track_index",
   "clip_slot_index",
   "parameter_path",
   "points"
  ],
  "type": "object"
 },
 "name": "clip_set_envelope"
}

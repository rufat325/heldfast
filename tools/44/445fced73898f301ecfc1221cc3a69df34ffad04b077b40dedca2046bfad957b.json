 "description": "Look up registration and ownership via RDAP (structured JSON), with a WHOIS fallback for TLDs without RDAP or when RDAP is unresponsive. For a domain it returns registrar, status codes, creation/expiry/updated events, nameservers, and DNSSEC; for an IP or CIDR it returns the netblock name, allocation CIDRs, origin ASN, and country. Registry data is frequently redacted or sparse \u2014 absent fields are reported as unknown, never inferred. Use only on assets you own or are authorized to assess.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "target": {
    "description": "A domain (e.g. \"example.com\"), an IP (e.g. \"8.8.8.8\"), or a CIDR (e.g. \"8.8.8.0/24\").",
    "type": "string"
   },
   "type": {
    "default": "auto",
    "description": "Force the target interpretation, or \"auto\" to detect domain vs IP/CIDR.",
    "enum": [
     "auto",
     "domain",
     "ip"
    ],
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "attacksurface_lookup_registration",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {

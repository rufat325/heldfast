    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `invalid_target`: The target is not a valid domain, IP, or CIDR. Other values are possible when a failure originates below the handler.",
        "examples": [
         "invalid_target"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "notes": {
    "description": "Notes such as RDAP-timeout-then-WHOIS-fallback.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rawWhois": {
    "description": "Raw WHOIS text when the WHOIS fallback answered, else null.",
    "type": [
     "string",
     "null"
    ]
   },
   "registration": {
    "description": "The parsed registration record (domain or IP).",
    "oneOf": [
     {
      "additionalProperties": false,
      "description": "Domain registration record (RDAP or WHOIS).",
      "properties": {
       "dnssecSigned": {
        "description": "Whether DNSSEC is signed, when reported.",
        "type": "boolean"
       },
       "events": {
        "description": "Registration lifecycle events.",
        "items": {
         "additionalProperties": false,
         "description": "A registration lifecycle event.",
         "properties": {
          "action": {
           "description": "Event action (e.g. \"registration\", \"expiration\", \"last changed\").",
           "type": "string"
          },
          "date": {
           "description": "Event timestamp (ISO 8601 when from RDAP; raw when from WHOIS).",
           "type": "string"
          }
         },
         "required": [

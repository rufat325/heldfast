       "cidrs",
       "originAsns",
       "statuses",
       "events"
      ],
      "type": "object"
     }
    ]
   },
   "source": {
    "description": "Which source answered the lookup.",
    "enum": [
     "rdap",
     "whois"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },

        "items": {
         "type": "number"
        },
        "type": "array"
       },
       "statuses": {
        "description": "Registry status codes.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "target": {
        "description": "IP or CIDR queried.",
        "type": "string"
       }
      },
      "required": [

          "date"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "kind": {
        "const": "domain",
        "description": "Discriminator: domain registration record.",
        "type": "string"
       },
       "nameservers": {
        "description": "Nameserver hostnames.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "registrar": {
        "description": "Registrar name, when disclosed.",

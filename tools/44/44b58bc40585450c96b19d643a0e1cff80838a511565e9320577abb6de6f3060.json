{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Manage Event Series"
 },
 "description": "Manage a recurring series \u2014 action 'extend' (add additional_count more occurrences), 'end' (cancel upcoming; mode 'pause' to suspend, optional from_date), or 'resume' (restart a paused series). Requires series_id + action; you must be a host of the series.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "extend",
     "end",
     "resume"
    ],
    "type": "string"
   },
   "additional_count": {
    "maximum": 52,
    "minimum": 1,
    "type": "integer"
   },
   "from_date": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "mode": {
    "enum": [
     "end",
     "pause"
    ],
    "type": "string"
   },
   "series_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "series_id",
   "action"
  ],
  "type": "object"
 },
 "name": "manage_event_series",
 "title": "Manage Event Series"
}

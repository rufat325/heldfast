    "minLength": 1,
    "type": "string"
   },
   "destination": {
    "additionalProperties": false,
    "properties": {
     "city": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "country": {
      "maxLength": 2,
      "minLength": 1,
      "type": "string"
     },
     "postalCode": {
      "maxLength": 20,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "country"
    ],
    "type": "object"
   },
   "origin": {
    "additionalProperties": false,
    "properties": {
     "city": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "country": {
      "maxLength": 2,
      "minLength": 1,
      "type": "string"
     },
     "postalCode": {
      "maxLength": 20,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "country"
    ],
    "type": "object"
   },
   "serviceLevel": {
    "default": "auto",
    "enum": [
     "economy",
     "standard",
     "express",
     "auto"
    ],
    "type": "string"
   },
   "shipment": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "declaredValue": {
      "maximum": 100000000,
      "minimum": 0,
      "type": "number"
     },
     "heightCm": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "number"
     },
     "lengthCm": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "number"
     },
     "quantity": {
      "default": 1,
      "maximum": 10000,
      "minimum": 1,
      "type": "integer"
     },
     "weightKg": {
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "type": "number"
     },
     "widthCm": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "number"
     }
    },
    "required": [
     "weightKg"
    ],
    "type": "object"
   },
   "shippingMode": {
    "default": "auto",
    "enum": [
     "courier",
     "air",
     "sea",
     "road",
     "postal",
     "auto"
    ],
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "shipment"
  ],
  "type": "object"
 },

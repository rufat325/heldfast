{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Test Run"
 },
 "description": "Update a test run's metadata and/or add test cases to it. Requires a project identifier (PR-*). No tool here lists projects, so if you do not have one, call askBrowserStackAI with product \"tm\" and ask which projects exist, then retry this tool with the identifier it returns.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "project_identifier": {
    "description": "Identifier of the project (Starts with 'PR-')",
    "type": "string"
   },
   "test_run": {
    "properties": {
     "add_test_cases": {
      "description": "Test cases to add to the run",
      "items": {
       "properties": {
        "configuration_ids": {
         "description": "Configuration IDs to apply",
         "items": {
          "type": "number"
         },
         "type": "array"
        },
        "test_case_ids": {
         "description": "Test case IDs, e.g. TC-123",
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        }
       },
       "required": [
        "test_case_ids"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "name": {
      "description": "New name of the test run",
      "type": "string"
     },
     "preserve_existing_results": {
      "description": "Keep existing results when adding cases (default true)",
      "type": "boolean"
     },
     "run_state": {
      "description": "Updated state of the test run",
      "enum": [
       "new_run",
       "in_progress",
       "under_review",
       "rejected",
       "done",
       "closed"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "test_run_id": {
    "description": "Test run identifier (e.g., TR-678)",
    "type": "string"
   }
  },
  "required": [
   "project_identifier",
   "test_run_id",
   "test_run"
  ],
  "type": "object"
 },
 "name": "updateTestRun"
}

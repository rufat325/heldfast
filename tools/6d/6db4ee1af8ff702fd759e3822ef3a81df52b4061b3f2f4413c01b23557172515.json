{
 "description": "Rotate all (or selected) pages of a local PDF by 90/180/270\u00b0.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "angle": {
    "description": "Rotation in degrees",
    "enum": [
     90,
     180,
     270
    ],
    "type": "number"
   },
   "input": {
    "type": "string"
   },
   "output": {
    "type": "string"
   },
   "pages": {
    "description": "1-based page numbers; omit to rotate all",
    "items": {
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "input",
   "output",
   "angle"
  ],
  "type": "object"
 },
 "name": "pdf_rotate",
 "title": "Rotate PDF pages (local, private)"
}

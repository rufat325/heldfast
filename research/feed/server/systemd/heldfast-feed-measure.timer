# Part of the portable collector (research/feed/server/MOVING.md). Shipped,
# not enabled. The times are feed.yml's.
[Unit]
Description=heldfast feed, daily: measure, publish, anchor, archive

[Timer]
OnCalendar=*-*-* 06:23:00 UTC
Persistent=true
Unit=heldfast-feed-measure.service

[Install]
WantedBy=timers.target

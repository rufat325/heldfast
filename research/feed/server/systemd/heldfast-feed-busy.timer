# Part of the portable collector (research/feed/server/MOVING.md). Shipped,
# not enabled. The times are feed.yml's.
[Unit]
Description=heldfast feed, every four hours: the hosted servers that keep changing

[Timer]
OnCalendar=*-*-* 00/4:43:00 UTC
Persistent=true
Unit=heldfast-feed-busy.service

[Install]
WantedBy=timers.target

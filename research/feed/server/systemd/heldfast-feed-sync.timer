# Part of the portable collector (research/feed/server/MOVING.md). Shipped,
# not enabled. The times are feed.yml's.
[Unit]
Description=heldfast feed, Mondays: rebuild the watchlist

[Timer]
OnCalendar=Mon *-*-* 05:03:00 UTC
Persistent=true
Unit=heldfast-feed-sync.service

[Install]
WantedBy=timers.target

# Part of the portable collector (research/feed/server/MOVING.md). Shipped,
# not enabled: enable the timers only after disabling feed.yml's schedule.
[Unit]
Description=heldfast feed: Pack what the mirror does not have yet
After=network-online.target docker.service
Wants=network-online.target
OnSuccess=heldfast-feed-mirror.service

[Service]
Type=oneshot
Group=heldfast
UMask=0007
WorkingDirectory=/var/lib/heldfast-feed
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/heldfast-feed
TimeoutStartSec=6h
User=heldfast-mirror
ExecStart=/usr/bin/flock --wait 21600 /var/lib/heldfast-feed/lock /usr/bin/python3 /opt/heldfast/research/feed/server/run.py archive

  "connect_broker": {
   "digest": "2bc43116271022c5e26165ee9f23ac08610d1ac6d3c107bf45615d58b666c0a2",
   "raw": {
    "description": "Attach a live execution provider to a journal account. For MetaApi, provide its account id and region. For `mt5_executor`, provide the expected MT5 login as `providerAccountRef` and its `baseUrl` under `*.aetherwealth.ai`. `providerToken` is sensitive \u2014 never expose or log it.",
    "inputSchema": {
     "additionalProperties": false,
     "properties": {
      "accountId": {
       "type": "string"
      },
      "approvalMode": {
       "description": "Confirmation mode. 'auto' is not selectable here; 'push' is also set later via set_broker_approval_mode because it requires an active app push subscription.",
       "enum": [
        "app_otp",
        "email_otp"
       ],
       "type": "string"
      },
      "baseUrl": {
       "description": "Required for `mt5_executor`; the executor's HTTPS origin under `*.aetherwealth.ai`.",
       "type": "string"
      },
      "provider": {
       "description": "Defaults to 'metaapi' when omitted.",
       "enum": [
        "metaapi",
        "mt5_executor"
       ],
       "type": "string"
      },
      "providerAccountRef": {
       "description": "The MetaApi account id, or the expected numeric MT5 login for `mt5_executor`.",
       "type": "string"
      },
      "providerToken": {
       "description": "The provider token. For `mt5_executor`, use its service bearer token. Sensitive \u2014 never expose or log it.",
       "type": "string"
      },
      "region": {
       "enum": [
        "new-york",
        "london"
       ],
       "type": "string"
      }
     },
     "required": [
      "accountId",
      "providerAccountRef",
      "providerToken"
     ],
     "type": "object"
    },
    "name": "connect_broker"
   }
  },

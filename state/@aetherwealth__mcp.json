     "additionalProperties": false,
     "properties": {
      "accountId": {
       "type": "string"
      },
      "idempotencyKey": {
       "description": "Stable caller-owned key. Reuse the exact key and inputs only after a transport timeout.",
       "maxLength": 80,
       "minLength": 8,
       "type": "string"
      },
      "positionId": {
       "type": "string"
      },
      "stopLoss": {
       "type": [
        "number",
        "null"
       ]
      },
      "takeProfit": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "accountId",
      "positionId"
     ],
     "type": "object"
    },
    "name": "modify_position"
   }
  },

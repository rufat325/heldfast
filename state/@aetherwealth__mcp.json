  "get_indicators": {
   "digest": "679f8b78929cc7e587094f5317fcb045a555533e4aac00cc58a7bc2c1db68de1",
   "raw": {
    "description": "Compute Twelve Data technical indicators for a pair + timeframe (requires sign-in). Pass up to 8 indicators by name; params are optional and default sensibly. Names \u2014 momentum: rsi, macd, stoch, stochf, stochrsi, cci, cmo, mom, roc, rocr, willr, mfi, ultosc, ppo, apo, bop, aroon, aroonosc; trend: adx, adxr, dx, plus_di, minus_di, plus_dm, minus_dm, sar, supertrend; moving averages: sma, ema, wma, dema, tema, trima, kama, t3ma, mama, vwap, midpoint, midprice; bands: bbands, keltner, percent_b; volatility: atr, natr, trange; volume: obv, ad, adosc; stats: linearreg, linearregslope, linearregangle, linearregintercept, stddev, var, tsf. Bad names/params return an error listing valid options. At most 2 distinct pairs per user at a time.",
    "inputSchema": {
     "additionalProperties": false,
     "properties": {
      "indicators": {
       "description": "Up to 8 indicators to compute on the pair",
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "description": "Indicator name, e.g. rsi, macd, ema, bbands, atr, adx",
          "type": "string"
         },
         "params": {
          "description": "Optional params, e.g. {\"time_period\": 14} or MACD {\"fast_period\":12,\"slow_period\":26}. Defaults applied when omitted.",
          "type": "object"
         }
        },
        "required": [
         "name"
        ],
        "type": "object"
       },
       "maxItems": 8,
       "minItems": 1,
       "type": "array"
      },
      "interval": {
       "description": "One of 1m, 5m, 15m, 30m, 45m, 1h, 2h, 4h, 1d",
       "type": "string"
      },
      "outputsize": {
       "description": "Bars to return per indicator (default 30)",
       "maximum": 500,
       "minimum": 1,
       "type": "integer"
      },
      "pair": {
       "description": "Canonical id, e.g. EURUSD, XAUUSD, BTCUSD (case-insensitive)",
       "type": "string"
      }
     },
     "required": [
      "pair",
      "interval",
      "indicators"
     ],
     "type": "object"
    },
    "name": "get_indicators"
   }
  },

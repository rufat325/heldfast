  "create_indicator_alert": {
   "digest": "db206b0b330c5df72c3bb19b220b88c5e38c048cd29ebb2cbedc44b8bf6f6dfd",
   "raw": {
    "description": "Create an indicator alert (fires on an indicator output condition, e.g. RSI crosses 70). `condition` is { op, threshold } or { op, other }. Requires sign-in.",
    "inputSchema": {
     "additionalProperties": false,
     "properties": {
      "condition": {
       "description": "{ op: gt|gte|lt|lte|eq|crosses_above|crosses_below, threshold } or { op: *_series, other }",
       "type": "object"
      },
      "dedupMode": {
       "description": "default: edge",
       "enum": [
        "edge",
        "continuous"
       ],
       "type": "string"
      },
      "expiresAt": {
       "description": "ISO 8601 datetime",
       "type": "string"
      },
      "indicatorParams": {
       "description": "Indicator settings, e.g. { length: 14 }",
       "type": "object"
      },
      "indicatorType": {
       "description": "e.g. rsi, ema, macd",
       "type": "string"
      },
      "isPersistent": {
       "description": "Re-arm after firing. default: false",
       "type": "boolean"
      },
      "message": {
       "type": "string"
      },
      "notifyEmail": {
       "description": "default: true",
       "type": "boolean"
      },
      "notifyPush": {
       "description": "default: true",
       "type": "boolean"
      },
      "outputSeries": {
       "description": "Which output series to watch",
       "type": "string"
      },
      "pair": {
       "type": "string"
      },
      "timeframe": {
       "type": "string"
      },
      "triggerType": {
       "description": "default: close",
       "enum": [
        "close",
        "wick"
       ],
       "type": "string"
      }
     },
     "required": [
      "pair",
      "timeframe",
      "indicatorType",
      "indicatorParams",
      "outputSeries",
      "condition"
     ],
     "type": "object"
    },
    "name": "create_indicator_alert"
   }
  },

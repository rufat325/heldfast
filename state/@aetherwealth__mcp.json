     ],
     "type": "object"
    },
    "name": "propose_trade"
   }
  },
  "render_chart": {
   "digest": "56e11d4d4e28ffe85a3becaa331cd76e564496da9f928aabb9d3447f2fc6ba29",
   "raw": {
    "description": "Render an annotated candlestick chart image (PNG) for a pair + timeframe and optional market-data sourceId. Fetches recent candles and draws optional shapes (support/resistance lines, zones, trendlines, a long/short position) using the same vocabulary as draw_chart_shape. Returns the chart as an image plus a text summary. PREFER absolute time anchors (time1/time2/entryTime, epoch seconds from get_candles) over barsBack*.",
    "inputSchema": {
     "additionalProperties": false,
     "properties": {
      "bars": {
       "description": "Most-recent candles to show (20-200, default 120)",
       "maximum": 200,
       "minimum": 20,
       "type": "integer"
      },
      "height": {
       "description": "Image height in px (240-1440, default 720)",
       "maximum": 1440,
       "minimum": 240,
       "type": "integer"
      },
      "offset": {
       "description": "Candle page offset: 0 is the latest page; larger offsets walk backward through history. Pair with bars to frame a historical setup.",
       "maximum": 4800,
       "minimum": 0,
       "type": "integer"
      },
      "pair": {
       "description": "Canonical instrument id, e.g. EURUSD (case-insensitive)",
       "type": "string"
      },
      "shapes": {
       "description": "Optional annotations. Each item is {type, ...}: horizontal_line/horizontal_ray/cross_line need `price`; zone/rectangle need `priceHigh`+`priceLow`; trendline/ray/right_ray/left_ray/extended_line/info_line/trend_angle need `price1`+`price2` (prefer `time1`+`time2` epoch seconds); position needs `direction` (long/short)+`entry`+`stop`+`target`. Optional `label`, `color` (hex), and `affectsScale` (false keeps a distant contextual level labelled without compressing the active setup).",
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "sourceId": {
       "description": "Market-data source from get_market_config, e.g. mt5-primary. Omit for Twelve Data.",
       "pattern": "^[a-z][a-z0-9-]{0,62}$",
       "type": "string"
      },
      "theme": {
       "description": "Color theme (default dark)",
       "enum": [
        "dark",
        "light"
       ],
       "type": "string"
      },
      "timeframe": {
       "description": "e.g. 1m, 5m, 15m, 30m, 1h, 4h, 1d (or an integer multiple)",
       "type": "string"
      },
      "width": {
       "description": "Image width in px (320-2560, default 1280)",
       "maximum": 2560,
       "minimum": 320,
       "type": "integer"
      }
     },
     "required": [
      "pair",
      "timeframe"
     ],
     "type": "object"
    },
    "name": "render_chart"
   }
  },

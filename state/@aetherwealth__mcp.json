  "get_candles": {
   "digest": "25acd0c794dc8997a83bf31fd77ffa6f655842175393607f1887b68d32a13e69",
   "raw": {
    "description": "Get OHLC candles for a pair + timeframe and optional sourceId. Omit sourceId for Twelve Data. Non-default sources return only native timeframes advertised by get_market_config; they are never re-aggregated. Returns up to 200 bars plus nextCursor. Pass nextCursor back as cursor until it is null. The legacy offset remains available for shallow pagination; do not combine offset and cursor.",
    "inputSchema": {
     "additionalProperties": false,
     "properties": {
      "cursor": {
       "description": "Opaque nextCursor returned by the previous get_candles page. Omit on the first page; continue until nextCursor is null. Do not combine with offset.",
       "maxLength": 2048,
       "minLength": 1,
       "type": "string"
      },
      "limit": {
       "description": "Maximum candles to return (1-200). Omit for the newest 200.",
       "maximum": 200,
       "minimum": 1,
       "type": "integer"
      },
      "offset": {
       "description": "Legacy shallow pagination: number of recent candles to skip (0\u20134800). Use cursor instead for complete history; do not combine offset and cursor.",
       "maximum": 4800,
       "minimum": 0,
       "type": "integer"
      },
      "pair": {
       "description": "e.g. EURUSD, BTCUSD (canonical id; case-insensitive)",
       "type": "string"
      },
      "sourceId": {
       "description": "Market-data source from get_market_config, e.g. mt5-primary. Omit for Twelve Data.",
       "pattern": "^[a-z][a-z0-9-]{0,62}$",
       "type": "string"
      },
      "timeframe": {
       "description": "A base (1m, 5m, 15m, 30m, 1h, 4h, 1d) or an integer multiple of one (e.g. 2h, 3h, 12h, 90m). No fractional (2.5h) or sub-minute values.",
       "type": "string"
      }
     },
     "required": [
      "pair",
      "timeframe"
     ],
     "type": "object"
    },
    "name": "get_candles"
   }
  },

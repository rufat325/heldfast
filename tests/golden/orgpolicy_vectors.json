{
 "about": "Inputs and the answers both src/heldfast/orgpolicy.py (with inventory.py) and plugin/heldfast/scripts/orgpolicy.js must give. Written from the Python and checked against both by tests/test_orgpolicy_parity.py.",
 "glob": [
  {
   "why": "a star crosses dots",
   "input": [
    "x.acme.com",
    "*.acme.com"
   ],
   "expect": true
  },
  {
   "why": "a star does not invent the dot before it",
   "input": [
    "acme.com",
    "*.acme.com"
   ],
   "expect": false
  },
  {
   "why": "? is exactly one character",
   "input": [
    "abc",
    "a?c"
   ],
   "expect": true
  },
  {
   "why": "? is not zero characters",
   "input": [
    "ac",
    "a?c"
   ],
   "expect": false
  },
  {
   "why": "brackets are literal, unlike fnmatch",
   "input": [
    "[x]",
    "[x]"
   ],
   "expect": true
  },
  {
   "why": "a bracket expression is not a character class",
   "input": [
    "x",
    "[x]"
   ],
   "expect": false
  },
  {
   "why": "? is one code point, not one UTF-16 unit",
   "input": [
    "\ud83d\ude00b",
    "?b"
   ],
   "expect": true
  },
  {
   "why": "a star matches nothing",
   "input": [
    "",
    "*"
   ],
   "expect": true
  },
  {
   "why": "an empty pattern matches only the empty string",
   "input": [
    "a",
    ""
   ],
   "expect": false
  },
  {
   "why": "matching is case-sensitive; callers lower what they mean to",
   "input": [
    "MCP",
    "mcp"
   ],
   "expect": false
  }
 ],
 "endpoint": [
  {
   "why": "Python's urlsplit reads good.example, a Node client connects to evil.example",
   "input": "https://evil.example\\@mcp.linear.app/sse",
   "expect": null
  },
  {
   "why": "user info never names the host",
   "input": "https://mcp.linear.app@evil.example/sse",
   "expect": "https://evil.example/sse"
  },
  {
   "why": "user info, query and fragment are dropped",
   "input": "https://user:pw@mcp.example.com/sse?api_key=abc#frag",
   "expect": "https://mcp.example.com/sse"
  },
  {
   "why": "two @ in the authority is refused",
   "input": "https://a@b@mcp.example.com/",
   "expect": null
  },
  {
   "why": "a percent-encoded host is refused",
   "input": "https://ex%61mple.com/",
   "expect": null
  },
  {
   "why": "a non-ASCII host is refused: Node would punycode it",
   "input": "https://b\u00fccher.example/",
   "expect": null
  },
  {
   "why": "Node resolves a dot segment before it asks",
   "input": "https://x.example/ok/../admin",
   "expect": null
  },
  {
   "why": "and an encoded one",
   "input": "https://x.example/ok/%2e%2e/admin",
   "expect": null
  },
  {
   "why": "matches /ok/* as written; Node resolves it to /admin",
   "input": "https://x.example/ok/x\\..\\..\\admin",
   "expect": null
  },
  {
   "why": "whitespace anywhere is refused",
   "input": "https://x.example/a b",
   "expect": null
  },
  {
   "why": "surrounding ASCII whitespace is trimmed",
   "input": "  https://x.example/sse \n",
   "expect": "https://x.example/sse"
  },
  {
   "why": "str.strip() would take \\x1c; this does not, and refuses it",
   "input": "\u001chttps://x.example/",
   "expect": null
  },
  {
   "why": "a port is read as a number",
   "input": "https://x.example:0443/p",
   "expect": "https://x.example:443/p"
  },
  {
   "why": "an empty port is no port",
   "input": "https://x.example:/p",
   "expect": "https://x.example/p"
  },
  {
   "why": "a port past 65535 is refused",
   "input": "https://x.example:99999/",
   "expect": null
  },
  {
   "why": "a bracketed IPv6 host",
   "input": "http://[::1]:8080/mcp",
   "expect": "http://[::1]:8080/mcp"
  },
  {
   "why": "an unclosed bracket is refused",
   "input": "https://[::1/x",
   "expect": null
  },
  {
   "why": "scheme and host lower-cased, path kept",
   "input": "HTTPS://MCP.Linear.App/SSE",
   "expect": "https://mcp.linear.app/SSE"
  },
  {
   "why": "no path is /",
   "input": "https://mcp.linear.app",
   "expect": "https://mcp.linear.app/"
  },
  {
   "why": "a long mixed segment is a credential",
   "input": "https://actions.zapier.com/mcp/sk-ak-9f8e7d6c5b4a3f2e1d0c9b8a7/sse",
   "expect": "https://actions.zapier.com/mcp/{redacted}/sse"
  },
  {
   "why": "a provider token shape is a credential",
   "input": "https://gw.example/ghp_A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8/mcp",
   "expect": "https://gw.example/{redacted}/mcp"
  },
  {
   "why": "redact() reads ;token= as a secret parameter",
   "input": "https://gw.example/x;token=abc/mcp",
   "expect": "https://gw.example/{redacted}/mcp"
  },
  {
   "why": "an already-redacted value is left alone",
   "input": "https://gw.example/a;session=[REDACTED]/mcp",
   "expect": "https://gw.example/a;session=[REDACTED]/mcp"
  },
  {
   "why": "no scheme is no address",
   "input": "mcp.example.com",
   "expect": null
  }
 ],
 "shlex": [
  {
   "why": "single quotes keep spaces",
   "input": "npx -y '@scope/a b'",
   "expect": [
    "npx",
    "-y",
    "@scope/a b"
   ]
  },
  {
   "why": "a backslash escapes a quote inside double quotes",
   "input": "a \"b\\\"c\" d",
   "expect": [
    "a",
    "b\"c",
    "d"
   ]
  },
  {
   "why": "and is kept before anything else there",
   "input": "a \"b\\c\"",
   "expect": [
    "a",
    "b\\c"
   ]
  },
  {
   "why": "a backslash escapes a space outside quotes",
   "input": "a\\ b",
   "expect": [
    "a b"
   ]
  },
  {
   "why": "an empty quoted word is a word",
   "input": "''",
   "expect": [
    ""
   ]
  },
  {
   "why": "an unclosed quote is an error",
   "input": "a 'b",
   "expect": "ERROR"
  },
  {
   "why": "a trailing backslash is an error",
   "input": "a\\",
   "expect": "ERROR"
  },
  {
   "why": "\\v is not shlex whitespace",
   "input": "a\u000bb",
   "expect": [
    "a\u000bb"
   ]
  },
  {
   "why": "# is not a comment for shlex.split",
   "input": "x #y",
   "expect": [
    "x",
    "#y"
   ]
  }
 ],
 "describe": [
  {
   "why": "a pinned npm package",
   "input": {
    "transport": "stdio",
    "command": "npx",
    "args": [
     "-y",
     "@scope/srv@1.2.3"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "@scope/srv",
     "version": "1.2.3",
     "exact": true
    },
    "endpoint": null,
    "command": "npx"
   }
  },
  {
   "why": "npm reads 1.2 as a range",
   "input": {
    "transport": "stdio",
    "command": "npx",
    "args": [
     "-y",
     "pkg@1.2"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "pkg",
     "version": "1.2",
     "exact": false
    },
    "endpoint": null,
    "command": "npx"
   }
  },
  {
   "why": "a leading v is stripped from an exact version",
   "input": {
    "transport": "stdio",
    "command": "npx",
    "args": [
     "-y",
     "pkg@v1.2.3"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "pkg",
     "version": "1.2.3",
     "exact": true
    },
    "endpoint": null,
    "command": "npx"
   }
  },
  {
   "why": "a PEP 508 pin",
   "input": {
    "transport": "stdio",
    "command": "uvx",
    "args": [
     "mcp-server-fetch==2025.4.7"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "pypi",
     "name": "mcp-server-fetch",
     "version": "2025.4.7",
     "exact": true
    },
    "endpoint": null,
    "command": "uvx"
   }
  },
  {
   "why": "a PEP 508 range, extras dropped from the name",
   "input": {
    "transport": "stdio",
    "command": "uvx",
    "args": [
     "Mcp[cli]>=1"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "pypi",
     "name": "Mcp",
     "version": ">=1",
     "exact": false
    },
    "endpoint": null,
    "command": "uvx"
   }
  },
  {
   "why": "Windows' cmd /c is seen through",
   "input": {
    "transport": "stdio",
    "command": "cmd",
    "args": [
     "/c",
     "npx",
     "-y",
     "pkg@1.0.0"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "pkg",
     "version": "1.0.0",
     "exact": true
    },
    "endpoint": null,
    "command": "npx"
   }
  },
  {
   "why": "a Windows path and suffix",
   "input": {
    "transport": "stdio",
    "command": "C:\\nodejs\\NPX.CMD",
    "args": [
     "-y",
     "pkg@1.0.0"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "pkg",
     "version": "1.0.0",
     "exact": true
    },
    "endpoint": null,
    "command": "npx"
   }
  },
  {
   "why": "deno's npm: specifier",
   "input": {
    "transport": "stdio",
    "command": "deno",
    "args": [
     "run",
     "-A",
     "npm:pkg@1.0.0"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "pkg",
     "version": "1.0.0",
     "exact": true
    },
    "endpoint": null,
    "command": "deno"
   }
  },
  {
   "why": "a flag that takes a value",
   "input": {
    "transport": "stdio",
    "command": "pnpm",
    "args": [
     "dlx",
     "--package",
     "x",
     "pkg@1.0.0"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "pkg",
     "version": "1.0.0",
     "exact": true
    },
    "endpoint": null,
    "command": "pnpm"
   }
  },
  {
   "why": "a wrapped server is described by what it wraps",
   "input": {
    "transport": "stdio",
    "command": "heldfast",
    "args": [
     "wrap",
     "--name",
     "s",
     "--",
     "npx",
     "-y",
     "pkg@1.0.0"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "pkg",
     "version": "1.0.0",
     "exact": true
    },
    "endpoint": null,
    "command": "npx"
   }
  },
  {
   "why": "heldfast -- is wrap",
   "input": {
    "transport": "stdio",
    "command": "heldfast",
    "args": [
     "--",
     "npx",
     "-y",
     "pkg@1.0.0"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "pkg",
     "version": "1.0.0",
     "exact": true
    },
    "endpoint": null,
    "command": "npx"
   }
  },
  {
   "why": "a local path is not a package",
   "input": {
    "transport": "stdio",
    "command": "npx",
    "args": [
     "-y",
     "./local"
    ]
   },
   "expect": {
    "kind": "local",
    "transport": "stdio",
    "package": null,
    "endpoint": null,
    "command": "npx"
   }
  },
  {
   "why": "a local command",
   "input": {
    "transport": "stdio",
    "command": "node",
    "args": [
     "server.js"
    ]
   },
   "expect": {
    "kind": "local",
    "transport": "stdio",
    "package": null,
    "endpoint": null,
    "command": "node"
   }
  },
  {
   "why": "an address that cannot be read is empty, not absent",
   "input": {
    "transport": "http",
    "command": null,
    "args": [],
    "url": "https://evil.example\\@good.example/"
   },
   "expect": {
    "kind": "hosted",
    "transport": "http",
    "package": null,
    "endpoint": "",
    "command": null
   }
  },
  {
   "why": "Arabic-Indic digits are not a version",
   "input": {
    "transport": "stdio",
    "command": "npx",
    "args": [
     "-y",
     "pkg@\u0661.\u0662.\u0663"
    ]
   },
   "expect": {
    "kind": "package",
    "transport": "stdio",
    "package": {
     "ecosystem": "npm",
     "name": "pkg",
     "version": "\u0661.\u0662.\u0663",
     "exact": false
    },
    "endpoint": null,
    "command": "npx"
   }
  }
 ],
